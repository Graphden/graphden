;; Coverage-mode kaocha config. Mirrors `tests.edn` but activates
;; `:kaocha.plugin/cloverage` (from `lambdaisland/kaocha-cloverage`)
;; so the coverage instrumentation runs through the kaocha runner —
;; that way `:kaocha.plugin/parallel` (in-JVM NS parallelism) is also
;; in effect during coverage runs.
;;
;; Activated by `bb coverage` only — `bb test` keeps using `tests.edn`
;; so day-to-day local runs don't pay the cloverage instrumentation
;; cost.
;;
;; UNIT SUITE ONLY: the integration suite is deliberately omitted from
;; this config. Empirical 2026-06-23 finding: every CRUD NS that
;; integration tests exercise (`crud.entities`, `crud.fn-execution.*`,
;; etc.) reports 0% form/line coverage anyway because cr/execute's
;; pre-compiled closure cache (built by `cr/rebuild!` from package
;; loader's defbase impls) holds already-resolved fn objects — they
;; never re-deref through cloverage's instrumented vars. Confirmed
;; under BOTH kaocha-cloverage AND a 2h32m sequential direct cloverage
;; CLI audit: total stayed 83.74% vs 83.77%, per-NS 0% identical.
;; → Adding integration to the cloverage pass paid ~30 min wall for
;;   ~0% useful per-NS attribution. Integration tests run via `bb test`
;;   / `bb test-integration` un-instrumented; that's the signal we use
;;   for those code paths.
#kaocha/v1
{:tests
 [{:id :unit
   :test-paths ["test"]
   :skip-meta [:integration]
   :kaocha/parallelism 8}]

 :plugins [:kaocha.plugin/profiling
           :kaocha.plugin/parallel
           :kaocha.plugin/shared-container
           :kaocha.plugin/cloverage]

 :cloverage/opts
 {:ns-regex ["graphden\\..*"]
  :ns-exclude-regex [".*-test"
                     ".*contract-tests"
                     ".*test-helpers"
                     ".*test-mocks"]
  ;; ANSI-colour the summary table — red below low-watermark (50%),
  ;; yellow in between, green at or above high-watermark (80%). The
  ;; cloverage CLI defaults this to true, but kaocha-cloverage builds
  ;; its opts map from scratch (no `:cov-colorize` CLI option), so
  ;; without this explicit key the report comes back uncoloured.
  :colorize? true
  :low-watermark 50
  :high-watermark 80}}
