;; Reitit routing base functions + `:router` assembly fn-def
;;
;; `:ring-router`, `:ring-create-default-handler`, `:ring-handler` are
;; thin wrappers around the corresponding `reitit.ring` calls. `:router`
;; is a pure graph-level composition — filter nils, normalize keys,
;; wrap default responses into Ring handlers, feed it all to reitit —
;; expressed here as a fn-def so the assembly is visible in the graph.
;;
;; `:middleware` / `:proceed` are the middleware primitives consumed by
;; reitit's per-route chain (see reitit/impls.clj for the per-request
;; map-callable that injects `:request` + `:next-handler` into the body
;; fn-graph).


{:namespace "web.reitit"
 :description "Reitit routing primitives (router/handler/middleware) plus the `:router` assembly that compiles routes + default-handler trio into a Ring callable."
 :fns
 [;; =============================================================================
  ;; REITIT-LIBRARY WRAPPERS (base-fns)
  ;; =============================================================================

  ;; Compile routes into a reitit router. `routes` is the shape reitit
  ;; expects: `[[path {:method {:handler …}} …] …]` with keyword keys
  ;; at every level of the route-data map.
  {:name :ring-router
   :description "Compile a vector of `[path method-data]` route entries into a reitit router. Wraps `reitit.ring/router`."
   :args {:routes :any}
   :return-type :any}

  ;; Build a Ring handler reitit falls back to when no route matches.
  ;; `handlers` is a map with `:not-found`, `:method-not-allowed`,
  ;; `:not-acceptable` keys; each value is a Ring-shaped handler fn.
  {:name :ring-create-default-handler
   :description "Build a Ring fallback handler from a `{:not-found :method-not-allowed :not-acceptable}` map of per-slot Ring callables."
   :args {:handlers :jsonb}
   :return-type :fn}

  ;; Compose a compiled reitit router and a default handler into the
  ;; final Ring callable that http-kit invokes per request.
  ;;
  ;; `:default-handler` is `:any` (not `:fn`): the fn-graph bound here
  ;; evaluates to a Ring callable (built via `:make-handler` + reitit's
  ;; `create-default-handler`) and we want to pass THAT fn object
  ;; through. `:fn` would trigger `hof-wrap` and re-wrap the fn-graph
  ;; — wrong here, because the value IS already a callable.
  {:name :ring-handler
   :description "Compose a compiled reitit router and a default handler into the single Ring callable invoked per request."
   :args {:router :any
          :default-handler :any}
   :return-type :fn}

  ;; =============================================================================
  ;; MIDDLEWARE CHAIN
  ;; =============================================================================

  ;; Middleware factory. `:body` is a Ring-shaped fn-graph with two
  ;; leftover free args (`:request` and `:next-handler`) — compile's
  ;; `hof-wrap` builds a map-callable for that shape. The middleware
  ;; impl invokes it per request as
  ;; `(body {:request <ring-request> :next-handler <next-link>})`.
  ;; Inside `:body`, use `:proceed` to delegate to the next link in
  ;; the chain (it just runs `:invoke` over those two free args).
  {:name :middleware
   :args {:name :any
          :body :fn}
   :return-type :jsonb}

  ;; Delegate to the next handler in the middleware chain. Replaces
  ;; the ex-`:proceed` base-fn (which sat on a `*next-handler*` dynvar).
  ;; Pure fn-def: composes `:invoke` over two free args directly. The
  ;; map-callable hof-wrap binds them by name from middleware impl's
  ;; `(body {:request _ :next-handler _})`. The `{:as :request}` rename
  ;; here means `:proceed`'s call-site free arg name for the request
  ;; is `:request` — which lines up with `:ring-request`'s rename, so
  ;; reuse of the existing extraction chain works naturally.
  {:name :proceed
   :parent :invoke
   :args {:func {:as :next-handler}
          :arg :ring-request}}

  ;; =============================================================================
  ;; ROUTER ASSEMBLY (fn-def composition)
  ;;
  ;; Free args (caller interface, same shape as the old monolithic
  ;; `:router` base-fn):
  ;;   :routes, :not-found-response, :method-not-allowed-response, :error-response
  ;;
  ;; Pipeline:
  ;;
  ;;   :routes → filter nils → keywordize keys → :ring-router
  ;;                                                     ↓
  ;;                                     :ring-handler → :router
  ;;                                                     ↑
  ;;    make-handler × 3 → pairs→map → :ring-create-default-handler
  ;; =============================================================================

  ;; Drop nils so unused slot entries can be passed in uniformly.
  {:name :_router-non-nil-routes
   :parent :filter
   :args {:pred :some?
          :coll {:as :routes}}}

  ;; Reitit walks route-data with keyword keys; our routes arrive with
  ;; string keys (`"get"`, `"handler"`, `"middleware"`) because they
  ;; were built via `:assoc` with literal string keys in app/common.
  {:name :_router-normalized-routes
   :parent :keywordize-map-keys
   :args {:m :_router-non-nil-routes}}

  {:name :_router-compiled
   :parent :ring-router
   :args {:routes :_router-normalized-routes}}

  ;; Three constant Ring handlers — one per reitit fallback slot.
  ;; Free arg on each is the response it wraps; those names become
  ;; the router fn-def's public free-arg interface.
  {:name :_router-not-found-handler
   :parent :make-handler
   :args {:response {:as :not-found-response}}}

  {:name :_router-method-not-allowed-handler
   :parent :make-handler
   :args {:response {:as :method-not-allowed-response}}}

  {:name :_router-not-acceptable-handler
   :parent :make-handler
   :args {:response {:as :error-response}}}

  ;; Defaults-map entries. Keys are reitit slot keywords (literal, so
  ;; `{:value :kw}` bypasses fn-ref resolution); values are the constant
  ;; handlers built above.
  {:name :_router-not-found-entry
   :parent :pair
   :args {:item1 {:value :not-found}
          :item2 :_router-not-found-handler}}

  {:name :_router-method-not-allowed-entry
   :parent :pair
   :args {:item1 {:value :method-not-allowed}
          :item2 :_router-method-not-allowed-handler}}

  {:name :_router-not-acceptable-entry
   :parent :pair
   :args {:item1 {:value :not-acceptable}
          :item2 :_router-not-acceptable-handler}}

  {:name :_router-defaults-map
   :parent :pairs->map
   :args {:entries [:_router-not-found-entry
                    :_router-method-not-allowed-entry
                    :_router-not-acceptable-entry]}}

  {:name :_router-default-handler
   :parent :ring-create-default-handler
   :args {:handlers :_router-defaults-map}}

  ;; Entry point. Same free-arg surface as the old `:router` base-fn,
  ;; so all downstream fn-defs (`:router-with-text-404`, etc.) keep
  ;; their existing bindings.
  {:name :router
   :description "Full router assembly — filter nils, keywordize keys, compile reitit router, and wire up a default-handler trio. Public free args: `:routes`, `:not-found-response`, `:method-not-allowed-response`, `:error-response`."
   :parent :ring-handler
   :args {:router :_router-compiled
          :default-handler :_router-default-handler}}

  ;; =============================================================================
  ;; ROUTER TEXT-DEFAULT PRESETS
  ;; Per-slot text-default presets + their body fn-defs live in
  ;; `web.reitit.text`. The MI composition below stays here because it
  ;; IS the canonical text-default router consumed by app.server.
  ;; =============================================================================

  {:name :text-error-router
   :description "Router with plain-text bodies wired into all three reitit fallback slots (404, 405, 500). Multiple-inheritance composition of the per-slot presets — caller only supplies `:routes`."
   :parents [:r404 :r405 :r500]}]}
