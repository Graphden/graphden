  ;; =========================================================================

  {:name :hx-get-attrs-carries-url-and-nil-options
   :description "`:hx-get-attrs` with only `:url` bound carries `hx-get` and nil for target/swap/trigger (nil attrs vanish at render)."
   :parent :assert-eq
   :args {:actual {:parent :hx-get-attrs :args {:url "/x" :swap nil}}
          :expected {:value {:hx-get "/x" :hx-target nil :hx-swap nil :hx-trigger nil}}}}

  {:name :hx-post-attrs-carries-target-swap-and-trigger
   :description "`:hx-post-attrs` maps the three options onto `hx-target` / `hx-swap` / `hx-trigger`."
   :parent :assert-eq
   :args {:actual {:parent :hx-post-attrs :args {:url "/x" :target "#t" :swap "outerHTML" :trigger "load"}}
          :expected {:value {:hx-post "/x" :hx-target "#t" :hx-swap "outerHTML" :hx-trigger "load"}}}}

  {:name :hx-request-attrs-takes-an-arbitrary-verb-attr
   :description "`:hx-request-attrs` keys the URL under whatever `:verb-attr` is bound — here `:hx-put`."
   :parent :assert-eq
   :args {:actual {:parent :hx-request-attrs :args {:verb-attr {:value :hx-put} :url "/x" :swap nil}}
          :expected {:value {:hx-put "/x" :hx-target nil :hx-swap nil :hx-trigger nil}}}}

  {:name :sse-connect-attrs-defaults-the-event-to-message
   :description "`:sse-connect-attrs` without `:event` subscribes to the `message` event."
   :parent :assert-eq
   :args {:actual {:parent :sse-connect-attrs :args {:url "/s"}}
          :expected {:value {:hx-ext "sse" :sse-connect "/s" :sse-swap "message"}}}}

  {:name :sse-connect-attrs-uses-the-bound-event
   :description "`:sse-connect-attrs` puts a bound `:event` into `sse-swap`."
   :parent :assert-eq
   :args {:actual {:parent :sse-connect-attrs :args {:url "/s" :event "tick"}}
          :expected {:value {:hx-ext "sse" :sse-connect "/s" :sse-swap "tick"}}}}

  {:name :hx-button-posts-to-its-url
   :description "`:hx-button` is a `<button hx-post=url>label</button>` with the unbound options as nil attrs."
   :parent :assert-eq
   :args {:actual {:parent :hx-button :args {:label "Go" :url "/x" :swap nil :extras {}}}
          :expected {:value [:button {:hx-post "/x" :hx-target nil :hx-swap nil :hx-trigger nil} "Go"]}}}

  {:name :hx-button-merges-extras-last
   :description "`:hx-button`'s `:extras` merge last — a caller's `hx-target` wins over the unbound nil and extra keys ride along."
   :parent :assert-eq
   :args {:actual {:parent :hx-button :args {:label "Go" :url "/x" :swap nil :extras {:class "c" :hx-target "#t"}}}
          :expected {:value [:button {:hx-post "/x" :hx-target "#t" :hx-swap nil :hx-trigger nil :class "c"} "Go"]}}}

