;; App-specific web-server composition.
;;
;; The reusable ring-adapter + handler pipeline lives in `web/ring-adapter`.
;; This module only carries THIS app's routes + router binding + the
;; web-server root node.


{:namespace "app.server"
 :description "Application web-server entry point — this app's routes, router binding, and the `:web-server` root fn-def started by the runtime."
 :fns
 [;; =============================================================================
  ;; MONITORING: Health & Metrics (app-specific)
  ;; =============================================================================

  {:name :_health-json-body
   :parent :to-json-string
   :args {:data :health-status}}

  {:name :_health-handler
   :parent :json-ok-response
   :args {:body :_health-json-body}}

  {:name :health-route
   :description "GET /health — returns the current health status as JSON."
   :parent :get-route
   :args {:path "/health" :handler :_health-handler}}

  {:name :_metrics-json-body
   :parent :to-json-string
   :args {:data :jvm-info}}

  {:name :_metrics-handler
   :parent :json-ok-response
   :args {:body :_metrics-json-body}}

  {:name :metrics-route
   :description "GET /metrics — returns JVM info (heap, threads, uptime) as JSON."
   :parent :get-route
   :args {:path "/metrics" :handler :_metrics-handler}}

  ;; =============================================================================
  ;; ROUTE GROUPS (named — user navigates to each from sidebar)
  ;; =============================================================================

  {:name :ui-routes
   :description "User-facing UI route group — favicon and the editor page."
   :parent :list
   :args {:items [:favicon-route :editor-route]}}

  {:name :entity-crud-routes
   :description "Entity CRUD route group — details/form pages and create/delete handlers used by the editor's right-hand panel."
   :parent :list
   :args {:items [:entity-details-route
                  :entity-form-create-route
                  :entity-form-edit-route
                  :create-entity-route
                  :delete-entity-route]}}

  {:name :graph-api-routes
   :description "Graph-data API routes — `/api/entities` (raw graph dump) and `/api/graph/layout` (layout pipeline)."
   :parent :list
   :args {:items [:api-entities-route :layout-api-route]}}

  {:name :monitoring-routes
   :description "Health + metrics route group consumed by the docker healthcheck and external scrapers."
   :parent :list
   :args {:items [:health-route :metrics-route]}}

  {:name :all-routes
   :description "Flat list of every route reitit serves. Bound into `:_router` — order is irrelevant since reitit dispatches by `[path method]`."
   :parent :list
   :args {:items [:favicon-route
                  :editor-route
                  :api-entities-route
                  :entity-details-route
                  :entity-form-create-route
                  :entity-form-edit-route
                  :create-entity-route
                  :delete-entity-route
                  :sequence-append-route
                  :sequence-remove-route
                  :health-route
                  :metrics-route
                  :layout-api-route]}}

  ;; =============================================================================
  ;; AUTH-REQUIRED ROUTE SHORTCUTS
  ;; App-specific wiring: bind `auth-required-middleware` as the route's
  ;; middleware list. Third-party apps with different auth policies
  ;; define their own shortcuts in the same style.
  ;; =============================================================================

  {:name :_auth-middleware-list
   :parent :list
   :args {:items [:auth-required-middleware]}}

  {:name :post-auth-required-route
   :description "POST route preset wired with `:auth-required-middleware`. Caller provides `:path` and `:handler`."
   :parent :post-route-with-middleware
   :args {:middleware :_auth-middleware-list}}

  {:name :delete-auth-required-route
   :description "DELETE route preset wired with `:auth-required-middleware`. Caller provides `:path` and `:handler`."
   :parent :delete-route-with-middleware
   :args {:middleware :_auth-middleware-list}}

  ;; =============================================================================
  ;; WEB SERVER
  ;; =============================================================================

  ;; This app's router instance — bound to all-routes.
  {:name :_router
   :description "This app's compiled reitit router — text-error-router bound to all of this app's routes."
   :parent :text-error-router
   :args {:routes :all-routes}}

  {:name :_app-ring-response
   :description "Final Ring handler — invokes the router on the parsed request and merges default security headers. Bound to `:http-server.handler`."
   :parent :router-ring-response
   :args {:func :_router}}

  {:name :web-server
   :description "Application root — starts the http-kit server on port 8080 with this app's full Ring handler chain."
   :parent :http-server
   :args {:handler :_app-ring-response :port 8080}}]}
