# Claude Code (local settings, worktrees) — except shared project
# skills, hooks, and the project-scoped settings.json. Personal
# overrides stay in .claude/settings.local.json (still gitignored).
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json

# Build artifacts
/target/
*.jar
*.class

# Generated by `bb rebuild` (writes to target/classes/) and read at
# runtime via `:read-resource` for /version. Devs keep a local stub
# in resources/ so REPL `(go)` boots — content is irrelevant outside
# the deployed uberjar.
resources/graphden-build-hashes.json

# Clojure caches
.cpcache/
.clj-kondo/.cache/
/.lsp/

# Leiningen
/lib/
/classes/
/checkouts/
pom.xml
pom.xml.asc
.lein-*

# REPL
.nrepl-port
.nrepl.log
.nrepl.pid

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# Tools
.aider*

# Node modules
node_modules/

# Security (contains API key)
cljwatson.properties

# Local env (AUTH_TOKEN, db creds) — `.env.example` is the tracked template.
.env

# One-off debug scripts written during a diagnostic session — long-
# lived tools live alongside in tools/browser-test/ (tracked); the
# scratch/ subdir is for throwaways that aren't worth committing.
tools/browser-test/scratch/

# Playwright MCP server scratch — auto-populated on every browser_*
# call (snapshots, console logs). Per-call timestamped files; nothing
# here is worth committing.
.playwright-mcp/

# Playwright visual-regression artifacts — baselines under
# tests/*-snapshots/ ARE committed (they're the reference set);
# everything else (per-run diffs, html report, traces) is throwaway.
tools/visual-tests/test-results/
tools/visual-tests/playwright-report/

# Perf artifacts — the same split as the visual baselines above.
# perf/budgets.edn IS committed (it's the reference set `bb perf` gates
# against); each run's raw readings are this-host, this-moment throwaway.
perf/runs/

# Playwright screenshot artifacts (browser-test verification, not for repo)
/editor-*.png
/.playwright-mcp/
tools/browser-test/node_modules/

# Local-cache for binary linters that bb downloads on demand —
# currently just `typos` (typos-cli release tarball). Pinned via
# version in `bb.edn :typos` task; refetched on bump.
/.tools/
