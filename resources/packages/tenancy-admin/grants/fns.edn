;; Org-admin Grants panel (PLATFORM_PLAN §6) — migrated out of the core
;; `app/admin` package into this addon-only package as part of the
;; route-collection seam. These routes are NOT in the core `:all` list;
;; they are compiled into `:tenancy-router` (a `:router-or-nil`) and
;; installed into the `:tenancy-routing-wrap` singleton at boot by the
;; addon's `:tenancy/router-install` init-key. With no addon active the
;; package isn't loaded, the singleton stays nil, and the wrap is a
;; transparent pass-through.
;;
;; The base-fns (`:list-grants`, `:create-grant`) are thin storage shims
;; over the addon's `:grant` entity; they read `(:storage ctx)` (the
;; org-scoped storage) so the panel only ever shows the current org's
;; grants. The query runs under the request-scope's `*current-org*`
;; binding established by `:tenancy-routing-wrap`'s enclosing layer.

{:namespace "tenancy-admin.grants"
 :description "Org-admin grants panel + create route, served via the tenancy route-collection seam."
 :fns
 [;; Base-fn: every :grant row, for the org-admin grants panel (§6).
  ;; Reads the addon's :grant entity, so it throws when the addon isn't
  ;; active — but this package only loads WITH the addon, so the :try
  ;; below is belt-and-suspenders.
  {:name :list-grants
   :description "All :grant rows as decoded entity maps (:subject :capability :namespace :id). Reads the tenancy addon's :grant entity via the storage protocol; throws if :grant isn't in the schema (addon inactive), so callers guard with :try."
   :args {}
   :return-type [:list :keyword-map]
   :effects #{:db}}

  ;; Base-fn: create a :grant from three text fields.
  {:name :create-grant
   :description "Create a :grant entity from subject/capability/namespace text. Reads the tenancy addon's :grant entity; throws if absent (addon inactive)."
   :args {:subject {:type :text :description "Principal the grant is for."}
          :capability {:type :text :description "read / write / execute / admin."}
          :namespace {:type :text :description "Dot-path namespace the capability applies to."}}
   :return-type :keyword-map
   :effects #{:db}}

  ;; ---------------------------------------------------------------------
  ;; GRANTS-ADMIN PARTIAL — GET /partials/grants-admin. A table of every
  ;; grant (subject | capability | namespace), wrapped in :try so it
  ;; degrades to a "not active" notice. Mirrors the secrets-panel.
  ;; ---------------------------------------------------------------------

  ;; --- header row ---
  {:name :_grants-th-subject
   :parent :hiccup
   :args {:tag {:value "th"} :children [{:value "Subject"}]}}

  {:name :_grants-th-capability
   :parent :hiccup
   :args {:tag {:value "th"} :children [{:value "Capability"}]}}

  {:name :_grants-th-namespace
   :parent :hiccup
   :args {:tag {:value "th"} :children [{:value "Namespace"}]}}

  {:name :_grants-th-actions
   :parent :hiccup
   :args {:tag {:value "th"} :children [{:value ""}]}}

  {:name :_grants-thead-row
   :parent :hiccup
   :args {:tag {:value "tr"}
          :children [:_grants-th-subject :_grants-th-capability
                     :_grants-th-namespace :_grants-th-actions]}}

  {:name :_grants-thead
   :parent :hiccup
   :args {:tag {:value "thead"} :children [:_grants-thead-row]}}

  ;; --- body row (HOF over :item — one grant map per element) ---
  {:name :_grant-subject-val
   :parent :get
   :args {:coll {:as :item} :key {:value :subject} :default {:value ""}}}

  {:name :_grant-capability-val
   :parent :get
   :args {:coll {:as :item} :key {:value :capability} :default {:value ""}}}

  {:name :_grant-namespace-val
   :parent :get
   :args {:coll {:as :item} :key {:value :namespace} :default {:value ""}}}

  {:name :_grant-td-subject
   :parent :hiccup
   :args {:tag {:value "td"} :children [:_grant-subject-val]}}

  {:name :_grant-td-capability
   :parent :hiccup
   :args {:tag {:value "td"} :children [:_grant-capability-val]}}

  {:name :_grant-td-namespace
   :parent :hiccup
   :args {:tag {:value "td"} :children [:_grant-namespace-val]}}

  ;; per-row delete button — HTMX-native: hx-delete hits the generic entity
  ;; endpoint, hx-swap="delete" removes THIS <tr> on success (the response body
  ;; is irrelevant — no panel refresh needed), hx-confirm prompts. No client JS;
  ;; the bearer rides along via the htmx:configRequest bridge in editor-auth.js.
  {:name :_grant-id-val
   :parent :get
   :args {:coll {:as :item} :key {:value :id} :default {:value ""}}}

  {:name :_grant-id-str
   :parent :to-str
   :args {:value :_grant-id-val}}

  {:name :_grant-delete-url
   :parent :str-join
   :args {:coll [{:value "/api/entities/grant/"} :_grant-id-str]
          :separator {:value ""}}}

  {:name :_grant-delete-attrs
   :parent :assoc
   :args {:map {:value {:type "button"
                        :class "grant-delete"
                        :title "Delete grant"
                        :hx-target "closest tr"
                        :hx-swap "delete"
                        :hx-confirm "Delete this grant?"}}
          :key {:value :hx-delete}
          :value :_grant-delete-url}}

  {:name :_grant-delete-btn
   :parent :hiccup
   :args {:tag {:value "button"} :attrs :_grant-delete-attrs :children [{:value "×"}]}}

  {:name :_grant-td-actions
   :parent :hiccup
   :args {:tag {:value "td"} :children [:_grant-delete-btn]}}

  {:name :_grant-row
   :parent :hiccup
   :args {:tag {:value "tr"}
          :children [:_grant-td-subject :_grant-td-capability
                     :_grant-td-namespace :_grant-td-actions]}}

  {:name :_grants-rows
   :parent :map
   :args {:func :_grant-row :coll :list-grants}}

  {:name :_grants-tbody
   :parent :hiccup
   :args {:tag {:value "tbody"} :children :_grants-rows}}

  {:name :_grants-table
   :parent :hiccup
   :args {:tag {:value "table"}
          :attrs {:value {:class "grants-admin-table"}}
          :children [:_grants-thead :_grants-tbody]}}

  ;; --- degradation: addon inactive (:grant query throws) → a notice ---
  {:name :_grants-disabled
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "grants-admin-disabled"}}
          :children [{:value "Tenancy addon not active — no grants to manage."}]}}

  {:name :_grants-safe
   :description "The grants table, or the disabled notice when :list-grants throws (addon inactive). `:on-throw` is a `[:fn :any]` callable, so the fallback is wrapped in `:const`."
   :parent :try
   :args {:body :_grants-table
          :on-throw {:parent :const :args {:value :_grants-disabled}}}}

  ;; --- create form — a real <form hx-post> (no client JS). HTML5 `required`
  ;; replaces the old JS empty-check; on submit HTMX form-encodes the inputs,
  ;; POSTs, and swaps the refreshed panel back in (see :_grant-create-handler).
  {:name :_grant-input-subject
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:value {:type "text" :name "subject" :placeholder "subject" :class "grant-input" :required true}}}}

  {:name :_grant-input-capability
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:value {:type "text" :name "capability" :placeholder "read / write / execute / admin" :class "grant-input" :required true}}}}

  {:name :_grant-input-namespace
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:value {:type "text" :name "namespace" :placeholder "namespace" :class "grant-input" :required true}}}}

  {:name :_grant-create-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:type "submit" :class "grant-create-btn"}}
          :children [{:value "+ Add grant"}]}}

  ;; Path single-sourced: BOTH `:create-grant-route` (the route) and this form's
  ;; hx-post reference `:_grants-api-path`, so the form can't drift from the
  ;; route it posts to.
  {:name :_grants-api-path
   :parent :const
   :args {:value "/api/grants"}}

  {:name :_grants-create-form-attrs
   :parent :assoc
   :args {:map {:value {:class "grant-create-form"
                        :hx-target "closest [data-grants-panel]"
                        :hx-swap "outerHTML"}}
          :key {:value :hx-post}
          :value :_grants-api-path}}

  {:name :_grants-create-form
   :parent :hiccup
   :args {:tag {:value "form"}
          :attrs :_grants-create-form-attrs
          :children [:_grant-input-subject :_grant-input-capability
                     :_grant-input-namespace :_grant-create-btn]}}

  ;; --- container + handler + route ---
  {:name :_grants-admin-title
   :parent :hiccup
   :args {:tag {:value "h3"} :children [{:value "Grants"}]}}

  ;; `data-grants-panel` is the stable hx-target the create form swaps into
  ;; (and the GET partial's root), so a create re-renders the whole panel.
  {:name :_grants-admin-body
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "grants-admin" :data-grants-panel "1"}}
          :children [:_grants-admin-title :_grants-safe :_grants-create-form]}}

  {:name :_grants-admin-html
   :parent :render-hiccup
   :args {:hiccup :_grants-admin-body}}

  {:name :_partial-grants-admin-handler
   :description "Ring handler for GET /partials/grants-admin — the org-admin grants table as text/html."
   :parent :html-ok-response
   :args {:body :_grants-admin-html}}

  {:name :partial-grants-admin
   :description "GET /partials/grants-admin — server-rendered grants table. Auth-required (admin-only); degrades to a notice when the tenancy addon is inactive."
   :parent :get-auth-required
   :args {:path "/partials/grants-admin" :handler :_partial-grants-admin-handler}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/grants — create a grant from the form-encoded body, then return
  ;; the REFRESHED panel HTML (HTMX swaps it back into [data-grants-panel]).
  ;; `:do` forces create-before-render, so the panel's :list-grants sees the new
  ;; row. Only reached when the addon is active (the section only mounts then).
  ;; ---------------------------------------------------------------------
  {:name :_grant-create-form-data
   :parent :parse-form-body}

  {:name :_grant-create-subject
   :parent :get
   :args {:coll :_grant-create-form-data :key {:value :subject} :default {:value ""}}}

  {:name :_grant-create-capability
   :parent :get
   :args {:coll :_grant-create-form-data :key {:value :capability} :default {:value ""}}}

  {:name :_grant-create-namespace
   :parent :get
   :args {:coll :_grant-create-form-data :key {:value :namespace} :default {:value ""}}}

  {:name :_grant-create-do
   :parent :create-grant
   :args {:subject :_grant-create-subject
          :capability :_grant-create-capability
          :namespace :_grant-create-namespace}}

  {:name :_grant-create-then-panel
   :description "Create the grant, THEN render the refreshed panel — `:do` forces left-to-right so the panel's :list-grants includes the new row. The HTMX hx-post swaps this back into [data-grants-panel]."
   :parent :do
   :args {:steps [:_grant-create-do :_grants-admin-html]}}

  {:name :_grant-create-handler
   :description "Ring handler for POST /api/grants — creates the grant and returns the refreshed grants panel as text/html (HTMX swap target)."
   :parent :html-ok-response
   :args {:body :_grant-create-then-panel}}

  {:name :create-grant-route
   :description "POST /api/grants — create a grant from a form-encoded body (subject/capability/namespace). Auth-required. Path single-sourced via :_grants-api-path (shared with the form's hx-post)."
   :parent :post
   :args {:path :_grants-api-path :handler :_grant-create-handler}}]}
