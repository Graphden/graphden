{:namespace "app.editor"
 :description "Branch/version UI partials — fn-versions popover (+ per-version executions sub-panel), branch-diff modal, and the merge-conflicts resolution card."
 :fns
 [;; ---------------------------------------------------------------------
  ;; The SQL boundary is local to this module so the editor's own partial can
  ;; resolve it before the later app.branches module is loaded.
  {:name :_history-change-group-fact
   :type {:group_id :uuid :change_id :nullable-uuid :change_revision :nullable-int
          :created_at :any :branch_id :nullable-text :kinds :text
          :event_count :int :deleted :bool :author_label :nullable-text}}
  {:name :_history-change-page-facts
   :type {:rows [:list :_history-change-group-fact] :limit :int :offset :int}}

  {:name :_load-fn-change-page
   :description "A bounded page of transaction groups for fn, fn-slot, binding and list-item versions; payload values are never included. Nil for an unreadable fn."
   :args {:fn-id {:type :nullable-uuid :required false}
          :limit {:type :int}
          :offset {:type :int}}
   :return-type [:union :null :_history-change-page-facts]
   :effects #{:db}}

  {:name :_history-group-row
   :parent :zipmap
   :args {:keys [{:value :group-id} {:value :change-id} {:value :change-revision} {:value :created-at} {:value :branch-id} {:value :kinds} {:value :event-count} {:value :deleted?} {:value :author-label} {:value :has-change-id?} {:value :has-change-revision?}]
          :vals [{:parent :to-str :args {:value {:parent :get :args {:coll {:as :item :type :_history-change-group-fact} :key {:value :group_id} :default nil}}}}
                 {:parent :if :args {:test {:parent :some? :args {:value {:parent :get :args {:coll {:as :item :type :_history-change-group-fact} :key {:value :change_id} :default nil}}}} :then {:parent :to-str :args {:value {:parent :get :args {:coll {:as :item :type :_history-change-group-fact} :key {:value :change_id} :default nil}}}} :else nil}}
                 {:parent :get :args {:coll {:as :item :type :_history-change-group-fact} :key {:value :change_revision} :default nil}}
                 {:parent :to-str :args {:value {:parent :get :args {:coll {:as :item :type :_history-change-group-fact} :key {:value :created_at} :default nil}}}}
                 {:parent :if :args {:test {:parent :some? :args {:value {:parent :get :args {:coll {:as :item :type :_history-change-group-fact} :key {:value :branch_id} :default nil}}}} :then {:parent :to-str :args {:value {:parent :get :args {:coll {:as :item :type :_history-change-group-fact} :key {:value :branch_id} :default nil}}}} :else nil}}
                 {:parent :get :args {:coll {:as :item :type :_history-change-group-fact} :key {:value :kinds} :default nil}}
                 {:parent :get :args {:coll {:as :item :type :_history-change-group-fact} :key {:value :event_count} :default nil}}
                 {:parent :get :args {:coll {:as :item :type :_history-change-group-fact} :key {:value :deleted} :default nil}}
                 {:parent :get :args {:coll {:as :item :type :_history-change-group-fact} :key {:value :author_label} :default nil}}
                 {:parent :some? :args {:value {:parent :get :args {:coll {:as :item :type :_history-change-group-fact} :key {:value :change_id} :default nil}}}}
                 {:parent :some? :args {:value {:parent :get :args {:coll {:as :item :type :_history-change-group-fact} :key {:value :change_revision} :default nil}}}}]}}

  {:name :_history-page-rows
   :parent :get
   :args {:coll :_load-fn-change-page :key {:value :rows} :default []}
   :return-type [:list :_history-change-group-fact]}
  {:name :_history-page-limit
   :parent :get
   :args {:coll :_load-fn-change-page :key {:value :limit} :default 1}
   :return-type :int}
  {:name :_history-page-offset
   :parent :get
   :args {:coll :_load-fn-change-page :key {:value :offset} :default 0}
   :return-type :int}
  {:name :_history-page-model
   :parent :zipmap
   :args {:keys [{:value :groups} {:value :next-offset}]
          :vals [{:parent :vec
                  :args {:coll {:parent :map
                                :args {:func :_history-group-row
                                       :coll {:parent :take
                                              :args {:count {:ref :_history-page-limit :type :non-negative-int}
                                                     :coll :_history-page-rows}}}}}}
                 {:parent :if
                  :args {:test {:parent :gt
                                :args {:nums [{:parent :count :args {:coll :_history-page-rows}}
                                              :_history-page-limit]}}
                         :then {:parent :add :args {:nums [:_history-page-offset :_history-page-limit]}}
                         :else nil}}]}}

  {:name :load-fn-change-events
   :description "A bounded page of transaction groups for fn, fn-slot, binding and list-item versions; payload values are never included. Nil for an unreadable fn."
   :parent :if
   :args {:test {:parent :some? :args {:value :_load-fn-change-page}}
          :then :_history-page-model :else nil
          :fn-id {:type :nullable-uuid :required false}
          :limit {:type :int} :offset {:type :int}}
   :return-type [:union :null
                 {:groups [:list {:group-id :text :kinds :text
                                  :branch-id :nullable-text
                                  :change-id :nullable-text
                                  :created-at :text :deleted? :bool
                                  :event-count :int
                                  :author-label :nullable-text
                                  :has-change-id? :bool}]
                  :next-offset :nullable-int}]}

  {:name :load-fn-history-diff
   :description "Storage boundary for a redacted field diff between two exact graph revisions. Nil for an invalid or unreadable target. The JSON variant is exact or incomplete when legacy provenance prevents a truthful snapshot."
   :args {:fn-id {:type :nullable-uuid :required false}
          :branch-id {:type :nullable-uuid :required false}
          :from-revision {:type :nullable-int :required false}
          :to-revision {:type :nullable-int :required false}}
   :return-type :nullable-jsonb
   :effects #{:db}}

  {:name :_preview-fn-history-restore
   :description "Redacted plan for restoring an exact owned-graph revision on the current branch."
   :args {:fn-id {:type :nullable-uuid :required false}
          :branch-id {:type :nullable-uuid :required false}
          :revision {:type :nullable-int :required false}}
   :return-type :nullable-jsonb
   :effects #{:db}}

  {:name :_commit-fn-history-restore
   :description "Atomically restore after a preview-token CAS; the storage layer rechecks ACL and dependencies."
   :args {:fn-id {:type :nullable-uuid :required false}
          :branch-id {:type :nullable-uuid :required false}
          :revision {:type :nullable-int :required false}
          :expected-current {:type :nullable-text :required false}}
   :return-type :nullable-jsonb
   :effects #{:db}}

  {:name :_history-revision
   :parent :const :args {:value {:as :revision :type :nullable-int}}}
  {:name :_history-positive-revision?
   :parent :if
   :args {:test {:parent :is-a? :args {:value :_history-revision :type {:value :int}}}
          :then {:parent :gt :args {:nums [{:ref :_history-revision :type :int} 0]}}
          :else false}}
  {:name :_history-restore-args-valid?
   :parent :and
   :args {:values [{:parent :is-a? :args {:value {:as :fn-id :type :nullable-uuid} :type {:value :uuid}}}
                   {:parent :is-a? :args {:value {:as :branch-id :type :nullable-uuid} :type {:value :uuid}}}
                   :_history-positive-revision?]}}
  {:name :_history-restore-error-kind
   :parent :get
   :args {:coll {:parent :ex-data :args {:ex {:as :exception}}}
          :key {:value :type} :default nil}}
  {:name :_history-restore-on-throw
   :parent :if
   :args {:test {:parent :or :args {:values [{:parent :equal? :args {:a :_history-restore-error-kind :b {:value :history/branch-mismatch}}}
                                             {:parent :equal? :args {:a :_history-restore-error-kind :b {:value :history/too-large}}}
                                             {:parent :equal? :args {:a :_history-restore-error-kind :b {:value :history/incomplete-provenance}}}
                                             {:parent :equal? :args {:a :_history-restore-error-kind :b {:value :history/secret-type-conflict}}}]}}
          :then {:parent :zipmap
                 :args {:keys [{:value :status} {:value :reason}] :vals [{:value :conflict} :_history-restore-error-kind]}}
          :else {:parent :throw :args {:exception {:as :exception}}}}}
  {:name :_history-restore-preview-try
   :parent :try
   :args {:body :_preview-fn-history-restore :on-throw :_history-restore-on-throw}}
  {:name :preview-fn-history-restore
   :description "Validate restore arguments and map safe conflicts around the canonical redacted preview."
   :parent :if
   :args {:test :_history-restore-args-valid? :then :_history-restore-preview-try :else nil
          :fn-id {:type :nullable-uuid :required false}
          :branch-id {:type :nullable-uuid :required false}
          :revision {:type :nullable-int :required false}}
   :return-type :nullable-jsonb}
  {:name :_history-restore-token
   :parent :const :args {:value {:as :expected-current :type :nullable-text}}}
  {:name :_history-restore-token-valid?
   :parent :if
   :args {:test {:parent :is-a? :args {:value :_history-restore-token :type {:value :text}}}
          :then {:parent :equal?
                 :args {:a {:parent :str-len :args {:string {:ref :_history-restore-token :type :text}}}
                        :b 64}}
          :else false}}
  {:name :_history-restore-commit-try
   :parent :try
   :args {:body :_commit-fn-history-restore :on-throw :_history-restore-on-throw}}
  {:name :commit-fn-history-restore
   :description "Validate restore arguments/token and map safe conflicts around exact-token mutation and secret-flow validation."
   :parent :if
   :args {:test {:parent :and :args {:values [:_history-restore-args-valid? :_history-restore-token-valid?]}}
          :then :_history-restore-commit-try :else nil
          :fn-id {:type :nullable-uuid :required false}
          :branch-id {:type :nullable-uuid :required false}
          :revision {:type :nullable-int :required false}
          :expected-current {:type :nullable-text :required false}}
   :return-type :nullable-jsonb}

  ;; GET /api/fns/:fn-id/history/diff?branch-id=X&from=N&to=M.
  ;; Parse request data in the graph. The storage primitive accepts typed
  ;; values only and enforces the scoped identity read inside one transaction.
  {:name :_history-diff-fn-id
   :parent :parse-uuid
   :args {:string {:parent :uri-segment-after
                   :args {:marker {:value "fns"}}}}}

  {:name :_history-diff-branch-id
   :parent :parse-uuid
   :args {:string {:parent :query-param
                   :args {:request {:as :request}
                          :param-name {:value "branch-id"}}}}}

  {:name :_history-diff-from-raw
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "from"}}}

  {:name :_history-diff-to-raw
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "to"}}}

  {:name :_history-diff-from-parsed
   :parent :parse-int
   :args {:s :_history-diff-from-raw}}

  {:name :_history-diff-to-parsed
   :parent :parse-int
   :args {:s :_history-diff-to-raw}}

  {:name :_history-diff-from
   :parent :if
   :args {:test {:parent :some? :args {:value :_history-diff-from-raw}}
          :then {:parent :try
                 :args {:body :_history-diff-from-parsed
                        :on-throw {:parent :const :args {:value nil}}}}
          :else nil}}

  {:name :_history-diff-to
   :parent :if
   :args {:test {:parent :some? :args {:value :_history-diff-to-raw}}
          :then {:parent :try
                 :args {:body :_history-diff-to-parsed
                        :on-throw {:parent :const :args {:value nil}}}}
          :else nil}}

  {:name :_history-diff-loaded
   :parent :load-fn-history-diff
   :args {:fn-id :_history-diff-fn-id
          :branch-id :_history-diff-branch-id
          :from-revision :_history-diff-from
          :to-revision :_history-diff-to}}

  {:name :_history-diff-too-large?
   :parent :equal?
   :args {:a {:parent :get
              :args {:coll :_history-diff-loaded
                     :key {:value :error-code} :default nil}}
          :b {:value :history/too-large}}}

  {:name :_history-diff-success-or-not-found
   :parent :if
   :args {:test {:parent :some? :args {:value :_history-diff-loaded}}
          :then {:parent :assoc
                 :args {:map {:parent :assert-some
                              :args {:value :_history-diff-loaded}}
                        :key {:value :ok} :value {:value true}}}
          :else {:parent :const
                 :return-type :error-result-status-shape
                 :args {:value {:ok false :error "History not found or invalid"
                                :http-status 404}}}}}

  {:name :_history-diff-data
   :parent :if
   :args {:test :_history-diff-too-large?
          :then {:parent :const
                 :return-type :error-result-status-shape
                 :args {:value {:ok false :error "History exceeds its size limit"
                                :http-status 413}}}
          :else :_history-diff-success-or-not-found}}

  {:name :fn-history-diff-handler
   :lambda-params [:request]
   :description "GET a bounded redacted graph diff at two revisions, or 404 for invalid/unreadable targets."
   :parent :json-envelope-response
   :args {:envelope :_history-diff-data}}

  {:name :_history-restore-revision-raw
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "revision"}}}

  {:name :_history-restore-revision
   :parent :try
   :args {:body {:parent :parse-int
                 :args {:s {:parent :assert-some
                            :args {:value :_history-restore-revision-raw}}}}
          :on-throw {:parent :const :args {:value nil}}}}

  {:name :_history-restore-preview-loaded
   :parent :preview-fn-history-restore
   :args {:fn-id :_history-diff-fn-id
          :branch-id :_history-diff-branch-id
          :revision :_history-restore-revision}}

  {:name :_history-restore-preview-envelope
   :parent :if
   :args {:test {:parent :some? :args {:value :_history-restore-preview-loaded}}
          :then {:parent :assoc
                 :args {:map {:parent :assert-some
                              :args {:value :_history-restore-preview-loaded}}
                        :key {:value :ok} :value {:value true}}}
          :else {:parent :const
                 :return-type :error-result-status-shape
                 :args {:value {:ok false :error "History not found or invalid"
                                :http-status 404}}}}}

  {:name :fn-history-restore-preview-handler
   :lambda-params [:request]
   :parent :json-envelope-response
   :args {:envelope :_history-restore-preview-envelope}}

  {:name :_history-restore-commit-body
   :parent :parse-json-body
   :args {:request {:as :request}}}

  {:name :_history-restore-commit-branch
   :parent :parse-uuid
   :args {:string {:parent :get
                   :args {:coll :_history-restore-commit-body
                          :key {:value :branch-id} :default nil}}}}

  {:name :_history-restore-commit-revision
   :parent :try
   :args {:body {:parent :parse-int
                 :args {:s {:parent :to-str
                            :args {:value {:parent :get
                                           :args {:coll :_history-restore-commit-body
                                                  :key {:value :revision}
                                                  :default nil}}}}}}
          :on-throw {:parent :const :args {:value nil}}}}

  {:name :_history-restore-commit-token
   :parent :get
   :args {:coll :_history-restore-commit-body
          :key {:value :expected-current} :default nil}}

  {:name :_history-restore-commit-loaded
   :parent :commit-fn-history-restore
   :args {:fn-id :_history-diff-fn-id
          :branch-id :_history-restore-commit-branch
          :revision :_history-restore-commit-revision
          :expected-current :_history-restore-commit-token}}

  {:name :_history-restore-commit-status
   :parent :get
   :args {:coll :_history-restore-commit-loaded
          :key {:value :status} :default nil}}

  {:name :_history-restore-commit-conflict?
   :parent :equal?
   :args {:a :_history-restore-commit-status
          :b {:value :conflict}}}

  {:name :_history-restore-commit-committed?
   :parent :equal?
   :args {:a :_history-restore-commit-status
          :b {:value :committed}}}

  {:name :_history-restore-commit-payload
   :parent :assoc
   :args {:map {:value {}} :key {:value :id}
          :value :_history-diff-fn-id}}

  {:name :_history-restore-commit-invalidate
   :parent :invalidate-after-write
   :args {:entity-type {:value "fn"}
          :entity-data :_history-restore-commit-payload}}

  {:name :_history-restore-commit-notify
   :parent :notify-after-write
   :args {:entity-type {:value "fn"} :op {:value "write"}
          :entity-data :_history-restore-commit-payload}}

  {:name :_history-restore-commit-fresh
   :parent :if
   :args {:test :_history-restore-commit-committed?
          :then {:parent :do
                 :args {:steps [:_history-restore-commit-invalidate
                                :_history-restore-commit-notify
                                :_history-restore-commit-loaded]}}
          :else :_history-restore-commit-loaded}}

  {:name :_history-restore-commit-success
   :parent :if
   :args {:test :_history-restore-commit-conflict?
          :then {:parent :assoc
                 :args {:map {:parent :assert-some
                              :args {:value :_history-restore-commit-loaded}}
                        :key {:value :http-status} :value {:value 409}}}
          :else :_history-restore-commit-fresh}}

  {:name :_history-restore-commit-envelope
   :parent :if
   :args {:test {:parent :some? :args {:value :_history-restore-commit-loaded}}
          :then {:parent :assoc
                 :args {:map {:parent :assert-some
                              :args {:value :_history-restore-commit-success}}
                        :key {:value :ok}
                        :value {:parent :not
                                :args {:value :_history-restore-commit-conflict?}}}}
          :else {:parent :const
                 :return-type :error-result-status-shape
                 :args {:value {:ok false :error "Invalid restore request"
                                :http-status 400}}}}}

  {:name :fn-history-restore-commit-handler
   :lambda-params [:request]
   :parent :json-envelope-response
   :args {:envelope :_history-restore-commit-envelope}}

  ;; ---------------------------------------------------------------------
  ;; fn-versions popover (second migration). Pulls the existing
  ;; `:list-fn-versions` data chain (in `app.branches`) for one fn-id
  ;; from a query-string param, then maps each enriched version row
  ;; into a hiccup `<div class="fn-versions-row">`. JS keeps only
  ;; the fetch, anchoring, dismissal, AND the per-row switch /
  ;; restore handlers (those rebind after innerHTML swap via the
  ;; existing `data-switch-to-branch` / `data-fn-version-id` markers
  ;; this fragment carries — same shape the legacy JS-built rows
  ;; produced, so the e2e contract is preserved).
  ;; ---------------------------------------------------------------------


  {:name :_partial-fn-versions-current-branch
   :description "Currently-selected branch name (from `?current-branch=`), used to highlight the matching row in the timeline. Empty string when absent — no row gets the `-current` class."
   :parent :query-param
   :args {:request {:as :request}
          :param-name {:value "current-branch"}}}

  {:name :_partial-fn-versions-data
   :description "Live versions data for the requested fn — wraps `:list-fn-versions`."
   :parent :list-fn-versions
   :args {:fn-id :fn-id-param}}

  {:name :_partial-fn-versions-rows
   :description "The `:versions` list out of `:list-fn-versions`'s envelope — already sorted latest-first, each row enriched with `:branch-name` and `:execution-count`."
   :parent :get
   :args {:coll :_partial-fn-versions-data
          :key {:value :versions}
          :default {:value []}}}

  {:name :_partial-fn-versions-count
   :parent :count
   :args {:coll :_partial-fn-versions-rows}}

  {:name :_partial-fn-versions-empty?
   :parent :empty?
   :args {:coll :_partial-fn-versions-rows}}

  ;; --- Per-row HOF callback. Pure rendering: takes one enriched
  ;; version row (`:item`), returns a hiccup `<div class="fn-versions-row">`
  ;; with the same CSS classes + data-attributes the legacy JS produced
  ;; (post-swap JS binds switch / restore handlers by selector).

  {:name :_partial-fnv-row-branch-name
   :parent :get
   :args {:coll {:as :item} :key {:value :branch-name} :default {:value "(unknown)"}}}

  {:name :_partial-fnv-row-version-id
   :parent :get
   :args {:coll {:as :item} :key {:value :id} :default {:value ""}}}

  {:name :_partial-fnv-row-created-at
   :parent :get
   :args {:coll {:as :item} :key {:value :created-at} :default {:value ""}}}

  ;; Timestamp shown as "YYYY-MM-DD HH:MM" — first 16 chars of either
  ;; "2026-05-24 06:21:21.103" (SQL) or "2026-05-24T06:35Z" (ISO).
  ;; `:subs` errors on shorter strings; coalesce to "" via the default
  ;; above keeps us out of the edge.
  {:name :_partial-fnv-row-ts-short
   :parent :subs
   :args {:string :_partial-fnv-row-created-at
          :start {:value 0}
          :end {:value 16}}}

  {:name :_partial-fnv-row-on-current?
   :parent :equal?
   :args {:a :_partial-fnv-row-branch-name
          :b :_partial-fn-versions-current-branch}}

  {:name :_partial-fnv-row-branch-class
   :description "`fn-versions-branch` plus `fn-versions-branch-current` when the row's branch matches the current-branch query param."
   :parent :if
   :args {:test :_partial-fnv-row-on-current?
          :then {:value "fn-versions-branch fn-versions-branch-current"}
          :else {:value "fn-versions-branch"}}}

  {:name :_partial-fnv-row-branch-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:parent :assoc
                  :args {:map {:value {}}
                         :key {:value :class}
                         :value :_partial-fnv-row-branch-class}}
          :children [:_partial-fnv-row-branch-name]}}

  {:name :_partial-fnv-row-ts-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "fn-versions-ts"}}
          :children [:_partial-fnv-row-ts-short]}}

  ;; Description text (e.g. "desc=hello world") — same
  ;; describeVersionContent logic the JS does. v1: just description
  ;; when present, otherwise empty span — keeps the row layout stable.
  {:name :_partial-fnv-row-description-text
   :parent :get
   :args {:coll {:as :item} :key {:value :description} :default {:value ""}}}

  {:name :_partial-fnv-row-author-label
   :description "Display-safe actor label stamped by the server; older versions have no author."
   :parent :get
   :args {:coll {:as :item} :key {:value :author-label}
          :default {:value "unknown author"}}}

  {:name :_partial-fnv-row-author-text
   :parent :str-join
   :args {:coll [{:value "by "} :_partial-fnv-row-author-label]
          :separator {:value ""}}}

  {:name :_partial-fnv-row-author-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "fn-versions-author"}}
          :children [:_partial-fnv-row-author-text]}}

  {:name :_partial-fnv-row-meta-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "fn-versions-row-meta"}}
          :children [:_partial-fnv-row-description-text
                     :_partial-fnv-row-author-span]}}

  ;; Disable Restore when the fields it writes already match this branch.
  ;; Comparing the effective fields also handles inherited branch versions.
  {:name :_partial-fnv-row-restore-needed?
   :parent :get
   :args {:coll {:as :item} :key {:value :restore-needed?}
          :default {:value false}}}

  {:name :_partial-fnv-row-restore-base-attrs
   :parent :if
   :args {:test :_partial-fnv-row-restore-needed?
          :then {:value {:class "fn-versions-restore"
                         :title "Restore function fields on this branch; argument bindings stay unchanged"}}
          :else {:value {:class "fn-versions-restore" :disabled true
                         :title "These function fields already match this branch; argument bindings are separate"}}}}

  {:name :_partial-fnv-row-restore-attrs
   :parent :assoc
   :args {:map :_partial-fnv-row-restore-base-attrs
          :key {:value :data-fn-version-id}
          :value :_partial-fnv-row-version-id}}

  {:name :_partial-fnv-row-restore-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_partial-fnv-row-restore-attrs
          :children ["restore"]}}

  ;; Switch button — only when this row's branch differs from the
  ;; currently-active branch. Stays as an empty placeholder span on
  ;; the current-branch row so the children-list length is stable.
  {:name :_partial-fnv-row-switch-title-prefix
   :parent :str-join
   :args {:coll [{:value "Switch the editor to "}
                 :_partial-fnv-row-branch-name]
          :separator {:value ""}}}

  {:name :_partial-fnv-row-switch-attrs-base
