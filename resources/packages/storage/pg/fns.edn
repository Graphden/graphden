;; Application-level Postgres base-fns.
;;
;; These reuse graphden's own pooled datasource — for connecting to
;; ARBITRARY databases with per-call creds use `web/sql` instead.
;;
;; SQL is built from HoneySQL maps (see https://github.com/seancorfield/honeysql)
;; to keep the surface declarative and parameterised by default —
;; users do not concatenate SQL strings.

{:namespace "storage.pg"
 :description "Application-level Postgres access against the pooled datasource backing graphden itself, using HoneySQL maps."
 :fns
 [;; ---------------------------------------------------------------------
  ;; :pg-query — SELECT-shape HoneySQL → list of row-maps.
  ;;
  ;; Each row arrives as `{:column value}` (next.jdbc's
  ;; `as-unqualified-maps`: lower-snake-case keys, no table-qualifier
  ;; prefix). For consumers that want JSON shapes, `:jsonb` per item
  ;; is the right downstream type.
  ;; ---------------------------------------------------------------------
  {:name :pg-query
   :description "Run a SELECT-shape HoneySQL map against graphden's own datasource and return rows. Each row is `{:column value}` with unqualified, lower-snake-case column keys."
   :args {:hsql {:type :keyword-map
                 :description "HoneySQL map, e.g. `{:select [:id :name] :from :users :where [:= :id ?]}`. See honeysql docs for the full vocabulary."}}
   :return-type [:list :text-keyed-map]
   :effects #{:db :raw-sql}}

  ;; ---------------------------------------------------------------------
  ;; :pg-execute — mutation HoneySQL → affected row count (long).
  ;;
  ;; INSERT / UPDATE / DELETE / DDL all funnel through here. DDL
  ;; reports 0; DML reports `next.jdbc/update-count` flattened to a
  ;; plain int so downstream `:if` / `:>` can branch on it without
  ;; record-shape acrobatics.
  ;; ---------------------------------------------------------------------
  {:name :pg-execute
   :description "Run a mutation-shape HoneySQL map (INSERT / UPDATE / DELETE / DDL) against graphden's own datasource and return the affected row count (0 for DDL)."
   :args {:hsql {:type :keyword-map
                 :description "HoneySQL map describing the mutation."}}
   :return-type :int
   :effects #{:db :raw-sql}}

  ;; ---------------------------------------------------------------------
  ;; :pg-tx — run a body callable inside a JDBC transaction.
  ;;
  ;; `body` is a 0-arg fn-graph that does any number of :pg-query /
  ;; :pg-execute calls. They all run on the same connection inside a
  ;; BEGIN / COMMIT, with rollback on throw. The return value of the
  ;; transaction is the return value of `body`'s last computation.
  ;;
  ;; Nested :pg-tx reuses the outer transaction (JDBC has no true
  ;; nesting); the inner block commits / rolls back with the outer.
  ;; ---------------------------------------------------------------------
  {:name :pg-tx
   :description "Run a body inside a JDBC transaction against graphden's own datasource. All nested :pg-query / :pg-execute calls atomically share one connection; rollback on throw."
   :args {:body {:type [:fn {} :any]
                 :description "0-arg fn-graph executed inside the transaction. Its return value is returned by :pg-tx."}}
   :return-type :any
   :effects #{:db :raw-sql}}

  ;; ---------------------------------------------------------------------
  ;; :decode-row — raw JDBC row → graphden's canonical entity shape.
  ;;
  ;; `:pg-query` returns rows in their RAW shape — snake_case column
  ;; keys (`fn_id`, `restart_policy`), enum strings (`"always"`), jsonb
  ;; PGobjects, and timestamps as JDBC strings. graphden's downstream
  ;; consumers expect the decoded shape: kebab-case kw keys (`:fn-id`,
  ;; `:restart-policy`), enum kw values (`:always`), Clojure data for
  ;; jsonb, `Instant` for timestamps.
  ;;
  ;; `:decode-row` does this transformation in graph form — single
  ;; row only; consumers compose `:map :func :decode-row :coll
  ;; <pg-query result>` for batches. Looks up the entity's field-specs
  ;; via storage-protocol introspection (`current-fields`) so no
  ;; storage-backend internals leak into the graph layer.
  ;; ---------------------------------------------------------------------
  {:name :decode-row
   :description "Decode one raw next.jdbc row into graphden's canonical entity shape (snake_case → kebab-case kw, enum strings → keywords, jsonb PGobjects → Clojure data, etc.). Field metadata is fetched per `entity-type`."
   :args {:row {:type [:union :null :text-keyed-map]
                :description "Raw row map from `:pg-query` — snake_case STRING column keys with undecoded values. Nullable at type level so callers can pass `:first` of an empty result; the impl handles nil by returning nil."}
          :entity-type {:type :text
                        :description "Entity table name (e.g. `\"service\"`, `\"fn\"`). Used to look up field-specs for decoding."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  ;; ---------------------------------------------------------------------
  ;; :pg-notify — emit `pg_notify` event for cross-pod sync.
  ;;
  ;; Sibling pods LISTEN on `graphden_events`; mutations on one pod
  ;; (e.g. an admin toggles a `:service` row on pod A) propagate to
  ;; the others within ~1s. The reconciler / compiled-registry
  ;; consume kind-specific payloads (`{:kind :service :op :write
  ;; :id "uuid-..."}` for services; `{:kind :fn :op :invalidate
  ;; :id "uuid-..."}` for fn-graph changes) — graph composition picks
  ;; the right shape per write site.
  ;;
  ;; Best-effort: a NOTIFY failure is logged but doesn't throw —
  ;; sibling pods catch up at the next mutation cycle.
  ;; ---------------------------------------------------------------------
  {:name :pg-notify
   :description "Emit a `pg_notify` event on `graphden_events` so sibling pods react to a local write. `:event` shape varies by kind — see system/core.clj LISTEN callbacks for the consumer contract. Best-effort: failures are logged but don't throw."
   :args {:event {:type :keyword-map
                  :description "Event payload. Standard shapes: `{:kind :fn :op :invalidate :id <uuid-str>}` (fn-graph mutation), `{:kind :service :op :write|:delete :id <uuid-str>}` (service row)."}}
   :return-type :null
   :effects #{:db}}

  ;; ---------------------------------------------------------------------
  ;; :storage-query-identities — base-storage `query-entities` (versioning bypass).
  ;;
  ;; For VERSIONED entities (`:fn` / `:fn-slot` / `:binding` /
  ;; `:binding-list-item`) the wrapping VersionedStorage intercepts
  ;; `query-entities` and routes it through `resolve-all-entities`,
  ;; merging identity + version rows on the current branch. That's
  ;; what `:list-entities` does today. To express versioned reads as
  ;; pure graph composition (Block 1 Step 2 Phase 3) we need to load
  ;; identity rows DIRECTLY — without version resolution — and run
  ;; the merge in graph form via `:resolve-versioned-rows`.
  ;;
  ;; This primitive unwraps the VersionedStorage wrapper and calls
  ;; `sp/query-entities` against the base storage. The result is
  ;; codec-decoded and has `:ref-many` fields (e.g. `:fn`'s
  ;; `:parent-ids`) populated from junction tables — which a raw
  ;; `:pg-query` would NOT include. For non-versioned entities,
  ;; prefer `:pg-query` + `:decode-row` since the SQL stays explicit
  ;; at the graph level.
  ;; ---------------------------------------------------------------------
  {:name :storage-query-identities
   :description "Query identity rows of an entity DIRECTLY against base storage (bypassing VersionedStorage). Returns codec-decoded rows with `:ref-many` fields populated from junction tables. Use as the identity-load input to `:resolve-versioned-rows`."
   :args {:entity-type {:type :text
                        :description "Entity table name, e.g. `\"fn\"`, `\"binding\"`."}
          :where {:type :nullable-keyword-map
                  :description "Equality-map (`{:column value}` or `{:column [v1 v2 …]}` for IN). Empty / nil → full scan."}}
   :return-type [:list :keyword-map]
   :effects #{:db}}

  ;; ---------------------------------------------------------------------
  ;; :invalidate-graph-cache — drop executor caches after a write.
  ;;
  ;; Every fn-graph write site (`_create-apply`, `_update-apply`,
  ;; `_delete-apply`, plus the secret + branch + type-row variants)
  ;; calls `invalidate-graph-cache!` after a successful mutation so
  ;; subsequent reads see the new state. Exposing this as a primitive
  ;; lets writes that decompose into graph composition (Block 1 Step 2
  ;; Phase 4) bind the invalidate as a regular composition step.
  ;; ---------------------------------------------------------------------
  {:name :invalidate-graph-cache
   :description "Low-level ctx-cache drop. `seeds` empty / nil → full clear; non-empty → delta invalidate just those fn-ids + transitive dependents. NOTE: a fn-graph WRITE must NOT parent on this directly — it drops the cache but does NOT restart cron/loop services holding the pre-edit closure, nor emit the cross-pod NOTIFY. Use `:invalidate-after-write` for writes (it wraps this + the restart hook). Guarded by `write-invalidation-parity-test`."
   :args {:seeds {:type [:list :uuid]
                  :description "fn-ids whose closure should be invalidated. Empty / nil performs a full clear."
                  :required false}}
   :return-type :null
   :effects #{:db}}

  ;; ---------------------------------------------------------------------
  ;; :invalidate-after-write — entity-type-aware cache invalidation.
  ;;
  ;; Derives the affected-fn-id seeds from `entity-type` + `entity-data`
  ;; (`:fn` writes seed themselves, `:fn-slot` / `:binding` seed their
  ;; owner fn-id, `:binding-list-item` reads the parent binding,
  ;; other types fall through to a full clear) and invalidates.
  ;; Use in write-site graph composition to keep the seed-shape case-
  ;; dispatch in one place.
  ;; ---------------------------------------------------------------------
  {:name :invalidate-after-write
   :description "Cache-invalidate after a write: derive affected-fn-ids from entity-type + entity-data, then invalidate. Use in write-site graph composition as the post-write effect step."
   :args {:entity-type {:type :text :description "Entity table name, e.g. `\"fn\"`, `\"binding\"`."}
          :entity-data {:type :nullable-keyword-map
                        :description "The just-written / about-to-be-deleted entity payload (incl. `:id` and any FKs needed for seed derivation)."}}
   :return-type :null
   :effects #{:db}}

  ;; ---------------------------------------------------------------------
  ;; :notify-after-write — fire pg_notify event(s) describing the
  ;; just-completed write so sibling pods react. Service writes get
  ;; `{:kind :service :op <op> :id}`, fn-graph writes get one
  ;; `{:kind :fn :op :invalidate :id <seed>}` per affected seed.
  ;; ---------------------------------------------------------------------
  {:name :notify-after-write
   :description "Emit pg_notify events describing the write. Service: `{:kind :service :op <op> :id}`. Fn-graph entities: one `{:kind :fn :op :invalidate :id <seed>}` per affected seed."
   :args {:entity-type {:type :text :description "Entity table name."}
          :op {:type :text :description "CRUD op kind — `\"write\"` or `\"delete\"`."}
          :entity-data {:type :nullable-keyword-map
                        :description "Entity payload — incl. `:id` and FKs for seed derivation."}}
   :return-type :null
   :effects #{:db}}

  ;; ---------------------------------------------------------------------
  ;; Schema migrations — `:migration` + `:migrate`.
  ;;
  ;; The Flyway / Rails-migrations shape as two fn-def TEMPLATES (no
  ;; new base-fn — the same role `:schedule` plays for cron services):
  ;;
  ;;   {:name :m-001 :parent :migration
  ;;    :args {:id "001-users" :ddl {:value {:create-table :users …}}}}
  ;;   {:name :m-002 :parent :migration
  ;;    :args {:id "002-users-email" :ddl {:value {:alter-table :users …}}}}
  ;;   {:name :app-migrate :parent :migrate :args {:migrations [:m-001 :m-002]}}
  ;;   {:name :app-service :parent :do :args {:steps [:app-migrate :web-server]}}
  ;;
  ;; `:app-service` is the service fn: `:do` runs the migrator, then
  ;; the listener whose stopper it returns (inheriting `:process`).
  ;; The migration LIST is graph structure, not data — each migration
  ;; is a node, the journal only ever grows (`{:append [...]}` on a
  ;; derived fn-def extends it without touching the parent), and the
  ;; write hook / merge restart the service so a newly added migration
  ;; applies on the next start. Concurrency is Flyway's: the run is ONE
  ;; transaction under `pg_advisory_xact_lock`, so N pods starting at
  ;; once serialise and the late ones find nothing pending; a failing
  ;; migration rolls the whole run back, markers included.
  ;;
  ;; These run against graphden's OWN datasource — a service on a
  ;; branch migrates the same physical database main uses (branches
  ;; version the graph, not Postgres). For a user database reach for
  ;; the branch-local `:env` DSN + `web/sql` instead.
  ;; ---------------------------------------------------------------------
  {:name :migration
   :description "One guarded schema migration — runs `:ddl` once, keyed by `:id` in the `schema_migrations` journal. In a transaction: when no marker row for `:id` exists, execute `:ddl` and insert the marker (returns 1); otherwise a no-op (returns nil). Derivatives bind `:id` (stable, append-only naming like \"001-users\") and `:ddl` (a HoneySQL map) and are listed in a `:migrate` derivative's `:migrations`."
   :parent :pg-tx
   :args {:body :_migration-guarded}}

  ;; `:else nil` is explicit so `:if`'s `:else` slot does not surface as
  ;; a free arg of every migration (and of the service `:do` above it,
  ;; which the create-service guard would refuse) — same as the guards
  ;; in web/crud-write.
  {:name :_migration-guarded
   :description "Transaction body of `:migration` — apply only when the journal has no marker for `:id`; nil when already applied."
   :parent :if
   :args {:test :_migration-pending?
          :then :_migration-applied
          :else nil}}

  {:name :_migration-pending?
   :description "True when `schema_migrations` holds no row for the captured `:id`."
   :parent :empty?
   :args {:coll :_migration-marker-rows}}

  {:name :_migration-marker-rows
   :description "Marker rows for the captured `:id` — `[]` or `[{:id …}]`."
   :parent :pg-query
   :args {:hsql :_migration-marker-select}}

  {:name :_migration-marker-select
   :description "`{:select [:id] :from :schema_migrations :where [:= :id <id>]}` assembled around the captured `:id`."
   :parent :assoc
   :args {:map {:value {:select [:id] :from :schema_migrations}}
          :key {:value :where}
          :value :_migration-id-eq}}

  ;; Named (not inline) so the `{:as :id}` rename lifts to the outer
  ;; fn-def — see `:_cron-parsed` in core/concurrency for the same rule.
  {:name :_migration-id-eq
   :description "`[:= :id <id>]` — the journal lookup predicate over the captured `:id`."
   :parent :conj
   :args {:coll {:value [:= :id]}
          :item {:as :id}}}

  {:name :_migration-applied
   :description "Apply step: run the captured `:ddl`, then insert the journal marker. Returns the marker insert count (1)."
   :parent :do
   :args {:steps [:_migration-ddl-run :_migration-marker-insert]}}

  {:name :_migration-ddl-run
   :description "Execute the captured `:ddl` HoneySQL map on the transaction's connection."
   :parent :pg-execute
   :args {:hsql {:as :ddl}}}

  {:name :_migration-marker-insert
   :description "Insert the `schema_migrations` marker row for the captured `:id`."
   :parent :pg-execute
   :args {:hsql :_migration-marker-insert-hsql}}

  {:name :_migration-marker-insert-hsql
   :description "`{:insert-into :schema_migrations :columns [:id] :values [[<id>]]}` assembled around the captured `:id`."
   :parent :assoc
   :args {:map {:value {:insert-into :schema_migrations :columns [:id]}}
          :key {:value :values}
          :value :_migration-id-rows}}

  {:name :_migration-id-rows
   :description "`[[<id>]]` — the single-row `:values` of the marker insert."
   :parent :conj
   :args {:coll {:value []}
          :item :_migration-id-row}}

  {:name :_migration-id-row
   :description "`[<id>]` — the marker row's column values."
   :parent :conj
   :args {:coll {:value []}
          :item {:as :id}}}

  {:name :migrate
   :description "Run `:migrations` (a vector of `:migration` derivatives, in order) once, as ONE transaction under `pg_advisory_xact_lock` — concurrent starts (N pods) serialise and the late ones find nothing pending; a throw rolls the whole run back. Ensures the `schema_migrations` journal table first. Returns the last migration's result. Derivatives bind `:migrations` (extend with `{:append [...]}`) and go first in the service's `:do`."
   :parent :pg-tx
   :args {:body :_migrate-body}}

  {:name :_migrate-body
   :description "Transaction body of `:migrate`: take the advisory lock, ensure the journal table, run the captured `:migrations`."
   :parent :do
   :args {:steps [:_migrations-locked :_migrations-table-ensured :_migrations-run]}}

  ;; Fixed key: every graphden deployment shares one migrator lock —
  ;; the journal table is one per database anyway. `:inline` keeps the
  ;; literal in the SQL text so the bigint overload is chosen.
  {:name :_migrations-locked
   :description "`SELECT pg_advisory_xact_lock(7441)` — held until the surrounding `:migrate` transaction commits or rolls back."
   :parent :pg-query
   :args {:hsql {:value {:select [[[:pg_advisory_xact_lock [:inline 7441]] :locked]]}}}}

  {:name :_migrations-table-ensured
   :description "`CREATE TABLE IF NOT EXISTS schema_migrations (id text primary key, applied_at timestamptz not null default now())`."
   :parent :pg-execute
   :args {:hsql {:value {:create-table [:schema_migrations :if-not-exists]
                         :with-columns [[:id :text [:primary-key]]
                                        [:applied_at :timestamptz [:not nil] [:default [:raw "now()"]]]]}}}}

  ;; `:steps` renamed to `:migrations` — the descendant's bare vector of
  ;; `:migration` refs binds through the rename as list ITEMS (loader
  ;; `slot-type-of` types a pure rename from its source; the runtime
  ;; list-chain reader picks the items up from the rename slot).
  {:name :_migrations-run
   :description "Run the captured `:migrations` in declaration order (`:do` semantics — left-to-right, last result returned)."
   :parent :do
   :args {:steps {:as :migrations}}}

  ;; ---------------------------------------------------------------------
  ;; :postgres-storage-impl — first concrete realisation of :Storage.
  ;;
  ;; Parents to the type-row `:Storage` from storage.protocol; each
  ;; :fn-typed slot is bound to the matching pg-* base-fn. Consumers
  ;; bind this fn-def (or any other :Storage implementation) at the
  ;; top of their chain to satisfy the storage protocol — see
  ;; PHILOSOPHY § Self-Describing System → Protocols via type-row.
  ;; ---------------------------------------------------------------------
  {:name :postgres-storage-impl
   :description "Storage protocol implementation backed by graphden's own pooled Postgres datasource. Inject at the top of a consumer chain to bind storage to the platform's own DB."
   :parent :Storage
   :args {:query   :pg-query
          :execute :pg-execute
          :tx      :pg-tx}}]}
