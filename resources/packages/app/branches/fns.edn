;; Read-side fn-defs for the /api/branches/* and
;; /api/fns/:fn-id/versions endpoints.
;;
;; Each `_*-data` base-fn returns the JSON-shape payload; the
;; matching `*-handler` wraps it with the `:json-handler` template
;; (200 application/json). Concrete routes live in `app.routes`.
;;
;; All four endpoints are read-only — handlers stay unauthenticated
;; for now (mirrors GET /api/graph/entities). Write endpoints
;; (POST/DELETE/merge) land in a follow-up commit and inherit the
;; auth-required preset.


{:namespace "app.branches"
 :description "Read-side endpoints for the versioning UI — list branches, look up one branch, list a fn's version history, diff two branches. Backed by `graphden.crud.branches` + `graphden.versioning.storage.{core,merge}`. Concrete routes are wired in `app.routes`."
 :fns
 [;; ---------------------------------------------------------------------
  ;; BASE-FN — shared branch lookup. Accepts a UUID string or a name,
  ;; returns the branch row or nil. Composed by every parser-driven
  ;; lookup (diff / conflicts / merge / delete) instead of going through
  ;; per-handler defbase shims.
  ;; ---------------------------------------------------------------------

  {:name :resolve-branch-ref
   :description "Look up a branch by `:ref` — accepts either a stringified UUID or a branch name. Returns the row, or nil when not found / ref is blank / ref isn't a string. Operates on the unwrapped base storage so reads see across versions."
   :args {:ref {:type [:union :null :text] :required false :description "UUID string or branch name. Non-string / blank → nil."}}
   :return-type [:union :null :_entity-field-map]
   :effects #{:db}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/branches — list every branch row, ordered by created-at.
  ;; ---------------------------------------------------------------------

  ;; GET /api/branches — graph composition: list-entities → sort-by
  ;; created-at → :map :as-json-branch → :zipmap envelope.
  ;; Reuses the same `:as-json-branch` row converter as
  ;; `:_get-branch-data`. Admin extension surface:
  ;;   * `:_list-branches-sort-key` — sort dimension (created-at /
  ;;     name / base-branch chain).
  ;;   * `:as-json-branch` — per-row JSON shape (single point of
  ;;     variation; touching this changes EVERY branch-returning
  ;;     handler too).
  ;;   * `:_list-branches-data` envelope — `{:ok :count :branches}`
  ;;     shape; replace for JSON:API, pagination, etc.
  ;; --- Block 1 Step 2 migration: row load goes through `:pg-query`
  ;; + per-row `:decode-row` instead of the generic `:list-entities`
  ;; wrap. `:branch` is non-versioned (per `versioning.storage.
  ;; resolution/entity-config`), so a raw pg-query bypasses the
  ;; version-resolution layer correctly. The HoneySQL is now
  ;; visible at the graph level — admins can add `:where` / extra
  ;; columns without touching the generic loader.
  {:name :_list-branches-rows
   :parent :map
   :args {:func :_list-branches-decode-row
          :coll :_list-branches-rows-raw}}

  {:name :_list-branches-rows-raw
   :description "Raw `SELECT * FROM branch` — snake_case column keys, undecoded enum/jsonb. Decoded per-row by `:_list-branches-decode-row`."
   :parent :storage-query-call
   :args {:arg {:value {:select [:*] :from :branch}}}}

  {:name :_list-branches-decode-row
   :description "HOF callback — decode one raw `:branch` row to graphden's canonical shape."
   :parent :decode-row
   :args {:row {:as :item}
          :entity-type {:value "branch"}}}

  {:name :_list-branches-sort-key
   :description "Per-row sort key — `:created-at` ascending (so the editor renders the forked-from chain in order)."
   :parent :get
   :args {:coll {:as :item} :key {:value :created-at} :default nil}}

  {:name :_list-branches-sorted
   :parent :sort-by
   :args {:key-fn :_list-branches-sort-key :coll :_list-branches-rows}}

  ;; HOF callback wrapping `:as-json-branch` — the free arg surface
  ;; differs (`:as-json-branch` expects `:branch-row`, HOF binds
  ;; `:item`). Bridge via an intermediate fn-def.
  {:name :_list-branches-as-json-item
   :parent :as-json-branch
   :args {:branch-row {:as :item}}}

  {:name :_list-branches-json
   :parent :map
   :args {:func :_list-branches-as-json-item
          :coll :_list-branches-sorted}}

  {:name :_list-branches-count
   :parent :count
   :args {:coll :_list-branches-sorted}}

  {:name :_list-branches-data
   :description "GET /api/branches — every :branch row off base storage, sorted by `:created-at` ascending, shaped via `:as-json-branch`."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :count} {:value :branches}]
          :vals [{:value true} :_list-branches-count :_list-branches-json]}}

  {:name :list-branches-handler
   :description "Ring handler for GET /api/branches."
   :parent :json-handler
   :args {:data :_list-branches-data}}

  ;; ---------------------------------------------------------------------
  ;; Shared JSON-coercion helpers — reused by branch / fn-version /
  ;; diff-entry / conflict-entry response shapes. Stringify any UUID
  ;; or timestamp value so jsonista doesn't choke.
  ;; ---------------------------------------------------------------------

  {:name :_is-uuid-or-inst?
   :description "True for values that need stringification before JSON encode — UUIDs and timestamps. Other scalars (bool / string / int) pass through. HOF-shaped: reads `:value` from the per-call binding."
   :parent :or
   :args {:values [{:parent :is-a? :args {:value {:as :value} :type {:value :uuid}}}
                   {:parent :is-a? :args {:value {:as :value} :type {:value :timestamptz}}}]}}

  {:name :_stringify-uuid-or-inst
   :description "HOF callable for `:update-vals` — stringify a UUID / timestamp, pass everything else through."
   :parent :if
   :args {:test :_is-uuid-or-inst?
          :then {:parent :to-str :args {:value {:as :value}}}
          :else {:as :value}}}

  {:name :stringify-uuids
   :description "Shallow stringify of UUIDs and timestamps in a map's values (mirrors `branches/stringify-uuids` Clojure helper). Nil-safe — `nil` in → `nil` out. Reused by diff-entry and conflict-entry per-row reshapes."
   :parent :if
   :args {:test {:parent :some? :args {:value {:as :m}}}
          :then {:parent :update-vals
                 :args {:m {:as :m} :f :_stringify-uuid-or-inst}}
          :else {:value nil}}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/branches/:ref — one branch (by UUID or name).
  ;; ---------------------------------------------------------------------

  ;; GET /api/branches/:ref — graph composition over the already-
  ;; decomposed `:resolve-branch-ref` plus a reusable
  ;; `:as-json-branch` row-to-JSON converter. Admins can:
  ;;   * Replace `:as-json-branch` to expose extra columns or different
  ;;     field names (`{:ok :data}` instead of `{:ok :branch}`, add a
  ;;     `:metadata` field, etc.).
  ;;   * Replace `:_get-branch-success` / `:_get-branch-err` to change
  ;;     the response envelope shape entirely.
  ;;   * The same `:as-json-branch` is reused by `:_list-branches-data`
  ;;     when it's eventually decomposed — single point of variation.
  {:name :_branch-row-id
   :parent :get
   :args {:coll {:as :branch-row} :key {:value :id} :default nil}}

  {:name :_branch-row-name
   :parent :get
   :args {:coll {:as :branch-row} :key {:value :name} :default nil}}

  {:name :_branch-row-base-branch-id
   :parent :get
   :args {:coll {:as :branch-row} :key {:value :base-branch-id} :default nil}}

  {:name :_branch-row-created-at
   :parent :get
   :args {:coll {:as :branch-row} :key {:value :created-at} :default nil}}

  {:name :_branch-id-str
   :description "Nil-safe `(str :id)`."
   :parent :if
   :args {:test {:parent :some? :args {:value :_branch-row-id}}
          :then {:parent :to-str :args {:value :_branch-row-id}}
          :else nil}}

  {:name :_branch-base-id-str
   :description "Nil-safe `(some-> :base-branch-id str)`."
   :parent :if
   :args {:test {:parent :some? :args {:value :_branch-row-base-branch-id}}
          :then {:parent :to-str :args {:value :_branch-row-base-branch-id}}
          :else nil}}

  {:name :_branch-created-at-str
   :description "Nil-safe `(some-> :created-at str)`."
   :parent :if
   :args {:test {:parent :some? :args {:value :_branch-row-created-at}}
          :then {:parent :to-str :args {:value :_branch-row-created-at}}
          :else nil}}

  {:name :as-json-branch
   :description "Convert a `:branch` storage row into a JSON-safe map — `{:id (str id) :name name :base-branch-id (some-> base-branch-id str) :created-at (some-> created-at str)}`. Own pin `:branch-row`. Used by `:_get-branch-data` and reusable by any other handler that surfaces a branch row."
   :parent :zipmap
   :args {:keys [{:value :id} {:value :name} {:value :base-branch-id} {:value :created-at}]
          :vals [:_branch-id-str
                 :_branch-row-name
                 :_branch-base-id-str
                 :_branch-created-at-str]
          :branch-row {:type [:union :null :_entity-field-map]
                       :description "Storage row of a `:branch` entity — fields stringified for the JSON wire."}}}

  {:name :_get-branch-ref
   :description "URL segment after `branches/` — the UUID or name to resolve."
   :parent :uri-segment-after
   :args {:marker {:value "branches"}}}

  {:name :_get-branch-row
   :description "Resolve the URL ref to a `:branch` row, or nil when not found."
   :parent :resolve-branch-ref
   :args {:ref :_get-branch-ref}}

  {:name :_get-branch-found?
   :parent :some?
   :args {:value :_get-branch-row}}

  {:name :_get-branch-as-json
   :description "Apply `:as-json-branch` to the resolved row."
   :parent :as-json-branch
   :args {:branch-row :_get-branch-row}}

  {:name :_get-branch-success
   :description "Success shape — `{:ok true :branch <json>}`."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :branch}]
          :vals [{:value true} :_get-branch-as-json]}}

  {:name :_get-branch-err
   :description "404 shape — `{:ok false :error \"Branch not found: <ref>\"}`."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :error}]
          :vals [{:value false}
                 {:parent :str :args {:parts ["Branch not found: " :_get-branch-ref]}}]}}

  {:name :_get-branch-data
   :description "GET /api/branches/:ref — `:_get-branch-success` when the row resolves, `:_get-branch-err` otherwise. Pure graph composition over `:resolve-branch-ref` + `:as-json-branch` + `:zipmap`."
   :parent :if
   :args {:test :_get-branch-found?
          :then :_get-branch-success
          :else :_get-branch-err}}

  {:name :get-branch-handler
   :description "Ring handler for GET /api/branches/:ref."
   :parent :json-handler
   :args {:data :_get-branch-data}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/fns/:fn-id/versions — history of one fn across branches.
  ;; ---------------------------------------------------------------------

  ;; `:list-fn-versions` is now a full graph decomposition — multi-
  ;; query join over `:list-entities` + `:group-by` + `:update-vals`
  ;; + `:sort-by` + per-row HOF chain producing the JSON shape, plus
  ;; the envelope `{:ok :fn-id :count :versions}`.
  ;;
  ;; Admin extension surface — every field can be varied independently:
  ;;   * `:_lfv-version-fields` — bare-row field set. Add / remove
  ;;     columns by swapping this list.
  ;;   * `:_lfv-stringify-uuid-or-inst` — value transform. Swap for a
  ;;     custom timestamp formatter (ISO-8601, epoch-ms, etc.).
  ;;   * `:_lfv-version-row` — the assoc'd shape per version. Add
  ;;     custom computed fields (last-executor, latency stats, …).
  ;;   * `:_lfv-version-sort-key` — change the sort dimension
  ;;     (latest first → oldest first, or sort by execution-count).

  ;; --- URL / fn-id extraction
  {:name :_list-fn-versions-fn-id-raw
   :description "Raw `:fn-id` segment from `/api/fns/:fn-id/versions`."
   :parent :uri-segment-after
   :args {:marker {:value "fns"}}}

  {:name :_list-fn-versions-fn-id
   :description "Parsed UUID (nil when missing / malformed)."
   :parent :parse-uuid
   :args {:s :_list-fn-versions-fn-id-raw}}

  ;; --- Query #1: versions for the fn-id.
  ;; Block 1 Step 2 migration: direct `:pg-query` + per-row
  ;; `:decode-row` over `:fn-version`. `:fn-version` is itself a
  ;; non-versioned write-once log (the version-history of `:fn`),
  ;; so bypassing the version-resolution layer is correct.
  {:name :_lfv-versions-from-storage
   :parent :map
   :args {:func :_lfv-versions-decode-row
          :coll :_lfv-versions-raw}}

  {:name :_lfv-versions-raw
   :parent :storage-query-call
   :args {:arg :_lfv-versions-hsql}}

  {:name :_lfv-versions-hsql
   :parent :assoc
   :args {:map {:value {:select [:*] :from :fn-version}}
          :key {:value :where}
          :value :_lfv-versions-hsql-where}}

  {:name :_lfv-versions-hsql-where
   :parent :vec
   :args {:coll [{:value :=} {:value :fn-id} {:as :fn-id}]}}

  {:name :_lfv-versions-decode-row
   :parent :decode-row
   :args {:row {:as :item} :entity-type {:value "fn-version"}}}

  {:name :_lfv-versions
   :description "Empty when fn-id is nil; otherwise the live version rows."
   :parent :if
   :args {:test {:parent :some? :args {:value {:as :fn-id}}}
          :then :_lfv-versions-from-storage
          :else {:value []}}}

  ;; --- Sort: descending by :created-at.
  {:name :_lfv-version-sort-key
   :description "Per-row sort key — `:created-at`. Swap to sort by something else (e.g. `:_lfv-version-execution-count`)."
   :parent :get
   :args {:coll {:as :item} :key {:value :created-at} :default nil}}

  {:name :_lfv-versions-sorted-asc
   :parent :sort-by
   :args {:key-fn :_lfv-version-sort-key :coll :_lfv-versions}}

  {:name :_lfv-versions-sorted
   :description "Latest first."
   :parent :reverse
   :args {:coll :_lfv-versions-sorted-asc}}

  ;; --- Compute distinct, non-nil referenced branch-ids.
  {:name :_lfv-extract-branch-id
   :parent :get
   :args {:coll {:as :item} :key {:value :branch-id} :default nil}}

  {:name :_lfv-version-branch-ids
   :parent :map
   :args {:func :_lfv-extract-branch-id :coll :_lfv-versions}}

  {:name :_lfv-version-branch-ids-non-nil
   :parent :filter
   :args {:pred :some? :coll :_lfv-version-branch-ids}}

  {:name :_lfv-branch-ids-vec
   :parent :vec
   :args {:coll {:parent :distinct :args {:coll :_lfv-version-branch-ids-non-nil}}}}

  ;; --- Query #2: branches by IN(branch-ids).
  ;; Block 1 Step 2 migration: HoneySQL emits `id IN (?, ?, ...)`
  ;; via `[:in :id <ids-vec>]` — the same shape `:list-entities`'s
  ;; collection-value heuristic produced internally.
  {:name :_lfv-branches-from-storage
   :parent :map
   :args {:func :_lfv-branches-decode-row
          :coll :_lfv-branches-raw}}

  {:name :_lfv-branches-raw
   :parent :storage-query-call
   :args {:arg :_lfv-branches-hsql}}

  {:name :_lfv-branches-hsql
   :parent :assoc
   :args {:map {:value {:select [:*] :from :branch}}
          :key {:value :where}
          :value :_lfv-branches-hsql-where}}

  {:name :_lfv-branches-hsql-where
   :parent :vec
   :args {:coll [{:value :in} {:value :id} :_lfv-branch-ids-vec]}}

  {:name :_lfv-branches-decode-row
   :parent :decode-row
   :args {:row {:as :item} :entity-type {:value "branch"}}}

  {:name :_lfv-branches
   :description "Skip the read when no branches are referenced."
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_lfv-branch-ids-vec}}
          :then {:value []}
          :else :_lfv-branches-from-storage}}

  ;; --- Build {branch-id → branch} index for the join.
  {:name :_lfv-branch-id-of
   :parent :get
   :args {:coll {:as :item} :key {:value :id} :default nil}}

  {:name :_lfv-branch-id-pair
   :parent :vec
   :args {:coll [:_lfv-branch-id-of {:as :item}]}}

  {:name :_lfv-branch-id-pairs
   :parent :map
   :args {:func :_lfv-branch-id-pair :coll :_lfv-branches}}

  {:name :_lfv-branches-by-id
   :parent :pairs->map
   :args {:entries :_lfv-branch-id-pairs}}

  ;; --- Query #3: executions by IN(version-ids), grouped + counted.
  {:name :_lfv-version-id-of
   :parent :get
   :args {:coll {:as :item} :key {:value :id} :default nil}}

  {:name :_lfv-version-id-list
   :parent :map
   :args {:func :_lfv-version-id-of :coll :_lfv-versions}}

  {:name :_lfv-version-ids-vec
   :parent :vec
   :args {:coll :_lfv-version-id-list}}

  ;; --- Query #3: executions by IN(version-ids).
  ;; Block 1 Step 2 migration: same IN-clause pattern as branches.
  {:name :_lfv-execs-from-storage
   :parent :map
   :args {:func :_lfv-execs-decode-row
          :coll :_lfv-execs-raw}}

  {:name :_lfv-execs-raw
   :parent :storage-query-call
   :args {:arg :_lfv-execs-hsql}}

  {:name :_lfv-execs-hsql
   :parent :assoc
   :args {:map {:value {:select [:*] :from :fn-execution}}
          :key {:value :where}
          :value :_lfv-execs-hsql-where}}

  {:name :_lfv-execs-hsql-where
   :parent :vec
   :args {:coll [{:value :in} {:value :fn-version-id} :_lfv-version-ids-vec]}}

  {:name :_lfv-execs-decode-row
   :parent :decode-row
   :args {:row {:as :item} :entity-type {:value "fn-execution"}}}

  {:name :_lfv-execs
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_lfv-version-ids-vec}}
          :then {:value []}
          :else :_lfv-execs-from-storage}}

  {:name :_lfv-exec-version-id
   :parent :get
   :args {:coll {:as :item} :key {:value :fn-version-id} :default nil}}

  {:name :_lfv-execs-by-version-id
   :parent :group-by
   :args {:key-fn :_lfv-exec-version-id :coll :_lfv-execs}}

  {:name :_lfv-count-callable
   :description "HOF callable for `:update-vals` — replace each grouped execution-list with its count."
   :parent :count
   :args {:coll {:as :value}}}

  {:name :_lfv-exec-counts
   :description "`{version-id → execution-count}` index."
   :parent :update-vals
   :args {:m :_lfv-execs-by-version-id :f :_lfv-count-callable}}

  ;; --- Per-row JSON shape (HOF callback over sorted versions).
  {:name :_lfv-version-selected
   :description "Pick the bare fn-version columns. Admin extension point: add / remove keys to change the bare-row field set."
   :parent :select-keys
   :args {:m {:as :item}
          :ks [{:value :id} {:value :name} {:value :description}
               {:value :impl-hash} {:value :constraint}
               {:value :base-fn-id} {:value :element-fn-id}
               {:value :return-type-fn-id} {:value :anonymous-hash}
               {:value :expects-effects} {:value :created-at}
               {:value :deleted-at}]}}

  {:name :_lfv-version-base
   :description "Bare fn-version JSON shape — selected columns with UUIDs and timestamps stringified via the shared `:_stringify-uuid-or-inst` helper."
   :parent :update-vals
   :args {:m :_lfv-version-selected :f :_stringify-uuid-or-inst}}

  ;; The three computed fields (assoc'd onto :_lfv-version-base).
  {:name :_lfv-version-branch-id-raw
   :parent :get
   :args {:coll {:as :item} :key {:value :branch-id} :default nil}}

  {:name :_lfv-version-branch-id-str
   :description "Nil-safe stringified branch-id."
   :parent :if
   :args {:test {:parent :some? :args {:value :_lfv-version-branch-id-raw}}
          :then {:parent :to-str :args {:value :_lfv-version-branch-id-raw}}
          :else nil}}

  {:name :_lfv-version-branch
   :parent :get
   :args {:coll :_lfv-branches-by-id
          :key :_lfv-version-branch-id-raw
          :default nil}}

  {:name :_lfv-version-branch-name
   :parent :get
   :args {:coll :_lfv-version-branch
          :key {:value :name}
          :default nil}}

  {:name :_lfv-version-execution-count
   :parent :get
   :args {:coll :_lfv-exec-counts
          :key :_lfv-version-id-of
          :default {:value 0}}}

  ;; Assoc the three computed fields onto the bare row, one at a time.
  {:name :_lfv-row-with-branch-id
   :parent :assoc
   :args {:map :_lfv-version-base
          :key {:value :branch-id}
          :value :_lfv-version-branch-id-str}}

  {:name :_lfv-row-with-branch-name
   :parent :assoc
   :args {:map :_lfv-row-with-branch-id
          :key {:value :branch-name}
          :value :_lfv-version-branch-name}}

  {:name :_lfv-version-row
   :description "Per-row HOF callback — bare row + branch-id + branch-name + execution-count."
   :parent :assoc
   :args {:map :_lfv-row-with-branch-name
          :key {:value :execution-count}
          :value :_lfv-version-execution-count}}

  ;; Map the per-row builder over sorted versions.
  {:name :_lfv-versions-json
   :parent :map
   :args {:func :_lfv-version-row :coll :_lfv-versions-sorted}}

  ;; --- Final envelope.
  {:name :_lfv-fn-id-str
   :parent :if
   :args {:test {:parent :some? :args {:value {:as :fn-id}}}
          :then {:parent :to-str :args {:value {:as :fn-id}}}
          :else nil}}

  {:name :_lfv-version-count
   :parent :count
   :args {:coll :_lfv-versions-sorted}}

  {:name :list-fn-versions
   :description "Full version-list response for one logical fn — `{:ok true :fn-id (str fn-id) :count N :versions [...]}`. Empty `:versions` when `:fn-id` is nil. `:fn-id` is the own public pin — reusable by any handler that needs this shape."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :fn-id} {:value :count} {:value :versions}]
          :vals [{:value true} :_lfv-fn-id-str :_lfv-version-count :_lfv-versions-json]
          :fn-id {:type [:union :null :uuid]
                  :description "Logical fn-id whose version history is being listed; nil → empty `:versions`. The JSON envelope stringifies via `:_lfv-fn-id-str`."}}}

  ;; Handler entry point.
  {:name :_list-fn-versions-data
   :description "GET /api/fns/:fn-id/versions — URL extraction → `:list-fn-versions`."
   :parent :list-fn-versions
   :args {:fn-id :_list-fn-versions-fn-id}}

  {:name :list-fn-versions-handler
   :description "Ring handler for GET /api/fns/:fn-id/versions."
   :parent :json-handler
   :args {:data :_list-fn-versions-data}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/branches/:ref/diff?against=<source-ref> — resolved-view
  ;; diff between two branches.
  ;; ---------------------------------------------------------------------

  ;; --- C12 atoms: diff-branches variant-2.
  {:name :_branches-target-ref
   :description "Target branch ref extracted from `/api/branches/:target/…` — shared by diff / conflicts / merge / delete parsers."
   :parent :uri-segment-after
   :args {:marker {:value "branches"}}}

  {:name :_query-params
   :description "Parsed query-string of the Ring request (`{key value}` map, repeated keys collapse to last). Shared by diff + conflicts."
   :parent :parse-query-string
   :args {:string :ring-query-string}}

  {:name :_diff-against-ref
   :description "Raw `against=` query-param value, or nil."
   :parent :get
   :args {:coll :_query-params
          :key {:value "against"}
          :default nil}}

  {:name :_diff-parsed
