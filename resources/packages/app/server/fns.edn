;; App-specific web-server composition.
;;
;; The reusable ring-adapter + handler pipeline lives in `web/ring-adapter`.
;; This module only carries THIS app's routes + router binding + the
;; web-server root node.


{:namespace "app.server"
 :description "Application web-server entry point — this app's routes, router binding, and the `:web-server` root fn-def started by the runtime."
 :fns
 [;; =============================================================================
  ;; MONITORING: Health & Metrics (app-specific)
  ;; =============================================================================

  {:name :_health-json-body
   :parent :to-json-string
   :args {:data :health-status}}

  {:name :_health-handler
   :parent :json-ok-response
   :args {:body :_health-json-body}}

  {:name :_metrics-json-body
   :parent :to-json-string
   :args {:data :jvm-info}}

  {:name :_metrics-handler
   :parent :json-ok-response
   :args {:body :_metrics-json-body}}

  ;; ============================================================================
  ;; VERSION (deploy verification)
  ;; ============================================================================
  ;; `/version` returns the full three-section build-hash map:
  ;;     {"frontend": "<hex>", "backend": "<hex>", "packages": "<hex>"}
  ;; Each is the SHA-256 of one slice of the deploy at build time
  ;; (see build.clj). `bb verify` recomputes the same three hashes
  ;; from the local checkout and reports per-section match/mismatch,
  ;; so a failing deploy can be diagnosed by section rather than as
  ;; one opaque "something didn't match".
  ;;
  ;; The handler just JSON-encodes the already-parsed `:build-hashes`
  ;; map.

  {:name :_version-json-body
   :parent :to-json-string
   :args {:data :build-hashes}}

  {:name :_version-handler
   :parent :json-ok-response
   :args {:body :_version-json-body}}

  ;; Concrete leaf routes live in `app.routes`; route groups
  ;; (`monitoring`, `entity-crud`, `graph-api`, `ui`, `all`) live in
  ;; `app.routes.groups`. This module only owns the auth presets +
  ;; the web-server root chain.

  ;; Auth-required route templates live in `app.routes.auth`.

  ;; =============================================================================
  ;; WEB SERVER
  ;; =============================================================================

  ;; This app's router instance — bound to all-routes.
  {:name :_router
   :description "This app's compiled reitit router — text-error-router bound to all of this app's routes."
   :parent :text-error-router
   :args {:routes :all}}

  {:name :_app-ring-response
   :description "Final Ring handler — invokes the router on the parsed request and merges default security headers. Wrapped by `:_branch-routed-handler` before reaching http-kit."
   :parent :router-ring-response
   :args {:func :_router}}

  ;; Branch dispatch wraps the compiled main handler. At runtime, the
  ;; wrap reads `X-Graphden-Branch` / `?branch=` from the request,
  ;; resolves the branch, and routes to a per-branch
  ;; ExecutionContext (lazy-built + cached by
  ;; `graphden.system.branch-router`). Missing branch ref → main.
  ;; Storage-protocol injection (Block 1 Step 3): consumer-layer
  ;; fn-defs in `app/*` and `web/crud` use `:parent :storage-query-call`
  ;; instead of `:parent :pg-query`, which propagates `:storage-query`
  ;; as a free arg up the chain. We satisfy that free arg HERE — at
  ;; the handler-chain root — by binding it to `:pg-query`. The
  ;; binding lives on `:_branch-routed-handler` (and NOT on the
  ;; outer `:web-server`) because storage backend choice is a
  ;; handler-concern, not a transport-concern: the same handler tree
  ;; could be mounted on a non-HTTP host (CLI, desktop, message
  ;; queue) and the storage binding would travel with it.
  ;;
  ;; Primitive-layer fn-defs (`storage/branches`, `storage/versioned`)
  ;; stay on `:parent :pg-query` directly — they live alongside
  ;; `:pg-query` and going through the protocol from inside the
  ;; storage layer is both circular and (for `:branch-chain`) would
  ;; force per-iteration closure-capture across a `:fix` HOF boundary.
  {:name :_branch-routed-handler
   :description "`:_app-ring-response` wrapped with per-branch dispatch. Bound to `:http-server.handler` so EVERY request flows through the branch router. Owns the storage-protocol injection point — `:storage-query :pg-query` satisfies the free arg propagated up from every consumer fn-def parented from `:storage-query-call`."
   :parent :branch-routing-wrap
   :args {:base-handler :_app-ring-response
          :storage-query :pg-query}}

  {:name :web-server
   :description "Application root — starts the http-kit server on port 8080 with the branch-aware Ring handler chain. Pure transport: the handler tree (including its storage binding) is supplied through `:handler`; this node only knows about the network surface."
   :parent :http-server
   :args {:handler :_branch-routed-handler :port 8080}}]}
