  {:name :review-map-aggregates-count-and-rounded-average
   :description "`{name {:count n :avg x}}` — the average rounded HALF_UP to one decimal (17 / 4 = 4.25 → 4.3). Ratings whose mean is a non-terminating decimal (e.g. 14 / 3) are avoided: `:round` over the ratio `:div` yields throws — a core arithmetic gap, not this fold's contract."
   :parent :assert-eq
   :args {:actual {:parent :marketplace-review-map
                   :args {:m {:parent :zipmap
                              :args {:keys [{:value "p"} {:value "q"}]
                                     :vals [{:value [{:package-name "p" :rating 4} {:package-name "p" :rating 5} {:package-name "p" :rating 5} {:package-name "p" :rating 3}]}
                                            {:value [{:package-name "q" :rating 2}]}]}}}}
          :expected {:parent :zipmap
                     :args {:keys [{:value "p"} {:value "q"}]
                            :vals [{:value {:count 4 :avg 4.3}} {:value {:count 1 :avg 2.0}}]}}}}

  {:name :review-map-is-empty-without-reviews
