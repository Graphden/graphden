;; Production system configuration
;; Environment variables are read via Aero #env tag

{:db/schema {}

 :db/postgres
 {:jdbc-url #or [#env JDBC_URL "jdbc:postgresql://localhost:5432/graphden"]
  :username #or [#env DB_USERNAME "graphden"]
  :password #or [#env DB_PASSWORD "graphden"]
  :pool-size #long #or [#env DB_POOL_SIZE "10"]
  :schema #ig/ref :db/schema}

 :db/versioned
 {:base-storage #ig/ref :db/postgres}

 ;; Load packages from resources/packages/
 :app/packages
 {:package-names ["core" "web" "app" "examples"]}

 :exec/base-fns
 {:storage #ig/ref :db/versioned
  :packages #ig/ref :app/packages}

 :exec/fn-entities
 {:storage #ig/ref :db/versioned
  :packages #ig/ref :app/packages
  :base-fns #ig/ref :exec/base-fns}

 :exec/context
 {:storage #ig/ref :db/versioned}

 ;; Compile fn graphs into Clojure closures at startup. Depends on
 ;; fn-entities so every composed fn is already in storage before we
 ;; traverse them.
 :exec/compiled-registry
 {:context #ig/ref :exec/context
  :_fn-entities #ig/ref :exec/fn-entities}

 ;; Phase 1 service registry: reads :service rows on startup, starts
 ;; enabled ones. Falls back to packages' :startup-fn when no rows
 ;; exist (preserves the old single-web-server behaviour for fresh
 ;; deploys). See system/core.clj for the full lifecycle.
 :exec/service-reconciler
 {:context #ig/ref :exec/context
  :packages #ig/ref :app/packages
  :_compiled-registry #ig/ref :exec/compiled-registry}

 ;; Hourly sweep of :fn-execution rows past per-status TTL.
 ;; period-ms overridable via env (e.g. 600000 for 10-min sweeps in
 ;; staging). Independent of HTTP — runs even when nobody hits /api.
 :exec/cleanup-scheduler
 {:context #ig/ref :exec/context
  :period-ms #long #or [#env CLEANUP_PERIOD_MS "3600000"]}}
