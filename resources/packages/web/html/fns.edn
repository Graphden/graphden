;; HTML templating base functions using Hiccup —
;; render-hiccup, html-page, with-cdn-script, cytoscape-container,
;; wrap-element / wrap-style / wrap-script, hiccup.


{:namespace "web.html"
 :description "HTML/Hiccup primitives — render a hiccup tree, page scaffolding, the generic `hiccup` element constructor, and `<style>` / `<script>` wrappers."
 :fns
 [{:name :render-hiccup
   :description "Render a hiccup tree to an HTML string (`hiccup2.core/html`)."
   :args {:hiccup {:type :jsonb :description "Hiccup expression — vector of `[tag attrs? & children]`."}}
   :return-type :text}

  {:name :html-page
   :description "Build a full HTML page hiccup tree — `<!DOCTYPE html>` + `<head>` (title + head elements) + `<body>` (body + script tags)."
   :args {:title {:type :text :description "Document title (rendered in `<title>`)."}
          :head {:type [:list :jsonb] :required false
                 :description "Additional `<head>` hiccup elements."}
          :body {:type :jsonb :description "Hiccup tree placed inside `<body>`."}
          :scripts {:type [:list :jsonb] :required false
                    :description "`<script>` hiccup elements appended at end of body."}}
   :return-type :jsonb}

  ;; Append a CDN script tag to head elements
  {:name :with-cdn-script
   :description "Append a `<script src=\"url\">` element to a head-elements vector."
   :args {:head {:type [:list :jsonb] :required false
                 :description "Existing head-elements list (nil treated as empty)."}
          :url {:type :text :description "CDN URL of the script to load."}}
   :return-type [:list :jsonb]}

  {:name :cytoscape-container
   :description "Hiccup snippet for a Cytoscape.js mount point — `<div id=… style=…>` ready for the JS to attach to."
   :args {:id {:type :text :description "DOM id used by the JS to find this container."}
          :style {:type :jsonb :description "Inline-style map (e.g. `{\"width\" \"100%\"}`)."}}
   :return-type :jsonb}

  ;; Wrap text content in an HTML element. Pure composition over
  ;; :hiccup with a single-item children sequence.
  {:name :wrap-element
   :description "Build a single-child hiccup element `[tag content]` — pure composition over `:hiccup`. Used as the parent of `:wrap-style` / `:wrap-script`."
   :parent :hiccup
   :args {:children [{:as :content}]}}

  {:name :wrap-style
   :description "Wrap a CSS string into `<style>content</style>` hiccup."
   :parent :wrap-element
   :args {:tag "style"}}

  {:name :wrap-script
   :description "Wrap a JS string into `<script>content</script>` hiccup."
   :parent :wrap-element
   :args {:tag "script"}}

  ;; Generic hiccup element constructor
  {:name :hiccup
   :description "Build a hiccup vector `[tag attrs & children]`. `attrs` and `children` are optional."
   :args {:tag {:type :text :description "HTML tag name."}
          :attrs {:type :jsonb :required false :description "Attribute map (string keys). Omit/nil for no attributes."}
          :children {:type :sequence :of :any :required false :description "Child hiccup nodes — each item may be a literal node or a fn-ref."}}
   :return-type :jsonb}]}
