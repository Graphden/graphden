#kaocha/v1
{:tests
 [;; Unit tests — skip ^:integration.
  ;;
  ;; `:kaocha/parallelism` is wired by `:kaocha.plugin/parallel` (see
  ;; `test/kaocha/plugin/parallel.clj`). NSs that redef process-wide
  ;; symbols (`jdbc/execute!`, `registry/rich-type-of`, ...) carry
  ;; `^:serial` in their ns meta — those run sequentially BEFORE the
  ;; parallel pool starts. Everything else runs on a fixed N-thread
  ;; pool.
  {:id :unit
   :test-paths ["test"]
   ;; `:container-e2e` (the two-executor fleet test) needs the locally-built
   ;; `graphden-executor:latest` image + ~4 min of container boots — skip it in
   ;; the fast unit run; it has its own suite below.
   :skip-meta [:integration :container-e2e]
   :kaocha/parallelism 8}

  ;; Integration tests — run against the shared PG container. Each NS
  ;; fixture is scoped to its OWN logical DB on the cluster (see
  ;; `graphden.test-infra.shared-container/shared-container-fixture` +
  ;; `ensure-ns-database!`) so that whenever in-JVM parallelism is
  ;; eventually un-blocked, the `DROP SCHEMA public CASCADE` between
  ;; tests can't trample a concurrent NS's tables. Today still
  ;; sequential — see the unit-suite note above for the blocker.
  {:id :integration
   :test-paths ["test"]
   :focus-meta [:integration]
   ;; Per-NS logical DBs (shared-container plugin) keep integration
   ;; tests isolated even when their NSs run on parallel threads.
   ;; N=4 (not 8) for integration: tests that boot their own
   ;; testcontainers (e.g. `clients.vault-test` runs OpenBao) race
   ;; on Docker daemon throughput when many concurrent
   ;; `GenericContainer.start` calls land at once — the `Wait/forHttp`
   ;; ready-check times out before the container actually boots.
   ;; Constraint is on the Docker daemon, not our code.
   :kaocha/parallelism 4}

  ;; Container fleet e2e — boots the locally-built `graphden-executor:latest`
  ;; TWICE as a real two-pod fleet over a shared Postgres (testcontainers) and
  ;; drives the cross-container control plane over real HTTP. Kept OUT of :unit
  ;; and :integration (needs the built image + ~4 min); run explicitly after a
  ;; `bb rebuild`, like the Playwright e2e. `clojure -M:dev:test -m kaocha.runner
  ;; :container-e2e`.
  {:id :container-e2e
   :test-paths ["test"]
   :focus-meta [:container-e2e]}]

 ;; Plugins:
 ;; - profiling: shows slowest tests
 ;; - shared-container: singleton PG container + per-NS logical-DB lifecycle
 :plugins [:kaocha.plugin/profiling
           :kaocha.plugin/parallel
           :kaocha.plugin/shared-container]}
