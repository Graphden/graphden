;; Reitit routing base functions
;; router, middleware factory, proceed (next-in-chain delegate)


{:namespace "web.reitit"
 :fns
 [{:name :router
   :args {:routes :any
          :not-found-response :jsonb
          :method-not-allowed-response :jsonb
          :error-response :jsonb}
   :return-type :fn}

  ;; Middleware factory. `:body` is a Ring-shaped fn-graph (one free
  ;; arg `:request`). The produced spec is consumed by `:router` and
  ;; folded around a route's handler. Inside `:body`, use `:proceed` to
  ;; delegate to the next link in the chain.
  {:name :middleware
   :args {:name :any
          :body :fn}
   :return-type :jsonb}

  ;; Delegate to the next handler in the middleware chain. Only valid
  ;; inside a middleware `:body`. Takes the request to pass along
  ;; (commonly the caller's own `:request` free arg, untransformed).
  {:name :proceed
   :args {:request :any}
   :return-type :jsonb}

  ;; Router with individual text defaults — each sets one error response
  {:name :router-with-text-404
   :parent :router
   :args {:not-found-response :_text-404-body}}

  ;; Response bodies: use ring-response directly (all args explicit, no free arg leakage)
  {:name :_text-404-body
   :parent :text-not-found-response
   :args {:body "Not Found"}}

  {:name :router-with-text-405
   :parent :router
   :args {:method-not-allowed-response :_text-405-body}}

  {:name :_text-405-body
   :parent :text-method-not-allowed-response
   :args {:body "Method Not Allowed"}}

  {:name :router-with-text-500
   :parent :router
   :args {:error-response :_text-500-body}}

  {:name :_text-500-body
   :parent :text-error-response
   :args {:body "Handler not configured"}}

  ;; Router with all text defaults via MI
  {:name :text-error-router
   :parents [:router-with-text-404 :router-with-text-405 :router-with-text-500]}]}
