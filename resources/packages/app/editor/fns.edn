  {:name :_favicon-svg-body
   :parent :const
   :args {:value "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" fill=\"none\"><g stroke=\"#0066cc\" stroke-width=\"3\" stroke-linecap=\"round\"><line x1=\"9\" y1=\"6\" x2=\"25\" y2=\"26\"/><line x1=\"17\" y1=\"16\" x2=\"8\" y2=\"26\"/></g><g fill=\"#0066cc\"><circle cx=\"9\" cy=\"6\" r=\"3\"/><circle cx=\"25\" cy=\"26\" r=\"3\"/><circle cx=\"8\" cy=\"26\" r=\"3\"/></g></svg>"}}

  {:name :_favicon-handler
   :parent :cached-svg-ok-response
   :args {:body :_favicon-svg-body}}

  ;; =============================================================================
  ;; HTMX PARTIALS — server-rendered fragments swapped into editor mount-points
  ;;
  ;; Collapse-to-nothing placeholder for `:if` branches that render no
  ;; section — hidden, so both the DOM and the JS probes that decide
  ;; "anything to show?" see nothing.
  {:name :_hidden-span
   :parent :const
   :args {:value [:span {:hidden "1"}]}}

  ;; Shared HOF callback — text name of the current `:item` keyword.
  ;; Every partial chain that maps a keyword roster to text uses it
  ;; (effect chips, arg names, resolved-binding names, category
  ;; checkboxes). Single-node callbacks shape-dedup at sync anyway;
  ;; the single NAME is for the reader.
  {:name :_kw-item-name
   :parent :keyword-to-str
   :args {:keyword {:as :item}}}

  ;; The effect-explainer popover. The lookup lives in
  ;; `:_effect-descriptions` below (one fn-def, editable through the
  ;; editor itself), rendered to hiccup, and served at
  ;; `GET /partials/effect?effect=db`. JS keeps only positioning +
  ;; dismissal — the content lives in the graph.
  ;;
  ;; Pattern for future partials: keep the lookup/data as fn-defs,
  ;; the hiccup composition as fn-defs, the handler is a thin
  ;; `:html-ok-response` wrap. The full chain — including which
  ;; effect names are documented — becomes inspectable / branchable
  ;; / type-checked through the same surface as everything else.
  ;; =============================================================================

  {:name :_effect-descriptions
   :description "Lookup table: effect tag (string) → plain-English description shown in the popover. Adding a new tracked effect means adding a row here, no JS edit needed."
   :parent :const
   :args {:value {"db"      "Reads or writes storage (database / persistent state)."
                  "env"     "Reads environment variables."
                  "io"      "Reads or writes files / classpath resources."
                  "network" "Makes outbound HTTP / network calls, including connecting to your OWN external database (:sql-query / :sql-exec). Guarded by the SSRF egress broker (no internal / platform targets) and a per-tier rate + response-size cap. Granted on the free / network / dedicated tiers."
                  "state"   "Mutates in-memory shared state (:cell atoms via :swap / :reset). Process-local — lost on restart, not shared across pods."
                  "time"    "Uses wall-clock time — call returns a different value over time."
                  "random"  "Generates random or otherwise non-deterministic values."
                  "process" "Spawns supervised background work (thread / loop / listener) that lives past the call and needs explicit stopping. Required for a fn to become a :service."
                  "raw-sql" "Runs arbitrary SQL against the PLATFORM database, bypassing the org-scoped, access-checked storage layer (raw `:pg-query` / `:pg-execute` / `:pg-tx`). Always blocked for cloud / tenant graphs — it would cross tenants; use the org-scoped `:query-entities` family instead. (Connecting to your OWN external database via `:sql-query` / `:sql-exec` is the `network` effect, not this.)"
                  "cross-org" "Runs a function under ANOTHER organization's data scope — the cloud domain-router's primitive for serving each app request as its owning org. Platform-only: always blocked for tenant graphs (it would cross tenants), and it cannot be granted on any plan. You never declare or use this; it exists so the trusted router can dispatch across orgs safely."}}}

  {:name :_partial-effect-name
   :description "Read the `effect` query-string parameter from the inbound request. Empty string when absent so downstream lookups fall to the default."
   :parent :query-param
   :args {:request {:as :request}
          :param-name {:value "effect"}}}

  ;; `:_effect-descriptions`'s literal map sticks keyword keys after
  ;; the JSONB round-trip (`{\"db\" ...}` → `{:db ...}`), so the
  ;; query-string lookup-key has to be coerced from string to
  ;; keyword before `:get`.
  {:name :_partial-effect-name-kw
   :parent :str-to-keyword
   :args {:string :_partial-effect-name}}

  {:name :_partial-effect-description
   :description "Plain-English description for the requested effect tag; fallback for tags not in the lookup table."
   :parent :get
   :args {:coll :_effect-descriptions
          :key :_partial-effect-name-kw
          :default {:value "Side effect that the type-checker tracks but doesn't name yet."}}}

  {:name :_partial-effect-structural-text
   :description "`:tag` form of the effect name (e.g. `:db`) — surfaced in the structural row so users can map the popover content back to the chip label."
   :parent :str-join
   :args {:coll [":" :_partial-effect-name]
          :separator ""}}

  ;; Hiccup composition for the popover content. Each tag with a
  ;; computed child (description / structural text) gets its own
  ;; `:hiccup`-based fn-def — `:value`-literal hiccup stores
  ;; keyword fn-refs as literal keywords, so dynamic content can't
  ;; sit inline. Pure-literal sub-trees (header) DO use `:const`
  ;; below where they don't depend on the request.
  {:name :_partial-effect-header
   :description "Popover header — title + close button. Pure literal (no per-request data); rendered as a fixed hiccup constant. The close button carries `data-explainer-close` so the post-swap JS handler binds dismissal without selectors."
   :parent :const
   :args {:value
          [:div {:class "type-explainer-header"}
           [:span {:class "type-explainer-title"} "Effect"]
           [:button {:type "button"
                     :class "type-explainer-close"
                     :data-explainer-close "1"
                     :aria-label "Close effect explainer"} "×"]]}}

  {:name :_partial-effect-description-div
   :description "`<div class=\"type-explainer-human\">{description}</div>` — one-line natural-language description of the effect."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "type-explainer-human"}}
          :children [:_partial-effect-description]}}

  {:name :_partial-effect-structural-div
   :description "`<div class=\"type-explainer-structural\">{:effect-tag}</div>` — canonical effect tag in the structural row."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "type-explainer-structural"}}
          :children [:_partial-effect-structural-text]}}

  {:name :_partial-effect-fragment
   :description "Full hiccup fragment for one effect's popover — header + description + structural row, wrapped in the `.type-explainer-content` container."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "type-explainer-content"}}
          :children [:_partial-effect-header
                     :_partial-effect-description-div
                     :_partial-effect-structural-div]}}

  {:name :_partial-effect-html
   :description "Rendered HTML string for the effect-explainer fragment."
   :parent :render-hiccup
   :args {:hiccup :_partial-effect-fragment}}

  {:name :_partial-effect-handler
   :lambda-params [:request]
   :description "Ring handler for `GET /partials/effect?effect=<tag>` — returns the popover hiccup as `text/html`. JS swaps the response body into the explainer mount-point and handles positioning + dismissal."
   :parent :html-ok-response
   :args {:body :_partial-effect-html}}

  ;; =====================================================================
  ;; AUTH-FORM PARTIAL (graph-first §6-#2) — GET /partials/auth-form
  ;; (UNAUTHENTICATED: it IS the login form, fetched before you have a
  ;; session). The popover FIELDS live in the graph; editor-auth.js keeps
  ;; the lock button (built synchronously, instant — §6.4), mounts these
  ;; fields lazily into `#auth-popover` on first open, and owns the
  ;; interactive lifecycle (single/multi-tenant mode-toggle = client state,
  ;; eye-toggle, submit-dispatch, positioning, dismissal). Full form for
  ;; BOTH modes; JS hides username/org per mode. The eye button is left
  ;; empty — JS fills its SVG (it toggles). Rendered as a `:list` FRAGMENT
  ;; (no wrapper) so the fields stay direct flex children of `.auth-popover`.
  ;; =====================================================================

  {:name :_auth-password-input
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:value {:id "auth-password-input" :type "password" :placeholder "Admin password"
                          :autocomplete "off"}}
          ;; VOID element — children pinned empty, or the free
          ;; :children slot swallows the caller's conveyed args (the ring
          ;; request rendered INSIDE the input — the popover-garbage bug).
          :children {:value []}}}

  {:name :_auth-eye-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:id "auth-toggle-visibility-btn" :type "button"
                          :class "auth-toggle-visibility" :tabindex "-1" :title "Show password"}}
          ;; Glyph set by JS — children pinned empty (free slot leaks conveyed args).
          :children {:value []}}}

  {:name :_auth-input-wrap
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "auth-input-wrap"}}
          :children [:_auth-password-input :_auth-eye-btn]}}


  {:name :_auth-save-btn
   :parent :hiccup
   :args {:tag {:value "button"} :attrs {:value {:id "auth-save-btn" :class "auth-popover-btn"}}
          :children [{:value "Save"}]}}

  {:name :_auth-cancel-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:id "auth-cancel-btn" :class "auth-popover-btn auth-popover-btn-secondary"}}
          :children [{:value "Cancel"}]}}

  {:name :_auth-popover-row
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "auth-popover-row"}}
          :children [:_auth-save-btn :_auth-cancel-btn]}}

  {:name :_auth-error
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:id "auth-error" :class "auth-error hidden"
                                              :data-auth-mode "admin"}}
          ;; Text set by JS — children pinned empty (free slot leaks conveyed args).
          :children {:value []}}}


  ;; SINGLE-TENANT fields ONLY (admin password). The tenant variant
  ;; (username + org + create-account) ships WITH the tenancy addon, which
  ;; overrides this same /partials/auth-form path via the route-collection
  ;; seam — so a self-hosted build carries no tenant markup at all.
  {:name :_auth-form-fields
   :description "The single-tenant auth popover fields (admin password + actions + error) as a fragment (rendered directly into `#auth-popover`, staying direct flex children). The `data-auth-mode` marker on the error div tells editor-auth.js which submit path the served form expects."
   :parent :list
   :args {:items [:_auth-input-wrap :_auth-popover-row :_auth-error]}}

  {:name :_auth-form-html
   :parent :render-hiccup
   :args {:hiccup :_auth-form-fields}}

  {:name :_partial-auth-form-handler
   ;; [] — the popover fields are STATIC markup; the old [:children] param
   ;; (a leaked free from the unpinned inputs) made the 1-arg shape-callable
   ;; drop the whole ring request into :children — rendered INSIDE the
   ;; inputs as garbage (<request-method>…, the reitit router object).
   :lambda-params []
   :description "Ring handler for GET /partials/auth-form — the login/signup popover fields as text/html. Unauthenticated (it IS the login form). editor-auth.js mounts it into #auth-popover on first open."
   :parent :html-ok-response
   :args {:body :_auth-form-html}}


  ;; Concrete editor routes (`/`, `/favicon.ico`, `/partials/...`,
  ;; `/api/entities/...`, `/api/sequence/...`) live in `app.routes`;
  ;; they reference the handler fn-defs above by name.
  ]}
