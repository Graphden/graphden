   :parent :html-ok-response
   :args {:body {:parent :render-hiccup :args {:hiccup :marketplace-root}}}}

  {:name :partial-marketplace
   :description "GET /partials/marketplace?kind=&q=&category=&tag=&sort= — the Marketplace surface's listing. Auth-required."
   :parent :get-auth-required
   :args {:path "/partials/marketplace" :handler :_partial-marketplace-handler}}

  ;; =====================================================================
  ;; ITEM — one package: versions, actions, reviews. Free arg: `:pkg-name`.
  ;; =====================================================================

  {:name :_mki-rows
   :description "The package's index rows, newest version first."
   :parent :reverse
   :args {:coll {:parent :sort-by
                 :args {:key-fn :_mkr-rank
                        :coll {:parent :filter :args {:pred :_mki-row-named? :coll :list-package-versions :pkg-name {:as :pkg-name :type :text}}}}}}}
  {:name :_mki-row-named?
   :parent :equal? :args {:a :_mkr-name :b {:as :pkg-name :type :text}}}

  {:name :_mki-latest
   :parent :first :args {:coll :_mki-rows}}
  {:name :_mki-missing?
   :parent :nil? :args {:value :_mki-latest}}
  {:name :_mki-kind
   :parent :coalesce
   :args {:value {:parent :get :args {:coll :_mki-latest :key {:value :kind} :default nil}} :default {:value "fns"}}}
  {:name :_mki-fns?
   :parent :equal? :args {:a :_mki-kind :b {:value "fns"}}}

  {:name :_mki-card
   :description "The package's card (rating / installs) — the listing folded for this one name."
   :parent :marketplace-card
   :args {:item :_mki-rows :reviews :marketplace-review-map :installs :marketplace-install-map}}

  ;; this branch's pin (fns) / the user's active selection (theme, keymap)
  {:name :_mki-pin-rows
   :parent :query-entities
   :args {:entity-type {:value "package-install"}
          :where {:parent :assoc
                  :args {:map {:parent :assoc-empty :args {:key {:value :branch-id} :value :current-branch-id}}
                         :key {:value :package-name} :value {:as :pkg-name :type :text}}}}}
  {:name :_mki-pinned-version
   :parent :to-str
   :args {:value {:parent :get :args {:coll {:parent :first :args {:coll :_mki-pin-rows}} :key {:value :version} :default {:value ""}}}}}
  {:name :_mki-pref
   :parent :get :args {:coll :ui-prefs-read :key :_mki-kind :default nil}}
  {:name :_mki-active-version
   :description "The version of THIS package the user's active theme / keymap came from (\"\" when it's another package or a local edit)."
   :parent :if
   :args {:test {:parent :equal? :args {:a {:parent :to-str :args {:value {:parent :get-in :args {:map :_mki-pref :path [{:value :source} {:value :name}] :default {:value ""}}}}}
                                        :b {:as :pkg-name :type :text}}}
          :then {:parent :to-str :args {:value {:parent :get-in :args {:map :_mki-pref :path [{:value :source} {:value :version}] :default {:value ""}}}}}
          :else {:value ""}}}
  {:name :_mki-current-version
   :description "What counts as \"current\" for the version rows: the pin for a fns package, the active selection for a theme / keymap."
   :parent :if
   :args {:test :_mki-fns? :then :_mki-pinned-version :else :_mki-active-version}}

  ;; --- header ---
  {:name :_mki-back-url
   :parent :str-join
   :args {:coll [{:value "/partials/marketplace?kind="} {:parent :url-encode :args {:string :_mki-kind}}] :separator {:value ""}}}
  {:name :_mki-back
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:parent :assoc :args {:map {:value {:type "button" :class "mk-back"}} :key {:value :hx-get} :value :_mki-back-url}}
          :children [{:value "← Marketplace"}]}}
  {:name :_mki-title
   :parent :hiccup
   :args {:tag {:value "h2"} :attrs {:value {:class "mk-item-title"}}
          :children [{:as :pkg-name :type :text}
                     {:parent :hiccup :args {:tag {:value "span"} :attrs {:value {:class "mk-kind"}} :children [:_mki-kind]}}]}}
  {:name :_mki-meta
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "mk-card-meta mk-item-meta"}}
          :children [{:parent :_mkh-card-category :args {:item :_mki-card}}
                     {:parent :_mkh-card-private :args {:item :_mki-card}}
                     {:parent :_mkh-card-rating-maybe :args {:item :_mki-card}}
                     {:parent :_mkh-card-installs :args {:item :_mki-card}}
                     {:parent :hiccup :args {:tag {:value "span"} :attrs {:value {:class "mk-publisher"}}
                                             :children [{:value "by "} {:parent :to-str :args {:value {:parent :get :args {:coll :_mki-latest :key {:value :org-id} :default {:value "—"}}}}}]}}]}}
  {:name :_mki-desc
   :parent :hiccup
   :args {:tag {:value "p"} :attrs {:value {:class "mk-item-desc"}}
          :children [{:parent :coalesce
                      :args {:value {:parent :get :args {:coll :_mki-latest :key {:value :description} :default nil}}
                             :default {:value "No description — the publisher can add one on the next version."}}}]}}
  {:name :_mki-tags
   :parent :_mkh-card-tags :args {:item :_mki-card}}

  ;; --- version rows (`:item` = an index row; `:current` / `:kind` captured) ---
  {:name :_mkvr-action-url
   :parent :str-join
   :args {:coll [{:as :path :type :text} {:value "?name="} {:parent :url-encode :args {:string :_mkr-name}}
                 {:value "&version="} {:parent :url-encode :args {:string :_mkr-version}}]
          :separator {:value ""}}}
  {:name :_mkvr-btn
   :description "An action button hx-POSTing `:path?name=&version=`. Free: `:path`, `:label`, `:class`."
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:parent :assoc
                  :args {:map {:parent :assoc :args {:map {:value {:type "button"}} :key {:value :class} :value {:as :class :type :text}}}
                         :key {:value :hx-post} :value :_mkvr-action-url}}
          :children [{:as :label :type :text}]}}
  {:name :_mkvr-is-current?
   :parent :equal? :args {:a :_mkr-version :b {:as :current :type :text}}}
  {:name :_mkvr-current-badge
   :parent :hiccup
   :args {:tag {:value "span"} :attrs {:value {:class "mk-current"}}
          :children [{:parent :if :args {:test {:parent :equal? :args {:a {:as :kind :type :text} :b {:value "fns"}}}
                                         :then {:value "installed"} :else {:value "active"}}}]}}
  {:name :_mkvr-fns-actions
   :parent :hiccup
