 ;; ---------------------------------------------------------- fns packages
 ;; Small, self-contained compositions over `core` / `web` — installed by
 ;; reference like any package (Lesson 32); the point is a non-empty
 ;; Packages tab that shows what a listing looks like and installs cleanly.
 {:kind "fns"
  :name "starter.text"
  :version "1.0.0"
  :description "Two text helpers: `slugify` turns any title into a URL slug (lower-case, dashes, trimmed), `word-count` counts whitespace-separated words (0 for blank input). Both take `:text`."
  :category "utilities"
  :tags ["text" "slug" "strings" "starter"]
  :ns-root "starter.text"
  :dependencies [:str-lower :re-replace :str-trim :str-split :count :non-blank? :if]
  ;; The free arg is `:text`, not the base-fns' own `:string`: a free that
  ;; shares its name with the slot it flows into resolves to the REF's
  ;; slot instead of the parent's (`resolve-slot-owner`'s type pass) and
  ;; is swallowed on the way out — a chain of `:string` refs surfaces
  ;; nothing. Name a package's frees apart from the slots they feed.
  :fns [{:name :_slug-lower
         :parent :str-lower
         :args {:string {:as :text}}}
        {:name :_slug-dashed
         :description "Every run of non-alphanumerics becomes one dash."
         :parent :re-replace
         :args {:string :_slug-lower :pattern "[^a-z0-9]+" :replacement "-"}}
        {:name :slugify
         :description "A URL slug from any title — lower-cased, runs of non-alphanumerics collapsed to a dash, leading / trailing dashes trimmed. `\"Hello, World!\"` → `\"hello-world\"`. Free arg: `:text`."
         :parent :re-replace
         :args {:string :_slug-dashed :pattern "^-+|-+$" :replacement ""}}
        {:name :_wc-trimmed
         :parent :str-trim
         :args {:string {:as :text}}}
        {:name :_wc-parts
         :parent :str-split
         :args {:string :_wc-trimmed :separator "\\s+"}}
        ;; `:non-blank?`, not `:blank?`: a free arg on a `:required false`
        ;; slot is an optional free, and a blank string must answer 0.
        {:name :word-count
         :description "Whitespace-separated words in a string; 0 when blank. Free arg: `:text`."
         :parent :if
         :args {:test {:parent :non-blank? :args {:string :_wc-trimmed}}
                :then {:parent :count :args {:coll :_wc-parts}}
                :else 0}}]}

 {:kind "fns"
  :name "starter.numbers"
  :version "1.0.0"
  :description "Two number helpers: `mean` of a list of `:values`, and `percent-of` — a `:part` as a percentage of a `:whole`, rounded to one decimal."
  :category "utilities"
  :tags ["numbers" "math" "percent" "starter"]
  :ns-root "starter.numbers"
  :dependencies [:div :add :count :mul :round]
  :fns [{:name :mean
         :description "Arithmetic mean of `:values` (throws on an empty list — division by zero). Free arg: `:values` — named apart from `:div`'s own `:nums`, see starter.text."
         :parent :div
         :args {:nums [{:parent :add :args {:nums {:as :values}}}
                       {:parent :count :args {:coll {:as :values}}}]}}
        {:name :percent-of
         :description "`:part` as a percentage of `:whole`, rounded to one decimal — `(percent-of 1 3)` → `33.3`. Free args: `:part`, `:whole`."
         :parent :round
         :args {:number {:parent :mul :args {:nums [{:parent :div :args {:nums [{:as :part} {:as :whole}]}} 100]}}
                :decimals 1}}]}

 {:kind "fns"
  :name "starter.hello-api"
  :version "1.0.0"
  :description "A JSON route to copy from: `GET /hello?name=…` answers `{\"hello\": \"…\"}` (`world` when the parameter is absent). Install it, then reference `hello-route` from your router's routes."
  :category "web"
  :tags ["http" "json" "route" "starter"]
  :ns-root "starter.hello-api"
  :dependencies [:query-param :coalesce :zipmap :json-handler :get-route]
  :fns [{:name :_hello-name
         :parent :query-param
         :args {:request {:as :request} :param-name "name"}}
        {:name :_hello-who
         :description "The `name` query parameter, `world` when absent."
         :parent :coalesce
         :args {:value :_hello-name :default "world"}}
        {:name :_hello-body
         :parent :zipmap
         :args {:keys ["hello"] :vals [:_hello-who]}}
        {:name :hello-handler
         :lambda-params [:request]
         :description "Ring handler for GET /hello — `{\"hello\": <name or world>}` as JSON."
         :parent :json-handler
         :args {:data :_hello-body}}
        {:name :hello-route
         :description "`GET /hello` → `hello-handler`. Add it to a router's `:routes` list."
         :parent :get-route
         :args {:path "/hello" :handler :hello-handler}}]}]
