          :expected "other.ns"}}

  {:name :dependency-bumps-flag-only-the-incompatible-advance
   :description "`a` 1→2 breaks; `b` dropped and `c` added are not breaks."
   :parent :assert-eq
   :args {:actual {:parent :incompatible-dependency-bumps
                   :args {:old-deps {:value [{:name "a" :version "1.0.0"} {:name "b" :version "1.0.0"}]}
                          :new-deps {:value [{:name "a" :version "2.0.0"} {:name "c" :version "1.0.0"}]}}}
          :expected {:value [{:kind :dependency-incompatible :name "a" :old "1.0.0" :new "2.0.0"}]}}}

  {:name :dependency-bumps-ignore-a-compatible-advance
   :parent :assert
   :args {:value {:parent :empty?
                  :args {:coll {:parent :incompatible-dependency-bumps
                                :args {:old-deps {:value [{:name "a" :version "1.0.0"}]}
                                       :new-deps {:value [{:name "a" :version "1.4.0"}]}}}}}}}

  {:name :breaking-changes-are-empty-for-identical-bundles
   :parent :assert
   :args {:value {:parent :empty?
                  :args {:coll {:parent :breaking-changes-between
