;; Graph visualization base functions for Cytoscape.js
;; entities-to-cytoscape, cytoscape-init-script, cytoscape-update-script


{:namespace "web.graph"
 :fns
[{:name :entities-to-cytoscape
  :args {:entities :jsonb}
  :return-type :jsonb}

 {:name :cytoscape-init-script
  :args {:container-id :text
         :elements :jsonb
         :style :jsonb
         :layout :jsonb
         :on-click {:type :text :required false}}
  :return-type :text}

 {:name :cytoscape-update-script
  :args {:elements :jsonb
         :layout {:type :bool :required false}}
  :return-type :text}

 {:name :format-display-value
  :args {:value {:type :any :required false}
         :ref-id {:type :text :required false}
         :max-length {:type :int :required false}}
  :return-type :text}

 ;; =============================================================================
 ;; FN-DEFS: Default Cytoscape configuration
 ;; =============================================================================

 {:name :cytoscape-default-graph-style
  :parent :const
  :args {:value
   [{:selector "node"
     :style {:label "data(label)"
             :text-valign "center"
             :text-halign "center"
             :font-size "12px"
             :width 80
             :height 40}}

    {:selector "node[type='fn'][is-base]"
     :style {:background-color "#fff"
             :border-width 2
             :border-color "#000"
             :shape "round-rectangle"}}

    {:selector "node[type='fn'][!is-base]"
     :style {:background-color "#fff"
             :border-width 2
             :border-color "#000"
             :shape "round-rectangle"}}

    {:selector "node[type='arg'][has-value]"
     :style {:background-color "#f5f5f5"
             :border-width 1
             :border-color "#000"
             :shape "rectangle"
             :width 100
             :height 30}}

    {:selector "node[type='arg'][!has-value]"
     :style {:background-color "#fff"
             :border-width 1
             :border-color "#999"
             :border-style "dashed"
             :shape "rectangle"
             :width 100
             :height 30}}

    {:selector "edge"
     :style {:width 2
             :line-color "#ccc"
             :target-arrow-color "#ccc"
             :target-arrow-shape "triangle"
             :curve-style "bezier"}}

    {:selector "edge[type='inherits']"
     :style {:line-color "#000"
             :target-arrow-color "#000"
             :line-style "dashed"}}

    {:selector "edge[type='references']"
     :style {:line-color "#666"
             :target-arrow-color "#666"}}

    {:selector ":selected"
     :style {:border-width 3
             :border-color "#000"}}]}}

 {:name :cytoscape-default-layout
  :parent :const
  :args {:value {:name "dagre"
                 :rankDir "TB"
                 :nodeSep 50
                 :edgeSep 10
                 :rankSep 100}}}]}
