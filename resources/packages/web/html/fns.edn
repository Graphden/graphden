;; HTML templating base functions using Hiccup
;; render-hiccup, html-response, html-page, with-htmx, with-cytoscape,
;; cytoscape-container, form-input, form-select, button


{:namespace "web.html"
 :description "HTML/Hiccup primitives — render, page scaffolding, form helpers, common UI blocks (button, badge, field-row)."
 :fns
 [{:name :render-hiccup
   :description "Render a hiccup tree to an HTML string (`hiccup2.core/html`)."
   :args {:hiccup {:type :jsonb :description "Hiccup expression — vector of `[tag attrs? & children]`."}}
   :return-type :text}

  {:name :html-page
   :description "Build a full HTML page hiccup tree — `<!DOCTYPE html>` + `<head>` (title + head elements) + `<body>` (body + script tags)."
   :args {:title {:type :text :description "Document title (rendered in `<title>`)."}
          :head {:type :jsonb :required false :description "Vector of additional `<head>` hiccup elements."}
          :body {:type :jsonb :description "Hiccup tree placed inside `<body>`."}
          :scripts {:type :jsonb :required false :description "Vector of `<script>` hiccup elements appended at end of body."}}
   :return-type :jsonb}

  ;; Append a CDN script tag to head elements
  {:name :with-cdn-script
   :description "Append a `<script src=\"url\">` element to a head-elements vector."
   :args {:head {:type :jsonb :required false :description "Existing head-elements vector (nil treated as empty)."}
          :url {:type :text :description "CDN URL of the script to load."}}
   :return-type :jsonb}

  {:name :cytoscape-container
   :description "Hiccup snippet for a Cytoscape.js mount point — `<div id=… style=…>` ready for the JS to attach to."
   :args {:id {:type :text :description "DOM id used by the JS to find this container."}
          :style {:type :jsonb :description "Inline-style map (e.g. `{\"width\" \"100%\"}`)."}}
   :return-type :jsonb}

  {:name :form-input
   :description "Hiccup snippet for a labelled `<input>` field — `<label> + <input>` wrapped in a div."
   :args {:field-name {:type :text :description "Form field name (becomes `name` and `for` attributes)."}
          :label-text {:type :text :description "Visible label text."}
          :input-type {:type :text :value "text" :description "HTML `type` attribute. Defaults to `\"text\"`."}
          :field-value {:type :any :required false :description "Pre-filled `value` for edit-style forms."}
          :extra-attrs {:type :jsonb :required false :description "Extra attributes merged onto the `<input>`."}}
   :return-type :jsonb}

  {:name :form-select
   :description "Hiccup snippet for a labelled `<select>` field with an options list."
   :args {:field-name {:type :text :description "Form field name."}
          :label-text {:type :text :description "Visible label text."}
          :options {:type :jsonb :description "Vector of `[value label]` pairs (or just values — re-used as labels)."}
          :selected-value {:type :any :required false :description "Pre-selected option value."}
          :extra-attrs {:type :jsonb :required false :description "Extra attributes merged onto the `<select>`."}}
   :return-type :jsonb}

  ;; <button type="..." ...extra-attrs>btn-text</button>
  ;; pure :hiccup composition with :coalesce default for btn-type
  {:name :button
   :description "`<button type=… …extra-attrs>btn-text</button>` — pure composition over `:hiccup` with `:coalesce` defaulting `btn-type` to `\"button\"`."
   :parent :hiccup
   :args {:tag "button"
          :attrs :_button-attrs
          :children :_button-children}}

  {:name :_button-type
   :parent :coalesce
   :args {:value {:as :btn-type} :default "button"}}

  {:name :_button-base-attrs
   :parent :assoc-empty
   :args {:key "type" :value :_button-type}}

  {:name :_button-attrs
   :parent :merge
   :args {:maps [:_button-base-attrs {:as :extra-attrs}]}}


  {:name :_button-children
   :parent :conj
   :args {:coll [] :item {:as :btn-text}}}

  ;; <div class="field-row"><span class="field-label">label</span>
  ;;                        <span class="field-value">value-or-dash</span></div>
  {:name :field-row
   :description "`<div class=\"field-row\"><span class=\"field-label\">label</span><span class=\"field-value\">value</span></div>`. nil values render as `-` so empty rows look intentional."
   :parent :hiccup
   :args {:tag "div"
          :attrs {:class "field-row"}
          :children :_field-row-children}}

  {:name :_field-row-label-span
   :parent :hiccup
   :args {:tag "span"
          :attrs {:class "field-label"}
          :children :_field-row-label-children}}

  {:name :_field-row-label-children
   :parent :conj
   :args {:coll [] :item {:as :label}}}

  {:name :_field-row-value-span
   :parent :hiccup
   :args {:tag "span"
          :attrs {:class "field-value"}
          :children :_field-row-value-children}}

  {:name :_field-row-value-children
   :parent :conj
   :args {:coll [] :item :_field-row-display-value}}

  {:name :_field-row-display-value
   :parent :if
   :args {:test :_field-row-value-nil?
          :then "-"
          :else :_field-row-value-str}}

  {:name :_field-row-value-nil?
   :parent :nil?
   :args {:value {:as :value}}}

  {:name :_field-row-value-str
   :parent :to-str
   :args {:value {:as :value}}}

  {:name :_field-row-children
   :parent :list
   :args {:items [:_field-row-label-span :_field-row-value-span]}}

  ;; <span class="badge[ badge-<type>]">badge-text</span>
  {:name :badge
   :description "`<span class=\"badge[ badge-<type>]\">badge-text</span>` — coloured pill for entity-type tags etc. Class becomes `\"badge badge-<type>\"` when `:badge-type` is set, else just `\"badge\"`."
   :parent :hiccup
   :args {:tag "span"
          :attrs :_badge-attrs
          :children :_badge-children}}

  {:name :_badge-attrs
   :parent :assoc-empty
   :args {:key "class" :value :_badge-class}}

  {:name :_badge-class
   :parent :if
   :args {:test {:as :badge-type}
          :then :_badge-class-typed
          :else "badge"}}

  {:name :_badge-class-typed
   :parent :str
   :args {:parts [{:value "badge badge-"} {:as :badge-type}]}}

  {:name :_badge-children
   :parent :conj
   :args {:coll [] :item {:as :badge-text}}}

  ;; Entity field rows - renders multiple field-rows from entity using field-specs
  ;; field-specs: [[label key] ...] or [[label key transform-fn] ...]
  {:name :entity-field-rows
   :description "Render a vector of `:field-row`s from a single entity, driven by a list of `[label key transform?]` specs."
   :args {:entity {:type :jsonb :description "Source entity map."}
          :field-specs {:type :jsonb :description "Vector of `[label key]` or `[label key transform-fn]` specs."}}
   :return-type :jsonb}

  ;; Wrap text content in an HTML element. fn-def composition over
  ;; :hiccup (tag + nil attrs + single-element children list).
  {:name :_wrap-element-children
   :parent :conj
   :args {:coll [] :item {:as :content}}}

  {:name :wrap-element
   :description "Build a single-child hiccup element `[tag content]` — pure composition over `:hiccup`. Used as the parent of `:wrap-style` / `:wrap-script`."
   :parent :hiccup
   :args {:children :_wrap-element-children}}

  {:name :wrap-style
   :description "Wrap a CSS string into `<style>content</style>` hiccup."
   :parent :wrap-element
   :args {:tag "style"}}

  {:name :wrap-script
   :description "Wrap a JS string into `<script>content</script>` hiccup."
   :parent :wrap-element
   :args {:tag "script"}}

  ;; Generic hiccup element constructor
  {:name :hiccup
   :description "Build a hiccup vector `[tag attrs & children]`. `attrs` and `children` are optional."
   :args {:tag {:type :text :description "HTML tag name."}
          :attrs {:type :jsonb :required false :description "Attribute map (string keys). Omit/nil for no attributes."}
          :children {:type :jsonb :required false :description "Vector of child hiccup nodes or text."}}
   :return-type :jsonb}

  ;; <div style="...">button1 button2 ...</div>  -- horizontal flex container.
  {:name :button-row
   :description "`<div style=…>btn1 btn2 …</div>` — horizontal flex container for action buttons. Caller supplies `:style` and `:buttons` (already-rendered hiccup)."
   :parent :hiccup
   :args {:tag "div"
          :attrs :_button-row-attrs
          :children {:as :buttons}}}

  {:name :_button-row-attrs
   :parent :assoc-empty
   :args {:key "style" :value {:as :style}}}

  ;; Transform a value for display: :keyword-to-str, :pr-str, :bool-to-yesno
  {:name :apply-transform
   :description "Apply a named display transform — `:keyword-to-str`, `:pr-str`, `:bool-to-yesno` — to a single value. Identity when `:transform` is nil."
   :args {:value {:type :any :required false :description "Value to transform (nil-safe)."}
          :transform {:type :text :required false :description "Transform name (e.g. `\"keyword-to-str\"`)."}}
   :return-type :any}]}
