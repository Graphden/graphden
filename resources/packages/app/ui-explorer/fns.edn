       {:name :_explorer-attrs-secrets :parent :_explorer-toggle-attrs :args {:vals ["button" "kind-toggle" "secrets" :_explorer-pressed-secrets "Only secrets" false]}}
       {:name :_explorer-button-secrets :parent :hiccup :args {:tag "button" :attrs :_explorer-attrs-secrets :children [:_explorer-glyph-secrets :_explorer-label-secrets]}}
       {:name :_explorer-pressed-services :parent :if :args {:test :_explorer-selected-services :then "true" :else "false"}}
