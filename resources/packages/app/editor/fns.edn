   :args {:coll :_partial-bd-diffs}}

  {:name :_partial-bd-empty?
   :parent :empty?
   :args {:coll :_partial-bd-diffs}}

  {:name :_partial-bd-source-name
   :parent :get
   :args {:coll {:parent :get :args {:coll :_partial-bd-data :key {:value :source} :default {:value {}}}}
          :key {:value :name}
          :default {:value "(source)"}}}

  {:name :_partial-bd-target-name
   :parent :get
   :args {:coll {:parent :get :args {:coll :_partial-bd-data :key {:value :target} :default {:value {}}}}
          :key {:value :name}
          :default {:value "(target)"}}}

  ;; --- Per-row HOF callback ---

  {:name :_partial-bd-row-entity-name
   :parent :get
   :args {:coll {:as :item} :key {:value :entity-name} :default {:value ""}}}

  {:name :_partial-bd-row-entity-id
   :parent :get
   :args {:coll {:as :item} :key {:value :entity-id} :default {:value ""}}}

  {:name :_partial-bd-row-change
   :parent :get
   :args {:coll {:as :item} :key {:value :change} :default {:value ""}}}

  {:name :_partial-bd-row-source-version
   :parent :get
   :args {:coll {:as :item} :key {:value :source-version} :default nil}}

  {:name :_partial-bd-row-target-version
   :parent :get
   :args {:coll {:as :item} :key {:value :target-version} :default nil}}

  ;; The fn's name, preferred from source-version (won't be in
  ;; current-branch fnMap for added-in-source rows), falling back
  ;; to target. Becomes `data-diff-fn-name` so the JS post-switch
  ;; hash-resolution can find the fn on the target branch.
  {:name :_partial-bd-row-fn-name
   :parent :coalesce
   :args {:value {:parent :get :args {:coll :_partial-bd-row-source-version :key {:value :name} :default nil}}
          :default {:parent :coalesce
                    :args {:value {:parent :get :args {:coll :_partial-bd-row-target-version :key {:value :name} :default nil}}
                           :default {:value ""}}}}}

  ;; `:entity-name` is also a kw in-graph (`:fn` / `:binding` / …)
  ;; — same JSON-flattens-but-graph-keeps-kw shape as `:change`.
  {:name :_partial-bd-row-is-fn?
   :parent :equal?
   :args {:a :_partial-bd-row-entity-name :b {:value :fn}}}

  ;; entity-id is a String in the entry (stringified by
  ;; `:_diff-apply-entry`). `:effective-branch-local?` wants a UUID.
  ;; Parse only when the row is a `:fn` (other entity-names → nil →
  ;; predicate returns false).
  {:name :_partial-bd-row-fn-id-uuid
   :parent :if
   :args {:test :_partial-bd-row-is-fn?
          :then {:parent :parse-uuid :args {:string :_partial-bd-row-entity-id}}
          :else nil}}

  {:name :_partial-bd-row-branch-local?
   :parent :effective-branch-local?
   :args {:fn-id :_partial-bd-row-fn-id-uuid}}

  ;; Row CSS class: base + clickable (when fn) + local (when
  ;; effective-branch-local).
  {:name :_partial-bd-row-class-step-1
   :description "Base `branch-diff-row` + `branch-diff-row-clickable` when entity is `:fn`."
   :parent :if
   :args {:test :_partial-bd-row-is-fn?
          :then {:value "branch-diff-row branch-diff-row-clickable"}
          :else {:value "branch-diff-row"}}}

  {:name :_partial-bd-row-class
   :description "Append `branch-diff-row-local` if effective-branch-local."
   :parent :if
   :args {:test :_partial-bd-row-branch-local?
          :then {:parent :str-join
                 :args {:coll [:_partial-bd-row-class-step-1 {:value " branch-diff-row-local"}]
                        :separator {:value ""}}}
          :else :_partial-bd-row-class-step-1}}

  ;; Row attributes: class + (when fn) data-diff-fn-id +
  ;; data-diff-change + data-diff-fn-name. Non-fn rows omit the
  ;; data-* attrs — JS click handler matches on `[data-diff-fn-id]`
  ;; so non-fn rows are naturally non-clickable.
  {:name :_partial-bd-row-attrs-step-1
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :class}
          :value :_partial-bd-row-class}}

  {:name :_partial-bd-row-attrs-with-data
   :description "When entity is `:fn`, add the three `data-diff-*` attrs the JS click handler reads."
   :parent :assoc
   :args {:map {:parent :assoc
                :args {:map {:parent :assoc
                             :args {:map :_partial-bd-row-attrs-step-1
                                    :key {:value :data-diff-fn-id}
                                    :value :_partial-bd-row-entity-id}}
                       :key {:value :data-diff-change}
                       :value :_partial-bd-row-change}}
          :key {:value :data-diff-fn-name}
          :value :_partial-bd-row-fn-name}}

  {:name :_partial-bd-row-attrs
   :parent :if
   :args {:test :_partial-bd-row-is-fn?
          :then :_partial-bd-row-attrs-with-data
          :else :_partial-bd-row-attrs-step-1}}

  ;; Row content: entity-name pill + id + (optional) local-badge +
  ;; minimal summary (fn-name when present).
  {:name :_partial-bd-row-entity-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "branch-diff-entity"}}
          :children [:_partial-bd-row-entity-name]}}

  {:name :_partial-bd-row-id-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "branch-diff-id"}}
          :children [:_partial-bd-row-entity-id]}}

  {:name :_partial-bd-row-local-badge-shown
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "branch-diff-row-local-badge"
                          :title "Won't propagate on merge — branch-local fn"}}
          :children ["📍 branch-local"]}}

  {:name :_partial-bd-row-local-badge-hidden
   :description "Empty span when the row isn't effective-branch-local — keeps the children-vector shape uniform."
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:hidden "1"}}
          :children {:value []}}}

  {:name :_partial-bd-row-local-badge
   :parent :if
   :args {:test :_partial-bd-row-branch-local?
          :then :_partial-bd-row-local-badge-shown
          :else :_partial-bd-row-local-badge-hidden}}

  {:name :_partial-bd-row-head
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-row-head"}}
          :children [:_partial-bd-row-entity-span
                     :_partial-bd-row-id-span
                     :_partial-bd-row-local-badge]}}

  ;; Summary line: fn-name wrapped in `<strong>` for visual weight
  ;; (matches the legacy `fnPreview` shape the e2e selector reads).
  ;; Rich per-type previews (description diffs, return-type markers,
  ;; binding value comparisons …) are deferred to v2.
  {:name :_partial-bd-row-name-strong
   :parent :hiccup
   :args {:tag {:value "strong"}
          :attrs {:value {}}
          :children [:_partial-bd-row-fn-name]}}

  {:name :_partial-bd-row-summary
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-row-summary"}}
          :children [:_partial-bd-row-name-strong]}}

  {:name :_partial-bd-row
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs :_partial-bd-row-attrs
          :children [:_partial-bd-row-head :_partial-bd-row-summary]}}

  ;; --- Section grouping by `:change` ---

  ;; `:diff-branches` returns `:change` as a keyword (`:modified` /
  ;; `:added-in-source` / `:added-in-target`); JSON serialisation
  ;; flattens to string for the wire, but in-graph it stays a kw.
  {:name :_partial-bd-row-change-eq?-added-src
   :parent :equal?
   :args {:a :_partial-bd-row-change :b {:value :added-in-source}}}

  {:name :_partial-bd-row-change-eq?-added-tgt
   :parent :equal?
   :args {:a :_partial-bd-row-change :b {:value :added-in-target}}}

  {:name :_partial-bd-row-change-eq?-modified
   :parent :equal?
   :args {:a :_partial-bd-row-change :b {:value :modified}}}

  {:name :_partial-bd-added-in-source-rows
   :parent :filter
   :args {:pred :_partial-bd-row-change-eq?-added-src
          :coll :_partial-bd-diffs}}

  {:name :_partial-bd-added-in-target-rows
   :parent :filter
   :args {:pred :_partial-bd-row-change-eq?-added-tgt
          :coll :_partial-bd-diffs}}

  {:name :_partial-bd-modified-rows
   :parent :filter
   :args {:pred :_partial-bd-row-change-eq?-modified
          :coll :_partial-bd-diffs}}

  ;; --- Per-section render: head + count + rendered rows.
  ;; Each section uses the SAME row-renderer (`:_partial-bd-row`)
  ;; but a DIFFERENT input list. Three separate `:map` invocations
  ;; — one per section.

  {:name :_partial-bd-added-src-rendered
   :parent :map
   :args {:func :_partial-bd-row :coll :_partial-bd-added-in-source-rows}}

  {:name :_partial-bd-added-tgt-rendered
   :parent :map
   :args {:func :_partial-bd-row :coll :_partial-bd-added-in-target-rows}}

  {:name :_partial-bd-modified-rendered
   :parent :map
   :args {:func :_partial-bd-row :coll :_partial-bd-modified-rows}}

  {:name :_partial-bd-added-src-count-text
   :parent :to-str
   :args {:value {:parent :count :args {:coll :_partial-bd-added-in-source-rows}}}}

  {:name :_partial-bd-added-tgt-count-text
   :parent :to-str
   :args {:value {:parent :count :args {:coll :_partial-bd-added-in-target-rows}}}}

  {:name :_partial-bd-modified-count-text
   :parent :to-str
   :args {:value {:parent :count :args {:coll :_partial-bd-modified-rows}}}}

  ;; Section head: "<label> <count>". Label includes the branch
  ;; name for "Added in" sections.
  {:name :_partial-bd-added-src-label
   :parent :str-join
   :args {:coll [{:value "Added in "} :_partial-bd-source-name]
          :separator {:value ""}}}

  {:name :_partial-bd-added-tgt-label
   :parent :str-join
   :args {:coll [{:value "Added in "} :_partial-bd-target-name]
          :separator {:value ""}}}

  {:name :_partial-bd-added-src-head-text
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "branch-diff-section-label"}}
          :children [:_partial-bd-added-src-label]}}

  {:name :_partial-bd-added-tgt-head-text
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "branch-diff-section-label"}}
          :children [:_partial-bd-added-tgt-label]}}

  {:name :_partial-bd-modified-head-text
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "branch-diff-section-label"}}
          :children ["Modified"]}}

  {:name :_partial-bd-added-src-count-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "branch-diff-count"}}
          :children [:_partial-bd-added-src-count-text]}}

  {:name :_partial-bd-added-tgt-count-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "branch-diff-count"}}
          :children [:_partial-bd-added-tgt-count-text]}}

  {:name :_partial-bd-modified-count-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "branch-diff-count"}}
          :children [:_partial-bd-modified-count-text]}}

  {:name :_partial-bd-added-src-section-head
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-section-head"}}
          :children [:_partial-bd-added-src-head-text :_partial-bd-added-src-count-span]}}

  {:name :_partial-bd-added-tgt-section-head
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-section-head"}}
          :children [:_partial-bd-added-tgt-head-text :_partial-bd-added-tgt-count-span]}}

  {:name :_partial-bd-modified-section-head
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-section-head"}}
          :children [:_partial-bd-modified-head-text :_partial-bd-modified-count-span]}}

  {:name :_partial-bd-added-src-rows-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-rows"}}
          :children :_partial-bd-added-src-rendered}}

  {:name :_partial-bd-added-tgt-rows-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-rows"}}
          :children :_partial-bd-added-tgt-rendered}}

  {:name :_partial-bd-modified-rows-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-rows"}}
          :children :_partial-bd-modified-rendered}}

  ;; Hidden section when the corresponding rows list is empty — keeps
  ;; the children-vector shape stable across diff payloads.
  {:name :_partial-bd-added-src-hidden
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:hidden "1"}} :children {:value []}}}

  {:name :_partial-bd-added-tgt-hidden
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:hidden "1"}} :children {:value []}}}

  {:name :_partial-bd-modified-hidden
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:hidden "1"}} :children {:value []}}}

  {:name :_partial-bd-added-src-section-shown
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-section"}}
          :children [:_partial-bd-added-src-section-head :_partial-bd-added-src-rows-div]}}

  {:name :_partial-bd-added-tgt-section-shown
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-section"}}
          :children [:_partial-bd-added-tgt-section-head :_partial-bd-added-tgt-rows-div]}}

  {:name :_partial-bd-modified-section-shown
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-section"}}
          :children [:_partial-bd-modified-section-head :_partial-bd-modified-rows-div]}}

  {:name :_partial-bd-added-src-section
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_partial-bd-added-in-source-rows}}
          :then :_partial-bd-added-src-hidden
          :else :_partial-bd-added-src-section-shown}}

  {:name :_partial-bd-added-tgt-section
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_partial-bd-added-in-target-rows}}
          :then :_partial-bd-added-tgt-hidden
          :else :_partial-bd-added-tgt-section-shown}}

  {:name :_partial-bd-modified-section
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_partial-bd-modified-rows}}
          :then :_partial-bd-modified-hidden
          :else :_partial-bd-modified-section-shown}}

  ;; --- Top-level body: summary + 3 sections, OR empty state.
  {:name :_partial-bd-count-text
   :parent :to-str
   :args {:value :_partial-bd-count}}

  {:name :_partial-bd-summary-text
   :parent :str-join
   :args {:coll [:_partial-bd-count-text {:value " difference(s)"}]
          :separator {:value ""}}}

  {:name :_partial-bd-summary-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-summary"}}
          :children [:_partial-bd-summary-text]}}

  {:name :_partial-bd-empty-msg-text
   :parent :str-join
   :args {:coll [{:value "No differences — "}
                 :_partial-bd-source-name
                 {:value " and "}
                 :_partial-bd-target-name
                 {:value " resolve to the same view."}]
          :separator {:value ""}}}

  {:name :_partial-bd-empty-msg
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-empty"}}
          :children [:_partial-bd-empty-msg-text]}}

  {:name :_partial-bd-body-populated
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-body-populated"}}
          :children [:_partial-bd-summary-div
                     :_partial-bd-added-src-section
                     :_partial-bd-added-tgt-section
                     :_partial-bd-modified-section]}}

  {:name :_partial-bd-body
   :parent :if
   :args {:test :_partial-bd-empty?
          :then :_partial-bd-empty-msg
          :else :_partial-bd-body-populated}}

  {:name :_partial-bd-fragment
   :description "Full branch-diff body hiccup. JS owns the surrounding modal chrome (overlay + card + header + close button) — this partial fills the `.branch-diff-body` mount inside it."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-diff-body-content"}}
          :children [:_partial-bd-body]}}

  {:name :_partial-bd-html
   :parent :render-hiccup
   :args {:hiccup :_partial-bd-fragment}}

  {:name :_partial-branch-diff-handler
   :description "Ring handler for `GET /partials/branch-diff?target=X&source=Y` — returns the diff body hiccup as `text/html`. JS in `editor-branch-diff.js` swaps the response into the modal body and binds row-click navigation handlers post-swap."
   :parent :html-ok-response
   :args {:body :_partial-bd-html}}

  ;; ---------------------------------------------------------------------
  ;; MERGE-CONFLICTS PARTIAL (graph-first §6) — POST /partials/merge-conflicts
  ;; with the JSON body `{conflicts, source, target}` the failed merge
  ;; already returned to JS. The server RENDERS those conflicts as the
  ;; resolution CARD hiccup (header + help + (>1) batch toolbar +
  ;; per-conflict rows with source/target radios + version previews +
  ;; error slot + Cancel/Apply). It does NOT re-detect — the conflicts are
  ;; already in hand, so this mirrors `:_partial-execute-result-inline-*`
  ;; (POST the already-computed data, server owns only the markup) rather
  ;; than duplicating `detect-conflicts`. Client data is trusted for
  ;; DISPLAY only — the re-submitted merge re-validates every resolution
  ;; server-side. JS in editor-branches.js owns the modal chrome (the
  ;; full-viewport overlay div — a flex sibling of the card, so it can't
  ;; live under this single-root fragment) + the radio/apply lifecycle (it
  ;; reads each row's `data-entity-*` + checked radio on submit).
  ;; ---------------------------------------------------------------------

  {:name :_partial-mc-body
   :description "JSON request body — `{:conflicts [...] :source <name> :target <name>}`, the shape the failed merge returned to JS. `:parse-json-body` types its return `:nullable-jsonb`; the modal only POSTs a keyword-keyed map, so narrow to `:nullable-keyword-map` for the downstream `:get` reads."
   :parent :parse-json-body
   :return-type :nullable-keyword-map
   :args {:request {:as :request}}}

  {:name :_partial-mc-conflicts
   :description "The conflict list straight from the POST body — `[{:entity-name :entity-id :source-version :target-version}]`, exactly as the merge's `:merge-conflict` response carried it."
   :parent :get
   :args {:coll :_partial-mc-body :key {:value :conflicts} :default {:value []}}}

  {:name :_partial-mc-count
   :parent :count
   :args {:coll :_partial-mc-conflicts}}

  {:name :_partial-mc-count-text
   :parent :to-str
   :args {:value :_partial-mc-count}}

  {:name :_partial-mc-source-name
   :parent :get
   :args {:coll :_partial-mc-body :key {:value :source} :default {:value "(source)"}}}

  {:name :_partial-mc-target-name
   :parent :get
   :args {:coll :_partial-mc-body :key {:value :target} :default {:value "(target)"}}}

  ;; --- Version preview (server mirror of `previewVersion`): "(deleted)"
  ;; for a nil version map, else the space-joined present fields
  ;; (name / "desc" / pos=N / value=…), long fields ellipsised at 32.

  {:name :_partial-mc-trunc-long?
   :parent :gt
   :args {:nums [{:parent :str-len :args {:string {:as :string}}} {:value 32}]}}

  {:name :_partial-mc-trunc-cut
   :parent :str
   :args {:parts [{:parent :subs :args {:string {:as :string} :start {:value 0} :end {:value 31}}}
                  {:value "…"}]}}

  {:name :_partial-mc-truncate
   :description "Truncate a string to 32 chars + ellipsis (mirrors JS `truncate(s, 32)`). `:string` is a free arg so the description and value previews reuse the same chain."
   :parent :if
   :args {:test :_partial-mc-trunc-long?
          :then :_partial-mc-trunc-cut
          :else {:as :string}}}

  {:name :_partial-mc-part-present?
   :description "Filter pred — keep non-empty preview parts (drops the `\"\"` an absent field contributes so `:str-join` doesn't emit stray separators)."
   :parent :not
   :args {:value {:parent :empty? :args {:coll {:as :item}}}}}

  {:name :_partial-mc-pv-name
   :parent :coalesce
   :args {:value {:parent :get :args {:coll {:as :version} :key {:value :name} :default nil}}
          :default {:value ""}}}

  {:name :_partial-mc-pv-desc-raw
   :parent :get
   :args {:coll {:as :version} :key {:value :description} :default nil}}

  {:name :_partial-mc-pv-desc-part
   :parent :if
   :args {:test {:parent :some? :args {:value :_partial-mc-pv-desc-raw}}
          :then {:parent :str
                 :args {:parts [{:value "\""}
                                {:parent :_partial-mc-truncate :args {:string :_partial-mc-pv-desc-raw}}
                                {:value "\""}]}}
          :else {:value ""}}}

  {:name :_partial-mc-pv-pos-raw
   :parent :get
   :args {:coll {:as :version} :key {:value :position} :default nil}}

  {:name :_partial-mc-pv-pos-part
   :parent :if
   :args {:test {:parent :some? :args {:value :_partial-mc-pv-pos-raw}}
          :then {:parent :str :args {:parts [{:value "pos="} :_partial-mc-pv-pos-raw]}}
          :else {:value ""}}}

  {:name :_partial-mc-pv-value-raw
   :parent :get
   :args {:coll {:as :version} :key {:value :value} :default nil}}

  {:name :_partial-mc-pv-value-part
   :parent :if
   :args {:test {:parent :some? :args {:value :_partial-mc-pv-value-raw}}
          :then {:parent :str
                 :args {:parts [{:value "value="}
                                {:parent :_partial-mc-truncate
                                 :args {:string {:parent :to-str :args {:value :_partial-mc-pv-value-raw}}}}]}}
          :else {:value ""}}}

  {:name :_partial-mc-pv-parts
   :parent :filter
   :args {:pred :_partial-mc-part-present?
          :coll [:_partial-mc-pv-name :_partial-mc-pv-desc-part
                 :_partial-mc-pv-pos-part :_partial-mc-pv-value-part]}}

  {:name :_partial-mc-pv-joined
   :parent :str-join
   :args {:coll :_partial-mc-pv-parts :separator {:value " "}}}

  {:name :_partial-mc-pv-nonempty
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_partial-mc-pv-joined}}
          :then {:value "(empty)"}
          :else :_partial-mc-pv-joined}}

  {:name :_partial-mc-preview
   :description "Server mirror of `previewVersion` — `(deleted)` when the version map is nil (side removed the entity), else the space-joined present fields. `:version` is a free arg so the row renderer feeds source-version and target-version through the same chain."
   :parent :if
   :args {:test {:parent :nil? :args {:value {:as :version}}}
          :then {:value "(deleted)"}
          :else :_partial-mc-pv-nonempty}}

  ;; --- Per-conflict HOF callback (`{:as :item}` = one conflict row) ---

  {:name :_partial-mc-row-entity-name-raw
   :parent :get
   :args {:coll {:as :item} :key {:value :entity-name} :default {:value ""}}}

  {:name :_partial-mc-row-entity-name
   :description "Entity-type as bare text (`fn`, not `:fn`) — the e2e asserts `.merge-conflict-entity` textContent `=== 'fn'`, and it also becomes the `data-entity-name` the JS submit reads."
   :parent :name
   :args {:value :_partial-mc-row-entity-name-raw}}

  {:name :_partial-mc-row-entity-id
   :parent :get
   :args {:coll {:as :item} :key {:value :entity-id} :default {:value ""}}}

  {:name :_partial-mc-row-source-version
   :parent :get
   :args {:coll {:as :item} :key {:value :source-version} :default nil}}

  {:name :_partial-mc-row-target-version
   :parent :get
   :args {:coll {:as :item} :key {:value :target-version} :default nil}}

  {:name :_partial-mc-row-source-preview
   :parent :_partial-mc-preview
   :args {:version :_partial-mc-row-source-version}}

  {:name :_partial-mc-row-target-preview
   :parent :_partial-mc-preview
   :args {:version :_partial-mc-row-target-version}}

  {:name :_partial-mc-row-radio-name
   :description "Per-row radio-group name — unique via the entity-id so the two radios in a row are mutually exclusive but independent of other rows."
   :parent :str
   :args {:parts [{:value "mc-"} :_partial-mc-row-entity-id]}}

  {:name :_partial-mc-row-source-radio
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:parent :zipmap
                  :args {:keys [{:value :type} {:value :name} {:value :value} {:value :checked}]
                         :vals [{:value "radio"} :_partial-mc-row-radio-name {:value "source"} {:value true}]}}
          :children {:value []}}}

  {:name :_partial-mc-row-target-radio
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:parent :zipmap
                  :args {:keys [{:value :type} {:value :name} {:value :value}]
                         :vals [{:value "radio"} :_partial-mc-row-radio-name {:value "target"}]}}
          :children {:value []}}}

  {:name :_partial-mc-strong-source
   :parent :hiccup
   :args {:tag {:value "strong"} :attrs {:value {}} :children ["source"]}}

  {:name :_partial-mc-strong-target
   :parent :hiccup
   :args {:tag {:value "strong"} :attrs {:value {}} :children ["target"]}}

  {:name :_partial-mc-row-source-code
   :parent :hiccup
   :args {:tag {:value "code"} :attrs {:value {}} :children [:_partial-mc-row-source-preview]}}

  {:name :_partial-mc-row-target-code
   :parent :hiccup
   :args {:tag {:value "code"} :attrs {:value {}} :children [:_partial-mc-row-target-preview]}}

  {:name :_partial-mc-row-source-label
   :parent :hiccup
   :args {:tag {:value "label"} :attrs {:value {}}
          :children [:_partial-mc-row-source-radio {:value " "} :_partial-mc-strong-source
                     {:value " "} :_partial-mc-row-source-code]}}

  {:name :_partial-mc-row-target-label
   :parent :hiccup
   :args {:tag {:value "label"} :attrs {:value {}}
          :children [:_partial-mc-row-target-radio {:value " "} :_partial-mc-strong-target
                     {:value " "} :_partial-mc-row-target-code]}}

  {:name :_partial-mc-row-choice
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflict-choice"}}
          :children [:_partial-mc-row-source-label :_partial-mc-row-target-label]}}

  {:name :_partial-mc-row-entity-span
   :parent :hiccup
   :args {:tag {:value "span"} :attrs {:value {:class "merge-conflict-entity"}}
          :children [:_partial-mc-row-entity-name]}}

  {:name :_partial-mc-row-id-span
   :parent :hiccup
   :args {:tag {:value "span"} :attrs {:value {:class "merge-conflict-id"}}
          :children [:_partial-mc-row-entity-id]}}

  {:name :_partial-mc-row-head
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflict-row-head"}}
          :children [:_partial-mc-row-entity-span :_partial-mc-row-id-span]}}

  {:name :_partial-mc-row-attrs
   :description "Row div attrs — class + the two `data-entity-*` attrs the JS submit reads to build `:conflict-resolutions`."
   :parent :zipmap
   :args {:keys [{:value :class} {:value :data-entity-name} {:value :data-entity-id}]
          :vals [{:value "merge-conflict-row"} :_partial-mc-row-entity-name :_partial-mc-row-entity-id]}}

  {:name :_partial-mc-row
   :parent :hiccup
   :args {:tag {:value "div"} :attrs :_partial-mc-row-attrs
          :children [:_partial-mc-row-head :_partial-mc-row-choice]}}

  {:name :_partial-mc-rendered
   :parent :map
   :args {:func :_partial-mc-row :coll :_partial-mc-conflicts}}

  {:name :_partial-mc-rows-div
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflicts-rows"}}
          :children :_partial-mc-rendered}}

  ;; --- Card chrome: header / help / batch toolbar / error / actions ---

  {:name :_partial-mc-plural
   :description "\"\" for exactly 1 conflict, \"s\" otherwise (mirrors JS `length === 1 ? '' : 's'`)."
   :parent :if
   :args {:test {:parent :equal? :args {:a :_partial-mc-count :b {:value 1}}}
          :then {:value ""}
          :else {:value "s"}}}

  {:name :_partial-mc-header-prefix
   :parent :str
   :args {:parts [{:value "Resolve "} :_partial-mc-count-text {:value " conflict"}
                  :_partial-mc-plural {:value " merging "}]}}

  {:name :_partial-mc-header-strong-src
   :parent :hiccup
   :args {:tag {:value "strong"} :attrs {:value {}} :children [:_partial-mc-source-name]}}

  {:name :_partial-mc-header-strong-tgt
   :parent :hiccup
   :args {:tag {:value "strong"} :attrs {:value {}} :children [:_partial-mc-target-name]}}

  {:name :_partial-mc-header
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflicts-header"}}
          :children [:_partial-mc-header-prefix :_partial-mc-header-strong-src
                     {:value " → "} :_partial-mc-header-strong-tgt]}}

  {:name :_partial-mc-help-em-src
   :parent :hiccup
   :args {:tag {:value "em"} :attrs {:value {}} :children ["source"]}}

  {:name :_partial-mc-help-em-tgt
   :parent :hiccup
   :args {:tag {:value "em"} :attrs {:value {}} :children ["target"]}}

  {:name :_partial-mc-help
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflicts-help"}}
          :children [{:value "For each entity, pick which side wins. "}
                     :_partial-mc-help-em-src {:value " = "} :_partial-mc-source-name
                     {:value ", "} :_partial-mc-help-em-tgt {:value " = "} :_partial-mc-target-name
                     {:value "."}]}}

  {:name :_partial-mc-batch-multi?
   :parent :gt
   :args {:nums [:_partial-mc-count {:value 1}]}}

  {:name :_partial-mc-batch-src-title
   :parent :str
   :args {:parts [{:value "Set every row to source — "} :_partial-mc-source-name]}}

  {:name :_partial-mc-batch-tgt-title
   :parent :str
   :args {:parts [{:value "Set every row to target — "} :_partial-mc-target-name]}}

  {:name :_partial-mc-batch-src-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:parent :zipmap
                  :args {:keys [{:value :id} {:value :class} {:value :title}]
                         :vals [{:value "merge-conflicts-pick-all-source"}
                                {:value "branch-popover-btn merge-conflicts-batch-btn"}
                                :_partial-mc-batch-src-title]}}
          :children ["source"]}}

  {:name :_partial-mc-batch-tgt-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:parent :zipmap
                  :args {:keys [{:value :id} {:value :class} {:value :title}]
                         :vals [{:value "merge-conflicts-pick-all-target"}
                                {:value "branch-popover-btn merge-conflicts-batch-btn"}
                                :_partial-mc-batch-tgt-title]}}
          :children ["target"]}}

  {:name :_partial-mc-batch-label
   :parent :hiccup
   :args {:tag {:value "span"} :attrs {:value {:class "merge-conflicts-batch-label"}}
          :children ["Pick all:"]}}

  {:name :_partial-mc-batch-shown
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflicts-batch"}}
          :children [:_partial-mc-batch-label :_partial-mc-batch-src-btn :_partial-mc-batch-tgt-btn]}}

  {:name :_partial-mc-batch-hidden
   :description "Empty (hidden) span when the modal has a single conflict — a batch toolbar would just be noise. Keeps the card children-vector shape uniform."
   :parent :hiccup
   :args {:tag {:value "span"} :attrs {:value {:hidden "1"}} :children {:value []}}}

  {:name :_partial-mc-batch
   :parent :if
   :args {:test :_partial-mc-batch-multi?
          :then :_partial-mc-batch-shown
          :else :_partial-mc-batch-hidden}}

  {:name :_partial-mc-error
   :description "Error slot — starts hidden; JS un-hides it + fills textContent when the re-submitted merge fails."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "merge-conflicts-error hidden" :id "merge-conflicts-error"}}
          :children {:value []}}}

  {:name :_partial-mc-cancel-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:id "merge-conflicts-cancel"
                          :class "branch-popover-btn merge-conflicts-cancel"}}
          :children ["Cancel"]}}

  {:name :_partial-mc-apply-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:id "merge-conflicts-submit" :class "branch-popover-btn"}}
          :children ["Apply merge"]}}

  {:name :_partial-mc-actions
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflicts-actions"}}
          :children [:_partial-mc-cancel-btn :_partial-mc-apply-btn]}}

  {:name :_partial-mc-card
   :description "Full resolution card (single hiccup root). JS mounts it as a flex sibling of the overlay div it creates; the overlay CAN'T live here because `.merge-conflicts-modal` centres its two direct children and an extra wrapper would break that."
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflicts-card"}}
          :children [:_partial-mc-header :_partial-mc-help :_partial-mc-batch
                     :_partial-mc-rows-div :_partial-mc-error :_partial-mc-actions]}}

  {:name :_partial-mc-html
   :parent :render-hiccup
   :args {:hiccup :_partial-mc-card}}

  {:name :_partial-merge-conflicts-handler
   :description "Ring handler for `POST /partials/merge-conflicts` — body is the `{conflicts, source, target}` JSON the failed merge returned to JS; returns the resolution card hiccup as `text/html`. Renders the POSTed conflicts (no re-detection). JS in editor-branches.js owns the overlay chrome + radio/apply lifecycle."
   :parent :html-ok-response
   :args {:body :_partial-mc-html}}

  ;; ---------------------------------------------------------------------
  ;; Runtime-effects strip — chips for {runtime, declared} effect sets
  ;; with drift detection. Slimmed out of editor-execute-result.js
  ;; (rendered per-execution-result, was the most isolated of that
  ;; module's render helpers — single input shape, no recursive
  ;; rendering of arbitrary result values).
  ;;
  ;; Effects come in as comma-separated kebab-case names via query
  ;; string (`?runtime=db,io&declared=db`) so the JS caller can build
  ;; the URL without JSON-encoding. Empty list → empty string → split
  ;; returns `[""]` so we filter blanks.
  ;; ---------------------------------------------------------------------

  {:name :_partial-rfx-runtime-raw
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "runtime"}}}

  {:name :_partial-rfx-declared-raw
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "declared"}}}

  {:name :_partial-rfx-runtime-split
   :parent :str-split
   :args {:string {:parent :coalesce :args {:value :_partial-rfx-runtime-raw :default ""}}
          :separator {:value ","}}}

  {:name :_partial-rfx-declared-split
   :parent :str-split
   :args {:string {:parent :coalesce :args {:value :_partial-rfx-declared-raw :default ""}}
          :separator {:value ","}}}

  {:name :_partial-rfx-blank?
   :parent :blank?
   :args {:string {:as :item}}}

  {:name :_partial-rfx-not-blank?
   :parent :not
   :args {:value :_partial-rfx-blank?}}

  {:name :_partial-rfx-runtime
   :description "Cleaned runtime-effects list — drops empty strings produced by `str-split` on empty input."
   :parent :filter
   :args {:pred :_partial-rfx-not-blank? :coll :_partial-rfx-runtime-split}}

  {:name :_partial-rfx-declared
   :parent :filter
   :args {:pred :_partial-rfx-not-blank? :coll :_partial-rfx-declared-split}}

  {:name :_partial-rfx-empty?
   :description "Both sets empty → return empty fragment (caller's host stays untouched)."
   :parent :and
   :args {:values [{:parent :empty? :args {:coll :_partial-rfx-runtime}}
                   {:parent :empty? :args {:coll :_partial-rfx-declared}}]}}

  ;; --- Runtime chips (effects that ACTUALLY fired). Drift detection:
  ;; chip carries `execute-effects-drift` when the runtime effect isn't
  ;; in the declared set (impl widens what the rich-type promised).
  ;;
  ;; `:contains?` over a list checks INDEX, not value — so we build a
  ;; set-as-map `{eff true}` via `:into {} <pairs>` and `:contains?` it
  ;; by key. Pair HOF: `:_partial-rfx-pair-true` returns `[item true]`.
  {:name :_partial-rfx-pair-true
   :description "Per-item HOF — returns `[item true]` as a VECTOR (not list); `:into {} <list-of-pairs>` requires vector-shaped Map$Entry items at runtime."
   :parent :vec
   :args {:coll [{:as :item} {:value true}]}}

  {:name :_partial-rfx-declared-pairs
   :parent :map
   :args {:func :_partial-rfx-pair-true :coll :_partial-rfx-declared}}

  {:name :_partial-rfx-runtime-declared-set
   :parent :into
   :args {:to {:value {}} :from :_partial-rfx-declared-pairs}}

  {:name :_partial-rfx-runtime-drift?
   :parent :not
   :args {:value {:parent :contains?
                  :args {:coll :_partial-rfx-runtime-declared-set
                         :key {:as :item}}}}}

  {:name :_partial-rfx-runtime-chip-class-base
   :parent :str-join
   :args {:coll [{:value "effects-chip effects-chip-"} {:as :item}]
          :separator {:value ""}}}

  {:name :_partial-rfx-runtime-chip-class
   :parent :if
   :args {:test :_partial-rfx-runtime-drift?
          :then {:parent :str-join
                 :args {:coll [:_partial-rfx-runtime-chip-class-base
                               {:value " execute-effects-drift"}]
                        :separator {:value ""}}}
          :else :_partial-rfx-runtime-chip-class-base}}

  {:name :_partial-rfx-runtime-chip-attrs
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :class}
          :value :_partial-rfx-runtime-chip-class}}

  {:name :_partial-rfx-runtime-chip
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs :_partial-rfx-runtime-chip-attrs
          :children [{:as :item}]}}

  {:name :_partial-rfx-runtime-chips
   :parent :map
   :args {:func :_partial-rfx-runtime-chip :coll :_partial-rfx-runtime}}

  ;; --- Declared-but-unobserved chips (declared but didn't fire on this
  ;; run). Skipped entirely when no runtime data was recorded — "missing"
  ;; in that case means "unknown", not "unobserved". The check is
  ;; `runtime-non-empty? AND not (item in runtime-set)`. Same set-as-map
  ;; trick as the drift check above.
  {:name :_partial-rfx-runtime-pairs
   :parent :map
   :args {:func :_partial-rfx-pair-true :coll :_partial-rfx-runtime}}

  {:name :_partial-rfx-runtime-set
   :parent :into
   :args {:to {:value {}} :from :_partial-rfx-runtime-pairs}}

  {:name :_partial-rfx-runtime-non-empty?
   :parent :not
   :args {:value {:parent :empty? :args {:coll :_partial-rfx-runtime}}}}

  {:name :_partial-rfx-declared-show-unobserved?
   :parent :and
   :args {:values [:_partial-rfx-runtime-non-empty?
                   {:parent :not :args {:value {:parent :contains?
                                                :args {:coll :_partial-rfx-runtime-set
                                                       :key {:as :item}}}}}]}}

  {:name :_partial-rfx-declared-chip-class
   :parent :str-join
   :args {:coll [{:value "effects-chip effects-chip-"} {:as :item}
                 {:value " execute-effects-unobserved"}]
          :separator {:value ""}}}

  {:name :_partial-rfx-declared-chip-title
   :parent :str-join
   :args {:coll [{:value "Declared by the fn-def but the runtime impl didn't fire it: "}
                 {:as :item}]
          :separator {:value ""}}}

  {:name :_partial-rfx-declared-chip-shown
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:parent :assoc
                  :args {:map {:parent :assoc
                               :args {:map {:value {}}
                                      :key {:value :class}
                                      :value :_partial-rfx-declared-chip-class}}
                         :key {:value :title}
                         :value :_partial-rfx-declared-chip-title}}
          :children [{:as :item}]}}

  ;; Hidden span (zero-width sentinel) when the chip should be skipped —
  ;; keeps the children-vec shape uniform across runs.
  {:name :_partial-rfx-declared-chip-hidden
   :parent :hiccup
   :args {:tag {:value "span"} :attrs {:value {:hidden "1"}} :children {:value []}}}

  {:name :_partial-rfx-declared-chip
   :parent :if
   :args {:test :_partial-rfx-declared-show-unobserved?
          :then :_partial-rfx-declared-chip-shown
          :else :_partial-rfx-declared-chip-hidden}}

  {:name :_partial-rfx-declared-chips
   :parent :map
   :args {:func :_partial-rfx-declared-chip :coll :_partial-rfx-declared}}

  ;; --- Composition.
  {:name :_partial-rfx-label
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "execute-runtime-effects-label"}}
          :children ["ran: "]}}

  ;; Wrap the label in a 1-element list so `:concat :colls` sees a
  ;; collection of collections (the inner `[:_partial-rfx-label]`
  ;; literal would store as `[:literal-kw]`, not as a ref to the
  ;; label fn-def — `:value` literals don't resolve refs).
  {:name :_partial-rfx-label-list
   :parent :list
   :args {:items [:_partial-rfx-label]}}

  {:name :_partial-rfx-strip-children
   :parent :concat
   :args {:colls [:_partial-rfx-label-list
                  :_partial-rfx-runtime-chips
                  :_partial-rfx-declared-chips]}}

  {:name :_partial-rfx-strip-populated
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-runtime-effects-strip"}}
          :children :_partial-rfx-strip-children}}

  {:name :_partial-rfx-strip-empty
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:hidden "1"}} :children {:value []}}}

  {:name :_partial-rfx-strip
   :parent :if
   :args {:test :_partial-rfx-empty?
          :then :_partial-rfx-strip-empty
          :else :_partial-rfx-strip-populated}}

  {:name :_partial-rfx-html
   :parent :render-hiccup
   :args {:hiccup :_partial-rfx-strip}}

  {:name :_partial-execute-result-effects-handler
   :description "Ring handler for `GET /partials/execute-result-effects?runtime=db,io&declared=db` — returns the runtime-effects strip hiccup as `text/html`. JS in `editor-execute.js` swaps the response into the result host below the result body."
   :parent :html-ok-response
   :args {:body :_partial-rfx-html}}

  ;; Concrete editor routes (`/`, `/favicon.ico`, `/partials/...`,
  ;; `/api/entities/...`, `/api/sequence/...`) live in `app.routes`;
  ;; they reference the handler fn-defs above by name.
  ]}
