                                   :args {:a :_branch-policy-value :b {:value "admins"}}}]}}}}

  {:name :_branch-policy-err-invalid
   :parent :const
   :return-type :_error-result-shape
   :args {:value {:ok false :error "write-policy must be one of: open, owner, admins"}}}

