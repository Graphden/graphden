;; Development system configuration
;; Uses local PostgreSQL with sensible defaults
;;
;; NOTE: Credentials use environment variables with dev defaults.
;; For production, always set proper environment variables.

{:db/schema {}

 :db/postgres
 {:jdbc-url #or [#env GRAPHDEN_JDBC_URL "jdbc:postgresql://localhost:5434/graphden"]
  :username #or [#env GRAPHDEN_DB_USER "graphden"]
  :password #or [#env GRAPHDEN_DB_PASSWORD "graphden"]
  :pool-size 5
  :schema #ig/ref :db/schema}

 :db/versioned
 {:base-storage #ig/ref :db/postgres}

 ;; Load packages from resources/packages/
 :app/packages
 {:package-names ["core" "web" "app" "examples"]}

 :exec/base-fns
 {:storage #ig/ref :db/versioned
  :packages #ig/ref :app/packages}

 :exec/fn-entities
 {:storage #ig/ref :db/versioned
  :packages #ig/ref :app/packages
  :base-fns #ig/ref :exec/base-fns}

 :exec/context
 {:storage #ig/ref :db/versioned}

 ;; Compile fn graphs into Clojure closures at startup. Depends on
 ;; fn-entities so every composed fn is already in storage before we
 ;; traverse them.
 :exec/compiled-registry
 {:context #ig/ref :exec/context
  :_fn-entities #ig/ref :exec/fn-entities}

 ;; Phase 1 service registry — see system-prod.edn for the full
 ;; rationale. Fallback to packages' :startup-fn when no rows exist.
 :exec/service-reconciler
 {:context #ig/ref :exec/context
  :packages #ig/ref :app/packages
  :_compiled-registry #ig/ref :exec/compiled-registry}

 ;; Hourly sweep of :fn-execution rows past per-status TTL.
 :exec/cleanup-scheduler
 {:context #ig/ref :exec/context
  :period-ms 3600000}}
