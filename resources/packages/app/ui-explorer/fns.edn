       {:name :_explorer-button-lint :parent :hiccup :args {:tag "button" :attrs :_explorer-attrs-lint :children [:_explorer-glyph-lint :_explorer-label-lint :_explorer-count-node-lint]}}
       {:name :_explorer-detail-pressed :parent :if :args {:test :_explorer-input-fx :then "true" :else "false"}}
