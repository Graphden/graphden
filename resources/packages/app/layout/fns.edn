;; Graph layout calculation base functions
;; compute-layout-matrix: calculates grid-based layout for graph visualization

[;; Core layout function - takes nodes/edges and returns layout matrix
 ;; Input: {:nodes [{:id :type :label ...}], :edges [{:source :target :argName}], :root-id uuid}
 ;; Output: {:grid-pos {node-id {:row n :col n}}, :matrix {...}, :validation {...}}
 {:name :compute-layout-matrix
  :args {:elements :jsonb}
  :return-type :jsonb}

 ;; Layout data function - computes layout from elements in request body
 ;; Used by make-json-response-handler
 {:name :get-layout-data
  :args {:request :jsonb}
  :return-type :jsonb}

 ;; =============================================================================
 ;; FN-DEFS: Layout API handler
 ;; =============================================================================

 ;; Layout handler using make-json-response-handler pattern
 {:name :layout-api-handler
  :parent :make-json-response-handler
  :args {:data-fn :get-layout-data}}

 ;; POST /api/graph/layout - accepts root-id and expands list
 {:name :layout-api-route
  :parent :post-route
  :args {:path "/api/graph/layout" :handler :layout-api-handler}}]
