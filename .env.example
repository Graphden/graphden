# Graphden Executor Server Configuration
# Copy this file to .env and adjust values as needed

# Server settings
PORT=8080

# Storage type: memory | postgres
# - memory: In-memory storage (for testing, data lost on restart)
# - postgres: PostgreSQL with full stack (versioning + caching + metrics)
STORAGE_TYPE=postgres

# PostgreSQL connection settings (required when STORAGE_TYPE=postgres)
JDBC_URL=jdbc:postgresql://localhost:5432/graphden
DB_USERNAME=graphden
DB_PASSWORD=graphden
DB_POOL_SIZE=10

# Opt-in seed of demo branches for the versioning UI. Off by default —
# real prod stays clean of demo rows. Set to 1 / true / yes / on to
# enable; the local docker-compose `.env` does so out of the box.
# See `graphden.system.demo-branches` for the declared branches +
# mutation vocabulary.
# GRAPHDEN_DEMO_BRANCHES_ENABLED=1
