;; Development system configuration
;; Uses local PostgreSQL with sensible defaults
;;
;; NOTE: Credentials use environment variables with dev defaults.
;; For production, always set proper environment variables.

{:db/schema {}

 :db/age
 {:jdbc-url #or [#env GRAPHDEN_JDBC_URL "jdbc:postgresql://localhost:5434/graphden"]
  :username #or [#env GRAPHDEN_DB_USER "graphden"]
  :password #or [#env GRAPHDEN_DB_PASSWORD "graphden"]
  :pool-size 5
  :schema #ig/ref :db/schema}

 :db/versioned
 {:base-storage #ig/ref :db/age}

 :exec/base-fns
 {:storage #ig/ref :db/versioned}

 :exec/fn-entities
 {:storage #ig/ref :db/versioned
  :fn-defs #ig/ref :app/fn-defs}

 :exec/context
 {:storage #ig/ref :db/versioned
  :max-depth 1000
  :timeout-ms 120000}

 :http/server
 {:context #ig/ref :exec/context
  :startup-fn-name :web-server
  :port 8080}

 :app/fn-defs #var graphden.library.fn-defs.web.editor/fn-defs}
