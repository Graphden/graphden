{:namespace "app.ui-account-menu"
 :fns
 [{:name :_root-update-input :type {:state :_account-menu-state :context :_account-menu-context :event :_account-menu-event}}
  {:name :_root-server-state :type {:phase :text :label :text :branch-name :text}}
  {:name :_root-view-input :type {:state :_account-menu-state :theme :_account-menu-theme :server :_root-server-state}}
  {:name :_root-view-result :type {:frame :hiccup-node :common-rows [:list :hiccup-node] :common-tree :hiccup-node
                                   :styles [:list {:selector :text :declarations :text-map}]
                                   :active :int :phase :text :handled :bool
                                   :theme-tokens :text-map :menu-tokens :text-map
                                   :motion {:duration-ms :int :offset-y :int :opacity :non-negative-int}}}
  {:name :_root-update-result :type {:phase :text :active :numeric :handled :bool}}
  {:name :_root-initial-callable :fn-type [{} :app.ui-account-menu/_account-menu-state]}
  {:name :_root-update-callable :fn-type [{:input :app.ui-account-menu/_root-update-input} :app.ui-account-menu/_root-update-result]}
  {:name :_root-view-callable :fn-type [{:input :app.ui-account-menu/_root-view-input} :app.ui-account-menu/_root-view-result]}
  {:name :_root-initial-record :type {:initial :app.ui-account-menu/_root-initial-callable}}
  {:name :_root-update-record :type {:initial :app.ui-account-menu/_root-initial-callable :update :app.ui-account-menu/_root-update-callable}}
  {:name :_root-query-callable :fn-type [{:input :app.ui-account-menu/_account-query-input} :app.ui-account-menu/_account-query-result]}
  {:name :_root-view-record :type {:initial :app.ui-account-menu/_root-initial-callable :update :app.ui-account-menu/_root-update-callable :view :app.ui-account-menu/_root-view-callable}}
  {:name :root-component :type {:initial :app.ui-account-menu/_root-initial-callable :update :app.ui-account-menu/_root-update-callable :view :app.ui-account-menu/_root-view-callable :query :app.ui-account-menu/_root-query-callable}}
  {:name :root-initial :parent :account-menu-initial :lambda-params []}
  {:name :root-update :parent :account-menu-update :lambda-params [:input]
   :return-type :app.ui-account-menu/_root-update-result
   :args {:state {:parent :get :args {:coll {:as :input :type :app.ui-account-menu/_root-update-input} :key {:value :state}}}
          :context {:parent :get :args {:coll {:as :input :type :app.ui-account-menu/_root-update-input} :key {:value :context}}}
          :event {:parent :get :args {:coll {:as :input :type :app.ui-account-menu/_root-update-input} :key {:value :event}}}}}
  {:name :_root-base-view :parent :account-menu-view
   :return-type :app.ui-account-menu/_root-view-result
   :args {:state {:parent :get :args {:coll {:as :input :type :app.ui-account-menu/_root-view-input} :key {:value :state}}}
          :theme {:parent :get :args {:coll {:as :input :type :app.ui-account-menu/_root-view-input} :key {:value :theme}}}}}
  {:name :_root-server :parent :get
   :args {:coll {:as :input :type :app.ui-account-menu/_root-view-input} :key {:value :server}}}
  {:name :_root-server-phase :parent :get :args {:coll :_root-server :key {:value :phase} :default "idle"}}
  {:name :_root-server-label :parent :get :args {:coll :_root-server :key {:value :label} :default ""}}
  {:name :_root-server-branch :parent :get :args {:coll :_root-server :key {:value :branch-name} :default ""}}
  {:name :_root-server-ready :parent :equal? :args {:a :_root-server-phase :b "ready"}}
  {:name :_root-server-loading :parent :equal? :args {:a :_root-server-phase :b "loading"}}
  {:name :_root-server-error :parent :equal? :args {:a :_root-server-phase :b "error"}}
  {:name :_root-server-details :parent :str :args {:parts [:_root-server-label " · " :_root-server-branch]}}
  {:name :_root-server-failure :parent :if :args {:test :_root-server-error :then "Account details could not be loaded." :else ""}}
  {:name :_root-server-pending :parent :if :args {:test :_root-server-loading :then "Loading account details…" :else :_root-server-failure}}
  {:name :_root-server-text :parent :if :args {:test :_root-server-ready :then :_root-server-details :else :_root-server-pending}}
  {:name :_root-server-node :parent :hiccup
   :args {:tag "div" :attrs {:value {:role "status" :class "auth-menu-status"}} :children [:_root-server-text]}}
  {:name :_root-common-tree :parent :hiccup
   :args {:tag "div" :attrs {:value {:class "auth-menu-common"}} :children [:settings-row :organization-row :_root-server-node]}}
  {:name :root-view :parent :assoc :lambda-params [:input] :return-type :app.ui-account-menu/_root-view-result
   :args {:map :_root-base-view :key {:value :common-tree} :value :_root-common-tree}}
  {:name :_root-initial-assoc :parent :assoc-fn
   :args {:value {:as :value :type :app.ui-account-menu/_root-initial-callable}}}
  {:name :_root-update-assoc :parent :assoc-fn
   :args {:value {:as :value :type :app.ui-account-menu/_root-update-callable}}}
  {:name :_root-view-assoc :parent :assoc-fn
   :args {:value {:as :value :type :app.ui-account-menu/_root-view-callable}}}
  {:name :_root-initial-field :parent :_root-initial-assoc :return-type :app.ui-account-menu/_root-initial-record
   :args {:map {} :key {:value :initial} :value {:ref :root-initial}}}
  {:name :_root-update-field :parent :_root-update-assoc :return-type :app.ui-account-menu/_root-update-record
   :args {:map {:ref :_root-initial-field :type :app.ui-account-menu/_root-initial-record} :key {:value :update} :value {:ref :root-update}}}
  {:name :_root-view-field :parent :_root-view-assoc :return-type :app.ui-account-menu/_root-view-record
   :args {:map {:ref :_root-update-field :type :app.ui-account-menu/_root-update-record} :key {:value :view} :value {:ref :root-view}}}
  {:name :_root-query-assoc :parent :assoc-fn
   :args {:value {:as :value :type :app.ui-account-menu/_root-query-callable}}}
  {:name :account-menu-component :parent :_root-query-assoc :return-type :app.ui-account-menu/root-component
   :args {:map {:ref :_root-view-field :type :app.ui-account-menu/_root-view-record} :key {:value :query} :value {:ref :account-menu-query}}}
  {:name :_account-menu-event :type {:kind :text :key :text :index :int}}
  {:name :_account-menu-state :type {:phase :text :active :int :handled :bool}}
  {:name :_account-menu-context :type {:items [:list :text]}}
  {:name :_account-menu-theme :type {:accent :core.refinements/color :canvas-background :core.refinements/color}}
  {:name :account-menu-initial :parent :const :return-type :_account-menu-state
   :args {:value {:value {:phase "closed" :active 0 :handled false}}}}
  {:name :account-menu-phase :parent :get :return-type :text
   :args {:coll {:as :state :type :_account-menu-state} :key {:value :phase} :default "closed"}}
  {:name :account-menu-active-index :parent :get :return-type :int
   :args {:coll {:as :state :type :_account-menu-state} :key {:value :active} :default 0}}
  {:name :_account-menu-handled :parent :get :return-type :bool
   :args {:coll {:as :state :type :_account-menu-state} :key {:value :handled} :default false}}
  {:name :_account-menu-raw-event-kind :parent :get :return-type :text
   :args {:coll {:as :event :type :_account-menu-event} :key {:value :kind} :default ""}}
  {:name :_account-menu-event-key :parent :get :return-type :text
   :args {:coll {:as :event :type :_account-menu-event} :key {:value :key} :default ""}}
  {:name :account-menu-key-map :parent :zipmap
   :args {:keys ["ArrowUp" "ArrowDown" "Home" "End" "Escape" "Tab"]
          :vals ["up" "down" "first" "last" "close" "close"]}}
  {:name :_account-menu-key-kind :parent :get :return-type :text
   :args {:coll :account-menu-key-map :key :_account-menu-event-key :default ""}}
  {:name :_account-menu-is-key-event :parent :equal?
   :args {:a :_account-menu-raw-event-kind :b "keydown"}}
  {:name :account-menu-event-kind :parent :if :return-type :text
   :args {:test :_account-menu-is-key-event :then :_account-menu-key-kind :else :_account-menu-raw-event-kind}}
  {:name :_account-menu-event-index :parent :get :return-type :int
   :args {:coll {:as :event :type :_account-menu-event} :key {:value :index} :default -1}}
  {:name :_account-menu-index-absent :parent :equal?
   :args {:a :_account-menu-event-index :b -1}}
  {:name :_account-menu-current-index :parent :if :return-type :int
   :args {:test :_account-menu-index-absent :then :account-menu-active-index :else :_account-menu-event-index}}
  {:name :_account-menu-items :parent :get :return-type [:list :text]
   :args {:coll {:as :context :type :_account-menu-context} :key {:value :items} :default {:value []}}}
  {:name :_account-menu-item-count :parent :count
   :args {:coll :_account-menu-items}}
  {:name :_account-menu-empty :parent :equal?
   :args {:a :_account-menu-item-count :b 0}}
  {:name :_account-menu-event-open :parent :equal?
   :args {:a :account-menu-event-kind :b "open"}}
  {:name :_account-menu-event-close :parent :equal?
   :args {:a :account-menu-event-kind :b "close"}}
  {:name :_account-menu-event-outside :parent :equal?
   :args {:a :account-menu-event-kind :b "outside"}}
  {:name :_account-menu-event-activate :parent :equal?
   :args {:a :account-menu-event-kind :b "activate"}}
  {:name :_account-menu-event-hover :parent :equal?
   :args {:a :account-menu-event-kind :b "hover"}}
  {:name :_account-menu-event-focus :parent :equal?
   :args {:a :account-menu-event-kind :b "focus"}}
  {:name :_account-menu-event-up :parent :equal?
   :args {:a :account-menu-event-kind :b "up"}}
  {:name :_account-menu-event-down :parent :equal?
   :args {:a :account-menu-event-kind :b "down"}}
  {:name :_account-menu-event-first :parent :equal?
   :args {:a :account-menu-event-kind :b "first"}}
  {:name :_account-menu-event-last :parent :equal?
   :args {:a :account-menu-event-kind :b "last"}}
  {:name :_account-menu-event-animation-finished :parent :equal?
   :args {:a :account-menu-event-kind :b "animation-finished"}}
  {:name :account-menu-is-closed :parent :equal?
   :args {:a :account-menu-phase :b "closed"}}
  {:name :account-menu-is-closing :parent :equal?
   :args {:a :account-menu-phase :b "closing"}}
  {:name :account-menu-is-opening :parent :equal?
   :args {:a :account-menu-phase :b "opening"}}
  {:name :_account-menu-unhandled-state :parent :assoc
   :args {:map {:as :state :type :_account-menu-state} :key {:value :handled} :value false}}
  {:name :_account-menu-handled-state :parent :assoc
   :args {:map {:as :state :type :_account-menu-state} :key {:value :handled} :value true}}
  {:name :account-menu-first :parent :assoc
   :args {:map :_account-menu-handled-state :key {:value :active} :value 0}}
  {:name :account-menu-open :parent :assoc
   :args {:map :account-menu-first :key {:value :phase} :value "opening"}}
  {:name :_account-menu-close-phase :parent :if :return-type :text
   :args {:test :account-menu-is-closed :then "closed" :else "closing"}}
  {:name :account-menu-close :parent :assoc
   :args {:map :_account-menu-handled-state :key {:value :phase} :value :_account-menu-close-phase}}
  {:name :_account-menu-toggle-open :parent :if
   :args {:test :account-menu-is-closing :then :account-menu-open :else :account-menu-close}}
  {:name :_account-menu-toggle :parent :if
   :args {:test :account-menu-is-closed :then :account-menu-open :else :_account-menu-toggle-open}}
  {:name :_account-menu-focus :parent :assoc
   :args {:map :_account-menu-handled-state :key {:value :active} :value :_account-menu-current-index}}
  {:name :_account-menu-step-delta :parent :if :return-type :int
   :args {:test :_account-menu-event-up :then -1 :else 1}}
  {:name :_account-menu-step-sum :parent :add
   :args {:nums [:_account-menu-current-index :_account-menu-step-delta]}}
  {:name :_account-menu-wrapped-index :parent :mod
   :args {:dividend :_account-menu-step-sum :divisor :_account-menu-item-count}}
  {:name :_account-menu-next-index :parent :if
   :args {:test :_account-menu-empty :then 0 :else :_account-menu-wrapped-index}}
  {:name :_account-menu-step :parent :assoc
   :args {:map :_account-menu-handled-state :key {:value :active} :value :_account-menu-next-index}}
  {:name :_account-menu-last-index :parent :add
   :args {:nums [:_account-menu-item-count -1]}}
  {:name :_account-menu-safe-last-index :parent :if
   :args {:test :_account-menu-empty :then 0 :else :_account-menu-last-index}}
  {:name :_account-menu-last :parent :assoc
   :args {:map :_account-menu-handled-state :key {:value :active} :value :_account-menu-safe-last-index}}
  {:name :_account-menu-finished-opening :parent :if :return-type :text
   :args {:test :account-menu-is-opening :then "open" :else :account-menu-phase}}
  {:name :_account-menu-finished-phase :parent :if :return-type :text
   :args {:test :account-menu-is-closing :then "closed" :else :_account-menu-finished-opening}}
  {:name :_account-menu-finished :parent :assoc
   :args {:map :_account-menu-unhandled-state :key {:value :phase} :value :_account-menu-finished-phase}}
  {:name :_account-menu-focus-update :parent :if
   :args {:test :_account-menu-event-focus :then :_account-menu-focus :else :_account-menu-unhandled-state}}
  {:name :_account-menu-hover-update :parent :if
   :args {:test :_account-menu-event-hover :then :_account-menu-focus :else :_account-menu-focus-update}}
  {:name :_account-menu-last-update :parent :if
   :args {:test :_account-menu-event-last :then :_account-menu-last :else :_account-menu-hover-update}}
  {:name :_account-menu-first-update :parent :if
   :args {:test :_account-menu-event-first :then :account-menu-first :else :_account-menu-last-update}}
  {:name :_account-menu-down-update :parent :if
   :args {:test :_account-menu-event-down :then :_account-menu-step :else :_account-menu-first-update}}
  {:name :_account-menu-up-update :parent :if
   :args {:test :_account-menu-event-up :then :_account-menu-step :else :_account-menu-down-update}}
  {:name :_account-menu-interactive :parent :if
   :args {:test :account-menu-is-closing :then :_account-menu-unhandled-state :else :_account-menu-up-update}}
  {:name :_account-menu-activate-update :parent :if
   :args {:test :_account-menu-event-activate :then :account-menu-close :else :_account-menu-interactive}}
  {:name :_account-menu-outside-update :parent :if
   :args {:test :_account-menu-event-outside :then :account-menu-close :else :_account-menu-activate-update}}
  {:name :_account-menu-close-update :parent :if
   :args {:test :_account-menu-event-close :then :account-menu-close :else :_account-menu-outside-update}}
  {:name :_account-menu-open-update :parent :if
   :args {:test :_account-menu-event-open :then :_account-menu-toggle :else :_account-menu-close-update}}
  {:name :account-menu-update :parent :if
   :args {:test :_account-menu-event-animation-finished :then :_account-menu-finished :else :_account-menu-open-update}}
  ;; Theme inputs are the effective built-in/saved theme BEFORE this graph layer.
  {:name :_theme-base-accent :parent :get :return-type :core.refinements/color
   :args {:coll {:as :theme :type :_account-menu-theme} :key {:value :accent} :default "#137c74"}}
  {:name :theme-accent :parent :core.refinements/color-const :return-type :core.refinements/color
   :args {:value :_theme-base-accent}}
  {:name :_theme-base-canvas-background :parent :get :return-type :core.refinements/color
   :args {:coll {:as :theme :type :_account-menu-theme} :key {:value :canvas-background} :default "#eff1f0"}}
  {:name :theme-canvas-background :parent :core.refinements/color-const :return-type :core.refinements/color
   :args {:value :_theme-base-canvas-background}}
  {:name :account-menu-hover :parent :core.refinements/color-const :return-type :core.refinements/color
   :args {:value :theme-canvas-background}}
  {:name :_theme-tokens :parent :zipmap
   :args {:keys [{:value "--gd-flow"} {:value "--bg"}]
          :vals [:theme-accent :theme-canvas-background]}}
  {:name :_account-menu-tokens :parent :zipmap
   :args {:keys [{:value "--gd-account-menu-hover"}]
          :vals [:account-menu-hover]}}
  ;; These are the real common rows; the host inserts native gated/session/footer rows.
  {:name :settings-row :parent :hiccup
   :args {:tag "button"
          :attrs {:value {:type "button" :class "auth-menu-item" :role "menuitem"
                          :key "settings" :tabindex -1 :data-action "settings" :data-item "Settings"}}
          :children ["Settings"]}}
  {:name :organization-row :parent :hiccup
   :args {:tag "button"
          :attrs {:value {:type "button" :class "auth-menu-item" :role "menuitem"
                          :key "operate" :tabindex -1 :data-action "operate" :data-item "Organization"}}
          :children ["Organization"]}}
  {:name :_account-menu-common-rows :parent :list
   :args {:items [:settings-row :organization-row]}}
  {:name :account-menu-common-tree :parent :hiccup
   :args {:tag "div" :attrs {:value {:class "auth-menu-common"}}
          :children :_account-menu-common-rows}}
  {:name :account-menu-item-highlight :parent :zipmap
   :return-type :text-map
   :args {:keys ["background-color"] :vals [:account-menu-hover]}}
  {:name :_account-menu-style :type {:selector :text :declarations :text-map}}
  {:name :_account-menu-hover-rule :parent :zipmap
   :return-type :_account-menu-style
   :args {:keys [{:value :selector} {:value :declarations}]
          :vals ["& .auth-menu-item:hover" :account-menu-item-highlight]}}
  {:name :_account-menu-focus-rule :parent :zipmap
   :return-type :_account-menu-style
   :args {:keys [{:value :selector} {:value :declarations}]
          :vals ["& .auth-menu-item:focus-visible" :account-menu-item-highlight]}}
  {:name :_account-menu-styles :list :_account-menu-style}
  {:name :account-menu-styles :parent :list
   :return-type :_account-menu-styles
   :args {:items [{:value {:selector "&" :declarations {"display" "contents"}}}
                  {:value {:selector "& > .auth-menu-common" :declarations {"display" "contents"}}}
                  :_account-menu-hover-rule :_account-menu-focus-rule]}}
  {:name :account-menu-frame :parent :hiccup
   :args {:tag "div"
          :attrs {:value {:class "auth-menu" :role "menu" :aria-label "Account and editor"}}
          :children []}}
  {:name :account-menu-animation-duration :parent :const :return-type :int
   :args {:value 160}}
  {:name :_account-menu-hidden-phase :parent :if :return-type :bool
   :args {:test :account-menu-is-closed :then true :else :account-menu-is-closing}}
  {:name :_account-menu-opacity :parent :if :return-type :non-negative-int
   :args {:test :_account-menu-hidden-phase :then 0 :else 1}}
  {:name :_account-menu-offset :parent :if :return-type :int
   :args {:test :_account-menu-hidden-phase :then -4 :else 0}}
  {:name :_account-menu-motion :parent :zipmap
   :args {:keys [{:value :duration-ms} {:value :offset-y} {:value :opacity}]
          :vals [:account-menu-animation-duration :_account-menu-offset :_account-menu-opacity]}}
  {:name :account-menu-view :parent :zipmap
   :args {:keys [{:value :frame} {:value :common-rows} {:value :common-tree} {:value :styles} {:value :active} {:value :phase} {:value :handled} {:value :theme-tokens} {:value :menu-tokens} {:value :motion}]
          :vals [:account-menu-frame :_account-menu-common-rows :account-menu-common-tree :account-menu-styles :account-menu-active-index :account-menu-phase :_account-menu-handled :_theme-tokens :_account-menu-tokens :_account-menu-motion]}}
  {:name :_account-query-input :type {:query :text}}
  {:name :_account-query-result :type {:label :text :branch-name :text}}
  {:name :_account-query-text :parent :get :return-type :text
   :args {:coll {:as :input :type :_account-query-input} :key {:value :query} :default ""}}
  {:name :_account-query-matches :parent :str-contains?
   :args {:string :current-branch-name :substring :_account-query-text}}
  {:name :_account-query-branch :parent :if :return-type :text
   :args {:test :_account-query-matches :then :current-branch-name :else ""}}
  {:name :_account-menu-branch-query :parent :zipmap :lambda-params [:input]
   :description "Read-only server query. The label is configured here and is never exported as a browser capture."
   :return-type :_account-query-result
   :args {:keys [{:value :label} {:value :branch-name}]
          :vals [{:value "Branch"} :_account-query-branch]}}
  {:name :account-menu-query :parent :server-call :lambda-params [:input]
   :description "Explicit async account-menu query; its server HOF remains on the server."
   :return-type :_account-query-result
   :args {:func {:ref :_account-menu-branch-query}
          :arg {:as :input :type :_account-query-input}}}
]}
