;; Contact-form demo — graph-composed page using
;; `web.components` + `web.runtime` + the built-in :submit-form
;; action handler. End-to-end proof that the components +
;; dispatcher pipeline works for a real interactive page.
;;
;; Routes shipped:
;;   GET  /demo/contact → :html-page-handler (via merged method-map)
;;   POST /demo/contact → :_contact-demo-post-handler
;;
;; Mounted in `app.route-groups.all` directly as `:demo-contact`.
;; Visit the page, type anything in the email + message fields,
;; click Send — the form POSTs via fetch (`submit-form`
;; handler), and the server's thanks partial is swapped into
;; the `#contact-result` div with no full-page reload. The
;; "Wave at me" button demonstrates the `:dispatch-custom`
;; escape hatch — inline JS body evaluated on click with
;; `btn`, `event`, `host` in scope.


{:namespace "app.contact-demo"
 :description "Block-2 demo — graph-composed contact-form page using web.components + web.runtime + the built-in :submit-form action handler."
 :fns
 [;; ---------------------------------------------------------------------------
  ;; FORM FIELDS
  ;; ---------------------------------------------------------------------------

  {:name :_contact-demo-email-input
   :description "Email field for the contact form — `<input type=email name=email required ...>`."
   :parent :input
   :args {:attrs {:value {:type "email"
                          :name "email"
                          :placeholder "you@example.com"
                          :required true
                          :style "width:100%;padding:8px;margin:6px 0;box-sizing:border-box"}}}}

  {:name :_contact-demo-message-textarea
   :description "Message field — `<textarea name=message rows=5>`."
   :parent :textarea
   :args {:attrs {:value {:name "message"
                          :rows 5
                          :placeholder "Tell us how we can help..."
                          :required true
                          :style "width:100%;padding:8px;margin:6px 0;box-sizing:border-box"}}
          :content ""}}

  ;; Submit button. The composition pattern is the canonical
  ;; "click-handler button with extra data-* payload":
  ;;
  ;;   :attrs = :dispatch-action {:action "submit-form"}
  ;;            (gives `:data-action "submit-form"`)
  ;;          + literal {:type "submit"
  ;;                     :data-target "#contact-result"}
  ;;            (the runtime swaps the response into the matched element)
  {:name :_contact-demo-submit-button
   :description "Send button — `data-action=\"submit-form\" data-target=\"#contact-result\"`."
   :parent :button
   :args {:label "Send"
          :attrs {:parent :merge
                  :args {:maps [{:parent :dispatch-action
                                 :args {:action "submit-form"}}
                                {:value {:type "submit"
                                         :data-target "#contact-result"
                                         :style "padding:10px 20px;cursor:pointer"}}]}}}}

  ;; ---------------------------------------------------------------------------
  ;; FORM + RESULT PANEL
  ;; ---------------------------------------------------------------------------

  ;; Empty result panel — populated post-submit by the runtime swapping
  ;; the POST handler's hiccup into it. `<div id=\"contact-result\">`.
  {:name :_contact-demo-result-panel
   :description "Empty `#contact-result` div the submit-form handler swaps the POST response into."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:id "contact-result"
                          :style "margin-top:1em;min-height:1.5em"}}
          :children {:value [""]}}}

  {:name :_contact-demo-form
   :description "POST /demo/contact form with email + textarea + submit; the runtime intercepts the submit click and swaps the response."
   :parent :form
   :args {:attrs {:value {:method "POST"
                          :action "/demo/contact"}}
          :children [:_contact-demo-email-input
                     :_contact-demo-message-textarea
                     :_contact-demo-submit-button]}}

  ;; Block 3.4 — escape-hatch button. Inline JS body bound via
  ;; `:dispatch-custom`; the runtime's `custom` handler evals it
  ;; on click with `btn`, `event`, `host` in scope. This stays
  ;; OUTSIDE the form (no submit) so it only demos the
  ;; escape-hatch path, not the form-post path.
  {:name :_contact-demo-custom-button
   :description "Escape-hatch demo button — toggles the result panel's text via inline JS, demonstrating `:dispatch-custom` without any server roundtrip."
   :parent :button
   :args {:label "Wave at me"
          :attrs {:parent :merge
                  :args {:maps [{:parent :dispatch-custom
                                 :args {:body "var t = document.getElementById('contact-result'); t.textContent = (t.textContent.trim() === '👋') ? '' : '👋';"}}
                                {:value {:type "button"
                                         :style "padding:8px 16px;margin-top:6px;cursor:pointer;background:transparent;border:1px solid #ccc;border-radius:4px"}}]}}}}

  ;; ---------------------------------------------------------------------------
  ;; PAGE BODY
  ;; ---------------------------------------------------------------------------

  {:name :_contact-demo-page-body
   :description "Card-wrapped contact-form page body with heading + intro paragraph."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:style "max-width:520px;margin:2em auto;padding:0 1em;font-family:system-ui,-apple-system,sans-serif"}}
          :children [{:value [:h1 "Contact us"]}
                     {:value [:p {:style "color:#555"}
                              "Block 2 demo — every element on this page is composed from "
                              [:code "web.components"]
                              " + "
                              [:code "web.runtime"]
                              " fn-defs. Submit goes through the runtime's "
                              [:code "submit-form"]
                              " action handler."]}
                     :_contact-demo-form
                     :_contact-demo-result-panel
                     :_contact-demo-custom-button]}}

  ;; ---------------------------------------------------------------------------
  ;; GET HANDLER — via :html-page-handler template
  ;; ---------------------------------------------------------------------------
  ;;
  ;; Six fn-defs (the page + render-hiccup + html-ok-response +
  ;; the two script tags + the script bundle) collapse to one
  ;; `:parent :html-page-handler` declaration that pins
  ;; `:title` / `:page-body` / `:scripts` and inherits the rest
  ;; from `app.page` and `app.editor` templates.

  {:name :_contact-demo-page-handler
   :description "GET /demo/contact handler — full HTML page via :html-page-handler with the graphden runtime scripts wired in."
   :parent :html-page-handler
   :args {:title "Contact (Graphden demo)"
          :page-body :_contact-demo-page-body
          :scripts :graphden-runtime-scripts}}

  ;; ---------------------------------------------------------------------------
  ;; POST HANDLER — returns the thanks partial
  ;; ---------------------------------------------------------------------------
  ;;
  ;; v0 doesn't echo the submitted email/message back — that
  ;; would require accessing the parsed form body, threading it
  ;; through `:parse-form-body`, and a couple of `:get` calls.
  ;; Future iteration when we want to demonstrate form-data
  ;; access end-to-end.

  {:name :_contact-demo-thanks-partial
   :description "Thanks-partial hiccup — `<p style=...>Thanks! We got your message.</p>`."
   :parent :hiccup
   :args {:tag {:value "p"}
          :attrs {:value {:style "color:green;font-weight:600"}}
          :children {:value ["Thanks! We got your message."]}}}

  {:name :_contact-demo-rendered-thanks
   :description "Render `:_contact-demo-thanks-partial` to an HTML string for the Ring response body."
   :parent :render-hiccup
   :return-type :text
   :args {:hiccup :_contact-demo-thanks-partial}}

  {:name :_contact-demo-post-handler
   :description "POST /demo/contact handler — returns a thanks partial that the runtime swaps into `#contact-result`."
   :parent :html-ok-response
   :args {:body :_contact-demo-rendered-thanks}}

  ;; ---------------------------------------------------------------------------
  ;; ROUTE ENTRIES — GET + POST merged into one /demo/contact path
  ;; ---------------------------------------------------------------------------
  ;;
  ;; Reitit needs a single entry per path; for GET + POST on
  ;; `/demo/contact` we build a method-map per method then
  ;; merge — same shape as `:api-branches-root`. Mounted
  ;; directly in `app.route-groups.all`'s items.

  {:name :_demo-contact-get-data
   :description "Method-data for GET on `/demo/contact`. Combined into `:demo-contact`."
   :parent :method-map
   :args {:method "get"
          :handler :_contact-demo-page-handler}}

  {:name :_demo-contact-post-data
   :description "Method-data for POST on `/demo/contact`. Combined into `:demo-contact`."
   :parent :method-map
   :args {:method "post"
          :handler :_contact-demo-post-handler}}

  {:name :_demo-contact-methods
   :description "Merged method-data — `{:get … :post …}` — for `/demo/contact`."
   :parent :merge
   :args {:maps [:_demo-contact-get-data :_demo-contact-post-data]}}

  {:name :demo-contact
   :description "Multi-method route entry `[\"/demo/contact\" {:get … :post …}]` for the contact-form demo. Mounted directly in `app.route-groups.all`."
   :parent :list
   :args {:items ["/demo/contact" :_demo-contact-methods]}}]}
