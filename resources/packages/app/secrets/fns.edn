   :description "Guard #1 — body lacked `:fn-id` (or unparseable UUID). Pure `:nil?` over the parsed `:fn-id`."
   :parent :nil?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :fn-id} :default nil}}}}

  {:name :_inline-bind-slot-id-missing?
   :description "Guard #2 — body lacked `:slot-id` (or unparseable UUID)."
   :parent :nil?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :slot-id} :default nil}}}}

  {:name :_inline-bind-path-blank?
   :description "Guard #3 — body lacked `:path`."
   :parent :blank?
   :args {:string {:parent :get :args {:coll {:as :parsed} :key {:value :path} :default nil}}}}

  {:name :_inline-bind-value-missing?
