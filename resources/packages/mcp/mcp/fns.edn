;; MCP server (ROADMAP Block 9.1, LAUNCH_PLAN stage 1.1) — graphden's
;; primitives over the Model Context Protocol, so any MCP client (Claude
;; Code / Desktop, Cursor) drives the graph on the USER'S OWN subscription.
;;
;; Pure graph composition: one auth-required POST /mcp endpoint, a JSON-RPC
;; 2.0 dispatch (:cond over the method string), and each tool is an ADAPTER
;; around an existing data fn-def / route handler — reads call
;; :list-all-graph-entities directly with named args; execute synthesizes a
;; Ring request for the existing :execute-handler. No new base-fns: the MCP
;; layer is exactly the kind of composition the graph exists to express.
;;
;; Per-user auth for free: /mcp is a `:post` (auth-required) route, so every
;; tool call rides the normal request scope — org-scoping + RLS, the effect
;; gate, grants, the tenant error envelope and the per-org rate limit all
;; apply to the AI exactly as to its human.
;;
;; Stateless streamable-HTTP shape: each POST carries one JSON-RPC message;
;; notifications get 202/no-body; unknown methods get -32601.
{:namespace "app.mcp"
 :description "MCP server — JSON-RPC endpoint + tools/resources over existing graph primitives."
 :fns
 [;; ==========================================================================
  ;; Base-fns (impls.clj). (`:parse-edn` moved to core/system — the
  ;; registry's import route needed it too and base-fn names are globally
  ;; unique; the bare refs below still resolve.)
  ;; ==========================================================================
  {:name :platform-owned-def-names
   :description "Names among `fn-defs` whose deterministic (namespace, name) fn-id was written by the package sync this boot — the fns the editor's package-guard protects. One in-memory registry lookup per def."
   :args {:fn-defs {:type [:union :null [:list :keyword-map]] :description "Parsed fn-def maps (fns.edn shape); nil treated as empty."}}
   :return-type [:list :text]}

  {:name :sync-fn-defs-branch!
   :description "Sync fn-defs into a NAMED branch + delta-invalidate that branch's registry. Atomic effect boundary (same carve-out as `:merge-branch!`). Returns the synced fn-ids as text."
   :args {:branch-id {:type :uuid :description "Target branch — the AI's `ai/…` branch, never the request's own."}
          :fn-defs {:type [:list :keyword-map] :description "Parsed fn-def maps, exactly the fns.edn shape."}}
   :return-type [:list :text]
   :effects #{:db}}

  ;; ==========================================================================
  ;; JSON-RPC envelope
  ;; ==========================================================================
  {:name :_mcp-body
   :description "Parsed JSON-RPC message of POST /mcp (keywordized): {:jsonrpc :id :method :params}."
   :parent :parse-json-body}

  {:name :_mcp-method
   :parent :get
   :args {:coll :_mcp-body :key {:value :method} :default {:value ""}}}

  {:name :_mcp-id
   :parent :get
   :args {:coll :_mcp-body :key {:value :id} :default nil}}

  {:name :_mcp-params
   :parent :get
   :args {:coll :_mcp-body :key {:value :params} :default {:value {}}}}

  {:name :_mcp-tool-name
   :description "tools/call → params.name (string)."
   :parent :get
   :args {:coll :_mcp-params :key {:value :name} :default {:value ""}}}

  {:name :_mcp-tool-args
   :description "tools/call → params.arguments (keywordized map)."
   :parent :get
   :args {:coll :_mcp-params :key {:value :arguments} :default {:value {}}}}

  ;; --- response builders --------------------------------------------------
  {:name :_mcp-result-envelope
   :description "JSON-RPC success envelope: {jsonrpc \"2.0\" :id <echo> :result <result>}. Free arg: :result."
   :parent :zipmap
   :args {:keys [{:value :jsonrpc} {:value :id} {:value :result}]
          :vals ["2.0" :_mcp-id {:as :result}]}}

  {:name :_mcp-ok
   :description "200 + JSON-RPC success envelope around :result (json-handler stringifies)."
   :parent :json-handler
   :args {:data :_mcp-result-envelope}}

  {:name :_mcp-error-body
   :description "JSON-RPC error object. Free args: :code (int), :message (text)."
   :parent :zipmap
   :args {:keys [{:value :code} {:value :message}]
          :vals [{:as :code} {:as :message}]}}

  {:name :_mcp-error-envelope
   :parent :zipmap
   :args {:keys [{:value :jsonrpc} {:value :id} {:value :error}]
          :vals ["2.0" :_mcp-id :_mcp-error-body]}}

  {:name :_mcp-err
   :description "200 + JSON-RPC error envelope (JSON-RPC errors ride HTTP 200). Free args: :code, :message."
   :parent :json-handler
   :args {:data :_mcp-error-envelope}}

  {:name :_mcp-method-not-found
   :parent :_mcp-err
   :args {:code {:value -32601} :message {:value "Method not found"}}}

  {:name :_mcp-tool-not-found
   :parent :_mcp-err
   :args {:code {:value -32602} :message {:value "Unknown tool"}}}

  {:name :_mcp-202
   :description "202 Accepted, empty body — the JSON-RPC notification reply (notifications carry no id and expect no result)."
   :parent :zipmap
   :args {:keys [{:value :status} {:value :body}]
          :vals [{:value 202} ""]}}

  ;; --- tool-result wrapper --------------------------------------------------
  {:name :_mcp-text-content-item
   :description "One MCP content item: {type \"text\" text <text>}. Free arg: :text."
   :parent :zipmap
   :args {:keys [{:value :type} {:value :text}]
          :vals ["text" {:as :text}]}}

  {:name :_mcp-tool-result
   :description "tools/call result: {content [{type text ...}] isError false}. Free arg: :text."
   :parent :zipmap
   :args {:keys [{:value :content} {:value :isError}]
          :vals [{:parent :list :args {:items [:_mcp-text-content-item]}}
                 {:value false}]}}

  {:name :_mcp-tool-ok
   :description "Full 200 JSON-RPC response wrapping one text content item. Free arg: :text."
   :parent :_mcp-ok
   :args {:result :_mcp-tool-result}}

  ;; ==========================================================================
  ;; initialize / initialized
  ;; ==========================================================================
  {:name :_mcp-initialize-result
   :parent :const
   :args {:value {:protocolVersion "2025-03-26"
                  :capabilities {:tools {:listChanged false}
                                 :resources {:listChanged false}}
                  :serverInfo {:name "graphden"
                               :title "Graphden — code as a graph"
                               :version "1.0.0"}
                  :instructions "Graphden stores programs as a GRAPH of fn-defs (composition, not text). Read the graphden://ai-context resource FIRST — it teaches the entity model and how to compose fn-defs. Work in a branch, never in main: mutations are reviewed by the human as graph-diffs."}}}

  {:name :_mcp-initialize
   :parent :_mcp-ok
   :args {:result :_mcp-initialize-result}}

  ;; ==========================================================================
  ;; tools/list — the catalog (Phase A: read + execute; mutations are Phase B)
  ;; ==========================================================================
  {:name :_mcp-tools-catalog
   :parent :const
   :args {:value
          {:tools
           [{:name "list-namespaces"
             :description "Overview of the graph: every namespace with its fn counts. Start here to orient."
             :inputSchema {:type "object" :properties {} :required []}}
            {:name "search-fns"
             :description "Search fns by name substring. Returns light rows (name, id, namespace, kind)."
             :inputSchema {:type "object"
                           :properties {:q {:type "string" :description "Name substring to search for."}}
                           :required ["q"]}}
            {:name "read-fn"
             :description "Read one fn-def and everything reachable from it (parents, slots, bindings, types, effects) — the full subgraph, JSON."
             :inputSchema {:type "object"
                           :properties {:name {:type "string" :description "Global fn name, without the leading colon."}}
                           :required ["name"]}}
            {:name "execute-fn"
             :description "Execute a fn by name with an args object. Returns {status result} inline, or {status pending execution-id} for slow/effectful runs."
             :inputSchema {:type "object"
                           :properties {:name {:type "string" :description "Global fn name."}
                                        :args {:type "object" :description "Arg-name -> value map (free args of the fn)."}}
                           :required ["name"]}}
            {:name "create-branch"
             :description "Create a branch to work in. ALWAYS do this before any mutation: main is the human's; your proposal lives on its own branch and is reviewed as a graph-diff."
             :inputSchema {:type "object"
                           :properties {:name {:type "string" :description "Branch name, e.g. ai/add-rate-limiter."}
                                        :base {:type "string" :description "Branch to fork from. Defaults to main."}}
                           :required ["name"]}}
            {:name "upsert-fn-defs"
             :description "Create or update fn-defs IN A BRANCH. `fn-defs` is EDN text: a vector of maps in fns.edn syntax, e.g. [{:name :my-fn :parent :add :args {:nums [1 2]}}]. EDN, not JSON — only there does a reference (:other-fn) stay distinguishable from a string. The same constraints as a human's fns.edn apply (cycles, name collisions, type-check), so a rejection is feedback you can act on. Platform fn-defs (the ones the package sync restores on every boot) are refused unless allow-platform-overwrite is true — prefer building under your own namespace."
             :inputSchema {:type "object"
                           :properties {:branch {:type "string" :description "Target branch name — never main."}
                                        :fn-defs {:type "string" :description "EDN vector of fn-def maps."}
                                        :allow-platform-overwrite {:type "boolean" :description "Explicitly allow shadowing platform (package-synced) fn-defs on the branch. Default false."}}
                           :required ["branch" "fn-defs"]}}
            {:name "run-tests"
             :description "Run the branch's tests (the `tests`-namespace fns) through the standard execute pipeline and get {total passed failed other results}. Run after upsert-fn-defs to close the write→verify loop."
             :inputSchema {:type "object"
                           :properties {:fn-ids {:type "array" :items {:type "string"} :description "Optional test fn-id strings — run only these; omit to run every test on the branch."}
                                        :timeout-ms {:type "integer" :description "Per-test timeout in ms. Defaults to 10000."}}
                           :required []}}
            {:name "list-branches"
             :description "Every branch with its base, timestamps and policy — orient after a context loss: which ai/* scratch branches already exist."
             :inputSchema {:type "object" :properties {} :required []}}
            {:name "diff-branch"
             :description "What your branch changed against another (default main). Change kinds: added-in-source / added-in-target / modified — deletion is a tombstone, so an entity deleted on your branch reports as added-in-target (present only there). This is what the human reviews."
             :inputSchema {:type "object"
                           :properties {:branch {:type "string" :description "Your branch."}
                                        :against {:type "string" :description "Branch to compare against. Defaults to main."}}
                           :required ["branch"]}}]}}}

  {:name :_mcp-tools-list
   :parent :_mcp-ok
   :args {:result :_mcp-tools-catalog}}

  ;; ==========================================================================
  ;; Tools — adapters over existing data fns / handlers
  ;; ==========================================================================
  ;; list-namespaces → the sidebar's ?scope=tree data, JSON-stringified.
  {:name :_mcp-tool-list-namespaces
   :parent :_mcp-tool-ok
   :args {:text {:parent :to-json-string
                 :args {:data {:parent :list-all-graph-entities
                               :args {:scope {:value :tree}
                                      :root-id nil
                                      :namespace-id nil
                                      :q nil}}}}}}

  ;; search-fns → ?scope=search&q=…
  {:name :_mcp-search-q
   :parent :get
   :args {:coll :_mcp-tool-args :key {:value :q} :default {:value ""}}}

  {:name :_mcp-tool-search-fns
   :parent :_mcp-tool-ok
   :args {:text {:parent :to-json-string
                 :args {:data {:parent :list-all-graph-entities
                               :args {:scope {:value :search}
                                      :root-id nil
                                      :namespace-id nil
                                      :q :_mcp-search-q}}}}}}

  ;; read-fn → resolve name → id (current branch), then ?scope=subtree.
  {:name :_mcp-read-fn-name
   :parent :get
   :args {:coll :_mcp-tool-args :key {:value :name} :default {:value ""}}}

  {:name :_mcp-read-fn-id
   :description "Target fn's id for read-fn — nil when the name doesn't resolve on this branch."
   :parent :fn-id-by-name
   :args {:fn-name :_mcp-read-fn-name}}

  {:name :_mcp-read-fn-missing
   :parent :_mcp-err
   :args {:code {:value -32602}
          :message {:parent :str
                    :args {:parts ["No fn named '" :_mcp-read-fn-name "' on this branch."]}}}}

  {:name :_mcp-tool-read-fn-found
   :parent :_mcp-tool-ok
   :args {:text {:parent :to-json-string
                 :args {:data {:parent :list-all-graph-entities
                               :args {:scope {:value :subtree}
                                      :root-id :_mcp-read-fn-id
                                      :namespace-id nil
                                      :q nil}}}}}}

  {:name :_mcp-tool-read-fn
   :parent :if
   :args {:test {:parent :nil? :args {:value :_mcp-read-fn-id}}
          :then :_mcp-read-fn-missing
          :else :_mcp-tool-read-fn-found}}

  ;; execute-fn → synthesize a Ring request for the EXISTING :execute-handler
  ;; (same admission path: caps, quotas, effect gate, persisted history).
  {:name :_mcp-exec-args
   :parent :get
   :args {:coll :_mcp-tool-args :key {:value :args} :default {:value {}}}}

  {:name :_mcp-exec-parsed
   :description "The execute pipeline's parsed-request shape, built from tool arguments instead of an HTTP body. Overriding :execute's :parsed slot (closer-fn-wins) skips its own body parse — re-entering the Ring handler with a synthesized request would collide with the OUTER :request free arg the MCP dispatch itself reads."
   :parent :zipmap
   ;; :trace? and :capture-values? are carried as false — the MCP tool
   ;; doesn't expose path tracing / value capture (debug P1+P3); the
   ;; parsed record must still satisfy the execute pipeline's shape.
   :args {:keys [{:value :fn-id} {:value :fn-name} {:value :args}
                 {:value :timeout-ms} {:value :persist?} {:value :trace?}
                 {:value :capture-values?}]
          :vals [{:parent :parse-uuid :args {:string nil}}
                 {:parent :to-str :args {:value :_mcp-read-fn-name}}
                 {:parent :coalesce :args {:value :_mcp-exec-args :default {}}}
                 {:value 10000} {:value false} {:value false} {:value false}]}}

  {:name :_mcp-exec-validation
   :description "The execute pipeline's stage-2 guard cond, fed my parsed map — :_execute-validation binds :parsed at itself (closer-fn-wins), so overriding :execute from outside can't reach it; this child rebinds it directly."
   :parent :_execute-validation
   :args {:parsed :_mcp-exec-parsed}}

  {:name :_mcp-exec-run
   :description "validate → apply, mirroring :execute's own :if — same guards, caps, quotas, effect gate and persisted history as POST /api/execute, minus the HTTP body parse (tool arguments feed :parsed)."
   :parent :if
   :args {:test {:parent :some? :args {:value :_mcp-exec-validation}}
          :then :_mcp-exec-validation
          ;; :fn-row must be re-bound HERE too: apply-bound's own :fn-row
          ;; ref resolves its free :parsed against apply-bound's binding set,
          ;; and a child's :parsed override does not retro-feed a ref bound
          ;; at the parent — without this the apply stage resolved fn-row
          ;; from the (absent) HTTP body and executed nothing.
          :else {:parent :_execute-apply-bound
                 :args {:parsed :_mcp-exec-parsed
                        :fn-row {:parent :_execute-fn-row
                                 :args {:parsed :_mcp-exec-parsed}}}}}}

  {:name :_mcp-tool-execute
   :description "execute-fn tool — the shared execute pipeline fed from tool arguments."
   :parent :_mcp-tool-ok
   :args {:text {:parent :to-json-string
                 :args {:data :_mcp-exec-run}}}}

  ;; ==========================================================================
  ;; Mutation tools (Phase B) — always branch-scoped: the AI proposes on its
  ;; own branch, the human reviews the graph-diff and merges. Same
  ;; parse → validate → apply shape as app/execution.
  ;; ==========================================================================

  ;; --- create-branch: reuse the /api/branches pipeline, fed from args ---------
  {:name :_mcp-branch-arg
   :description "tools/call → arguments.branch (the AI's working branch)."
   :parent :to-str
   :args {:value {:parent :get :args {:coll :_mcp-tool-args :key {:value :branch} :default {:value ""}}}}}

  {:name :_mcp-create-branch-parsed
   :description "The create-branch pipeline's parsed shape, from tool arguments instead of a JSON body. `:base` defaults to main. `:forbid-invalid?`, `:write-policy` and `:require-merge?` are carried as nil — the MCP tool exposes none of the policy flags (yet); the parsed record must still satisfy the pipeline's shape."
   :parent :zipmap
   :args {:keys [{:value :branch-name} {:value :base-ref} {:value :forbid-invalid?} {:value :write-policy} {:value :require-merge?}]
          :vals [{:parent :to-str
                  :args {:value {:parent :get :args {:coll :_mcp-tool-args :key {:value :name} :default {:value ""}}}}}
                 {:parent :to-str
                  :args {:value {:parent :get :args {:coll :_mcp-tool-args :key {:value :base} :default {:value "main"}}}}}
                 {:parent :const :args {:value nil}}
                 {:parent :const :args {:value nil}}
                 {:parent :const :args {:value nil}}]}}

  {:name :_mcp-tool-create-branch
   :description "create-branch tool — the SAME guards POST /api/branches runs (blank name, name taken, base missing), so a bad request reads as feedback the model can act on."
   :parent :_mcp-tool-ok
   :args {:text {:parent :to-json-string
                 :args {:data {:parent :_create-branch-data
                               :args {:parsed :_mcp-create-branch-parsed
                                      :resolved-parent {:parent :_create-branch-resolved-parent
                                                        :args {:parsed :_mcp-create-branch-parsed}}}}}}}}

  ;; --- diff-branch: reuse the /api/branches/:ref/diff pipeline ----------------
  {:name :_mcp-diff-parsed
   :parent :zipmap
   :args {:keys [{:value :target-ref} {:value :against-ref}]
          :vals [:_mcp-branch-arg
                 {:parent :to-str
                  :args {:value {:parent :get :args {:coll :_mcp-tool-args :key {:value :against} :default {:value "main"}}}}}]}}

  {:name :_mcp-tool-diff-branch
   :description "diff-branch tool — what the human will review, in the same shape the editor's Δ view renders."
   :parent :_mcp-tool-ok
   :args {:text {:parent :to-json-string
                 :args {:data {:parent :_diff-branches-data
                               :args {:parsed :_mcp-diff-parsed
                                      :target-branch {:parent :_target-branch
                                                      :args {:parsed :_mcp-diff-parsed}}
                                      :source-branch {:parent :_diff-source-branch
                                                      :args {:parsed :_mcp-diff-parsed}}}}}}}}

  ;; --- upsert-fn-defs: parse EDN → validate → sync into the branch ------------
  {:name :_mcp-upsert-edn
   :parent :to-str
   :args {:value {:parent :get :args {:coll :_mcp-tool-args :key {:value :fn-defs} :default {:value ""}}}}}

  {:name :_mcp-upsert-parsed
   :description "The EDN text the AI wrote, read into data. nil when it doesn't parse."
   :parent :parse-edn
   :args {:string :_mcp-upsert-edn}}

  {:name :_mcp-upsert-target-branch
   :description "The branch named in `:branch`; nil when it doesn't resolve — mutations NEVER fall back to the request's own branch."
   :parent :resolve-branch-ref
   :args {:ref :_mcp-branch-arg}}

  ;; Guards, one predicate each (the `:cond` below reads as the rule list).
  {:name :_mcp-upsert-not-a-vector?
   :parent :not
   :args {:value {:parent :is-a? :args {:value :_mcp-upsert-parsed :type {:value :vector}}}}}

  {:name :_mcp-upsert-item-is-named-map?
   :description "One fn-def is a map carrying a :name — anonymous defs can't be addressed by a later call."
   :parent :and
   :args {:values [{:parent :is-a? :args {:value {:as :item} :type {:value :map}}}
                   {:parent :some?
                    :args {:value {:parent :get :args {:coll {:as :item} :key {:value :name} :default nil}}}}]}}

  {:name :_mcp-upsert-items-malformed?
   :parent :not
   :args {:value {:parent :every?
                  :args {:pred :_mcp-upsert-item-is-named-map?
                         :coll :_mcp-upsert-parsed}}}}

  {:name :_mcp-upsert-branch-missing?
   :parent :nil?
   :args {:value :_mcp-upsert-target-branch}}

  {:name :_mcp-err-branch-missing
   :parent :_mcp-err
   :args {:code {:value -32602}
          :message {:parent :str
                    :args {:parts ["No branch named '" :_mcp-branch-arg
                                   "'. Call create-branch first — mutations never touch main."]}}}}

  {:name :_mcp-err-not-a-vector
   :parent :_mcp-err
   :args {:code {:value -32602}
          :message {:value "fn-defs must be readable EDN holding a VECTOR of fn-def maps, e.g. [{:name :my-fn :parent :add :args {:nums [1 2]}}]"}}}

  {:name :_mcp-err-items-malformed
   :parent :_mcp-err
   :args {:code {:value -32602}
          :message {:value "every fn-def must be a map with a :name"}}}

  ;; Platform-guard: the editor API refuses writes against package-synced
  ;; fns (crud.package-guard); this sync path must not stay the one write
  ;; route around that protection (the 2026-08-20 :add-poisoning class).
  {:name :_mcp-upsert-allow-platform?
   :parent :get
   :args {:coll :_mcp-tool-args :key {:value :allow-platform-overwrite} :default {:value false}}}

  {:name :_mcp-upsert-owned-names
   :description "Names in the parsed bundle that would land on package-synced fn-ids."
   :parent :platform-owned-def-names
   :args {:fn-defs :_mcp-upsert-parsed}}

  {:name :_mcp-upsert-platform-protected?
   :parent :and
   :args {:values [{:parent :not :args {:value :_mcp-upsert-allow-platform?}}
                   {:parent :not :args {:value {:parent :empty? :args {:coll :_mcp-upsert-owned-names}}}}]}}

  {:name :_mcp-err-platform-protected
   :parent :_mcp-err
   :args {:code {:value -32602}
          :message {:parent :str
                    :args {:parts ["These fn-defs are platform-owned (the package sync restores them on every boot): "
                                   {:parent :str-join
                                    :args {:coll :_mcp-upsert-owned-names :separator {:value ", "}}}
                                   ". Build under your own namespace instead, or pass allow-platform-overwrite=true to shadow them on the branch deliberately."]}}}}

  {:name :_mcp-upsert-applied
   :description "Sync into the resolved branch; returns the written fn-ids."
   :parent :sync-fn-defs-branch!
   :args {:branch-id {:parent :get :args {:coll :_mcp-upsert-target-branch :key {:value :id} :default nil}}
          :fn-defs :_mcp-upsert-parsed}}

  {:name :_mcp-upsert-result
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :branch} {:value :fn-ids}]
          :vals [{:value true} :_mcp-branch-arg :_mcp-upsert-applied]}}

  {:name :_mcp-tool-upsert-ok
   :parent :_mcp-tool-ok
   :args {:text {:parent :to-json-string :args {:data :_mcp-upsert-result}}}}

  {:name :_mcp-tool-upsert
   :description "upsert-fn-defs tool — guards first (branch resolves, EDN is a vector, every item is a named map, no platform fn-defs without the explicit flag), then the atomic branch-scoped sync. A rejection is a -32602 the model can read and fix."
   :parent :cond
   :args {:clauses [:_mcp-upsert-branch-missing?      :_mcp-err-branch-missing
                    :_mcp-upsert-not-a-vector?        :_mcp-err-not-a-vector
                    :_mcp-upsert-items-malformed?     :_mcp-err-items-malformed
                    :_mcp-upsert-platform-protected?  :_mcp-err-platform-protected
                    {:value true}                     :_mcp-tool-upsert-ok]}}

  ;; --- run-tests: the /api/tests/run apply stage, fed from tool arguments ----
  ;; `:request` stays free and unifies with the MCP dispatch's own request
  ;; (the same scope-pin the HTTP handler passes), so per-branch scoping via
  ;; X-Graphden-Branch works unchanged.
  {:name :_mcp-run-tests-fn-ids
   :parent :get
   :args {:coll :_mcp-tool-args :key {:value :fn-ids} :default {:value nil}}}

  {:name :_mcp-run-tests-timeout
   :parent :get
   :args {:coll :_mcp-tool-args :key {:value :timeout-ms} :default {:value nil}}}

  {:name :_mcp-tool-run-tests
   :description "run-tests tool — the SAME sequential runner POST /api/tests/run uses (effect gating, redaction, per-org caps, persistence), summarised as {total passed failed other results}."
   :parent :_mcp-tool-ok
   :args {:text {:parent :to-json-string
                 :args {:data {:parent :_tests-run-apply
                               :args {:fn-ids :_mcp-run-tests-fn-ids
                                      :timeout-ms :_mcp-run-tests-timeout}}}}}}

  ;; --- list-branches: the GET /api/branches data, JSON-stringified -----------
  {:name :_mcp-tool-list-branches
   :description "list-branches tool — the same {ok count branches} shape GET /api/branches serves."
   :parent :_mcp-tool-ok
   :args {:text {:parent :to-json-string
                 :args {:data :_list-branches-data}}}}

  ;; --- tools/call dispatch ---------------------------------------------------
  {:name :_mcp-tools-call
   :description "Dispatch tools/call on params.name."
   :parent :cond
   :args {:clauses [{:parent :equal? :args {:a :_mcp-tool-name :b {:value "list-namespaces"}}}
                    :_mcp-tool-list-namespaces
                    {:parent :equal? :args {:a :_mcp-tool-name :b {:value "search-fns"}}}
                    :_mcp-tool-search-fns
                    {:parent :equal? :args {:a :_mcp-tool-name :b {:value "read-fn"}}}
                    :_mcp-tool-read-fn
                    {:parent :equal? :args {:a :_mcp-tool-name :b {:value "execute-fn"}}}
                    :_mcp-tool-execute
                    {:parent :equal? :args {:a :_mcp-tool-name :b {:value "create-branch"}}}
                    :_mcp-tool-create-branch
                    {:parent :equal? :args {:a :_mcp-tool-name :b {:value "upsert-fn-defs"}}}
                    :_mcp-tool-upsert
                    {:parent :equal? :args {:a :_mcp-tool-name :b {:value "run-tests"}}}
                    :_mcp-tool-run-tests
                    {:parent :equal? :args {:a :_mcp-tool-name :b {:value "list-branches"}}}
                    :_mcp-tool-list-branches
                    {:parent :equal? :args {:a :_mcp-tool-name :b {:value "diff-branch"}}}
                    :_mcp-tool-diff-branch
                    {:value true}
                    :_mcp-tool-not-found]}}

  ;; ==========================================================================
  ;; resources — the AI-context document (Block 9.3 serves the real text;
  ;; Phase A ships the wiring + a seed document)
  ;; ==========================================================================
  {:name :_mcp-resources-catalog
   :parent :const
   :args {:value {:resources
                  [{:uri "graphden://ai-context"
                    :name "ai-context"
                    :title "How to write graphden fn-defs"
                    :description "The entity model (fn/slot/binding), composition patterns, naming rules, and how to mutate the graph through the MCP tools. Read before writing."
                    :mimeType "text/markdown"}]}}}

  {:name :_mcp-resources-list
   :parent :_mcp-ok
   :args {:result :_mcp-resources-catalog}}

  {:name :_mcp-ai-context-text
   :description "The AI-author guide (Block 9.3) — read from the classpath so the served resource IS docs/AI_CONTEXT.md, never a hand-kept copy of it (the .md at resources/packages/mcp/mcp/ai-context.md is that file, kept identical by mcp-ai-context-doc-in-sync-test). Static platform content, like the editor's CSS/JS assets, so the `:io` read rides the same unrestricted platform face."
   :parent :read-resource
   :return-type :text
   :args {:path "packages/mcp/mcp/ai-context.md"}}

  {:name :_mcp-resource-uri
   :parent :get
   :args {:coll :_mcp-params :key {:value :uri} :default {:value ""}}}

  {:name :_mcp-resource-contents
   :parent :zipmap
   :args {:keys [{:value :contents}]
          :vals [{:parent :list
                  :args {:items [{:parent :zipmap
                                  :args {:keys [{:value :uri} {:value :mimeType} {:value :text}]
                                         :vals ["graphden://ai-context"
                                                "text/markdown"
                                                :_mcp-ai-context-text]}}]}}]}}

  {:name :_mcp-resource-not-found
   :parent :_mcp-err
   :args {:code {:value -32002} :message {:value "Unknown resource uri"}}}

  {:name :_mcp-resources-read
   :parent :if
   :args {:test {:parent :equal? :args {:a :_mcp-resource-uri :b {:value "graphden://ai-context"}}}
          :then {:parent :_mcp-ok :args {:result :_mcp-resource-contents}}
          :else :_mcp-resource-not-found}}

  ;; ==========================================================================
  ;; Method dispatch + route
  ;; ==========================================================================
  {:name :_mcp-dispatch
   :lambda-params [:request :storage-query]
   :description "JSON-RPC method dispatch for POST /mcp."
   :parent :cond
   :args {:clauses [{:parent :equal? :args {:a :_mcp-method :b {:value "initialize"}}}
                    :_mcp-initialize
                    {:parent :equal? :args {:a :_mcp-method :b {:value "notifications/initialized"}}}
                    :_mcp-202
                    {:parent :equal? :args {:a :_mcp-method :b {:value "tools/list"}}}
                    :_mcp-tools-list
                    {:parent :equal? :args {:a :_mcp-method :b {:value "tools/call"}}}
                    :_mcp-tools-call
                    {:parent :equal? :args {:a :_mcp-method :b {:value "resources/list"}}}
                    :_mcp-resources-list
                    {:parent :equal? :args {:a :_mcp-method :b {:value "resources/read"}}}
                    :_mcp-resources-read
                    {:value true}
                    :_mcp-method-not-found]}}

  {:name :mcp-route
   :description "POST /mcp — the MCP endpoint (JSON-RPC 2.0, stateless streamable-HTTP). Auth-required: the bearer is the user's normal graphden token, so every AI tool call carries exactly that user's rights."
   :parent :post
   :args {:path "/mcp" :handler :_mcp-dispatch}}

  ;; Route-collection seam: this package's routes as a fall-through
  ;; `:router-or-nil`, installed into the JVM-wide route collection by the
  ;; `:mcp/router-install` init-key at boot (mirrors the tenancy addon's
  ;; `:tenancy-router`). `app` no longer references `:mcp-route`, so when
  ;; `"mcp"` is omitted from :package-names this router is simply never
  ;; built/installed and `/mcp` 404s while the rest of the app is unaffected.
  {:name :_mcp-routes
   :description "The mcp package's route list — the single `/mcp` endpoint."
   :parent :list
   :args {:items [:mcp-route]}}

  {:name :mcp-router
   :description "Fall-through reitit router over `:_mcp-routes` — returns nil on no-match (`:router-or-nil`) so the branch-router falls through to the main app router for any non-`/mcp` path."
   :parent :router-or-nil
   :args {:routes :_mcp-routes}}

  ;; Per-branch Ring handler — invokes `:mcp-router` on the parsed request,
  ;; binding `:storage-query :pg-query` (the `:_mcp-dispatch` free arg —
  ;; `:_mcp-dispatch` is `:lambda-params [:request :storage-query]`). Returns
  ;; nil on no-match for fall-through. The OPTIONAL analogue of
  ;; `app.server/_app-ring-response`: the branch-router builds a per-branch
  ;; closure for it (only when the mcp package is loaded) and consults it
  ;; BEFORE the main handler, so `/mcp` is served through the SAME per-branch,
  ;; request-threaded machinery as the main router. The boot-frozen route-
  ;; collection seam could NOT serve it — with no `:request`/`:storage-query`
  ;; bound at boot, `:_mcp-dispatch` baked to a constant method-not-found.
  {:name :_mcp-ring-response
   :description "Per-branch Ring handler for POST /mcp. Invokes `:mcp-router` on the request with `:storage-query :pg-query` bound; nil on no-match → fall-through to the main app handler. Free arg: `:request`."
   :parent :router-result
   :args {:func :mcp-router
          :storage-query :pg-query}}]}
