;; Splint configuration
;; https://github.com/NoahTheDuke/splint

{;; Enable all rules by default, with exceptions

 ;; Paths to lint. NOTE: `bb splint` passes explicit paths on the command
 ;; line (bb.edn `all-paths`), which override this key — it only matters
 ;; for a bare `splint` invocation. The stale "components"/"bases" entries
 ;; are polylith leftovers from before this repo became a classic monorepo.
 :paths ["src" "test" "development" "resources/packages"]

 ;; `dev` and the CRaC POC are single-file dev entry points loaded by hand
 ;; (`clojure -M:dev`, a POC main) — a second namespace segment would buy
 ;; nothing and break the invocation they exist for.
 naming/single-segment-namespace {:enabled false}

 ;; `development/bench` measures CALL OVERHEAD: `(fn [n] (- n))` standing in
 ;; for a bound base-fn impl is the subject of the benchmark, and rewriting
 ;; it to bare `-` would delete the very cost being measured. The rule is
 ;; genuinely useful everywhere else, so it is excluded by PATH, not off.
 lint/fn-wrapper {:excludes [#"development/bench/.*"]}

 ;; Output format
 :output "full"

 ;; Parallel processing
 :parallel true}
