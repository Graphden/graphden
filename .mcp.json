{
  "mcpServers": {
    "clojure": {
      "type": "stdio",
      "command": "clojure",
      "args": [
        "-Tmcp",
        "start"
      ],
      "env": {}
    },
    "postgres": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://graphden:graphden@localhost:5435/graphden"
      ],
      "env": {}
    }
  }
}
