   :parent :zipmap
   :return-type :_error-result-with-reason-shape
   :args {:keys [{:value :ok} {:value :reason} {:value :error}]
          :vals [{:value false}
                 {:value :not-found}
                 {:parent :str
                  :args {:parts ["Branch not found: "
                                 {:parent :get
                                  :args {:coll {:as :parsed}
                                         :key {:value :branch-ref}
                                         :default nil}}]}}]}}

  ;; --- :delete-branch! atomic primitive + graph try/catch ----------
  ;; The success path AND the 3 constraint-violation rejection shapes
  ;; live in graph (`_delete-branch-apply-*`). The dispatch on
  ;; `(:type (ex-data e))` uses the `:ex-data` primitive in
  ;; `core.system`.
  {:name :delete-branch!
   :description "Atomic library boundary over `vs/delete-branch!` — removes branch by id. Throws ex-info with `:type :constraint-violation/{root-branch-undeletable, branch-has-children}` (latter carries `:child-branch-ids`) or `:not-found`."
   :args {:branch-id {:type :uuid :description "Branch id to remove."}}
   :return-type :any
   :effects #{:db}}

