;; Page templates — collapse the boilerplate around serving a
;; full HTML page as a Ring route. Three layers, each usable
;; on its own:
;;
;;   :html-page-rendered — :render-hiccup ∘ :html-page
;;     (returns text — the HTML string)
;;   :html-page-handler  — :html-ok-response of :html-page-rendered
;;     (returns a Ring response)
;;   :html-page-route    — :get-route of :html-page-handler
;;     (returns a full reitit-shaped route entry)
;;
;; Use `:html-page-route` for the common case (one GET route =
;; one page). Drop down to `:html-page-handler` when you need
;; to mix GET + POST on the same path via the method-map merge
;; pattern (e.g. the contact-form demo). Drop down further to
;; `:html-page-rendered` if you want the raw text body for
;; non-Ring sinks (file write, email body, etc).
;;
;; All three expose the same four free args:
;;   :title     — document <title> text
;;   :body      — hiccup tree for <body>
;;   :head      — extra <head> hiccup nodes (typically
;;                `:graphden-page-head` for the default stylesheet)
;;   :scripts   — end-of-body <script> hiccup nodes (typically
;;                `:graphden-runtime-scripts` for the dispatcher
;;                bundle that wires `data-action` clicks)
;;
;; Both `:head` and `:scripts` accept `{:value []}` if a page
;; doesn't need them.


{:namespace "app.page"
 :description "HTML-page route templates — :html-page-rendered / :html-page-handler / :html-page-route, each collapsing one more layer of the :html-page → :render-hiccup → :html-ok-response → :get-route chain."
 :fns
 [{:name :html-page-rendered
   :description "Render a full HTML page (`:html-page`) to a string via `:render-hiccup`. Free args: `:title`, `:body`, `:head`, `:scripts`."
   :parent :render-hiccup
   :return-type :text
   :args {:hiccup {:parent :html-page
                   :args {:title {:as :title :type :text
                                  :description "Document `<title>` text."}
                          :body {:as :body :type :hiccup-node
                                 :description "Page body hiccup tree."}
                          :head {:as :head :type [:list :hiccup-node]
                                 :description "Extra `<head>` hiccup nodes — typically `:graphden-page-head` for the default stylesheet, or `{:value []}` for none."}
                          :scripts {:as :scripts :type [:list :hiccup-node]
                                    :description "End-of-body `<script>` hiccup nodes — typically `:graphden-runtime-scripts` for the standard dispatcher bundle, or `{:value []}` for none."}}}}}

  {:name :html-page-handler
   :lambda-params []
   :description "Ring handler returning a full HTML page — `:html-ok-response` wrapping `:html-page-rendered`. Free args: `:title`, `:body`, `:head`, `:scripts`. Use as the `:handler` of a `:get-route`, or as the GET-side `:handler` of a method-map merge."
   :parent :html-ok-response
   :args {:body :html-page-rendered}}

  {:name :html-page-route
   :description "GET-route template for a full HTML page. Collapses `:html-page` + `:render-hiccup` + `:html-ok-response` + `:get-route` into one entry. Free args: `:path` (URL), `:title`, `:body`, `:head`, `:scripts`. For GET + POST on the same path, use `:html-page-handler` on the GET side of a method-map merge."
   :parent :get-route
   :args {:path {:as :path :type :text
                 :description "URL path the route is mounted at (e.g. `\"/about\"`)."}
          :handler :html-page-handler}}

  ;; Stylesheet twins — serve a graph-authored CSS body as text/css.
  ;; The CSS lives in the graph (a `:custom-stylesheet` const or a
  ;; literal), so an edit shows on the next reload (`:css-ok-response`
  ;; sets no cache directives). Pages reference it with a plain
  ;; `<link>` in `:head`.
  {:name :stylesheet-handler
   :lambda-params []
   :description "Ring handler serving a CSS stylesheet — `:css-ok-response` over the `:css` free arg. Use as the `:handler` of a route, or take `:stylesheet-route` for the one-liner."
   :parent :css-ok-response
   :args {:body {:as :css :type :css-source
                 :description "The stylesheet body — typically a `:custom-stylesheet` ref."}}}

  ;; --- fragments — the tenant-side analogue of the editor's
  ;; /partials/* (docs/PARTIALS.md): a route that returns a rendered
  ;; hiccup FRAGMENT (no page shell) as text/html, for htmx swaps.
  ;; The handler exposes `:request` as a free arg so a fragment
  ;; composition can read query params (`:query-param`) or a POSTed
  ;; form body (`:parse-form-body`).

  {:name :html-fragment-rendered
   :description "Render a hiccup FRAGMENT (no page shell) to an HTML string. Free arg: `:fragment`."
   :parent :render-hiccup
   :return-type :text
   :args {:hiccup {:as :fragment :type :hiccup-node
                   :description "The fragment's hiccup tree."}}}

  ;; A fragment that READS the request (query params via
  ;; `:query-param`, a POSTed form via `:parse-form-body`) declares
  ;; its own handler child so the ring request reaches the `:request`
  ;; free arg its composition introduces:
  ;;
  ;;   {:name :my-frag-handler
  ;;    :lambda-params [:request]
  ;;    :parent :html-fragment-handler
  ;;    :args {:fragment :my-frag}}
  ;;   {:name :my-frag-route
  ;;    :parent :post-route
  ;;    :args {:path "/fragments/vote" :handler :my-frag-handler}}
  ;;
  ;; (Same pattern as the contact-demo POST handler; the template
  ;; itself can't declare `[:request]` — lambda-params must name a
  ;; real free arg, and a static fragment has none.)
  {:name :html-fragment-handler
   :lambda-params []
   :description "Ring handler returning a rendered hiccup fragment as text/html — the server side of an `hx-get` / `hx-post` swap. Free arg: `:fragment` (the hiccup). A request-reading fragment declares a handler CHILD with `:lambda-params [:request]` — see the comment above this fn-def."
   :parent :html-ok-response
   :args {:body :html-fragment-rendered}}

  {:name :fragment-route
   :description "GET-route template serving a hiccup fragment as text/html — pair with `:hx-get-attrs` (web.htmx) on the requesting element. Free args: `:path`, `:fragment`. A request-reading fragment takes its own `:html-fragment-handler` child instead (see there)."
   :parent :get-route
   :args {:path {:as :path :type :text
                 :description "URL path the fragment is mounted at (e.g. `\"/fragments/stats\"`)."}
          :handler :html-fragment-handler}}

  {:name :fragment-post-route
   :description "POST-route template serving a hiccup fragment as text/html — the target of an `:hx-post-attrs` form/button. Free args: `:path`, `:fragment`. To read the submitted fields, take a `:html-fragment-handler` child with `:lambda-params [:request]` + `:parse-form-body` (see there)."
   :parent :post-route
   :args {:path {:as :path :type :text
                 :description "URL path the fragment is mounted at."}
          :handler :html-fragment-handler}}

  ;; --- with-htmx — PHILOSOPHY's long-named head helper, now real:
  ;; append the locally-served htmx bundle to a page's :head list.
  {:name :with-htmx
   :description "Append the local htmx `<script>` (`/assets/htmx.min.js`, vendored — no CDN) to a page's `:head` list. Bind a page's `:head` to this when any element carries `hx-*` attrs (see web.htmx). Free arg: `:head` (the list to extend — e.g. `:graphden-page-head`)."
   :parent :with-cdn-script
   :args {:url :_htmx-js-url}}

  {:name :stylesheet-route
   :description "GET-route template serving a graph-authored stylesheet as `text/css`. Free args: `:path` (e.g. `\"/styles.css\"`), `:css` (the stylesheet body). Reference it from a page with `[:link {:rel \"stylesheet\" :href <path>}]` in `:head`."
   :parent :get-route
   :args {:path {:as :path :type :text
                 :description "URL path the stylesheet is mounted at (e.g. `\"/styles.css\"`)."}
          :handler :stylesheet-handler}}]}
