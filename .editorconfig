; EditorConfig — repo-wide indent / line-ending / trim-trailing
; conventions. Honoured by every mainstream editor / IDE that ships
; the EditorConfig plugin (VS Code, IntelliJ, Emacs, Vim — all
; built-in or one-extension-install).
;
; Pairs with the linters: cljstyle / biome / stylelint enforce
; deeper rules, this just keeps newcomers from showing up with
; CRLF endings or 8-space tabs on day one.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.clj]
; Matches cljstyle defaults.
indent_size = 2

[*.edn]
indent_size = 2

[*.{js,css,html,json}]
; biome / stylelint enforce 2-space.
indent_size = 2

[*.md]
; Markdown is whitespace-sensitive — leave trailing spaces alone (some
; editors use trailing-double-space as a line-break marker).
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2
