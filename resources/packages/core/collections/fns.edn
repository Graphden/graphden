;; Collection manipulation base functions
;; first, rest, cons, conj, get, assoc, dissoc, count, empty?,
;; contains?, keys, vals, merge, into, range, repeat, take, drop,
;; reverse, sort, concat, flatten, distinct


{:namespace "core.collections"
 :fns
[{:name :first
  :args {:coll :jsonb}
  :return-type :any}

 {:name :rest
  :args {:coll :jsonb}
  :return-type :jsonb}

 {:name :cons
  :args {:item :any, :coll :jsonb}
  :return-type :jsonb}

 {:name :conj
  :args {:coll :jsonb, :item :any}
  :return-type :jsonb}

 {:name :conj-any
  :args {:coll :any, :item :any}
  :return-type :any}

 {:name :get
  :args {:coll :jsonb, :key :any, :default :any}
  :return-type :any}

 {:name :get-in
  :args {:map :jsonb
         :path :jsonb
         :default {:type :any :required false}}
  :return-type :any}

 {:name :assoc
  :args {:map :jsonb, :key :any, :value :any}
  :return-type :jsonb}

 {:name :assoc-any
  :args {:map :any, :key :any, :value :any}
  :return-type :any}

 {:name :dissoc
  :args {:map :jsonb, :key :any}
  :return-type :jsonb}

 {:name :count
  :args {:coll :jsonb}
  :return-type :int}

 {:name :empty?
  :args {:coll :jsonb}
  :return-type :bool}

 {:name :contains?
  :args {:coll :jsonb, :key :any}
  :return-type :bool}

 {:name :keys
  :args {:map :jsonb}
  :return-type :jsonb}

 {:name :vals
  :args {:map :jsonb}
  :return-type :jsonb}

 {:name :merge
  :args {:maps :jsonb}
  :return-type :jsonb}

 {:name :into
  :args {:to :jsonb, :from :jsonb}
  :return-type :jsonb}

 {:name :range
  :args {:start {:type :int :required false}
         :end :int
         :step {:type :int :required false}}
  :return-type :jsonb}

 {:name :repeat
  :args {:count :int, :item :any}
  :return-type :jsonb}

 {:name :take
  :args {:count :int, :coll :jsonb}
  :return-type :jsonb}

 {:name :drop
  :args {:count :int, :coll :jsonb}
  :return-type :jsonb}

 {:name :reverse
  :args {:coll :jsonb}
  :return-type :jsonb}

 {:name :sort
  :args {:coll :jsonb}
  :return-type :jsonb}

 {:name :concat
  :args {:colls :jsonb}
  :return-type :jsonb}

 {:name :flatten
  :args {:coll :jsonb}
  :return-type :jsonb}

 {:name :distinct
  :args {:coll :jsonb}
  :return-type :jsonb}

 {:name :stringify-map-keys
  :args {:m :jsonb}
  :return-type :jsonb}]}
