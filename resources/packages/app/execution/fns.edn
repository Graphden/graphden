   :parent :cond
   :args {:clauses [:_execute-no-fn-rej?            :_execute-no-fn-err
                    :_execute-fn-not-found-rej?     :_execute-fn-not-found-err
                    :_execute-timeout-bad-rej?      :_execute-timeout-bad-err
                    :_execute-args-too-large-rej?   :_execute-args-too-large-err
                    :_execute-running-as-svc-rej?   :_execute-running-as-svc-err
                    :_execute-unknown-arg-rej?      :_execute-unknown-arg-err
                    :_execute-malformed-ref-rej?    :_execute-malformed-ref-err
                    {:value true}                   {:value nil}]
          :parsed :_execute-parsed}}

  {:name :_execute-apply
   :description "Stage 3 — submit future, deref with timeout. Returns inline `{:status :succeeded :result …}` for fast pure fns, or `{:status :pending :execution-id}` when timeout/effects/persist? forced async."
   :args {:parsed {:type :_execute-parsed-shape}}
   :return-type :keyword-map
   :effects #{:db}}

  {:name :_execute-rejected?
   :description "True when `:_execute-validation` produced a rejection."
   :parent :some?
   :args {:value {:as :validation}}}

  ;; ---------------------------------------------------------------------
  ;; Composed: parse → (if rejected then rejection else apply)
  ;; ---------------------------------------------------------------------

  {:name :execute
   :description "POST /api/execute pipeline. Parse → validate → on success apply."
   :parent :if
   :args {:test :_execute-rejected?
          :then :_execute-validation
          :else :_execute-apply
          :validation :_execute-validation
          :parsed :_execute-parsed}}

  {:name :execute-handler
   :description "Ring handler for POST /api/execute — wraps `:execute` in a JSON 200 response."
   :parent :json-handler
   :args {:data :execute}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/execute/:id — read a persisted row
  ;; ---------------------------------------------------------------------

  ;; --- C18 atoms: get-execution + cancel-execution variant-2.
  ;; Shared parse (`_exec-id-parsed`) + shared 404 builder
  ;; (`_exec-err-not-found`).
  {:name :_exec-id-from-path-params
   :description "Try the reitit-enriched `:path-params {:id …}` field first — the canonical place when the request flows through reitit's enrich-request middleware."
   :parent :get-in
   :args {:map {:as :request}
          :path [{:value :path-params} {:value :id}]
          :default nil}}

  {:name :_exec-id-from-uri
   :description "Fallback: parse the id directly from the URL when the handler is invoked with a raw http-kit request (e.g. through `:branch-routing-wrap`) that hasn't gone through reitit's enrich-request — `:path-params` is nil there."
   :parent :uri-segment-after
   :args {:marker {:value "execute"}}}

  {:name :_exec-id-raw
   :description "Raw id string from the URL — `:path-params` when present, else the URI segment after `execute/`."
   :parent :coalesce
   :args {:value :_exec-id-from-path-params
          :default :_exec-id-from-uri}}

  {:name :_exec-id-parsed
   :description "Parse the `:id` path segment for both `/api/execute/:id` and `/api/execute/:id/cancel` into `{:id <uuid|nil> :id-raw <raw>}`. Raw form preserved for the dynamic 404 message."
   :parent :zipmap
   :args {:keys [{:value :id} {:value :id-raw}]
          :vals [{:parent :parse-uuid :args {:string :_exec-id-raw}}
                 :_exec-id-raw]}}

  {:name :_exec-err-not-found
   :description "Dynamic 404 builder — cites the raw id-segment. Shared between get + cancel. `:return-type` pinned so downstream `:cond` unions of error + success retain precise record shapes (otherwise bare `:zipmap` infers `[:map :any [:union :bool :text]]` and the per-member narrowing in `get-return-rule` opaques out)."
   :parent :zipmap
   :return-type :_error-result-shape
   :args {:keys [:ok :error]
          :vals [false
                 {:parent :str
                  :args {:parts ["Execution not found: "
                                 {:parent :get
                                  :args {:coll {:as :parsed}
                                         :key {:value :id-raw}
                                         :default nil}}]}}]}}

  ;; --- :get-execution / :cancel-execution! — atomic DB primitives.
  {:name :get-execution
   :description "Read a :fn-execution row by id (joined with arg + arg-item rows). nil when id is nil or doesn't resolve."
   :args {:id {:type :nullable-uuid :description "Target execution id."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  ;; `:render-execute-result-hiccup` retired — entire result body now
  ;; graph-composed in the `:_er-*` chain below (`:_er-body` is the
  ;; entry; `:_partial-execute-result-fragment` /
  ;; `:_partial-execute-result-inline-fragment` in `app/editor/fns.edn`
  ;; both delegate here). §3.3 fix.

  ;; `:render-service-popover-hiccup` retired — entire popover body now
  ;; graph-composed in the `:_sp-*` chain below (`:_partial-service-
  ;; popover-body` is the entry). §3.3 fix.

  {:name :cancel-execution!
   :description "Soft-cancel an in-flight execution by id. nil when id is nil or doesn't resolve. Side effects: `:db` (sets `:cancel-requested?` on the persisted row) + `:process` (interrupts the in-process future via `future-cancel`)."
   :args {:id {:type :nullable-uuid :description "Target execution id."}}
   :return-type :nullable-keyword-map
   :effects #{:db :process}}

  {:name :_get-exec-loaded
   :description "Load the persisted execution row by id; nil when not found. Reuses the `:get-execution` primitive."
   :parent :get-execution
   :return-type [:union :null :fn-execution-row-shape]
   :args {:id {:parent :get :args {:coll {:as :parsed} :key {:value :id} :default nil}}}}

  {:name :_get-exec-missing?
   :description "Guard — load returned nil."
   :parent :nil?
   :args {:value {:as :loaded}}}

  {:name :_get-exec-apply
   :description "Success branch — return the loaded row verbatim. `:const` over the captured `:loaded` cond shared-arg."
   :parent :const
   :args {:value {:as :loaded}}}

  {:name :_get-execution
   :description "GET /api/execute/:id — flat `:cond` of `[exec-missing? → 404-dynamic, true → return-loaded]`. `parsed` + `loaded` are shared sub-results bound once at the `:cond` fn-def."
   :parent :cond
   :args {:clauses [:_get-exec-missing? :_exec-err-not-found
                    {:value true}        :_get-exec-apply]
          :parsed :_exec-id-parsed
          :loaded :_get-exec-loaded}}

  {:name :get-execution-handler
   :description "Ring handler for GET /api/execute/:id."
   :parent :json-handler
   :args {:data :_get-execution}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/execute/:id/cancel — soft cancel an in-flight execution
  ;; ---------------------------------------------------------------------

  {:name :_cancel-exec-applied
   :description "Call `:cancel-execution!` — no-op (returns nil) when id is invalid OR no row matches. Otherwise sets `:cancel-requested?` on the row + `future-cancel`s the in-process handle."
   :parent :cancel-execution!
   :return-type [:union :null :fn-execution-row-shape]
   :args {:id {:parent :get :args {:coll {:as :parsed} :key {:value :id} :default nil}}}}

  {:name :_cancel-exec-missing?
   :description "Guard — cancel returned nil (bad id OR no row)."
   :parent :nil?
   :args {:value {:as :applied}}}

  {:name :_cancel-exec-apply
   :description "Success branch — return the cancel-result-map verbatim. `:const` over the captured `:applied` cond shared-arg."
   :parent :const
   :args {:value {:as :applied}}}

  {:name :_cancel-execution
   :description "POST /api/execute/:id/cancel — flat `:cond` of `[cancel-missing? → 404-dynamic, true → return-applied]`. Reuses C18's `_exec-id-parsed` parser + `_exec-err-not-found` builder."
   :parent :cond
   :args {:clauses [:_cancel-exec-missing? :_exec-err-not-found
                    {:value true}           :_cancel-exec-apply]
          :parsed :_exec-id-parsed
          :applied :_cancel-exec-applied}}

  {:name :cancel-execution-handler
   :description "Ring handler for POST /api/execute/:id/cancel."
   :parent :json-handler
   :args {:data :_cancel-execution}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/executions?fn-id=X — list recent runs for one fn
  ;; ---------------------------------------------------------------------

  ;; --- C6 atoms: parse / no-anchor? / by-version? / two apply paths.
  ;; --- :_list-exec-parsed (Variant-2). Was defbase delegating to
  ;; `parse-list-executions-request`. Now graph composition:
  ;;   - `:query-param` (new web/crud primitive) for each of the 3
  ;;     query params,
  ;;   - `:parse-uuid` for `:fn-id` and `:version-id` (returns nil on
  ;;     blank / non-string / malformed — matches the legacy
  ;;     `parse-uuid-or-clear` semantics),
  ;;   - `:try`-wrapped `:parse-int` for `:limit` so a non-numeric
  ;;     `?limit=abc` collapses to nil instead of 500-ing.

  {:name :_list-exec-fn-id-raw
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "fn-id"}}}

  {:name :_list-exec-version-id-raw
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "fn-version-id"}}}

  {:name :_list-exec-limit-raw
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "limit"}}}

  {:name :_list-exec-limit-parsed-body
   :description "`:try` body — :parse-int throws NumberFormatException on non-numeric input. The wrapping `:try` collapses that to nil. Phase #170 control-flow narrowing recognises the parent `:_list-exec-limit`'s `:if :test (:some? :_list-exec-limit-raw)` guard and narrows `:_list-exec-limit-raw` to non-null inside the `:then` ref-tree."
   :parent :parse-int
   :args {:s :_list-exec-limit-raw}}

  {:name :_list-exec-limit
   :description "Parsed `?limit` integer; nil when absent / non-numeric."
   :parent :if
   :args {:test {:parent :some? :args {:value :_list-exec-limit-raw}}
          :then {:parent :try
                 :args {:body :_list-exec-limit-parsed-body
                        ;; `:on-throw` is a `[:fn :any]` callable invoked WITH
                        ;; the caught exception. A literal `{:value nil}` would
                        ;; type-fail against the slot's callable shape; wrap in
                        ;; `:const` so the binding is a (fn [_] nil) shape.
                        :on-throw {:parent :const :args {:value nil}}}}
          :else nil}}

  {:name :_list-exec-parsed
   :description "Parse `GET /api/executions` query-string into `{:fn-id :version-id :limit}`."
   :parent :zipmap
   :args {:keys [{:value :fn-id} {:value :version-id} {:value :limit}]
          :vals [{:parent :parse-uuid :args {:string :_list-exec-fn-id-raw}}
                 {:parent :parse-uuid :args {:string :_list-exec-version-id-raw}}
                 :_list-exec-limit]}}

  {:name :_list-exec-no-anchor?
   :description "Guard — neither `?fn-id` nor `?fn-version-id` was supplied. `:and [nil? (get parsed :version-id)] [nil? (get parsed :fn-id)]`."
   :parent :and
   :args {:values [{:parent :nil? :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :version-id} :default nil}}}}
                   {:parent :nil? :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :fn-id} :default nil}}}}]}}

  {:name :_list-exec-by-version?
   :description "Dispatch — `?fn-version-id` supplied. Wins over `?fn-id` when both are present."
   :parent :some?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :version-id} :default nil}}}}

  ;; Phase 4 follow-up — list-executions-by-version decomposition.
  ;; `:fn-execution` is non-versioned (write-once log), so the SQL
  ;; goes through `:pg-query` directly with `WHERE fn-version-id = ?`
  ;; + `ORDER BY started-at DESC` + `LIMIT <clamped>`. Per-row
  ;; `:decode-row` for snake_case → kebab-case + timestamp parsing.
  ;; Limit clamp is a `:cond` graph over the same nil/non-number/
  ;; lt-1/gt-max ladder the Clojure helper used.
  {:name :_list-exec-apply-by-version
   :description "Return executions for the specific `:fn-version-id`."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :executions}]
          :vals [{:value true} :_list-exec-by-version-rows]}}

  {:name :_list-exec-by-version-rows
   :description "Latest-first slice of the executions for this version, capped at the clamped limit."
   :parent :take
   :args {:count {:ref :_list-exec-clamped-limit :type :non-negative-int}
          :coll :_list-exec-by-version-rows-desc}}

  {:name :_list-exec-by-version-rows-desc
   :parent :reverse
   :args {:coll :_list-exec-by-version-rows-asc}}

  {:name :_list-exec-by-version-rows-asc
   :parent :sort-by
   :args {:key-fn :_list-exec-started-at-key
          :coll :_list-exec-by-version-decoded}}

  {:name :_list-exec-started-at-key
   :parent :get :args {:coll {:as :item} :key {:value :started-at} :default nil}}

  {:name :_list-exec-by-version-decoded
   :parent :map
   :args {:func :_list-exec-decode-row :coll :_list-exec-by-version-raw}}

  {:name :_list-exec-decode-row
   :parent :decode-row
   :return-type :fn-execution-row-shape
   :args {:row {:as :item} :entity-type {:value "fn-execution"}}}

  {:name :_list-exec-by-version-raw
   :parent :storage-query-call
   :args {:arg :_list-exec-by-version-hsql}}

  {:name :_list-exec-by-version-hsql
   :parent :assoc
   :args {:map {:value {:select [:*] :from :fn-execution}}
          :key {:value :where}
          :value :_list-exec-by-version-hsql-where}}

  {:name :_list-exec-by-version-hsql-where
   :parent :vec
   :args {:coll [{:value :=} {:value :fn-version-id} :_list-exec-version-id]}}

  {:name :_list-exec-version-id
   :parent :get :args {:coll {:as :parsed} :key {:value :version-id} :default nil}}

  ;; Limit clamp. The Clojure version: nil/not-number/<1 → 20,
  ;; > 100 → 100, else (long limit). Express as flat `:cond` over
  ;; the parsed `:limit` field.
  {:name :_list-exec-limit-parsed
   :parent :get :args {:coll {:as :parsed} :key {:value :limit} :default nil}}

  {:name :_list-exec-clamped-limit
   :parent :cond
   :args {:clauses [:_list-exec-limit-invalid?  {:value 20}
                    :_list-exec-limit-over-max? {:value 100}
                    {:value true}                :_list-exec-limit-parsed]}}

  {:name :_list-exec-limit-invalid?
   :parent :or
   :args {:values [{:parent :nil? :args {:value :_list-exec-limit-parsed}}
                   :_list-exec-limit-less-than-1?]}}

  ;; `:_list-exec-limit-parsed` declares `:nullable-int` —
  ;; non-null asserted here because the sole consumer
  ;; `:_list-exec-limit-invalid?` short-circuits on `:or` after the
  ;; preceding `(:nil? :_list-exec-limit-parsed)` clause, so this
  ;; branch only evaluates when the parsed limit IS an int.
  {:name :_list-exec-limit-less-than-1?
   :parent :gt
   :args {:nums [{:value 1} {:ref :_list-exec-limit-parsed :type :int}]}}

  {:name :_list-exec-limit-over-max?
   :parent :gt
   :args {:nums [{:ref :_list-exec-limit-parsed :type :int} {:value 100}]}}

  ;; `:_list-exec-apply-by-fn` — same shape as `-by-version`, but the
  ;; version-id is RESOLVED from the logical fn-id via
  ;; `:resolve-fn-version-id` (a thin §3.1 wrap around `fn-execution.
  ;; lookup/resolve-fn-version-id`). The reuses-the-version-path :if
  ;; emits `{:ok true :executions []}` when the fn has no version
  ;; visible on the active branch (e.g. inherited-only, never written).
  {:name :resolve-fn-version-id
   :description "Resolve a logical fn-id to its current-branch version-id. nil when the fn has no version visible on the active branch."
   :args {:fn-id {:type :uuid}}
   :return-type :nullable-uuid
   :effects #{:db}}

  {:name :_list-exec-apply-by-fn
   :description "Return executions for the logical `:fn-id` (current branch's resolved version)."
   :parent :if
   :args {:test :_list-exec-by-fn-version-found?
          :then :_list-exec-apply-by-fn-with-version
          :else :_list-exec-apply-by-fn-empty
          :version-id :_list-exec-by-fn-version-id
          ;; Carry the OUTER :parsed's :limit out under a fresh
          ;; name so the synth below doesn't have to re-read the
          ;; OUTER :parsed (which the by-version chain rewrites to
          ;; `:_list-exec-by-fn-synth-parsed` — a self-reference
          ;; that loops the executor at runtime).
          :outer-limit {:parent :get
                        :args {:coll {:as :parsed}
                               :key {:value :limit}
                               :default nil}}}}

  {:name :_list-exec-by-fn-version-id
   :parent :resolve-fn-version-id
   :args {:fn-id {:parent :get :type :uuid
                  :args {:coll {:as :parsed} :key {:value :fn-id} :default nil}}}}

  {:name :_list-exec-by-fn-version-found?
   :parent :some? :args {:value {:as :version-id}}}

  ;; When a version IS resolvable, reuse the by-version path's query
  ;; via a small parsed-shape adapter — synthesize a `{:version-id <resolved>}`
  ;; that the version-path's `:_list-exec-version-id` reader picks up.
  {:name :_list-exec-apply-by-fn-with-version
   :parent :_list-exec-apply-by-version
   :args {:parsed :_list-exec-by-fn-synth-parsed}}

  {:name :_list-exec-by-fn-synth-parsed
   :description "Carry the resolved version-id + the OUTER limit into the by-version graph composition. The limit comes via `:outer-limit` from `:_list-exec-apply-by-fn` (NOT a re-read of `:as :parsed`) — at this level `:parsed` is BEING REDEFINED to point at this same fn, so re-reading it would loop. The structural shape mirrors `:_list-exec-by-version`'s declared `:parsed` (fn-id + version-id + limit) so the by-version's typed downstream chain doesn't fail open-record subtype against the missing `:fn-id`."
   :parent :assoc
   :args {:map {:parent :zipmap
                :args {:keys [{:value :limit} {:value :fn-id}]
                       :vals [{:as :outer-limit :type :nullable-int}
                              {:as :fn-id :type :nullable-uuid}]}}
          :key {:value :version-id}
          :value {:as :version-id}}}

  {:name :_list-exec-apply-by-fn-empty
   :description "Fn has no version visible on the current branch → empty execution list."
   :parent :const
   :args {:value {:ok true :executions []}}}

  {:name :_list-exec-err-no-anchor
   :parent :const
   :return-type :_error-result-shape
   :args {:value {:ok false :error "missing or invalid ?fn-id / ?fn-version-id query parameter"}}}

  {:name :_list-executions-by-fn
   :description "GET /api/executions — flat `:cond` of `[no-anchor? → err, by-version? → version-apply, true → fn-apply]`. `:cond` is lazy, so each apply runs only on its branch. `parsed` is bound once at the `:cond` fn-def."
   :parent :cond
   :args {:clauses [:_list-exec-no-anchor? :_list-exec-err-no-anchor
                    :_list-exec-by-version? :_list-exec-apply-by-version
                    {:value true}            :_list-exec-apply-by-fn]
          :parsed :_list-exec-parsed}}

  {:name :list-executions-handler
   :description "Ring handler for GET /api/executions."
   :parent :json-handler
   :args {:data :_list-executions-by-fn}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/services/reconcile — Phase 1 hot-reload trigger
  ;; ---------------------------------------------------------------------

  {:name :_reconcile-services-apply
   :description "Stage 1 — single recon-library call producing the reconcile summary (`{:started [ids] :stopped [ids]}`). Wrapped into `{:ok true :reconcile …}` by the fn-def below."
   :args {:request {:type :ring-request-shape}}
   :return-type {:started [:list :uuid] :stopped [:list :uuid]}
   :effects #{:db :io}}

  {:name :_reconcile-services
   :description "Wrap the recon summary into the public response shape. Admins can extend the response by adding keys here without touching impls."
   :parent :zipmap
   :args {:keys [:ok :reconcile]
          :vals [{:value true}
                 :_reconcile-services-apply]}}

  {:name :reconcile-services-handler
   :description "Ring handler for POST /api/services/reconcile."
   :parent :json-handler
   :args {:data :_reconcile-services}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/services — list service rows + in-process running state
  ;; ---------------------------------------------------------------------

  ;; --- C17 atoms: list-services linear ETL decomposition.
  ;; Five named stages glued by a non-:cond graph (pure variant-1
  ;; data composition). Each stage's purpose is visible at the
  ;; graph level instead of buried in a 20-line `defbase` body.
  ;;
  ;; --- Block 1 Step 2 migration: Stage 1 now reads :service directly
  ;; via `:pg-query` + `:decode-row` instead of the thin
  ;; `:list-entities` wrap. `:service` is NON-VERSIONED (per
  ;; `versioning.storage.resolution/entity-config`), so a raw
  ;; pg-query bypasses the version-resolution layer correctly. The
  ;; HoneySQL is visible in the graph: admins can add `:where` /
  ;; `:order-by` / joins without going through `:list-entities`'s
  ;; generic interface.
  {:name :_list-services-rows
   :description "Stage 1 — every `:service` row decoded to graphden's canonical shape. Direct `:pg-query` + per-row `:decode-row` composition (Block 1 Step 2 migration off `:list-entities`)."
   :parent :map
   :args {:func :_list-services-decode-row
          :coll :_list-services-rows-raw}}

  {:name :_list-services-rows-raw
   :description "Raw `SELECT * FROM service` — snake_case column keys, undecoded enum/jsonb. Decoded per-row by `:_list-services-decode-row`."
   :parent :storage-query-call
   :args {:arg {:value {:select [:*] :from :service}}}}

  {:name :_list-services-decode-row
   :description "HOF callback — decode one raw `:service` row to graphden's canonical shape."
   :parent :decode-row
   :return-type :service-row-shape
   :args {:row {:as :item}
          :entity-type {:value "service"}}}

  ;; Block 1 Step 2 Phase 3: `:fn` is a VERSIONED entity. The
  ;; per-entity-type wrapper `:resolve-fn-rows` pins everything
  ;; entity-specific (version-id-field, version-data-fields, the
  ;; SQL for the version table). Per-site we only wire `:identities`
  ;; (the SELECT against `:fn` identity table) and `:branch-chain`
  ;; (the parent chain to scan).
  {:name :_list-services-fn-rows
   :description "Stage 2a — all `:fn` rows visible on the current branch."
   :parent :resolve-fn-rows
   :args {:identities :_list-services-fn-identities
          :branch-chain :current-branch-chain}}

  {:name :_list-services-fn-identities
   :parent :storage-query-identities
   :args {:entity-type {:value "fn"}
          :where {:value {}}}}

  {:name :_list-services-fn-id-name-pair
   :description "HOF callback per fn-row — emit a `[:id :name]` 2-vec so `:into {}` folds the sequence into a `{id → name}` index."
   :parent :vec
   :args {:coll [{:parent :get :args {:coll {:as :item} :key {:value :id} :default nil}}
                 {:parent :get :args {:coll {:as :item} :key {:value :name} :default nil}}]}}

  {:name :_list-services-fn-id-name-pairs
   :description "Stage 2b — map the per-fn `[:id :name]` builder over every fn row."
   :parent :map
   :args {:func :_list-services-fn-id-name-pair
          :coll :_list-services-fn-rows}}

  {:name :_list-services-fn-names
   :description "Stage 2 — build `{fn-id → name}` index over `:fn` rows (one query, constant-time lookups for the join below)."
   :parent :into
   :args {:to {:value {}}
          :from :_list-services-fn-id-name-pairs}}

  ;; --- :running-entry atomic primitive ----------------------------
  ;; Single library call — atom-deref + key lookup on `@recon/running`.
  ;; The downstream reshape lives in `:enrich-running` graph fn-def
  ;; below; admins can add `:thread-id` / `:port` / rename
  ;; `:stopper-set?` without touching Clojure.
  {:name :running-entry
   :description "Raw per-service running-info entry from `@recon/running` — `{:stopper :started-at :start-attempts :start-failed-at}` or nil. Atomic boundary; the JSON shape reshape lives in `:enrich-running`."
   :args {:service-id {:type :uuid :description "Service's row id."}}
   :return-type :nullable-keyword-map
   :effects #{}}

  ;; --- :enrich-running graph composition --------------------------
  ;; Per-service reshape into a JSON-safe map. Was a `defbase` that
  ;; hardcoded `{:stopper-set? :started-at :start-attempts
  ;; :start-failed-at}` in Clojure; now pure graph composition over
  ;; `:running-entry` + `:if (some? entry)` + `:zipmap`. Admins can
  ;; vary the response shape by reparenting `:_enrich-running-shape`.

  {:name :_enrich-running-entry
   :description "Closure-capture seed — the raw entry pulled off the reconciler atom. Referenced by the per-field readers below."
   :parent :running-entry
   :return-type [:union :null :running-info-shape]
   :args {:service-id {:as :service-id}}}

  {:name :_enrich-running-stopper-set?
   :description "Boolean coercion of `:stopper` (a Clojure callable or nil) for the JSON wire."
   :parent :is-a?
   :args {:value {:parent :get :args {:coll :_enrich-running-entry :key {:value :stopper} :default nil}}
          :type {:value :any}}}

  {:name :_enrich-running-started-at-raw
   :parent :get :args {:coll :_enrich-running-entry :key {:value :started-at} :default nil}}

  {:name :_enrich-running-started-at
   :description "Nil-safe stringify (mirrors `(some-> :started-at str)`)."
   :parent :if
   :args {:test {:parent :some? :args {:value :_enrich-running-started-at-raw}}
          :then {:parent :to-str :args {:value :_enrich-running-started-at-raw}}
          :else {:value nil}}}

  {:name :_enrich-running-start-failed-at-raw
   :parent :get :args {:coll :_enrich-running-entry :key {:value :start-failed-at} :default nil}}

  {:name :_enrich-running-start-failed-at
   :description "Nil-safe stringify (mirrors `(some-> :start-failed-at str)`)."
   :parent :if
   :args {:test {:parent :some? :args {:value :_enrich-running-start-failed-at-raw}}
          :then {:parent :to-str :args {:value :_enrich-running-start-failed-at-raw}}
          :else {:value nil}}}

  {:name :_enrich-running-shape
   :description "4-field JSON shape — `{:stopper-set? :started-at :start-attempts :start-failed-at}`. Admins can reparent / reorder to vary the response shape."
   :parent :zipmap
   :return-type {:stopper-set? :bool
                 :started-at :nullable-text
                 :start-attempts :nullable-int
                 :start-failed-at :nullable-text}
   :args {:keys [{:value :stopper-set?} {:value :started-at} {:value :start-attempts} {:value :start-failed-at}]
          :vals [:_enrich-running-stopper-set?
                 :_enrich-running-started-at
                 {:parent :get :args {:coll :_enrich-running-entry :key {:value :start-attempts} :default nil}}
                 :_enrich-running-start-failed-at]}}

  {:name :enrich-running
   :description "Reshape the in-process running entry for `service-id` (from `@recon/running`) into a JSON-safe map. nil when nothing is registered. Pure graph composition over `:running-entry` + `:if (some?)` + 4-field `:zipmap` reshape."
   :parent :if
   :args {:test {:parent :some? :args {:value :_enrich-running-entry}}
          :then :_enrich-running-shape
          :else {:value nil}
          :service-id {:type :uuid
                       :description "Service entity id — used to look up the running entry off the reconciler's in-process atom."}}}

  ;; ---------------------------------------------------------------------
  ;; :_list-services-enriched — graph-composed ETL Stage 3
  ;; ---------------------------------------------------------------------
  ;; Was `(mapv (fn [s] {:id … :fn-id … :fn-name (get names …)
  ;; :running (enrich-running …)}) rows)` — a single defbase that
  ;; hardcoded the per-row reshape. Now an `:map` HOF over `:rows`
  ;; with a `:_list-services-row-shape` callback that uses `:zipmap`
  ;; for the field map. `:names` is captured from the outer scope via
  ;; `{:as :names}` — closure-capture per `docs/CLOSURE_CAPTURE.md`,
  ;; the same pattern `:_merge-in-fn` uses for `:update-in`.

  {:name :_list-services-enriched
   :description "Stage 3 — `:map` each service row to the JSON-safe shape (`:fn-name` joined from the index, `:running` snapshot from the in-process atom). Composition is open: admins can extend the `:keys`/`:vals` lists in `:_list-services-row-shape` without editing Clojure."
   :parent :map
   :args {:func :_list-services-row-shape
          :coll {:as :rows}}}

  {:name :_list-services-row-shape
   :description "Single-row reshape — `(fn [s] {:id (:id s) :fn-id (:fn-id s) :fn-name (get names (:fn-id s)) :enabled? (:enabled? s) :restart-policy (:restart-policy s) :branch-id (:branch-id s) :running (enrich-running (:id s))})`. The HOF callback of `:_list-services-enriched`; `:names` is captured from the outer fn-def's free args. `:branch-id` is nullable (legacy rows pre-date the field); the editor service popover uses it to pre-fill the branch picker."
   :parent :zipmap
   :args {:keys [:id :fn-id :fn-name :enabled? :restart-policy :branch-id :running]
          :vals [{:parent :get :args {:coll {:as :item} :key {:value :id} :default nil}}
                 {:parent :get :args {:coll {:as :item} :key {:value :fn-id} :default nil}}
                 {:parent :get
                  :args {:coll {:as :names}
                         :key {:parent :get :args {:coll {:as :item} :key {:value :fn-id} :default nil}}
                         :default nil}}
                 {:parent :get :args {:coll {:as :item} :key {:value :enabled?} :default nil}}
                 {:parent :get :args {:coll {:as :item} :key {:value :restart-policy} :default nil}}
                 {:parent :get :args {:coll {:as :item} :key {:value :branch-id} :default nil}}
                 {:parent :enrich-running
                  :args {:service-id {:parent :get :args {:coll {:as :item} :key {:value :id} :default nil}}}}]}}

  {:name :_list-services
   :description "Stage 4 — wrap enriched-services into the final `{:ok true :services}` response."
   :parent :zipmap
   :args {:keys [:ok :services]
          :vals [{:value true}
                 {:as :enriched}]}}

  {:name :_list-services-data
   :description "GET /api/services — Stage-4 wrap of the enriched-services sub-result. Each stage is named in fns.edn so the editor's graph view surfaces the pipeline."
   :parent :_list-services
   :args {:enriched :_list-services-enriched
          ;; Sub-results fed into the enrichment.
          :rows :_list-services-rows
          :names :_list-services-fn-names}}

  {:name :list-services-handler
   :description "Ring handler for GET /api/services."
   :parent :json-handler
   :args {:data :_list-services-data}}

  ;; ---------------------------------------------------------------------
  ;; GET /partials/service-popover?fn-id=X — service settings popover
  ;; body. Reuses `:_list-services-enriched` (provides the per-row
  ;; `{:id :fn-id :fn-name :enabled? :restart-policy :branch-id
  ;; :running}` shape the popover renderer expects). The fn-name for
  ;; the popover title comes from the SAME `:_list-services-fn-names`
  ;; index that drives `:fn-name` on enriched services — covers ANY
  ;; fn (not just service-owners) because the index is built over the
  ;; full `:fn` table with `:where {}`.
  ;; ---------------------------------------------------------------------

  {:name :_partial-service-popover-fn-id-str
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "fn-id"}}}

  {:name :_partial-service-popover-fn-id-raw
   :parent :parse-uuid
   :args {:string :_partial-service-popover-fn-id-str}}

  {:name :_partial-service-popover-fn-id
   :description "Strict-uuid narrowing — `:render-service-popover-hiccup`'s `:fn-id` slot is `:uuid`. The JS caller only opens the popover with a real fn-id; a nil here is a programming error worth a 500 instead of silently rendering an empty popover."
   :parent :assert-some
   :return-type :uuid
   :args {:value :_partial-service-popover-fn-id-raw}}

  {:name :_partial-service-popover-fn-name
   :description "Display name from the all-fns index built by the existing services chain — works for any fn (even those without a service), because `:_list-services-fn-names` is keyed off `:_list-services-fn-rows` which selects the full `:fn` table."
   :parent :get
   :args {:coll :_list-services-fn-names
          :key :_partial-service-popover-fn-id
          :default nil}}

  {:name :_partial-service-popover-services
   :description "Enriched services list — same shape `:_list-services-data` uses, but referenced standalone here so the popover only pays for the join it actually needs."
   :parent :_list-services-enriched
   :args {:rows :_list-services-rows
          :names :_list-services-fn-names}}

  ;; =====================================================================
  ;; Execute-result body chain (`:_er-*`). The previous
  ;; `crud.fn-execution/render-execute-result-hiccup` + 5 private
  ;; helpers (render-list-body / render-record-body / render-tainted-
  ;; body / render-error-body / render-succeeded-body) hid the entire
  ;; result-rendering policy in Clojure: every text label, every
  ;; type-dispatch branch, the 50-item / 50-KB caps, the truncation
  ;; messages. §3.3 fix moves it all to the graph.
  ;;
  ;; Entry: `:_er-body` takes `{:as :exec}` (nullable keyword-map —
  ;; an execution row) and returns hiccup. Caller wraps via:
  ;;
  ;;   {:_partial-execute-result-fragment :parent :_er-body
  ;;    :args {:exec :_partial-execute-result-exec}}
  ;;
  ;; The 50-item list cap + 50-KB JSON-preview cap live as `:value`
  ;; bindings in `:_er-max-list-items` / `:_er-max-json-preview-bytes`
  ;; so admins can re-tune without a backend rebuild.
  ;; =====================================================================

  {:name :_er-max-list-items
   :description "Cap on visible list items — anything past this collapses to a `… N more` placeholder. Admin-tweakable. `:take :count` and `:subs :start` slots require `:non-negative-int` (refinement), so declare narrower than `:const`'s inferred `:int`."
   :parent :const
   :return-type :non-negative-int
   :args {:value 50}}

  {:name :_er-max-json-preview-bytes
   :description "Cap on serialized JSON shown for large payloads — preview cuts at this byte count. Admin-tweakable. Narrowed return matches `:subs :end` slot's `:non-negative-int`."
   :parent :const
   :return-type :non-negative-int
   :args {:value 50000}}

  ;; --- Top-level dispatch predicates ---

  {:name :_er-exec-nil?
   :parent :nil? :args {:value {:as :exec}}}

  {:name :_er-error-data
   :parent :get :args {:coll {:as :exec} :key {:value :error-data} :default nil}}

  {:name :_er-error-data-reason
   :parent :get :args {:coll :_er-error-data :key {:value :reason} :default nil}}

  {:name :_er-error-is-tainted?
   :parent :equal? :args {:a :_er-error-data-reason :b {:value :tainted}}}

  {:name :_er-touched-secret?
   :parent :get :args {:coll {:as :exec} :key {:value :touched-secret?} :default nil}}

  {:name :_er-tainted?
   :parent :or :args {:values [:_er-error-is-tainted? :_er-touched-secret?]}}

  ;; status comes back as a keyword from JSON parsing; coerce to text
  ;; for safe `:equal?` comparison against the literal strings below.
  {:name :_er-status-raw
   :parent :get :args {:coll {:as :exec} :key {:value :status} :default nil}}

  {:name :_er-status-some?
   :parent :some? :args {:value :_er-status-raw}}

  {:name :_er-status-name
   :parent :if
   :args {:test :_er-status-some?
          :then {:parent :name :args {:value :_er-status-raw}}
          :else {:value ""}}}

  {:name :_er-status-succeeded?
   :parent :equal? :args {:a :_er-status-name :b {:value "succeeded"}}}

  {:name :_er-status-failed?
   :parent :equal? :args {:a :_er-status-name :b {:value "failed"}}}

  ;; --- Tainted pane — "Result hidden" notice ---

  {:name :_er-tainted-icon
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "execute-tainted-icon"}}
          :children [{:value "🔒"}]}}

  {:name :_er-tainted-head
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-tainted-head"}}
          :children [{:value "Result hidden"}]}}

  {:name :_er-tainted-body-text
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-tainted-body"}}
          :children [{:value "This fn's return type is :secret — the value never reaches the browser. Swap the secret-bound argument for a plain literal to debug visibly."}]}}

  {:name :_er-tainted-text-wrap
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-tainted-text"}}
          :children [:_er-tainted-head :_er-tainted-body-text]}}

  {:name :_er-tainted-pane
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-result-pane execute-result-tainted"}}
          :children [:_er-tainted-icon :_er-tainted-text-wrap]}}

  ;; --- Error pane (status=failed) ---

  {:name :_er-error
   :parent :get :args {:coll {:as :exec} :key {:value :error} :default nil}}

  {:name :_er-error-text
   :parent :coalesce :args {:value :_er-error :default {:value "Execution failed"}}}

  {:name :_er-error-head
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-error-head"}}
          :children [:_er-error-text]}}

  {:name :_er-error-data-some?
   :parent :some? :args {:value :_er-error-data}}

  {:name :_er-error-data-json
   :parent :to-json-string :args {:data :_er-error-data}}

  {:name :_er-error-data-pre-shown
   :parent :hiccup
   :args {:tag {:value "pre"}
          :attrs {:value {:class "execute-error-data"}}
          :children [:_er-error-data-json]}}

  {:name :_er-hidden-placeholder
   :description "Empty `<span hidden=\"1\">` placeholder reused as the empty `:else` branch wherever a conditional section collapses to nothing — keeps the children-vector shape uniform."
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:hidden "1"}}
          :children {:value []}}}

  {:name :_er-error-data-pre
   :parent :if
   :args {:test :_er-error-data-some?
          :then :_er-error-data-pre-shown
          :else :_er-hidden-placeholder}}

  {:name :_er-error-pane
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-error-pane"}}
          :children [:_er-error-head :_er-error-data-pre]}}

  ;; --- Succeeded body — inner result-shape dispatch ---

  {:name :_er-result
   :parent :get :args {:coll {:as :exec} :key {:value :result} :default nil}}

  {:name :_er-result-truncated?
   :parent :get :args {:coll {:as :exec} :key {:value :result-truncated?} :default nil}}

  {:name :_er-result-nil?
   :parent :nil? :args {:value :_er-result}}

  {:name :_er-result-as-json
   :parent :to-json-string :args {:data :_er-result}}

  {:name :_er-result-as-json-len
   :parent :str-len :args {:string :_er-result-as-json}}

  {:name :_er-result-too-large?
   :parent :gt :args {:nums [:_er-result-as-json-len :_er-max-json-preview-bytes]}}

  ;; --- Truncated-cap pane (5 MB persistence cap fired) ---

  {:name :_er-truncated-note
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-result-truncated"}}
          :children [{:value "Result exceeded 5 MB cap — not stored."}]}}

  {:name :_er-truncated-pane
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-result-pane"}}
          :children [:_er-truncated-note]}}

  ;; --- nil-result pane (status=succeeded, value really was nil) ---

  {:name :_er-nil-scalar
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-result-scalar"}}
          :children [{:value "nil"}]}}

  {:name :_er-nil-pane
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-result-pane"}}
          :children [:_er-nil-scalar]}}

  ;; --- Large-JSON preview pane (>50 KB serialized) ---

  {:name :_er-large-preview-msg
   :description "Byte-count caption above the JSON preview pane. Stable across browsers — no locale-dependent KB rounding (admins who want KB display can wire a divide+round once they want it)."
   :parent :str
   :args {:parts [{:value "Result preview only — full payload "}
                  {:parent :to-str :args {:value :_er-result-as-json-len}}
                  {:value " bytes. First 50 KB shown."}]}}

  {:name :_er-large-preview-banner
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-result-truncated"}}
          :children [:_er-large-preview-msg]}}

  {:name :_er-large-preview-subs
   :parent :subs
   :args {:string :_er-result-as-json :start {:value 0} :end :_er-max-json-preview-bytes}}

  {:name :_er-large-preview-text
   :parent :str :args {:parts [:_er-large-preview-subs {:value "…"}]}}

  {:name :_er-large-preview-pre
   :parent :hiccup
   :args {:tag {:value "pre"}
          :attrs {:value {:class "execute-result-json"}}
          :children [:_er-large-preview-text]}}

  {:name :_er-large-preview-pane
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-result-pane"}}
          :children [:_er-large-preview-banner :_er-large-preview-pre]}}

  ;; --- Per-item simple-scalar predicate (used by list + record) ---
  ;; `{:as :item}` is the current element. Simple scalars stringify
  ;; via `:str`; everything else gets a `:pre` JSON dump.

  {:name :_er-item-is-text?
   :parent :is-a? :args {:value {:as :item} :type {:value :text}}}

  {:name :_er-item-is-int?
   :parent :is-a? :args {:value {:as :item} :type {:value :int}}}

  {:name :_er-item-is-numeric?
   :parent :is-a? :args {:value {:as :item} :type {:value :numeric}}}

  {:name :_er-item-is-bool?
   :parent :is-a? :args {:value {:as :item} :type {:value :bool}}}

  {:name :_er-item-is-keyword?
   :parent :is-a? :args {:value {:as :item} :type {:value :keyword}}}

  {:name :_er-item-is-null?
   :parent :is-a? :args {:value {:as :item} :type {:value :null}}}

  {:name :_er-item-is-simple?
   :parent :or
   :args {:values [:_er-item-is-text? :_er-item-is-int? :_er-item-is-numeric?
                   :_er-item-is-bool? :_er-item-is-keyword? :_er-item-is-null?]}}

  {:name :_er-item-as-str
   :parent :str :args {:parts [{:as :item}]}}

  {:name :_er-item-as-json
   :parent :to-json-string :args {:data {:as :item}}}

  {:name :_er-item-pre-json
   :parent :hiccup
   :args {:tag {:value "pre"} :attrs {:value nil}
          :children [:_er-item-as-json]}}

  {:name :_er-item-content
   :parent :if
   :args {:test :_er-item-is-simple?
          :then :_er-item-as-str
          :else :_er-item-pre-json}}

  ;; --- List pane (sequential result) ---

  {:name :_er-list-li
   :parent :hiccup
   :args {:tag {:value "li"} :attrs {:value nil}
          :children [:_er-item-content]}}

  ;; `:_er-result` types as `:any` (plucked from a nullable-keyword-
  ;; map via `:get`) but Phase #170 control-flow narrowing through
  ;; the `:_er-result-is-list?` `:is-a?` predicate in
  ;; `:_er-succeeded-body`'s `:cond` narrows it to `[:list :any]`
  ;; inside the list-pane branch. The type-checker sees the narrowed
  ;; type when checking these fn-defs (the override is propagated
  ;; transitively from `:_er-list-pane` down through the ref tree).
  ;; No `:assert-some` intermediate needed.

  {:name :_er-list-items-taken
   :parent :take :args {:count :_er-max-list-items :coll :_er-result}}

  {:name :_er-list-items-count
   :parent :count :args {:coll :_er-list-items-taken}}

  {:name :_er-list-total-count
   :parent :count :args {:coll :_er-result}}

  {:name :_er-list-overflow
   :parent :sub :args {:nums [:_er-list-total-count :_er-list-items-count]}}

  {:name :_er-list-overflow-shown?
   :parent :gt :args {:nums [:_er-list-overflow {:value 0}]}}

  {:name :_er-list-li-hiccup
   :parent :map :args {:func :_er-list-li :coll :_er-list-items-taken}}

  {:name :_er-list-overflow-msg
   :parent :str
   :args {:parts [{:value "… "}
                  {:parent :to-str :args {:value :_er-list-overflow}}
                  {:value " more"}]}}

  {:name :_er-list-overflow-li
   :parent :hiccup
   :args {:tag {:value "li"}
          :attrs {:value {:class "execute-result-list-more"}}
          :children [:_er-list-overflow-msg]}}

  {:name :_er-list-children-with-overflow
   :parent :concat :args {:colls [:_er-list-li-hiccup [:_er-list-overflow-li]]}}

  {:name :_er-list-children
   :parent :if
   :args {:test :_er-list-overflow-shown?
          :then :_er-list-children-with-overflow
          :else :_er-list-li-hiccup}}

  {:name :_er-list-ul
   :parent :hiccup
   :args {:tag {:value "ul"}
          :attrs {:value {:class "execute-result-list"}}
          :children :_er-list-children}}

  {:name :_er-list-pane
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-result-pane"}}
          :children [:_er-list-ul]}}

  ;; --- Record pane (map-typed result) ---
  ;; Iterates over the map — but :map HOFs iterate over sequences, so
  ;; we need to walk the entries. Idiomatic graphden: `:keys` + `:map`
  ;; per-key, looking up the value inside the callback via `:get`
  ;; against the closure-captured outer map.

  ;; `:keys` accepts wider input than `:take` so no allowlist entry
  ;; is needed for the record branch — direct read of `:_er-result`
  ;; works.
  {:name :_er-record-keys
   :parent :keys :args {:map :_er-result}}

  {:name :_er-record-key-value
   :parent :get :args {:coll {:as :record-m} :key {:as :item} :default nil}}

  {:name :_er-record-cell-content-is-simple?-cb
   :parent :or
   :args {:values [{:parent :is-a? :args {:value :_er-record-key-value :type {:value :text}}}
                   {:parent :is-a? :args {:value :_er-record-key-value :type {:value :int}}}
                   {:parent :is-a? :args {:value :_er-record-key-value :type {:value :numeric}}}
                   {:parent :is-a? :args {:value :_er-record-key-value :type {:value :bool}}}
                   {:parent :is-a? :args {:value :_er-record-key-value :type {:value :keyword}}}
                   {:parent :is-a? :args {:value :_er-record-key-value :type {:value :null}}}]}}

  {:name :_er-record-cell-as-str
   :parent :str :args {:parts [:_er-record-key-value]}}

  {:name :_er-record-cell-as-json
   :parent :to-json-string :args {:data :_er-record-key-value}}

  {:name :_er-record-cell-pre
   :parent :hiccup
   :args {:tag {:value "pre"} :attrs {:value nil}
          :children [:_er-record-cell-as-json]}}

  {:name :_er-record-cell-content
   :parent :if
   :args {:test :_er-record-cell-content-is-simple?-cb
          :then :_er-record-cell-as-str
          :else :_er-record-cell-pre}}

  {:name :_er-record-th
   :parent :hiccup
   :args {:tag {:value "th"} :attrs {:value nil}
          :children [{:parent :str :args {:parts [{:as :item}]}}]}}

  {:name :_er-record-td
   :parent :hiccup
   :args {:tag {:value "td"} :attrs {:value nil}
          :children [:_er-record-cell-content]}}

  {:name :_er-record-tr
   :parent :hiccup
   :args {:tag {:value "tr"} :attrs {:value nil}
          :children [:_er-record-th :_er-record-td]}}

  {:name :_er-record-trs
   :parent :map
   :args {:func :_er-record-tr
          :coll :_er-record-keys
          :record-m :_er-result}}

  {:name :_er-record-table
   :parent :hiccup
   :args {:tag {:value "table"}
          :attrs {:value {:class "execute-result-record"}}
          :children :_er-record-trs}}

  {:name :_er-record-pane
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-result-pane"}}
          :children [:_er-record-table]}}

  ;; --- Scalar-fallback pane (non-nil, not list, not map) ---

  {:name :_er-scalar-text
   :parent :str :args {:parts [:_er-result]}}

  {:name :_er-scalar-content
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-result-scalar"}}
          :children [:_er-scalar-text]}}

  {:name :_er-scalar-pane
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-result-pane"}}
          :children [:_er-scalar-content]}}

  ;; --- Succeeded-body dispatch — inner cond over result shape ---

  ;; `:sequence` covers Clojure's `sequential?` — vectors, lists,
  ;; lazy seqs. JSON arrays parse to vectors via cheshire, which are
  ;; sequential, so a single `:is-a? :sequence` is enough. Keeping
  ;; this as a direct `:is-a?` (not wrapped in `:or`) lets Phase #170
  ;; control-flow narrowing recognize the predicate in the `:cond`
  ;; clause below and narrow `:_er-result` to `[:list :any]` in the
  ;; corresponding `:_er-list-pane` branch — which is what
  ;; `:_er-result-as-list` declared `:return-type` matches.
  {:name :_er-result-is-list?
   :parent :is-a? :args {:value :_er-result :type {:value :sequence}}}

  {:name :_er-result-is-map?
   :parent :is-a? :args {:value :_er-result :type {:value :map}}}

  {:name :_er-succeeded-body
   :parent :cond
   :args {:clauses [:_er-result-truncated?  :_er-truncated-pane
                    :_er-result-nil?        :_er-nil-pane
                    :_er-result-too-large?  :_er-large-preview-pane
                    :_er-result-is-list?    :_er-list-pane
                    :_er-result-is-map?     :_er-record-pane
                    {:value true}           :_er-scalar-pane]}}

  ;; --- Neutral-status note (pending / cancelled / unknown) ---

  {:name :_er-status-text-or-unknown
   :parent :coalesce :args {:value :_er-status-name :default {:value "unknown"}}}

  {:name :_er-status-text-non-blank
   :parent :if
   :args {:test {:parent :equal? :args {:a :_er-status-text-or-unknown :b {:value ""}}}
          :then {:value "unknown"}
          :else :_er-status-text-or-unknown}}

  {:name :_er-neutral-note
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-cancelled"}}
          :children [:_er-status-text-non-blank]}}

  {:name :_er-neutral-pane
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-result-pane"}}
          :children [:_er-neutral-note]}}

  ;; --- Top-level body — final dispatch ---

  {:name :_er-body
   :description "Full result body hiccup — exec → hiccup. Replaces `crud.fn-execution/render-execute-result-hiccup` per §3.3. nil exec → `<span hidden>`; tainted (touched-secret? OR `:error-data.reason == :tainted`) → `Result hidden` pane; status=succeeded → result-shape dispatch via `:_er-succeeded-body`; status=failed → error pane; other (pending/cancelled/unknown) → neutral status note."
   :parent :cond
   :args {:clauses [:_er-exec-nil?           :_er-hidden-placeholder
                    :_er-tainted?            :_er-tainted-pane
                    :_er-status-succeeded?   :_er-succeeded-body
                    :_er-status-failed?      :_er-error-pane
                    {:value true}            :_er-neutral-pane]
          :exec {:type [:union :null :keyword-map]
                 :description "Decoded execution row from `:get-execution` OR the inline-Run JSON body. Both call sites bind via `:_partial-execute-result-fragment` / `:_partial-execute-result-inline-fragment` wrappers in `app/editor/fns.edn`."}}}

  ;; =====================================================================

  {:name :_sp-svc-row-fn-id
   :parent :get
   :args {:coll {:as :item} :key {:value :fn-id} :default nil}}

  {:name :_sp-svc-row-branch-id
   :parent :get
   :args {:coll {:as :item} :key {:value :branch-id} :default nil}}

  {:name :_sp-row-matches-fn?-cb
   :parent :equal?
   :args {:a :_sp-svc-row-fn-id :b {:as :fn-id}}}

  {:name :_sp-matches
   :parent :filter
   :args {:pred :_sp-row-matches-fn?-cb
          :coll {:as :enriched-services}}}

  {:name :_sp-on-current?-cb
   :parent :equal?
   :args {:a :_sp-svc-row-branch-id :b {:as :current-branch-id}}}

  {:name :_sp-matches-on-current
   :parent :filter
   :args {:pred :_sp-on-current?-cb
          :coll :_sp-matches
          :current-branch-id {:as :current-branch-id}}}

  {:name :_sp-existing-on-current
   :parent :first
   :args {:coll :_sp-matches-on-current}}

  {:name :_sp-on-null-branch?-cb
   :parent :nil?
   :args {:value :_sp-svc-row-branch-id}}

  {:name :_sp-matches-on-null
   :parent :filter
   :args {:pred :_sp-on-null-branch?-cb :coll :_sp-matches}}

  {:name :_sp-existing-on-null
   :parent :first
   :args {:coll :_sp-matches-on-null}}

  {:name :_sp-existing-first-match
   :parent :first
   :args {:coll :_sp-matches}}

  {:name :_sp-existing-fallback
   :description "Falls back to the legacy null-branch row first, then any first match."
   :parent :coalesce
   :args {:value :_sp-existing-on-null :default :_sp-existing-first-match}}

  {:name :_sp-existing
   :description "Picked :service row (or nil). Preference: row matching the active branch → null-branch fallback → first match."
   :parent :coalesce
   :args {:value :_sp-existing-on-current :default :_sp-existing-fallback}}

  {:name :_sp-existing-id
   :parent :get
   :args {:coll :_sp-existing :key {:value :id} :default nil}}

  {:name :_sp-existing-id-str
   :description "Stringified existing-service id for `data-existing-service-id` HTML attr. Empty string when no existing row — JS reads `data.existingServiceId || ''` and picks POST vs PUT/DELETE."
   :parent :if
   :args {:test :_sp-has-existing?
          :then {:parent :to-str :args {:value :_sp-existing-id}}
          :else {:value ""}}}

  {:name :_sp-has-existing?
   :parent :some?
   :args {:value :_sp-existing}}

  ;; ---------------------------------------------------------------------
  ;; Siblings — services on OTHER branches for the same fn-id. The
  ;; in-row id-check uses `:not :equal?` against the existing id;
  ;; nil-vs-uuid compares safely (no row's id will ever equal nil).
  ;; ---------------------------------------------------------------------

  {:name :_sp-svc-row-id
   :parent :get
   :args {:coll {:as :item} :key {:value :id} :default nil}}

  {:name :_sp-not-existing?-cb
   :parent :not
   :args {:value {:parent :equal? :args {:a :_sp-svc-row-id :b {:as :existing-id}}}}}

  {:name :_sp-siblings
   :parent :filter
   :args {:pred :_sp-not-existing?-cb
          :coll :_sp-matches
          :existing-id :_sp-existing-id}}

  {:name :_sp-siblings-empty?
   :parent :empty? :args {:coll :_sp-siblings}}

  {:name :_sp-has-siblings?
   :parent :not :args {:value :_sp-siblings-empty?}}

  {:name :_sp-siblings-count
   :parent :count :args {:coll :_sp-siblings}}

  {:name :_sp-multiple-siblings?
   :parent :gt :args {:nums [:_sp-siblings-count {:value 1}]}}

  ;; ---------------------------------------------------------------------
  ;; Header — title text + × close button.
  ;; ---------------------------------------------------------------------

  {:name :_sp-title-prefix
   :parent :if
   :args {:test :_sp-has-existing?
          :then {:value "Service: :"}
          :else {:value "Make service: :"}}}

  {:name :_sp-fn-name-or-anon
   :parent :coalesce
   :args {:value {:as :fn-name} :default {:value "(anonymous)"}}}

  {:name :_sp-title-text
   :parent :str
   :args {:parts [:_sp-title-prefix :_sp-fn-name-or-anon]}}

  {:name :_sp-title-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "service-popover-title"}}
          :children [:_sp-title-text]}}

  {:name :_sp-close-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:type "button"
                          :class "service-popover-close"
                          :aria-label "Close service popover"}}
          :children [{:value "×"}]}}

  {:name :_sp-header-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "service-popover-header"}}
          :children [:_sp-title-span :_sp-close-btn]}}

  ;; ---------------------------------------------------------------------
  ;; Status line (visible only when an existing :service row matches).
  ;; 4-branch cond over the running entry:
  ;;   nil running    → "Not yet started (reconcile to apply)."
  ;;   start-failed?  → "Start failed — exhausted N retries at HH:MM:SS UTC."
  ;;   stopper-set?   → "Running [since HH:MM:SS UTC]."
  ;;   else           → "Tracked but no active stopper."
  ;; ---------------------------------------------------------------------

  {:name :_sp-running
   :parent :get
   :args {:coll :_sp-existing :key {:value :running} :default nil}}

  {:name :_sp-running-nil?
   :parent :nil? :args {:value :_sp-running}}

  {:name :_sp-start-failed-at
   :parent :get :args {:coll :_sp-running :key {:value :start-failed-at} :default nil}}

  {:name :_sp-start-failed?
   :parent :some? :args {:value :_sp-start-failed-at}}

  {:name :_sp-stopper-set?
   :parent :get :args {:coll :_sp-running :key {:value :stopper-set?} :default nil}}

  {:name :_sp-start-attempts-raw
   :parent :get :args {:coll :_sp-running :key {:value :start-attempts} :default nil}}

  {:name :_sp-start-attempts
   :parent :coalesce :args {:value :_sp-start-attempts-raw :default {:value 1}}}

  {:name :_sp-started-at
   :parent :get :args {:coll :_sp-running :key {:value :started-at} :default nil}}

  ;; Time-of-day extraction: "2026-06-18T17:58:24..." → "17:58:24".
  ;; The `:coalesce` ahead of `:subs` keeps the type-checker happy
  ;; (subs requires :text); empty string is harmless because the
  ;; downstream :str caller only emits this when started-at is some?.
  {:name :_sp-started-at-text
   :parent :coalesce :args {:value :_sp-started-at :default {:value ""}}}

  {:name :_sp-started-at-short
   :parent :subs
   :args {:string :_sp-started-at-text :start {:value 11} :end {:value 19}}}

  {:name :_sp-start-failed-at-text
   :parent :coalesce :args {:value :_sp-start-failed-at :default {:value ""}}}

  {:name :_sp-start-failed-at-short
   :parent :subs
   :args {:string :_sp-start-failed-at-text :start {:value 11} :end {:value 19}}}

  {:name :_sp-status-line-failed
   :parent :str
   :args {:parts [{:value "Start failed — exhausted "}
                  :_sp-start-attempts
                  {:value " retries at "}
                  :_sp-start-failed-at-short
                  {:value " UTC."}]}}

  {:name :_sp-started-at-some?
   :parent :some? :args {:value :_sp-started-at}}

  {:name :_sp-status-line-running-since
   :parent :if
   :args {:test :_sp-started-at-some?
          :then {:parent :str
                 :args {:parts [{:value " since "}
                                :_sp-started-at-short
                                {:value " UTC"}]}}
          :else {:value ""}}}

  {:name :_sp-status-line-running
   :parent :str
   :args {:parts [{:value "Running"} :_sp-status-line-running-since {:value "."}]}}

  {:name :_sp-status-line
   :parent :cond
   :args {:clauses [:_sp-running-nil?  {:value "Not yet started (reconcile to apply)."}
                    :_sp-start-failed? :_sp-status-line-failed
                    :_sp-stopper-set?  :_sp-status-line-running
                    {:value true}      {:value "Tracked but no active stopper."}]}}

  {:name :_sp-status-div-shown
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "service-popover-status"}}
          :children [:_sp-status-line]}}

  {:name :_sp-hidden-placeholder
   :description "Empty `<span hidden=\"1\">` placeholder reused as the `:else` branch wherever a conditional section collapses to nothing — keeps the children-vector shape uniform."
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:hidden "1"}}
          :children {:value []}}}

  {:name :_sp-status-div
   :parent :if
   :args {:test :_sp-has-existing?
          :then :_sp-status-div-shown
          :else :_sp-hidden-placeholder}}

  ;; ---------------------------------------------------------------------
  ;; Sibling warning. Maps each sibling to "<branch-name> (<state>)",
  ;; joins with ", ", prepends pluralized header.
  ;; ---------------------------------------------------------------------

  {:name :_sp-sibling-running
   :parent :get :args {:coll {:as :item} :key {:value :running} :default nil}}

  {:name :_sp-sibling-stopper-set?
   :parent :get :args {:coll :_sp-sibling-running :key {:value :stopper-set?} :default nil}}

  {:name :_sp-sibling-start-failed-at
   :parent :get :args {:coll :_sp-sibling-running :key {:value :start-failed-at} :default nil}}

  {:name :_sp-sibling-failed?
   :parent :some? :args {:value :_sp-sibling-start-failed-at}}

  {:name :_sp-sibling-enabled?
   :parent :get :args {:coll {:as :item} :key {:value :enabled?} :default nil}}

  {:name :_sp-sibling-state
   :parent :cond
   :args {:clauses [:_sp-sibling-stopper-set? {:value "running"}
                    :_sp-sibling-failed?      {:value "failed"}
                    :_sp-sibling-enabled?     {:value "pending"}
                    {:value true}             {:value "disabled"}]}}

  ;; Find the branch whose :id matches the sibling's :branch-id —
  ;; same in-list :filter+:first pattern as the branch-popover row
  ;; helpers (closure-captured `{:as :branches}`).
  {:name :_sp-sibling-branch-id
   :parent :get :args {:coll {:as :item} :key {:value :branch-id} :default nil}}

  {:name :_sp-branch-matches-sibling?-cb
   :parent :equal?
   :args {:a {:parent :get :args {:coll {:as :item} :key {:value :id} :default nil}}
          :b {:as :sibling-branch-id}}}

  {:name :_sp-sibling-branch-matches
   :parent :filter
   :args {:pred :_sp-branch-matches-sibling?-cb
          :coll {:as :branches}
          :sibling-branch-id :_sp-sibling-branch-id}}

  {:name :_sp-sibling-branch-row
   :parent :first :args {:coll :_sp-sibling-branch-matches}}

  {:name :_sp-sibling-branch-name-found
   :parent :get :args {:coll :_sp-sibling-branch-row :key {:value :name} :default nil}}

  ;; Fallback label when branch lookup fails: "(any)" for null-branch
  ;; rows, "<unknown branch>" otherwise.
  {:name :_sp-sibling-branch-id-nil?
   :parent :nil? :args {:value :_sp-sibling-branch-id}}

  {:name :_sp-sibling-branch-fallback
   :parent :if
   :args {:test :_sp-sibling-branch-id-nil?
          :then {:value "(any)"}
          :else {:value "<unknown branch>"}}}

  {:name :_sp-sibling-branch-name
   :parent :coalesce
   :args {:value :_sp-sibling-branch-name-found :default :_sp-sibling-branch-fallback}}

  {:name :_sp-sibling-label
   :parent :str
   :args {:parts [:_sp-sibling-branch-name {:value " ("} :_sp-sibling-state {:value ")"}]}}

  {:name :_sp-sibling-labels
   :parent :map
   :args {:func :_sp-sibling-label
          :coll :_sp-siblings
          :branches {:as :branches}}}

  {:name :_sp-sibling-labels-joined
   :parent :str-join :args {:coll :_sp-sibling-labels :separator {:value ", "}}}

  {:name :_sp-sibling-warn-prefix
   :parent :if
   :args {:test :_sp-multiple-siblings?
          :then {:value "⚠ Also services on: "}
          :else {:value "⚠ Also a service on: "}}}

  {:name :_sp-sibling-warn-text
   :parent :str
   :args {:parts [:_sp-sibling-warn-prefix :_sp-sibling-labels-joined]}}

  {:name :_sp-sibling-warn-shown
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "service-popover-sibling-warn"
                          :title "Same fn-id, different branch. Reconciler keeps each branch's instance separate — verify this is intentional before adding another."}}
          :children [:_sp-sibling-warn-text]}}

  {:name :_sp-sibling-warn-div
   :parent :if
   :args {:test :_sp-has-siblings?
          :then :_sp-sibling-warn-shown
          :else :_sp-hidden-placeholder}}

  ;; ---------------------------------------------------------------------
  ;; Enabled checkbox. Default true for brand-new rows; existing rows
  ;; pre-fill with their stored `:enabled?` flag.
  ;; ---------------------------------------------------------------------

  {:name :_sp-existing-enabled?
   :parent :get :args {:coll :_sp-existing :key {:value :enabled?} :default {:value true}}}

  {:name :_sp-enabled-input-attrs-base
   :parent :assoc
   :args {:map {:value {:type "checkbox"}}
          :key {:value :class}
          :value {:value "service-popover-enabled"}}}

  {:name :_sp-enabled-input-attrs-with-checked
   :parent :assoc
   :args {:map :_sp-enabled-input-attrs-base
          :key {:value :checked}
          :value {:value "checked"}}}

  {:name :_sp-enabled-input-attrs
   :parent :if
   :args {:test :_sp-existing-enabled?
          :then :_sp-enabled-input-attrs-with-checked
          :else :_sp-enabled-input-attrs-base}}

  {:name :_sp-enabled-input
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs :_sp-enabled-input-attrs
          :children {:value []}}}

  {:name :_sp-enabled-label
   :parent :hiccup
   :args {:tag {:value "label"}
          :attrs {:value {:class "service-popover-option"}}
          :children [:_sp-enabled-input {:value " Enabled"}]}}

  ;; ---------------------------------------------------------------------
  ;; Branch picker. Pre-selected value:
  ;;   existing.branch-id-as-string   (if existing has explicit branch)
  ;;   ELSE current-branch-id-as-string  (default for new rows)
  ;;   ELSE ""                        (legacy null-branch)
  ;; The "(any — legacy)" option always present so admins can opt out
  ;; of per-branch scoping for a service that ought to run regardless.
  ;; ---------------------------------------------------------------------

  {:name :_sp-existing-branch-id
   :parent :get :args {:coll :_sp-existing :key {:value :branch-id} :default nil}}

  {:name :_sp-existing-branch-id-some?
   :parent :some? :args {:value :_sp-existing-branch-id}}

  {:name :_sp-existing-branch-id-str
   :parent :if
   :args {:test :_sp-existing-branch-id-some?
          :then {:parent :to-str :args {:value :_sp-existing-branch-id}}
          :else {:value nil}}}

  {:name :_sp-current-branch-id-str
   :parent :to-str :args {:value {:as :current-branch-id}}}

  {:name :_sp-pre-selected-fallback
   :parent :coalesce
   :args {:value :_sp-current-branch-id-str :default {:value ""}}}

  {:name :_sp-pre-selected
   :description "Selected `value=` for the branch picker — existing row's branch-id wins, else current-branch default, else empty (the legacy `(any)` option)."
   :parent :coalesce
   :args {:value :_sp-existing-branch-id-str :default :_sp-pre-selected-fallback}}

  {:name :_sp-pre-selected-is-any?
   :parent :equal? :args {:a :_sp-pre-selected :b {:value ""}}}

  ;; "(any — legacy)" option — selected iff nothing else matched.
  {:name :_sp-option-any-attrs-shown
   :parent :assoc
   :args {:map {:value {:value ""}}
          :key {:value :selected}
          :value {:value "selected"}}}

  {:name :_sp-option-any-attrs
   :parent :if
   :args {:test :_sp-pre-selected-is-any?
          :then :_sp-option-any-attrs-shown
          :else {:value {:value ""}}}}

  {:name :_sp-option-any
   :parent :hiccup
   :args {:tag {:value "option"}
          :attrs :_sp-option-any-attrs
          :children [{:value "(any — legacy)"}]}}

  ;; Per-branch option (HOF callback over branches).
  {:name :_sp-branch-row-id-str
   :parent :to-str :args {:value {:parent :get :args {:coll {:as :item} :key {:value :id} :default nil}}}}

  {:name :_sp-branch-row-name
   :parent :get :args {:coll {:as :item} :key {:value :name} :default nil}}

  {:name :_sp-branch-row-selected?
   :parent :equal?
   :args {:a :_sp-branch-row-id-str :b {:as :pre-selected}}}

  {:name :_sp-branch-option-attrs-base
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :value}
          :value :_sp-branch-row-id-str}}

  {:name :_sp-branch-option-attrs-with-selected
   :parent :assoc
   :args {:map :_sp-branch-option-attrs-base
          :key {:value :selected}
          :value {:value "selected"}}}

  {:name :_sp-branch-option-attrs
   :parent :if
   :args {:test :_sp-branch-row-selected?
          :then :_sp-branch-option-attrs-with-selected
          :else :_sp-branch-option-attrs-base}}

  {:name :_sp-branch-option
   :parent :hiccup
   :args {:tag {:value "option"}
          :attrs :_sp-branch-option-attrs
          :children [:_sp-branch-row-name]}}

  {:name :_sp-branch-options
   :parent :map
   :args {:func :_sp-branch-option
          :coll {:as :branches}
          :pre-selected :_sp-pre-selected}}

  {:name :_sp-branch-options-all
   :parent :cons
   :args {:item :_sp-option-any :coll :_sp-branch-options}}

  {:name :_sp-branch-select
   :parent :hiccup
   :args {:tag {:value "select"}
          :attrs {:value {:class "service-popover-branch-select"}}
          :children :_sp-branch-options-all}}

  {:name :_sp-branch-label-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "service-popover-branch-label"}}
          :children [{:value "Branch:"}]}}

  {:name :_sp-branch-wrap
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "service-popover-branch"}}
          :children [:_sp-branch-label-div :_sp-branch-select]}}

  ;; ---------------------------------------------------------------------
  ;; Restart-policy radios — 3 hardcoded enum values (matches the
  ;; `:service.restart-policy` column). Per-radio :checked toggled by
  ;; comparing against the existing row's policy (or "always" default
  ;; for new rows).
  ;; ---------------------------------------------------------------------

  {:name :_sp-existing-policy-raw
   :parent :get :args {:coll :_sp-existing :key {:value :restart-policy} :default nil}}

  {:name :_sp-existing-policy-keyword-name
   :description "Strip the leading `:` from the keyword form (e.g. `:always` → `\"always\"`); nil-safe."
   :parent :if
   :args {:test {:parent :some? :args {:value :_sp-existing-policy-raw}}
          :then {:parent :name :args {:value :_sp-existing-policy-raw}}
          :else {:value nil}}}

  {:name :_sp-current-policy
   :parent :coalesce
   :args {:value :_sp-existing-policy-keyword-name :default {:value "always"}}}

  {:name :_sp-policies
   :description "Hardcoded enum — matches the `:service.restart-policy` column. Admins MUST change the column enum + storage schema before adding values here."
   :parent :list
   :args {:items [{:value "always"} {:value "on-failure"} {:value "never"}]}}

  ;; Per-radio callback. `{:as :item}` is the policy string.
  {:name :_sp-policy-name
   :parent :str :args {:parts [{:as :item}]}}

  {:name :_sp-policy-selected?
   :parent :equal? :args {:a :_sp-policy-name :b {:as :current-policy}}}

  {:name :_sp-radio-attrs-base
   :parent :assoc
   :args {:map {:value {:type "radio" :name "service-restart-policy"}}
          :key {:value :value}
          :value :_sp-policy-name}}

  {:name :_sp-radio-attrs-with-checked
   :parent :assoc
   :args {:map :_sp-radio-attrs-base
          :key {:value :checked}
          :value {:value "checked"}}}

  {:name :_sp-radio-attrs
   :parent :if
   :args {:test :_sp-policy-selected?
          :then :_sp-radio-attrs-with-checked
          :else :_sp-radio-attrs-base}}

  {:name :_sp-radio-input
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs :_sp-radio-attrs
          :children {:value []}}}

  {:name :_sp-radio-label-text
   :parent :str :args {:parts [{:value " "} :_sp-policy-name]}}

  {:name :_sp-radio-label
   :parent :hiccup
   :args {:tag {:value "label"}
          :attrs {:value {:class "service-popover-policy-option"}}
          :children [:_sp-radio-input :_sp-radio-label-text]}}

  {:name :_sp-policy-radios
   :parent :map
   :args {:func :_sp-radio-label
          :coll :_sp-policies
          :current-policy :_sp-current-policy}}

  {:name :_sp-policy-label-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "service-popover-policy-label"}}
          :children [{:value "Restart policy:"}]}}

  {:name :_sp-policy-wrap-children
   :parent :cons
   :args {:item :_sp-policy-label-div :coll :_sp-policy-radios}}

  {:name :_sp-policy-wrap
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "service-popover-policy"}}
          :children :_sp-policy-wrap-children}}

  ;; ---------------------------------------------------------------------
  ;; Action bar: save (always) + delete (only when existing).
  ;; `data-existing-service-id` carries the row id (or empty for new)
  ;; so the JS save handler picks PUT-vs-POST and the delete handler
  ;; knows which id to target.
  ;; ---------------------------------------------------------------------

  {:name :_sp-save-btn-label
   :parent :if
   :args {:test :_sp-has-existing?
          :then {:value "Save & reconcile"}
          :else {:value "Create & reconcile"}}}

  {:name :_sp-save-btn-attrs
   :parent :assoc
   :args {:map {:value {:type "button"
                        :class "service-popover-save-btn"}}
          :key {:value :data-existing-service-id}
          :value :_sp-existing-id-str}}

  {:name :_sp-save-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_sp-save-btn-attrs
          :children [:_sp-save-btn-label]}}

  {:name :_sp-delete-btn-attrs
   :parent :assoc
   :args {:map {:value {:type "button"
                        :class "service-popover-delete-btn"
                        :title "Removes the :service row; reconcile stops the running fn."}}
          :key {:value :data-existing-service-id}
          :value :_sp-existing-id-str}}

  {:name :_sp-delete-btn-shown
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_sp-delete-btn-attrs
          :children [{:value "Delete service"}]}}

  {:name :_sp-delete-btn
   :parent :if
   :args {:test :_sp-has-existing?
          :then :_sp-delete-btn-shown
          :else :_sp-hidden-placeholder}}

  {:name :_sp-actions-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "service-popover-actions"}}
          :children [:_sp-save-btn :_sp-delete-btn]}}

  ;; ---------------------------------------------------------------------
  ;; Top-level body — all sections in order.
  ;; ---------------------------------------------------------------------

  {:name :_partial-service-popover-body
   :description "Full popover body. Pure-graph composition over the `:_sp-*` chain; previously delegated to `crud.services/render-service-popover-hiccup` (Clojure helper retired per §3.3)."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {}}
          :children [:_sp-header-div :_sp-status-div :_sp-sibling-warn-div
                     :_sp-enabled-label :_sp-branch-wrap :_sp-policy-wrap
                     :_sp-actions-div]
          :fn-id :_partial-service-popover-fn-id
          :fn-name :_partial-service-popover-fn-name
          :enriched-services :_partial-service-popover-services
          :branches :_list-branches-rows
          :current-branch-id :current-branch-id}}

  {:name :_partial-service-popover-html
   :parent :render-hiccup
   :args {:hiccup :_partial-service-popover-body}}

  {:name :_partial-service-popover-handler
   :description "Ring handler for `GET /partials/service-popover?fn-id=X` — returns the popover body as `text/html`. JS swaps the response into the popover host and binds save/delete/close handlers via `.service-popover-*-btn` selectors + `data-existing-service-id` attrs the partial emits."
   :parent :html-ok-response
   :args {:body :_partial-service-popover-html}}]}
