{:paths []

 :deps {org.clojure/clojure {:mvn/version "1.12.3"}}

 :aliases
 {;; === DEVELOPMENT ===

  :dev
  {:extra-paths
   ["development/src"
    ;; Components src
    "components/schema/src"
    "components/schema-malli/src"
    "components/storage/src"
    "components/storage-memory/src"
    "components/cache/src"
    "components/cache-eager/src"
    "components/graph/src"
    ;; Components test
    "components/schema/test"
    "components/schema-malli/test"
    "components/storage/test"
    "components/storage-memory/test"
    "components/cache/test"
    "components/cache-eager/test"
    "components/graph/test"
    ;; Base
    "bases/dev/src"
    "bases/dev/resources"]

   :extra-deps
   {integrant/integrant {:mvn/version "1.0.1"}
    metosin/malli {:mvn/version "0.20.0"}
    com.taoensso/timbre {:mvn/version "6.8.0"}
    org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}}

  ;; === TESTING ===

  :test
  {:extra-paths
   [;; Components src
    "components/schema/src"
    "components/schema-malli/src"
    "components/storage/src"
    "components/storage-memory/src"
    "components/cache/src"
    "components/cache-eager/src"
    "components/graph/src"
    ;; Components test
    "components/schema/test"
    "components/schema-malli/test"
    "components/storage/test"
    "components/storage-memory/test"
    "components/cache/test"
    "components/cache-eager/test"
    "components/graph/test"
    ;; Base
    "bases/dev/src"
    "bases/dev/resources"]

   :extra-deps
   {integrant/integrant {:mvn/version "1.0.1"}
    metosin/malli {:mvn/version "0.20.0"}
    lambdaisland/kaocha {:mvn/version "1.91.1392"}}}

  ;; === POLYLITH ===

  :poly
  {:extra-deps {polylith/clj-poly {:mvn/version "0.2.21"}}
   :main-opts ["-m" "polylith.clj.core.poly-cli.core"]}

  ;; === LINTERS ===

  ;; clj-kondo: Static analysis
  :kondo
  {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2025.10.23"}}
   :main-opts ["-m" "clj-kondo.main"]}

  ;; cljstyle: Code formatting
  :cljstyle
  {:extra-deps {mvxcvi/cljstyle {:mvn/version "0.17.642"}}
   :main-opts ["-m" "cljstyle.main"]}

  ;; splint: Modern linter (covers kibit functionality)
  :splint
  {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.22.0"}}
   :main-opts ["-m" "noahtheduke.splint"]}

  ;; cloverage: Test coverage
  :cloverage
  {:extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}}
   :main-opts ["-m" "cloverage.coverage"]}

  ;; clj-watson: Security CVE scanner
  :watson
  {:extra-deps {io.github.clj-holmes/clj-watson
                {:git/tag "v6.0.1" :git/sha "b520351"}}
   :main-opts ["-m" "clj-watson.cli" "scan"]}

  ;; antq: Outdated dependencies
  :outdated
  {:extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
   :main-opts ["-m" "antq.core"]}

  ;; === REPL ===

  :nrepl
  {:extra-deps
   {nrepl/nrepl {:mvn/version "1.5.1"}
    cider/cider-nrepl {:mvn/version "0.58.0"}
    refactor-nrepl/refactor-nrepl {:mvn/version "3.11.0"}}
   :main-opts
   ["-m" "nrepl.cmdline"
    "--middleware" "[cider.nrepl/cider-middleware,refactor-nrepl.middleware/wrap-refactor]"]}}}
