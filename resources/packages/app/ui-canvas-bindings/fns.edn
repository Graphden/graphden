   :args {:a :_flag-names-count :b 0}}
  {:name :_flag-declared-mode :parent :if
   :args {:test :_flag-no-names :then "none" :else "named"}}
  {:name :_flag-lambda-mode :parent :if
   :args {:test :_flag-declared :then :_flag-declared-mode :else "derived"}}
  {:name :_flag-is-lambda :parent :equal?
   :args {:a :_flag-surface :b "lambda"}}
