;; Logic and conditional base functions
;; All functions require implementations in impls.clj


{:namespace "core.logic"
 :description "Boolean logic, branching, defaults, and constant primitives."
 :fns
 [;; === Logic ===
  {:name :and
   :description "Logical AND over a vector — true iff every value is truthy."
   :args {:values {:type [:list :any] :description "Vector of values to AND."}}
   :return-type :bool}

  {:name :or
   :description "Logical OR over a vector — true iff at least one value is truthy."
   :args {:values {:type [:list :any] :description "Vector of values to OR."}}
   :return-type :bool}

  {:name :not
   :description "Boolean negation."
   :args {:value {:type a :description "Any value; truthy → false, falsy → true."}}
   :return-type :bool}

  {:name :some?
   :description "True iff value is non-nil."
   :args {:value {:type a :description "Value to test for nilness."}}
   :return-type :bool}

  {:name :nil?
   :description "True iff value is nil."
   :args {:value {:type a :description "Value to test for nilness."}}
   :return-type :bool}

  {:name :zero?
   :description "True iff number is zero. Pure library wrap of Clojure's `zero?` — added for the readable-in-graph case (`:if :test :_count-zero?` over `:zero? :number :my-count`) instead of routing every numeric-empty check through `:empty?` on the underlying collection."
   :args {:number {:type :numeric :description "Number to test."}}
   :return-type :bool}

  ;; === Type predicate ===
  ;;
  ;; ONE primitive replacing the per-type `keyword?` / `string?` /
  ;; `map?` / `vector?` / `sequential?` / `number?` / `integer?` /
  ;; `boolean?` family. The runtime check map lives in
  ;; `graphden.types.core/runtime-predicates`, colocated with the
  ;; canonical `primitives` set — adding a new primitive type updates
  ;; ONE place.

  {:name :is-a?
   :description "True iff `value` is an instance of the primitive type tagged by `type` (`:keyword` / `:int` / `:numeric` / `:text` / `:map` / `:vector` / `:sequence` / `:bool` / `:null` / `:any` / …). See `runtime-predicates` in `graphden.types.core` for the full list. Throws on unknown tags."
   :args {:value {:type :any
                  :description "Value to test."}
          :type {:type :keyword
                 :description "Canonical type-tag — a keyword like `:int` / `:keyword` / `:map`. Wrap with `{:value :foo}` in fn-def args to bypass fn-ref resolution if the tag happens to name a known fn-def."}}
   :return-type :bool}

  ;; === Conditionals ===
  ;; `:then` and `:else` share type-var `'a` so the return narrows to
  ;; whichever concrete type both branches carry. `:else` is optional —
  ;; when omitted, the runtime yields nil; the type system simplifies
  ;; that to `'a` rather than `[:union :null 'a]`.
  {:name :if
   :description "Two-branch conditional. Returns `then` when `test` is truthy, else `else` (nil if omitted)."
   ;; `:then` and `:else` are INDEPENDENT type variables — the branches
   ;; need not agree. The return is their union (`make-union` collapses
   ;; `[:union T T]` back to `T` when they do agree), matching the
   ;; runtime "whichever branch ran" semantics. A shared `a` here would
   ;; force the branches to unify and reject every heterogeneous `:if`.
   :args {:test {:type :any :description "Truthy/falsy expression."}
          :then {:type a :description "Returned when test is truthy."}
          :else {:type b :required false
                 :description "Returned when test is falsy. Defaults to nil."}}
   :return-type [:union a b]}

  ;; Flat clause sequence `[test1 result1 test2 result2 …]`. `:clauses`
  ;; is a `:lazy-seq-args` slot of `:cond` — items arrive as delays, so
  ;; an un-taken clause's result never runs (short-circuit). The
  ;; `cond-return-rule` types the return as the union of the
  ;; result-position branches, generalising `:if`'s `[:union then else]`.
  {:name :cond
   :description "Multi-branch conditional. `:clauses` is a flat sequence `[test1 result1 test2 result2 …]` — returns the first result whose test is truthy, nil if none match. Use a literal `true` as the final else-branch test. Each item may be a literal or a fn-ref."
   :args {:clauses {:type [:list :any] :description "Flat sequence of alternating test / result items; each may be a literal or a fn-ref."}}
   :return-type :any}

  ;; When `:clauses` is a literal map (or a homogeneous `[:map K V]`)
  ;; the type-checker's `case-return-rule` unions every clause value's
  ;; type with `:default`'s — so a `:case` with heterogeneous clauses
  ;; is typed `[:union …]`, not just `:default`'s type. When `:clauses`
  ;; is an opaque ref the return falls back to the declared `'a`.
  {:name :case
   :description "Constant-time dispatch on `value` via a `{match-value result}` map (Clojure's `(get clauses value default)`). Falls back to `:default` when the value isn't a key. Note: keys in a literal `:clauses` map come back keywordized after JSONB roundtrip — use string keys when matching against caller-supplied strings."
   :args {:value {:type :any :description "Value to look up in the clauses map."}
          ;; `:clauses` is `[:map a b]` — `a` is the key (dispatch) type,
          ;; `b` is the result type. `case-return-rule` unions concrete
          ;; clause-value types from a literal map with `:default`'s
          ;; type, so heterogeneous clause values are preserved as a
          ;; `[:union ...]` return; when `:clauses` is an opaque ref the
          ;; return falls back to `b`.
          :clauses {:type [:map a b] :description "Map of `{match-value result}` — the dispatch table. Pass either a literal map or a fn-ref that returns one."}
          :default {:type b :required false
                    :description "Fallback returned when `value` isn't a key in `:clauses`. Same type as the clause results. Defaults to nil."}}
   :return-type b}

  ;; === Defaults ===
  ;; `:coalesce` is the null-eliminator. `:value` is `:any` — any
  ;; maybe-nil value can be coalesced; `coalesce-return-rule` strips
  ;; `:null` from `:value`'s type and unions it with `:default`'s, so
  ;; a `[:union :null T]` value coalesced with a `T` default is typed
  ;; `T`. This is the explicit point where a nullable narrows back to
  ;; non-null.
  {:name :coalesce
   :description "Returns `value` if non-nil, else `default`. The null-eliminator — `coalesce-return-rule` strips `:null` from the value's type."
   ;; `:value` is `[:union :null a]` — pinning the contract that the
   ;; argument is either nil or some type `a` (which the default's
   ;; type also pins). Concrete non-null inputs (e.g. `:int`) still
   ;; type-check via subtype: `:int ⊆ :nullable-int` after
   ;; unification binds `a := :int`. `coalesce-return-rule` then
   ;; strips `:null` and unions with the default's type.
   :args {:value {:type [:union :null a] :description "Primary value; used when non-nil. Either nil or some `a` (matching the default's type)."}
          :default {:type a :description "Fallback used when value is nil."}}
   :return-type a}

  ;; --- :assert-some — narrow [:union :null T] → T at type-system level
  ;;
  ;; Runtime: passes the value through if non-nil, throws
  ;; `:execution-error/nil-assertion` if nil. The type-system
  ;; counterpart to `(when (nil? x) (throw ...)) x` — explicit
  ;; non-null assertion at sites where a control-flow guard
  ;; (`:if`-test elsewhere in the graph) makes the assertion
  ;; vacuous at runtime but the type-checker can't propagate the
  ;; guard knowledge. The rule strips `:null` from the input's
  ;; type so downstream sees the narrowed shape.
  ;;
  ;; Companion to `:coalesce`: both eliminate the null-or-T case,
  ;; but `:coalesce` substitutes a fallback value and pollutes the
  ;; type with the default's. `:assert-some` keeps the type clean
  ;; at the cost of a runtime throw the author has audited as
  ;; unreachable.
  {:name :assert-some
   :description "Throws `:execution-error/nil-assertion` if `value` is nil; returns it unchanged otherwise. The type-system bridge for control-flow invariants — strips `:null` from the input's type without polluting it with a fallback's type the way `:coalesce` does."
   :args {:value {:type [:union :null a]
                  :description "Maybe-nil value the caller has audited as unreachable-nil."}}
   :return-type a}

  ;; === Constants ===
  {:name :const
   :description "Identity-style passthrough — returns `:value` unchanged. Building block for capture renames `{:as :name}`."
   :args {:value {:type a :description "Value to return as-is."}}
   :return-type a}

  {:name :identity
   :description "Alias of `:const`."
   :parent :const}

  {:name :equal?
   :description "Two-arg equality (Clojure's `=`). Composition-friendly variant of `:eq`."
   :args {:a {:type :any :description "Left operand."}
          :b {:type :any :description "Right operand."}}
   :return-type :bool}

  {:name :constant-time-equal?
   :description "Two-string equality in constant time relative to the longer input — comparison never short-circuits on the first differing byte. Use for any equality check on secret material (bearer tokens, HMAC tags, …); a regular `:equal?` leaks a per-byte timing channel that lets an attacker probe one prefix at a time. Behavioural semantics match `:equal?` for strings; nil/non-string inputs short-circuit to false at the boundary."
   :args {:a {:type :nullable-text :description "First string (nil-safe — nil ↔ non-nil compares false)."}
          :b {:type :nullable-text :description "Second string."}}
   :return-type :bool}]}
