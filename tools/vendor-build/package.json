{
  "name": "graphden-vendor-build",
  "private": true,
  "description": "Builds the vendored CodeMirror 6 bundle for resources/packages/web/vendor/. Run `npm install && npm run build` after bumping versions.",
  "scripts": {
    "build": "esbuild cm-entry.js --bundle --minify --format=iife --outfile=../../resources/packages/web/vendor/codemirror.min.js",
    "build:preact": "esbuild preact-entry.js --bundle --minify --format=iife --global-name=GraphdenPreact --legal-comments=inline --outfile=../../resources/packages/web/vendor/preact.min.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@nextjournal/lang-clojure": "1.0.0",
    "preact": "11.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
