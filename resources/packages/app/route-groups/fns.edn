;; Route groups — the top-level entry reitit consumes via `app.server._router`.
;;
;; `:all` is not a flat list of every endpoint — it's a small list of
;; TOP-LEVEL reitit entries:
;; standalone leaves (`:health`, `:metrics`, `:favicon`, `:editor`) and
;; the `:api-routes` prefix group. Reitit walks the nested vectors and
;; assembles full paths itself.


{:namespace "app.routes.groups"
 :description "The `:all` route bundle — the top-level nested-tree input to reitit's router."
 :fns
 [{:name :all
   :description "Top-level reitit entries — standalone leaves and the `:api-routes` prefix group that the router walks. Adding a new path = either drop a new leaf in here (if it has no prefix-mate) or extend the appropriate sub-group inside `:api-routes`."
   :parent :list
   ;; Route order is free again: the list-grow bug that made a mid-insert
   ;; drop `:api-routes` from a LIVE database (versionless identity
   ;; remnants never got a version row, so they stayed invisible) is fixed
   ;; in versioning/storage/core's batch update path, pinned by
   ;; `upsert-onto-versionless-identity-writes-a-version-test`.
   :args {:items [:favicon
                  :auth-me-fallback
                  :editor
                  :editor-js-asset
                  :api-routes-js-asset
                  :graphden-runtime-js-asset
                  :htmx-js-asset
                  :htmx-sse-js-asset
                  :codemirror-js-asset
                  :editor-css-asset
                  :graphden-components-css-asset
                  :partial-effect
                  :partial-branch-verification
                  :partial-auth-form
                  :partial-fn-versions
