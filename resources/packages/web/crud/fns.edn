;; Storage CRUD base functions for web UI.
;; Impls that need storage access read it from `ctx` in their body
;; (see resources/packages/web/crud/impls.clj).


{:namespace "web.crud"
 :description "Storage CRUD primitives for the web UI — query/render/dispatch entity create/update/delete via context-aware impls."
 :fns
 [;; ---------------------------------------------------------------------
  ;; Parse-stage output shapes. Each `_*-parsed` base-fn returns a
  ;; record of a known shape; naming it lets the matching validate /
  ;; apply stages declare `:parsed` as that record instead of bare
  ;; `:jsonb`. `_`-prefixed — internal to one handler triple each.
  ;; ---------------------------------------------------------------------

  {:name :_types-compatible-parsed-shape
   :description "Output of `:_types-compatible-parsed` — the two type expressions to subtype-check."
   :type {:expected :jsonb :candidate :jsonb}}

  {:name :_types-candidates-parsed-shape
   :description "Output of `:_types-candidates-parsed` — the target type plus optional effect-set / name-prefix filters."
   :type {:expected :jsonb :allowed-effects :jsonb :name-prefix :text}}

  {:name :_types-usages-parsed-shape
   :description "Output of `:_types-usages-parsed` — the type-row id to search references for."
   :type {:target-id :uuid}}

  {:name :_create-record-type-parsed-shape
   :description "Output of `:_create-record-type-parsed` — a record type-row's name, owning namespace, description and field list."
   :type {:name :text :ns-id :uuid :description :text :fields :jsonb}}

  {:name :_create-list-type-parsed-shape
   :description "Output of `:_create-list-type-parsed` — a list type-row's name, owning namespace, description and element-type reference."
   :type {:name :text :ns-id :uuid :description :text :element-ref :text}}

  {:name :_update-record-type-parsed-shape
   :description "Output of `:_update-record-type-parsed` — the target fn-id plus the submitted name / description / field list. `:has-description?` distinguishes a submitted-nil description from an absent key."
   :type {:fn-id :uuid :name :text :has-description? :bool :description :text :fields :jsonb}}

  {:name :_create-parsed-shape
   :description "Output of `:_create-parsed` — the URI entity-type, the form-decoded body, the per-type-parsed entity field map, and a `:parse-error` string set when the per-type parser threw."
   :type {:entity-type :keyword :type-str :text :form-data :jsonb :entity-data :jsonb :parse-error :text}}

  {:name :_update-parsed-shape
   :description "Output of `:_update-parsed` — like `:_create-parsed-shape` plus the `:id` URI segment (`:id-str` / `:id-uuid`) and `:pre-existing`, the pre-read of the row being updated."
   :type {:entity-type :keyword :type-str :text :id-str :text :id-uuid :uuid :form-data :jsonb :pre-existing :jsonb :entity-data :jsonb :parse-error :text}}

  {:name :_tighten-parsed-shape
   :description "Output of `:_tighten-parsed` — the target binding-id and the raw `effects` / `args` / `ret` body components plus the assembled `:delta` map."
   :type {:binding-id :uuid :effects-val :jsonb :args-val :jsonb :ret-val :jsonb :delta :jsonb}}

  ;; A write-time validation rejection. The `_*-validation` stages
  ;; return this when a guard fails (or nil when the request passes);
  ;; `_rejection-response` renders the `:reason` into a 400.
  {:name :_rejection-shape
   :description "A write-time validation rejection — `_rejection-response` renders `:reason` into a 400 partial response."
   :type {:reason :text}}

  ;; --- handler RESULT shapes — the JSON payloads the type-API /
  ;; type-row stages return (distinct from `_rejection-shape`, the
  ;; entity-CRUD `{:reason}` rejection). ---

  {:name :_error-result-shape
   :description "The `{:ok false :error}` rejection payload returned by every type-API / type-row / value-form validation stage."
   :type {:ok :bool :error :text}}

  {:name :_types-compatible-result-shape
   :description "Output of `:_types-compatible-apply` — the subtype-check verdict. An extra `:reason` is present when not ok (open-record — extra fields are fine)."
   :type {:ok :bool :expected :jsonb :candidate :jsonb}}

  {:name :_types-candidates-result-shape
   :description "Output of `:_types-candidates-apply` — the enumeration of fns whose return type is a subtype of `expected`."
   :type {:ok :bool :expected :jsonb :count :int :candidates :jsonb}}

  {:name :_types-usages-result-shape
   :description "Output of `:_types-usages-apply` — every reference to the target type-row. `:type-fn-id` is the id stringified."
   :type {:ok :bool :type-fn-id :text :type-name :text :count :int :usages :jsonb}}

  {:name :_id-name-result-shape
   :description "The success payload of a type-row create / update — the new row's id (stringified) and name."
   :type {:ok :bool :id :text :name :text}}

  {:name :_type-row-result-shape
   :description "What a type-row create / update apply stage returns — the success payload, or an `{:ok false :error}` map when the transactional write failed."
   :union [:_id-name-result-shape :_error-result-shape]}

  {:name :_partial-response-shape
   :description "A partial Ring response from a `process-*` / `_*-apply` stage — `:status` + `:body`, optionally `:headers` (open-record). `html-action-response` wraps it into a full response, defaulting any missing field."
   :type {:status :int :body :text}}

  ;; --- open-map shapes — `[:map K V]` typed maps, replacing bare
  ;; `:jsonb` where the key / value domains ARE known. ---

  {:name :_storage-where-map
   :description "A storage query filter — `{column-keyword → match-value}`. Keys are entity column names; values arbitrary."
   :map {:key :keyword :value :any}}

  {:name :_form-field-map
   :description "Parsed `application/x-www-form-urlencoded` fields — `{field-keyword → string-value}`."
   :map {:key :keyword :value :text}}

  {:name :_entity-field-map
   :description "An entity's field map — `{column-keyword → value}`. The sparse shape a form parser extracts and `create` / `update-entity` writes."
   :map {:key :keyword :value :any}}

  ;; Query functions (context-aware)
  {:name :list-entities
   :description "Query a list of entities of a given type, optionally filtered by `:where`. Reads through the storage attached to the executor context."
   :args {:entity-type {:type :text :description "Entity-name keyword as string (e.g. \"fn\", \"arg\", \"ns\")."}
          :where {:type :_storage-where-map :required false :description "Storage filter map. Omit to fetch all of the type."}}
   :return-type [:list :jsonb]
   :effects #{:db}}

  {:name :get-entity
   :description "Look up a single entity by id."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :id {:type :uuid :description "Entity UUID."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :create-entity
   :description "Insert a new entity row from `:data`. The id is generated by storage if absent."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :data {:type :_entity-field-map :description "Field map for the new row."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :update-entity
   :description "Update an existing entity by id with `:data` (sparse — only fields present in `:data` change)."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :id {:type :uuid :description "Entity UUID to update."}
          :data {:type :_entity-field-map :description "Sparse field map of changes."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :delete-entity
   :description "Delete an entity by id. With versioned storage this is a soft-delete; the base row persists."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :id {:type :uuid :description "Entity UUID to delete."}}
   :return-type :bool
   :effects #{:db}}

  {:name :list-all-graph-entities
   :description "Dump every fn, arg, and namespace currently in storage — the payload behind `/api/graph/entities`."
   :args {}
   :return-type :jsonb
   :effects #{:db}}

  {:name :all-rich-types
   :description "Snapshot of the in-memory rich-type registry. Returns `{fn-name {:return type :args {arg-name type}}}` for every base-fn AND composed fn-def the type-checker has processed. Powers `/api/types` — editor and external tools use this to know what each slot accepts."
   :args {}
   :return-type :jsonb
   :effects #{:db}}

  {:name :value-kinds
   :description "The `value_kind` schema enum as an ordered list of primitive type-tag strings (`\"int\"`, `\"text\"`, …) a binding value / slot can carry. Powers `GET /api/value-kinds` — the editor's type-pickers read it instead of hard-coding the enum. Pure: reads a compile-time constant."
   :args {}
   :return-type [:list :text]}

  ;; --- type-API handler primitives. The handlers themselves are `:if`
  ;; graph fn-defs below; these base-fns are the parse / validate /
  ;; apply stages. `validate-*` returns the `{:ok false :error}`
  ;; rejection response directly (or nil), so the `:if`'s `:then` branch
  ;; is the validation result itself; `_rejected?` is shared with the
  ;; entity create/update + type-row handlers. ---
  {:name :_types-compatible-parsed
   :description "Stage 1 of types-compatible — JSON body → `{:expected :candidate}`, each decoded from the wire shape produced by `/api/types`."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :_types-compatible-parsed-shape}

  {:name :_types-compatible-validation
   :description "Stage 2 of types-compatible — guards (both `expected` and `candidate` present). Returns the `{:ok false :error}` rejection response, or nil when well-formed."
   :args {:parsed {:type :_types-compatible-parsed-shape :description "Output of `:_types-compatible-parsed`."}}
   :return-type :_error-result-shape}

  {:name :_types-compatible-apply
   :description "Stage 3 of types-compatible — the single-pair subtype check between an `expected` (slot-side) and `candidate` (binding-side) type. Returns `{:ok :expected :candidate :reason?}`. Reached only after validation passes."
   :args {:parsed {:type :_types-compatible-parsed-shape :description "Output of `:_types-compatible-parsed`."}}
   :return-type :_types-compatible-result-shape}

  {:name :_types-candidates-parsed
   :description "Stage 1 of types-candidates — JSON body → `{:expected :allowed-effects :name-prefix}`."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :_types-candidates-parsed-shape}

  {:name :_types-candidates-validation
   :description "Stage 2 of types-candidates — guards `expected` present. Returns the `{:ok false :error}` rejection response, or nil when well-formed."
   :args {:parsed {:type :_types-candidates-parsed-shape :description "Output of `:_types-candidates-parsed`."}}
   :return-type :_error-result-shape}

  {:name :_types-candidates-apply
   :description "Stage 3 of types-candidates — enumerate every fn whose return type is a subtype of `expected`, narrowed by the optional allowed-effect set / name-prefix. Returns `{:ok :expected :count :candidates}` sorted alphabetically. Reached only after validation passes."
   :args {:parsed {:type :_types-candidates-parsed-shape :description "Output of `:_types-candidates-parsed`."}}
   :return-type :_types-candidates-result-shape
   :effects #{:db}}

  {:name :_types-usages-parsed
   :description "Stage 1 of types-usages — JSON body → `{:target-id}` (the `type-fn-id` coerced to a UUID, or nil when absent / malformed)."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :_types-usages-parsed-shape}

  {:name :_types-usages-validation
   :description "Stage 2 of types-usages — guards a valid `type-fn-id`. Returns the `{:ok false :error}` rejection response, or nil when well-formed."
   :args {:parsed {:type :_types-usages-parsed-shape :description "Output of `:_types-usages-parsed`."}}
   :return-type :_error-result-shape}

  {:name :_types-usages-apply
   :description "Stage 3 of types-usages — walk the graph for every reference to the target type-row. Returns `{:ok :type-fn-id :type-name :count :usages}` where each usage's `kind ∈ {:base-of :element-of :return-of :slot-of :binding-of :union-branch :variant-branch}`. Reached only after validation passes."
   :args {:parsed {:type :_types-usages-parsed-shape :description "Output of `:_types-usages-parsed`."}}
   :return-type :_types-usages-result-shape
   :effects #{:db}}

  ;; --- type-row compound handler primitives. The handlers themselves
  ;; are `:if` graph fn-defs below; these base-fns are the parse /
  ;; validate / apply stages. `validate-*` returns the `{:ok false
  ;; :error}` rejection response directly (or nil), so the `:if`'s
  ;; `:then` branch is the validation result itself; `_rejected?` is
  ;; shared with the entity create/update handlers. ---
  {:name :_create-record-type-parsed
   :description "Stage 1 of create-record-type — JSON body → `{:name :ns-id :description :fields}`."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :_create-record-type-parsed-shape}

  {:name :_create-record-type-validation
   :description "Stage 2 of create-record-type — guards (blank name, empty field list). Returns the `{:ok false :error}` rejection response, or nil when well-formed."
   :args {:parsed {:type :_create-record-type-parsed-shape :description "Output of `:_create-record-type-parsed`."}}
   :return-type :_error-result-shape}

  {:name :_create-record-type-apply
   :description "Stage 3 of create-record-type — atomically create the record type-row (1 fn-row + N slot-rows + N fn-slot-junctions); rolls partial writes back on failure. Reached only after validation passes. Returns `{:ok true :id :name}`."
   :args {:parsed {:type :_create-record-type-parsed-shape :description "Output of `:_create-record-type-parsed`."}}
   :return-type :_type-row-result-shape
   :effects #{:db}}

  {:name :_create-list-type-parsed
   :description "Stage 1 of create-list-type — JSON body → `{:name :ns-id :description :element-ref}`."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :_create-list-type-parsed-shape}

  {:name :_create-list-type-validation
   :description "Stage 2 of create-list-type — guards (blank name, missing element-type). Returns the `{:ok false :error}` rejection response, or nil when well-formed."
   :args {:parsed {:type :_create-list-type-parsed-shape :description "Output of `:_create-list-type-parsed`."}}
   :return-type :_error-result-shape}

  {:name :_create-list-type-apply
   :description "Stage 3 of create-list-type — atomically create the list type-row (1 fn-row with `element-fn-id` + synthesised `items` slot); rolls partial writes back on failure. Reached only after validation passes. Returns `{:ok true :id :name}`."
   :args {:parsed {:type :_create-list-type-parsed-shape :description "Output of `:_create-list-type-parsed`."}}
   :return-type :_type-row-result-shape
   :effects #{:db}}

  {:name :_update-record-type-parsed
   :description "Stage 1 of update-record-type — JSON body → `{:fn-id :name :has-description? :description :fields}`."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :_update-record-type-parsed-shape}

  {:name :_update-record-type-validation
   :description "Stage 2 of update-record-type — guards (missing id, empty field list, fn-row not found). The final guard reads storage. Returns the `{:ok false :error}` rejection response, or nil when well-formed."
   :args {:parsed {:type :_update-record-type-parsed-shape :description "Output of `:_update-record-type-parsed`."}}
   :return-type :_error-result-shape
   :effects #{:db}}

  {:name :_update-record-type-apply
   :description "Stage 3 of update-record-type — diff the submitted field list against the row's current fn-slots and atomically apply it (journalled rollback on failure). Reached only after validation passes. Returns `{:ok true :id :name}`. Caveat: orphaned slots are NOT garbage-collected (slot rows are shared)."
   :args {:parsed {:type :_update-record-type-parsed-shape :description "Output of `:_update-record-type-parsed`."}}
   :return-type :_type-row-result-shape
   :effects #{:db}}

  ;; --- entity create / update pipeline primitives. The handlers
  ;; themselves are `:if` graph fn-defs below; these base-fns are the
  ;; parse / validate / apply stages. `_rejected?` + `_rejection-response`
  ;; are shared by both create and update. ---
  {:name :_create-parsed
   :description "Stage 1 of create — URI entity-type + form-decoded body routed through the per-type parser. `{:entity-type :type-str :form-data :entity-data :parse-error}`."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :_create-parsed-shape}

  {:name :_create-validation
   :description "Stage 2 of create — every write-time guard; the first rejection `{:reason …}` or nil."
   :args {:parsed {:type :_create-parsed-shape :description "Output of `:_create-parsed`."}}
   :return-type :_rejection-shape
   :effects #{:db}}

  {:name :_create-apply
   :description "Stage 3 of create — create the entity, run the post-create whole-fn type-check (rollback on failure), return the partial Ring response. Reached only after validation passes."
   :args {:parsed {:type :_create-parsed-shape :description "Output of `:_create-parsed`."}}
   :return-type :_partial-response-shape
   :effects #{:db}}

  {:name :_update-parsed
   :description "Stage 1 of update — like `:_create-parsed` plus the `:id` segment and a pre-read of the existing row."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :_update-parsed-shape
   :effects #{:db}}

  {:name :_update-validation
   :description "Stage 2 of update — write-time guards against the merged post-write view; first rejection or nil."
   :args {:parsed {:type :_update-parsed-shape :description "Output of `:_update-parsed`."}}
   :return-type :_rejection-shape
   :effects #{:db}}

  {:name :_update-apply
   :description "Stage 3 of update — update the entity and return the partial Ring response. Reached only after validation passes."
   :args {:parsed {:type :_update-parsed-shape :description "Output of `:_update-parsed`."}}
   :return-type :_partial-response-shape
   :effects #{:db}}

  {:name :_rejected?
   :description "True when a `validate-*` stage produced a rejection."
   :args {:validation {:type [:union :_rejection-shape :null] :description "A `{:reason …}` rejection map, or nil."}}
   :return-type :bool}

  {:name :_rejection-response
   :description "Render a `validate-*` rejection as a 400 partial Ring response."
   :args {:validation {:type :_rejection-shape :description "A `{:reason …}` rejection map."}}
   :return-type :_partial-response-shape}

  {:name :process-delete-entity
   :description "Parse a Ring request, delete the entity it identifies, return a partial Ring response."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :_partial-response-shape
   :effects #{:db}}

  ;; Sequence operations: append/remove items of a sequence arg on any fn
  ;; that has a `:sequence`-typed anchor (e.g. :list, :pairs->map children).
  {:name :process-sequence-append
   :description "Append an item to a `:sequence`-typed arg on the fn identified by the request. Returns a partial Ring response."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :_partial-response-shape
   :effects #{:db}}

  {:name :process-sequence-remove
   :description "Remove an item from a `:sequence`-typed arg by item id. Returns a partial Ring response."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :_partial-response-shape
   :effects #{:db}}

  {:name :process-sequence-update
   :description "Update an existing `:sequence`-arg item by item id (PUT /api/sequence/item/:item-id) — replaces its `:value` or `:ref-fn-id`. Returns a partial Ring response."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :_partial-response-shape
   :effects #{:db}}

  ;; --- tighten-fn-effects primitives. The handler itself is a
  ;; `:cond` graph fn-def (`:process-tighten-binding-effects` below);
  ;; these are its parse / guard-predicate / apply primitives. ---
  {:name :_tighten-parsed
   :description "Parse a tighten-fn-effects request into `{:binding-id :effects-val :args-val :ret-val :delta}` — no validation."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :_tighten-parsed-shape}

  {:name :_tighten-binding-id-invalid?
   :description "Guard predicate — true when the request carries no valid binding-id."
   :args {:parsed {:type :_tighten-parsed-shape :description "Output of `:_tighten-parsed`."}}
   :return-type :bool}

  {:name :_tighten-effects-invalid?
   :description "Guard predicate — true when `effects` is present but not a JSON array."
   :args {:parsed {:type :_tighten-parsed-shape :description "Output of `:_tighten-parsed`."}}
   :return-type :bool}

  {:name :_tighten-args-invalid?
   :description "Guard predicate — true when `args` is present but not a JSON object."
   :args {:parsed {:type :_tighten-parsed-shape :description "Output of `:_tighten-parsed`."}}
   :return-type :bool}

  {:name :_tighten-delta-empty?
   :description "Guard predicate — true when the body carried none of args / ret / effects."
   :args {:parsed {:type :_tighten-parsed-shape :description "Output of `:_tighten-parsed`."}}
   :return-type :bool}

  {:name :_tighten-apply
   :description "Success branch — narrow the fn-typed binding's effective type to a 4-arity `[:fn args ret #{eff-set}]`, dedupe the anonymous constraint fn-row, write the binding's `:type-override-fn-id`, and return the partial Ring response. Reached only after every `:cond` guard passes."
   :args {:parsed {:type :_tighten-parsed-shape :description "Output of `:_tighten-parsed`."}}
   :return-type :_partial-response-shape
   :effects #{:db}}

  {:name :parse-form-body
   :description "Parse an `application/x-www-form-urlencoded` request body into a `{key value}` map."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map (uses its `:body`)."}}
   :return-type :_form-field-map}

  {:name :parse-json-body
   :description "Parse a JSON request body into a Clojure value (keywordizing string keys)."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map (uses its `:body`)."}}
   :return-type :jsonb}

  {:name :str-to-uuid
   :description "Coerce a string to `java.util.UUID`. Throws on malformed input."
   :args {:string {:type :text :description "UUID in canonical 8-4-4-4-12 form."}}
   :return-type :uuid}

  ;; Form data parsing helpers
  {:name :parse-fn-from-form
   :description "Extract a fn entity's field map from a parsed form-data map."
   :args {:form-data {:type :_form-field-map :description "`{key value}` map from `parse-form-body`."}}
   :return-type :_entity-field-map}

  {:name :parse-ns-from-form
   :description "Extract a namespace entity's field map from a parsed form-data map. `:name` (string) is required; `:parent-id` and `:description` are optional. The form is the body of `POST /api/entities/ns` from the editor's `+` menu."
   :args {:form-data {:type :_form-field-map :description "`{key value}` map from `parse-form-body`."}}
   :return-type :_entity-field-map}

  {:name :parse-slot-from-form
   :description "Extract a slot entity's field map from a parsed form-data map. `:name` (string) is required on create; `:type-fn-id` (UUID), `:description`, `:required` are optional."
   :args {:form-data {:type :_form-field-map :description "`{key value}` map from `parse-form-body`."}}
   :return-type :_entity-field-map}

  {:name :parse-fn-slot-from-form
   :description "Extract a fn-slot junction's field map. `:fn-id` and `:slot-id` (UUIDs) are required; `:position` (int) is optional and defaults to 0."
   :args {:form-data {:type :_form-field-map :description "`{key value}` map from `parse-form-body`."}}
   :return-type :_entity-field-map}

  {:name :parse-binding-from-form
   :description "Extract a binding entity's field map. `:fn-id` and `:slot-id` (UUIDs) identify the slot being bound. Optional fields: `:value` (JSON literal), `:ref-fn-id` (UUID), `:rename-to` (string), `:type-override-fn-id` (UUID), `:description`, `:terminal`/`:list-append`/`:list-closed` (bool), `:override-kind` (`:fixed` / `:default`). Empty form values clear the corresponding column."
   :args {:form-data {:type :_form-field-map :description "`{key value}` map from `parse-form-body`."}}
   :return-type :_entity-field-map}

  {:name :parse-binding-list-item-from-form
   :description "Extract a binding-list-item field map. `:binding-id` (UUID) and `:position` (int) are required for create. The item carries either a `:value` (JSON literal) or a `:ref-fn-id` (UUID), plus an optional `:literal` boolean (true marks a keyword literal)."
   :args {:form-data {:type :_form-field-map :description "`{key value}` map from `parse-form-body`."}}
   :return-type :_entity-field-map}

  ;; =============================================================================
  ;; FN-DEFS: Response handlers composed from base functions
  ;;
  ;; Handlers are fn-graphs. At the route binding (:assoc-handler.value
  ;; → :fn-typed via :assoc-fn) the compiler hof-wrap's them into Ring
  ;; callables. Free arg `:request` propagates from inner refs (those
  ;; whose primary `:request` arg isn't bound here) up through the
  ;; chain; hof-wrap turns the leftover into a single-arg callable.
  ;; =============================================================================

  ;; --- JSON data handlers: a data-fn wrapped by the :json-handler
  ;; template (serialise → 200 application/json) ---

  ;; Template for JSON-rendering Ring handlers. Free arg `:data`
  ;; propagates up from `:to-json-string`, so concrete handlers below
  ;; set `:data :some-data-fn` directly instead of each defining its
  ;; own private `_*-body` fn-def.
  {:name :json-handler
   :description "Template Ring handler — serialises a value (free arg `:data`) to JSON and returns it as a 200 OK with `application/json` content-type."
   :parent :json-ok-response
   :args {:body :_json-handler-body}}

  {:name :_json-handler-body
   :parent :to-json-string}

  {:name :all-entities-handler
   :description "Ring handler that returns the full graph dump as JSON. Bound by `app.routes.api-entities`."
   :parent :json-handler
   :args {:data :list-all-graph-entities}}

  {:name :all-rich-types-handler
   :description "Ring handler for `GET /api/types` — returns the rich-type registry as JSON. Editor / external tools use it to know each slot's expected type without having to re-derive from EDN."
   :parent :json-handler
   :args {:data :all-rich-types}}

  {:name :value-kinds-handler
   :description "Ring handler for `GET /api/value-kinds` — returns the `value_kind` schema enum as a JSON array of primitive type-tag strings."
   :parent :json-handler
   :args {:data :value-kinds}}

  ;; --- type-API handlers — parse → validate → branch graphs. `:if`
  ;; over the validation result: the rejection IS the `{:ok false
  ;; :error}` payload (so `:then` reuses the validation ref), the clean
  ;; path runs the computation. ---
  {:name :types-compatible
   :description "POST /api/types/compatible — parse the JSON body `{expected, candidate}`, validate (both present), and on success run the subtype check. Returns `{:ok :expected :candidate :reason?}` or `{:ok false :error}`. The editor's fn-picker / mismatch explainers call this instead of duplicating `subtype?` in JS."
   :parent :if
   :args {:test :_rejected?
          :then :_types-compatible-validation
          :else :_types-compatible-apply
          :validation :_types-compatible-validation
          :parsed :_types-compatible-parsed}}

  {:name :types-candidates
   :description "POST /api/types/candidates — parse the JSON body `{expected, effects?, name-prefix?}`, validate (`expected` present), and on success enumerate fns whose return type is a subtype of `expected`. Returns `{:ok :expected :count :candidates}` or `{:ok false :error}`. Powers type-aware fn-pickers."
   :parent :if
   :args {:test :_rejected?
          :then :_types-candidates-validation
          :else :_types-candidates-apply
          :validation :_types-candidates-validation
          :parsed :_types-candidates-parsed}}

  {:name :types-usages
   :description "POST /api/types/usages — parse the JSON body `{type-fn-id}`, validate (valid UUID), and on success find every fn that references the type-row. Returns `{:ok :type-fn-id :type-name :count :usages}` or `{:ok false :error}`. Powers the editor's inline-expand 'Used by N' footer."
   :parent :if
   :args {:test :_rejected?
          :then :_types-usages-validation
          :else :_types-usages-apply
          :validation :_types-usages-validation
          :parsed :_types-usages-parsed}}

  {:name :types-compatible-handler
   :description "Ring handler for `POST /api/types/compatible` — wraps `:types-compatible` in a JSON 200 response."
   :parent :json-handler
   :args {:data :types-compatible}}

  {:name :types-candidates-handler
   :description "Ring handler for `POST /api/types/candidates` — wraps `:types-candidates` in a JSON 200 response."
   :parent :json-handler
   :args {:data :types-candidates}}

  {:name :types-usages-handler
   :description "Ring handler for `POST /api/types/usages` — wraps `:types-usages` in a JSON 200 response."
   :parent :json-handler
   :args {:data :types-usages}}

  {:name :types-create-record-handler
   :description "Ring handler for `POST /api/types/record` — atomic compound create for a record type-row. Wraps `process-create-record-type` in a JSON 200 response (the {:ok false :error} payload itself carries any error)."
   :parent :json-handler
   :args {:data :process-create-record-type}}

  {:name :types-create-list-handler
   :description "Ring handler for `POST /api/types/list` — atomic compound create for a list type-row."
   :parent :json-handler
   :args {:data :process-create-list-type}}

  {:name :types-update-record-handler
   :description "Ring handler for `PUT /api/types/record` — atomic compound update for a record type-row. Wraps `process-update-record-type` in a JSON 200 response (the {:ok false :error} payload carries failures)."
   :parent :json-handler
   :args {:data :process-update-record-type}}

  ;; --- Action handlers: action-fn returns partial response, defaults
  ;; (status 200, body "", html headers) supplied by composition. ---

  {:name :_html-action-base-headers
   :parent :const
   :args {:value {"Content-Type" "text/html; charset=utf-8"}}}

  {:name :_action-status
   :parent :get
   :args {:coll {:as :result} :key {:value :status} :default 200}}

  {:name :_action-body
   :parent :get
   :args {:coll {:as :result} :key {:value :body} :default ""}}

  {:name :_action-headers-raw
   :parent :get
   :args {:coll {:as :result} :key {:value :headers} :default {}}}

  {:name :_action-headers
   :parent :merge
   :args {:maps [:_html-action-base-headers :_action-headers-raw]}}

  {:name :html-action-response
   :description "Wrap a partial action response (`{:status :headers :body}` from a `process-*` fn) into a full Ring response, defaulting status=200, body=\"\", and html content-type."
   :parent :ring-response
   :args {:status :_action-status
          :headers :_action-headers
          :body :_action-body}}

  ;; --- entity create / update — parse → validate → branch graphs.
  ;; `:if` over the validation result: a rejection renders a 400, the
  ;; clean path runs the apply (write) stage. `:if` is lazy, so the
  ;; write runs only when validation passes. `validation` + `parsed`
  ;; are shared sub-results bound once at the `:if` fn-def. ---
  {:name :process-create-entity
   :description "POST /api/entities/:type — parse the request, run write-time validation, and on success create the entity (with post-create whole-fn type-check + rollback). Returns a partial Ring response."
   :parent :if
   :args {:test :_rejected?
          :then :_rejection-response
          :else :_create-apply
          :validation :_create-validation
          :parsed :_create-parsed}}

  {:name :process-update-entity
   :description "PUT /api/entities/:type/:id — parse the request, run write-time validation against the merged post-write view, and on success update the entity. Returns a partial Ring response."
   :parent :if
   :args {:test :_rejected?
          :then :_rejection-response
          :else :_update-apply
          :validation :_update-validation
          :parsed :_update-parsed}}

  ;; --- type-row compound handlers — parse → validate → branch graphs.
  ;; `:if` over the validation result: the rejection IS the
  ;; `{:ok false :error}` payload (so `:then` reuses the validation
  ;; ref), the clean path runs the transactional apply. `:if` is lazy,
  ;; so the multi-row write runs only when validation passes. ---
  {:name :process-create-record-type
   :description "POST /api/types/record — parse the JSON body `{namespace-id?, name, description?, fields:[…]}`, validate (name + ≥1 field), and on success atomically create the record type-row. Returns `{:ok true :id :name}` or `{:ok false :error}`."
   :parent :if
   :args {:test :_rejected?
          :then :_create-record-type-validation
          :else :_create-record-type-apply
          :validation :_create-record-type-validation
          :parsed :_create-record-type-parsed}}

  {:name :process-create-list-type
   :description "POST /api/types/list — parse the JSON body `{namespace-id?, name, description?, element-type}`, validate (name + element-type), and on success atomically create the list type-row. Returns `{:ok true :id :name}` or `{:ok false :error}`."
   :parent :if
   :args {:test :_rejected?
          :then :_create-list-type-validation
          :else :_create-list-type-apply
          :validation :_create-list-type-validation
          :parsed :_create-list-type-parsed}}

  {:name :process-update-record-type
   :description "PUT /api/types/record — parse the JSON body `{id, name?, description?, fields:[…]}`, validate (id + ≥1 field + the fn-row exists), and on success atomically apply the field diff (journalled rollback). Returns `{:ok true :id :name}` or `{:ok false :error}`."
   :parent :if
   :args {:test :_rejected?
          :then :_update-record-type-validation
          :else :_update-record-type-apply
          :validation :_update-record-type-validation
          :parsed :_update-record-type-parsed}}

  {:name :create-entity-handler
   :description "Ring handler for `POST /api/entities/:type` — runs `process-create-entity` and wraps the result via `html-action-response`."
   :parent :html-action-response
   :args {:result :process-create-entity}}

  {:name :update-entity-handler
   :description "Ring handler for `PUT /api/entities/:type/:id` — runs `process-update-entity` and wraps the result via `html-action-response`."
   :parent :html-action-response
   :args {:result :process-update-entity}}

  {:name :delete-entity-handler
   :description "Ring handler for `DELETE /api/entities/:type/:id` — runs `process-delete-entity` and wraps the result via `html-action-response`."
   :parent :html-action-response
   :args {:result :process-delete-entity}}

  {:name :sequence-append-handler
   :description "Ring handler for `POST /api/sequence/append/:fn-id` — appends an item to the named sequence-arg."
   :parent :html-action-response
   :args {:result :process-sequence-append}}

  {:name :sequence-remove-handler
   :description "Ring handler for `DELETE /api/sequence/item/:item-id` — removes an item from its sequence-arg."
   :parent :html-action-response
   :args {:result :process-sequence-remove}}

  {:name :sequence-update-handler
   :description "Ring handler for `PUT /api/sequence/item/:item-id` — replaces an item's value/ref."
   :parent :html-action-response
   :args {:result :process-sequence-update}}

  ;; =============================================================================
  ;; FN-DEFS: tighten-fn-effects — validation chain as a :cond graph
  ;;
  ;; The handler is a `:cond`: each clause is a `[predicate 400-response]`
  ;; pair, the `:else` clause runs `:_tighten-apply` (the DB write). The
  ;; executor is lazy — `:cond` forces a clause's test but never an
  ;; un-taken clause's result — so the write runs solely when every
  ;; guard passes. `parsed` is one shared `:_tighten-parsed`, bound at
  ;; the `:cond` fn-def — the free arg every clause's predicate exposes.
  ;; =============================================================================

  {:name :_tighten-err-binding-id
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 400 :body "<p class=\"error\">Invalid binding-id</p>"}}}

  {:name :_tighten-err-effects
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 400 :body "<p class=\"error\">'effects' must be a JSON array</p>"}}}

  {:name :_tighten-err-args
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 400 :body "<p class=\"error\">'args' must be a JSON object</p>"}}}

  {:name :_tighten-err-delta
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 400 :body "<p class=\"error\">Body must include at least one of args / ret / effects</p>"}}}

  {:name :process-tighten-binding-effects
   :description "POST /api/bindings/:binding-id/tighten-fn-effects — narrow an fn-typed binding's effective type. The four validation guards and the success path are a flat `:cond` — alternating `[predicate 400-response]`, ending with `true → :_tighten-apply`. `:cond` is lazy, so the DB write runs only when every guard passes. Returns a partial Ring response."
   :parent :cond
   :args {:clauses [:_tighten-binding-id-invalid? :_tighten-err-binding-id
                    :_tighten-effects-invalid?    :_tighten-err-effects
                    :_tighten-args-invalid?       :_tighten-err-args
                    :_tighten-delta-empty?        :_tighten-err-delta
                    {:value true}                 :_tighten-apply]
          :parsed :_tighten-parsed}}

  {:name :tighten-binding-effects-handler
   :description "Ring handler for `POST /api/bindings/:binding-id/tighten-fn-effects` — narrow an fn-typed binding's effective type."
   :parent :html-action-response
   :args {:result :process-tighten-binding-effects}}]}
