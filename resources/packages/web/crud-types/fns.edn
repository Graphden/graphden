  ;; and rollback see the same instance. Phases 2-5 + invalidate +
  ;; success live inside `:_apply-update-record-type-body` (one Clojure
  ;; helper — atomic-or-rolled-back is one concept per skill §3 §1);
  ;; cleanup lives inside `:_apply-update-record-type-rollback`. ---

  {:name :_apply-update-record-type-journal
   :description "Fresh atom-of-vector to collect rollback entries. Referenced from `:_update-record-type-apply` at the `:try`-call site (extra `:journal` binding); body and on-throw both see the same instance via wrap-time-capture."
   :parent :atom
   :args {:initial-value {:value []}}}

  {:name :_apply-update-record-type-body
   :description "Phases 2-5 + invalidate + success of update-record-type-apply. Mutates `:journal` for rollback hints; throws on storage/type-resolve failure (caught by `:try`)."
   :args {:parsed {:type :_update-record-type-parsed-shape :description "Output of `:_update-record-type-parsed`."}
          :journal {:type :any :description "Shared rollback-journal atom (captured from `:_update-record-type-apply`'s `:journal` binding at wrap time)."}}
   :return-type :_type-row-result-shape
   :effects #{:db}}

  {:name :_apply-update-record-type-rollback
   :description "`:try`'s on-throw branch — derefs `:journal` and replays entries in reverse. Returns the partial 400 response carrying the exception's message + ex-data. Both `:journal` (captured) and `:exception` (call-time) come from `:try`'s environment."
   :args {:journal {:type :any :description "Shared rollback-journal atom (captured from `:_update-record-type-apply`'s `:journal` binding)."}
          :exception {:type :any :description "Caught Exception, provided by `:try` at call time as the single lambda-param."}}
   :return-type :_error-result-shape
   :effects #{:db}}

  {:name :_update-record-type-apply
   :description "Stage 3 of update-record-type — `:try` over a shared `:atom` journal. Body runs phases 2-5 + invalidate + success; on-throw runs rollback. Returns `{:ok true :id :name}` on success or `{:ok false :error :data}` on rollback. `:journal` is an extra binding at the `:try`-call site (synthetic slot owned by `:try`); HOF wrap-time-capture treats it as a captured env-binding for both `:body` and `:on-throw` callables, so they share one atom instance per request. Caveat: orphaned slots are NOT garbage-collected (slot rows are shared)."
   :parent :try
   :args {:body :_apply-update-record-type-body
          :on-throw :_apply-update-record-type-rollback
          :journal :_apply-update-record-type-journal
