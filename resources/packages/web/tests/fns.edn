;; web.tests — the platform's own self-tests for the `web` package's
;; fn-defs. Ordinary fn-defs in a `tests` namespace (docs/TESTS.md):
;; every non-`_` fn here is a test, runs with `{}` args, and passes
;; when it does not throw. `_wt-`-prefixed fns are scaffolding.
;;
;; Everything here is PURE — no subject carries a :db / :network /
;; :time / :env / :vault effect — so the suite auto-runs on writes
;; that reach these fn-defs and never needs a live system.
;;
;; Verified live through /mcp before landing (run-tests: failed=0,
;; other=0). Things deliberately NOT covered, with the reason:
;;   * `:parse-fn-from-form` — its closure carries `:resolve-type-fn-id`
;;     (`:db`), so it is not a pure subject.
;;   * `:service-url` (`:service-endpoint` is `:db`), `:response-cache-get`
;;     (cell-backed), `:proceed` (needs a middleware chain),
;;     `:types-compatible` (reads the registry), `:encode-response`
;;     (its `:request` does not reach the negotiation when bound on a
;;     child — free-args surface shows `[unencoded-response default]`),
;;     the http-client templates (`:network`), and the type rows
;;     (`:script-tag` / `:style-tag` / `:hx-swap-mode` /
;;     `:security-headers-shape` / `:service-endpoint-shape`).
;;   * `:card` / `:link` / `:image` / `:stack` / `:row` / `:checkbox`
;;     and `:r405` — see the note at the components section.

{:namespace "web.tests"
 :description "Platform self-tests for web: hiccup/html scaffolding, htmx attrs builders, the response matrix, the starter components, ring-adapter helpers and wraps, request parsing, and the JSON/HTML response builders."
 :fns
 [;; =========================================================================
  ;; Scaffolding (private, `_wt-` prefixed — not tests).
  ;; =========================================================================

  ;; A Ring response reduced to the four facts every response test pins:
  ;; `[status content-type cache-control body]`. Header keys are keywords
  ;; at runtime — the content-type fn-defs bind them as JSONB literals and
  ;; the `:http-server` adapter stringifies once on the way to http-kit.
  {:name :_wt-resp-sig
   :description "Signature of a Ring response — `[status Content-Type Cache-Control body]` — so a response test pins both axes and the body with one literal vector."
   :parent :vec
   :args {:coll [{:parent :get :args {:coll {:as :resp} :key {:value :status} :default nil}}
                 {:parent :get-in :args {:map {:as :resp} :path [{:value :headers} {:value :Content-Type}] :default nil}}
                 {:parent :get-in :args {:map {:as :resp} :path [{:value :headers} {:value :Cache-Control}] :default nil}}
                 {:parent :get :args {:coll {:as :resp} :key {:value :body} :default nil}}]
          :resp {:type [:map :any :any] :description "The Ring response under test. Typed as a plain map, not `:ring-response-shape`: a response built inline computes `:status :int`, which cannot be proved to satisfy the shape's `[:refine :int [:and [:>= 100] [:<= 599]]]`, and this helper only reads three keys."}}}

  ;; Ring handlers for the wrap tests. A handler that ignores the request
  ;; declares `:lambda-params []`; one that reads it declares `[:request]`.
  {:name :_wt-const-handler
   :description "Handler that answers 200 text/plain \"ok\" to any request."
   :lambda-params []
   :parent :text-ok-response
   :args {:body "ok"}}

  {:name :_wt-xfo-handler
   :description "Handler that sets its own `X-Frame-Options` — the header `:secure-headers-wrap` must NOT overwrite."
   :lambda-params []
   :parent :ok-response
   :args {:body "ok" :headers {"X-Frame-Options" "SAMEORIGIN"}}}

  {:name :_wt-echo-body-handler
   :description "Handler that echoes the request's `:body` as a text/plain 200."
   :lambda-params [:request]
   :parent :text-ok-response
   :args {:body {:parent :get :args {:coll {:as :request} :key {:value :body} :default ""}}}}

  {:name :_wt-ring-request
   :description "A full `:ring-request-shape` literal (every field present) for the wraps whose `:request` slot is nominally typed."
   :parent :const
   :args {:value {:request-method :get :uri "/" :query-string "" :headers {} :body "raw" :async-channel nil}}}

  ;; `:uri-segment-after` reads only `:uri`, but its slot is the full
  ;; `:ring-request-shape` record — a partial literal is a type error at
  ;; sync time (the sweep, not the runtime). Each URI under test gets a
  ;; complete request; `:const` carries the literal, as `:_wt-ring-request`
  ;; above does.
  {:name :_wt-request-uri-segment
   :description "Full Ring request for `/api/secrets/abc` — the marker `secrets` has a segment after it."
   :parent :const
   :args {:value {:request-method :get :uri "/api/secrets/abc" :query-string ""
                  :headers {} :body "" :async-channel nil}}}

  {:name :_wt-request-uri-marker-last
   :description "Full Ring request for `/api/secrets` — the marker is the last segment."
   :parent :const
   :args {:value {:request-method :get :uri "/api/secrets" :query-string ""
                  :headers {} :body "" :async-channel nil}}}

  {:name :_wt-request-uri-no-marker
   :description "Full Ring request for `/api/x` — the marker never appears."
   :parent :const
   :args {:value {:request-method :get :uri "/api/x" :query-string ""
                  :headers {} :body "" :async-channel nil}}}

  ;; Requests with STRING header keys (as http-kit delivers them). A
  ;; literal map would keywordize through the JSONB roundtrip, so the
  ;; header map is built at runtime with `:zipmap`.
  {:name :_wt-form-request
   :description "Ring request carrying an `application/x-www-form-urlencoded` body `a=1&b=x+y`."
   :parent :zipmap
   :args {:keys [{:value :headers} {:value :body}]
          :vals [{:parent :zipmap :args {:keys [{:value "content-type"}] :vals [{:value "application/x-www-form-urlencoded"}]}}
                 {:value "a=1&b=x+y"}]}}

  {:name :_wt-json-request
   :description "Ring request carrying an `application/json` body `{\"name\":\"foo\",\"n\":[1,2]}`."
   :parent :zipmap
   :args {:keys [{:value :headers} {:value :body}]
          :vals [{:parent :zipmap :args {:keys [{:value "content-type"}] :vals [{:value "application/json; charset=utf-8"}]}}
                 {:value "{\"name\":\"foo\",\"n\":[1,2]}"}]}}

  {:name :_wt-r404-router
   :description "A `:r404` router with no routes — every request falls through to the 404 slot."
   :parent :r404
   :args {:routes []
          :method-not-allowed-response {:parent :text-method-not-allowed-response :args {:body "mna"}}
          :error-response {:parent :text-error-response :args {:body "err"}}}}

  {:name :_wt-page-with-assets
   :description "An `:html-page` with one `<style>` in head and one `<script>` at the end of body, both carrying characters that HTML-escaping would mangle."
   :parent :html-page
   :args {:title "T"
          :body {:value ["p" "x"]}
          :head [{:parent :wrap-style :args {:content "b{}"}}]
          :scripts [{:parent :wrap-script :args {:content "1<2"}}]}}

