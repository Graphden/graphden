;; Reusable Ring-request handler pipeline.
;;
;; The exported root `:request-handler` builds a Ring request handler that:
;;   1. Receives a raw Ring request (free arg, `value/as :request`).
;;   2. Extracts common fields (method/uri/query-string/headers/body) into
;;      an internal map via `:pairs->map`.
;;   3. Invokes a router (free arg `:func`) on that internal request.
;;   4. Wraps the router result in a ring-response with default security
;;      headers merged in.
;;   5. Gates protected paths (/api/entities, /api/sequence) behind a Bearer
;;      token pulled from the AUTH_TOKEN env var.
;;
;; Consumers supply the concrete router via `:func` (bound on a child of
;; `:path-gated-response` which they then pass to `:request-handler` as
;; `:response-fn`). Other parts of the pipeline (AUTH_TOKEN env var, the two
;; protected prefixes, standard security headers) are opinionated defaults —
;; override by building from the same lower-level pieces.


{:namespace "web.ring-adapter"
 :fns
 [;; =============================================================================
  ;; RING REQUEST EXTRACTION
  ;; =============================================================================

  ;; Single holder for the Ring request. All field extractors reference this
  ;; one fn so the same request value flows into each `get`. The rename
  ;; `value/as :request` exposes it as a free arg named `:request` — but its
  ;; ROOT name (walking source-id chain) is still `:value`, which is what
  ;; `make-single-arg-callable` binds.
  {:name :ring-request
   :parent :identity
   :args {:value {:as :request}}}

  ;; Shared `:coll :ring-request` lookup — factor out the common binding so
  ;; each field extractor below just names the key it wants.
  {:name :ring-request-field
   :parent :get
   :args {:coll :ring-request}}

  {:name :ring-method-kw
   :parent :ring-request-field
   :args {:key {:value :request-method}}}

  {:name :ring-method
   :parent :keyword-to-str
   :args {:keyword :ring-method-kw}}

  {:name :ring-uri
   :parent :ring-request-field
   :args {:key {:value :uri}}}

  {:name :ring-query-string
   :parent :ring-request-field
   :args {:key {:value :query-string}}}

  {:name :ring-headers
   :parent :ring-request-field
   :args {:key {:value :headers}}}

  {:name :ring-body-input-stream
   :parent :ring-request-field
   :args {:key {:value :body}}}

  {:name :ring-body
   :parent :slurp
   :args {:input :ring-body-input-stream}}

  ;; =============================================================================
  ;; INTERNAL REQUEST SHAPE — one :pairs->map with 5 pair entries.
  ;; =============================================================================

  {:name :ring-method-entry
   :parent :pair
   :args {:item1 {:value :method} :item2 :ring-method}}

  {:name :ring-uri-entry
   :parent :pair
   :args {:item1 {:value :uri} :item2 :ring-uri}}

  {:name :ring-query-string-entry
   :parent :pair
   :args {:item1 {:value :query-string} :item2 :ring-query-string}}

  {:name :ring-headers-entry
   :parent :pair
   :args {:item1 {:value :headers} :item2 :ring-headers}}

  {:name :ring-body-entry
   :parent :pair
   :args {:item1 {:value :body} :item2 :ring-body}}

  {:name :internal-request
   :parent :pairs->map
   :args {:entries [:ring-method-entry
                    :ring-uri-entry
                    :ring-query-string-entry
                    :ring-headers-entry
                    :ring-body-entry]}}

  ;; =============================================================================
  ;; ROUTER INVOCATION + RESPONSE EXTRACTION
  ;; `:func` is a FREE arg — the consuming fn binds it to a concrete router
  ;; fn-def (e.g. `:_router`). `:arg` is bound to the extracted internal
  ;; request so every router call receives the same shape.
  ;; =============================================================================

  {:name :router-result
   :parent :invoke
   :args {:arg :internal-request}}

  ;; Shared `:coll :router-result` lookup — same factoring pattern as
  ;; `:ring-request-field` above. Subclasses only declare which field (and
  ;; their fallback default) they want.
  {:name :router-result-field
   :parent :get
   :args {:coll :router-result}}

  {:name :router-response-status
   :parent :router-result-field
   :args {:key {:value :status} :default 200}}

  {:name :router-response-headers
   :parent :router-result-field
   :args {:key {:value :headers} :default {}}}

  {:name :router-response-body
   :parent :router-result-field
   :args {:key {:value :body} :default ""}}

  ;; Opinionated default security headers — merged into every response.
  {:name :default-security-headers
   :parent :const
   :args {:value {"X-Content-Type-Options" "nosniff"
                  "X-Frame-Options" "DENY"
                  "X-XSS-Protection" "1; mode=block"
                  "Referrer-Policy" "strict-origin-when-cross-origin"}}}

  ;; Ring response built from router-result + merged headers. Both auth
  ;; branches (protected+valid and unprotected) of `path-gated-response`
  ;; ultimately need THIS exact response; wrapping each branch in its own
  ;; `_unprotected-response` / `_authenticated-response` child added zero
  ;; bindings and just doubled the subtree in the editor view. Lazy `:if`
  ;; already computes only the chosen branch, so sharing the fn-id is safe.
  ;;
  ;; Structural split: `merged-response-headers` preloads default security
  ;; headers on top of `merge2`; `router-ring-response` inherits those
  ;; (+ a fixed `:status`) via `_router-ring-response-envelope` so the
  ;; editor-visible level of `router-ring-response` shows only the body
  ;; binding (the slot that carries the actual router computation).

  {:name :merged-response-headers
   :parent :merge2
   :args {:a :default-security-headers
          :b :router-response-headers}}

  {:name :_router-ring-response-envelope
   :parent :ring-response
   :args {:status :router-response-status
          :headers :merged-response-headers}}

  {:name :router-ring-response
   :parent :_router-ring-response-envelope
   :args {:body :router-response-body}}

  ;; =============================================================================
  ;; AUTH — Bearer token primitives (opinionated defaults)
  ;; =============================================================================

  {:name :auth-token-from-env
   :parent :env
   :args {:name "AUTH_TOKEN"}}

  ;; Missing `Authorization` header → `get` returns nil; downstream
  ;; `has-bearer-prefix?` is nil-safe (returns false), so no default
  ;; needed here. Keeps the node free of literal-default clutter.
  {:name :authorization-header
   :parent :get
   :args {:coll :ring-headers :key "authorization"}}

  {:name :has-bearer-prefix?
   :parent :str-starts-with?
   :args {:string :authorization-header :prefix "Bearer "}}

  {:name :bearer-token-raw
   :parent :subs
   :args {:string :authorization-header :start 7}}

  {:name :bearer-token
   :parent :if
   :args {:test :has-bearer-prefix? :then :bearer-token-raw :else nil}}

  {:name :token-valid?
   :parent :equal?
   :args {:a :bearer-token :b :auth-token-from-env}}

  ;; 401 response used by auth middleware on failure.
  {:name :_default-auth-fail-body
   :parent :ring-response
   :args {:status 401
          :headers {"Content-Type" "text/plain"}}}

  {:name :default-auth-fail-response
   :parent :_default-auth-fail-body
   :args {:body "Unauthorized"}}

  ;; =============================================================================
  ;; AUTH MIDDLEWARE
  ;; Body is a Ring-shaped fn-graph: if token valid → proceed to the next
  ;; handler in the middleware chain, else return the 401 response
  ;; directly. Attached to protected routes via `:middleware
  ;; [:auth-required-middleware]` in the route's method-data. No pre-router
  ;; path-gating layer — the router reads route-data once, runs the chain,
  ;; dispatches.
  ;; =============================================================================

  {:name :_auth-required-body
   :parent :if
   :args {:test :token-valid?
          :then :proceed
          :else :default-auth-fail-response}}

  {:name :auth-required-middleware
   :parent :middleware
   :args {:name {:value :auth-required}
          :body :_auth-required-body}}

  ;; =============================================================================
  ;; ENTRY POINT
  ;; The consumer binds a router fn-graph (usually wrapped into
  ;; `:router-ring-response`) directly to the web server's `:handler` slot.
  ;; `:handler` is declared `:fn`-type on `:http-server`, so compile's
  ;; hof-wrap turns the fn-graph into a Ring callable automatically.
  ;; =============================================================================
  ]}
