  {:name :_auth-form-html
   :parent :render-hiccup
   :args {:hiccup :_auth-form-fields}}

  {:name :_partial-auth-form-handler
   ;; [] — the popover fields are STATIC markup; the old [:children] param
   ;; (a leaked free from the unpinned inputs) made the 1-arg shape-callable
   ;; drop the whole ring request into :children — rendered INSIDE the
   ;; inputs as garbage (<request-method>…, the reitit router object).
   :lambda-params []
   :description "Ring handler for GET /partials/auth-form — the login/signup popover fields as text/html. Unauthenticated (it IS the login form). editor-auth.js mounts it into #auth-popover on first open."
   :parent :html-ok-response
   :args {:body :_auth-form-html}}


  ;; Concrete editor routes (`/`, `/favicon.ico`, `/partials/...`,
  ;; `/api/entities/...`, `/api/sequence/...`) live in `app.routes`;
  ;; they reference the handler fn-defs above by name.
  ]}
