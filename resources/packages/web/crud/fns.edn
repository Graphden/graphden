;; Storage CRUD base functions for web UI.
;; Impls that need storage access read it from `ctx` in their body
;; (see the matching `impls.clj` in each module directory).
;;
;; ONE NAMESPACE, SEVEN MODULES. Every `web/crud*` module declares
;; `:namespace "web.crud"`, so all of these fn-defs live in the same
;; graph namespace and keep the same ids — a fn-id is
;; `uuid5(namespace, name)`, and nothing here renames anything. The split
;; is purely so the file a reader opens is about one thing:
;;
;;   crud          shapes + the primitives the rest compose over  (this file)
;;   crud-types    the type API and type-row compounds
;;   crud-write    entity create / update
;;   crud-delete   entity delete + the reverse-reference scans
;;   crud-seq      sequence bindings + tighten
;;   crud-parse    request-body parsing
;;   crud-routes   the handler graphs the router points at
;;
;; Cross-module references need nothing special: refs resolve by name
;; across the whole loaded set, exactly as they did in one file.
;; (Precedent: `app.editor` has been seven modules for a while.)


{:namespace "web.crud"
 :description "Storage CRUD vocabulary — result / rejection shapes, the open-map types, and the graph-lookup primitives the other `web.crud` modules compose over."
 :fns
 [;; ---------------------------------------------------------------------
  ;; Parse-stage output shapes. Each `_*-parsed` base-fn returns a
  ;; record of a known shape; naming it lets the matching validate /
  ;; apply stages declare `:parsed` as that record instead of bare
  ;; `:jsonb`. `_`-prefixed — internal to one handler triple each.
  ;; ---------------------------------------------------------------------

  {:name :_types-compatible-parsed-shape
   :description "Output of `:_types-compatible-parsed` — the two type expressions to subtype-check."
   :type {:expected :type-expression
          :candidate :type-expression}}

  {:name :_types-candidates-parsed-shape
   :description "Output of `:_types-candidates-parsed` — the target type plus optional effect-set / name-prefix filters. `:allowed-effects` and `:name-prefix` are nullable (caller may omit either) — `:_types-candidates-apply` treats nil as 'no filter'."
   :type {:expected :type-expression
          :allowed-effects [:union :null [:list [:union :keyword :null]]]
          :name-prefix :nullable-text}}

  {:name :_types-usages-parsed-shape
   :description "Output of `:_types-usages-parsed` — the type-row id to search references for. `:target-id` is nullable to match the parse stage's `(when raw (try uuid-parse ...))` semantics; the downstream validation guard catches the nil case."
   :type {:target-id :nullable-uuid :root-id :nullable-uuid}}

  {:name :_create-record-type-parsed-shape
   :description "Output of `:_create-record-type-parsed` — a record type-row's name, owning namespace, description and field list. `:name`/`:ns-id` are nullable post-parse; `:description` is loosely-typed (the JSON body may carry non-string descriptions); `:fields` is the per-field record list (`:vec` of the body's `:fields` value)."
   :type {:name :nullable-text :ns-id :nullable-uuid :description :jsonb :fields [:list :any]}}

  {:name :_create-list-type-parsed-shape
   :description "Output of `:_create-list-type-parsed` — a list type-row's name, owning namespace, description and element-type reference. Nullable shape mirrors `:_create-record-type-parsed-shape`'s tolerant parse."
   :type {:name :nullable-text :ns-id :nullable-uuid :description :jsonb :element-ref :jsonb}}

  {:name :_update-record-type-parsed-shape
   :description "Output of `:_update-record-type-parsed` — the target fn-id plus the submitted name / description / field list. `:has-description?` distinguishes a submitted-nil description from an absent key. `:name` nullable text; `:description` loosely-typed; `:fields` is the per-field record list (`:vec` of the body's `:fields` value). The validation guard catches the missing-fn-id / blank-name cases downstream."
   :type {:fn-id :nullable-uuid :name :nullable-text :has-description? :bool :description :jsonb :fields [:list :any]}}

  {:name :_create-parsed-shape
   :description "Output of `:_create-parsed` — the URI entity-type, the form-decoded body, the per-type-parsed entity field map, and a `:parse-error` string set when the per-type parser threw."
   :type {:entity-type :keyword :type-str :text :form-data :keyword-map :entity-data :keyword-map :parse-error :text}}

  {:name :_update-parsed-shape
   :description "Output of `:_update-parsed` — like `:_create-parsed-shape` plus the `:id` URI segment (`:id-str` / `:id-uuid`) and `:pre-existing`, the pre-read of the row being updated."
   :type {:entity-type :keyword :type-str :text :id-str :text :id-uuid :uuid :form-data :keyword-map :pre-existing :keyword-map :entity-data :keyword-map :parse-error :text}}

  {:name :_delete-parsed-shape
   :description "Output of `:_delete-parsed` — the URI entity-type and the parsed UUID. Validation downstream rejects unknown entity-type / malformed id, so the apply-flow sees them as non-null at runtime; the type asserts that post-validation invariant."
   :type {:entity-type :keyword :id :uuid}}

  {:name :_tighten-parsed-shape
   :description "Output of `:_tighten-parsed` — the target binding-id and the raw `effects` / `args` / `ret` body components plus the assembled `:delta` map."
   :type {:binding-id :uuid :effects-val :jsonb :args-val :jsonb :ret-val :jsonb :delta :jsonb}}

  ;; Sequence-write parsed-shape aliases: each of the four
  ;; consumers (load + try-apply, both append + update) declared the
  ;; same record-shape inline. Naming them as type-rows lets the
  ;; consumer slot read at the contract level instead of restating
  ;; the structural shape every time.
  {:name :_seq-append-parsed-shape
   :description "Output of `:_seq-append-parsed` — `{:fn-id <uuid|nil> :body <json-or-nil>}`."
   :type {:fn-id :nullable-uuid :body :nullable-jsonb}}

  {:name :_seq-update-parsed-shape
   :description "Output of `:_seq-update-parsed` — `{:item-id <uuid|nil> :body <json-or-nil>}`."
   :type {:item-id :nullable-uuid :body :nullable-jsonb}}

  ;; A write-time validation rejection. The `_*-validation` stages
  ;; return this when a guard fails (or nil when the request passes);
  ;; `_rejection-response` renders the `:reason` into a 400.
  {:name :_rejection-shape
   :description "A write-time validation rejection — `_rejection-response` renders `:reason` into a 400 partial response."
   :type {:reason :text}}

  ;; --- handler RESULT shapes — the JSON payloads the type-API /
  ;; type-row stages return (distinct from `_rejection-shape`, the
  ;; entity-CRUD `{:reason}` rejection). ---

  {:name :error-result-with-reason-shape
   :description "Variant of `:error-result-shape` carrying an additional `:reason` keyword tag — used by guards whose downstream consumer needs to discriminate (e.g. UI distinguishing `:missing-binding` vs `:binding-exists` to wire different recovery paths)."
   :type {:ok :bool :error :text :reason :keyword}}

  {:name :error-result-shape
   :description "The `{:ok false :error}` rejection payload returned by every type-API / type-row / value-form validation stage."
   :type {:ok :bool :error :text}}

  {:name :error-result-status-shape
   :description "`:error-result-shape` plus the `:http-status` the envelope-response seam reads (web.errors/:json-envelope-response) — rejection builders that declare their HTTP status pin to this."
   :type {:ok :bool :error :text :http-status :int}}

  {:name :_types-compatible-result-shape
   :description "Output of `:_types-compatible-apply` — the subtype-check verdict. An extra `:reason` is present when not ok (open-record — extra fields are fine)."
   :type {:ok :bool :expected :type-expression :candidate :type-expression}}

  {:name :_types-candidates-result-shape
   :description "Output of `:_types-candidates-apply` — the enumeration of fns whose return type is a subtype of `expected`."
   :type {:ok :bool :expected :type-expression :count :non-negative-int :candidates [:list :any]}}

  {:name :_types-usage-summary-shape
   :type {:fn-id :text :fn-name :text :role [:union :null :keyword] :kind :keyword}}
  {:name :_types-usage-summaries :list :_types-usage-summary-shape}
  {:name :_types-usage-reachability-shape
   :type {:state :keyword :scope :keyword :origin [:union :null :keyword]
          :roots :_types-usage-summaries :path :_types-usage-summaries}}
  {:name :_types-usages-result-shape
   :description "Output of `:_types-usages-apply` — every reference to the target type-row. `:type-fn-id` is the id stringified."
   :type {:ok :bool :type-fn-id :text :type-name :nullable-text :count :non-negative-int
          :truncated? :bool :usages :_types-usage-summaries :reachability :_types-usage-reachability-shape}}

  {:name :_id-name-result-shape
   :description "The success payload of a type-row create / update — the new row's id (stringified) and name."
   :type {:ok :bool :id :text :name :text}}

  {:name :_type-row-result-shape
   :description "What a type-row create / update apply stage returns — the success payload, or an `{:ok false :error}` map when the transactional write failed."
   :union [:_id-name-result-shape :error-result-shape]}

  {:name :_partial-response-shape
   :description "A partial Ring response from a `process-*` / `_*-apply` stage — `:status` + `:body`, optionally `:headers` (open-record). `html-action-response` wraps it into a full response, defaulting any missing field."
   :type {:status :int :body :text}}

  ;; --- shared rejection envelopes — identical literal payloads,
  ;; shared instead of duplicated per-endpoint. Documentation
  ;; of WHICH endpoint hits WHICH guard lives in the predicate name on
  ;; the cond clause line, not on a per-endpoint copy of the envelope.

  {:name :_err-name-required
   :description "JSON 400 rejection — `:name` field missing or blank. Shared between create-record-type + create-list-type endpoints."
   :parent :const
   :return-type :error-result-shape
   :args {:value {:ok false :error "name required"}}}

  {:name :_err-fields-required
   :description "JSON 400 rejection — `:fields` list empty. Shared between create-record-type + update-record-type endpoints."
   :parent :const
   :return-type :error-result-shape
   :args {:value {:ok false :error "fields required (a record needs ≥1 field)"}}}

  {:name :_html-err-invalid-body
   :description "HTML 400 partial response — JSON body required. Shared between seq-append + seq-update."
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 400 :body "<p class=\"error\">JSON body required</p>"}}}

  {:name :_html-err-invalid-item-id
   :description "HTML 400 partial response — item-id malformed. Shared between seq-remove + seq-update."
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 400 :body "<p class=\"error\">Invalid item-id</p>"}}}

  {:name :_html-err-item-not-found
   :description "HTML 404 partial response — item-id resolved to no row. Shared between seq-remove + seq-update."
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 404 :body "<p class=\"error\">Item not found</p>"}}}

  {:name :err-name-blank
   :description "JSON 400 rejection — required `:name` field missing. Shared admin-CRUD envelope used by create-secret + create-branch."
   :parent :const
   :return-type :error-result-shape
   :args {:value {:ok false :error "Required field ':name' is missing"}}}

  {:name :_parsed-body
   :description "Shared `:parse-json-body` wrap for every type-API / type-row stage1. call-cache dedupes per (fn, env), so cross-endpoint requests never collide."
   :parent :parse-json-body
   :args {:request {:as :request :type :ring-request-shape :description "Internal Ring request map."}}}

  ;; --- open-map shapes — `[:map K V]` typed maps, replacing bare
  ;; `:jsonb` where the key / value domains ARE known. ---

  {:name :_storage-where-map
   :description "A storage query filter — `{column-keyword → match-value}`. Keys are entity column names; values arbitrary."
   :map {:key :keyword :value :any}}

  {:name :_form-data-shape
   :description "Pre-parser form payload: `{field-name field-value}` keyed by FORM field name (string-or-keyword post JSONB-roundtrip). Wider than `:keyword-map` — covers the wire layer where keys may still be strings."
   :map {:key :keyword-or-text :value :any}}

  ;; Query functions (context-aware)
  {:name :get-entity
   :description "Look up a single entity by id."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :id {:type :uuid :description "Entity UUID."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :delete-entity
   :description "Delete an entity by id. With versioned storage this is a soft-delete; the base row persists."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :id {:type :uuid :description "Entity UUID to delete."}}
   :return-type :bool
   :effects #{:db}}

  {:name :revive-entity
   :description "Undo a soft delete: re-create the version a user-facing delete tombstoned on this branch (from the tombstone's own data), invalidate and notify like a create. Returns the live row, or nil when nothing was tombstoned to revive — already live, never existed, or purged by the tombstone GC."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :id {:type :uuid :description "Entity UUID to revive."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :query-entities
   :description "Every entity of `:entity-type` matching the `:where` filter, as decoded entity maps. One `crud.entities/list-entities` protocol call. The `:where {:required false :value {}}` default is load-bearing — an unbound optional map slot would leak caller context into the filter."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :where {:type :_storage-where-map :value {}
                  :description "Column-match filter — `{column-keyword value}`. Defaults to `{}` (all rows)."}}
   :return-type [:list :keyword-map]
   :effects #{:db}}

  {:name :create-entity
   :description "Create an entity through the full CRUD write unit (`crud.entities/create-entity`): write-time validation, graph-cache delta invalidation, cross-pod NOTIFY. Sibling of `:get-entity` / `:delete-entity`."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :data {:type :keyword-map :description "Entity row data (keyword keys)."}}
   :return-type :keyword-map
   :effects #{:db}}

  {:name :update-entity
   :description "Update an entity by id through the full CRUD write unit (`crud.entities/update-entity`): validation, delta invalidation, NOTIFY."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :id {:type :uuid :description "Entity UUID."}
          :data {:type :keyword-map :description "Fields to set (keyword keys)."}}
   :return-type :keyword-map
   :effects #{:db}}

  ;; --- :free-arg-slot-map — atomic graph-lookup primitive. Returns
  ;; `{arg-name → slot-id}` for the fn's free args, BFS'd over the
  ;; inheritance chain + transitive captured-args of referenced
  ;; fn-graphs. Returns `{}` for nil fn-id.
  ;;
  ;; The traversal itself is a graph-algorithm-with-invariant (cycle-
  ;; tracking shared state) and stays inside the Clojure primitive
  ;; (§3.3 carve-out). User-composable extension: a custom validator
  ;; can call `:free-arg-slot-map` then layer additional filtering
  ;; (e.g. drop args matching a deprecation marker) at the graph layer.
  ;;
  ;; Used by both `:_create-service-free-args-rej` (CRUD-write
  ;; validation) and `:_execute-unknown-arg-err` (execute-time
  ;; validation); kept in `web/crud` so both call sites see it
  ;; without forcing a downstream-package dependency.
  {:name :free-arg-slot-map
   :description "Map of `arg-name → slot-id` for `fn-id`'s free args. `{}` when fn-id is nil."
   :args {:fn-id {:type :nullable-uuid :description "Target fn-id; nil short-circuits to empty map."}}
   :return-type [:map :keyword :uuid]
   :effects #{:db}}

  {:name :with-graph-load-memo
   :description "Run one graph body with an epoch-aware branch-load memo. Repeated closure lookups share the branch read; an enclosing memo is reused, otherwise the new memo ends with this call."
   :args {:body {:type [:fn {} a]}}
   :return-type a
   :effects #{:db}}

  ;; The same surface with the facts the EDITOR needs per hole — whether
  ;; it is optional (the executor's effective-required at the slot's
  ;; owner), whether it is a closure capture and inside which HOF target.
  ;; `:free-arg-slot-map` stays the executor-facing projection.
  {:name :_free-arg-entry-fact
   :type {:ext-name :keyword :slot-id :uuid :optional? :bool
          :captured? :nullable-bool :via :nullable-uuid}}
  {:name :_free-arg-fact-batch
   :type {:entries [:list :_free-arg-entry-fact]
          :via-names [:map :uuid :nullable-text]}}
  {:name :_free-arg-facts
   :description "Canonical public holes and capture-target names from one scoped executor lookup snapshot. Native slot algebra decides membership, inherited names and requiredness."
   :args {:fn-id {:type :nullable-uuid}}
   :return-type :_free-arg-fact-batch :effects #{:db}}
  {:name :_free-arg-rows
   :parent :get :args {:coll :_free-arg-facts :key {:value :entries} :default {:value []}}}
  {:name :_free-arg-via-names
   :parent :get :args {:coll :_free-arg-facts :key {:value :via-names} :default {:value {}}}}
  {:name :_free-arg-display-row
   :parent :zipmap :lambda-params [:entry]
   :args {:keys {:value [:name :slot-id :optional? :captured? :via]}
          :vals [{:parent :get :args {:coll {:as :entry :type :_free-arg-entry-fact}
                                      :key {:value :ext-name} :default nil}}
                 {:parent :get :args {:coll {:as :entry :type :_free-arg-entry-fact}
                                      :key {:value :slot-id} :default nil}}
                 {:parent :get :args {:coll {:as :entry :type :_free-arg-entry-fact}
                                      :key {:value :optional?} :default false}}
                 {:parent :coalesce
                  :args {:value {:parent :get
                                 :args {:coll {:as :entry :type :_free-arg-entry-fact}
                                        :key {:value :captured?} :default nil}}
                         :default false}}
                 {:parent :get
                  :args {:coll {:as :via-names :type [:map :uuid :nullable-text]}
                         :key {:parent :get :args {:coll {:as :entry :type :_free-arg-entry-fact}
                                                   :key {:value :via} :default nil}}
                         :default nil}}]}}
  {:name :free-arg-entries
   :description "Public Run/Inspector display rows over the canonical slot surface: keyword name, slot identity, explicit optional/captured flags and capture-target display name. Nil fn-id yields []."
   :parent :map
   :args {:fn-id {:type :nullable-uuid}
          :func :_free-arg-display-row :coll :_free-arg-rows :via-names :_free-arg-via-names}
   :return-type [:list {:name :keyword :slot-id :uuid :optional? :bool :captured? :bool :via :nullable-text}]}

  ;; --- :service-blocking-free-args — the service-ability PROJECTION of
  ;; :free-arg-slot-map. Same graph-traversal primitive (§3.3 carve-out),
  ;; but drops the fn's own top-level CALLBACK-slot subtrees: an
  ;; `:http-server` handler / `:schedule` body is invoked by the deferred
  ;; invoker per request/tick, so its free args are per-invocation and don't
  ;; block STARTING the service. Only `:_create-service-free-args-rej` uses
  ;; it, so a whole-app listener (all free args below its `:handler` HOF
  ;; slot) isn't falsely rejected while a genuinely unstartable fn still is.
  {:name :service-blocking-free-args
   :description "Map of `arg-name → slot-id` for only the free args that would prevent `fn-id` from being STARTED as a service (drops callback subtrees the deferred invoker supplies per-invocation). `{}` when fn-id is nil."
   :args {:fn-id {:type :nullable-uuid :description "Target fn-id; nil short-circuits to empty map."}}
   :return-type [:map :keyword :uuid]
   :effects #{:db}}

  ;; --- The editor's graph reads — scoped acquisition and projection over the
  ;; shared graph-cache. Every fn row carries a `:role` (Types vs
  ;; Functions decided server-side); `GET /api/graph/entities` picks one
  ;; by its `scope` (`:all-entities-handler`), each MCP tool binds its own.
  {:name :_graph-tree-kind :type {:count :int :types :int :plain :int}}
  {:name :_graph-tree-kinds :map {:key :nullable-uuid :value :_graph-tree-kind}}
  {:name :_graph-tree-errors :map {:key :nullable-uuid :value :int}}
  {:name :_graph-tree-facts-shape
   :type {:namespaces [:list :keyword-map] :kinds :_graph-tree-kinds :errors :_graph-tree-errors}}
  {:name :_graph-tree-facts
   :description "One scoped sidebar snapshot: memoized kinds and diagnostics counted only for visible fn IDs."
   :args {} :return-type :_graph-tree-facts-shape :effects #{:db}}
  {:name :_graph-tree-kinds-value :parent :get
   :args {:coll :_graph-tree-facts :key {:value :kinds} :default {}}}
  {:name :_graph-tree-errors-value :parent :get
   :args {:coll :_graph-tree-facts :key {:value :errors} :default {}}}
  {:name :_graph-tree-namespace-ids :parent :distinct
   :args {:coll {:parent :concat
                 :args {:colls [{:parent :keys :args {:map :_graph-tree-kinds-value}}
                                {:parent :keys :args {:map :_graph-tree-errors-value}}]}}}}
  {:name :_graph-tree-captured-kinds :parent :get
   :args {:coll {:as :tree-facts :type :_graph-tree-facts-shape} :key {:value :kinds} :default {}}}
  {:name :_graph-tree-kind-value :parent :get
   :args {:coll :_graph-tree-captured-kinds :key {:as :namespace-id :type :nullable-uuid}
          :default {:value {:count 0 :types 0 :plain 0}}}}
  {:name :_graph-tree-error-count :parent :get
   :args {:coll {:parent :get
                 :args {:coll {:as :tree-facts :type :_graph-tree-facts-shape} :key {:value :errors} :default {}}}
          :key {:as :namespace-id :type :nullable-uuid} :default 0}}
  {:name :_graph-tree-type-count :parent :get
   :args {:coll :_graph-tree-kind-value :key {:value :types} :default 0}}
  {:name :_graph-tree-fn-count :parent :get
   :args {:coll :_graph-tree-kind-value :key {:value :plain} :default 0}}
  {:name :_graph-tree-count-row :parent :merge :lambda-params [:namespace-id]
   :args {:maps [{:parent :zipmap
                  :args {:keys [{:value :namespace-id} {:value :count}]
                         :vals [{:as :namespace-id :type :nullable-uuid}
                                {:parent :get :args {:coll :_graph-tree-kind-value :key {:value :count} :default 0}}]}}
                 {:parent :if
                  :args {:test {:parent :or
                                :args {:values [{:parent :gt :args {:nums [:_graph-tree-error-count 0]}}
                                                {:parent :not
                                                 :args {:value {:parent :contains?
                                                                :args {:coll :_graph-tree-captured-kinds
                                                                       :key {:as :namespace-id :type :nullable-uuid}}}}}]}}
                         :then {:parent :assoc-empty :args {:key {:value :type-error-count} :value :_graph-tree-error-count}}
                         :else {}}}
                 {:parent :if
                  :args {:test {:parent :gt :args {:nums [:_graph-tree-type-count 0]}}
                         :then {:parent :assoc-empty :args {:key {:value :type-count} :value :_graph-tree-type-count}}
                         :else {}}}
                 {:parent :if
                  :args {:test {:parent :gt :args {:nums [:_graph-tree-fn-count 0]}}
                         :then {:parent :assoc-empty :args {:key {:value :fn-count} :value :_graph-tree-fn-count}}
                         :else {}}}]}}
  {:name :graph-tree
   :description "Sidebar namespaces and kind/diagnostic counts; anonymous-only diagnosed namespaces retain a zero-count row."
   :parent :zipmap
   :args {:keys [{:value :namespaces} {:value :counts}]
          :vals [{:parent :get :args {:coll :_graph-tree-facts :key {:value :namespaces} :default []}}
                 {:parent :map :args {:func :_graph-tree-count-row :coll :_graph-tree-namespace-ids :tree-facts :_graph-tree-facts}}]}
   :return-type {:namespaces [:list :keyword-map] :counts [:list :keyword-map]}}

  {:name :_graph-candidate-shape
   :type {:id :uuid :name :nullable-text :namespace-id :nullable-uuid :description :nullable-text}}
  {:name :_graph-cohort-shape
   :type {:rows [:list :_graph-candidate-shape] :paths [:map :uuid :text] :limit :non-negative-int}}
  {:name :_graph-selection-shape
   :type {:ids [:list :uuid] :truncated? :bool}}
  {:name :_project-graph-cohort
   :description "Acquire one authorized candidate cohort, invoke a pure selector over data only, then annotate selected IDs from that same snapshot."
   :args {:selector {:type [:fn {:cohort :_graph-cohort-shape} :_graph-selection-shape #{}]}
          :namespaces? {:type :bool}
          :capped? {:type :bool}}
   :return-type {:fns [:list :keyword-map] :truncated? :bool}
   :effects #{:db}}
  {:name :_cohort-rows :parent :get
   :args {:coll {:as :cohort :type :_graph-cohort-shape} :key {:value :rows} :default []}}
  {:name :_cohort-paths :parent :get
   :args {:coll {:as :cohort :type :_graph-cohort-shape} :key {:value :paths} :default {}}}
  {:name :_cohort-limit :parent :get
   :args {:coll {:as :cohort :type :_graph-cohort-shape} :key {:value :limit} :default 0}}
  {:name :_cohort-row-id :parent :get
   :lambda-params [:row]
   :args {:coll {:as :row :type :_graph-candidate-shape} :key {:value :id} :default nil}}
  {:name :_cohort-row-name :parent :get
   :args {:coll {:as :row :type :_graph-candidate-shape} :key {:value :name} :default nil}}
  {:name :_cohort-row-namespace :parent :get
   :args {:coll {:as :row :type :_graph-candidate-shape} :key {:value :namespace-id} :default nil}}
  {:name :_cohort-row-description :parent :get
   :args {:coll {:as :row :type :_graph-candidate-shape} :key {:value :description} :default nil}}
  {:name :_search-normalized :parent :str-replace
   :args {:string {:parent :str-trim
                   :args {:string {:parent :str-lower
                                   :args {:string {:parent :coalesce :args {:value {:as :q :type :nullable-text} :default ""}}}}}}
          :match "/" :replacement "."}}
  {:name :_search-needle :parent :coalesce
   :args {:value :_search-normalized :default ""}}
  {:name :_search-nonblank? :parent :not
   :args {:value {:parent :equal? :args {:a :_search-needle :b ""}}}}
  {:name :_search-name :parent :str-lower
   :args {:string {:parent :coalesce :args {:value :_cohort-row-name :default ""}}}}
  {:name :_search-path :parent :get
   :args {:coll :_cohort-paths :key :_cohort-row-namespace :default ""}}
  {:name :_search-qualified :parent :if
   :args {:test {:parent :equal? :args {:a :_search-path :b ""}}
          :then :_search-name
          :else {:parent :str-lower
                 :args {:string {:parent :str :args {:parts [:_search-path "." :_cohort-row-name]}}}}}}
  {:name :_search-description :parent :str-lower
   :args {:string {:parent :coalesce :args {:value :_cohort-row-description :default ""}}}}
  {:name :_search-tier-value :parent :if
   :args {:test {:parent :equal? :args {:a :_search-name :b :_search-needle}}
          :then 0
          :else {:parent :if
                 :args {:test {:parent :str-contains? :args {:string :_search-name :substring :_search-needle}}
                        :then 1
                        :else {:parent :if
                               :args {:test {:parent :str-contains? :args {:string :_search-qualified :substring :_search-needle}}
                                      :then 2
                                      :else {:parent :if
                                             :args {:test {:parent :and
                                                           :args {:values [{:as :descriptions? :type :bool}
                                                                           {:parent :str-contains? :args {:string :_search-description :substring :_search-needle}}]}}
                                                    :then 3 :else 4}}}}}}}
   :return-type :non-negative-int}
  {:name :_search-tier :parent :_search-tier-value :lambda-params [:row]}
  {:name :_search-match? :parent :and
   :lambda-params [:row]
   :args {:values [{:parent :some? :args {:value :_cohort-row-name}}
                   {:parent :lt :args {:nums [:_search-tier-value 4]}}]}}
  {:name :_search-matches :parent :if
   :args {:test :_search-nonblank?
          :then {:parent :filter :args {:pred :_search-match? :coll :_cohort-rows}}
          :else []}
   :return-type [:list :_graph-candidate-shape]}
  {:name :_search-ranked :parent :sort-by
   :args {:key-fn :_search-tier :coll :_search-matches}}
  {:name :_search-limited :parent :take
   :args {:count :_cohort-limit :coll :_search-ranked}}
  {:name :_search-selection :parent :zipmap
   :lambda-params [:cohort]
   :args {:keys [{:value :ids} {:value :truncated?}]
          :vals [{:parent :map :args {:func :_cohort-row-id :coll :_search-limited}}
                 {:parent :gt :args {:nums [{:parent :count :args {:coll :_search-matches}} :_cohort-limit]}}]}
   :return-type :_graph-selection-shape}
  {:name :graph-search
   :description "Rank authorized names before capping: exact, bare substring, qualified substring, then optional description hits. Slash reads as dot; blank returns no rows."
   :parent :_project-graph-cohort
   :args {:q {:type :nullable-text}
          :descriptions? {:type :bool}
          :selector :_search-selection :namespaces? :_search-nonblank? :capped? true}}
  {:name :_namespace-match? :parent :and
   :lambda-params [:row]
   :args {:values [{:parent :some? :args {:value :_cohort-row-name}}
                   {:parent :equal? :args {:a :_cohort-row-namespace :b {:as :namespace-id :type :nullable-uuid}}}]}}
  {:name :_namespace-selection :parent :zipmap
   :lambda-params [:cohort]
   :args {:keys [{:value :ids} {:value :truncated?}]
          :vals [{:parent :map
                  :args {:func :_cohort-row-id
                         :coll {:parent :filter :args {:pred :_namespace-match? :coll :_cohort-rows}}}}
                 false]}
   :return-type :_graph-selection-shape}
  {:name :_namespace-projection :parent :_project-graph-cohort
   :args {:selector :_namespace-selection :namespaces? false :capped? false}}
  {:name :graph-namespace-fns
   :description "One namespace's named light rows. Nil namespace-id selects the root bucket, never all namespaces."
   :parent :zipmap
   :args {:namespace-id {:type :nullable-uuid}
          :keys [{:value :fns}]
          :vals [{:parent :get :args {:coll :_namespace-projection :key {:value :fns} :default []}}]}
   :return-type {:fns [:list :keyword-map]}}

  {:name :_graph-index-facts
   :description "One org-scoped, implementation-concealed snapshot of roled fn rows and namespaces. No ctx, delays or reverse-reference index crosses this boundary."
   :args {}
   :return-type {:fns [:list :keyword-map] :namespaces [:list :keyword-map]}
   :effects #{:db}}

  {:name :_graph-index-key-present?
   :parent :some?
   :lambda-params [:key]
   :args {:value {:parent :get
                  :args {:coll {:as :row :type :keyword-map}
                         :key {:as :key :type :keyword}
                         :default nil}}}}

  {:name :_graph-index-present-keys
   :parent :filter
   :args {:pred :_graph-index-key-present?
          :coll {:parent :keys :args {:map {:as :row :type :keyword-map}}}
          :row {:as :row}}}

  {:name :_graph-index-row
   :description "Keep every non-nil field of a viewer-safe fn row, including extensions, false and zero."
   :parent :select-keys
   :lambda-params [:row]
   :args {:m {:as :row :type :keyword-map}
          :ks :_graph-index-present-keys}
   :return-type :keyword-map}

  {:name :_graph-index-rows
   :parent :map
   :args {:func :_graph-index-row
          :coll {:parent :get
                 :args {:coll :_graph-index-facts :key :fns :default []}}}
   :return-type [:list :keyword-map]}

  {:name :graph-index
   :description "Every fn row and namespace — `{:fns :namespaces}`, nil fields dropped (CLI / batch pull)."
   :parent :assoc
   :args {:map :_graph-index-facts
          :key :fns
          :value :_graph-index-rows}
   :return-type {:fns [:list :keyword-map] :namespaces [:list :keyword-map]}}

  {:name :graph-subtree
   :description "The fn-view slice: the fns transitively reachable from `root-id` via parent-ids + binding refs + type overrides + list-item refs + own-slot type-fn-ids, plus the rows they own (~98% smaller than the full dump). Empty rows for a nil / unknown root."
   :args {:root-id {:type :nullable-uuid :description "Anchor of the closure."}}
   :return-type {:fns [:list :keyword-map] :slots [:list :keyword-map] :fn-slots [:list :keyword-map]
                 :bindings [:list :keyword-map] :list-items [:list :keyword-map]
                 :namespaces [:list :keyword-map]}
   :effects #{:db}}

  {:name :graph-full
   :description "Every fn, slot, fn-slot, binding, list item and namespace — the editor's initial load (~4.5 MB on a 3000-fn graph)."
   :args {}
   :return-type {:fns [:list :keyword-map] :slots [:list :keyword-map] :fn-slots [:list :keyword-map]
                 :bindings [:list :keyword-map] :list-items [:list :keyword-map]
                 :namespaces [:list :keyword-map]}
   :effects #{:db}}

  {:name :fn-unread-bindings
   :description "Names of the bindings `fn-id` carries that no reader can see: every fn in its tree that owns the slot already binds it closer, so the value the author wrote is silently ignored. Reported only when the readers were found and all are bound (precise, not complete). `[]` for nil / unknown fn-id or nothing shadowed. What `describe-fn` reports as `unread-bindings`."
   :args {:fn-id {:type :nullable-uuid :description "Target fn-id; nil → `[]`."}}
   :return-type [:list :keyword]
   :effects #{:db}}

  {:name :graph-fn-defs-subtree
   :description "The fn-defs (fns.edn maps) of the subtree reachable from `root-id` — the same closure `:graph-subtree` walks, emitted through the records→EDN codec (`packages.export/export-subtree`). `[]` for nil / unknown root. What an AI author reads back through `read-fn`: the exact syntax it writes."
   :args {:root-id {:type :nullable-uuid :description "Anchor fn-id; nil → `[]`."}}
   :return-type [:list :keyword-map]
   :effects #{:db}}

  {:name :strip-hidden-impl
   :description "Apply the installed view-impl filter to a `/api/graph/entities` dump — strips the internal composition (parent-ids + bindings) of fns the current viewer lacks `:view-impl` on (own-org / grant), leaving each fn's signature. Identity when no tenancy addon is wired (single-tenant sees everything). Pure pass-through base-fn over the `graphden.crud.entities/apply-view-impl-filter` seam; the actual filter fn is installed by the tenancy addon. Compose it over the `:graph-*` reads in the graph-read handler."
   :args {:graph {:type :keyword-map
                  :description "A graph dump from one of the `:graph-*` reads."}}
   :return-type :keyword-map
   :effects #{}}

  {:name :fn-impl-visible?
   :description "May the current viewer see `fn-id`'s internal composition? The one-fn answer of the same view-impl seam `:strip-hidden-impl` applies to a dump — for reads that report about a fn's internals without shipping rows (`describe-fn`'s unread bindings). Always true with no tenancy addon wired; false for nil / unknown fn-id."
   :args {:fn-id {:type :nullable-uuid :description "Target fn-id; nil → false."}}
   :return-type :bool
   :effects #{:db}}

  {:name :all-rich-types
   :description "Snapshot of the in-memory rich-type registry. Returns `{fn-name {:return type :args {arg-name type}}}` for every base-fn AND composed fn-def the type-checker has processed. FULL — every per-entry field. Internal single-source-of-truth for `/api/types/candidates` (`:_types-candidates-snapshot`); the HTTP wire-shaping (lean bulk / per-fn) lives in `:api-rich-types`."
   :args {}
   :return-type :keyword-map
   :effects #{:db}}

  {:name :_rich-type-wire-entry
   :description "Lean bulk entry: preserve type and future fields, omit metadata unused by chip and strip paint."
   :lambda-params [:entry]
   :parent :dissoc
   :args {:map {:parent :dissoc
                :args {:map {:parent :dissoc
                             :args {:map {:parent :dissoc
                                          :args {:map {:parent :dissoc
                                                       :args {:map {:parent :dissoc
                                                                    :args {:map {:parent :dissoc
                                                                                 :args {:map {:parent :dissoc
                                                                                              :args {:map {:as :entry :type :keyword-map}
                                                                                                     :key {:value :resolved-bindings}}}
                                                                                        :key {:value :description}}}
                                                                           :key {:value :source-file}}}
                                                              :key {:value :source-line}}}
                                                 :key {:value :tags}}}
                                    :key {:value :arg-effects}}}
                       :key {:value :call-time-effects}}}
          :key {:value :primary-parent}}}

  {:name :api-rich-types
   :description "Lean bulk snapshot for GET /api/types. Acquisition and canonical type derivation share all-rich-types; wire projection is graph composition."
   :parent :update-vals
   :args {:m :all-rich-types
          :f :_rich-type-wire-entry}}

  ;; §3.3 atomic core of POST /api/entities/:type — the unit that
  ;; bundles `sp/create-entity`, the Phase-6c rename-slot side effect,
  ;; the post-create whole-fn type-check, and the rollback-on-failure
  ;; into ONE atomic primitive. The rollback's row-id has to match
  ;; the create's; splitting the pair across graph nodes risks a
  ;; stale-id read.
  {:name :_apply-error-code :parent :get
   :args {:coll {:as :outcome :type :keyword-map} :key {:value :error} :default nil}}
  {:name :_apply-write-rejection :parent :get
   :args {:coll {:as :outcome :type :keyword-map} :key {:value :write-rejection} :default {}}}
  {:name :_apply-rejection-kind :parent :get
   :args {:coll :_apply-write-rejection :key {:value :kind} :default nil}}
  {:name :_apply-rejection-status :parent :get
   :args {:coll :_apply-write-rejection :key {:value :status} :default nil}}
  {:name :_apply-http-status :parent :cond
   :args {:clauses [{:parent :equal? :args {:a :_apply-rejection-kind :b {:value :package}}} 403
                    {:parent :equal? :args {:a :_apply-rejection-kind :b {:value :secret-leaf}}} 403
                    {:parent :equal? :args {:a :_apply-rejection-kind :b {:value :validation}}}
                    {:parent :if :args {:test {:parent :some? :args {:value :_apply-rejection-status}}
                                        :then :_apply-rejection-status :else 400}}
                    {:parent :get :args {:coll :_apply-write-rejection :key {:value :duplicate-key?} :default false}} 409
                    true :_apply-rejection-status]}}
  {:name :_apply-error-message :parent :if
   :args {:test {:parent :equal? :args {:a :_apply-error-code :b {:value :crud/write-failed}}}
          :then {:as :fallback :type :text} :else :_apply-error-code}}
  {:name :_apply-rejection-envelope :parent :if
   :args {:test {:parent :or :args {:values [{:parent :some? :args {:value :_apply-http-status}}
                                             {:parent :get :args {:coll :_apply-write-rejection :key {:value :include-null-status?} :default false}}]}}
          :then {:parent :zipmap :args {:keys [{:value :error} {:value :http-status}]
                                        :vals [:_apply-error-message :_apply-http-status]}}
          :else {:parent :zipmap :args {:keys [{:value :error}] :vals [:_apply-error-message]}}}}
  {:name :_apply-formatted-outcome :parent :cond
   :args {:clauses [{:parent :some? :args {:value :_apply-rejection-kind}} :_apply-rejection-envelope
                    {:parent :equal? :args {:a :_apply-error-code :b {:value :crud/sequence-binding-changed}}}
                    {:error "Sequence binding or inherited slot changed; refresh and retry" :http-status 409}
                    {:parent :equal? :args {:a :_apply-error-code :b {:value :crud/sequence-item-missing}}}
                    {:error "Sequence item no longer exists" :http-status 404}
                    {:parent :equal? :args {:a :_apply-error-code :b {:value :crud/write-failed}}}
                    {:parent :assoc :args {:map {:as :outcome :type :keyword-map}
                                           :key {:value :error} :value {:as :fallback :type :text}}}
                    true {:as :outcome :type :keyword-map}]}}
  {:name :_apply-response
   :description "Render a guarded outcome only after the writer has committed or rolled back its truthy error sentinel. Keep optional response keys compatible."
   :parent :ensure-type
   :args {:value :_apply-formatted-outcome :type {:value :keyword-map}}
   :return-type :keyword-map}

  {:name :_apply-create-parsed :parent :zipmap
   :args {:keys [{:value :entity-type} {:value :entity-data} {:value :type-str} {:value :form-data}]
          :vals [{:parent :str-to-keyword :args {:string {:as :entity-type :type :text}}}
                 {:as :entity-data :type :nullable-keyword-map}
                 {:as :type-str :type :text} {:as :form-data :type :nullable-keyword-map}]}}
  {:name :_apply-update-parsed :parent :assoc
   :args {:map :_apply-create-parsed :key {:value :id-uuid} :value {:as :id-uuid :type :uuid}}}
  {:name :_apply-create-atomic
   :description "Guarded create/rename/type-check/rollback; errors remain truthy until rollback completes."
   :args {:parsed {:type :keyword-map}} :return-type :keyword-map :effects #{:db}}
  {:name :_apply-update-atomic
   :description "Guarded update/rename/type-check/rollback; errors remain truthy until rollback completes."
   :args {:parsed {:type :keyword-map}} :return-type :keyword-map :effects #{:db}}
  {:name :try-apply-create
   :description "Assemble the parsed write, execute its atomic core, then format the create fallback."
   :parent :_apply-response
   :args {:type-str {:type :text}
          :entity-type {:type :text}
          :entity-data {:type :nullable-keyword-map}
          :form-data {:type :nullable-keyword-map}
          :outcome {:parent :_apply-create-atomic :args {:parsed :_apply-create-parsed}}
          :fallback {:parent :str :args {:parts ["Failed to create " {:as :type-str :type :text}]}}}
   :return-type :keyword-map}
  {:name :try-apply-update
   :description "Assemble the parsed write, execute its atomic core, then format the update fallback."
   :parent :_apply-response
   :args {:entity-type {:type :text}
          :id-uuid {:type :uuid}
          :entity-data {:type :nullable-keyword-map}
          :type-str {:type :text}
          :form-data {:type :nullable-keyword-map}
          :outcome {:parent :_apply-update-atomic :args {:parsed :_apply-update-parsed}}
          :fallback "Failed to update entity"}
   :return-type :keyword-map}

  {:name :_apply-seq-append-atomic
   :description "Refresh and append under one guarded writer."
   :args {:parsed {:type :_seq-append-parsed-shape} :seq-binding {:type :nullable-keyword-map}}
   :return-type :keyword-map :effects #{:db}}
  {:name :_apply-seq-update-atomic
   :description "Refresh and update under one guarded writer."
   :args {:parsed {:type :_seq-update-parsed-shape} :item {:type :nullable-keyword-map}}
   :return-type :keyword-map :effects #{:db}}
  {:name :_apply-seq-move-atomic
   :description "Refresh and swap positions under one guarded writer."
   :args {:parsed {:type :_seq-update-parsed-shape} :item {:type :nullable-keyword-map}}
   :return-type :keyword-map :effects #{:db}}
  {:name :try-apply-seq-append
   :description "Render the committed append or stale-binding HTTP rejection after atomic rollback."
   :parent :_apply-response
   :args {:parsed {:type :_seq-append-parsed-shape}
          :seq-binding {:type :nullable-keyword-map}
          :outcome :_apply-seq-append-atomic :fallback ""} :return-type :keyword-map}
  {:name :try-apply-seq-update
   :description "Render the committed update or missing-item HTTP rejection after atomic rollback."
   :parent :_apply-response
   :args {:parsed {:type :_seq-update-parsed-shape}
          :item {:type :nullable-keyword-map}
          :outcome :_apply-seq-update-atomic :fallback ""} :return-type :keyword-map}
  {:name :try-apply-seq-move
   :description "Render the committed swap or missing-item HTTP rejection after atomic rollback."
   :parent :_apply-response
   :args {:parsed {:type :_seq-update-parsed-shape}
          :item {:type :nullable-keyword-map}
          :outcome :_apply-seq-move-atomic :fallback ""} :return-type :keyword-map}

  {:name :fn-names-with-tag
   :description "Vec of fn-NAMES (as strings) declared with `tag` in their `:tags` set. Used to discover tagged base-fns declaratively — e.g. `(:secret-shape)` resolves to the secret-leaf row's name without hardcoding `\"secret-leaf\"` anywhere. Pure: derefs the in-memory `rich-types-registry` atom, no storage round-trip."
   :args {:tag {:type :text :description "Tag keyword as text, e.g. \"secret-shape\" / \"admin-only-vault\"."}}
   :return-type [:list :text]}

  ;; Reverse-junction lookup. Used by the in-use guard
  ;; (`:_delete-fn-in-use-reason`), the find-fn-usages chain
  ;; (`app/secrets`), and any future reverse-reference walks.
  ;; Lives in web/crud so the web layer can reach it without
  ;; depending on app.
  {:name :query-ref-many-owners
   :description "Find all rows of `:entity-type` whose `:ref-many-field` (a vector of ids) contains `:target-id`. Returns a vector of owner ids."
   :args {:entity-type {:type :text :description "Entity name as text."}
          :ref-many-field {:type :text :description "Ref-many field name as text."}
          :target-id {:type :uuid :description "Target id to find in the ref-many vectors."}}
   :return-type [:list :uuid]
   :effects #{:db}}

  {:name :value-kinds
   :description "The `value_kind` schema enum as an ordered list of primitive type-tag strings (`\"int\"`, `\"text\"`, …) a binding value / slot can carry. Powers `GET /api/value-kinds` — the editor's type-pickers read it instead of hard-coding the enum. Pure: reads a compile-time constant."
   :args {}
   :return-type [:list :text]}]}
