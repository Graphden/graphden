// Graphden Graph Data Schema
// This schema defines the structure for storing function composition graphs.
// Versioned entities use a two-table pattern: stable id + version table with data.
// Version tables are append-only: each change adds a new record.
//
// === Version Resolution Algorithm ===
// To resolve current version of entity E on branch B:
//   1. Find latest version record for E where branch_id = B (own version).
//   2. Find all branch_merge records where target_branch_id = B
//      and target_timestamp > own version's created_at (or all, if no own version).
//   3. For each such merge, find latest version of E in source_branch
//      where created_at <= source_timestamp.
//   4. Among all candidates (own + from merges), pick the one with the
//      greatest effective timestamp (own created_at, or merge's target_timestamp).
//   5. If no version found on B, walk up to base_branch_id and repeat.
//
// This avoids duplicating version records on merge. A single branch_merge
// record makes all source branch versions visible in the target branch.

Enum value_kind {
  null
  bool
  int
  numeric
  text
  uuid
  timestamptz
  jsonb
  bytes
  fn
  any
}

// === Branching ===

Table branch {
  id uuid [primary key]
  name text [not null]
  base_branch_id uuid [ref: > branch.id]
  created_at timestamptz [not null]
}

// Merge record: makes source branch versions visible in target branch.
// source_timestamp = snapshot point in source (versions created_at <= this are included).
// target_timestamp = effective time in target (for ordering among multiple merges).
// No version records are copied — this single record is sufficient.
// Conflict detection: entity modified in both source and target after fork point = conflict.
Table branch_merge {
  id uuid [primary key]
  source_branch_id uuid [not null, ref: > branch.id]
  source_timestamp timestamptz [not null]
  target_branch_id uuid [not null, ref: > branch.id]
  target_timestamp timestamptz [not null]
  created_at timestamptz [not null]

  indexes {
    (target_branch_id, target_timestamp) [name: 'idx_branch_merge_target_lookup']
  }
}

// === Versioned: fn_schema (platform-level) ===

// Function signature (stable identity).
// Updated via platform migrations (base-fn changes) or user edits (composite fn signatures).
Table fn_schema {
  id uuid [primary key]
}

// Version of a function signature. Append-only history.
// Can change: name, returned_type, base_fn_name, impl_hash.
// Current version: latest by created_at for (fn_schema_id, branch_id).
//
// Platform updates (base-fn migration):
//   - Compatible changes (new optional arg): update on platform branch, users merge when ready.
//   - Breaking changes (removed arg, type change): register new base_fn_name,
//     create new fn_schema. Old fn_schema + old code remain functional.
//   - Clojure runtime must support old signatures until all users migrate.
Table fn_schema_version {
  id uuid [primary key]
  fn_schema_id uuid [not null, ref: > fn_schema.id]
  branch_id uuid [not null, ref: > branch.id]
  name text [not null]
  returned_type value_kind [not null]
  base_fn_name text
  impl_hash text
  created_at timestamptz [not null]

  indexes {
    (fn_schema_id, branch_id, created_at) [name: 'idx_fn_schema_version_lookup']
  }
}

// === Versioned: arg_schema (tied to fn_schema) ===

// Argument definition (stable identity).
// fn_schema_id is stable — arg always belongs to the same fn_schema.
Table arg_schema {
  id uuid [primary key]
  fn_schema_id uuid [not null, ref: > fn_schema.id]
}

// Version of an argument definition. Append-only history.
// Can change: name, type, required.
// Current version: latest by created_at for (arg_schema_id, branch_id).
Table arg_schema_version {
  id uuid [primary key]
  arg_schema_id uuid [not null, ref: > arg_schema.id]
  branch_id uuid [not null, ref: > branch.id]
  name text [not null]
  type value_kind [not null]
  required bool [not null]
  created_at timestamptz [not null]

  indexes {
    (arg_schema_id, branch_id, created_at) [name: 'idx_arg_schema_version_lookup']
  }
}

// Pure argument value (no owner). Immutable, deduplicated.
// value can be:
// - literal (int, text, bool, etc.)
// - UUID referencing fn (for HOF - pass function as object)
// - UUID referencing fn_usage (for computed values - execute & cache)
// NOT versioned: changing an argument = pointing fn_arg to a different arg_value.
Table arg_value {
  id uuid [primary key]
  arg_schema_id uuid [not null, ref: > arg_schema.id]
  value jsonb

  indexes {
    (arg_schema_id, value) [unique]
  }
}

// === Versioned: fn ===

// Function instance (stable identity).
// Other entities reference fn.id which never changes.
Table fn {
  id uuid [primary key]
}

// Version of a function. Append-only history.
// Can change: name, fn_schema_id.
// Current version: latest by created_at for (fn_id, branch_id).
Table fn_version {
  id uuid [primary key]
  fn_id uuid [not null, ref: > fn.id]
  branch_id uuid [not null, ref: > branch.id]
  name text [not null]
  fn_schema_id uuid [not null, ref: > fn_schema.id]
  created_at timestamptz [not null]

  indexes {
    (fn_id, branch_id, created_at) [name: 'idx_fn_version_lookup']
  }
}

// === Versioned: fn_arg ===

// Binding from fn to arg_value (stable identity).
Table fn_arg {
  id uuid [primary key]
}

// Version of a fn_arg binding. Append-only history.
// Can change: arg_value_id.
// Current version: latest by created_at for (fn_arg_id, branch_id).
Table fn_arg_version {
  id uuid [primary key]
  fn_arg_id uuid [not null, ref: > fn_arg.id]
  branch_id uuid [not null, ref: > branch.id]
  fn_id uuid [not null, ref: > fn.id]
  arg_schema_id uuid [not null, ref: > arg_schema.id]
  arg_value_id uuid [not null, ref: > arg_value.id]
  created_at timestamptz [not null]

  indexes {
    (fn_arg_id, branch_id, created_at) [name: 'idx_fn_arg_version_lookup']
  }
}

// === Non-versioned: fn_usage ===

// Call site reference (function to execute at this point).
// fn_id is fixed (fn_usage always calls the same fn).
// NOT versioned: fn_usage itself doesn't change.
Table fn_usage {
  id uuid [primary key]
  name text [not null, unique]
  fn_id uuid [not null, ref: > fn.id]
}

// === Versioned: fn_usage_arg ===

// Binding from fn_usage to arg_value (stable identity).
Table fn_usage_arg {
  id uuid [primary key]
}

// Version of a fn_usage_arg binding. Append-only history.
// Can change: arg_value_id.
// Current version: latest by created_at for (fn_usage_arg_id, branch_id).
Table fn_usage_arg_version {
  id uuid [primary key]
  fn_usage_arg_id uuid [not null, ref: > fn_usage_arg.id]
  branch_id uuid [not null, ref: > branch.id]
  fn_usage_id uuid [not null, ref: > fn_usage.id]
  arg_schema_id uuid [not null, ref: > arg_schema.id]
  arg_value_id uuid [not null, ref: > arg_value.id]
  created_at timestamptz [not null]

  indexes {
    (fn_usage_arg_id, branch_id, created_at) [name: 'idx_fn_usage_arg_version_lookup']
  }
}
