;; Service-to-service calls — the SERVICE FN IS THE VALUE.
;;
;; A consumer names the service it talks to by binding the service fn
;; itself into `:service-endpoint`'s `:service` slot. That slot is
;; `:fn-ref`-typed: the fn's IDENTITY, never evaluated — binding
;; `:web-server` here does not start a second listener, and the edge is
;; not a dependency (two services may name each other). The reconciler
;; records where a started service answers (`:service.endpoint`, from
;; the `:endpoint` metadata on the handle `:http-server` returns);
;; `:service-endpoint` reads it back, and on the cloud an addon-installed
;; resolver answers for app-routes behind a public domain.
;;
;; The contract between two services lives in the graph too — a shared
;; namespace holding the path constants and the request/response
;; type-rows that BOTH sides reference (the producer's route + handler
;; return type, the consumer's `:service-get` + decode). One edit moves
;; both sides; the type-checker catches a drift at write time.
;;
;;   :service-endpoint            {:host :port :url}     (graph policy, :db)
;;     └─ :service-url            the `:url` field
;;          └─ :_service-url-join url + path
;;               ├─ :service-get       GET  <service>/<path>
;;               │    └─ :service-get-json   … → parsed body
;;               └─ :service-post      POST <service>/<path> with a body
;;                    └─ :service-post-json  … → parsed body
;;
;; Free args of every template: `:service` (the service fn), `:path`,
;; plus http-client's `:headers` / `:auth-value` / `:timeout-ms` (and
;; `:body` on the POST rung).

{:namespace "web.service"
 :description "Service-to-service: resolve a service fn to the address it answers on (the fn IS the value) and call it over HTTP; the contract is fn-defs both sides share."
 :fns
 [{:name :service-endpoint-shape
   :description "Where a running service answers — `{host, port, url}`. `url` is the base URL: a listener origin, an isolated app origin, or a temporary publication URL including its reserved path. Append paths without dropping that base path."
   :type {:host :text
          :port :port
          :url :url}}

  {:name :_service-rows
   :description "Enabled service rows on the caller's branch. Native storage read."
   :args {:service {:type :fn-ref}}
   :return-type [:list :keyword-map]
   :effects #{:db}}

  {:name :_live-service-endpoint
   :description "Best live listener from the enabled service rows, or nil. Native heartbeat query and ordering."
   :args {:rows {:type [:list :keyword-map]}}
   :return-type [:union :null :service-endpoint-shape]
   :effects #{:db}}

  {:name :_temporary-service-endpoint
   :description "Deployment's finite HTTP publication lookup, or nil. Native resolver seam."
   :args {:service {:type :fn-ref}}
   :return-type [:union :null :service-endpoint-shape]
   :effects #{:db}}

  {:name :_addon-service-endpoint
   :description "Deployment's app-route lookup, or nil. Native resolver seam."
   :args {:service {:type :fn-ref}}
   :return-type [:union :null :service-endpoint-shape]
   :effects #{:db}}

  {:name :_service-no-rows?
   :parent :empty?
   :args {:coll :_service-rows}}

  {:name :_service-missing-detail
   :parent :if
   :args {:test :_service-no-rows?
          :then " (no enabled service row on this branch)"
          :else " (the service row exists but no copy is alive, or it is not a listener)"}}

  {:name :_service-missing-message
   :parent :str
   :args {:parts ["Service is not running: no live instance for fn "
                  {:as :service :type :fn-ref}
                  :_service-missing-detail]}}

  {:name :_service-missing-type
   :parent :assoc-empty
   :args {:key {:value :type}
          :value {:value :service/not-running}}}

  {:name :_service-missing-id
   :parent :assoc
   :args {:map :_service-missing-type
          :key {:value :fn-id}
          :value {:as :service :type :fn-ref}}}

  {:name :_service-rows-count
   :parent :count
   :args {:coll :_service-rows}}

  {:name :_service-missing-data
   :parent :assoc
   :args {:map :_service-missing-id
          :key {:value :service-rows}
          :value :_service-rows-count}}

  {:name :_service-missing-ex
   :parent :ex-info
   :args {:message :_service-missing-message
          :data :_service-missing-data}}

  {:name :_service-not-running
   :parent :throw
   :args {:exception :_service-missing-ex}}

  {:name :_service-listener-endpoint
   :parent :_live-service-endpoint
   :args {:rows :_service-rows}}

  {:name :_service-addon-or-miss
   :parent :coalesce
   :args {:value :_addon-service-endpoint
          :default :_service-not-running}}

  {:name :_service-public-or-addon
   :parent :coalesce
   :args {:value :_temporary-service-endpoint
          :default :_service-addon-or-miss}}

  {:name :service-endpoint
   :description "The address the service named by `:service` currently answers on. The graph selects a live listener, then a finite HTTP publication, then an app-route resolver. Throws `service/not-running` when every source misses. The `:fn-ref` identity is never evaluated."
   :parent :coalesce
   :args {:value :_service-listener-endpoint
          :default :_service-public-or-addon}
   :return-type :service-endpoint-shape
   :expects-effects #{:db}}

  {:name :service-url
   :description "The complete base URL a service or published handler answers on — `:service-endpoint`'s `url` field. Free: `:service`."
   :parent :get
   :args {:coll :service-endpoint
          :key {:value :url}
          :default nil}}

  {:name :_service-url-join
   :parent :str
   :args {:parts [:service-url {:as :path :type :text}]}}

  ;; --- Call templates over web/http-client -------------------------
  ;; `:url` is pinned to the joined origin+path; the `:type :url`
  ;; override narrows `:str`'s `:text` back to the slot's refinement —
  ;; the origin always carries a scheme, so the pin is truthful.
  ;; The caller's trace rides along: the request headers are the user's
  ;; `:headers` (still free, defaulting to none) merged with
  ;; `:trace-headers`, so the service that answers links the request it
  ;; handles to this execution (docs/EXECUTION.md § Tracing).
  {:name :_service-headers
   :parent :merge
   :args {:maps [{:as :headers :type :text-map} :trace-headers]}}

  {:name :service-get
   :description "HTTP GET against a service: `:http-get` with `:url` = the service's base URL + `:path`, and the caller's trace header merged into `:headers`. Free: `:service` (the service fn), `:path` (e.g. `\"/orders\"`), `:headers`, `:auth-value`, `:timeout-ms`. Returns `{:status :headers :body}`."
   :parent :http-get
   :args {:url {:ref :_service-url-join :type :url}
          :headers :_service-headers}}

  {:name :service-post
   :description "HTTP POST against a service: `:http-post` with `:url` = the service's base URL + `:path`, and the caller's trace header merged into `:headers`. Free: `:service`, `:path`, `:body` (text — JSON-encode upstream via `:to-json-string`), `:headers`, `:auth-value`, `:timeout-ms`."
   :parent :http-post
   :args {:url {:ref :_service-url-join :type :url}
          :headers :_service-headers}}

  ;; --- Decoded rungs: the response body parsed as JSON --------------
  ;; Narrow the result to the contract's response type-row on the
  ;; consumer side (`{:ref :orders-fetch :type :orders-shape}`) —
  ;; the same type-row the producer's handler returns.
  {:name :_service-get-body
   :parent :get
   :args {:coll :service-get
          :key {:value :body}
          :default nil}}

  ;; `:keywordize` is PINNED — a base-fn spec's `:value` is a default for
  ;; the editor, not a binding, so an unpinned slot would surface free
  ;; and read nil (string keys).
  {:name :service-get-json
   :description "`:service-get` with the response body parsed as JSON (keywordized). Free: `:service`, `:path`, `:headers`, `:auth-value`, `:timeout-ms`."
   :parent :parse-json
   :args {:string :_service-get-body :keywordize true}}

  {:name :_service-post-body
   :parent :get
   :args {:coll :service-post
          :key {:value :body}
          :default nil}}

  {:name :service-post-json
   :description "`:service-post` with the response body parsed as JSON (keywordized). Free: `:service`, `:path`, `:body`, `:headers`, `:auth-value`, `:timeout-ms`."
   :parent :parse-json
   :args {:string :_service-post-body :keywordize true}}]}
