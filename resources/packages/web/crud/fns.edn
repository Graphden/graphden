;; Storage CRUD base functions for web UI
;; Context-aware functions (marked with :ctx true) require storage in execution context

[;; Query functions (context-aware)
 {:name :list-entities
  :args {:entity-type :text
         :where {:type :jsonb :required false}}
  :return-type :jsonb
  :ctx true}

 {:name :get-entity
  :args {:entity-type :text
         :id :uuid}
  :return-type :jsonb
  :ctx true}

 {:name :create-entity
  :args {:entity-type :text
         :data :jsonb}
  :return-type :jsonb
  :ctx true}

 {:name :update-entity
  :args {:entity-type :text
         :id :uuid
         :data :jsonb}
  :return-type :jsonb
  :ctx true}

 {:name :delete-entity
  :args {:entity-type :text
         :id :uuid}
  :return-type :bool
  :ctx true}

 {:name :list-all-graph-entities
  :args {}
  :return-type :jsonb
  :ctx true}

 ;; Action functions (context-aware, return {:status :headers :body} response map)
 ;; These perform actions and return result for make-html-action-handler (dynamic-response)
 {:name :process-create-entity
  :args {:request :jsonb}
  :return-type :jsonb
  :ctx true}

 {:name :process-delete-entity
  :args {:request :jsonb}
  :return-type :jsonb
  :ctx true}

 ;; Request parameter helpers (pure functions)
 {:name :get-path-param
  :args {:request :jsonb
         :param-name :text}
  :return-type :any}

 {:name :get-query-param
  :args {:request :jsonb
         :param-name :text
         :default {:type :any :required false}}
  :return-type :any}

 {:name :parse-form-body
  :args {:request :jsonb}
  :return-type :jsonb}

 {:name :parse-json-body
  :args {:request :jsonb}
  :return-type :jsonb}

 {:name :str-to-uuid
  :args {:string :text}
  :return-type :uuid}

 ;; Render functions (context-aware, return hiccup)
 ;; These extract data from request and render to hiccup
 {:name :render-entity-details-view
  :args {:request :jsonb}
  :return-type :jsonb
  :ctx true}

 {:name :render-entity-form-view
  :args {:request :jsonb}
  :return-type :jsonb
  :ctx true}

 ;; =============================================================================
 ;; FN-DEFS: Pure render functions composed from entity-field-rows
 ;; =============================================================================

 ;; Field specs for fn entity details
 {:name :fn-field-specs
  :parent :const
  :args {:value [["ID" :id]
                 ["Name" :name :keyword-to-str]
                 ["Parent ID" :parent-id]
                 ["Return Type" :return-type :keyword-to-str]
                 ["Impl Hash" :impl-hash]]}}

 ;; Render fn details using entity-field-rows
 {:name :render-fn-details
  :parent :entity-field-rows
  :args {:field-specs :fn-field-specs
         :entity {:as :entity}}}

 ;; Field specs for arg entity details (basic fields always shown)
 {:name :arg-field-specs
  :parent :const
  :args {:value [["ID" :id]
                 ["Name" :name :keyword-to-str]
                 ["Fn ID" :fn-id]
                 ["Type" :type :keyword-to-str]
                 ["Required" :required :bool-to-yesno]
                 ["Is Fn" :is-fn :bool-to-yesno]
                 ["Source ID" :source-id]
                 ["Value" :value :pr-str]
                 ["Ref ID" :ref-id]]}}

 ;; Render arg details using entity-field-rows
 {:name :render-arg-details
  :parent :entity-field-rows
  :args {:field-specs :arg-field-specs
         :entity {:as :entity}}}

 ;; Renders action buttons (Edit/Delete) for entity - still a base-fn
 ;; because it generates dynamic URLs and htmx attributes
 {:name :render-entity-actions
  :args {:entity-type :text
         :entity-id :text}
  :return-type :jsonb}

 ;; Form data parsing helpers
 {:name :parse-fn-from-form
  :args {:form-data :jsonb}
  :return-type :jsonb}

 {:name :parse-arg-from-form
  :args {:form-data :jsonb}
  :return-type :jsonb}

 ;; =============================================================================
 ;; FN-DEFS: Response handlers composed from base functions
 ;; =============================================================================

 ;; all-entities-json-handler using fn-def composition
 ;; Uses :make-json-response-handler to wrap :list-all-graph-entities
 {:name :all-entities-json-handler
  :parent :make-json-response-handler
  :args {:data-fn :list-all-graph-entities}}

 ;; entity-details-handler using fn-def composition
 ;; Uses :make-html-response-handler to wrap :render-entity-details-view
 {:name :entity-details-handler
  :parent :make-html-response-handler
  :args {:render-fn :render-entity-details-view}}

 ;; entity-form-handler using fn-def composition
 ;; Uses :make-html-response-handler to wrap :render-entity-form-view
 {:name :entity-form-handler
  :parent :make-html-response-handler
  :args {:render-fn :render-entity-form-view}}

 ;; create-entity-api-handler using fn-def composition
 ;; Uses :make-html-action-handler to wrap :process-create-entity
 {:name :create-entity-api-handler
  :parent :make-html-action-handler
  :args {:action-fn :process-create-entity}}

 ;; delete-entity-api-handler using fn-def composition
 ;; Uses :make-html-action-handler to wrap :process-delete-entity
 {:name :delete-entity-api-handler
  :parent :make-html-action-handler
  :args {:action-fn :process-delete-entity}}]
