  ;; shared with the entity create/update handlers. ---
  {:name :_type-form-name-raw
   :parent :get
   :args {:coll :_parsed-body :key {:value :name} :default nil}}

  {:name :_type-form-ns-id-raw
   :parent :get
   :args {:coll :_parsed-body :key {:value :namespace-id} :default nil}}

  {:name :_create-record-type-parsed
   :description "Stage 1 of create-record-type — JSON body → `{:name :ns-id :description :fields}`."
   :parent :zipmap
   :args {:keys [{:value :name} {:value :ns-id} {:value :description} {:value :fields}]
          :vals [{:parent :if
