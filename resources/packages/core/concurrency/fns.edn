;; Concurrency / time primitives — atomic base-fns wrapping single
;; Clojure / Java primitives. Used to compose long-running patterns
;; (cron schedule, file watcher, queue consumer, websocket listener,
;; …) at the fn-def layer instead of monolithic base-fns.
;;
;; The vocabulary intentionally mirrors Clojure core: `:do` (sequence
;; effects), `:sleep` (Thread/sleep), `:future` (spawn daemon thread),
;; `:loop-until-interrupted` (cooperative-shutdown loop). When a future
;; pattern emerges we add another small primitive instead of a
;; pattern-specific base-fn.
;;
;; Effect declarations:
;; - `:sleep`   → `:time`
;; - `:future`  → `:process` (spawns supervised background work —
;;                this is the service-eligibility marker)
;; - `:do`, `:loop-until-interrupted` declare no effects of their
;;   own; they inherit whatever their body composes.


{:namespace "core.concurrency"
 :description "Concurrency / time primitives: sequencing, sleep, future spawning, interruption-bounded loops."
 :fns
 [;; ---------------------------------------------------------------------
  ;; :do — sequential evaluation of `:steps`; returns the LAST.
  ;;
  ;; `:steps` is `:lazy-seq-args` so each item arrives as a delay; the
  ;; impl forces them in declaration order, guaranteeing side effects
  ;; fire left-to-right. Without this, the executor is free to resolve
  ;; in parallel and the ordering would be undefined.
  ;; ---------------------------------------------------------------------
  {:name :do
   :description "Evaluate `:steps` in declaration order (left-to-right) and return the LAST. Use when a fn-graph needs explicit sequencing of effectful steps — e.g. inside a cron loop: `(do (sleep until-next) (invoke target))`."
   :args {:steps {:type [:list :any]
                  :description "Vector of values evaluated in order. Each may be a literal or a fn-ref. Side effects fire left-to-right; the result of the LAST entry is returned."}}
   :return-type :any}

  ;; ---------------------------------------------------------------------
  ;; :sleep — Thread/sleep wrapper. Honors Thread.interrupt so cooperative
  ;; shutdown from :future's stopper can unwind a sleeping loop cleanly.
  ;; ---------------------------------------------------------------------
  {:name :sleep
   :description "Block the current thread for `:ms` milliseconds. Honors Thread.interrupt — InterruptedException propagates so a cron loop's `:sleep` can be cut short when the parent :future's stopper fires. Returns nil. Non-positive `:ms` is treated as no-op."
   :args {:ms {:type :int
               :description "Milliseconds to block. Non-positive → returns immediately."}}
   :return-type :null
   :effects #{:time}}

  ;; ---------------------------------------------------------------------
  ;; :sleep-until-ms — block until a wall-clock target. Companion to
  ;; :sleep — composes cleanly with :cron-next-after (which returns an
  ;; epoch-ms target) without needing intermediate arithmetic.
  ;; ---------------------------------------------------------------------
  ;; ---------------------------------------------------------------------
  ;; :sleep-until-ms — kept as a defbase (not decomposed) because the
  ;; closure-capture / service-eligibility static analysis treats
  ;; `{:as :target-ms}` inside a `:list` binding as a free arg that
  ;; persists past the calling chain's `:target-ms`-slot binding,
  ;; which breaks `:my-cron`'s "no remaining free args" check (see
  ;; `closure_capture_test.clj`). The defbase keeps `:target-ms` as
  ;; a regular own slot so the binding chain collapses cleanly.
  ;; ---------------------------------------------------------------------
  {:name :sleep-until-ms
   :description "Block until the given epoch-ms target — or return immediately if already past. Honors Thread.interrupt. Composes with `:cron-next-after` for cron-driven loops."
   :args {:target-ms {:type :int :description "Wall-clock target in epoch milliseconds."}}
   :return-type :null
   :effects #{:time}}

  ;; ---------------------------------------------------------------------
  ;; :future — spawn body in a daemon thread; return stopper-thunk.
  ;;
  ;; The returned `[:fn {} :null]` callable, when invoked, interrupts
  ;; the spawned thread. This is what makes any composition built on
  ;; `:future` service-eligible — declares the `:process` effect AND
  ;; returns the right callable shape for the service registry.
  ;; ---------------------------------------------------------------------
  {:name :future
   :description "Spawn `:body` in a daemon thread, return a stopper-thunk. The returned `(fn [] ...)` interrupts the thread when invoked — InterruptedException propagates through any blocking call (`:sleep`, IO with interrupt support) inside the body. Body errors are logged but don't crash the spawner."
   :args {:body {:type [:fn {} :any]
                 :description "Zero-arg callable to run in the background thread. Typically wraps `:loop-until-interrupted` for long-lived patterns."}}
   :return-type [:fn {} :null]
   :effects #{:process}}

  ;; ---------------------------------------------------------------------
  ;; :loop-until-interrupted — body runs while !Thread.isInterrupted.
  ;;
  ;; Cooperative shutdown: the parent :future's stopper interrupts the
  ;; thread; the next `(.isInterrupted ...)` check or a thrown
  ;; InterruptedException from inside the body breaks the loop. Catches
  ;; the exception so unwinding is clean.
  ;; ---------------------------------------------------------------------
  {:name :loop-until-interrupted
   :description "Run `:body` repeatedly while `(Thread/isInterrupted)` is false. Exits cleanly when the parent :future's stopper interrupts the thread — either at the next loop boundary or via InterruptedException thrown from inside the body (e.g. by `:sleep`). Catches the exception so shutdown is clean."
   :args {:body {:type [:fn {} :any]
                 :description "Zero-arg callable invoked each iteration."}}
   :return-type :null}

  ;; ---------------------------------------------------------------------
  ;; :cron-next-after — pure cron-arithmetic primitive.
  ;;
  ;; Wraps `org.quartz.CronExpression.getNextValidTimeAfter` — Quartz's
  ;; well-tested cron parser. We depend on the cron-parser class only;
  ;; no Quartz scheduler runtime is used. Graphden's own :future +
  ;; :loop-until-interrupted drive the firing loop.
  ;;
  ;; Cron-6 syntax (Quartz): `sec min hr day-of-month mon day-of-week`,
  ;; e.g. `"0 */5 * * * ?"` = every 5 minutes, `"0 0 9 * * ?"` = 9am
  ;; daily. The `?` in day-of-week / day-of-month is "no specific value"
  ;; — Quartz requires it when one of the two is `*`.
  ;; ---------------------------------------------------------------------
  {:name :cron-parse
   :description "Parse a Quartz cron-6 expression (`sec min hr day-of-month mon day-of-week`) into an opaque `CronExpression` handle. Throws `:cron/parse-error` on malformed input. Compose with `:cron-fire-after` for cron-loop driving."
   :args {:cron {:type :text
                 :description "Quartz cron-6 expression: `sec min hr day-of-month mon day-of-week`."}}
   :return-type :any}

  {:name :cron-fire-after
   :description "Given a parsed `CronExpression` and current epoch-ms, return the NEXT epoch-ms that satisfies the cron. Pure arithmetic over a parsed handle — no string parsing per call."
   :args {:expr {:type :any
                 :description "Parsed handle from `:cron-parse`."}
          :now-ms {:type :int
                   :description "Current epoch milliseconds (from `:current-time-ms`)."}}
   :return-type :int}

  ;; Intermediate fn-def needed so `:cron` propagates as a free arg
  ;; of `:cron-next-after` (and onward to `:schedule`'s closure
  ;; capture). An inline anon `{:parent :cron-parse :args {:cron {:as
  ;; :cron}}}` binding wouldn't lift its rename through to the outer
  ;; fn-def — see `feedback_fn_def_arg_keyword_literal` memory.
  {:name :_cron-parsed
   :description "Parse the supplied `:cron` (free arg) into a `CronExpression` handle. Result-cached per top-level invocation."
   :parent :cron-parse
   :args {:cron {:as :cron}}}

  {:name :cron-next-after
   :description "Pure cron arithmetic — given a cron-6 expression and current epoch-ms, return the NEXT epoch-ms that satisfies the cron. Composition: `(cron-fire-after :_cron-parsed now-ms)`. The parse + fire are separated so admins can hoist parsing out of a tight loop by binding `:expr` to `:cron-parse` directly."
   :parent :cron-fire-after
   :args {:expr :_cron-parsed
          :cron {:type :text
                 :description "Cron-6 expression (sec min hour day mon dow) — parsed via `:_cron-parsed`'s result-cached `:cron-parse`."}}}

  ;; ---------------------------------------------------------------------
  ;; :schedule — pure fn-def composition over the concurrency primitives.
  ;;
  ;; A cron-driven supervised loop. Each tick computes the delay to the
  ;; next cron fire, sleeps, then invokes `:fn`. `:future` provides the
  ;; daemon-thread spawn (and the `:process` effect that makes
  ;; derivatives service-eligible); `:loop-until-interrupted` carries
  ;; the cooperative-shutdown semantics so the parent future's stopper
  ;; can unwind a sleeping iteration cleanly.
  ;;
  ;; Free args (closure-capture; see docs/CLOSURE_CAPTURE.md):
  ;;   :cron — Quartz cron-6 expression (string)
  ;;   :fn   — 0-arg callable to fire on each tick
  ;;
  ;; Both propagate up via:
  ;;   :cron-next-after's :cron free arg → :_next-fire-ms → :_next-delay-
  ;;   ms → :_sleep-to-next → list item in :_cron-step → captured-arg of
  ;;   :_cron-loop (via :loop-until-interrupted :body HOF boundary) →
  ;;   captured-arg of :schedule (via :future :body HOF boundary).
  ;;   Same shape for :fn via :_fire-target's :func rename.
  ;;
  ;; Admin usage:
  ;;   {:name :my-cron :parent :schedule :args {:cron "0 */5 * * * ?"
  ;;                                              :fn :my-tick-fn}}
  ;; Then `:my-cron` has zero free args and is service-eligible
  ;; (inherits :process via :schedule → :future).
  ;; ---------------------------------------------------------------------
  {:name :schedule
   :description "Run `:fn` on every fire of a cron schedule. Spawns a daemon thread (inherits `:process` effect from `:future`), loops with cooperative shutdown via Thread.interrupt. Derivatives that bind `:cron` and `:fn` are service-eligible."
   :parent :future
   :args {:body :_cron-loop}
   ;; Runtime-config marker — see graphden.versioning.branch-local.
   ;; A cron schedule (string) is per-environment (dev → every 5s for
   ;; fast iteration, prod → hourly). Sticky-local so `{:parent :schedule}`
   ;; user fn-defs never carry a dev cadence to prod via merge.
   :branch-local? true}

  {:name :_cron-loop
   :description "Cron-driven cooperative loop body — sleeps to the next fire then invokes the captured `:fn`, repeating until interrupted."
   :parent :loop-until-interrupted
   :args {:body :_cron-step}}

  {:name :_cron-step
   :description "One iteration of the cron loop: sleep until next fire, then invoke `:fn`. Steps fire left-to-right (:do's :lazy-seq-args semantics)."
   :parent :do
   :args {:steps [:_sleep-to-next :_fire-target]}}

  {:name :_sleep-to-next
   :description "Sleep until the next cron fire — `:sleep-until-ms` consumes `:_next-fire-ms` (epoch target). Honors Thread.interrupt so the parent :future's stopper can cut the sleep short."
   :parent :sleep-until-ms
   :args {:target-ms :_next-fire-ms}}

  {:name :_next-fire-ms
   :description "Epoch-ms of the next cron fire after the current time."
   :parent :cron-next-after
   :args {:now-ms :current-time-ms}}

  {:name :_fire-target
   :description "Invoke the captured `:fn` with no arguments. The slot's bare `[:fn {} a]` shape makes the binding-site hof-wrap, capturing the calling scope's `:fn` value."
   :parent :call-noargs
   :args {:func {:as :fn}}}

  ;; ---------------------------------------------------------------------
  ;; Mutable-state primitives — `clojure.core` atom + swap + deref.
  ;; Two lifetimes (see impls.clj header):
  ;;   :atom — fresh per top-level `execute` (result-cache-scoped) —
  ;;           backs the `:try`-journal idiom (each request its own
  ;;           independent rollback journal).
  ;;   :cell — persistent per compiled registry (`:compile-time-value?`,
  ;;           baked once like a `:const`) — survives across `execute`s,
  ;;           so `:cell` + `:swap` + `:deref` is a real in-process cache.
  ;;           Per-instance only (not shared across executor pods — that
  ;;           needs an external store).
  ;; `:swap` / `:deref` are lifetime-agnostic; `:swap-conj` is a fn-def
  ;; over `:swap` (the conj is graph-visible, not a bespoke impl).
  ;; ---------------------------------------------------------------------

  {:name :atom
   :description "Create a fresh `clojure.core/atom` holding `:initial-value`. The same fn-def (referenced multiple times in one composition) hands back the SAME atom instance per top-level call — that's the mechanism that lets every `:try`-body phase share a journal. For state that must persist ACROSS calls (a cache), use `:cell`."
   :args {:initial-value {:type :any
                          :description "Value the atom starts holding."}}
   :return-type :any}

  {:name :cell
   :description "Create a PERSISTENT `clojure.core/atom` holding `:initial-value`. Unlike `:atom`, the instance is allocated ONCE per compiled registry and baked into the closure (like a `:const` literal), so it survives across `execute`s — `:cell` + `:swap` + `:deref` composes an in-process cache. Scope is the compiling registry (per-JVM for the server handler); NOT shared across executor instances. Re-allocated on recompile = cache reset. Persistence requires `:initial-value` to be a LITERAL (compile-time constant); bound to a fn-ref instead, a `:cell` degrades to per-call `:atom` semantics (a fresh instance each call)."
   :args {:initial-value {:type :any
                          :description "Literal value the cell starts holding. A fn-ref works but forfeits persistence (per-call, like `:atom`)."}}
   :return-type :any}

  {:name :swap
   :description "`(swap! :a :func)` — atomically apply the 1-arg `:func` to the atom's current value and install the result (`clojure.core/swap!`). Returns the new value. `:func` is `:fn`-typed; fold extra data in by closure-capturing it in the callback (see `:swap-conj`). `:func` must be pure so a CAS retry is safe."
   :args {:a {:type :any :description "Atom (from `:atom` or `:cell`)."}
          :func {:type [:fn {:current a} a #{}]
                 :description "Pure 1-arg callable `a → a` — receives the current value, returns the next of the same type. Type var `a` lets the callback narrow the value type (e.g. a map for a keyed cache) without an `:any`-param contravariance clash. Extra inputs are closure-captured."}}
   :return-type :any
   :effects #{:state}}

  ;; Closure-capturing callback for `:swap-conj`: the per-call `:current`
  ;; is the atom's value (the HOF lambda param, matching `:swap`'s
  ;; `:func` param name); `:value` is captured from the call site and
  ;; conj'd on. `:coll` widened to `:any` so it unifies with `:swap`'s
  ;; `:any` lambda-param type. Private — only meaningful under `:swap-conj`.
  {:name :_conj-into
   :description "`(conj current value)` as a 1-arg swap callback — `:current` supplied per-swap, `:value` closure-captured."
   :parent :conj
   :args {:coll {:as :current :type :any}
          :item {:as :value}}}

  {:name :swap-conj
   :description "`(swap! :a conj :value)` — append `:value` to a vector-holding atom. Returns the new vector. Now a fn-def over `:swap` + `:_conj-into` (the conj is graph-visible composition, not a bespoke impl). Atomic at the JVM level."
   :parent :swap
   :args {:func :_conj-into}}

  {:name :deref
   :description "`@:a` — read the current value of an atom (`clojure.core/deref`). Works on both `:atom` and `:cell`."
   :args {:a {:type :any :description "Atom to read."}}
   :return-type :any}]}
