;; System information and Ring response primitives
;; ring-response, make-handler, to-json-string, jvm-info, current-time-ms


{:namespace "core.system"
 :fns
 [{:name :ring-response
   :args {:status :int
          :headers :jsonb
          :body :text}
   :return-type :jsonb}

  {:name :make-handler
   :args {:response :jsonb}
   :return-type :fn}

  ;; =============================================================================
  ;; HANDLER FACTORIES (base-fns)
  ;; =============================================================================

  ;; Data handler: data-fn(request) -> data, body-fn(data) -> body string
  {:name :make-data-handler
   :args {:data-fn :fn
          :body-fn :fn
          :status :int
          :headers :jsonb}
   :return-type :fn}

  ;; Action handler: action-fn(request) -> {:status :headers :body}
  {:name :make-action-handler
   :args {:action-fn :fn
          :base-headers :jsonb}
   :return-type :fn}

  ;; =============================================================================
  ;; FN-DEFS: Specialized handlers via inheritance
  ;; =============================================================================

  ;; JSON data handler - data-fn returns data, serialized to JSON
  {:name :make-json-response-handler
   :parent :make-data-handler
   :args {:body-fn :to-json-string
          :status 200
          :headers {"Content-Type" "application/json"}
          :data-fn {:as :data-fn}}}

  ;; HTML data handler - data-fn returns hiccup, rendered to HTML
  {:name :make-html-response-handler
   :parent :make-data-handler
   :args {:body-fn :render-hiccup
          :status 200
          :headers {"Content-Type" "text/html; charset=utf-8"}
          :data-fn {:as :render-fn}}}

  ;; HTML action handler - action-fn returns full response map
  {:name :make-html-action-handler
   :parent :make-action-handler
   :args {:base-headers {"Content-Type" "text/html; charset=utf-8"}
          :action-fn {:as :action-fn}}}

  {:name :to-json-string
   :args {:data :any}
   :return-type :text}

  {:name :parse-json
   :args {:string :text
          :keywordize {:type :bool :value true}}
   :return-type :jsonb}

  {:name :jvm-version
   :args {}
   :return-type :jsonb}

  {:name :heap-memory
   :args {}
   :return-type :jsonb}

  {:name :thread-count
   :args {}
   :return-type :int}

  {:name :os-info
   :args {}
   :return-type :jsonb}

  ;; jvm-info composed from atomic base-fns via assoc chain
  {:name :_jvm-section
   :parent :assoc-empty
   :args {:key "jvm" :value :jvm-version}}

  {:name :_memory-section
   :parent :assoc
   :args {:map :_jvm-section :key "memory" :value :heap-memory}}

  {:name :_threads-section
   :parent :assoc
   :args {:map :_memory-section :key "threads" :value :thread-count}}

  {:name :jvm-info
   :parent :assoc
   :args {:map :_threads-section :key "os" :value :os-info}}

  {:name :current-time-ms
   :args {}
   :return-type :int}

  ;; Read environment variable
  {:name :env
   :args {:name :text}
   :return-type :text}

  ;; Construct an ExceptionInfo. Paired with :throw to raise from
  ;; graph code; also usable as a plain value if something wants a
  ;; ready-made exception without raising.
  {:name :ex-info
   :args {:message :text
          :data :jsonb}
   :return-type :any}

  ;; Raise the given exception. :return-type is :any because control
  ;; flow never returns, but the graph-level caller needs a placeholder.
  {:name :throw
   :args {:exception :any}
   :return-type :any}

  ;; `:env-required` is now a fn-def (see below) composing :env with
  ;; :if + :throw + :ex-info — kept here as a forward declaration so
  ;; consumers reading fns.edn see the spec in one place.
  {:name :env-required
   :parent :if
   :args {:test :_env-blank?
          :then :_env-missing-throw
          :else :_env-value}}

  {:name :_env-value
   :parent :env
   :args {:name {:as :name}}}

  {:name :_env-blank?
   :parent :blank?
   :args {:string :_env-value}}

  {:name :_env-missing-message
   :parent :str
   :args {:parts :_env-missing-message-parts}}

  {:name :_env-missing-message-parts
   :parent :list
   :args {:items [{:value "Required env var "}
                  :_env-name-as-string
                  {:value " is not set"}]}}

  {:name :_env-name-as-string
   :parent :identity
   :args {:value {:as :name}}}

  {:name :_env-missing-error
   :parent :ex-info
   :args {:message :_env-missing-message
          :data {"type" "execution-error/missing-env-var"}}}

  {:name :_env-missing-throw
   :parent :throw
   :args {:exception :_env-missing-error}}

  ;; Read file from classpath resources
  {:name :read-resource
   :args {:path :text}
   :return-type :text}

  ;; Load multiple resource files and concatenate with separator
  {:name :concat-resources
   :args {:paths :jsonb
          :separator {:type :text :value "\n\n"}}
   :return-type :text}

  ;; Call a Clojure fn (from :any arg) with one argument
  {:name :invoke
   :args {:func :any, :arg :any}
   :return-type :any}

  ;; Read an InputStream/Reader to string
  {:name :slurp
   :args {:input :any}
   :return-type :text}]}
