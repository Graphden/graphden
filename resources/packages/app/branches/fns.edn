;; Read-side fn-defs for the /api/branches/* and
;; /api/fns/:fn-id/versions endpoints.
;;
;; Each `_*-data` base-fn returns the JSON-shape payload; the
;; matching `*-handler` wraps it with the `:json-handler` template
;; (200 application/json). Concrete routes live in `app.routes`.
;;
;; All four endpoints are read-only — handlers stay unauthenticated
;; for now (mirrors GET /api/graph/entities). Write endpoints
;; (POST/DELETE/merge) land in a follow-up commit and inherit the
;; auth-required preset.


{:namespace "app.branches"
 :description "Read-side endpoints for the versioning UI — list branches, look up one branch, list a fn's version history, diff two branches. Backed by `graphden.crud.branches` + `graphden.versioning.storage.{core,merge}`. Concrete routes are wired in `app.routes`."
 :fns
 [;; ---------------------------------------------------------------------
  ;; BASE-FN — shared branch lookup. Accepts a UUID string or a name,
  ;; returns the branch row or nil. Composed by every parser-driven
  ;; lookup (diff / conflicts / merge / delete) instead of going through
  ;; per-handler defbase shims.
  ;; ---------------------------------------------------------------------

  {:name :resolve-branch-ref
   :description "Look up a branch by `:ref` — accepts either a stringified UUID or a branch name. Returns the row, or nil when not found / ref is blank / ref isn't a string. Operates on the unwrapped base storage so reads see across versions."
   :args {:ref {:type :nullable-text :required false :description "UUID string or branch name. Non-string / blank → nil."}}
   :return-type [:union :null :branch-row-shape]
   :effects #{:db}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/branches — list every branch row, ordered by created-at.
  ;; ---------------------------------------------------------------------

  ;; GET /api/branches — graph composition: list-entities → sort-by
  ;; created-at → :map :as-json-branch → :zipmap envelope.
  ;; Reuses the same `:as-json-branch` row converter as
  ;; `:_get-branch-data`. Admin extension surface:
  ;;   * `:_list-branches-sort-key` — sort dimension (created-at /
  ;;     name / base-branch chain).
  ;;   * `:as-json-branch` — per-row JSON shape (single point of
  ;;     variation; touching this changes EVERY branch-returning
  ;;     handler too).
  ;;   * `:_list-branches-data` envelope — `{:ok :count :branches}`
  ;;     shape; replace for JSON:API, pagination, etc.
  ;; Row load goes through `:pg-query` + per-row `:decode-row` rather
  ;; than the generic `:list-entities` wrap. `:branch` is non-versioned
  ;; (per `versioning.storage.resolution/entity-config`), so a raw
  ;; pg-query bypasses the version-resolution layer correctly. The
  ;; HoneySQL is visible at the graph level — admins can add `:where` /
  ;; extra columns without touching the generic loader.
  {:name :_list-branches-rows
   :parent :map
   :args {:func :_list-branches-decode-row
          :coll :_list-branches-rows-raw}}

  {:name :_list-branches-rows-raw
   :description "Raw `SELECT * FROM branch` — snake_case column keys, undecoded enum/jsonb. Decoded per-row by `:_list-branches-decode-row`."
   :parent :storage-query-call
   :args {:arg {:value {:select [:*] :from :branch}}}}

  {:name :_list-branches-decode-row
   :description "HOF callback — decode one raw `:branch` row to graphden's canonical shape."
   :parent :decode-row
   :return-type :branch-row-shape
   :args {:row {:as :item}
          :entity-type {:value "branch"}}}

  {:name :_list-branches-sort-key
   :description "Per-row sort key — `:created-at` ascending (so the editor renders the forked-from chain in order)."
   :parent :get
   :args {:coll {:as :item} :key {:value :created-at} :default nil}}

  {:name :_list-branches-sorted
   :parent :sort-by
   :args {:key-fn :_list-branches-sort-key :coll :_list-branches-rows}}

  ;; HOF callback wrapping `:as-json-branch` — the free arg surface
  ;; differs (`:as-json-branch` expects `:branch-row`, HOF binds
  ;; `:item`). Bridge via an intermediate fn-def.
  {:name :_list-branches-as-json-item
   :parent :as-json-branch
   :args {:branch-row {:as :item}}}

  {:name :_list-branches-json
   :parent :map
   :args {:func :_list-branches-as-json-item
          :coll :_list-branches-sorted}}

  {:name :_list-branches-count
   :parent :count
   :args {:coll :_list-branches-sorted}}

  {:name :_list-branches-data
   :description "GET /api/branches — every :branch row off base storage, sorted by `:created-at` ascending, shaped via `:as-json-branch`."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :count} {:value :branches}]
          :vals [{:value true} :_list-branches-count :_list-branches-json]}}

  {:name :list-branches-handler
   :lambda-params []
   :description "Ring handler for GET /api/branches."
   :parent :json-handler
   :args {:data :_list-branches-data}}

  ;; ---------------------------------------------------------------------
  ;; Shared JSON-coercion helpers — reused by branch / fn-version /
  ;; diff-entry / conflict-entry response shapes. Stringify any UUID
  ;; or timestamp value so jsonista doesn't choke.
  ;; ---------------------------------------------------------------------

  {:name :_is-uuid-or-inst?
   :description "True for values that need stringification before JSON encode — UUIDs and timestamps. Other scalars (bool / string / int) pass through. HOF-shaped: reads `:value` from the per-call binding."
   :parent :or
   :args {:values [{:parent :is-a? :args {:value {:as :value} :type {:value :uuid}}}
                   {:parent :is-a? :args {:value {:as :value} :type {:value :timestamptz}}}]}}

  {:name :_stringify-uuid-or-inst
   :description "HOF callable for `:update-vals` — stringify a UUID / timestamp, pass everything else through."
   :parent :if
   :args {:test :_is-uuid-or-inst?
          :then {:parent :to-str :args {:value {:as :value}}}
          :else {:as :value}}}

  {:name :stringify-uuids
   :description "Shallow stringify of UUIDs and timestamps in a map's values (mirrors `branches/stringify-uuids` Clojure helper). Nil-safe — `nil` in → `nil` out. Reused by diff-entry and conflict-entry per-row reshapes."
   :parent :if
   :args {:test {:parent :some? :args {:value {:as :m}}}
          :then {:parent :update-vals
                 :args {:m {:as :m} :f :_stringify-uuid-or-inst}}
          :else {:value nil}}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/branches/:ref — one branch (by UUID or name).
  ;; ---------------------------------------------------------------------

  ;; GET /api/branches/:ref — graph composition over the already-
  ;; decomposed `:resolve-branch-ref` plus a reusable
  ;; `:as-json-branch` row-to-JSON converter. Admins can:
  ;;   * Replace `:as-json-branch` to expose extra columns or different
  ;;     field names (`{:ok :data}` instead of `{:ok :branch}`, add a
  ;;     `:metadata` field, etc.).
  ;;   * Replace `:_get-branch-success` / `:_get-branch-err` to change
  ;;     the response envelope shape entirely.
  ;;   * The same `:as-json-branch` is reused by `:_list-branches-data`
  ;;     when it's eventually decomposed — single point of variation.
  {:name :_branch-row-id
   :parent :get
   :args {:coll {:as :branch-row} :key {:value :id} :default nil}}

  {:name :_branch-row-name
   :parent :get
   :args {:coll {:as :branch-row} :key {:value :name} :default nil}}

  {:name :_branch-row-base-branch-id
   :parent :get
   :args {:coll {:as :branch-row} :key {:value :base-branch-id} :default nil}}

  {:name :_branch-row-created-at
   :parent :get
   :args {:coll {:as :branch-row} :key {:value :created-at} :default nil}}

  {:name :_branch-id-str
   :description "Nil-safe `(str :id)`."
   :parent :if
   :args {:test {:parent :some? :args {:value :_branch-row-id}}
          :then {:parent :to-str :args {:value :_branch-row-id}}
          :else nil}}

  {:name :_branch-base-id-str
   :description "Nil-safe `(some-> :base-branch-id str)`."
   :parent :if
   :args {:test {:parent :some? :args {:value :_branch-row-base-branch-id}}
          :then {:parent :to-str :args {:value :_branch-row-base-branch-id}}
          :else nil}}

  {:name :_branch-created-at-str
   :description "Nil-safe `(some-> :created-at str)`."
   :parent :if
   :args {:test {:parent :some? :args {:value :_branch-row-created-at}}
          :then {:parent :to-str :args {:value :_branch-row-created-at}}
          :else nil}}

  {:name :as-json-branch
   :description "Convert a `:branch` storage row into a JSON-safe map — `{:id (str id) :name name :base-branch-id (some-> base-branch-id str) :created-at (some-> created-at str) :owner-id owner-id :write-policy write-policy}`. Own pin `:branch-row`. Used by `:_get-branch-data` and reusable by any other handler that surfaces a branch row."
   :parent :zipmap
   :args {:keys [{:value :id} {:value :name} {:value :base-branch-id} {:value :created-at} {:value :owner-id} {:value :write-policy} {:value :require-merge?} {:value :review-state}]
          :vals [:_branch-id-str
                 :_branch-row-name
                 :_branch-base-id-str
                 :_branch-created-at-str
                 {:parent :get :args {:coll {:as :branch-row} :key {:value :owner-id} :default nil}}
                 {:parent :get :args {:coll {:as :branch-row} :key {:value :write-policy} :default nil}}
                 {:parent :get :args {:coll {:as :branch-row} :key {:value :require-merge?} :default nil}}
                 {:parent :get :args {:coll {:as :branch-row} :key {:value :review-state} :default nil}}]
          :branch-row {:type :nullable-keyword-map
                       :description "Storage row of a `:branch` entity — fields stringified for the JSON wire."}}}

  {:name :_get-branch-ref
   :description "URL segment after `branches/` — the UUID or name to resolve."
   :parent :uri-segment-after
   :args {:marker {:value "branches"}}}

  {:name :_get-branch-row
   :description "Resolve the URL ref to a `:branch` row, or nil when not found."
   :parent :resolve-branch-ref
   :args {:ref :_get-branch-ref}}

  {:name :_get-branch-found?
   :parent :some?
   :args {:value :_get-branch-row}}

  {:name :_get-branch-as-json
   :description "Apply `:as-json-branch` to the resolved row."
   :parent :as-json-branch
   :args {:branch-row :_get-branch-row}}

  {:name :_get-branch-success
   :description "Success shape — `{:ok true :branch <json>}`."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :branch}]
          :vals [{:value true} :_get-branch-as-json]}}

  {:name :_get-branch-err
   :description "Not-found shape — `{:ok false :reason :not-found :error \"Branch not found: <ref>\"}`. Same envelope as the delete-branch not-found sibling."
   :parent :zipmap
   :return-type :_error-result-with-reason-shape
   :args {:keys [{:value :ok} {:value :reason} {:value :error}]
          :vals [{:value false}
                 {:value :not-found}
                 {:parent :str :args {:parts ["Branch not found: " :_get-branch-ref]}}]}}

  {:name :_get-branch-data
   :description "GET /api/branches/:ref — `:_get-branch-success` when the row resolves, `:_get-branch-err` otherwise. Pure graph composition over `:resolve-branch-ref` + `:as-json-branch` + `:zipmap`."
   :parent :if
   :args {:test :_get-branch-found?
          :then :_get-branch-success
          :else :_get-branch-err}}

  {:name :get-branch-handler
   :lambda-params [:request :default]
   :description "Ring handler for GET /api/branches/:ref."
   :parent :json-handler
   :args {:data :_get-branch-data}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/fns/:fn-id/versions — history of one fn across branches.
  ;; ---------------------------------------------------------------------

  ;; `:list-fn-versions` is a full graph decomposition — multi-query
  ;; join over `:list-entities` + `:group-by` + `:update-vals`
  ;; + `:sort-by` + per-row HOF chain producing the JSON shape, plus
  ;; the envelope `{:ok :fn-id :count :versions}`.
  ;;
  ;; Admin extension surface — every field can be varied independently:
  ;;   * `:_lfv-version-fields` — bare-row field set. Add / remove
  ;;     columns by swapping this list.
  ;;   * `:_lfv-stringify-uuid-or-inst` — value transform. Swap for a
  ;;     custom timestamp formatter (ISO-8601, epoch-ms, etc.).
  ;;   * `:_lfv-version-row` — the assoc'd shape per version. Add
  ;;     custom computed fields (last-executor, latency stats, …).
  ;;   * `:_lfv-version-sort-key` — change the sort dimension
  ;;     (latest first → oldest first, or sort by execution-count).

  ;; --- URL / fn-id extraction
  {:name :_list-fn-versions-fn-id-raw
   :description "Raw `:fn-id` segment from `/api/fns/:fn-id/versions`."
   :parent :uri-segment-after
   :args {:marker {:value "fns"}}}

  {:name :_list-fn-versions-fn-id
   :description "Parsed UUID (nil when missing / malformed)."
   :parent :parse-uuid
   :args {:string :_list-fn-versions-fn-id-raw}}

  ;; --- Query #1: versions for the fn-id.
  ;; Direct `:pg-query` + per-row `:decode-row` over `:fn-version`.
  ;; `:fn-version` is itself a
  ;; non-versioned write-once log (the version-history of `:fn`),
  ;; so bypassing the version-resolution layer is correct.
  {:name :_lfv-versions-from-storage
   :parent :map
   :args {:func :_lfv-versions-decode-row
          :coll :_lfv-versions-raw}}

  {:name :_lfv-versions-raw
   :parent :storage-query-call
   :args {:arg :_lfv-versions-hsql}}

  {:name :_lfv-versions-hsql
   :parent :assoc
   :args {:map {:value {:select [:*] :from :fn-version}}
          :key {:value :where}
          :value :_lfv-versions-hsql-where}}

  {:name :_lfv-versions-hsql-where
   :parent :vec
   :args {:coll [{:value :=} {:value :fn-id} {:as :fn-id}]}}

  {:name :_lfv-versions-decode-row
   :parent :decode-row
   :return-type :fn-version-row-shape
   :args {:row {:as :item} :entity-type {:value "fn-version"}}}

  {:name :_lfv-versions
   :description "Empty when fn-id is nil; otherwise the live version rows."
   :parent :if
   :args {:test {:parent :some? :args {:value {:as :fn-id}}}
          :then :_lfv-versions-from-storage
          :else {:value []}}}

  ;; --- Sort: descending by :created-at.
  {:name :_lfv-version-sort-key
   :description "Per-row sort key — `:created-at`. Swap to sort by something else (e.g. `:_lfv-version-execution-count`)."
   :parent :get
   :args {:coll {:as :item} :key {:value :created-at} :default nil}}

  {:name :_lfv-versions-sorted-asc
   :parent :sort-by
   :args {:key-fn :_lfv-version-sort-key :coll :_lfv-versions}}

  {:name :_lfv-versions-sorted
   :description "Latest first."
   :parent :reverse
   :args {:coll :_lfv-versions-sorted-asc}}

  ;; --- Compute distinct, non-nil referenced branch-ids.
  {:name :_lfv-extract-branch-id
   :parent :get
   :args {:coll {:as :item} :key {:value :branch-id} :default nil}}

  {:name :_lfv-version-branch-ids
   :parent :map
   :args {:func :_lfv-extract-branch-id :coll :_lfv-versions}}

  {:name :_lfv-version-branch-ids-non-nil
   :parent :filter
   :args {:pred :some? :coll :_lfv-version-branch-ids}}

  {:name :_lfv-branch-ids-vec
   :parent :vec
   :args {:coll {:parent :distinct :args {:coll :_lfv-version-branch-ids-non-nil}}}}

  ;; --- Query #2: branches by IN(branch-ids).
  ;; HoneySQL emits `id IN (?, ?, ...)` via `[:in :id <ids-vec>]` —
  ;; the same shape `:list-entities`'s collection-value heuristic
  ;; produces internally.
  {:name :_lfv-branches-from-storage
   :parent :map
   :args {:func :_lfv-branches-decode-row
          :coll :_lfv-branches-raw}}

  {:name :_lfv-branches-raw
   :parent :storage-query-call
   :args {:arg :_lfv-branches-hsql}}

  {:name :_lfv-branches-hsql
   :parent :assoc
   :args {:map {:value {:select [:*] :from :branch}}
          :key {:value :where}
          :value :_lfv-branches-hsql-where}}

  {:name :_lfv-branches-hsql-where
   :parent :vec
   :args {:coll [{:value :in} {:value :id} :_lfv-branch-ids-vec]}}

  {:name :_lfv-branches-decode-row
   :parent :decode-row
   :return-type :branch-row-shape
   :args {:row {:as :item} :entity-type {:value "branch"}}}

  {:name :_lfv-branches
   :description "Skip the read when no branches are referenced."
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_lfv-branch-ids-vec}}
          :then {:value []}
          :else :_lfv-branches-from-storage}}

  ;; --- Build {branch-id → branch} index for the join.
  {:name :_lfv-branch-id-of
   :parent :get
   :args {:coll {:as :item} :key {:value :id} :default nil}}

  {:name :_lfv-branch-id-pair
   :parent :vec
   :args {:coll [:_lfv-branch-id-of {:as :item}]}}

  {:name :_lfv-branch-id-pairs
   :parent :map
   :args {:func :_lfv-branch-id-pair :coll :_lfv-branches}}

  {:name :_lfv-branches-by-id
   :parent :pairs->map
   :args {:entries :_lfv-branch-id-pairs}}

  ;; --- Query #3: executions by IN(version-ids), grouped + counted.
  {:name :_lfv-version-id-of
   :parent :get
   :args {:coll {:as :item} :key {:value :id} :default nil}}

  {:name :_lfv-version-id-list
   :parent :map
   :args {:func :_lfv-version-id-of :coll :_lfv-versions}}

  {:name :_lfv-version-ids-vec
   :parent :vec
   :args {:coll :_lfv-version-id-list}}

  ;; --- Query #3: executions by IN(version-ids).
  ;; Same IN-clause pattern as branches.
  {:name :_lfv-execs-from-storage
   :parent :map
   :args {:func :_lfv-execs-decode-row
          :coll :_lfv-execs-raw}}

  {:name :_lfv-execs-raw
   :parent :storage-query-call
   :args {:arg :_lfv-execs-hsql}}

  {:name :_lfv-execs-hsql
   :parent :assoc
   :args {:map {:value {:select [:*] :from :fn-execution}}
          :key {:value :where}
          :value :_lfv-execs-hsql-where}}

  {:name :_lfv-execs-hsql-where
   :parent :vec
   :args {:coll [{:value :in} {:value :fn-version-id} :_lfv-version-ids-vec]}}

  {:name :_lfv-execs-decode-row
   :parent :decode-row
   :return-type :fn-execution-row-shape
   :args {:row {:as :item} :entity-type {:value "fn-execution"}}}

  {:name :_lfv-execs
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_lfv-version-ids-vec}}
          :then {:value []}
          :else :_lfv-execs-from-storage}}

  {:name :_lfv-exec-version-id
   :parent :get
   :args {:coll {:as :item} :key {:value :fn-version-id} :default nil}}

  {:name :_lfv-execs-by-version-id
   :parent :group-by
   :args {:key-fn :_lfv-exec-version-id :coll :_lfv-execs}}

  {:name :_lfv-count-callable
   :description "HOF callable for `:update-vals` — replace each grouped execution-list with its count."
   :parent :count
   :args {:coll {:as :value}}}

  {:name :_lfv-exec-counts
   :description "`{version-id → execution-count}` index."
   :parent :update-vals
   :args {:m :_lfv-execs-by-version-id :f :_lfv-count-callable}}

  ;; --- Per-row JSON shape (HOF callback over sorted versions).
  {:name :_lfv-version-selected
   :description "Pick the bare fn-version columns. Admin extension point: add / remove keys to change the bare-row field set."
   :parent :select-keys
   :args {:m {:as :item}
          :ks [{:value :id} {:value :name} {:value :description}
               {:value :constraint}
               {:value :base-fn-id} {:value :element-fn-id}
               {:value :return-type-fn-id} {:value :anonymous-hash}
               {:value :expects-effects} {:value :created-at}
               {:value :deleted-at}]}}

  {:name :_lfv-version-base
   :description "Bare fn-version JSON shape — selected columns with UUIDs and timestamps stringified via the shared `:_stringify-uuid-or-inst` helper."
   :parent :update-vals
   :args {:m :_lfv-version-selected :f :_stringify-uuid-or-inst}}

  ;; The three computed fields (assoc'd onto :_lfv-version-base).
  {:name :_lfv-version-branch-id-raw
   :parent :get
   :args {:coll {:as :item} :key {:value :branch-id} :default nil}}

  {:name :_lfv-version-branch-id-str
   :description "Nil-safe stringified branch-id."
   :parent :if
   :args {:test {:parent :some? :args {:value :_lfv-version-branch-id-raw}}
          :then {:parent :to-str :args {:value :_lfv-version-branch-id-raw}}
          :else nil}}

  {:name :_lfv-version-branch
   :parent :get
   :args {:coll :_lfv-branches-by-id
          :key :_lfv-version-branch-id-raw
          :default nil}}

  {:name :_lfv-version-branch-name
   :parent :get
   :args {:coll :_lfv-version-branch
          :key {:value :name}
          :default nil}}

  {:name :_lfv-version-execution-count
   :parent :get
   :args {:coll :_lfv-exec-counts
          :key :_lfv-version-id-of
          :default {:value 0}}}

  ;; Assoc the three computed fields onto the bare row, one at a time.
  {:name :_lfv-row-with-branch-id
   :parent :assoc
   :args {:map :_lfv-version-base
          :key {:value :branch-id}
          :value :_lfv-version-branch-id-str}}

  {:name :_lfv-row-with-branch-name
   :parent :assoc
   :args {:map :_lfv-row-with-branch-id
          :key {:value :branch-name}
          :value :_lfv-version-branch-name}}

  {:name :_lfv-version-row
   :description "Per-row HOF callback — bare row + branch-id + branch-name + execution-count."
   :parent :assoc
   :args {:map :_lfv-row-with-branch-name
          :key {:value :execution-count}
          :value :_lfv-version-execution-count}}

  ;; Map the per-row builder over sorted versions.
  {:name :_lfv-versions-json
   :parent :map
   :args {:func :_lfv-version-row :coll :_lfv-versions-sorted}}

  ;; --- Final envelope.
  {:name :_lfv-fn-id-str
   :parent :if
   :args {:test {:parent :some? :args {:value {:as :fn-id}}}
          :then {:parent :to-str :args {:value {:as :fn-id}}}
          :else nil}}

  {:name :_lfv-version-count
   :parent :count
   :args {:coll :_lfv-versions-sorted}}

  {:name :list-fn-versions
   :description "Full version-list response for one logical fn — `{:ok true :fn-id (str fn-id) :count N :versions [...]}`. Empty `:versions` when `:fn-id` is nil. `:fn-id` is the own public pin — reusable by any handler that needs this shape."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :fn-id} {:value :count} {:value :versions}]
          :vals [{:value true} :_lfv-fn-id-str :_lfv-version-count :_lfv-versions-json]
          :fn-id {:type :nullable-uuid
                  :description "Logical fn-id whose version history is being listed; nil → empty `:versions`. The JSON envelope stringifies via `:_lfv-fn-id-str`."}}}

  ;; Handler entry point.
  {:name :_list-fn-versions-data
   :description "GET /api/fns/:fn-id/versions — URL extraction → `:list-fn-versions`."
   :parent :list-fn-versions
   :args {:fn-id :_list-fn-versions-fn-id}}

  {:name :list-fn-versions-handler
   :lambda-params [:storage-query :request :default]
   :description "Ring handler for GET /api/fns/:fn-id/versions."
   :parent :json-handler
   :args {:data :_list-fn-versions-data}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/branches/:ref/diff?against=<source-ref> — resolved-view
  ;; diff between two branches.
  ;; ---------------------------------------------------------------------

  ;; --- diff-branches ---
  {:name :_branches-target-ref
   :description "Target branch ref extracted from `/api/branches/:target/…` — shared by diff / conflicts / merge / delete parsers."
   :parent :uri-segment-after
   :args {:marker {:value "branches"}}}

  {:name :_query-params
   :description "Parsed query-string of the Ring request (`{key value}` map, repeated keys collapse to last). Shared by diff + conflicts."
   :parent :parse-query-string
   :args {:string :ring-query-string}}

  {:name :_diff-against-ref
   :description "Raw `against=` query-param value, or nil."
   :parent :get
   :args {:coll :_query-params
          :key {:value "against"}
          :default nil}}

  {:name :_diff-parsed
   :description "Parse `GET /api/branches/:target/diff?against=<source>` into `{:target-ref :against-ref}`. Pure graph composition over `:uri-segment-after` + `:parse-query-string` + `:zipmap`."
   :parent :zipmap
   :args {:keys [{:value :target-ref} {:value :against-ref}]
          :vals [:_branches-target-ref :_diff-against-ref]}}

  ;; Shared across the diff / conflicts / merge handlers — every
  ;; branch-op request resolves its target (and optional source) the
  ;; same way, off the same `parsed` shape.
  {:name :_target-branch
   :description "Resolve the target branch by ref; nil when missing. `:resolve-branch-ref` over `(get parsed :target-ref)`."
   :parent :resolve-branch-ref
   :args {:ref {:parent :get :args {:coll {:as :parsed} :key {:value :target-ref} :default nil}}}}

  {:name :_source-branch
   :description "Resolve the source branch when supplied; nil otherwise. `:resolve-branch-ref` over `(get parsed :source-ref)`."
   :parent :resolve-branch-ref
   :args {:ref {:parent :get :args {:coll {:as :parsed} :key {:value :source-ref} :default nil}}}}

  {:name :_diff-source-branch
   :description "Resolve the source branch when `?against=` was supplied; nil otherwise."
   :parent :resolve-branch-ref
   :args {:ref {:parent :get :args {:coll {:as :parsed} :key {:value :against-ref} :default nil}}}}

  {:name :_diff-target-missing?
   :description "Guard #1 — target branch not found. `:nil? :target-branch`."
   :parent :nil?
   :args {:value {:as :target-branch}}}

  {:name :_diff-against-missing?
   :description "Guard #2 — `?against=` query param not supplied. `:nil? (get parsed :against-ref)`."
   :parent :nil?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :against-ref} :default nil}}}}

  {:name :_diff-source-missing?
   :description "Guard #3 — source branch ref supplied but resolves to nil. `:nil? :source-branch`."
   :parent :nil?
   :args {:value {:as :source-branch}}}

  {:name :_diff-err-target-missing
   :description "Dynamic error — cites the raw target-ref. Shared by diff / conflicts / merge via `:parent`. `:return-type` pinned so the parent `:cond`'s union of error envelopes + success envelope stays a union of PRECISE record shapes (otherwise the bare `:zipmap` inference opaques out to `[:map :any …]` and downstream `:get :key …` can't narrow per-branch)."
   :parent :zipmap
   :return-type :_error-result-shape
   :args {:keys [:ok :error]
          :vals [false
                 {:parent :str
                  :args {:parts ["Target branch not found: "
                                 {:parent :get
                                  :args {:coll {:as :parsed}
                                         :key {:value :target-ref}
                                         :default nil}}]}}]}}

  {:name :_diff-err-against-missing
   :parent :const
   :return-type :_error-result-shape
   :args {:value {:ok false :error "Query parameter 'against' is required"}}}

  {:name :_diff-err-source-missing
   :description "Dynamic error — cites the raw against-ref. Only diff uses `:against-ref` as the source key (conflicts/merge use `:source-ref`). Pinned `:return-type` mirrors `:_diff-err-target-missing` — keeps the cond's union of precise record shapes intact."
   :parent :zipmap
   :return-type :_error-result-shape
   :args {:keys [:ok :error]
          :vals [false
                 {:parent :str
                  :args {:parts ["Source branch not found: "
                                 {:parent :get
                                  :args {:coll {:as :parsed}
                                         :key {:value :against-ref}
                                         :default nil}}]}}]}}

  ;; --- :diff-branches atomic primitive ------------------------------
  ;; Single library call over `mrg/diff-branches`. The per-entry
  ;; reshape + envelope are graph composition below — admins can vary
  ;; the diff-entry shape or the envelope without Clojure edits.

  ;; Closed enums for diff-entry fields. They make the `{:value :modified}`
  ;; vs `{:value \"modified\"}` mistake visible at sync-time — the
  ;; type-checker rejects a string-literal compare against
  ;; `:diff-change-kw` since `:text` ⊄ `:diff-change-kw`. Mirrors the
  ;; Clojure source of truth in `graphden.versioning.storage.merge`.
  {:name :diff-change-kw
   :description "Closed enum for the `:change` field on a `:diff-branches` entry. Same keyword set the Clojure merge layer emits."
   :refine {:base :keyword :constraint [:in [:added-in-source :added-in-target :modified]]}}

  {:name :diff-entity-name-kw
   :description "Closed enum for the `:entity-name` field on a `:diff-branches` entry — the versioned entity kinds the diff walker considers."
   :refine {:base :keyword :constraint [:in [:fn :fn-slot :binding :binding-list-item]]}}

  {:name :diff-branches
   :description "Atomic library boundary over `mrg/diff-branches` — returns the resolved-view diff between the two branches' ancestor chains: `{:source-branch-id :target-branch-id :diffs [...]}`."
   :args {:source-branch-id {:type :uuid :description "Source branch id."}
          :target-branch-id {:type :uuid :description "Target branch id."}}
   :return-type :keyword-map
   :effects #{:db}}

  {:name :_diff-apply-raw
   :description "Stage 1 — run the diff. The `:source-branch` / `:target-branch` free args come from the parent `:cond` which threaded them through `:_diff-source-branch` / `:_target-branch`. The `:assert-some` wraps mirror the `:cond` guards (`:_diff-source-missing?` / `:_diff-target-missing?` reject nil branches upstream) — they bridge the type-checker's per-arm narrowing gap."
   :parent :diff-branches
   :args {:source-branch-id {:parent :assert-some
                             :args {:value {:parent :get
                                            :args {:coll {:as :source-branch}
                                                   :key {:value :id}
                                                   :default nil}}}}
          :target-branch-id {:parent :assert-some
                             :args {:value {:parent :get
                                            :args {:coll {:as :target-branch}
                                                   :key {:value :id}
                                                   :default nil}}}}}}

  {:name :_diff-apply-diffs-raw
   :description "Stage 2 — pull the `:diffs` vec out of the diff result."
   :parent :get
   :args {:coll :_diff-apply-raw :key {:value :diffs} :default []}}

  ;; --- Per-entry reshape: stringify UUIDs in version maps.
  {:name :_diff-entry-entity-id
   :parent :get
   :args {:coll {:as :item} :key {:value :entity-id} :default nil}}

  {:name :_diff-entry-source-version
   :parent :get
   :args {:coll {:as :item} :key {:value :source-version} :default nil}}

  {:name :_diff-entry-target-version
   :parent :get
   :args {:coll {:as :item} :key {:value :target-version} :default nil}}

  {:name :_diff-apply-entry
   :description "HOF callback per diff row — `{:entity-name :entity-id (str) :change :source-version (stringify-uuids) :target-version (stringify-uuids)}`. Mirrors the Clojure `prepare-diff-entry`."
   :parent :zipmap
   :args {:keys [{:value :entity-name} {:value :entity-id} {:value :change}
                 {:value :source-version} {:value :target-version}]
          :vals [{:parent :get :args {:coll {:as :item} :key {:value :entity-name} :default nil}}
                 {:parent :to-str :args {:value :_diff-entry-entity-id}}
                 {:parent :get :args {:coll {:as :item} :key {:value :change} :default nil}}
                 {:parent :stringify-uuids :args {:m :_diff-entry-source-version}}
                 {:parent :stringify-uuids :args {:m :_diff-entry-target-version}}]}}

  {:name :_diff-apply-diffs
   :parent :map
   :args {:func :_diff-apply-entry :coll :_diff-apply-diffs-raw}}

  {:name :_diff-apply-target-shaped
   :parent :as-json-branch
   :args {:branch-row {:as :target-branch}}}

  {:name :_diff-apply-source-shaped
   :parent :as-json-branch
   :args {:branch-row {:as :source-branch}}}

  {:name :_diff-apply-count
   :parent :count
   :args {:coll :_diff-apply-diffs}}

  {:name :_diff-apply
   :description "Success branch — `{:ok true :target (as-json-branch) :source (as-json-branch) :count :diffs [...]}`. Pure graph composition over `:diff-branches` + per-row reshape + envelope."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :target} {:value :source}
                 {:value :count} {:value :diffs}]
          :vals [{:value true}
                 :_diff-apply-target-shaped
                 :_diff-apply-source-shaped
                 :_diff-apply-count
                 :_diff-apply-diffs]}}

  {:name :_diff-branches-data
   :description "GET /api/branches/:ref/diff?against=<source> — flat `:cond` of 3 guards + apply."
   :parent :cond
   :args {:clauses [:_diff-target-missing?  :_diff-err-target-missing
                    :_diff-against-missing? :_diff-err-against-missing
                    :_diff-source-missing?  :_diff-err-source-missing
                    {:value true}           :_diff-apply]
          :parsed :_diff-parsed
          :target-branch :_target-branch
          :source-branch :_diff-source-branch}}

  {:name :diff-branches-handler
   :lambda-params [:branch-row :request :default]
   :description "Ring handler for GET /api/branches/:ref/diff."
   :parent :json-handler
   :args {:data :_diff-branches-data}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/branches — create a new branch.
  ;; ---------------------------------------------------------------------

  ;; --- create-branch ---
  ;; Body parser — `:branch-name` is `:str-trim`'d (nil-safe via `:if
  ;; :some?`), `:base-ref` is `(str v)` if non-blank else nil.
  {:name :_create-branch-body
   :description "Parsed JSON body of POST /api/branches — `{:name :base-branch-id}`."
   :parent :parse-json-body}

  {:name :_create-branch-name-raw
   :description "Raw `:name` field from the body (nil when missing)."
   :parent :get
   :args {:coll :_create-branch-body
          :key {:value :name}
          :default nil}}

  {:name :_create-branch-name-trimmed
   :description "`(str/trim :_create-branch-name-raw)` — only computed when the raw value is non-nil; `:str-trim`'s `:string` slot is required so we gate via `:if :some?`."
   :parent :str-trim
   :args {:string :_create-branch-name-raw}}

  {:name :_create-branch-name
   :description "Nil-safe trim: `(some-> body :name str/trim)`."
   :parent :if
   :args {:test {:parent :some? :args {:value :_create-branch-name-raw}}
          :then :_create-branch-name-trimmed
          :else nil}}

  {:name :_create-branch-base-raw
   :description "Raw `:base-branch-id` field from the body (nil when missing)."
   :parent :get
   :args {:coll :_create-branch-body
          :key {:value :base-branch-id}
          :default nil}}

  {:name :_create-branch-base-str
   :description "`(str :base-branch-id)` — coerces UUID / string / other-jsonb to a string. Nil becomes the empty string, which the `:blank?` guard below collapses back to nil."
   :parent :to-str
   :args {:value :_create-branch-base-raw}}

  {:name :_create-branch-base-blank?
   :description "True iff the coerced base-ref string is blank (which means: missing OR empty OR whitespace-only)."
   :parent :blank?
   :args {:string :_create-branch-base-str}}

  {:name :_create-branch-base-ref
   :description "Final `:base-ref` value — nil if blank, the coerced string otherwise. Matches `(when-let [v (:base-branch-id body)] (when-not (blank? (str v)) (str v)))`."
   :parent :if
   :args {:test :_create-branch-base-blank?
          :then nil
          :else :_create-branch-base-str}}

  {:name :_create-branch-forbid-invalid
   :description "Raw `:forbid-invalid?` flag from the body (nil when missing) — the error-tolerance Phase 5 merge-policy opt-in. Threaded through `:parsed` into `:_create-branch-apply-row`; nil leaves the column unwritten."
   :parent :get
   :args {:coll :_create-branch-body
          :key {:value :forbid-invalid?}
          :default nil}}

  {:name :_create-branch-write-policy
   :description "Raw `:write-policy` from the body (nil when missing) — the protected-branch level (\"open\"/\"owner\"/\"admins\"). Validated inside `:create-branch!`; nil leaves the column unwritten."
   :parent :get
   :args {:coll :_create-branch-body
          :key {:value :write-policy}
          :default nil}}

  {:name :_create-branch-require-merge
   :description "Raw `:require-merge` from the body (nil when missing) — the protected-branch 'push only via merge' flag (JSON key has no `?`; the stored column is `:require-merge?`). nil leaves the column unwritten."
   :parent :get
   :args {:coll :_create-branch-body
          :key {:value :require-merge}
          :default nil}}

  {:name :_create-branch-parsed
   :description "Parse POST /api/branches body into `{:branch-name :base-ref :forbid-invalid? :write-policy :require-merge?}`. Pure graph composition over `:parse-json-body` + `:get` + `:to-str` + `:str-trim` + `:if` + `:zipmap`."
   :parent :zipmap
   :args {:keys [{:value :branch-name} {:value :base-ref} {:value :forbid-invalid?} {:value :write-policy} {:value :require-merge?}]
          :vals [:_create-branch-name :_create-branch-base-ref :_create-branch-forbid-invalid :_create-branch-write-policy :_create-branch-require-merge]}}

  {:name :_create-branch-policy-value
   :parent :get
   :args {:coll {:as :parsed} :key {:value :write-policy} :default nil}}

  ;; Same JSONB-keywordize trap note as `:_branch-policy-invalid?` — the
  ;; membership test is an :or of :equal?, not a map :contains?.
  {:name :_create-branch-policy-invalid?
   :description "Guard — a PRESENT body `:write-policy` must be open/owner/admins; absent (nil) is fine (no policy)."
   :parent :and
   :args {:values [{:parent :some? :args {:value :_create-branch-policy-value}}
                   {:parent :not
                    :args {:value {:parent :or
                                   :args {:values [{:parent :equal?
                                                    :args {:a :_create-branch-policy-value :b {:value "open"}}}
                                                   {:parent :equal?
                                                    :args {:a :_create-branch-policy-value :b {:value "owner"}}}
                                                   {:parent :equal?
                                                    :args {:a :_create-branch-policy-value :b {:value "admins"}}}]}}}}]}}

  {:name :_create-branch-err-policy-invalid
   :parent :const
   :return-type :_error-result-shape
   :args {:value {:ok false :error "write-policy must be one of: open, owner, admins"}}}

  {:name :_create-branch-name-blank?
   :description "Guard #1 — `:name` missing or blank. `:blank?` is nil-safe, so it covers both cases in one call."
   :parent :blank?
   :args {:string {:parent :get :args {:coll {:as :parsed} :key {:value :branch-name} :default nil}}}}

  ;; --- Name-collision check goes through `:pg-query` + parameterised
  ;; HoneySQL `:where [:= :name ...]` rather than the generic
  ;; `:list-entities` wrap. `:branch` is
  ;; non-versioned (see `versioning.storage.resolution/entity-config`),
  ;; so a raw pg-query bypasses the version-resolution layer
  ;; correctly.
  ;;
  ;; We don't decode the rows — the only consumer (`:_create-branch-
  ;; name-taken?`) just checks `:empty?`, never reads columns.
  {:name :_create-branch-name-taken-rows
   :description "Raw `SELECT * FROM branch WHERE name = <branch-name>`. Empty when no collision. Rows are NOT decoded — the only consumer checks emptiness."
   :parent :storage-query-call
   :args {:arg :_create-branch-name-taken-hsql}}

  {:name :_create-branch-name-taken-hsql
   :parent :assoc
   :args {:map {:value {:select [:*] :from :branch}}
          :key {:value :where}
          :value :_create-branch-name-taken-hsql-where}}

  {:name :_create-branch-name-taken-hsql-where
   :parent :vec
   :args {:coll [{:value :=} {:value :name} :_create-branch-name-taken-name]}}

  {:name :_create-branch-name-taken-name
   :parent :get
   :args {:coll {:as :parsed} :key {:value :branch-name} :default nil}}

  {:name :_create-branch-name-taken?
   :description "Guard #2 — a branch with this name already exists. `:not :empty? (pg-query :branch where name = :branch-name)`."
   :parent :not
   :args {:value {:parent :empty? :args {:coll :_create-branch-name-taken-rows}}}}

  ;; `:current-branch-id` + `:current-branch-chain` now live in
  ;; `storage/branches` so packages below `app` (`web/crud` etc.) can
  ;; reference them.

  ;; `:_create-branch-resolved-parent` graph form:
  ;;   if base-ref supplied: resolve it via `:resolve-branch-ref`
  ;;   else: look up the current branch row via `:resolve-branch-ref`
  ;;         on (str current-branch-id).
  {:name :_create-branch-base-ref-raw
   :parent :get
   :args {:coll {:as :parsed} :key {:value :base-ref} :default nil}}

  {:name :_create-branch-resolved-supplied
   :parent :resolve-branch-ref
   :args {:ref :_create-branch-base-ref-raw}}

  {:name :_current-branch-id-str
   :description "Stringify the UUID so `:resolve-branch-ref` (which accepts the same string form as URL refs) can look it up."
   :parent :to-str
   :args {:value :current-branch-id}}

  {:name :_create-branch-default-parent
   :parent :resolve-branch-ref
   :args {:ref :_current-branch-id-str}}

  {:name :_create-branch-resolved-parent
   :description "Resolve `:base-ref` to a branch row, defaulting to the wrapper's current branch (= main) when absent. `:if :some? :base-ref :then resolve else default-parent`."
   :parent :if
   :args {:test {:parent :some? :args {:value :_create-branch-base-ref-raw}}
          :then :_create-branch-resolved-supplied
          :else :_create-branch-default-parent}}

  {:name :_create-branch-base-missing?
   :description "Guard #3 — base-ref supplied but resolves to nil. `:and [some? (get parsed :base-ref)] [nil? :resolved-parent]`."
   :parent :and
   :args {:values [{:parent :some?
                    :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :base-ref} :default nil}}}}
                   {:parent :nil? :args {:value {:as :resolved-parent}}}]}}

  {:name :_create-branch-err-name-taken
   :description "Dynamic error — cites the rejected name. `:return-type` pinned so the parent cond's union stays a union of precise record shapes for downstream `:get` narrowing."
   :parent :zipmap
   :return-type :_error-result-shape
   :args {:keys [:ok :error]
          :vals [false
                 {:parent :str
                  :args {:parts ["Branch already exists: "
                                 {:parent :get
                                  :args {:coll {:as :parsed}
                                         :key {:value :branch-name}
                                         :default nil}}]}}]}}

  {:name :_create-branch-err-base-missing
   :description "Dynamic error — cites the base-ref that didn't resolve."
   :parent :zipmap
   :return-type :_error-result-shape
   :args {:keys [:ok :error]
          :vals [false
                 {:parent :str
                  :args {:parts ["Base branch not found: "
                                 {:parent :get
                                  :args {:coll {:as :parsed}
                                         :key {:value :base-ref}
                                         :default nil}}]}}]}}

  ;; --- :create-branch! atomic primitive ----------------------------
  ;; Single library call over `vs/create-branch!`. The success-shape
  ;; building (envelope + `:as-json-branch` row reshape) is graph
  ;; composition below — admins can swap the envelope or per-row
  ;; shape without touching Clojure.
  {:name :create-branch!
   :description "Atomic library boundary over `vs/create-branch!` — writes a new branch row with `:branch-name` + `:base-branch-id` (+ optional `:forbid-invalid?` merge-policy flag and `:write-policy` protection level; the creating principal is stamped as `:owner-id`) and returns the row."
   :args {:branch-name {:type :text :description "New branch's display name."}
          :base-branch-id {:type :uuid :description "Parent branch's id; the new branch forks from this point."}
          :forbid-invalid? {:type :nullable-bool :required false :description "Error-tolerance Phase 5 merge policy: truthy → merges INTO this branch are refused while recorded type diagnostics exist on either side. Absent/nil ≡ off."}
          :write-policy {:type :nullable-text :required false :description "Protected-branch write policy: \"open\" (nil ≡ open — anyone the ordinary grants admit), \"owner\" (branch owner + the org's :manage-grants holders), \"admins\" (:manage-grants holders only). Enforced by the tenancy addon; inert without it."}
          :require-merge? {:type :nullable-bool :required false :description "Protected-branch 'push only via merge' flag (Stage 2): truthy → direct graph writes are refused, changes land only via merge. Enforced in open core. Absent/nil ≡ off."}}
   :return-type :keyword-map
   :effects #{:db}}

  {:name :_create-branch-apply-row
   :description "Stage 1 of the apply — write the branch row off the parsed name + resolved parent. Branch-name is non-null here because the `:_create-branch-name-blank?` guard rejects the request upstream. `:base-branch-id` is asserted non-null because the wrapping `:cond` reaches this arm only when `:_create-branch-parent-missing?` is false (`:resolved-parent` exists)."
   :parent :create-branch!
   :args {:branch-name {:parent :get :type :text
                        :args {:coll {:as :parsed}
                               :key {:value :branch-name}
                               :default nil}}
          :base-branch-id {:parent :assert-some
                           :args {:value {:parent :get
                                          :args {:coll {:as :resolved-parent}
                                                 :key {:value :id}
                                                 :default nil}}}}
          :forbid-invalid? {:parent :get :type :nullable-bool
                            :args {:coll {:as :parsed}
                                   :key {:value :forbid-invalid?}
                                   :default nil}}
          :write-policy {:parent :get :type :nullable-text
                         :args {:coll {:as :parsed}
                                :key {:value :write-policy}
                                :default nil}}
          :require-merge? {:parent :get :type :nullable-bool
                           :args {:coll {:as :parsed}
                                  :key {:value :require-merge?}
                                  :default nil}}}}

  {:name :_create-branch-apply-shaped
   :description "Stage 2 — reshape the new row via the shared `:as-json-branch` converter (stringified ids + created-at)."
   :parent :as-json-branch
   :args {:branch-row :_create-branch-apply-row}}

  {:name :_create-branch-apply
   :description "Success branch — `{:ok true :branch (as-json-branch row)}`. Pure graph composition over `:create-branch!` + `:as-json-branch` + `:zipmap`."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :branch}]
          :vals [{:value true} :_create-branch-apply-shaped]}}

  {:name :_create-branch-data
   :description "POST /api/branches — flat `:cond` of `[name-blank? → 400, name-taken? → 400-dynamic, base-missing? → 400-dynamic, true → apply]`."
   :parent :cond
   :args {:clauses [:_create-branch-name-blank?  :_err-name-blank
                    :_create-branch-policy-invalid? :_create-branch-err-policy-invalid
                    :_create-branch-name-taken?  :_create-branch-err-name-taken
                    :_create-branch-base-missing? :_create-branch-err-base-missing
                    {:value true}                 :_create-branch-apply]
          :parsed :_create-branch-parsed
          :resolved-parent :_create-branch-resolved-parent}}

  {:name :create-branch-handler
   :lambda-params [:storage-query :request]
   :description "Ring handler for POST /api/branches (auth-required)."
   :parent :json-handler
   :args {:data :_create-branch-data}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/branches/:ref/policy — set / clear the branch's write
  ;; policy (protected branches, Stage 1). Body `{write-policy}` with
  ;; "open" | "owner" | "admins"; "open" clears back to nil. WHO may
  ;; flip a policy is gated by the tenancy addon's authorize-writer on
  ;; the underlying `:branch` row write (owner / :manage-grants).
  ;; ---------------------------------------------------------------------

  ;; --- :set-branch-policy! atomic primitive ---
  {:name :set-branch-policy!
   :description "Atomic library boundary — update `:branch.write-policy` by branch id. Validates the policy value (`:branches/invalid-write-policy` otherwise); \"open\" normalises to nil (cleared). Returns the stored policy (nil when cleared)."
   :args {:branch-id {:type :uuid :description "Branch id whose policy to set."}
          :write-policy {:type :nullable-text :description "\"open\" (clear), \"owner\" or \"admins\"."}}
   :return-type :nullable-text
   :effects #{:db}}

  {:name :set-branch-require-merge!
   :description "Atomic library boundary — set `:branch.require-merge?` (bool) by branch id. When true, direct graph writes to the branch are refused (open-core enforcement); changes land only via merge. Returns the stored boolean."
