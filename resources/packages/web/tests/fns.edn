  ;; web.html
  ;; =========================================================================

  {:name :hidden-span-is-an-empty-hidden-span
   :description "`:hidden-span` is `[:span {:hidden \"1\"}]` — the shape-stable `:else` of a conditional section."
   :parent :assert-eq
   :args {:actual :hidden-span
          :expected {:value [:span {:hidden "1"}]}}}

  {:name :hiccup-builds-tag-attrs-children
   :description "`:hiccup` assembles `[tag attrs & children]`."
   :parent :assert-eq
   :args {:actual {:parent :hiccup :args {:tag "b" :attrs {:class "c"} :children ["x" "y"]}}
          :expected {:value [:b {:class "c"} "x" "y"]}}}

  {:name :hiccup-omits-nil-attrs
   :description "`:hiccup` with no `:attrs` yields `[tag & children]` — no empty attrs map."
   :parent :assert-eq
   :args {:actual {:parent :hiccup :args {:tag "b" :attrs nil :children ["x"]}}
          :expected {:value [:b "x"]}}}

  {:name :render-hiccup-escapes-text-children
   :description "`:render-hiccup` HTML-escapes text children (`<` → `&lt;`) and renders attrs."
   :parent :assert-eq
   :args {:actual {:parent :render-hiccup :args {:hiccup {:value ["div" {"class" "a"} "x<y"]}}}
          :expected "<div class=\"a\">x&lt;y</div>"}}

  {:name :hiccup-normalize-keywordizes-string-tags
   :description "`:hiccup-normalize` turns string tags into keywords at every depth and keeps the attrs map."
   :parent :assert-eq
   :args {:actual {:parent :hiccup-normalize :args {:tree {:value ["div" {"class" "a"} ["span" "x"]]}}}
          :expected {:value [:div {:class "a"} [:span "x"]]}}}

  {:name :hiccup-normalize-passes-scalars-through
   :description "`:hiccup-normalize` on a non-element (a bare string) returns it unchanged."
   :parent :assert-eq
   :args {:actual {:parent :hiccup-normalize :args {:tree "x"}}
          :expected "x"}}

  {:name :hiccup-normalize-keeps-style-text-verbatim
   :description "String children of a normalized `<style>` render unescaped — `>` survives as `>`."
   :parent :assert-eq
   :args {:actual {:parent :render-hiccup :args {:hiccup {:parent :hiccup-normalize :args {:tree {:value ["style" "a>b{}"]}}}}}
          :expected "<style>a>b{}</style>"}}

  {:name :html-page-scaffolds-head-and-body
   :description "`:html-page` yields `<html lang=en>` with charset + viewport metas and the title in `<head>`, and the (keywordized) body in `<body>`."
   :parent :assert-eq
   :args {:actual {:parent :html-page :args {:title "T" :body {:value ["div" {"class" "a"} "x"]} :head [] :scripts []}}
          :expected {:value [:html {:lang "en"}
                             [:head {}
                              [:meta {:charset "utf-8"}]
                              [:meta {:name "viewport" :content "width=device-width, initial-scale=1"}]
                              [:title {} "T"]]
                             [:body {} [:div {:class "a"} "x"]]]}}}

  {:name :html-page-renders-head-styles-and-body-scripts-verbatim
   :description "Rendered, a page's `:head` `<style>` follows the title, its `:scripts` `<script>` closes the body, and neither body is HTML-escaped."
   :parent :assert-eq
   :args {:actual {:parent :render-hiccup :args {:hiccup :_wt-page-with-assets}}
          :expected "<html lang=\"en\"><head><meta charset=\"utf-8\" /><meta content=\"width=device-width, initial-scale=1\" name=\"viewport\" /><title>T</title><style>b{}</style></head><body><p>x</p><script>1<2</script></body></html>"}}

  {:name :with-cdn-script-appends-script-src-to-head
   :description "`:with-cdn-script` conj's `[:script {:src url}]` onto the existing head list, after its elements."
   :parent :assert-eq
   :args {:actual {:parent :with-cdn-script :args {:head {:value [[:meta {:charset "utf-8"}]]} :url "https://cdn.example/x.js"}}
          :expected {:value [[:meta {:charset "utf-8"}] [:script {:src "https://cdn.example/x.js"}]]}}}

  {:name :wrap-element-builds-a-single-child-element
   :description "`:wrap-element` is `[tag {} content]` — attrs pinned to `{}`."
   :parent :assert-eq
   :args {:actual {:parent :wrap-element :args {:tag "em" :content "x"}}
          :expected {:value [:em {} "x"]}}}

  {:name :wrap-style-wraps-css-in-a-style-tag
   :description "`:wrap-style` is `[:style {} css]`."
   :parent :assert-eq
   :args {:actual {:parent :wrap-style :args {:content "b{}"}}
          :expected {:value [:style {} "b{}"]}}}

  {:name :wrap-script-wraps-js-in-a-script-tag
   :description "`:wrap-script` is `[:script {} js]`."
   :parent :assert-eq
   :args {:actual {:parent :wrap-script :args {:content "1"}}
          :expected {:value [:script {} "1"]}}}

