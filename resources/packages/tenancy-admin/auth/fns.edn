;; Auth routes (PLATFORM_PLAN §4.1) — login / signup / logout / logout-all.
;; Migrated out of core `app/admin` into this addon-only package (route-
;; collection seam §6); compiled into `:tenancy-router`, NOT in core `:all`.
;; login/signup are UNAUTHENTICATED (`:post-route`); logout/logout-all are
;; auth-required. Each `:invoke-*` base-fn calls the addon's `:user-ops` seam,
;; so without the addon they no-op — a single-tenant editor authenticates with
;; a static bearer + GET /api/auth/check (a CORE route in `app/routes`) and
;; never calls these (editor-auth.js gates them behind `loginIsTenant()`).

{:namespace "tenancy-admin.auth"
 :description "Tenancy auth routes — login / signup / logout / logout-all, served via the route-collection seam."
 :fns
 [;; --- shared 401 body for a failed credential attempt (login + signup) ----
  {:name :_auth-401-body
   :parent :const
   :args {:value "Invalid username or password."}}

  {:name :_auth-401
   :parent :text-unauthorized-response
   :args {:body :_auth-401-body}}

  ;; ---------------------------------------------------------------------
  ;; LOGIN (§4.1) — POST /api/login {username password}. UNAUTHENTICATED (you
  ;; log in to obtain a token). The `:invoke-login` base-fn calls the
  ;; `:user-ops` seam, which verifies credentials and mints a session `:token`
  ;; (the storage-token-provider resolves it thereafter). 200 + the token, or
  ;; 401 on bad credentials.
  ;; ---------------------------------------------------------------------
  {:name :invoke-login
   :description "Verify credentials via the addon's user-ops seam and mint a session token. Returns {:token :user :org} on success, nil on bad credentials / rate-limited / no addon."
   :args {:username {:type :text :description "Login id."}
          :password {:type :text :description "Raw password."}
          :request {:type :ring-request-shape :description "The Ring request — its client IP feeds the per-IP login rate limiter (brute-force defense)."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :_login-form-data
   :parent :parse-form-body-kw}

  {:name :_login-username
   :parent :get
   :args {:coll :_login-form-data :key {:value :username} :default {:value ""}}}

  {:name :_login-password
   :parent :get
   :args {:coll :_login-form-data :key {:value :password} :default {:value ""}}}

  {:name :_login-do
   :parent :invoke-login
   :args {:username :_login-username
          :password :_login-password}}

  {:name :_login-token
   :parent :get
   :args {:coll :_login-do :key {:value :token} :default {:value ""}}}

  {:name :_login-token-text
   :parent :to-str
   :args {:value :_login-token}}

  {:name :_login-token-blank?
   :parent :blank?
   :args {:string :_login-token-text}}

  {:name :_login-200
   :parent :text-ok-response
   :args {:body :_login-token-text}}

  {:name :_login-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/login — 200 + the minted session token, or 401 on bad credentials (blank token)."
   :parent :if
   :args {:test :_login-token-blank? :then :_auth-401 :else :_login-200}}

  ;; UNAUTHENTICATED — `:post-route` (no auth-required middleware, unlike
  ;; `:post`): login is the entry point to obtaining auth, so it must be
  ;; reachable without a token. The request-scope runs it as public; login!
  ;; reads `:user` + mints the session token in the platform context.
  {:name :login-route
   :description "POST /api/login — exchange username/password for a session token. UNAUTHENTICATED (the entry point to obtaining auth)."
   :parent :post-route
   :args {:path "/api/login" :handler :_login-handler}}

  ;; ---------------------------------------------------------------------
  ;; SIGNUP (§4.1) — POST /api/signup {username password org}. UNAUTHENTICATED
  ;; self-serve registration: creates a BRAND-NEW org + user and auto-logs-in
  ;; (returns the session token). The seam refuses an existing org, so a new
  ;; account can never join another tenant. Empty body on failure (taken /
  ;; blank), exactly like login.
  ;; ---------------------------------------------------------------------
  {:name :invoke-signup
   :description "Self-serve signup via the user-ops seam: create a new org + user, auto-login. Returns {:token :user :org}, or nil on failure / rate-limit / no addon."
   :args {:username {:type :text :description "Desired login id (must be free)."}
          :password {:type :text :description "Raw password — only its bcrypt hash is stored."}
          :org {:type :text :description "Desired org slug (must be free — signup creates it)."}
          :request {:type :ring-request-shape :description "The Ring request — its client IP feeds the per-IP signup rate limiter."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :_signup-form-data
   :parent :parse-form-body-kw}

  {:name :_signup-username
   :parent :get
   :args {:coll :_signup-form-data :key {:value :username} :default {:value ""}}}

  {:name :_signup-password
   :parent :get
   :args {:coll :_signup-form-data :key {:value :password} :default {:value ""}}}

  {:name :_signup-org
   :parent :get
   :args {:coll :_signup-form-data :key {:value :org} :default {:value ""}}}

  {:name :_signup-do
   :parent :invoke-signup
   :args {:username :_signup-username
          :password :_signup-password
          :org :_signup-org}}

  {:name :_signup-token
   :parent :get
   :args {:coll :_signup-do :key {:value :token} :default {:value ""}}}

  {:name :_signup-token-text
   :parent :to-str
   :args {:value :_signup-token}}

  {:name :_signup-token-blank?
   :parent :blank?
   :args {:string :_signup-token-text}}

  {:name :_signup-200
   :parent :text-ok-response
   :args {:body :_signup-token-text}}

  {:name :_signup-token-result
   :description "200 + the new session token, or 401 when signup failed (taken / blank)."
   :parent :if
   :args {:test :_signup-token-blank? :then :_auth-401 :else :_signup-200}}

  ;; The rate limiter returns a {:rate-limited true} sentinel for an over-quota
  ;; IP → 429 (distinct from a credential/taken failure → 401).
  {:name :_signup-rate-limited?
   :parent :get
   :args {:coll :_signup-do :key {:value :rate-limited} :default {:value false}}}

  {:name :_signup-429-body
   :parent :const
   :args {:value "Too many signup attempts — please try again later."}}

  {:name :_signup-429
   :parent :text-too-many-requests-response
   :args {:body :_signup-429-body}}

  {:name :_signup-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/signup — 429 when rate-limited, else 200 + the new session token, or 401 when signup failed (taken / blank)."
   :parent :if
   :args {:test :_signup-rate-limited? :then :_signup-429 :else :_signup-token-result}}

  {:name :signup-route
   :description "POST /api/signup — self-serve register a new org + user and get a session token. UNAUTHENTICATED."
   :parent :post-route
   :args {:path "/api/signup" :handler :_signup-handler}}

  ;; ---------------------------------------------------------------------
  ;; LANDING DEMO (tier-split) — POST /api/demo/start (UNAUTHENTICATED).
  ;; Mints an EPHEMERAL ANONYMOUS org + token so a visitor can try graphs
  ;; with nothing to lose (locked tier, reaped after the demo TTL). OFF by
  ;; default (the seam is gated by `demo-signup-enabled?`); when off → 404,
  ;; over-quota IP → 429, else 200 + JSON {token, org}. No form body — the
  ;; server generates both. The write happens INSIDE the seam only when
  ;; enabled, so referencing `:_demo-start-do` for the checks is safe.
  ;; ---------------------------------------------------------------------
  {:name :invoke-demo-start
   :description "Provision an ephemeral anonymous demo org + token via the user-ops :demo-start seam. Returns {:token :org}, {:disabled true} (off), {:rate-limited true} (over IP quota), or nil (no addon)."
   :args {:request {:type :ring-request-shape :description "The Ring request — its client IP feeds the per-IP rate limiter."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :_demo-start-do
   :parent :invoke-demo-start}

  {:name :_demo-start-disabled?
   :parent :get
   :args {:coll :_demo-start-do :key {:value :disabled} :default {:value false}}}

  {:name :_demo-start-rate-limited?
   :parent :get
   :args {:coll :_demo-start-do :key {:value :rate-limited} :default {:value false}}}

  {:name :_demo-start-json
   :parent :to-json-string
   :args {:data :_demo-start-do}}

  {:name :_demo-start-200
   :parent :json-ok-response
   :args {:body :_demo-start-json}}

  {:name :_demo-start-404-body
   :parent :const
   :args {:value "Demo sign-up is not enabled on this deployment."}}

  {:name :_demo-start-404
   :parent :text-not-found-response
   :args {:body :_demo-start-404-body}}

  {:name :_demo-start-429-body
   :parent :const
   :args {:value "Too many demo requests — please try again later."}}

  {:name :_demo-start-429
   :parent :text-too-many-requests-response
   :args {:body :_demo-start-429-body}}

  {:name :_demo-start-live
   :description "Not disabled: 429 when rate-limited, else 200 + the new demo token."
   :parent :if
   :args {:test :_demo-start-rate-limited? :then :_demo-start-429 :else :_demo-start-200}}

  {:name :_demo-start-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/demo/start — 404 when the feature is off, 429 when rate-limited, else 200 + JSON {token, org}."
   :parent :if
   :args {:test :_demo-start-disabled? :then :_demo-start-404 :else :_demo-start-live}}

  {:name :demo-start-route
   :description "POST /api/demo/start — mint an ephemeral anonymous demo org + token. UNAUTHENTICATED; OFF by default (enable via :tenancy/user-ops :demo-signup-enabled?)."
   :parent :post-route
   :args {:path "/api/demo/start" :handler :_demo-start-handler}}

  ;; ---------------------------------------------------------------------
  ;; INVITES (LAUNCH_PLAN stage 1.3) — POST /api/invites (auth-required)
  ;; mints a single-use, 7-day invite into the CALLER'S org; POST
  ;; /api/invite-signup (unauthenticated, flat path — a nested
  ;; /api/signup/invite would conflict with /api/signup in reitit)
  ;; redeems it: creates the user INSIDE the invite's org + auto-login.
  ;; ---------------------------------------------------------------------
  {:name :invoke-invite-create
   :description "Invoke the addon's invite-create seam — mint a single-use invite into the caller's org. Returns {:invite <raw> :org <org>}, or nil (no addon / public-org caller / rate-limited)."
   :args {:request {:type :ring-request-shape :description "The Ring request — principal supplies the org, client IP feeds the limiter."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :_invite-create-do
   :parent :invoke-invite-create}

  {:name :_invite-create-token
   :parent :get
   :args {:coll :_invite-create-do :key {:value :invite} :default {:value ""}}}

  {:name :_invite-create-text
   :parent :to-str
   :args {:value :_invite-create-token}}

  {:name :_invite-create-blank?
   :parent :blank?
   :args {:string :_invite-create-text}}

  {:name :_invite-create-200
   :parent :text-ok-response
   :args {:body :_invite-create-text}}

  {:name :_invite-create-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/invites — 200 + the raw invite token (shown once), or 401 when minting failed (no addon / public-org / rate-limited)."
   :parent :if
   :args {:test :_invite-create-blank? :then :_auth-401 :else :_invite-create-200}}

  {:name :invite-create-route
   :description "POST /api/invites — mint a single-use invite into the caller's org. Auth-required."
   :parent :post
   :args {:path "/api/invites" :handler :_invite-create-handler}}

  {:name :invoke-invite-redeem
   :description "Invoke the addon's invite-redeem seam — create the user inside the invite's org + auto-login. Returns {:token :user :org}, {:rate-limited true}, or nil on failure."
   :args {:invite {:type :text :description "The raw invite token from the invite link."}
          :username {:type :text :description "Desired login id (must be free)."}
          :password {:type :text :description "Raw password — only its bcrypt hash is stored."}
          :request {:type :ring-request-shape :description "The Ring request — its client IP feeds the limiter."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :_invite-redeem-form
   :parent :parse-form-body-kw}

  {:name :_invite-redeem-invite
   :parent :get
   :args {:coll :_invite-redeem-form :key {:value :invite} :default {:value ""}}}

  {:name :_invite-redeem-username
   :parent :get
   :args {:coll :_invite-redeem-form :key {:value :username} :default {:value ""}}}

  {:name :_invite-redeem-password
   :parent :get
   :args {:coll :_invite-redeem-form :key {:value :password} :default {:value ""}}}

  {:name :_invite-redeem-do
   :parent :invoke-invite-redeem
   :args {:invite :_invite-redeem-invite
          :username :_invite-redeem-username
          :password :_invite-redeem-password}}

  {:name :_invite-redeem-rate-limited?
   :parent :get
   :args {:coll :_invite-redeem-do :key {:value :rate-limited} :default {:value false}}}

  {:name :_invite-redeem-token
   :parent :get
   :args {:coll :_invite-redeem-do :key {:value :token} :default {:value ""}}}

  {:name :_invite-redeem-token-text
   :parent :to-str
   :args {:value :_invite-redeem-token}}

  {:name :_invite-redeem-token-blank?
   :parent :blank?
   :args {:string :_invite-redeem-token-text}}

  {:name :_invite-redeem-200
   :parent :text-ok-response
   :args {:body :_invite-redeem-token-text}}

  {:name :_invite-redeem-token-result
   :parent :if
   :args {:test :_invite-redeem-token-blank? :then :_auth-401 :else :_invite-redeem-200}}

  {:name :_invite-redeem-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/invite-signup — 200 + session token, 401 on bad/expired invite or taken username, 429 over the per-IP limit."
   :parent :if
   :args {:test :_invite-redeem-rate-limited? :then :_signup-429 :else :_invite-redeem-token-result}}

  {:name :invite-signup-route
   :description "POST /api/invite-signup — redeem an invite: create the user inside the invite's org, get a session token. UNAUTHENTICATED."
   :parent :post-route
   :args {:path "/api/invite-signup" :handler :_invite-redeem-handler}}

  ;; ---------------------------------------------------------------------
  ;; LOGOUT (§4.1) — POST /api/logout. Deletes the caller's session `:token`
  ;; server-side (the seam reads the bearer from `:request`), so a leaked
  ;; token can't be replayed after sign-out. Auth-required (you present the
  ;; token to invalidate it). `:request` stays a free arg → bound to the Ring
  ;; request at the handler call.
  ;; ---------------------------------------------------------------------
  {:name :invoke-logout
   :description "Invoke the addon's logout seam — delete the caller's session token (bearer read from :request). Returns true iff a row was deleted, or nil when the addon isn't active."
   :args {:request {:type :ring-request-shape :description "The Ring request — its bearer identifies the session to invalidate."}}
   :return-type :nullable-bool
   :effects #{:db}}

  {:name :_logout-do
   :parent :invoke-logout}

  {:name :_logout-text
   :parent :to-str
   :args {:value :_logout-do}}

  {:name :_logout-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/logout — invalidates the caller's session token."
   :parent :text-ok-response
   :args {:body :_logout-text}}

  {:name :logout-route
   :description "POST /api/logout — delete the caller's session token. Auth-required (the bearer to invalidate is the request's own)."
   :parent :post
   :args {:path "/api/logout" :handler :_logout-handler}}

  ;; ---------------------------------------------------------------------
  ;; LOGOUT-ALL (§4.1) — POST /api/logout-all. Sign out everywhere: delete
  ;; EVERY session token for the current user (the seam reads
  ;; *current-principal*). Auth-required.
  ;; ---------------------------------------------------------------------
  {:name :invoke-logout-all
   :description "Invoke the addon's logout-all seam — delete every session token for the current user. Returns the count deleted, or nil when the addon isn't active."
   :args {}
   :return-type :nullable-int
   :effects #{:db}}

  {:name :_logout-all-do
   :parent :invoke-logout-all}

  {:name :_logout-all-text
   :parent :to-str
   :args {:value :_logout-all-do}}

  {:name :_logout-all-handler
   :description "Ring handler for POST /api/logout-all — invalidates every session of the current user."
   :parent :text-ok-response
   :args {:body :_logout-all-text}}

  {:name :logout-all-route
   :description "POST /api/logout-all — sign out everywhere (delete all the current user's session tokens). Auth-required."
   :parent :post
   :args {:path "/api/logout-all" :handler :_logout-all-handler}}

  ;; ==========================================================================
  ;; PUBLIC LOGIN / SIGN-UP PAGE — a full HTML page at GET /login (unauth).
  ;; The self-serve entry a new cloud visitor needs: sign into an existing org
  ;; or create a brand-new one. Reuses the existing POST /api/login + /api/signup
  ;; endpoints; a small inline script stores the returned bearer under the SAME
  ;; localStorage key the editor reads (`graphden.auth.password`) and redirects
  ;; to `?next=` (default `/`). Brand-styled inline (tenancy-admin has no `app`
  ;; dep, so it can't reuse the editor stylesheet); `:html-page` runs
  ;; `:hiccup-normalize`, which raws the <style>/<script> bodies verbatim.
  ;; ==========================================================================
  {:name :_login-page-css
   :parent :const
   :args {:value "
:root{--ink:#0d1117;--panel:#151b26;--blue:#0066cc;--blue-deep:#0047a3;--blue-light:#4d94ff;--line:#222a38;--text:#e6edf3;--muted:#98a2b6}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--ink);color:var(--text);font:16px/1.5 -apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
.card{width:100%;max-width:380px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:28px}
.brand{display:flex;align-items:center;gap:10px;justify-content:center;margin-bottom:4px}
.brand svg{display:block;color:var(--blue-light)}
.brand b{font-size:1.4rem;font-weight:700;letter-spacing:.3px}
.brand b i{color:var(--blue-light);font-style:normal}
.sub{text-align:center;color:var(--muted);font-size:.92rem;margin-bottom:20px}
.tabs{display:flex;gap:6px;margin-bottom:18px}
.tab{flex:1;padding:8px;border:1px solid var(--line);border-radius:8px;background:transparent;color:var(--muted);cursor:pointer;font:inherit;font-size:.9rem}
.tab.active{background:var(--blue);border-color:var(--blue);color:#fff}
form{display:none;flex-direction:column;gap:12px}
form.active{display:flex}
label{font-size:.82rem;color:var(--muted)}
input{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:8px;background:var(--ink);color:var(--text);font:inherit}
input:focus{outline:none;border-color:var(--blue-light)}
.submit{padding:11px;border:none;border-radius:8px;background:linear-gradient(90deg,var(--blue),var(--blue-deep));color:#fff;font:inherit;font-weight:600;cursor:pointer}
.submit:hover{filter:brightness(1.1)}
.err{color:#ff8a8a;font-size:.85rem;min-height:1.2em;text-align:center;margin-top:4px}
.meter{height:6px;border-radius:3px;background:var(--line);overflow:hidden;margin-top:-4px}
.meter i{display:block;height:100%;width:0;border-radius:3px;transition:width .2s,background .2s}
.meter.weak i{width:33%;background:#e5484d}
.meter.medium i{width:66%;background:#e0a94a}
.meter.strong i{width:100%;background:#3fb950}
.meter-label{font-size:.75rem;color:var(--muted);min-height:1em;margin-top:-6px}
.hint{color:var(--muted);font-size:.8rem;text-align:center;margin-top:16px}
a{color:var(--blue-light);text-decoration:none}
a:hover{text-decoration:underline}
"}}

  {:name :_login-page-style-node
   :parent :wrap-style
   :args {:content :_login-page-css}}

  {:name :_login-page-viewport
   :parent :const
   :args {:value [:meta {:name "viewport" :content "width=device-width, initial-scale=1"}]}}

  {:name :_login-page-head
   :parent :list
   :args {:items [:_login-page-viewport :_login-page-style-node]}}

  {:name :_login-page-js
   :parent :const
   :args {:value "
(function(){
  var KEY='graphden.auth.password';
  var next=new URLSearchParams(location.search).get('next')||'/';
  var err=document.getElementById('login-err');
  function show(which){
    ['login','signup'].forEach(function(k){
      document.getElementById('tab-'+k).classList.toggle('active',k===which);
      document.getElementById('form-'+k).classList.toggle('active',k===which);
    });
    err.textContent='';
  }
  document.getElementById('tab-login').onclick=function(){show('login');};
  document.getElementById('tab-signup').onclick=function(){show('signup');};
  function submit(form,url,e){
    e.preventDefault();
    err.textContent='';
    var body=new URLSearchParams(new FormData(form)).toString();
    fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body})
      .then(function(r){return r.text().then(function(t){return {ok:r.ok,status:r.status,token:(t||'').trim()};});})
      .then(function(res){
        if(res.ok&&res.token){localStorage.setItem(KEY,res.token);location.href=next;return;}
        if(res.status===429){err.textContent='Too many attempts — wait a minute and try again.';return;}
        err.textContent=(url.indexOf('signup')!==-1)?'That username or organization is already taken.':'Wrong username or password.';
      })
      .catch(function(){err.textContent='Network error — please try again.';});
  }
  var pw=document.getElementById('su-pass');
  var meter=document.getElementById('su-meter');
  var label=document.getElementById('su-meter-label');
  function score(v){
    if(!v)return null;
    var s=0;
    if(v.length>=8)s++;
    if(v.length>=12)s++;
    if(/[a-z]/.test(v)&&/[A-Z]/.test(v))s++;
    if(/[0-9]/.test(v))s++;
    if(/[^A-Za-z0-9]/.test(v))s++;
    return s<=2?'weak':(s<=3?'medium':'strong');
  }
  pw.oninput=function(){
    var r=score(pw.value);
    meter.className='meter'+(r?' '+r:'');
    label.textContent=r?({weak:'Weak password',medium:'Medium password',strong:'Strong password'})[r]:'';
  };
  document.getElementById('form-login').onsubmit=function(e){submit(this,'/api/login',e);};
  document.getElementById('form-signup').onsubmit=function(e){
    e.preventDefault();
    if(pw.value.length<8){err.textContent='Password must be at least 8 characters.';return;}
    if(pw.value!==document.getElementById('su-pass2').value){err.textContent='Passwords do not match.';return;}
    submit(this,'/api/signup',e);
  };
})();
"}}

  {:name :_login-page-script-node
   :parent :wrap-script
   :args {:content :_login-page-js}}

  {:name :_login-page-scripts
   :parent :list
   :args {:items [:_login-page-script-node]}}

  {:name :_login-page-body
   :parent :const
   :args {:value
          [:div {:class "card"}
           [:div {:class "brand"}
            [:svg {:viewBox "0 0 32 32" :fill "none" :width "26" :height "26" :aria-hidden "true"}
             [:g {:stroke "currentColor" :stroke-width "3" :stroke-linecap "round"}
              [:line {:x1 "9" :y1 "6" :x2 "25" :y2 "26"}]
              [:line {:x1 "17" :y1 "16" :x2 "8" :y2 "26"}]]
             [:g {:fill "currentColor"}
              [:circle {:cx "9" :cy "6" :r "3"}]
              [:circle {:cx "25" :cy "26" :r "3"}]
              [:circle {:cx "8" :cy "26" :r "3"}]]]
            [:b "graph" [:i "den"]]]
           [:p {:class "sub"} "Sign in, or create your workspace"]
           [:div {:class "tabs"}
            [:button {:id "tab-login" :type "button" :class "tab active"} "Sign in"]
            [:button {:id "tab-signup" :type "button" :class "tab"} "Create account"]]
           [:form {:id "form-login" :class "active"}
            [:label {:for "li-user"} "Username"]
            [:input {:id "li-user" :name "username" :autocomplete "username" :required "required"}]
            [:label {:for "li-pass"} "Password"]
            [:input {:id "li-pass" :name "password" :type "password" :autocomplete "current-password" :required "required"}]
            [:button {:type "submit" :class "submit"} "Sign in"]]
           [:form {:id "form-signup"}
            [:label {:for "su-org"} "Organization name"]
            [:input {:id "su-org" :name "org" :autocomplete "organization" :required "required"}]
            [:label {:for "su-user"} "Username"]
            [:input {:id "su-user" :name "username" :autocomplete "username" :required "required"}]
            [:label {:for "su-pass"} "Password"]
            [:input {:id "su-pass" :name "password" :type "password" :autocomplete "new-password" :required "required"}]
            [:div {:id "su-meter" :class "meter"} [:i]]
            [:p {:id "su-meter-label" :class "meter-label"}]
            [:label {:for "su-pass2"} "Confirm password"]
            [:input {:id "su-pass2" :type "password" :autocomplete "new-password" :required "required"}]
            [:button {:type "submit" :class "submit"} "Create account"]]
           [:p {:id "login-err" :class "err"}]
           [:p {:class "hint"} "Self-hosting? "
            [:a {:href "https://github.com/Graphden/graphden"} "Run your own"] " — free and uncapped."]]}}

  {:name :_login-page-rendered
   :description "The /login page rendered to an HTML string — brand-styled sign-in / create-org card with an inline script that stores the bearer + redirects."
   :parent :render-hiccup
   :return-type :text
   :args {:hiccup {:parent :html-page
                   :args {:title {:value "Graphden — sign in"}
                          :body :_login-page-body
                          :head :_login-page-head
                          :scripts :_login-page-scripts}}}}

  {:name :_login-page-handler
   :lambda-params []
   :description "Ring handler for GET /login — the full public login / sign-up page."
   :parent :html-ok-response
   :args {:body :_login-page-rendered}}

  ;; ==========================================================================
  ;; TENANT AUTH-FORM PARTIAL — overrides the core `GET /partials/auth-form`.
  ;; The route-collection seam consults the tenancy router BEFORE the main app
  ;; router, so a tenancy deployment serves THESE fields (username + password +
  ;; org + create-account toggle) and a single-tenant build — which never loads
  ;; this package — serves the core admin-password-only variant. No hidden
  ;; markup to un-hide: each deployment ships exactly its own form.
  ;; ==========================================================================
  {:name :_tauth-username-input
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:value {:id "auth-username-input" :type "text" :placeholder "Username"
                          :autocomplete "username" :class "auth-username-input"}}
          :children {:value []}}}

  {:name :_tauth-password-input
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:value {:id "auth-password-input" :type "password" :placeholder "Password"
                          :autocomplete "current-password"}}
          :children {:value []}}}

  {:name :_tauth-eye-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:id "auth-toggle-visibility-btn" :type "button"
                          :class "auth-toggle-visibility" :tabindex "-1" :title "Show password"}}
          :children {:value []}}}

  {:name :_tauth-input-wrap
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "auth-input-wrap"}}
          :children [:_tauth-password-input :_tauth-eye-btn]}}

  {:name :_tauth-org-input
   :description "New-org field — hidden until the Create-account toggle flips signup mode (editor-auth.js applyAuthMode)."
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:value {:id "auth-org-input" :type "text" :placeholder "New org name"
                          :autocomplete "off" :class "auth-username-input hidden"}}
          :children {:value []}}}

  {:name :_tauth-save-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:id "auth-save-btn" :class "auth-popover-btn"}}
          :children ["Sign in"]}}

  {:name :_tauth-cancel-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:id "auth-cancel-btn" :class "auth-popover-btn"}}
          :children ["Cancel"]}}

  {:name :_tauth-popover-row
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "auth-popover-row"}}
          :children [:_tauth-save-btn :_tauth-cancel-btn]}}

  {:name :_tauth-error
   :description "Error line — also carries the `data-auth-mode` marker editor-auth.js reads to pick the tenant submit path."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:id "auth-error" :class "auth-error hidden"
                          :data-auth-mode "tenant"}}
          :children {:value []}}}

  {:name :_tauth-mode-toggle
   :parent :hiccup
   :args {:tag {:value "a"}
          :attrs {:value {:id "auth-mode-toggle" :class "auth-mode-toggle"}}
          :children ["Create account"]}}

  {:name :_tauth-form-fields
   :parent :list
   :args {:items [:_tauth-username-input :_tauth-input-wrap :_tauth-org-input
                  :_tauth-popover-row :_tauth-error :_tauth-mode-toggle]}}

  {:name :_tauth-form-html
   :parent :render-hiccup
   :args {:hiccup :_tauth-form-fields}}

  {:name :_tauth-form-handler
   :lambda-params []
   :description "Ring handler for the TENANT GET /partials/auth-form — username/password/org fields as text/html. Unauthenticated (it IS the login form)."
   :parent :html-ok-response
   :args {:body :_tauth-form-html}}

  {:name :auth-form-partial-route
   :description "GET /partials/auth-form (tenant variant) — shadows the core admin-password partial via the route-collection seam."
   :parent :get-route
   :args {:path "/partials/auth-form" :handler :_tauth-form-handler}}

  ;; UNAUTHENTICATED — `:get-route` (no auth-required middleware): this page IS
  ;; how an unauthenticated visitor authenticates.
  {:name :login-page-route
   :description "GET /login — the public login / create-org page (unauthenticated)."
   :parent :get-route
   :args {:path "/login" :handler :_login-page-handler}}]}
