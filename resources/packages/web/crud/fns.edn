  {:name :parse-fn-from-form
   :description "Extract a fn entity's field map from a parsed form-data map. 10 fields: name + parent-id + namespace-id + description + return-type → return-type-fn-id + parent-ids (CSV-of-UUIDs) + base-fn-id + element-fn-id + expects-effects (CSV-of-bare-names with `null`/`[]` literals) + constraint (JSON + recursive keyword-restore)."
   :parent :merge
   :args {:maps [{:value {}}
                 :_parse-fn-form-name-fragment
                 :_parse-fn-form-parent-id-fragment
                 :_parse-fn-form-namespace-id-fragment
                 :_parse-fn-form-description-fragment
                 :_parse-fn-form-return-type-fragment
                 :_parse-fn-form-parent-ids-fragment
                 :_parse-fn-form-base-fn-id-fragment
                 :_parse-fn-form-element-fn-id-fragment
                 :_parse-fn-form-expects-effects-fragment
                 :_parse-fn-form-constraint-fragment]
          :form-data {:type :_form-data-shape
                      :description "Parsed application/x-www-form-urlencoded form-data map (`{field-name field-value}`). Each per-field fragment looks up its key here."}}}

  ;; --- :parse-ns-from-form (Variant-2). Was defbase delegating to a
  ;; since-removed `parse-ns-from-form` helper (a 3-branch `cond->` over
