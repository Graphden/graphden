   :parent :get-auth-required
   :args {:path "/partials/execute-popover" :handler :_partial-xp-handler}}

  {:name :partial-type-name-datalist
   :description "GET /partials/type-name-datalist — the create-type popover's name-autocomplete <datalist> (named type-rows with kind labels + primitives). AUTH-REQUIRED — only the authed create/edit-type flow mounts it."
   :parent :get-auth-required
