;; Graph layout calculation
;;
;; `get-layout-data` is a graph fn-def composing base-fn primitives so
;; the layout pipeline is visible in the graph rather than hidden in a
;; single big impl:
;;
;;   get-layout-data = _compute-layout( _load-graph-cached,
;;                                      _parse-layout-request(request) )
;;   _compute-layout = _layout-place( _layout-build-elements(graph, parsed) )
;;
;; Input: {root-id: uuid-string, expansions: {fn-id: level, ...}}
;; Output: {nodes: [...], edges: [...], grid-pos: {...}, validation: {...}}


{:namespace "app.layout"
 :description "Graph-layout pass — turns raw fn/arg entities + per-call expansion specs into the {:nodes :edges :grid-pos :validation} graph-elements response."
 :fns
 [;; =============================================================================
  ;; SHAPES: layout-pipeline stage records
  ;;
  ;; Each base-fn below produces a record of a known shape; naming them
  ;; lets the pipeline's stage args / return-types read as records
  ;; instead of bare `:jsonb`. `_`-prefixed — internal to this pipeline.
  ;; =============================================================================

  {:name :_parse-layout-request-shape
   :description "Output of `:_parse-layout-request` — the layout root and the per-fn expansion-level map keyed by graph node-id."
   :type {:root-id :uuid :expansions :text-keyed-map}}

  {:name :_graph-snapshot-shape
   :description "Output of `:_load-graph-cached` — every fn / slot / fn-slot / binding / list-item row plus the derived `:args` slot views. Each list element is one entity record (heterogeneous columns → `:jsonb`)."
   :type {:fns         [:list :jsonb]
          :slots       [:list :jsonb]
          :fn-slots    [:list :jsonb]
          :bindings    [:list :jsonb]
          :list-items  [:list :jsonb]
          :args        [:list :jsonb]}}

  {:name :_layout-elements-shape
   :description "Output of `:_layout-build-elements` — the graph node / edge lists (each element a `{:data … :position?}` map) before grid placement."
   :type {:nodes [:list :jsonb]
          :edges [:list :jsonb]}}

  {:name :_layout-response-shape
   :description "Output of `:_layout-place` — the full layout response: placed nodes / edges plus a node-id → position map and validation summary."
   :type {:nodes      [:list :jsonb]
          :edges      [:list :jsonb]
          :grid-pos   [:map :text :jsonb]
          :validation :jsonb}}

  ;; =============================================================================
  ;; BASE-FNS: layout pipeline primitives
  ;;
  ;; Each is exactly ONE library call into `graphden.layout.*`.
  ;; Composition, error handling, and upstream-error pass-through live
  ;; in the graph fn-defs below.
  ;; =============================================================================

  {:name :_load-graph-cached
   :description "Load every fn/slot/binding entity for layout, served from the per-context graph cache when warm. Context-aware (reads storage from `ctx`)."
   :args {}
   :return-type :_graph-snapshot-shape
   :effects #{:db}}

  {:name :_fn-branch-local-seed
   :description "`{:own bool :seed \"name\"}` when the fn or an ancestor is branch-local (the 📍 strip's fact), nil otherwise — read by the Inspector Overview's Merge row."
   :args {:fn-id {:type :nullable-uuid :required false}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :_fn-slot-seal-facts
   :description "Authorized effective slot identities and canonical inherited seal facts, without Inspector wording."
   :args {:fn-id {:type :nullable-uuid :required false}}
   :return-type [:list :any]
   :effects #{:db}}

  {:name :_seal-fields
   :parent :get
   :args {:coll {:as :item} :key 1 :default {:value {}}}}

  {:name :_seal-sealed-by
   :parent :get
   :args {:coll :_seal-fields :key {:value :sealed-by} :default nil}}
  {:name :_seal-list-closed-by
   :parent :get
   :args {:coll :_seal-fields :key {:value :list-closed-by} :default nil}}
  {:name :_seal-required-by
   :parent :get
   :args {:coll :_seal-fields :key {:value :required-by} :default nil}}
  {:name :_seal-optional?
   :parent :get
   :args {:coll :_seal-fields :key {:value :optional?} :default false}}

  {:name :_seal-present?
   :parent :or
   :args {:values [:_seal-optional? :_seal-sealed-by :_seal-list-closed-by :_seal-required-by]}}

  {:name :_seal-note-parts
   :parent :list
   :args {:items [{:parent :if
                   :args {:test :_seal-sealed-by
                          :then {:parent :str :args {:parts ["sealed in " :_seal-sealed-by]}}
                          :else nil}}
                  {:parent :if
                   :args {:test :_seal-list-closed-by
                          :then {:parent :str :args {:parts ["list closed in " :_seal-list-closed-by]}}
                          :else nil}}
                  {:parent :if
                   :args {:test :_seal-optional?
                          :then {:parent :if
                                 :args {:test :_seal-required-by
                                        :then {:parent :str :args {:parts ["required since " :_seal-required-by]}}
                                        :else "optional"}}
                          :else nil}}]}}

  {:name :_seal-note
   :parent :str-join
   :args {:coll {:parent :filter
                 :args {:pred {:parent :some? :args {:value {:as :item}}}
                        :coll :_seal-note-parts}}
          :separator " · "}}

  {:name :_seal-entry
   :parent :list
   :args {:items [{:parent :get :args {:coll {:as :item} :key 0 :default nil}}
                  {:parent :assoc
                   :args {:map :_seal-fields :key {:value :note} :value :_seal-note}}]}}

  {:name :_fn-slot-seals
   :description "Inspector seals keyed by effective slot name. Authorized facts feed graph-visible filtering and ordered seal/list/required/optional wording."
   :parent :pairs->map
   :args {:entries {:parent :map
                    :args {:func :_seal-entry
                           :coll {:parent :filter
                                  :args {:pred :_seal-present? :coll :_fn-slot-seal-facts}}}}}
   :return-type :keyword-map}

  {:name :_layout-read-json-body
   :description "Canonical Ring JSON request-body decoder."
   :args {:request {:type :ring-request-shape}}
   :return-type :any}
  {:name :_layout-parse-expansions
   :description "Canonical expansion-spec codec with exact per-call-site string node ids."
   :args {:expansions {:type [:map :keyword-or-text :any]}}
   :return-type :text-keyed-map}
  {:name :_layout-parse-uuid
   :description "Strict UUID parsing; malformed input throws IllegalArgumentException."
   :args {:value {:type :text}}
   :return-type :uuid}
  {:name :_layout-value-class
   :description "Host value class name for request diagnostics."
   :args {:value {:type :any}}
   :return-type :text}

  {:name :_layout-body-root
   :parent :get
   :args {:coll :_layout-read-json-body :key {:value :root-id} :default nil}}
  {:name :_layout-body-expansions
   :parent :get
   :args {:coll :_layout-read-json-body :key {:value :expansions} :default nil}}

  {:name :_layout-request-error
   :parent :throw
   :args {:exception {:parent :ex-info
                      :args {:message {:as :message} :data {:as :data}}}}}
  {:name :_layout-missing-root-error
   :parent :_layout-request-error
   :args {:message "Request body must contain 'root-id'"
          :data {:value {:type :execution-error/invalid-args}}}}
  {:name :_layout-root-type-error
   :parent :_layout-request-error
   :args {:message "Request body 'root-id' must be a UUID string"
          :data {:parent :assoc
                 :args {:map {:value {:type :execution-error/invalid-args}}
                        :key {:value :got}
                        :value {:parent :_layout-value-class :args {:value :_layout-body-root}}}}}}
  {:name :_layout-expansions-type-error
   :parent :_layout-request-error
   :args {:message "Request body 'expansions' must be a map of node-id → spec"
          :data {:parent :assoc
                 :args {:map {:value {:type :execution-error/invalid-args}}
                        :key {:value :got}
                        :value {:parent :_layout-value-class :args {:value :_layout-body-expansions}}}}}}

  {:name :_layout-parsed-body
   :parent :zipmap
   :args {:keys [:root-id :expansions]
          :vals [{:parent :_layout-parse-uuid
                  :args {:value {:ref :_layout-body-root :type :text}}}
                 {:parent :_layout-parse-expansions
                  :args {:expansions {:parent :coalesce
                                      :args {:value :_layout-body-expansions :default {:value {}}}}}}]}
   :return-type :_parse-layout-request-shape}

  {:name :_parse-layout-body
   :description "Graph request policy: require a string root, accept nil/map expansions, then decode UUID and canonical expansion specs. Error class/message contracts remain unchanged."
   :parent :cond
   :args {:clauses [{:parent :not :args {:value :_layout-body-root}}
                    :_layout-missing-root-error
                    {:parent :not
                     :args {:value {:parent :is-a?
                                    :args {:value :_layout-body-root :type {:value :text}}}}}
                    :_layout-root-type-error
                    {:parent :not
                     :args {:value {:parent :or
                                    :args {:values [{:parent :nil? :args {:value :_layout-body-expansions}}
                                                    {:parent :is-a?
                                                     :args {:value :_layout-body-expansions :type {:value :map}}}]}}}}
                    :_layout-expansions-type-error
                    true :_layout-parsed-body]}
   :return-type :_parse-layout-request-shape}

  {:name :_layout-build-apply
   :description "Single library call — build graph `{:nodes :edges}` from the graph snapshot + parsed request. Throws ExceptionInfo on `:execution-error/not-found`."
   :args {:graph {:type :_graph-snapshot-shape}
          :parsed {:type :_parse-layout-request-shape}}
   :return-type :_layout-elements-shape}

  {:name :_layout-place-apply
   :description "Single library call — grid-place `{:nodes :edges}` into the full layout response."
   :args {:elements {:type :_layout-elements-shape}}
   :return-type :_layout-response-shape}

  {:name :_layout-literal-previews
   :description "Bounded canonical safe preview evaluation. Markers, secret references and invalid refinements cannot reach a repr; effect denial and sanitization stay native."
   :args {:elements {:type :_layout-elements-shape}
          :graph {:type :_graph-snapshot-shape}
          :selector {:type [:fn {:dispatch {:registry [:list :any] :type-expr :type-expression}} :nullable-text #{}]}}
   :return-type [:list {:node :keyword-map :repr [:union :null :hiccup-node]}]}

  {:name :_layout-literal-preview-node
   :parent :get
   :args {:coll {:as :item} :key {:value :node} :default nil}}
  {:name :_layout-literal-preview-repr
   :parent :get
   :args {:coll {:as :item} :key {:value :repr} :default nil}}
  {:name :_layout-attach-literal-preview
   :parent :if
   :args {:test {:parent :some? :args {:value :_layout-literal-preview-repr}}
          :then {:parent :assoc-in
                 :args {:m :_layout-literal-preview-node :path [:data :literalRepr]
                        :v :_layout-literal-preview-repr}}
          :else :_layout-literal-preview-node}}

  {:name :_layout-literal-reprs-attach
   :parent :assoc
   :args {:map {:as :elements} :key {:value :nodes}
          :value {:parent :vec
                  :args {:coll {:parent :map
                                :args {:func :_layout-attach-literal-preview
                                       :coll {:parent :_layout-literal-previews :args {:selector :form-registry-selector}}}}}}}}

  {:name :_layout-literal-reprs-apply
   :description "Pass layout failures through; attach present safe literal previews in graph composition."
   :parent :if
   :args {:test :_layout-place-failed? :then {:as :elements}
          :else :_layout-literal-reprs-attach}
   :return-type :_layout-elements-shape}

  {:name :_layout-safe-strip-facts
   :description "Canonical authorized strip facts by visible fn id. Concealed chain names never leave this boundary."
   :args {:elements {:type :_layout-elements-shape}
          :graph {:type :_graph-snapshot-shape}}
   :return-type :text-keyed-map}

  {:name :_layout-node-strip-facts
   :parent :get
   :args {:coll :_layout-safe-strip-facts
          :key {:parent :get-in
                :args {:map {:as :item} :path [:data :originalFnId] :default nil}}
          :default nil}}

  {:name :_layout-node-with-strip-facts
   :parent :if
   :args {:test {:parent :some? :args {:value :_layout-node-strip-facts}}
          :then {:parent :assoc
                 :args {:map {:as :item}
                        :key {:value :data}
                        :value {:parent :merge
                                :args {:maps [{:parent :get
                                               :args {:coll {:as :item} :key {:value :data} :default nil}}
                                              :_layout-node-strip-facts]}}}}
          :else {:as :item}}}

  {:name :_layout-strip-facts-apply
   :description "Attach authorized strip facts to node data while retaining all other layout fields."
   :parent :assoc
   :args {:map {:as :elements :type :_layout-elements-shape}
          :key {:value :nodes}
          :value {:parent :vec
                  :args {:coll {:parent :map
                                :args {:func :_layout-node-with-strip-facts
                                       :coll {:parent :get
                                              :args {:coll {:as :elements} :key {:value :nodes} :default []}}}}}}}
   :return-type :_layout-elements-shape}

  ;; =============================================================================
  ;; FN-DEFS: error-shape templates + pass-through guards
  ;; =============================================================================

  {:name :_layout-err-message
   :description "`{:ok false :error <exception.message>}` — the shape `:_layout-build-elements` and `:_parse-layout-request` use to surface ExceptionInfo / IllegalArgumentException messages. `:return-type` pinned to keep downstream `:if`/`:cond` unions a union of precise record shapes."
   :parent :zipmap
   :return-type :error-result-shape
   :args {:keys [:ok :error]
          :vals [false
                 {:parent :throwable-message
                  :args {:ex {:as :exception}}}]}}

  ;; =============================================================================
  ;; FN-DEFS: :_parse-layout-request — :try with multi-class dispatch
  ;; =============================================================================

  {:name :_parse-layout-err-bad-json
   :description "Static err — JsonParseException leaks `Source: REDACTED` info if we surface .getMessage; replace with a generic message."
   :parent :const
   :return-type :error-result-shape
   :args {:value {:ok false :error "Request body is not valid JSON"}}}

  {:name :_parse-layout-err-invalid-request
   :description "`{:ok false :error \"Invalid request: <msg>\"}` — IllegalArgumentException (typically from `UUID/fromString`) gets a prefix to disambiguate from server-side errors. `:return-type` pinned to keep the parent on-throw cond's union of precise record shapes."
   :parent :zipmap
   :return-type :error-result-shape
   :args {:keys [:ok :error]
          :vals [false
                 {:parent :str
                  :args {:parts ["Invalid request: "
                                 {:parent :throwable-message
                                  :args {:ex {:as :exception}}}]}}]}}

  {:name :_parse-layout-err-rethrow
   :description "Fallback — any exception class outside the three expected user-input classes is rethrown so it surfaces as a 500 / proper server error."
   :parent :throw
   :args {:exception {:as :exception}}}

  {:name :_parse-layout-exception-class
   :description "Look up the exception's class-name once so the `:cond` clauses can compare against literal class-name strings."
   :parent :throwable-class-name
   :args {:ex {:as :exception}}}

  {:name :_parse-layout-on-throw
   :description "1-arg handler — dispatch on the caught exception's class name to JsonParseException / ExceptionInfo / IllegalArgumentException err-shapes, else rethrow."
   :parent :cond
   :args {:clauses [{:parent :equal?
                     :args {:a :_parse-layout-exception-class
                            :b {:value "com.fasterxml.jackson.core.JsonParseException"}}}
                    :_parse-layout-err-bad-json
                    {:parent :equal?
                     :args {:a :_parse-layout-exception-class
                            :b {:value "clojure.lang.ExceptionInfo"}}}
                    :_layout-err-message
                    {:parent :equal?
                     :args {:a :_parse-layout-exception-class
                            :b {:value "java.lang.IllegalArgumentException"}}}
                    :_parse-layout-err-invalid-request
                    {:value true}
                    :_parse-layout-err-rethrow]}}

  {:name :_parse-layout-request
   :description "Parse the internal Ring request body into `{:root-id :expansions}` via graph validation and a `:try` around the decoding codecs. On JsonParseException / ExceptionInfo / IllegalArgumentException the on-throw handler returns `{:ok false :error}`; other exceptions propagate."
   :parent :try
   :args {:body :_parse-layout-body
          :on-throw :_parse-layout-on-throw}}

  ;; =============================================================================
  ;; FN-DEFS: :_layout-build-elements — :if pass-through + :try
  ;; =============================================================================

  {:name :_layout-build-try
   :description "Run `:_layout-build-apply` and convert any ExceptionInfo into `:_layout-err-message`. Pure graph `:try`."
   :parent :try
   :args {:body :_layout-build-apply
          :on-throw :_layout-err-message
          :graph {:as :graph}
          :parsed {:as :parsed}}}

  {:name :_layout-build-elements
   :description "Stage A — pass an upstream `{:ok false}` parse result through, otherwise build graph `{:nodes :edges}`."
   :parent :if
   :args {:test :_layout-build-parsed-failed?
          :then {:as :parsed}
          :else :_layout-build-try
          :graph {:as :graph}
          :parsed {:as :parsed}}}

  {:name :_layout-build-parsed-failed?
   :description "True iff `:parsed` is an upstream `{:ok false}` payload."
   :parent :equal?
   :args {:a {:parent :get
              :args {:coll {:as :parsed}
                     :key {:value :ok}
                     :default nil}}
          :b {:value false}}}

  ;; =============================================================================
  ;; FN-DEFS: :_layout-strip-facts — :if pass-through
  ;; =============================================================================

  {:name :_layout-strip-facts
   :description "Stage A.5 — pass an upstream `{:ok false}` through, otherwise annotate fn-nodes with the strip facts. Shares the `{:ok false}` test with `:_layout-place` (same `:elements` free-arg name, values unify)."
   :parent :if
   :args {:test :_layout-place-failed?
          :then {:as :elements}
          :else :_layout-strip-facts-apply
          :elements {:as :elements}
          :graph {:as :graph}}}

  ;; build → strip-facts. `:graph` propagates by name into BOTH the
  ;; build stage and the annotate stage.
  {:name :_layout-elements-with-strips
   :parent :_layout-strip-facts
   :args {:elements :_layout-build-elements}}

  ;; =============================================================================
  ;; FN-DEFS: :_layout-place — :if pass-through
  ;; =============================================================================

  {:name :_layout-place
   :description "Stage B — pass an upstream `{:ok false}` from `:_layout-build-elements` through, otherwise grid-place the elements."
   :parent :if
   :args {:test :_layout-place-failed?
          :then {:as :elements}
          :else :_layout-place-apply
          :elements {:as :elements}}}

  {:name :_layout-place-failed?
   :description "True iff `:elements` is an upstream `{:ok false}` payload."
   :parent :equal?
   :args {:a {:parent :get
              :args {:coll {:as :elements}
                     :key {:value :ok}
                     :default nil}}
          :b {:value false}}}

  ;; =============================================================================
  ;; FN-DEFS: layout pipeline composition
  ;; =============================================================================

  {:name :_layout-elements-with-reprs
   :parent :_layout-literal-reprs-apply
   :args {:elements :_layout-elements-with-strips}}

  ;; build → strip-facts → place. Free args `graph` + `parsed`
  ;; propagate up from the inner stages.
  {:name :_compute-layout
   :description "Run the build → strip-facts → place layout pipeline for one parsed request. Composition of `:_layout-build-elements` → `:_layout-strip-facts` → `:_layout-place`. Owns `:graph` as an explicit free pin — value flows down to the build + annotate stages by name match."
   :parent :_layout-place
   :args {:elements :_layout-elements-with-reprs
          :graph {:type :_graph-snapshot-shape
                  :description "Full entity graph snapshot — typically supplied by `:_load-graph-cached`."}}}

  ;; parse → load → compute. Context-aware: free arg `request`
  ;; propagates up from `_parse-layout-request`.
  {:name :get-layout-data
   :description "Fetch every fn/arg entity from storage, expand the requested subgraph based on the request's `:root-id` + `:expansions` map, run the layout pipeline, and return `{:nodes :edges :grid-pos :validation}`. Composition of `:_parse-layout-request` → `:_load-graph-cached` → `:_compute-layout`."
   :parent :_compute-layout
   :args {:graph :_load-graph-cached
          :parsed :_parse-layout-request}}

  ;; =============================================================================
  ;; FN-DEFS: Layout API handler
  ;; =============================================================================

  ;; Layout handler — fn-graph composition, no factory.
  {:name :_layout-api-handler
   :parent :json-ok-response
   :args {:body :_layout-api-body}}

  {:name :_layout-api-body
   :parent :to-json-string
   :args {:data :get-layout-data}}

  ;; The concrete `/api/graph/layout` route lives in `app.routes`.
  ]}
