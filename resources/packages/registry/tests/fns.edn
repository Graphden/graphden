  ;; A `:zipmap` with LITERAL keys computes a RECORD (`{:q {…}}`), and the
  ;; review / install slots are declared `[:map :text :any]` — a record is
  ;; not a subtype of that, so the fixture is widened at the call site with
  ;; `{:parent :const :return-type :any}` (`:any` is provable from any
  ;; computed type). Runtime value is unchanged: a string-keyed map.
  {:name :_t-card-q
   :description "Subject: a locally published package with one review aggregate and an install count captured."
   :parent :marketplace-card
   :args {:item {:value [{:name "q" :version "0.1.0"}]}
          :reviews {:parent :const :return-type :any :return-type-wide? true :args {:value {:parent :zipmap :args {:keys [{:value "q"}] :vals [{:value {:count 1 :avg 3.0}}]}}}}
          :installs {:parent :const :return-type :any :return-type-wide? true :args {:value {:parent :zipmap :args {:keys [{:value "q"}] :vals [{:value 7}]}}}}}}

  {:name :card-rating-is-looked-up-by-name-in-the-review-map
