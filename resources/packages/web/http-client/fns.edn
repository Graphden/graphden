;; Outgoing HTTP — ONE universal base-fn plus a graph-level
;; specialization LADDER (the same shape the server side uses:
;; `:route` carries `:method` as data, `:get-route` pins it):
;;
;;   :http-request            method :text (ANY RFC 9110 token —
;;                            custom/extension methods welcome; the
;;                            impl's wire-method backstop validates
;;                            the token grammar at runtime)
;;     └─ :standard-http-request   method NARROWED to :http-method
;;                                 ([:in] refinement — the standard
;;                                 set), still free
;;          ├─ :http-get           method PINNED "get"
;;          ├─ :http-post          method PINNED "post"
;;          ├─ :http-put           method PINNED "put"
;;          ├─ :http-delete        method PINNED "delete"
;;          └─ :http-patch         method PINNED "patch"
;;   (+ :http-get-with-authorization — back-compat rename preset,
;;      parented on the ROOT: it renames the defaulted :headers slot,
;;      and the checker resolves such renames only against the slot
;;      owner's direct child)
;;
;; Need a custom method? Parent `:http-request`. Standard method with
;; a custom shape? Parent `:standard-http-request` or a per-method
;; preset. Per-resource fns (a concrete API: pinned url template,
;; auth from vault, body narrowed to a record) parent the presets —
;; all further narrowing is ordinary fn-def authoring, no impl work.
;;
;; Every security guard (SSRF egress classifier, DNS-pinned dial,
;; per-org rate cap, response byte-cap) lives in the ONE impl, so no
;; descendant can specialize past it.


{:namespace "web.http-client"
 :description "Outgoing HTTP — the universal :http-request primitive and its per-method preset ladder."
 :fns
 [;; Return shape: same keys http-kit emits, but stringified at the
  ;; boundary so the fn-graph stays primitive-typed end-to-end. The
  ;; record subtype rule (open) means downstream `:get` of `"body"`
  ;; / `"status"` works directly without an extra adapter.
  {:name :http-response-shape
   :description "Result of the :http-request family — `{status, headers, body}` mirroring http-kit's response map (headers stringified, body slurped to text)."
   :type {:status :int
          :headers :text-map
          :body :text}}

  {:name :http-request
   :description "Universal outbound HTTP request — method carried as DATA (`:http-method-token`, any RFC 9110 token). Returns `{:status :headers :body}` — body slurped to text, headers stringified; non-2xx responses are returned with their actual status so callers can branch. Throws `http-client/request-failed` on transport errors. Prefer the per-method presets (`:http-get`, `:http-post`, …) — a preset node states its intent in the graph; use this root directly only when the method itself is dynamic or non-standard."
   :args {:method {:type :text
                   :description "HTTP request method, lower-case by convention (`\"get\"`, `\"post\"`, custom tokens allowed — any RFC 9110 token; the impl validates the grammar and upper-cases at the wire boundary)."}
          :url {:type :url
                :description "Absolute URL, e.g. `https://httpbin.org/anything`."}
          :headers {:type :text-map
                    :value {}
                    :description "Header map. Keys + values are strings. Defaults to empty. Plain `:text` values only — secret-typed values are rejected at sync-time; auth flows go through `:auth-value`."}
          :body {:type :nullable-text
                 :value nil
                 :description "Request body as text (JSON-encode upstream via `:to-json-string`; set the `Content-Type` header alongside). nil = no body (methods that require one on the wire send an empty body)."}
          :auth-value {:type [:union :null [:secret :text]]
                       :value nil
                       :description "Full `Authorization` header value (e.g. `\"Bearer xxx\"`), or nil for unauthenticated requests. The slot accepts `[:secret :text]` structurally — a vault-sourced token never crosses the generic `:headers` map; the impl injects it at the wire boundary (auth wins on key collision)."}
          :timeout-ms {:type :positive-int
                       :value 10000
                       :description "Connect+read timeout in milliseconds. Defaults to 10s."}}
   :return-type :http-response-shape
   :effects #{:network}}

  ;; --- The standard-method rung: type-NARROW, slot stays free -----------
  {:name :standard-http-request
   :description "`:http-request` with `:method` narrowed to the standard set (`:http-method` — get/post/put/delete/patch/head/options), still free. Parent this when the method is chosen at composition time but not fixed yet (e.g. a `:case` dispatch); parent `:http-request` itself for custom protocol tokens."
   :parent :http-request
   :args {:method {:type :http-method}}}

  ;; --- Per-method presets: value-PIN ------------------------------------
  ;; Bare literals: the sweep validates them against :http-method's
  ;; `[:in]` constraint (literal-satisfies-refinement?). `:http-get`
  ;; keeps the root's `body nil` default (a GET does not send a body).
  {:name :http-get
   :description "HTTP GET preset — `:standard-http-request` with the method pinned; body stays at the root's nil default. Free: `:url`, `:headers`, `:auth-value` (secret-friendly Authorization), `:timeout-ms`."
   :parent :standard-http-request
   :args {:method "get"}}

  {:name :http-post
   :description "HTTP POST preset. Free: `:url`, `:body` (text — JSON-encode upstream and set `Content-Type`), `:headers`, `:auth-value`, `:timeout-ms`."
   :parent :standard-http-request
   :args {:method "post"}}

  {:name :http-put
   :description "HTTP PUT preset. Free: `:url`, `:body`, `:headers`, `:auth-value`, `:timeout-ms`."
   :parent :standard-http-request
   :args {:method "put"}}

  {:name :http-delete
   :description "HTTP DELETE preset. Free: `:url`, `:headers`, `:auth-value`, `:timeout-ms`; `:body` stays available (rare but legal on the wire)."
   :parent :standard-http-request
   :args {:method "delete"}}

  {:name :http-patch
   :description "HTTP PATCH preset. Free: `:url`, `:body`, `:headers`, `:auth-value`, `:timeout-ms`."
   :parent :standard-http-request
   :args {:method "patch"}}

  ;; --- Back-compat rename preset ----------------------------------------
  ;; Pre-ladder callers bound `:extra-headers`; keep their surface as a
  ;; rename preset. Parented on the ROOT (not :http-get): renaming the
  ;; DEFAULTED :headers slot resolves only against the slot owner's
  ;; direct child — through an intermediate rung the sweep reports
  ;; "not a slot of <parent>". `:auth-value` (root slot) is the same
  ;; arg it always was.
  {:name :http-get-with-authorization
   :description "Auth-aware HTTP GET — `:http-request` with the method pinned and `:headers` re-exposed as `:extra-headers` (back-compat surface). Bind `:auth-value` with the full Authorization header value; its `[:secret :text]`-accepting slot is the secret-flow boundary — vault tokens never cross a generic `:text-map` slot."
   :parent :http-request
   :args {:method "get"
          :headers {:as :extra-headers}}}]}
