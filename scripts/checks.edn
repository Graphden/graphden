;; Single source of truth for the CI check registry.
;;
;; Read by scripts/ci.clj (the parallel runner behind `bb ci` / `bb lint` /
;; `bb lint-<group>`). Each check delegates to its `bb <bb>` task — the actual
;; command lives ONLY in that task, so this file never duplicates it; here we
;; hold just the metadata the runner needs: display name, which bb task runs it,
;; a per-check timeout ceiling (ms, measured on an idle box), the group it
;; belongs to, and which files make it relevant.
;;
;; Groups drive the command hierarchy:
;;   :clj :web :infra :docs :sec   — domain lint sub-groups (`bb lint-clj`, …)
;;   :commit                       — commit-message lint (part of full lint)
;;   :test                         — the suites; run AFTER lint passes
;;   :post-test                    — reads what the test wave WROTE (`bb perf`
;;                                   grades perf/runs/*.edn), so it cannot share
;;                                   a wave with the runs it grades
;;   :info                         — non-blocking (a warning never fails the run)
;;
;; `:relevant` — diff-scoping (the landing gate's `bb ci --since <ref>`): a
;; vector of Java regexes matched (re-find) against each repo-relative changed
;; path. With `--since`, a check runs iff ≥1 changed file matches ≥1 pattern.
;; NO `:relevant` key = the check ALWAYS runs (typos scans identifiers in every
;; file kind; gitleaks — any file can carry a secret; commitlint — the commits
;; themselves are always new). Without `--since` the key is ignored and
;; everything runs — scoping is opt-in, the conservative default stands.
;; When editing a `bb` task's scan set, keep its `:relevant` in sync — a
;; too-narrow pattern silently green-lights a change the check never saw.
;;
;; `bb lint`  = every lint/commit group.
;; `bb ci`    = lint (fail-fast) -> test -> post-test  (+ :info alongside).
;; Order in this vector is the display order.
[{:name "clj-kondo"     :bb "kondo"         :timeout 120000 :group :clj
  :relevant ["\\.(clj|cljc|cljs|edn|bb)$"]}
 {:name "splint"        :bb "splint"        :timeout 120000 :group :clj
  :relevant ["\\.(clj|cljc|cljs|edn|bb)$"]}
 {:name "cljstyle"      :bb "cljstyle"      :timeout 120000 :group :clj
  :relevant ["\\.(clj|cljc|cljs|edn|bb)$"]}
 {:name "biome"         :bb "biome"         :timeout  60000 :group :web
  :relevant ["\\.(js|mjs|jsonc?)$"]}
 {:name "stylelint"     :bb "stylelint"     :timeout 120000 :group :web
  :relevant ["\\.css$" "^\\.stylelintrc"]}
 {:name "shellcheck"    :bb "shellcheck"    :timeout 120000 :group :infra
  :relevant ["\\.sh$" "^dev/wtq/wt$"]}
 {:name "hadolint"      :bb "hadolint"      :timeout 120000 :group :infra
  :relevant ["^Dockerfile"]}
 {:name "actionlint"    :bb "actionlint"    :timeout  60000 :group :infra
  :relevant ["^\\.github/workflows/"]}
 ;; The scoping mechanism guards itself: selector partition semantics +
 ;; checks.edn shape/regex validity + the canonical path→check drift table.
 {:name "ci-selftest"   :bb "ci-test"       :timeout  60000 :group :infra
  :relevant ["^scripts/ci" "^scripts/checks\\.edn$" "^bb\\.edn$"]}
 {:name "markdownlint"  :bb "markdownlint"  :timeout  60000 :group :docs
  :relevant ["\\.md$" "^\\.markdownlint"]}
 {:name "lychee"        :bb "lychee"        :timeout  60000 :group :docs
  :relevant ["\\.md$" "^\\.lychee"]}
 {:name "typos"         :bb "typos"         :timeout  60000 :group :docs}
 ;; The unit suite's mcp-doc-sync-test pins the same pair, but tests-unit is
 ;; diff-scoped OUT of a docs-only change — without this check, editing only
 ;; docs/AI_CONTEXT.md lands green locally and reddens develop on GitHub CI.
 {:name "ai-context-sync" :bb "ai-context-sync" :timeout 30000 :group :docs
  :relevant ["^docs/AI_CONTEXT\\.md$" "^resources/packages/mcp/mcp/ai-context\\.md$"]}
 {:name "devtour"       :bb "devtour-check" :timeout  60000 :group :docs
  :relevant ["^docs/devtour/" "^src/" "^scripts/devtour\\.clj$"]}
 {:name "gitleaks"      :bb "gitleaks"      :timeout 300000 :group :sec}
 {:name "trivy"         :bb "trivy"         :timeout 300000 :group :sec
  ;; Three passes (see the `trivy` bb task): (1) `config .` — RECURSIVE IaC
  ;; misconfig over docker-compose + deploy/ (kind, helm), not just Dockerfiles;
  ;; (2) `fs .` — CVE in the npm lockfiles; (3) `rootfs` over the resolved
  ;; classpath jars — CVE in the JVM / deps.edn deps (a tools.deps project has
  ;; no pom.xml, so this is the ONLY pass that sees Java deps). `deps.edn` is in
  ;; :relevant so a JVM-dep bump re-runs the scan.
  :relevant ["^Dockerfile" "deps\\.edn$" "package(-lock)?\\.json$" "^\\.trivyignore"
             "^docker-compose" "^deploy/" "^bb\\.edn$"]}
 ;; npm-only audit — a deps.edn change must NOT trigger it: the green would
 ;; read as "the new JVM dep's license was vetted", which this task never does.
 {:name "license-check" :bb "license-check" :timeout 120000 :group :sec
  :relevant ["package(-lock)?\\.json$"]}
 {:name "commitlint"    :bb "commitlint"    :timeout  60000 :group :commit}
 {:name "tests-js"      :bb "test-js"       :timeout  60000 :group :test
  :relevant ["\\.(js|mjs)$" "^tools/runtime-test/"]}
 {:name "tests-unit"    :bb "test-unit"     :timeout 900000 :group :test
  :relevant ["^src/" "^test/" "^resources/" "^scripts/" "^external-packages/"
             "^(bb|deps|tests)\\.edn$" "^build\\.clj$" "^dev-resources/" "^development/src/"]}
 {:name "tests-perf"    :bb "test-perf"     :timeout 300000 :group :test
  :relevant ["^src/" "^test/" "^resources/" "^scripts/" "^external-packages/"
             "^(bb|deps|tests)\\.edn$" "^build\\.clj$" "^dev-resources/" "^development/src/" "^perf/"]}
 {:name "perf"          :bb "perf"          :timeout  60000 :group :post-test
  :relevant ["^src/" "^test/" "^resources/" "^scripts/" "^external-packages/"
             "^(bb|deps|tests)\\.edn$" "^build\\.clj$" "^dev-resources/" "^development/src/" "^perf/"]}
 {:name "outdated"      :bb "outdated"      :timeout 120000 :group :info
  :relevant ["deps\\.edn$" "package(-lock)?\\.json$"]}]
