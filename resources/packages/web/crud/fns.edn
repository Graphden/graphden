  ;; via `:equal? "true"`).

  {:name :_parse-slot-form-name-fragment
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll {:as :form-data} :key {:value :name}}}
          :then {:parent :zipmap
                 :args {:keys [{:value :name}]
                        :vals [{:parent :to-str
                                :args {:value {:parent :get
                                               :args {:coll {:as :form-data}
                                                      :key {:value :name}
                                                      :default nil}}}}]}}
          :else {:value {}}}}

  {:name :_parse-slot-form-type-fn-id-fragment
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll {:as :form-data} :key {:value :type-fn-id}}}
          :then {:parent :zipmap
                 :args {:keys [{:value :type-fn-id}]
                        :vals [{:parent :parse-uuid
                                :args {:string {:parent :get
                                                :args {:coll {:as :form-data}
                                                       :key {:value :type-fn-id}
                                                       :default nil}}}}]}}
          :else {:value {}}}}

  {:name :_parse-slot-form-description-fragment
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll {:as :form-data} :key {:value :description}}}
          :then {:parent :zipmap
                 :args {:keys [{:value :description}]
                        :vals [{:parent :get
                                :args {:coll {:as :form-data}
                                       :key {:value :description}
                                       :default nil}}]}}
          :else {:value {}}}}

  {:name :_parse-slot-form-required-fragment
   :description "`{:required (= \"true\" v)}` when form-data contains `:required`."
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll {:as :form-data} :key {:value :required}}}
          :then {:parent :zipmap
