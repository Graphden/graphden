#!/usr/bin/env bash
# wt — worktree + merge-queue helper for parallel feature development.
#
# Model: N git worktrees, one per in-flight feature, each on its own
# `feature/<name>` branch off develop. You run a separate Claude Code
# (or human) session per worktree — real independent dialogs. Each runs
# the FAST loop (`bb ci` = linters + unit) freely and in parallel.
#
# When a feature is ready, `wt merge` (run FROM INSIDE that worktree)
# enters a machine-wide flock queue: at most one merge runs at a time.
# The gate merges the latest develop into the feature, runs the HEAVY
# suite (image build + integration + e2e) on the MERGED result,
# and only then fast-forwards develop. Green -> develop advances; red ->
# the branch bounces back to you with the log, develop untouched.
#
# The queue is stateless (the lock knows nothing about who is waiting),
# so worktrees can be created and dropped at any time.
#
# Two ways to start an agent:
#   A) hands-off:  wt agent   -> a NAMELESS discussion session. You describe the
#      task; the agent picks its own branch name, self-registers with `wt claim`,
#      works, lands it through the gate and cleans up after itself. You never
#      invent a name, and you are not asked to sign off on a finished feature.
#   B) manual:     wt new <name> [task...] [--start]  -> you pick the name.
#
# Commands:
#   wt agent               launch a nameless autonomous agent (discuss -> self-claim -> work)
#   wt claim <name> [task] (agent-invoked) register feature/<name> + worktree in the pool
#   wt new <name> [task...] [--start]  manual: create the worktree yourself (+ --start)
#   wt start <name>        launch an autonomous agent inside an existing worktree
#   wt task  <name>        print the feature's task spec
#   wt list                show every worktree, branch, ahead/behind, dirty, result
#   wt merge [--no-e2e] [--deploy]  (inside a worktree) queue + gate + land on develop
#                          --deploy: also reset the develop DB schema on landing
#   wt up                  (inside a worktree) build + run THIS branch on its own
#                          ports — your private instance; never touches the demo
#   wt down                (inside a worktree) stop it (keeps the DB volume)
#   wt gc                  reclaim superseded / orphaned executor images
#   wt doctor              report stray test JVMs / testcontainers + host state
#                          (a killed run leaves its JVM holding GBs; the next
#                           run then flakes on a machine nobody looked at)
#   wt ack                 (inside a worktree) print what develop changed in the
#                          rules you work under, and record that you have read it
#   wt status              show queue lock holder + recent gate logs
#   wt drop <name> [-f]    remove a worktree + its branch (must be merged; -f overrides)
#   wt log <name>          tail the most recent gate log for a feature
#   wt watch <name>        follow a running gate: 60s status ticks (log tail +
#                          host load) until a fresh RESULT lands, then print it —
#                          the poll loop AGENT.md mandates, so agents stop
#                          hand-rolling it
#
# Env overrides:
#   WTQ_TARGET   integration branch (default: develop)
#   WTQ_ROOT     where worktrees live (default: <repo-parent>/graphden-wt)
#   WTQ_NO_PUSH  =1 -> gate advances develop LOCALLY only, never pushes (push yourself)
#   WTQ_CI_SKIP  comma list of check names/groups force-skipped in the gate's
#                `bb ci` (passed through as `bb ci --skip`). Announced loudly in
#                the gate log — a GREEN with it set is a SCOPED result, use only
#                when you know why (e.g. a flaky third-party linter outage).
set -euo pipefail

# --- locate the repo / shared plumbing -------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF="$SCRIPT_DIR/$(basename "${BASH_SOURCE[0]}")"
cd "$SCRIPT_DIR"
COMMON_DIR="$(cd "$(git rev-parse --git-common-dir)" && pwd)"   # shared .git across all worktrees
WTQ_DIR="$COMMON_DIR/wtq"                                        # coordination lives here (untracked, shared)
LOCK="$WTQ_DIR/queue.lock"
HOLDER="$WTQ_DIR/holder"
LOG_DIR="$WTQ_DIR/logs"
TASKS_DIR="$WTQ_DIR/tasks"       # task specs — live under .git, never in the working tree
RESULT_DIR="$WTQ_DIR/results"    # machine-readable last gate outcome per feature
mkdir -p "$LOG_DIR" "$TASKS_DIR" "$RESULT_DIR"

TARGET="${WTQ_TARGET:-develop}"

# main worktree = wherever $TARGET is checked out (that is the branch we advance)
main_worktree() {
  git worktree list --porcelain | awk -v tgt="refs/heads/$TARGET" '
    /^worktree /  { wt=$2 }
    $0 == "branch " tgt { print wt; exit }'
}
MAIN_WT="$(main_worktree)"
REPO_PARENT="$(dirname "${MAIN_WT:-$(git rev-parse --show-toplevel)}")"
WTQ_ROOT="${WTQ_ROOT:-$REPO_PARENT/graphden-wt}"

# --- pretty ----------------------------------------------------------------
c()  { printf '\033[%sm' "$1"; }
GRN="$(c 32)"; RED="$(c 31)"; YLW="$(c 33)"; BLU="$(c 34)"; BLD="$(c 1)"; RST="$(c 0)"
say()  { printf '%s\n' "$*"; }
info() { printf '%s%s%s\n' "$BLU" "$*" "$RST"; }
ok()   { printf '%s%s%s\n' "$GRN" "$*" "$RST"; }
warn() { printf '%s%s%s\n' "$YLW" "$*" "$RST"; }
die()  { printf '%s%s%s\n' "$RED" "$*" "$RST" >&2; exit 1; }

branch_of() { git -C "$1" rev-parse --abbrev-ref HEAD; }

# Newest-first gate logs. `find -printf` rather than `ls -t` so a filename is
# never re-parsed by the shell: usage `newest_logs <n> [feature]`.
newest_logs() {
  local n="$1" name="${2:-}"
  find "$LOG_DIR" -maxdepth 1 -type f -name "${name:+$name-}*.log" -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn | head -"$n" | cut -d' ' -f2-
}

# node_modules/ is gitignored, so a fresh worktree gets every package.json but
# none of the installed deps. The damage is worse than a missing linter:
#   - stylelint cannot resolve stylelint-config-standard and fails outright;
#   - license-checker exits 0 on "No packages found", so the licence audit
#     silently passes while auditing nothing;
#   - the e2e suite has no playwright.
# So `bb ci` is red — or, worse, green and hollow — before the agent has
# written a line, while AGENT.md declares it the loop to iterate until green.
#
# Hardlink the main checkout's trees rather than symlinking them: the copy must
# be a real directory, because license-checker refuses to walk a symlinked
# node_modules (the very silent-pass this guards against). Hardlinks make that
# nearly free — the files share inodes, so a 200 MB tree costs ~0 extra disk
# and ~0.1 s, and the linters only ever read it.
bootstrap_node_modules() {
  local path="$1" dir src dst
  while IFS= read -r dir; do
    src="$MAIN_WT/$dir/node_modules"
    dst="$path/$dir/node_modules"
    if [ ! -d "$src" ]; then
      warn "no node_modules in $MAIN_WT/$dir — run 'npm ci' there, or bb ci cannot pass in a worktree"
      continue
    fi
    # A SYMLINK here is actively harmful, not merely different: git records a
    # symlink as a file, so the `node_modules/` ignore rule (trailing slash =
    # directories only) does not match it. It shows up as untracked, and the
    # gate's first act is to refuse a worktree that `git status` calls dirty —
    # so a symlinked tree cannot land at all. Replace it with the real thing.
    if [ -L "$dst" ]; then
      warn "$dir/node_modules is a symlink — git leaves it untracked, which blocks the gate. Replacing with a hardlink copy."
      rm -f "$dst"
    fi
    [ -e "$dst" ] && continue
    cp -al "$src" "$dst" 2>/dev/null || cp -a "$src" "$dst"
  done < <(git -C "$MAIN_WT" ls-files '*package.json' | xargs -r -n1 dirname | sort -u)
}

# --- governance drift -------------------------------------------------------
# The rules an agent works under reach it ONCE: CLAUDE.md at session start,
# AGENT.md in its first minutes. Nothing re-reads them. An agent that has been
# working for hours may therefore be operating under rules develop has since
# replaced — and it would land that work without ever noticing.
#
# So: record the target SHA whose governance the agent has seen, and refuse to
# land while develop has moved any governed path past it.
ACK_DIR="$WTQ_DIR/ack"
mkdir -p "$ACK_DIR"

# The governed paths, from the explicit list. A heuristic over the diff would
# have to guess "rule, or just a doc?" — which is how a rule change slips past.
# Fills the GOV_PATHS array. An array, not a bare $(...) splat: pathspecs go
# straight to git without the shell re-splitting them on whitespace.
GOV_PATHS=()
governance_paths() {
  [ "${#GOV_PATHS[@]}" -gt 0 ] && return 0
  mapfile -t GOV_PATHS < <(grep -vE '^[[:space:]]*(#|$)' "$SCRIPT_DIR/GOVERNANCE")
}

ack_file() { printf '%s/%s' "$ACK_DIR" "$1"; }

# The SHA whose governance this agent has seen. A worktree with no record — one
# created before this existed — is credited with its fork point: that IS the
# state of the rules when it read them.
acked_sha() {
  local name="$1" branch="$2"
  local f; f="$(ack_file "$name")"
  if [ ! -s "$f" ]; then
    git -C "$MAIN_WT" merge-base "$branch" "$TARGET" > "$f" 2>/dev/null || true
  fi
  cat "$f" 2>/dev/null
}

# Governed paths that $TARGET moved since the agent last acknowledged them.
governance_drift() {
  local name="$1" branch="$2" acked
  acked="$(acked_sha "$name" "$branch")"
  [ -n "$acked" ] || return 0
  governance_paths
  git -C "$MAIN_WT" diff --name-only "$acked..$TARGET" -- "${GOV_PATHS[@]}" 2>/dev/null
}

# --- what a change actually needs -------------------------------------------
# The queue is serialized, so a minute spent in the gate is a minute charged to
# every branch waiting behind it. A docs-only branch should not pay 25 minutes
# of browser tests.
#
# But a WRONG skip costs far more than a slow gate: it lands untested code under
# a green tick, and green-but-hollow is the failure mode this whole tool has
# been fighting. So:
#
#   - the table is FAIL-SAFE: anything it does not recognise runs EVERYTHING;
#   - whatever is skipped is PRINTED, because a silent skip reads as "checked";
#   - `bb ci` always runs, but DIFF-SCOPED (`--since`): each check declares its
#     relevant paths in scripts/checks.edn; a check whose paths saw no change is
#     skipped VISIBLY in the report (docs-only -> no unit suite, no clj/js
#     linters). No `:relevant` key on a check = it always runs, and an
#     unrecognised ref widens to everything — same fail-safe stance.
#
#   *.md, docs/**                    no runtime surface     -> nothing heavy
#   dev/**                           this queue's own tooling; not on any
#                                    classpath, not bundled -> nothing heavy
#   tools/browser-test/**            the e2e suite itself   -> e2e
#   packages' .js/.css/.html/.svg    browser-only surface   -> e2e
#   everything else                  src, .clj/.edn, deps.edn, bb.edn, scripts/,
#                                    Dockerfile*, compose,  -> integration + e2e
#                                    CI config, unknown
#
# On dev/**: it holds only `wt` and its docs. `bb ci` shellchecks the script,
# and the gate is itself the script executing — that IS its test. Putting app
# code there would mean adding it to a classpath, i.e. touching deps.edn or
# build.clj, which lands in "everything else" and runs the lot.
classify_changes() {   # <worktree> -> sets NEED_INTEGRATION / NEED_E2E / CHANGED_N
  local wt="$1" f
  NEED_INTEGRATION=0; NEED_E2E=0; CHANGED_N=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    CHANGED_N=$((CHANGED_N + 1))
    case "$f" in
      *.md|docs/*|dev/*)              : ;;
      tools/browser-test/*)           NEED_E2E=1 ;;
      resources/packages/*.js|resources/packages/*.css|\
      resources/packages/*.html|resources/packages/*.svg)
                                      NEED_E2E=1 ;;
      *)                              NEED_INTEGRATION=1; NEED_E2E=1 ;;
    esac
  done < <(git -C "$wt" diff --name-only "$TARGET..HEAD")
}

# --- per-worktree docker instance -------------------------------------------
# docker-compose.yml is parameterised by GD_*; with none set it raises the
# CANONICAL stack (graphden-executor on :9002, image graphden-executor:latest).
# That stack belongs to develop and to the gate. An agent that wants to click
# through its own changes gets a private one instead: own containers, own
# volumes, own image tag, own ports.
PORTS_DIR="$WTQ_DIR/ports"
PORT_BASE=9100     # canonical stack owns 9002/9081/9099/5435/5436/8200
PORT_STRIDE=6      # HTTP, HISTORY, NREPL, PG, USERPG, BAO
mkdir -p "$PORTS_DIR"

# Hand each instance a contiguous block of host ports, recorded under the shared
# .git so it survives across sessions and is visible to every worktree. Taken
# under a lock: two agents claiming at the same moment must not get the same
# block. Freed by `wt drop`.
alloc_port_base() {
  local name="$1" slot=0 base
  local f="$PORTS_DIR/$name"
  exec 8>"$PORTS_DIR/.lock"
  flock -x 8
  if [ ! -f "$f" ]; then
    while :; do
      base=$((PORT_BASE + slot * PORT_STRIDE))
      grep -qxF "$base" "$PORTS_DIR"/* 2>/dev/null || break
      slot=$((slot + 1))
      [ "$slot" -lt 100 ] || die "no free port block below $((PORT_BASE + 100 * PORT_STRIDE))"
    done
    printf '%s\n' "$base" > "$f"
  fi
  flock -u 8
  cat "$f"
}

# Export the GD_* the compose file reads. Sourced by every instance command so
# they all address the SAME stack for a given worktree.
instance_env() {
  local name="$1" base; base="$(alloc_port_base "$name")"
  export GD_INSTANCE="gdwt-$name"
  export GD_IMAGE="graphden-wt-$name-executor:latest"
  export COMPOSE_PROJECT_NAME="gdwt-$name"
  export GD_PORT_HTTP=$base
  export GD_PORT_HISTORY=$((base + 1))
  export GD_PORT_NREPL=$((base + 2))
  export GD_PORT_PG=$((base + 3))
  export GD_PORT_USERPG=$((base + 4))
  export GD_PORT_BAO=$((base + 5))
  # Bound the throwaway instance. Without a container limit the JVM's
  # MaxRAMPercentage=75 measures against the HOST, so every agent instance
  # would size its heap for 75% of the whole box and they would fight. The
  # executor boots and serves in well under 1 GB.
  export GD_MEM_LIMIT="${GD_MEM_LIMIT:-2g}"
}

# Name of the worktree we are standing in — every instance command is scoped to
# it, so an agent can never address another agent's stack.
this_worktree() {
  local wt; wt="$(git rev-parse --show-toplevel)"
  [ "$wt" != "$MAIN_WT" ] || die "this command is for a feature worktree; the main checkout drives the canonical instance with 'bb rebuild'."
  basename "$wt"
}

# Tear an instance down completely: containers, volumes, image, port block.
teardown_instance() {
  local name="$1"
  local path="$WTQ_ROOT/$name"
  ( instance_env "$name"
    if [ -d "$path" ]; then
      ( cd "$path" && docker-compose down -v --remove-orphans ) >/dev/null 2>&1 || true
    fi
    docker image rm -f "$GD_IMAGE" >/dev/null 2>&1 || true )
  rm -f "$PORTS_DIR/$name"
}

# bootstrap prompt for a NAMELESS agent (discussion phase, before it self-claims)
bootstrap_kickoff() {
  cat <<'EOF'
You are an autonomous feature agent for the graphden repo, launched into a
DISCUSSION phase in the main checkout (on develop). You may READ anything, but
you MUST NOT create, edit, or delete any file until you have claimed your own
isolated workspace.

1. Discuss the task with me until the goal is clear — ask questions, propose an
   approach. Do NOT write code yet.
2. When we agree, CLAIM a workspace: pick a short kebab-case branch name and run
       bb wt claim <name> "<one-line task summary>"
   This creates feature/<name> + an isolated worktree and registers you in the
   pool. cd into the printed WORKTREE path and do ALL work there.
3. Implement, keeping `bb ci` green.
4. When the code is ready and `bb ci` is green, LAND IT YOURSELF — run the gate
   (`bb wt merge` in the BACKGROUND). Don't ask permission to finish: the gate
   cannot advance develop on a red result. Handle any conflict or failure it
   reports, and iterate until it is green.
5. Once landed, clean up yourself: cd back to the main checkout and run
   `bb wt drop <name>`. Then report what happened.

Read dev/wtq/AGENT.md now for the full contract, then ask me what to build.
EOF
}

# kickoff prompt handed to an autonomous agent session for <name>
kickoff_text() {
  local name="$1"
  local path="$WTQ_ROOT/$name" branch="feature/$name"

  cat <<EOF
You are an autonomous feature agent for '$name', working in an ISOLATED git
worktree on branch $branch. Other agents may be working in parallel
worktrees — never assume repo-global state, and never touch develop or other
worktrees directly.

First read your operating contract at dev/wtq/AGENT.md, then your task spec at
$TASKS_DIR/$name.md.
EOF

  # A session can die — killed, crashed, /clear'd — and the agent that replaces
  # it is handed this same prompt. Told only "execute the task", it starts over
  # and redoes work that is already committed. The work survives on disk; only
  # the agent's memory of it does not. So when the branch already carries
  # commits, hand the replacement its bearings instead of a blank slate.
  local commits; commits="$(git -C "$path" rev-list --count "$TARGET..$branch" 2>/dev/null || echo 0)"
  if [ "${commits:-0}" -eq 0 ]; then
    cat <<EOF
Execute the task end to end: implement in small commits, keep 'bb ci' green as
your fast loop, and when the feature is complete LAND IT YOURSELF — run the gate
with 'bb wt merge' (in the BACKGROUND — it takes ~40 min), handling any conflict
or failure it reports, then clean up with 'bb wt drop'. Do not ask permission to
finish. Report what happened, and ask only if you hit a real decision you can't
make.
EOF
    return 0
  fi

  local dirty=""; [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ] && dirty=" (working tree DIRTY — uncommitted changes)"
  local result="—"
  [ -f "$RESULT_DIR/$name" ] && result="$(cut -f1 "$RESULT_DIR/$name")"
  local drift; drift="$(governance_drift "$name" "$branch")"

  cat <<EOF

You are RESUMING work already in progress — a previous session ended without
finishing. Nothing is lost: the branch, the worktree and the task spec are on
disk. Do NOT start over. Get your bearings first:

  $commits commit(s) on $branch beyond $TARGET$dirty
  last landing-gate result: $result

  git log --oneline $TARGET..HEAD     # what you already did
  git status                          # anything left uncommitted
  bb wt log $name                     # your last gate run, if any
EOF

  if [ -n "$drift" ]; then
    cat <<EOF

  WARNING — $TARGET has changed the rules you work under since you started:
$(printf '%s\n' "$drift" | sed 's/^/      /')
  Run 'bb wt ack' to see the diff. The gate will refuse to land until you have.
EOF
  fi

  cat <<EOF

Then finish the job: keep 'bb ci' green, and when the feature is complete land it
yourself — 'bb wt merge' (in the BACKGROUND — it takes ~40 min), handling any
conflict or failure it reports, then 'bb wt drop'. Do not ask permission to
finish. Ask only if you hit a real decision you can't make.
EOF
}

# =====================================================================
# up / down / gc — the agent's own instance
# =====================================================================
cmd_up() {
  local name; name="$(this_worktree)"
  local path="$WTQ_ROOT/$name"
  instance_env "$name"

  info "Instance $GD_INSTANCE  ->  http://localhost:$GD_PORT_HTTP   (image $GD_IMAGE)"
  say  "  postgres :$GD_PORT_PG · user-postgres :$GD_PORT_USERPG · openbao :$GD_PORT_BAO · nrepl :$GD_PORT_NREPL"
  echo
  # bb rebuild = uberjar + image + up + health + `bb verify` + `bb smoke`. With
  # GD_* exported it targets THIS worktree's stack, so `bb verify` compares the
  # running build against THIS branch's tree — the agent sees its own code.
  ( cd "$path" && bb rebuild ) || die "instance build failed — see the output above"

  echo
  ok "✓ '$name' is live at http://localhost:$GD_PORT_HTTP"
  say "  stop it:   ${BLD}bb wt down${RST}      (keeps the DB volume)"
  say "  remove it: ${BLD}bb wt drop $name${RST}  (containers + volumes + image + ports)"
}

cmd_down() {
  local name; name="$(this_worktree)"
  local path="$WTQ_ROOT/$name"
  instance_env "$name"
  info "Stopping $GD_INSTANCE ..."
  ( cd "$path" && docker-compose down --remove-orphans ) || die "docker-compose down failed"
  ok "✓ stopped (DB volume kept — 'bb wt drop $name' removes it)"
}

cmd_ack() {
  local name; name="$(this_worktree)"
  local branch="feature/$name"
  local drift; drift="$(governance_drift "$name" "$branch")"
  local tip; tip="$(git -C "$MAIN_WT" rev-parse "$TARGET")"

  if [ -z "$drift" ]; then
    ok "✓ already current — $TARGET has not moved any governed path since you last looked."
    printf '%s\n' "$tip" > "$(ack_file "$name")"
    return 0
  fi

  # Print the diff, not a summary. The point is not to tick a box: it is that
  # the new rules pass through the agent's context on their way to being
  # acknowledged. A one-line "3 files changed" would defeat that entirely.
  info "== $TARGET changed the rules you work under. Read this. =="
  echo
  governance_paths
  git -C "$MAIN_WT" diff "$(acked_sha "$name" "$branch")..$TARGET" -- "${GOV_PATHS[@]}"
  echo
  printf '%s\n' "$tip" > "$(ack_file "$name")"
  ok "✓ acknowledged $TARGET@${tip:0:8}"
  say "  Re-read anything above that changes what you are doing, then: ${BLD}bb wt merge${RST}"
}

# What is on this machine that should not be? A killed test run leaves its JVM
# alive — Ctrl-C, a tool timeout, an OOM-killed parent — and that JVM keeps its
# heap (2.5 GB, measured) and its testcontainers. The next run then starts on a
# machine that is already half-consumed, flakes, and by the time anyone looks the
# orphan has finally exited and the host reads as healthy. That is how an
# environment problem gets mistaken for a code problem, repeatedly.
#
# REPORTS, never kills: other agents run their own suites on this host, and a
# pattern-match kill cannot tell their live work from my dead work.
cmd_doctor() {
  info "Stray test JVMs (a killed run leaves these behind) ..."
  local found=0 pid rss age
  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    found=1
    rss="$(awk '/^VmRSS:/{printf "%d", $2/1024}' "/proc/$pid/status" 2>/dev/null)"
    age="$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')"
    printf '  pid=%-8s up=%-10s rss=%sMB\n' "$pid" "${age:-?}" "${rss:-?}"
  done < <(pgrep -f 'kaocha|cloverage' 2>/dev/null || true)
  [ "$found" = 0 ] && ok "  none"

  echo
  info "Testcontainers still up (Ryuk reaps these when the JVM exits cleanly) ..."
  found=0
  while IFS= read -r line; do found=1; say "  $line"; done < <(
    docker ps --filter "label=org.testcontainers=true" \
              --format '{{.Names}}  {{.Image}}  up {{.RunningFor}}' 2>/dev/null)
  [ "$found" = 0 ] && ok "  none"

  echo
  info "Host ..."
  free -m | awk '/^Mem:/{printf "  memory: %s MB used, %s MB available\n",$3,$7}
                 /^Swap:/{printf "  swap:   %s MB used of %s MB\n",$3,$2}'
  awk '{printf "  load:   %s (%s cores)\n", $1, ENVIRON["NPROC"]}' /proc/loadavg
  echo
  say "  Nothing above is killed for you: another agent's suite looks identical"
  say "  to your leftovers. Check the pid, then kill it yourself."
}

cmd_gc() {
  info "Reclaiming superseded executor layers (label graphden.image=executor) ..."
  docker image prune -f --filter label=graphden.image=executor || true

  info "Removing agent images whose worktree is gone ..."
  local img name
  while IFS= read -r img; do
    name="${img#graphden-wt-}"; name="${name%-executor:latest}"
    if [ ! -d "$WTQ_ROOT/$name" ]; then
      docker image rm "$img" >/dev/null 2>&1 && ok "  removed $img (no worktree '$name')"
    fi
  done < <(docker images --format '{{.Repository}}:{{.Tag}}' | grep -E '^graphden-wt-.+-executor:latest$' || true)

  # Tags from the OLD directory-derived naming (`<worktree>-executor:latest`),
  # left behind by worktrees that predate the explicit GD_IMAGE tag. Never -f:
  # docker refuses to drop an image a container still uses, which is exactly the
  # protection we want against a false positive on someone else's image.
  info "Removing legacy directory-derived executor images ..."
  while IFS= read -r img; do
    name="${img%-executor:latest}"
    case "$name" in
      graphden)     continue ;;   # the canonical image — keep
      graphden-wt-*) continue ;;  # ours, and ALREADY handled by the sweep above,
                                  # which strips the prefix before checking the
                                  # worktree. Falling through to here would test
                                  # $WTQ_ROOT/graphden-wt-<name> — a path that
                                  # never exists — so the "is it still live?"
                                  # guard silently passes and a working agent's
                                  # image is deleted out from under it. That is
                                  # exactly what happened to sidebar-filters.
    esac
    [ -d "$WTQ_ROOT/$name" ] && continue         # a live worktree's own build
    docker image rm "$img" >/dev/null 2>&1 && ok "  removed legacy $img"
  done < <(docker images --format '{{.Repository}}:{{.Tag}}' | grep -E '^[a-z0-9._-]+-executor:latest$' || true)

  echo
  docker system df | head -5
}

