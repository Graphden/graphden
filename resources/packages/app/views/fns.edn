  {:name :api-views
   :description "GET /api/views — the views saved in the graph. Auth-required (projects tenant-private structure, like `/api/graph/entities`)."
   :parent :get-auth-required
   :args {:path "/views" :handler :api-views-handler}}

  {:name :api-view-members
   :description "POST /api/views/members — evaluate an ad-hoc Explorer filter set; body `{name uses effects kinds namespaces exclude unused views}`. Auth-required."
   :parent :post
   :args {:path "/views/members" :handler :api-view-members-handler}}

  {:name :api-view-save
   :description "POST /api/views/save — atomic Save of {id?, name, namespace-id?, filters}. Authorization comes from the request storage and current branch."
