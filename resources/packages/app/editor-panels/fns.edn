{:namespace "app.editor"
 :description "Sidebar panel partials — error-log (recent failed executions), type-errors (current branch's recorded type diagnostics) and stats (org usage rollups)."
 :fns
 [;; ---------------------------------------------------------------------
  ;; ERROR LOG partial — GET /partials/error-log. The current branch
  ;; view's UNRESOLVED failures (see :recent-failures for the four-part
  ;; predicate: branch-chain scope, still-current version, no later
  ;; success of the same version, not dismissed). Fn names link via the
  ;; editor's native #hash navigation. Each row carries a ✕ dismiss
  ;; button (POST /partials/error-log/ack); the list header carries
  ;; «Dismiss all» — both swap the refreshed body back in place, so the
  ;; tab badge recount (htmx:afterSettle) follows automatically.
  ;; ---------------------------------------------------------------------
  {:name :_perr-rows
   :parent :recent-failures
   :args {:days 7 :limit 50}}

  ;; Rows that name a fn (`:fn-name`) and link to it — the Errors,
  ;; Type errors, Stats and Tests panels all render the same cell, so
  ;; the accessor + `#hash` href are public app.editor vocabulary.
  {:name :item-fn-name
   :description "`:fn-name` of the row in hand (`:item`), `\"?\"` when absent."
   :parent :get
   :args {:coll {:as :item} :key {:value :fn-name} :default {:value "?"}}}

  {:name :item-fn-href
   :description "`#<fn-name>` — the editor's native hash navigation to the row's fn."
   :parent :str
   :args {:parts [{:value "#"} :item-fn-name]}}

  {:name :_perr-item-link-attrs
   :parent :assoc
   :args {:map {:value {:class "error-log-fn"}}
          :key {:value :href}
          :value :item-fn-href}}

  {:name :_perr-item-link
   :parent :hiccup
   :args {:tag {:value "a"}
          :attrs :_perr-item-link-attrs
          :children [:item-fn-name]}}

  {:name :_perr-item-time
   :parent :get
   :args {:coll {:as :item} :key {:value :finished-at} :default {:value ""}}}

  {:name :_perr-item-error
   :parent :get
   :args {:coll {:as :item} :key {:value :error} :default {:value ""}}}

  {:name :_perr-item-time-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "error-log-time"}}
          :children [:_perr-item-time]}}

  {:name :_perr-item-error-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "error-log-msg"}}
          :children [:_perr-item-error]}}

  {:name :_perr-item-data
   :parent :get
   :args {:coll {:as :item} :key {:value :error-data} :default {:value nil}}}

  {:name :_perr-item-data-pre
   :parent :hiccup
   :args {:tag {:value "pre"}
          :attrs {:value {:class "error-log-data"}}
          :children [:_perr-item-data]}}

  {:name :_perr-item-details
   :description "Collapsible ex-data (trace context) — rendered only when the row HAS error-data."
   :parent :hiccup
   :args {:tag {:value "details"}
          :attrs {:value {:class "error-log-details"}}
          :children [{:value [:summary "details"]} :_perr-item-data-pre]}}

  {:name :_perr-item-data?
   :parent :some?
   :args {:value :_perr-item-data}}

  {:name :_perr-item-details-opt
   :parent :if
   :args {:test :_perr-item-data?
          :then :_perr-item-details
          :else :hidden-span}}

  {:name :_perr-item-exec-id
   :parent :get
   :args {:coll {:as :item} :key {:value :execution-id} :default {:value ""}}}

  {:name :_perr-item-ack-url
   :parent :str
   :args {:parts [{:value "/partials/error-log/ack?id="} :_perr-item-exec-id]}}

  {:name :_perr-item-ack-btn
   :description "Per-row ✕ dismiss — POSTs the row's execution-id to the ack route and swaps the refreshed list body back in."
   :parent :hx-button
   :args {:label {:value "✕"}
          :url :_perr-item-ack-url
          :target {:value "closest .error-log-body"}
          :swap {:value "outerHTML"}
          :extras {:value {:class "error-log-ack"
                           :title "Dismiss this failure"
                           :aria-label "Dismiss this failure"}}}}

  {:name :_perr-row
   :description "One failure row — fn link (native #hash navigation), ✕ dismiss button, finish time, scrubbed error text, optional ex-data details."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "error-log-row"}}
          :children [:_perr-item-ack-btn :_perr-item-link :_perr-item-time-div
                     :_perr-item-error-div :_perr-item-details-opt]}}

  {:name :_perr-rendered-rows
   :parent :map
   :args {:func :_perr-row :coll :_perr-rows}}

  {:name :_perr-empty?
   :parent :empty?
   :args {:coll :_perr-rows}}

  {:name :_perr-empty-msg
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "error-log-empty"}}
          :children ["No unresolved failures in the last 7 days."]}}

  {:name :_perr-ack-all-btn
   :description "«Dismiss all» — acks every failure the current branch view lists and swaps the (now empty) body back in."
   :parent :hx-button
   :args {:label {:value "Dismiss all"}
          :url {:value "/partials/error-log/ack-all"}
          :target {:value "closest .error-log-body"}
          :swap {:value "outerHTML"}
          :extras {:value {:class "error-log-ack-all"}}}}

  {:name :_perr-toolbar
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "error-log-toolbar"}}
          :children [:_perr-ack-all-btn]}}

  {:name :_perr-list
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "error-log-list"}}
          :children [:_perr-toolbar :_perr-rendered-rows]}}

  {:name :_perr-body
   :parent :if
   :args {:test :_perr-empty?
          :then :_perr-empty-msg
          :else :_perr-list}}

  ;; Stable swap anchor: GET and both ack POSTs all return THIS div, so
  ;; the buttons' `hx-target \"closest .error-log-body\"` + outerHTML
  ;; swap replaces the whole body atomically.
  {:name :_perr-wrap
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "error-log-body"}}
          :children [:_perr-body]}}

  {:name :_perr-html
   :parent :render-hiccup
   :args {:hiccup :_perr-wrap}}

  {:name :_partial-error-log-handler
   :lambda-params []
   :description "Ring handler for GET /partials/error-log — the current branch view's unresolved failures as text/html. Auth-required (route side)."
   :parent :html-ok-response
   :args {:body :_perr-html}}

  ;; --- dismiss (ack) routes — POST, auth-required (route side). Each
  ;; applies the ack THEN renders the refreshed body (`:do` forces the
  ;; steps left-to-right), so the swapped-in fragment already reflects
  ;; the dismissal. ---

  {:name :_perr-ack-id
   :parent :query-param
   :args {:param-name {:value "id"}}}

  {:name :_perr-ack-applied
   :parent :failure-ack
   :args {:execution-id :_perr-ack-id}}

  {:name :_perr-ack-then-html
   :parent :do
   :args {:steps [:_perr-ack-applied :_perr-html]}}

  {:name :_partial-error-ack-handler
   :lambda-params [:request]
   :description "Ring handler for POST /partials/error-log/ack?id=X — dismiss one failure row, respond with the refreshed error-log body."
   :parent :html-ok-response
   :args {:body :_perr-ack-then-html}}

  {:name :_perr-ack-all-applied
   :parent :failure-ack-all
   :args {:days 7}}

  {:name :_perr-ack-all-then-html
   :parent :do
   :args {:steps [:_perr-ack-all-applied :_perr-html]}}

  {:name :_partial-error-ack-all-handler
   :lambda-params []
   :description "Ring handler for POST /partials/error-log/ack-all — dismiss every failure the current branch view lists, respond with the refreshed (empty) body."
   :parent :html-ok-response
   :args {:body :_perr-ack-all-then-html}}

  ;; ---------------------------------------------------------------------
  ;; TYPE ERRORS partial (error-tolerance Phase 3) — GET /partials/
  ;; type-errors. The CURRENT branch's recorded type diagnostics (the
  ;; per-branch in-memory store every post-write check keeps fresh),
  ;; one row per diagnostic: fn name (native #hash link), arg, short
  ;; message. Mirrors the error-log family above.
  ;; ---------------------------------------------------------------------
  {:name :branch-diagnostics-flat
   :description "The CURRENT branch's recorded type diagnostics joined with fn names, one entry per diagnostic — `[{:fn-id :fn-name :diag} …]` (`:fn-name` nil for anonymous fns). Reads the in-memory per-branch diagnostics store (`graphden.types.diagnostics/branch-errors`, branch = the request's versioned storage, nil = default), joins fn names in one batched org-scoped read, and DROPS foreign-org fn-ids (the security boundary — stays impl-side). Empty when the branch has no recorded diagnostics."
   :args {}
   :return-type [:list :keyword-map]
   :effects #{:db}}

  ;; --- display reshape (formerly inside the impl): per-diagnostic row
  ;;     build + arg coalescing + uuid-name fallback + sort. ---

  {:name :_tdl-flat
   :parent :branch-diagnostics-flat}

  ;; row-build callback (per flat entry)
  {:name :_tdl-e-fn-id
   :parent :get
   :args {:coll {:as :item} :key {:value :fn-id} :default {:value ""}}}
  {:name :_tdl-e-name-raw
   :parent :get
   :args {:coll {:as :item} :key {:value :fn-name} :default nil}}
  ;; an anonymous own fn rows up UUID-labelled — the fallback is for
  ;; its nil :fn-name, not for missing rows (those were dropped).
  {:name :_tdl-e-name
   :parent :coalesce
   :args {:value :_tdl-e-name-raw :default {:ref :_tdl-e-fn-id :type :text}}}
  {:name :_tdl-e-diag
   :parent :get
   :args {:coll {:as :item} :key {:value :diag} :default {:value {}}}}
  ;; `:arg-name` when the checker stamped one; a ref-mismatch
  ;; diagnostic carries the bound fn under `:binding` instead.
  {:name :_tdl-arg-name-raw
   :parent :get
   :args {:coll :_tdl-e-diag :key {:value :arg-name} :default nil}}
  {:name :_tdl-arg-from-name
   :parent :name
   :args {:value :_tdl-arg-name-raw}}
  {:name :_tdl-binding-raw
   :parent :get
   :args {:coll :_tdl-e-diag :key {:value :binding} :default nil}}
  {:name :_tdl-binding-kw?
   :parent :is-a?
   :args {:type {:value :keyword} :value :_tdl-binding-raw}}
  {:name :_tdl-binding-name
   :parent :name
   :args {:value :_tdl-binding-raw}}
  {:name :_tdl-arg-from-binding
   :parent :if
   :args {:test :_tdl-binding-kw?
          :then :_tdl-binding-name
          :else {:value nil}}}
  {:name :_tdl-arg-fallback
   :parent :coalesce
   :args {:value :_tdl-arg-from-binding :default {:value ""}}}
  {:name :_tdl-arg
   :parent :coalesce
   :args {:value :_tdl-arg-from-name :default :_tdl-arg-fallback}}
  {:name :_tdl-message-raw
   :parent :get
   :args {:coll :_tdl-e-diag :key {:value :message} :default {:value ""}}}
  {:name :_tdl-message
   :parent :to-str
   :args {:value :_tdl-message-raw}}
  {:name :_tdl-row
   :parent :zipmap
   :args {:keys [{:value :fn-id} {:value :fn-name} {:value :arg} {:value :message}]
          :vals [:_tdl-e-fn-id :_tdl-e-name :_tdl-arg :_tdl-message]}}

  {:name :_tdl-rows
   :parent :map
   :args {:func :_tdl-row
          :coll {:ref :_tdl-flat :type [:list :keyword-map]}}}

  ;; sort-key callback
  {:name :_tdl-sort-key
   :parent :get
   :args {:coll {:as :item} :key {:value :fn-name} :default {:value ""}}}
  {:name :_tdl-sorted
   :parent :sort-by
   :args {:key-fn :_tdl-sort-key
          :coll :_tdl-rows}}

  {:name :type-diagnostics-list
   :description "The CURRENT branch's recorded type diagnostics as flat display rows — `[{:fn-id :fn-name :arg :message} …]`, sorted by fn name. Pure graph reshape over `:branch-diagnostics-flat` (the org-scoped join); the arg coalescing (`:arg-name`, else a keyword `:binding`, else empty) and the uuid label for anonymous fns are graph-visible. Empty when the branch has no recorded diagnostics."
   :parent :vec
   :args {:coll :_tdl-sorted}
   :return-type [:list :keyword-map]}

  {:name :_pterr-rows
   :parent :type-diagnostics-list}

  {:name :_pterr-item-link-attrs
   :parent :assoc
   :args {:map {:value {:class "type-errors-fn"}}
          :key {:value :href}
          :value :item-fn-href}}

  {:name :_pterr-item-link
   :parent :hiccup
   :args {:tag {:value "a"}
          :attrs :_pterr-item-link-attrs
          :children [:item-fn-name]}}

  {:name :_pterr-item-arg
   :parent :get
   :args {:coll {:as :item} :key {:value :arg} :default {:value ""}}}

  {:name :_pterr-item-arg-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "type-errors-arg"}}
          :children [:_pterr-item-arg]}}

  {:name :_pterr-item-msg
   :parent :get
   :args {:coll {:as :item} :key {:value :message} :default {:value ""}}}

  {:name :_pterr-item-msg-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "type-errors-msg"}}
          :children [:_pterr-item-msg]}}

  {:name :_pterr-row
   :description "One diagnostic row — fn link (native #hash navigation), arg name, short message."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "type-errors-row"}}
          :children [:_pterr-item-link :_pterr-item-arg-div :_pterr-item-msg-div]}}

  {:name :_pterr-rendered-rows
   :parent :map
   :args {:func :_pterr-row :coll :_pterr-rows}}

  {:name :_pterr-empty?
   :parent :empty?
   :args {:coll :_pterr-rows}}

  {:name :_pterr-empty-msg
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "type-errors-empty"}}
          :children ["No type errors on this branch."]}}

  {:name :_pterr-list
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "type-errors-list"}}
          :children [:_pterr-rendered-rows]}}

  {:name :_pterr-body
   :parent :if
   :args {:test :_pterr-empty?
          :then :_pterr-empty-msg
          :else :_pterr-list}}

  {:name :_pterr-html
   :parent :render-hiccup
   :args {:hiccup :_pterr-body}}

  {:name :_partial-type-errors-handler
   :lambda-params []
   :description "Ring handler for GET /partials/type-errors — the current branch's recorded type diagnostics as text/html. Auth-required (route side)."
   :parent :html-ok-response
   :args {:body :_pterr-html}}

  ;; ---------------------------------------------------------------------
  ;; LINT partial — GET /partials/lint. The graph lint (docs/GRAPH_LINT.md)
  ;; over the CURRENT branch: definitions that already exist elsewhere
  ;; (exactly, or once private helpers are inlined) and private fn-defs
  ;; nothing references. Warnings only. Every row carries a
  ;; "Not an issue" button; the suppression it records lives IN THE GRAPH
  ;; — the root fn `lint-suppressions` (a `:const` whose value is the
  ;; list of `{:rule :fn-ids}` entries), created on first use, versioned
  ;; per branch like any fn, visible and editable on the canvas. A
  ;; finding is keyed by its member ids, so a group that later gains a
  ;; member comes back on its own.
  ;; ---------------------------------------------------------------------
  {:name :branch-lint-warnings
   :description "The graph lint's WARNINGS over the current branch (docs/GRAPH_LINT.md) as display rows — `[{:rule :message :weight :fn-ids :fn-ids-csv :fns [{:id :name :ns} …]} …]`, minus the findings listed in `:suppressed`. One `lint.graph/lint-branch` call over the request's graph snapshot; recomputed only when the snapshot or the suppression set changed."
   :args {:suppressed {:type [:list :jsonb]
                       :description "Findings marked as not-an-issue — the `lint-suppressions` const's value, `[{:rule <text> :fn-ids [<uuid-text> …]} …]`."}}
   :return-type [:list :keyword-map]
   :effects #{:db}}

  ;; --- the suppression store: root fn `lint-suppressions` (:const) ------
  {:name :_plint-supp-fn-id
   :description "Id of the root `lint-suppressions` const; nil until the first \"Not an issue\" creates it."
   :parent :fn-id-by-name
   :args {:fn-name {:value "lint-suppressions"}}}

  {:name :_plint-supp-fn-nil?
   :parent :nil? :args {:value :_plint-supp-fn-id}}

  {:name :_plint-supp-where
   :parent :assoc
   :args {:map {:value {}} :key {:value :fn-id} :value :_plint-supp-fn-id}}

  {:name :_plint-supp-binding
   :description "The const's `:value` binding row on this branch — the whole suppression list lives in its `:value`."
   :parent :first
   :args {:coll {:parent :query-entities
                 :args {:entity-type {:value "binding"} :where :_plint-supp-where}}}}

  {:name :_plint-supp-binding-id
   :parent :get :args {:coll :_plint-supp-binding :key {:value :id} :default nil}}

  {:name :_plint-supp-value
   :parent :get :args {:coll :_plint-supp-binding :key {:value :value} :default {:value []}}}

  {:name :_plint-suppressed
   :description "The entries marked not-an-issue — `[]` while no `lint-suppressions` fn exists."
   :parent :if
   :args {:test :_plint-supp-fn-nil?
          :then {:value []}
          :else :_plint-supp-value}}

  ;; --- rendering — parametrised by `:warnings` so the GET and the two
  ;;     POSTs (which must render AFTER their write, from the list they
  ;;     just wrote) share one chain without re-reading a thunk-once store.
  {:name :_plint-f-rule
   :parent :get :args {:coll {:as :item} :key {:value :rule} :default {:value ""}}}
  {:name :_plint-f-msg
   :parent :get :args {:coll {:as :item} :key {:value :message} :default {:value ""}}}
  {:name :_plint-f-fns
   :parent :get :args {:coll {:as :item} :key {:value :fns} :default {:value []}}}
  {:name :_plint-f-csv
   :parent :get :args {:coll {:as :item} :key {:value :fn-ids-csv} :default {:value ""}}}

  {:name :_plint-fn-name
   :parent :get :args {:coll {:as :item} :key {:value :name} :default {:value "?"}}}
  {:name :_plint-fn-ns
   :parent :get :args {:coll {:as :item} :key {:value :ns} :default {:value ""}}}
  {:name :_plint-fn-link-attrs
   :parent :assoc
   :args {:map {:value {:class "lint-fn"}}
          :key {:value :href}
          :value {:parent :str :args {:parts [{:value "#"} :_plint-fn-name]}}}}
  {:name :_plint-fn-link
   :description "One member fn as a native #hash link, its namespace dimmed after it."
   :parent :hiccup
   :args {:tag {:value "a"}
          :attrs :_plint-fn-link-attrs
          :children [:_plint-fn-name
                     {:parent :hiccup
                      :args {:tag {:value "span"}
                             :attrs {:value {:class "lint-fn-ns"}}
                             :children [:_plint-fn-ns]}}]}}
  {:name :_plint-f-links
   :parent :map :args {:func :_plint-fn-link :coll :_plint-f-fns}}
  {:name :_plint-f-links-div
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "lint-fns"}} :children [:_plint-f-links]}}

  {:name :_plint-f-rule-chip
   :parent :hiccup
   :args {:tag {:value "span"} :attrs {:value {:class "lint-rule"}} :children [:_plint-f-rule]}}
  {:name :_plint-f-msg-div
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "lint-msg"}} :children [:_plint-f-msg]}}

  {:name :_plint-suppress-url
   :parent :str
   :args {:parts [{:value "/partials/lint/suppress?rule="} :_plint-f-rule {:value "&fn-ids="} :_plint-f-csv]}}
  {:name :_plint-suppress-btn
   :description "Per-row \"Not an issue\" — POSTs the finding's key to the suppress route and swaps the refreshed panel body back in."
   :parent :hx-button
   :args {:label {:value "Not an issue"}
          :url :_plint-suppress-url
          :target {:value "closest .lint-body"}
          :swap {:value "outerHTML"}
          :extras {:value {:class "lint-suppress"
                           :title "Hide this finding; it stays hidden until the group changes or you restore it"}}}}

  {:name :_plint-row
   :description "One finding — rule chip, member fn links, the engine's message, the suppress button."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "lint-row"}}
          :children [:_plint-f-rule-chip :_plint-f-links-div :_plint-f-msg-div :_plint-suppress-btn]}}

  {:name :_plint-rendered-rows
   :parent :map :args {:func :_plint-row :coll {:as :warnings}}}
  {:name :_plint-empty?
   :parent :empty? :args {:coll {:as :warnings}}}
  {:name :_plint-empty-msg
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "lint-empty"}}
          :children ["Nothing to report on this branch."]}}
  {:name :_plint-list
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "lint-list"}} :children [:_plint-rendered-rows]}}
  {:name :_plint-findings
   :parent :if
   :args {:test :_plint-empty? :then :_plint-empty-msg :else :_plint-list}}

  ;; --- the hidden list: what was marked not-an-issue, each restorable ---
  {:name :_plint-s-rule
   :parent :get :args {:coll {:as :item} :key {:value :rule} :default {:value ""}}}
  {:name :_plint-s-ids
   :parent :get :args {:coll {:as :item} :key {:value :fn-ids} :default {:value []}}}
  {:name :_plint-s-fn-row
   :description "The suppressed member's fn row; nil when it was deleted since. Ids in the store were written by the suppress route, so the `:assert-some` narrowing never fires on a real entry."
   :parent :get-entity
   :args {:entity-type {:value "fn"}
          :id {:parent :assert-some
               :args {:value {:parent :parse-uuid :args {:string {:as :item}}}}}}}
  {:name :_plint-s-fn-name
   :description "A suppressed member by name — the id when the fn is gone (a deleted member is the usual reason the entry is stale)."
   :parent :coalesce
   :args {:value {:parent :get :args {:coll :_plint-s-fn-row :key {:value :name} :default nil}}
          :default {:as :item}}}
  {:name :_plint-s-fn-link
   :parent :hiccup
   :args {:tag {:value "a"}
          :attrs {:parent :assoc
                  :args {:map {:value {:class "lint-fn"}}
                         :key {:value :href}
                         :value {:parent :str :args {:parts [{:value "#"} :_plint-s-fn-name]}}}}
          :children [:_plint-s-fn-name]}}
  {:name :_plint-s-links
   :parent :map :args {:func :_plint-s-fn-link :coll :_plint-s-ids}}
  {:name :_plint-restore-url
   :parent :str
   :args {:parts [{:value "/partials/lint/restore?rule="} :_plint-s-rule {:value "&fn-ids="}
                  {:parent :str-join :args {:coll :_plint-s-ids :separator {:value ","}}}]}}
  {:name :_plint-restore-btn
   :parent :hx-button
   :args {:label {:value "Restore"}
          :url :_plint-restore-url
          :target {:value "closest .lint-body"}
          :swap {:value "outerHTML"}
          :extras {:value {:class "lint-restore" :title "Show this finding again"}}}}
  {:name :_plint-s-row
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "lint-row lint-row-hidden"}}
          :children [{:parent :hiccup
                      :args {:tag {:value "span"} :attrs {:value {:class "lint-rule"}} :children [:_plint-s-rule]}}
                     {:parent :hiccup
                      :args {:tag {:value "div"} :attrs {:value {:class "lint-fns"}} :children [:_plint-s-links]}}
                     :_plint-restore-btn]}}
  {:name :_plint-s-rows
   :parent :map :args {:func :_plint-s-row :coll {:as :suppressed}}}
  {:name :_plint-s-count
   :parent :count :args {:coll {:as :suppressed}}}
  {:name :_plint-s-summary
   :parent :hiccup
   :args {:tag {:value "summary"}
          :attrs {:value {:class "lint-hidden-summary"}}
          :children [{:parent :to-str :args {:value :_plint-s-count}} " marked not an issue"]}}
  {:name :_plint-s-details
   :parent :hiccup
   :args {:tag {:value "details"}
          :attrs {:value {:class "lint-hidden"}}
          :children [:_plint-s-summary :_plint-s-rows]}}
  {:name :_plint-s-any?
   :parent :not :args {:value {:parent :empty? :args {:coll {:as :suppressed}}}}}
  {:name :_plint-hidden
   :parent :if
   :args {:test :_plint-s-any? :then :_plint-s-details :else :hidden-span}}

  {:name :_plint-body
   :description "The swappable panel body — findings, then the collapsed list of hidden ones. Free args: `:warnings` (display rows), `:suppressed` (the store's entries)."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "lint-body"}}
          :children [:_plint-findings :_plint-hidden]}}
  {:name :_plint-render
   :parent :render-hiccup
   :args {:hiccup :_plint-body}}

  ;; --- GET: warnings against the stored suppressions ---
  {:name :_plint-html
   :parent :_plint-render
   :args {:warnings {:parent :branch-lint-warnings :args {:suppressed :_plint-suppressed}}
          :suppressed :_plint-suppressed}}

  {:name :_partial-lint-handler
   :lambda-params []
   :description "Ring handler for GET /partials/lint — the current branch's graph-lint warnings as text/html. Auth-required (route side)."
   :parent :html-ok-response
   :args {:body :_plint-html}}

  ;; --- POST suppress / restore: apply the write, then render from the
  ;;     list just written (the store's thunk was forced BEFORE the write). ---
  {:name :_plint-q-rule
   :parent :query-param :args {:param-name {:value "rule"}}}
  {:name :_plint-q-ids
   :description "`?fn-ids=a,b` split — `:query-param` is `:nullable-text`, the `:coalesce` keeps `:str-split`'s `:text` slot proven."
   :parent :str-split
   :args {:string {:parent :coalesce
                   :args {:value {:parent :query-param :args {:param-name {:value "fn-ids"}}}
                          :default {:value ""}}}
          :separator {:value ","}}}
  {:name :_plint-entry
   :description "The finding's key as the store keeps it — `{:rule <text> :fn-ids [<uuid-text> …]}`."
   :parent :zipmap
   :args {:keys [{:value :rule} {:value :fn-ids}]
          :vals [:_plint-q-rule :_plint-q-ids]}}

  {:name :_plint-supp-appended
   :parent :distinct
   :args {:coll {:parent :conj :args {:coll :_plint-suppressed :item :_plint-entry}}}}
  {:name :_plint-supp-update
   :description "Store exists — rewrite the const's `:value` with the entry added."
   :parent :update-entity
   :args {:entity-type {:value "binding"}
          :id :_plint-supp-binding-id
          :data {:parent :zipmap :args {:keys [{:value :value}] :vals [:_plint-supp-appended]}}}}

  {:name :_plint-const-id
   :parent :fn-id-by-name
   :args {:fn-name {:value "const"}}}
  {:name :_plint-const-slot-id
   :description "`:const`'s one slot (`value`) — the binding the store's list goes on."
   :parent :get
   :args {:coll {:parent :first
                 :args {:coll {:parent :query-entities
                               :args {:entity-type {:value "fn-slot"}
                                      :where {:parent :assoc
                                              :args {:map {:value {}} :key {:value :fn-id} :value :_plint-const-id}}}}}}
          :key {:value :slot-id}
          :default nil}}
  {:name :_plint-supp-created-fn
   :description "First suppression on this branch — create the root `lint-suppressions` const through the full CRUD write unit."
   :parent :create-entity
   :args {:entity-type {:value "fn"}
          :data {:parent :zipmap
                 :args {:keys [{:value :name} {:value :parent-ids} {:value :description}]
                        :vals [{:value "lint-suppressions"}
                               {:parent :vec :args {:coll [:_plint-const-id]}}
                               {:value "Lint findings marked as not an issue — a list of {:rule :fn-ids}. The Lint panel adds and removes entries; edit or delete this fn to change them by hand."}]}}}}
  {:name :_plint-supp-created-id
   :parent :get :args {:coll :_plint-supp-created-fn :key {:value :id} :default nil}}
  {:name :_plint-supp-create-binding
   :parent :create-entity
   :args {:entity-type {:value "binding"}
          :data {:parent :zipmap
                 :args {:keys [{:value :fn-id} {:value :slot-id} {:value :value}]
                        :vals [:_plint-supp-created-id :_plint-const-slot-id
                               {:parent :vec :args {:coll [:_plint-entry]}}]}}}}
  {:name :_plint-suppress-applied
   :parent :if
   :args {:test :_plint-supp-fn-nil?
          :then :_plint-supp-create-binding
          :else :_plint-supp-update}}
  {:name :_plint-after-suppress-html
   :parent :_plint-render
   :args {:warnings {:parent :branch-lint-warnings :args {:suppressed :_plint-supp-appended}}
          :suppressed :_plint-supp-appended}}
  {:name :_plint-suppress-then-html
   :parent :do
   :args {:steps [:_plint-suppress-applied :_plint-after-suppress-html]}}
  {:name :_partial-lint-suppress-handler
   :lambda-params [:request]
   :description "Ring handler for POST /partials/lint/suppress?rule=R&fn-ids=a,b — record the finding as not-an-issue in the branch's `lint-suppressions` const (created on first use), respond with the refreshed panel body."
   :parent :html-ok-response
   :args {:body :_plint-suppress-then-html}}

  {:name :_plint-not-entry?
   :description "HOF pred — every stored entry except the one being restored."
   :parent :not
   :args {:value {:parent :equal? :args {:a {:as :item} :b :_plint-entry}}}}
  {:name :_plint-supp-removed
   :parent :vec
   :args {:coll {:parent :filter :args {:pred :_plint-not-entry? :coll :_plint-suppressed}}}}
  {:name :_plint-restore-applied
   :parent :update-entity
   :args {:entity-type {:value "binding"}
          :id :_plint-supp-binding-id
          :data {:parent :zipmap :args {:keys [{:value :value}] :vals [:_plint-supp-removed]}}}}
  {:name :_plint-after-restore-html
   :parent :_plint-render
   :args {:warnings {:parent :branch-lint-warnings :args {:suppressed :_plint-supp-removed}}
          :suppressed :_plint-supp-removed}}
  {:name :_plint-restore-then-html
   :description "The entry is read FIRST as its own step: inside the `:filter` predicate it is a captured closure arg, invisible to the handler's free-arg surface, and `:lambda-params [:request]` must name a real free arg (`:compile/invalid-lambda-params` otherwise)."
   :parent :do
   :args {:steps [:_plint-entry :_plint-restore-applied :_plint-after-restore-html]}}
  {:name :_partial-lint-restore-handler
   :lambda-params [:request]
   :description "Ring handler for POST /partials/lint/restore?rule=R&fn-ids=a,b — drop the entry from `lint-suppressions`, respond with the refreshed panel body (the finding shows again if it still holds)."
   :parent :html-ok-response
   :args {:body :_plint-restore-then-html}}

  ;; ---------------------------------------------------------------------
  ;; STATS partial (Phase C) — GET /partials/stats. The CURRENT org's run
  ;; statistics over a 7-day window: headline totals, a per-day trend
  ;; table, and a top-fns table. Every number comes from an org-scoped
  ;; `:usage-stat` rollup (counts + durations only — never args/results/
  ;; errors), so a tenant sees exactly their own workspace and nothing of
  ;; anyone else's. Fn names in the top table are native #hash links.
  ;; ---------------------------------------------------------------------
  {:name :_pstats-days-raw
   :description "Read the `days` query-string parameter; nil when absent."
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "days"}}}

  {:name :_pstats-days-30?
   :parent :equal? :args {:a :_pstats-days-raw :b {:value "30"}}}
  {:name :_pstats-days-90?
   :parent :equal? :args {:a :_pstats-days-raw :b {:value "90"}}}

  {:name :_pstats-days-else
   :parent :if :args {:test :_pstats-days-30? :then {:value 30} :else {:value 7}}}
  {:name :_pstats-window-days
   :description "The panel's trailing window — `?days=30|90` allowed, anything else clamps to 7 (allowlist, not parse: no way to smuggle an arbitrary interval)."
   :parent :if :args {:test :_pstats-days-90? :then {:value 90} :else :_pstats-days-else}}

  {:name :_pstats-summary
   :parent :usage-org-summary
   :args {:days :_pstats-window-days}}

  {:name :_pstats-summary-runs
   :parent :get :args {:coll :_pstats-summary :key {:value :runs} :default {:value 0}}}
  {:name :_pstats-summary-failed
   :parent :get :args {:coll :_pstats-summary :key {:value :failed} :default {:value 0}}}
  ;; Run-weighted average derived HERE (the `:_ufs-avg` pattern) — the
  ;; base-fn returns raw `:duration-ms-sum` only.
  {:name :_pstats-summary-sum
   :parent :get :args {:coll :_pstats-summary :key {:value :duration-ms-sum} :default {:value 0}}}
  {:name :_pstats-summary-has-runs?
   :parent :gt :args {:nums [:_pstats-summary-runs {:value 0}]}}
  {:name :_pstats-summary-avg-raw
   :parent :quot :args {:dividend :_pstats-summary-sum :divisor :_pstats-summary-runs}}
  {:name :_pstats-summary-avg
   :parent :if
   :args {:test :_pstats-summary-has-runs?
          :then :_pstats-summary-avg-raw
          :else {:value 0}}}

  {:name :_pstats-headline-text
   :description "`<N>d: N runs · M failed · avg K ms` — the panel headline, window included."
   :parent :str
   :args {:parts [:_pstats-window-days {:value "d: "} :_pstats-summary-runs {:value " runs · "}
                  :_pstats-summary-failed {:value " failed · avg "}
                  :_pstats-summary-avg {:value " ms"}]}}

  {:name :_pstats-headline
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "stats-headline"}}
          :children [:_pstats-headline-text]}}

  ;; --- Period switcher — three htmx buttons re-fetching the partial with
  ;; ?days=N and swapping the [data-stats-panel] root (outerHTML, the
  ;; packages-panel pattern). Active state is server-rendered.
  {:name :_pstats-is-7?
   :parent :equal? :args {:a :_pstats-window-days :b {:value 7}}}
  {:name :_pstats-is-30?
   :parent :equal? :args {:a :_pstats-window-days :b {:value 30}}}
  {:name :_pstats-is-90?
   :parent :equal? :args {:a :_pstats-window-days :b {:value 90}}}

  {:name :_pstats-p7-class
   :parent :if :args {:test :_pstats-is-7?
                      :then {:value "stats-period stats-period-active"}
                      :else {:value "stats-period"}}}
  {:name :_pstats-p30-class
   :parent :if :args {:test :_pstats-is-30?
                      :then {:value "stats-period stats-period-active"}
                      :else {:value "stats-period"}}}
  {:name :_pstats-p90-class
   :parent :if :args {:test :_pstats-is-90?
                      :then {:value "stats-period stats-period-active"}
                      :else {:value "stats-period"}}}

  {:name :_pstats-p7-attrs
   :parent :assoc
   :args {:map {:value {:hx-get "/partials/stats?days=7"
                        :hx-target "closest [data-stats-panel]"
                        :hx-swap "outerHTML" :type "button"}}
          :key {:value :class} :value :_pstats-p7-class}}
  {:name :_pstats-p30-attrs
   :parent :assoc
   :args {:map {:value {:hx-get "/partials/stats?days=30"
                        :hx-target "closest [data-stats-panel]"
                        :hx-swap "outerHTML" :type "button"}}
          :key {:value :class} :value :_pstats-p30-class}}
  {:name :_pstats-p90-attrs
   :parent :assoc
   :args {:map {:value {:hx-get "/partials/stats?days=90"
                        :hx-target "closest [data-stats-panel]"
                        :hx-swap "outerHTML" :type "button"}}
          :key {:value :class} :value :_pstats-p90-class}}

  {:name :_pstats-p7-btn
   :parent :hiccup
   :args {:tag {:value "button"} :attrs :_pstats-p7-attrs :children ["7d"]}}
  {:name :_pstats-p30-btn
   :parent :hiccup
   :args {:tag {:value "button"} :attrs :_pstats-p30-attrs :children ["30d"]}}
  {:name :_pstats-p90-btn
   :parent :hiccup
   :args {:tag {:value "button"} :attrs :_pstats-p90-attrs :children ["90d"]}}

  {:name :_pstats-period-bar
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "stats-period-bar"}}
          :children [:_pstats-p7-btn :_pstats-p30-btn :_pstats-p90-btn]}}

  ;; --- Per-day trend table ---------------------------------------------
  {:name :_pstats-daily
   :parent :usage-org-daily
   :args {:days :_pstats-window-days}}

  {:name :_pstats-day-label
   :parent :get :args {:coll {:as :item} :key {:value :day} :default {:value ""}}}
  ;; --- Shared per-row cells ---------------------------------------------
  ;; The day / top-fns / by-org tables carry the same usage columns
  ;; (`:runs` / `:failed` / `:duration-ms-sum` / `:runs-pct`) on their
