                                                                                :children [{:parent :_mk-stars :args {:rating {:parent :get :args {:coll {:as :item} :key {:value :rating} :default {:value 0}}}}}]}}
                                                        {:parent :hiccup :args {:tag {:value "span"} :attrs {:value {:class "mk-review-author"}}
                                                                                :children [{:parent :to-str :args {:value {:parent :get :args {:coll {:as :item} :key {:value :author-label} :default {:value "anonymous"}}}}}]}}
                                                        {:parent :hiccup :args {:tag {:value "span"} :attrs {:value {:class "mk-review-date"}}
                                                                                :children [{:parent :str-clip :args {:string :_mkw-updated :limit {:value 10}}}]}}]}}
