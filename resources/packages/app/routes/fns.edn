;; App routes. Each leaf carries only the SUB-path under its enclosing
;; group; full URLs are assembled by reitit's nested vector form
;; (`[prefix child …]`). Adding a version like `/v1` becomes a single
;; wrap of `:api-routes` instead of a touch on every endpoint.
;;
;; Multi-method paths are expressed by merging per-method method-maps
;; (`:_method-map-with-middleware`) and pairing the result with the
;; sub-path — that gives reitit a single conflict-free entry per path.
;;
;; The top-level group (`:api-routes`) and the standalone root-level
;; routes (`:health`, `:metrics`, `:favicon`, `:editor`) are collected
;; into `app.routes.groups.all` for the `:_router` binding.


{:namespace "app.routes"
 :description "Application routes — sub-paths inside the `:api-routes` group plus a handful of standalone root-level entries. Each entry is one reitit-shaped route, with multi-method paths combined at the graph level so reitit's natural conflict detection sees clean data."
 :fns
 [;; =============================================================================
  ;; STANDALONE ROOT-LEVEL ROUTES
  ;; =============================================================================

  {:name :health
   :description "GET /health — current health status as JSON."
   :parent :get-route
   :args {:path "/health" :handler :_health-handler}
   :expects-effects #{:time}}                 ; only wall-clock; no DB / env / IO

  {:name :metrics
   :description "GET /metrics — JVM info (heap, threads, uptime) as JSON."
   :parent :get-route
   :args {:path "/metrics" :handler :_metrics-handler}
   :expects-effects #{:io :env}}              ; reads JVM state (heap / threads / os) + env (hostname / user)

  {:name :version
   :description "GET /version — `{\"frontend\": \"<hex>\", \"packages\": \"<hex>\", \"backend\": \"<hex>\"}`. Each is a SHA-256 over that section's source files at build time; compare with `bb verify` to confirm which section a deploy actually shipped."
   :parent :get-route
   :args {:path "/version" :handler :_version-handler}
   :expects-effects #{:io}}                   ; reads classpath resource only

  {:name :favicon
   :description "GET /favicon.ico — inlined SVG icon, cached for 24 hours."
   :parent :get-route
   :args {:path "/favicon.ico" :handler :_favicon-handler}
   :expects-effects #{}}                      ; SVG body is a const; no IO

  {:name :editor
   :description "GET / — the graph-editor HTML page."
   :parent :get-route
   :args {:path "/" :handler :_editor-handler}
   :expects-effects #{:io}}

  ;; The /demo/contact route entry (`:demo-contact`) lives in
  ;; app.contact-demo alongside its handlers; referenced
  ;; directly from app.route-groups.all.

  ;; The editor JS/CSS bundles are SEPARATE responses (not inlined
  ;; into the HTML). The URLs carry `?v=<frontend-build-hash>` so the
  ;; `immutable` `Cache-Control` is safe: a new deploy changes the
  ;; URL → cache miss → fresh fetch; in-between the browser serves
  ;; the body from cache without a conditional request.
  {:name :editor-js-asset
   :description "GET /assets/editor.js — bundled editor JS with 1-year `immutable` `Cache-Control`. Hash-busted via `?v=` query string on the inbound `<script src>`."
   :parent :get-route
   :args {:path "/assets/editor.js" :handler :_editor-js-handler}
   :expects-effects #{:io}}

  {:name :api-routes-js-asset
   :description "GET /assets/api-routes.js — boot-cached `window.API = {…}` module derived from the live reitit router. 1-year `immutable` cache, hash-busted via `?v=` on the inbound `<script src>`. Loaded before editor.js so every editor module can resolve `/api/*` URLs via `window.API.<key>` at file-eval time."
   :parent :get-route
   :args {:path "/assets/api-routes.js" :handler :_api-routes-js-handler}}                   ; reads classpath JS bundle

  {:name :graphden-runtime-js-asset
   :description "GET /assets/graphden-runtime.js — runtime bundle (graphden-popover.js + graphden-forms.js + graphden-runtime.js + graphden-actions-builtin.js) for user-built pages that don't host the editor canvas: popover positioning/dismiss + hiccup form render/collect/fill/widgets + action dispatch + built-in handlers. Same 1-year `immutable` cache as editor.js."
   :parent :get-route
   :args {:path "/assets/graphden-runtime.js" :handler :_graphden-runtime-js-handler}
   :expects-effects #{:io}}

  {:name :editor-css-asset
   :description "GET /assets/editor.css — bundled editor stylesheet with 1-year `immutable` `Cache-Control`. Hash-busted via `?v=` query string on the inbound `<link href>`."
   :parent :get-route
   :args {:path "/assets/editor.css" :handler :_editor-css-handler}
   :expects-effects #{:io}}                   ; reads classpath CSS

  {:name :graphden-components-css-asset
   :description "GET /assets/graphden-components.css — default stylesheet for web.components primitives. Same 1-year `immutable` cache + `?v=` hash-bust."
   :parent :get-route
   :args {:path "/assets/graphden-components.css" :handler :_graphden-components-css-handler}
   :expects-effects #{:io}}

  ;; HTMX partials — server-rendered HTML fragments that the editor's
  ;; JS swaps into mount-points instead of building DOM client-side.
  ;; The fragment fn-defs live in `app.editor`; this route just
  ;; exposes the handler.
  {:name :partial-effect
   :description "GET /partials/effect?effect=<tag> — popover hiccup for one tracked side-effect, served as `text/html`. Editor JS fetches this and swaps the response body into the explainer mount-point."
   :parent :get-route
   :args {:path "/partials/effect" :handler :_partial-effect-handler}
   :expects-effects #{}}                      ; pure lookup over a literal map

  {:name :partial-auth-form
   :description "GET /partials/auth-form — the login/signup popover fields as text/html. UNAUTHENTICATED (it IS the login form). editor-auth.js mounts it into #auth-popover on first open + owns the interactive lifecycle."
   :parent :get-route
   :args {:path "/partials/auth-form" :handler :_partial-auth-form-handler}
   :expects-effects #{}}                      ; pure static form markup

  {:name :partial-fn-versions
   :description "GET /partials/fn-versions?fn-id=X&current-branch=Y&title=Z — popover hiccup for one fn's version history, served as `text/html`. Reads from the same `:list-fn-versions` data chain `/api/fns/:id/versions` uses; the partial is the HTML projection of that JSON."
   :parent :get-auth-required
   :args {:path "/partials/fn-versions" :handler :_partial-fn-versions-handler}}

  {:name :partial-fn-version-executions
   :description "GET /partials/fn-version-executions?fn-version-id=X — executions sub-list for one version row, served as `text/html`. HTMX-fetched from each `:partial-fn-versions` row on click."
   :parent :get-auth-required
   :args {:path "/partials/fn-version-executions" :handler :_partial-fn-version-executions-handler}}

  {:name :partial-execute-history
   :description "GET /partials/execute-history?fn-id=X — history panel hiccup for one fn (rows across all of its versions on the current branch). JS in `editor-execute.js` swaps the response into the panel host and binds Repeat / row-expand handlers post-swap."
   :parent :get-auth-required
   :args {:path "/partials/execute-history" :handler :_partial-execute-history-handler}}

  {:name :partial-branch-diff
   :description "GET /partials/branch-diff?target=X&source=Y — branch-diff body hiccup (3 sections grouped by `:change` + branch-local annotations). JS in `editor-branch-diff.js` owns the modal chrome; this fills the body mount."
   :parent :get-auth-required
   :args {:path "/partials/branch-diff" :handler :_partial-branch-diff-handler}}

  {:name :partial-merge-conflicts
   :description "POST /partials/merge-conflicts — body is the `{conflicts, source, target}` JSON the failed merge returned; renders the resolution card hiccup (header + help + batch toolbar + per-conflict source/target radios + version previews + Cancel/Apply). Renders the POSTed conflicts (no re-detection — mirrors `:partial-execute-result-inline`). JS in `editor-branches.js` owns the overlay chrome + radio/apply lifecycle."
   :parent :post
   :args {:path "/partials/merge-conflicts" :handler :_partial-merge-conflicts-handler}}

  {:name :partial-execute-result-effects
   :description "GET /partials/execute-result-effects?runtime=db,io&declared=db — runtime-effects chip strip below an execute-popover result. Both params are comma-separated effect names; empty lists render an empty (hidden) span. JS in `editor-execute.js` swaps the response into the result host."
   :parent :get-route
   :args {:path "/partials/execute-result-effects" :handler :_partial-execute-result-effects-handler}
   :expects-effects #{}}

  {:name :partial-mismatch-explainer
   :description "GET /partials/mismatch-explainer?binding-id=X[&item-id=Y] — mismatch-explainer hiccup (header + Expected / Got / Reason rows) computed server-side off the binding row. STEP 1 of the JS→graph migration: replaces JS-local validation; provenance / diff-leaves / Edit-button stay JS-side for now (steps 2-4)."
   :parent :get-auth-required
   :args {:path "/partials/mismatch-explainer" :handler :_partial-mismatch-handler}}

  {:name :partial-provenance
   :description "GET /partials/provenance?binding-id=X[&item-id=Y] — type-narrowing provenance popover (the `↳` badge target on arg-overlay type-chips). Shares the `_provenance-section` renderer with `/partials/mismatch-explainer`. STEP 1 — header + Resolved-via section; Allowed-values + Slot-effect-bound sections are steps 2-3. PUBLIC (`:get-route`): it only projects type structure already readable via the public `/api/graph/entities`, so gating it added nothing but a login wall on a read-only badge."
   :parent :get-route
   :args {:path "/partials/provenance" :handler :_partial-provenance-handler}}

  {:name :partial-fn-picker-incompat
   :description "GET /partials/fn-picker-incompat?expected={json}&candidate-fn-id={uuid} — server-rendered incompat-explainer popover fragment for the fn-picker's `explainAndOfferAnyway` flow."
   :parent :get-auth-required
   :args {:path "/partials/fn-picker-incompat" :handler :_partial-fn-picker-incompat-handler}}

  {:name :partial-execute-result
   :description "GET /partials/execute-result?id={uuid} — execution body hiccup (scalar / list / record / tainted / large-JSON / 5MB-truncated / error). Consumed by `editor-execute-history.js` row-expand + `editor-execute.js` orchestrator after Run."
   :parent :get-auth-required
   :args {:path "/partials/execute-result" :handler :_partial-execute-result-handler}}

  {:name :partial-execute-result-inline
   :description "POST /partials/execute-result-inline — same hiccup as the GET-by-id sibling, but reads the execution shape from the POST JSON body instead of storage. Used by the orchestrator's non-persisted inline-Run path (no execution-id to read by)."
   :parent :post
   :args {:path "/partials/execute-result-inline" :handler :_partial-execute-result-inline-handler}}

  {:name :partial-branch-popover
   :description "GET /partials/branch-popover — top-bar branch chip popover body (sorted list + create input + error slot). Auth-gated: branch enumeration mirrors `/api/branches`. Click handlers in `editor-branches.js` bind via `data-branch-name` / `data-merge-source` / `data-diff-source` attrs the partial emits; 401 is surfaced by the same inline-error path as the legacy fetch."
   :parent :get-auth-required
   :args {:path "/partials/branch-popover" :handler :_partial-branch-popover-handler}}

  {:name :partial-service-popover
   :description "GET /partials/service-popover?fn-id=X — service settings popover body (header + status + sibling-warning + enabled/branch/policy form + save/delete actions). Auth-gated. Save / delete / close handlers in `editor-service-popover.js` are bound post-swap against `.service-popover-{save,delete,close}-btn` + the `data-existing-service-id` attr the partial emits."
   :parent :get-auth-required
   :args {:path "/partials/service-popover" :handler :_partial-service-popover-handler}}

  {:name :partial-secret-create-form
   :description "GET /partials/secret-create-form — the New-secret form markup (graph-first §6-#2). editor-secrets.js mounts it into the popover and owns the lifecycle. Auth-required."
   :parent :get-auth-required
   :args {:path "/partials/secret-create-form" :handler :_partial-secret-create-form-handler}}

  {:name :partial-secret-rotate-form
   :description "GET /partials/secret-rotate-form?name=&path= — the Rotate-secret form markup (title from query params; VALUE entered client-side). Auth-required."
   :parent :get-auth-required
   :args {:path "/partials/secret-rotate-form" :handler :_partial-secret-rotate-form-handler}}

  {:name :partial-row-actions
   :description "GET /partials/row-actions?fn-id=X&context=col-header[&show-open=false] — server-rendered per-row action buttons (ns / i / ↗ for col-header; cell / use-site-arg / root-row contexts added in subsequent migration phases). Public read-only route — write actions re-check `isAuthenticated()` client-side in the row-actions dispatcher (`editor-row-actions.js` bindRowActionsDispatch). Phase A1 of the HTMX migration plan."
   :parent :get-route
   :args {:path "/partials/row-actions" :handler :_partial-row-actions-handler}}

  ;; =============================================================================
  ;; /api/* — application API surface. Adding `/v1` is a single wrap of
  ;; `:api-routes` in another group with prefix "/v1".
  ;; =============================================================================

  ;; --- /api/entities — entity CRUD ---

  {:name :entity-create
   :description "POST /api/entities/:type — create entity from form-encoded body. Auth-required."
   :parent :post
   :args {:path "/:type" :handler :create-entity-handler}}

  ;; PUT and DELETE both target /:type/:id — combine their method-maps
  ;; into one reitit entry so the path is declared exactly once.

  {:name :entity-update
   :description "Method-data for PUT on `/api/entities/:type/:id` — updates an entity from a form-encoded body. Combined with `:entity-delete` into `:entity-by-id`. Auth-required."
   :parent :_method-map-with-middleware
   :args {:method "put"
          :handler :update-entity-handler
          :middleware :_middleware-list}}

  {:name :entity-delete
   :description "Method-data for DELETE on `/api/entities/:type/:id` — soft-deletes the entity. Combined with `:entity-update` into `:entity-by-id`. Auth-required."
   :parent :_method-map-with-middleware
   :args {:method "delete"
          :handler :delete-entity-handler
          :middleware :_middleware-list}}

  {:name :_entity-by-id-methods
   :description "Merged method-data — `{:put {…} :delete {…}}` — for `/api/entities/:type/:id`."
   :parent :merge
   :args {:maps [:entity-update :entity-delete]}}

  {:name :entity-by-id
   :description "Multi-method route entry `[\"/:type/:id\" {:put … :delete …}]`. Sits inside `:entity-routes`."
   :parent :list
   :args {:items ["/:type/:id" :_entity-by-id-methods]}}

  {:name :entity-routes
   :description "/api/entities/* sub-group — POST `/:type` (create) and PUT/DELETE `/:type/:id` (update/delete). New methods on /:type/:id go into `:_entity-by-id-methods`; new sub-paths get listed here directly."
   :parent :list
   :args {:items ["/entities" :entity-create :entity-by-id]}}

  ;; --- /api/sequence — sequence-arg editing ---

  {:name :sequence-append
   :description "POST /api/sequence/append/:fn-id — appends an item to a `:sequence`-typed arg. Auth-required."
   :parent :post
   :args {:path "/append/:fn-id" :handler :sequence-append-handler}}

  ;; PUT and DELETE both target /item/:item-id — combine their
  ;; method-maps into one reitit entry so the path is declared once.

  {:name :sequence-item-update
   :description "Method-data for PUT on `/api/sequence/item/:item-id` — replaces an item's value/ref. Combined with `:sequence-item-remove` into `:sequence-item`. Auth-required."
   :parent :_method-map-with-middleware
   :args {:method "put"
          :handler :sequence-update-handler
          :middleware :_middleware-list}}

  {:name :sequence-item-remove
   :description "Method-data for DELETE on `/api/sequence/item/:item-id` — removes an item from its sequence-arg. Combined with `:sequence-item-update` into `:sequence-item`. Auth-required."
   :parent :_method-map-with-middleware
   :args {:method "delete"
          :handler :sequence-remove-handler
          :middleware :_middleware-list}}

  {:name :_sequence-item-methods
   :description "Merged method-data — `{:put {…} :delete {…}}` — for `/api/sequence/item/:item-id`."
   :parent :merge
   :args {:maps [:sequence-item-update :sequence-item-remove]}}

  {:name :sequence-item
   :description "Multi-method route entry `[\"/item/:item-id\" {:put … :delete …}]`. Sits inside `:sequence-routes`."
   :parent :list
   :args {:items ["/item/:item-id" :_sequence-item-methods]}}

  {:name :sequence-routes
   :description "/api/sequence/* sub-group — POST `/append/:fn-id` plus PUT/DELETE `/item/:item-id`. New methods on /item/:item-id go into `:_sequence-item-methods`."
   :parent :list
   :args {:items ["/sequence" :sequence-append :sequence-item]}}

  ;; --- /api/bindings — binding-specific narrowing operations ---

  {:name :tighten-binding-effects
   :description "POST /api/bindings/:binding-id/tighten-fn-effects — narrow an fn-typed binding's effective type to a 4-arity `[:fn args ret #{eff-set}]`. Body: `{effects: [\"db\", \"io\", …]}`. Auth-required."
   :parent :post
   :args {:path "/:binding-id/tighten-fn-effects"
          :handler :tighten-binding-effects-handler}}

  {:name :bindings-routes
   :description "/api/bindings/* sub-group — currently just the tighten-fn-effects endpoint."
   :parent :list
   :args {:items ["/bindings" :tighten-binding-effects]}}

  ;; --- /api/graph — graph data API ---

  {:name :api-entities
   :description "GET /api/graph/entities — full graph dump (every fn, arg, namespace) as JSON."
   :parent :get-route
   :args {:path "/entities" :handler :all-entities-handler}}

  {:name :layout-api
   :description "POST /api/graph/layout — accepts `{root-id, expansions}`, returns the laid-out graph (nodes + edges + grid positions)."
   :parent :post-route
   :args {:path "/layout" :handler :_layout-api-handler}}

  {:name :graph-routes
   :description "/api/graph/* sub-group — graph-data endpoints (entities dump + layout pipeline)."
   :parent :list
   :args {:items ["/graph" :api-entities :layout-api]}}

  ;; --- /api/types — type-system surface ---

  {:name :api-types
   :description "GET /api/types — snapshot of the in-memory rich-type registry (every fn / fn-def's `:return` + `:args`). Powers editor type hints and external introspection."
   :parent :get-route
   :args {:path "" :handler :all-rich-types-handler}}

  {:name :api-types-compatible
   :description "POST /api/types/compatible — single-pair subtype check. Body: `{expected, candidate}` in the JSON shape produced by `/api/types`. Returns `{ok, expected, candidate, reason?}`. UI uses this for type-mismatch explainers without re-implementing `subtype?` in JS."
   :parent :post-route
   :args {:path "/compatible" :handler :types-compatible-handler}}

  {:name :api-types-candidates
   :description "POST /api/types/candidates — enumerate fns whose return type is a subtype of `expected`. Body: `{expected, effects?, name-prefix?}`. Returns `{count, candidates: [{name, return, args, effects}, ...]}` sorted alphabetically. Powers type-aware fn-pickers."
   :parent :post-route
   :args {:path "/candidates" :handler :types-candidates-handler}}

  {:name :api-types-usages
   :description "POST /api/types/usages — list every fn that references a given type-row. Body: `{type-fn-id}`. Returns `{count, usages: [{fn-id, fn-name, role, kind, slot-name?}, ...]}`. Powers the inline-expand panel's 'Used by N' navigation."
   :parent :post-route
   :args {:path "/usages" :handler :types-usages-handler}}

  {:name :api-types-record
   :description "POST /api/types/record — atomically create a record type-row. JSON body `{namespace-id?, name, description?, fields: [{name, type, description?, required?}, …]}`. Returns `{ok, id?, name?, error?}`. Auth-required (creates entities)."
   :parent :post
   :args {:path "/record" :handler :types-create-record-handler}}

  {:name :api-types-record-update
   :description "PUT /api/types/record-update — diff-update an existing record (path-distinct from POST /record because the reitit router rejects duplicate path entries even across methods in our compile pipeline). JSON body `{id, name?, description?, fields: [{name, type, …}, …]}`. Auth-required."
   :parent :put
   :args {:path "/record-update" :handler :types-update-record-handler}}

  {:name :api-types-list
   :description "POST /api/types/list — atomically create a list type-row (fn + auto-`items` slot). JSON body `{namespace-id?, name, description?, element-type}`. Auth-required."
   :parent :post
   :args {:path "/list" :handler :types-create-list-handler}}

  {:name :types-routes
   :description "/api/types/* sub-group — registry snapshot + Phase 1 type-aware helpers (compatible / candidates / usages) + Tier-2 compound creators (record / list) for the editor."
   :parent :list
   :args {:items ["/types"
                  :api-types
                  :api-types-compatible
                  :api-types-candidates
                  :api-types-usages
                  :api-types-record
                  :api-types-record-update
                  :api-types-list]}}

  ;; --- /api/auth/check — admin-token validation ping ---

  {:name :auth-check
   :description "GET /api/auth/check — auth-required ping endpoint. Returns 200 `\"ok\"` when the bearer token matches; the auth middleware short-circuits to 401 otherwise. Used by the editor's lock-icon popover to validate the password before showing edit affordances."
   :parent :get-auth-required
   :args {:path "/auth/check" :handler :_auth-check-handler}}

  {:name :_auth-check-handler
   :description "Ring handler returning `200 \"ok\"` as plain text."
   :parent :text-ok-response
   :args {:body "ok"}}

  ;; --- /api/value-kinds — value_kind schema enum ---

  {:name :api-value-kinds
   :description "GET /api/value-kinds — the `value_kind` schema enum as a JSON array of primitive type-tag strings. The editor's type-pickers fetch this instead of hard-coding the enum."
   :parent :get-route
   :args {:path "/value-kinds" :handler :value-kinds-handler}}

  ;; --- /api/value-form — type-aware editor form for a binding/slot ---

  {:name :api-value-form
   :description "POST /api/value-form — JSON body `{binding-id | fn-id+slot-id, item-id?}`. Resolves the slot's effective type, picks the matching form-fn, and returns `{ok, form: <hiccup>, value: <current>}`. The editor renders the hiccup as the value-edit popover."
   :parent :post-route
   :args {:path "/value-form" :handler :value-form-handler}}

  ;; --- /api/execute — submit, poll, cancel fn runs ---

  {:name :api-execute
   :description "POST /api/execute — submit a fn-graph run. Body `{fn-id|fn-name, args, timeout-ms?, persist??}`. Returns inline `{status: succeeded, result}` for fast pure fns or `{status: pending, execution-id}` when timeout fires / effects ≠ #{} / persist? true. Auth-required."
   :parent :post
   :args {:path "/execute" :handler :execute-handler}}

  {:name :api-execution-by-id
   :description "GET /api/execute/:id — read a persisted execution row (status, result/error, declared-effects, started/finished-at, nested args). Auth-required."
   :parent :get-auth-required
   :args {:path "/execute/:id" :handler :get-execution-handler}}

  {:name :api-execution-cancel
   :description "POST /api/execute/:id/cancel — soft-cancel an in-flight execution. Sets the row's :cancel-requested? flag + future-cancel. Best-effort (blocking IO won't respect interrupt without explicit Statement.cancel())."
   :parent :post
   :args {:path "/execute/:id/cancel" :handler :cancel-execution-handler}}

  {:name :api-executions-list
   :description "GET /api/executions?fn-id=X — list last 20 executions for one fn (across all of its versions). Each row summarises status / timestamps / declared-effects; nested args are NOT included (call GET /api/execute/:id to expand a row). Auth-required."
   :parent :get-auth-required
   :args {:path "/executions" :handler :list-executions-handler}}

  ;; --- /api/services/reconcile — Phase 1 hot-reload trigger ---

  {:name :api-services-reconcile
   :description "POST /api/services/reconcile — trigger the service reconciler. Reads enabled :service rows, starts missing + stops removed. Admin calls this after CREATE/UPDATE/DELETE on a :service row so the in-process state catches up without a pod restart. Phase 1 only — periodic poll arrives with Phase 3 (multi-pod). Auth-required."
   :parent :post
   :args {:path "/services/reconcile" :handler :reconcile-services-handler}}

  {:name :api-services-list
   :description "GET /api/services — list every :service row joined with its in-process running state (started-at, attempts, give-up marker) and the legacy fallback if active. Editor reads this to drive the sidebar 'Only services' filter, the row-actions 'Make service' popover, and the per-fn status badge. Auth-required."
   :parent :get-auth-required
   :args {:path "/services" :handler :list-services-handler}}

  ;; --- /api/branches — branch lifecycle + diff/merge. All entries
  ;; are auth-required (matches /api/services pattern). Same path on
  ;; multiple methods → reitit needs ONE entry with the method-data
  ;; merged, like `:entity-by-id`. ---

  ;; GET /api/branches (list) + POST /api/branches (create) — same path.
  {:name :branches-list-data
   :description "Method-data for GET on `/api/branches`. Combined into `:api-branches-root`. Auth-required."
   :parent :_method-map-with-middleware
   :args {:method "get"
          :handler :list-branches-handler
          :middleware :_middleware-list}}

  {:name :branches-create-data
   :description "Method-data for POST on `/api/branches` — body `{name, base-branch-id?}`. Combined into `:api-branches-root`. Auth-required."
