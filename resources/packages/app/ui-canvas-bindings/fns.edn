   :args {:test :_flag-is-lambda :then :_flag-lambda-mode :else ""}}
  {:name :_flag-branch-checked :parent :if
   :args {:test :_flag-inherited :then true :else :_flag-own}}
  {:name :_flag-checked :parent :if
   :args {:test :_flag-is-lambda :then false :else :_flag-branch-checked}}
  {:name :_flag-disabled :parent :if
   :args {:test :_flag-is-lambda :then false :else :_flag-inherited}}
  {:name :bindings-initial :parent :zipmap :return-type :_flag-policy-result
   :args {:keys [{:value :mode} {:value :checked} {:value :disabled}]
          :vals [:_flag-mode :_flag-checked :_flag-disabled]}}
