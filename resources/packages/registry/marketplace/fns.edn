                                    :else {:value "Installed on this branch — the pin is in the packages chip."}}}
          :else {:parent :str-join :args {:coll [{:value "Refused: "} {:parent :to-str :args {:value {:parent :get :args {:coll {:as :outcome :type :keyword-map} :key {:value :reason} :default {:value "unknown"}}}}}] :separator {:value ""}}}}}
