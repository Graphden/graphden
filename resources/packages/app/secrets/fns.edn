   :description "Vec of `{:fn-id :name :reason}` rows for every fn that references `fn-id`. `[]` on nil input (the `:if (some? :fn-id)` lazy guard short-circuits nil before the 5 storage queries fire). Pure graph composition over 5 storage queries (3 reverse-ref + 1 IN-fetch for list-item parents + 1 IN-fetch for names) + 3 per-source reason maps + `:merge`-precedence + per-row JSON shape."
   :parent :if
   :args {:test {:parent :some? :args {:value {:as :fn-id :type :nullable-uuid :description "Target fn-id; nil short-circuits to `[]`."}}}
          :then :_find-fn-usages-rows
          :else {:value []}
          :fn-id {:type :nullable-uuid
                  :description "Target fn-id whose reverse references are scanned. nil short-circuits to `[]` via the `:if (some? :fn-id)` guard."}}}

  {:name :_delete-secret-usages
   :description "Find every fn that references the target — empty when delete can proceed. Reuses `:find-fn-usages`."
   :parent :find-fn-usages
   :args {:fn-id {:parent :get :args {:coll {:as :parsed} :key {:value :fn-id} :default nil}}}}

  {:name :_delete-secret-in-use?
   :description "Guard #3 — usages list is non-empty (`:not :empty?`)."
   :parent :not
   :args {:value {:parent :empty? :args {:coll {:as :usages}}}}}

  {:name :_delete-secret-err-not-found
   :description "Dynamic error builder — cites the raw fn-id-ref."
   :parent :zipmap
   :args {:keys [:ok :error :reason]
          :vals [false
                 {:parent :str
                  :args {:parts ["Secret not found: "
                                 {:parent :get
                                  :args {:coll {:as :parsed}
                                         :key {:value :fn-id-ref}
                                         :default nil}}]}}
                 :not-found]}}

  {:name :_delete-secret-err-not-a-secret
   :description "Dynamic error builder — cites the raw fn-id-ref."
   :parent :zipmap
   :args {:keys [:ok :error :reason]
          :vals [false
                 {:parent :str
                  :args {:parts ["fn is not a secret (parent != [:secret-leaf]): "
                                 {:parent :get
                                  :args {:coll {:as :parsed}
                                         :key {:value :fn-id-ref}
                                         :default nil}}]}}
                 :not-a-secret]}}

  ;; ---------------------------------------------------------------------
  ;; :_delete-secret-err-in-use — graph-composed error response
  ;; ---------------------------------------------------------------------
  ;; Was a literal-map defbase: `{:ok false :error (str …) :reason …
  ;; :usages (mapv reshape usages)}`. Admins wanting to tweak wording or
  ;; add a field had to edit Clojure. Now expressed via `:zipmap` over
  ;; [keys vals] lists — every field's value is a refactorable graph fn.

  {:name :_delete-secret-err-in-use
   :description "Error response when a secret is referenced by other fn rows. Lists each referencing fn (id, name, reason)."
   :parent :zipmap
   :args {:keys [:ok :error :reason :usages]
          :vals [false
                 {:parent :str
                  :args {:parts ["Secret is referenced by "
                                 {:parent :count :args {:coll {:as :usages}}}
                                 " fn(s) — remove or re-target dependents first"]}}
                 :secret-in-use
                 {:parent :map
                  :args {:func :_delete-secret-usage-shape
                         :coll {:as :usages}}}]}}

  {:name :_delete-secret-usage-shape
   :description "Single-usage reshape — `(fn [u] {:fn-id (str (:fn-id u)) :name (:name u) :reason (:reason u)})`. The HOF callable of `:_delete-secret-err-in-use`'s `:usages` field; stringifies the UUID so JSON-encode is faithful."
   :parent :zipmap
   :args {:keys [:fn-id :name :reason]
          :vals [{:parent :str
                  :args {:parts [{:parent :get
                                  :args {:coll {:as :item}
                                         :key {:value :fn-id}
                                         :default nil}}]}}
                 {:parent :get
                  :args {:coll {:as :item}
                         :key {:value :name}
                         :default nil}}
                 {:parent :get
                  :args {:coll {:as :item}
                         :key {:value :reason}
                         :default nil}}]}}

  ;; Phase 4.5 decomposition: success branch of DELETE /api/secrets/:fn-id
  ;; is now `:do` over three side-effect steps (vault cleanup → storage
  ;; cleanup → response build). No rollback — all three are best-effort.
  ;; The atomic helpers (`:_delete-secret-vault-cleanup`, `:_delete-
  ;; secret-storage-cleanup`) wrap one storage / vault concept each.
  {:name :_delete-secret-vault-cleanup
   :description "Best-effort vault delete during secret removal — suppresses failures internally so graph callers don't need a separate `:try` wrapper."
   :args {:path {:type :text}}
   :return-type :null
   :effects #{:network}}

  {:name :_delete-secret-storage-cleanup
   :description "Delete the path-binding (if present) + the fn-row through `crud.entities` so graph cache invalidates on each."
   :args {:parsed {:type {:fn-id :nullable-uuid :fn-id-ref :nullable-text}}}
   :return-type :null
   :effects #{:db}}

  {:name :_delete-secret-apply
   :description "Success branch — `:do` over vault cleanup → storage cleanup → success response. The `:path` arg is read from `:parsed` so admins reparenting the `:_delete-secret-parsed` shape can vary how the path is derived."
   :parent :do
   :args {:steps [:_delete-secret-apply-do-vault-cleanup
                  :_delete-secret-apply-do-storage-cleanup
                  :_delete-secret-apply-response]}}

  {:name :_delete-secret-apply-do-vault-cleanup
   :parent :_delete-secret-vault-cleanup
   :args {:path :_delete-secret-path}}

  {:name :_delete-secret-apply-do-storage-cleanup
   :parent :_delete-secret-storage-cleanup
   :args {:parsed {:as :parsed}}}

  {:name :_delete-secret-apply-response
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :id} {:value :name} {:value :path}]
          :vals [{:value true}
                 {:parent :to-str
                  :args {:value {:parent :get
                                 :args {:coll {:as :parsed} :key {:value :fn-id} :default nil}}}}
                 {:parent :get :args {:coll {:as :fn-row} :key {:value :name} :default nil}}
                 :_delete-secret-path]}}

  {:name :_delete-secret-data
   :description "DELETE /api/secrets/:fn-id — flat `:cond` of `[not-found? → 404-shape, not-a-secret? → 409-shape, in-use? → 409 with usages list, true → apply]`. Lazy short-circuit means vault-delete + graphden deletes only run when every guard passes."
   :parent :cond
   :args {:clauses [:_delete-secret-not-found?     :_delete-secret-err-not-found
                    :_delete-secret-not-a-secret?  :_delete-secret-err-not-a-secret
                    :_delete-secret-in-use?        :_delete-secret-err-in-use
                    {:value true}                  :_delete-secret-apply]
          :parsed :_delete-secret-parsed
          :fn-row :_delete-secret-fn-row
          :secret-leaf-id :_secret-leaf-fn-id
          :usages :_delete-secret-usages}}

  {:name :delete-secret-handler
   :description "Ring handler for DELETE /api/secrets/:fn-id (auth-required)."
   :parent :json-handler
   :args {:data :_delete-secret-data}}]}
