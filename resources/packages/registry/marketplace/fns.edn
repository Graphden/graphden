   :parent :call :args {:func :_mka-install-item :arg :_mka-install-do}}
  {:name :_mka-install-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/marketplace/install?name=&version=[&fork=1] — installs (or forks) then returns the refreshed item as text/html."
   :parent :html-ok-response
   :args {:body :_mka-install-then-item}}
  {:name :api-marketplace-install
   :description "POST /api/marketplace/install?name=<pkg>&version=<v>[&fork=1] — reference-install (or fork) a fns package from the Marketplace; returns the item HTML. Auth-required."
   :parent :post
   :args {:path "/marketplace/install" :handler :_mka-install-handler}}

  ;; --- apply (theme / keymap): the row's payload becomes the user's pref ---
  {:name :_mka-row
   :parent :package-version-row
   :args {:pkg-name :_mka-name :resolved {:parent :resolve-package-version :args {:pkg-name :_mka-name :spec :_mka-version}}}}
  {:name :_mka-row-kind
   :parent :coalesce
   :args {:value {:parent :get :args {:coll :_mka-row :key {:value :kind} :default nil}} :default {:value "fns"}}}
  {:name :_mka-apply-ok?
   :parent :and
   :args {:values [{:parent :some? :args {:value :_mka-row}}
                   {:parent :not :args {:value {:parent :equal? :args {:a :_mka-row-kind :b {:value "fns"}}}}}]}}
  {:name :_mka-pref-value
   :description "`{:source {:name :version} :payload …}` — the selection the editor applies; the payload is COPIED so a later withdraw of the version leaves the user's editor as it was."
   :parent :zipmap
   :args {:keys [{:value :source} {:value :payload}]
          :vals [{:parent :zipmap :args {:keys [{:value :name} {:value :version}]
