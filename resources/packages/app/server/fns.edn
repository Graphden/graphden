;; App-specific web-server composition.
;;
;; The reusable ring-adapter + handler pipeline lives in `web/ring-adapter`.
;; This module only carries THIS app's routes + router binding + the
;; web-server root node.


{:namespace "app.server"
 :description "Application web-server entry point — this app's routes, router binding, and the `:web-server` root fn-def started by the runtime."
 :fns
 [;; =============================================================================
  ;; MONITORING: Health & Metrics (app-specific)
  ;; =============================================================================

  {:name :_health-json-body
   :parent :to-json-string
   :args {:data :health-status}}

  {:name :_health-handler
   :parent :json-ok-response
   :args {:body :_health-json-body}}

  {:name :_metrics-json-body
   :parent :to-json-string
   :args {:data :jvm-info}}

  {:name :_metrics-handler
   :parent :json-ok-response
   :args {:body :_metrics-json-body}}

  ;; ============================================================================
  ;; VERSION (deploy verification)
  ;; ============================================================================
  ;; `/version` returns the full three-section build-hash map:
  ;;     {"frontend": "<hex>", "backend": "<hex>", "packages": "<hex>"}
  ;; Each is the SHA-256 of one slice of the deploy at build time
  ;; (see build.clj). `bb verify` recomputes the same three hashes
  ;; from the local checkout and reports per-section match/mismatch,
  ;; so a failing deploy can be diagnosed by section rather than as
  ;; one opaque "something didn't match".
  ;;
  ;; The handler just JSON-encodes the already-parsed `:build-hashes`
  ;; map.

  {:name :_version-json-body
   :parent :to-json-string
   :args {:data :build-hashes}}

  {:name :_version-handler
   :parent :json-ok-response
   :args {:body :_version-json-body}}

  ;; Concrete leaf routes live in `app.routes`; route groups
  ;; (`monitoring`, `entity-crud`, `graph-api`, `ui`, `all`) live in
  ;; `app.routes.groups`. This module only owns the auth presets +
  ;; the web-server root chain.

  ;; Auth-required route templates live in `app.routes.auth`.

  ;; =============================================================================
  ;; WEB SERVER
  ;; =============================================================================

  ;; This app's router instance — bound to all-routes.
  {:name :_router
   :description "This app's compiled reitit router — text-error-router bound to all of this app's routes."
   :parent :text-error-router
   :args {:routes :all}}

  ;; Storage-protocol injection (Block 1 Step 3): consumer-layer
  ;; fn-defs in `app/*` and `web/crud` use `:parent :storage-query-call`
  ;; instead of `:parent :pg-query`, which propagates `:storage-query`
  ;; as a free arg up the chain. We satisfy that free arg HERE — on
  ;; the handler-tree root — by binding it to `:pg-query`.
  ;;
  ;; Lives on `:_app-ring-response` (and NOT on `:_branch-routed-handler`
  ;; above) because the per-branch dispatcher
  ;; (`graphden.system.branch-router`) compiles `_app-ring-response`
  ;; directly for each per-branch ExecutionContext, BYPASSING the
  ;; `branch-routing-wrap` layer entirely. A binding on
  ;; `:_branch-routed-handler` would only fire on the (rare)
  ;; no-router fallback path; on every real request the per-branch
  ;; compiled closure for `_app-ring-response` is what runs, and the
  ;; `:storage-query` free arg must already be bound at that point.
  ;;
  ;; Storage backend choice is a handler-concern, not a transport-
  ;; concern: the same handler tree could be mounted on a non-HTTP
  ;; host (CLI, desktop, message queue) and the storage binding would
  ;; travel with it.
  ;;
  ;; Primitive-layer fn-defs (`storage/branches`, `storage/versioned`)
  ;; stay on `:parent :pg-query` directly — they live alongside
  ;; `:pg-query` and going through the protocol from inside the
  ;; storage layer is both circular and (for `:branch-chain`) would
  ;; force per-iteration closure-capture across a `:fix` HOF boundary.
  {:name :_app-ring-response
   :description "Final Ring handler — invokes the router on the parsed request and merges default security headers. Owns the storage-protocol injection point: `:storage-query :pg-query` satisfies the free arg propagated up from every consumer fn-def parented from `:storage-query-call`. Wrapped by `:_branch-routed-handler` before reaching http-kit."
   :parent :router-ring-response
   :args {:func :_router
          :storage-query :pg-query}}

  ;; Branch dispatch wraps the compiled main handler. At runtime, the
  ;; wrap reads `X-Graphden-Branch` / `?branch=` from the request,
  ;; resolves the branch, and routes to a per-branch
  ;; ExecutionContext (lazy-built + cached by
  ;; `graphden.system.branch-router`). Missing branch ref → main.
  {:name :_branch-routed-handler
   :description "`:_app-ring-response` wrapped with per-branch dispatch. Bound to `:http-server.handler` so EVERY request flows through the branch router. The branch dispatcher (`graphden.system.branch-router/dispatch`) also consults the tenancy control-plane router INSIDE its request-scope — see that fn for the route-collection seam."
   :parent :branch-routing-wrap
   :args {:base-handler :_app-ring-response}}

  ;; Per-request handler wrap chain (outer → inner):
  ;;   :_app-cached → :_app-encoded → :_app-realized → :_branch-routed-handler
  ;;
  ;; - cache wrap is OUTERMOST so it can short-circuit the entire
  ;;   chain on hit (no executor work, no encoding, no body slurp)
  ;; - encode-stringify wraps the body realisation + handler so the
  ;;   cache stores fully-processed responses
  ;; - realize-body wraps just the handler — body realisation only
  ;;   needs to happen when we'll actually run the handler

  {:name :_app-realized
   :description "Branch-routed handler with request-body realisation (`:body InputStream` → String)."
   :parent :realize-body-wrap
   :args {:base-handler :_branch-routed-handler}}

  {:name :_app-encoded
   :description "Realized + branch-routed handler with response post-processing: keyword header keys → strings, body encoded (`br` > `gzip` > identity) when compressible."
   :parent :encode-stringify-wrap
   :args {:base-handler :_app-realized}}

  {:name :_app-cached
   :description "Encoded + realized + branch-routed handler with `Cache-Control: immutable` response caching. Cache hit returns the stored response verbatim — no executor work."
   :parent :response-cache-wrap
   :args {:base-handler :_app-encoded}}

  {:name :web-server
   :description "Application root — starts the http-kit server on port 8080 with the full handler wrap chain (cache → encode → realize-body → branch-routed → app)."
   :parent :http-server
   :args {:handler :_app-cached :port 8080}}]}
