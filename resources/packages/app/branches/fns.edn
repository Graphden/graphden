  ;; outer `:cond` already proved `:resolved` non-null via
  ;; `:_delete-branch-missing?`, but the type-checker can't see that
  ;; narrowing across the cond-arm boundary.
  {:name :_delete-branch-id
   :parent :assert-some
   :args {:value {:parent :get :args {:coll {:as :resolved} :key {:value :id} :default nil}}}}

  ;; --- Success path: delete returns nil; success envelope cites the
  ;; resolved branch's id + name. `:do` forces the side-effect before
  ;; building the response shape (its return value — the last step's
  ;; result — IS the response).
  {:name :_delete-branch-apply-deleted
   :parent :delete-branch! :args {:branch-id :_delete-branch-id}}

  {:name :_delete-branch-apply-response
   :parent :zipmap
   :return-type {:ok :bool :id :text :name :nullable-text}
   :args {:keys [{:value :ok} {:value :id} {:value :name}]
          :vals [{:value true}
                 {:parent :to-str :args {:value :_delete-branch-id}}
                 {:parent :get :args {:coll {:as :resolved} :key {:value :name} :default nil}}]}}

  {:name :_delete-branch-apply-success
   :description "Force the delete first (`:do`'s steps evaluate in order), then return the response envelope. Without this the executor could observe the branch row's `:name` BEFORE the delete row-removal landed, surfacing stale state."
   :parent :do
   :args {:steps [:_delete-branch-apply-deleted
                  :_delete-branch-apply-response]}}

  ;; --- Error path: ex-data dispatch.
  {:name :_delete-branch-apply-ex-data
   :parent :ex-data :args {:ex {:as :exception}}}

  {:name :_delete-branch-apply-ex-type
   :parent :get :args {:coll :_delete-branch-apply-ex-data :key {:value :type} :default nil}}

  ;; child-branch-ids stringification (vec of UUIDs → vec of strings).
  {:name :_delete-branch-apply-ex-child-ids
   :parent :get :args {:coll :_delete-branch-apply-ex-data :key {:value :child-branch-ids} :default []}}

  {:name :_delete-branch-apply-ex-child-ids-str-item
   :parent :to-str :args {:value {:as :item}}}

  {:name :_delete-branch-apply-ex-child-ids-str
   :parent :map
   :args {:func :_delete-branch-apply-ex-child-ids-str-item
          :coll :_delete-branch-apply-ex-child-ids}}

  {:name :_delete-branch-err-main
   :parent :const
   :return-type :_error-result-with-reason-shape
   :args {:value {:ok false :reason :root-branch-undeletable
                  :error "Cannot delete the root branch"}}}

  {:name :_delete-branch-err-children
   :parent :zipmap
   :return-type {:ok :bool :reason :keyword :error :text :child-branch-ids [:list :text]}
   :args {:keys [{:value :ok} {:value :reason} {:value :error} {:value :child-branch-ids}]
          :vals [{:value false}
                 {:value :branch-has-children}
