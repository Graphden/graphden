;; String manipulation base functions
;; str, subs, str-len, str-upper, str-lower, str-trim, str-split, str-join,
;; str-to-keyword, keyword-to-str


{:namespace "core.strings"
 :description "String primitives — concat/subs/length/case/trim/split/join, plus keyword↔string conversions."
 :fns
 [{:name :str
   :description "Concatenate a sequence of values into a single string (Clojure's `(apply str parts)`). Each part is stringified."
   :args {:parts {:type [:list :any] :description "Items to stringify and concatenate. Each item may be a literal or a fn-ref."}}
   :return-type :text}

  {:name :subs
   :description "Substring of a string (Clojure's `subs`). End is exclusive; omit it to take to end."
   :args {:string {:type :text :description "Source string."}
          :start {:type :int :description "Inclusive start index."}
          :end {:type :int :required false :description "Exclusive end index. Defaults to string length."}}
   :return-type :text}

  {:name :str-len
   :description "Length of a string in characters (Clojure's `count` on a string). Always non-negative."
   :args {:string {:type :text :description "String to measure."}}
   :return-type :non-negative-int}

  {:name :str-clip
   :description "String truncated to at most `:limit` characters — `(subs s 0 (min (count s) limit))`. The size-cap primitive for storing or forwarding untrusted text; unlike bare `:subs` it never throws on a short input."
   :args {:string {:type :text :description "String to clip."}
          :limit {:type :non-negative-int :description "Maximum length in characters."}}
   :return-type :text}

  {:name :byte-len
   :description "UTF-8 byte length of a string (`String.getBytes(\"UTF-8\").length`). Distinct from :str-len — use for byte-sized budgets (e.g. jsonb payload caps), which :str-len (UTF-16 code units) under-counts for non-ASCII text."
   :args {:string {:type :text :description "String to measure."}}
   :return-type :non-negative-int}

  {:name :str-upper
   :description "Upper-case a string (Java `String.toUpperCase`)."
   :args {:string {:type :text :description "String to upper-case."}}
   :return-type :text}

  {:name :str-lower
   :description "Lower-case a string (Java `String.toLowerCase`)."
   :args {:string {:type :text :description "String to lower-case."}}
   :return-type :text}

  {:name :str-trim
   :description "Trim leading and trailing whitespace (Clojure's `clojure.string/trim`)."
   :args {:string {:type :text :description "String to trim."}}
   :return-type :text}

  {:name :str-split
   :description "Split a string by separator (Clojure's `(str/split s (re-pattern separator) limit)`). Separator is a regex. Optional `:limit` caps the number of parts — handy for `key=value=more` style parsing where you want exactly 2 parts even if the value contains the separator."
   :args {:string {:type :text :description "String to split."}
          :separator {:type :text :description "Regex pattern that delimits parts."}
          :limit {:type :nullable-int
                  :required false
                  :description "Maximum number of parts. Non-positive / nil → no limit (default)."}}
   :return-type [:list :text]}

  {:name :str-join
   :description "Join a collection of strings into one (Clojure's `clojure.string/join`)."
   :args {:coll {:type [:list :any] :description "Collection of items to stringify and concatenate (each `str`'d before joining)."}
          :separator {:type :text :value "" :description "Inserted between every pair. Defaults to empty."}}
   :return-type :text}

  {:name :str-to-keyword
   :description "Coerce a string into a keyword (Clojure's `keyword`). Nil-safe — returns nil for nil input."
   :args {:string {:type :nullable-text :description "String to convert (nil-safe)."}}
   :return-type :nullable-keyword}

  {:name :keyword-to-str
   :description "Coerce a keyword into a string without the leading colon (Clojure's `name`)."
   :args {:keyword {:type :keyword :description "Keyword to convert."}}
   :return-type :text}

  {:name :pr-str
   :description "Print-readable string form of a value (Clojure's `pr-str`). Strings are quoted, keywords prefixed."
   :args {:value {:type a :description "Value to print."}}
   :return-type :text}

  {:name :pprint-str
   :description "Pretty-printed, readable string form of a value (`clojure.pprint/pprint`) — multi-line EDN a human or an AI reads comfortably; `:pr-str` is the one-line form."
   :args {:value {:type a :description "Value to print."}}
   :return-type :text}

  {:name :to-str
   :description "Plain string form of a value (Clojure's `str`). No quoting; nil renders as empty string."
   :args {:value {:type a :description "Value to stringify."}}
   :return-type :text}

  {:name :name
   :description "Clojure's `(name x)` — strip the leading `:` from a keyword, return a string as-is. Differs from `:to-str` on keywords: `(name :foo)` returns `\"foo\"`, `(to-str :foo)` returns `\":foo\"`. Use at boundaries that expect bare identifier text (entity-type slot names, SQL identifiers, …)."
   :args {:value {:type a :description "Keyword, string, or nil."}}
   :return-type :nullable-text}

  ;; ----------------------------------------------------------------
  ;; :parse-query-string is now a pure graph composition over
  ;; `:blank?` / `:str-split` (with the new `:limit` overload) /
  ;; `:url-decode` / `:map` / `:into` / `:get` / `:vec`. The shape
  ;; matches the previous impl's: blank input → nil, otherwise split
  ;; on `&`, then on `=` with limit 2 so a value containing `=` keeps
  ;; its trailing parts, URL-decode each value, fold into a map.
  ;; ----------------------------------------------------------------
  {:name :_qs-pairs-split
   :description "Stage 1 — split the raw query string on `&`. Each element of the result is a `k=v` pair string."
   :parent :str-split
   :args {:string {:as :string}
          :separator {:value "&"}}}

  {:name :_qs-pair-split
   :description "HOF helper — split a single `k=v` pair on `=` with limit 2 so a value that itself contains `=` keeps its trailing parts intact. Bound to the HOF `:item` from `:_qs-pairs-decoded`."
   :parent :str-split
   :args {:string {:as :item}
          :separator {:value "="}
          :limit {:value 2}}}

  {:name :_qs-pair-k
   :parent :get
   :args {:coll :_qs-pair-split
          :key {:value 0}
          :default nil}}

  {:name :_qs-pair-k-decoded
   :description "URL-decode the key. RFC 3986 form-urlencoded bodies allow `%`-escapes in keys too — most browsers' `URLSearchParams` percent-encodes any keyword-unsafe char (e.g. `?` → `%3F`), so a server-side parser that leaves keys raw misroutes `enabled?` to a bucket nothing reads. Without this decode, the `:service` create form's `enabled?=true` field never reaches the form-data parser."
   :parent :url-decode
   :args {:string :_qs-pair-k}}

  {:name :_qs-pair-v
   :parent :get
   :args {:coll :_qs-pair-split
          :key {:value 1}
          :default {:value ""}}}

  {:name :_qs-pair-v-decoded
   :parent :url-decode
   :args {:string :_qs-pair-v}}

  {:name :_qs-decode-pair
   :description "HOF callback per pair — return `[url-decode(k) url-decode(v|\"\")]` as a 2-vec so `:into {}` can fold it into the map."
   :parent :vec
   :args {:coll [:_qs-pair-k-decoded :_qs-pair-v-decoded]}}

  {:name :_qs-pairs-decoded
   :description "Map the per-pair decoder over every `k=v` split out of the raw string."
   :parent :map
   :args {:func :_qs-decode-pair
          :coll :_qs-pairs-split}}

  {:name :_qs-pairs-as-map
   :description "Fold the decoded `[k v]` pairs into `{k v}`. Repeated keys collapse to last (Clojure `:into` over `{}`)."
   :parent :into
   :args {:to {:value {}}
          :from :_qs-pairs-decoded}}

  {:name :parse-query-string
   :description "Parse an HTTP query string into a `{key value}` map. Splits on `&` then on `=` (limit 2 so values containing `=` are preserved), URL-decodes each value. Blank / empty input → nil. Repeated keys collapse to last. Pure graph composition; admins can swap the separator / decoding rule without writing Clojure. Owns its `:string` free pin explicitly — value flows down to the inner blank? / split chain by name match."
   :parent :if
   :args {:test {:parent :blank? :args {:string {:as :string}}}
          :then {:value nil}
          :else :_qs-pairs-as-map
          :string {:type :text
                   :description "Raw HTTP query string (e.g. `\"a=1&b=2\"`)."}}}

  {:name :blank?
   :description "True iff the string is nil, empty, or contains only whitespace (Clojure's `clojure.string/blank?`)."
   :args {:string {:type :nullable-text :required false :description "String to test (nil-safe)."}}
   :return-type :bool}

  {:name :non-blank?
   :description "True iff the string is non-blank. Required-slot 1-arg companion to `:blank?` — graphden's HOF wrap treats `:required false` slots as 0-lambda-param (variadic-ignore), which would make `(filter :blank? coll)` keep every element instead of filtering. Use this when you need a blank-check as a `:filter` / `:some` predicate."
   :args {:string {:type :text :description "String to test."}}
   :return-type :bool}

  {:name :url-decode
   :description "Decode a URL-encoded string (`%20` → space, etc.). UTF-8."
   :args {:string {:type :text :description "Encoded string."}}
   :return-type :text}

  {:name :str-contains?
   :description "True iff `string` contains `substring` (Clojure's `clojure.string/includes?`). Nil-safe — returns false for nil `string`, so callers needn't pre-guard."
   :args {:string {:type :nullable-text :description "String to search (nil → returns false)."}
          :substring {:type :text :description "Substring to find."}}
   :return-type :bool}

  {:name :str-starts-with?
   :description "True iff `string` starts with `prefix` (Java `String.startsWith`). Nil-safe — returns false for nil input. `:string` accepts the nullable form so callers needn't pre-guard."
   :args {:string {:type :nullable-text :description "String to test (nil → returns false)."}
          :prefix {:type :text :description "Required leading substring."}}
   :return-type :bool}

  {:name :str-replace
   :description "Replace every occurrence of `:match` with `:replacement` in `:string` (Clojure's `clojure.string/replace`). All three args are plain strings — no regex. Nil `:string` flows through unchanged."
   :args {:string {:type :nullable-text :description "Source string (nil → returns nil)."}
          :match {:type :text :description "Literal substring to find."}
          :replacement {:type :text :description "Replacement string."}}
   :return-type :nullable-text}

  {:name :re-find?
   :description "True iff `:pattern` (a regex) matches somewhere inside `:string`. Returns false for nil / non-string input. General regex-match primitive — compose it into a `:_refinement-narrow` `:test` to build an `:ensure-*` narrower for a `:matches`-constrained refinement."
   :args {:string {:type :any :required false :description "String to search. Non-string / nil → false."}
          :pattern {:type :text :description "Regex pattern (Java syntax)."}}
   :return-type :bool}

  {:name :re-replace
   :description "Replace every match of the regex `:pattern` in `:string` with `:replacement` (`clojure.string/replace` over a compiled pattern — the regex sibling of the literal-only `:str-replace`; same safe-compile caps as `:re-find?`). Nil `:string` flows through unchanged. `$1`-style group refs work in `:replacement`."
   :args {:string {:type :nullable-text :description "Source string (nil → returns nil)."}
          :pattern {:type :text :description "Regex pattern (Java syntax)."}
          :replacement {:type :text :description "Replacement string (`$1` group refs supported)."}}
   :return-type :nullable-text}]}
