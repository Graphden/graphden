   :parent :equal?
   :args {:a {:parent :get :args {:coll {:as :item} :key {:value :fn-id} :default nil}}
          :b {:parent :get :args {:coll {:as :parsed} :key {:value :fn-id} :default nil}}}}

  {:name :_inline-bind-existing-slot-id-eq?
   :parent :equal?
   :args {:a {:parent :get :args {:coll {:as :item} :key {:value :slot-id} :default nil}}
          :b {:parent :get :args {:coll {:as :parsed} :key {:value :slot-id} :default nil}}}}

  {:name :_inline-bind-exists?
   :description "Guard #6 — a binding already exists for this fn+slot."
   :parent :some?
   :args {:value {:as :existing}}}

  {:name :_inline-bind-err-fn-id-missing
   :parent :const
   :return-type :_error-result-shape
   :args {:value {:ok false :error "Required field ':fn-id' is missing or malformed"}}}

  {:name :_inline-bind-err-slot-id-missing
   :parent :const
   :return-type :_error-result-shape
   :args {:value {:ok false :error "Required field ':slot-id' is missing or malformed"}}}

  {:name :_inline-bind-err-target-missing
   :description "Dynamic error — cites the parsed fn-id. `:return-type` pinned so the parent cond stays a union of precise record shapes for downstream narrowing."
   :parent :zipmap
   :return-type :_error-result-shape
   :args {:keys [:ok :error]
          :vals [false
                 {:parent :str
                  :args {:parts ["fn not found: "
                                 {:parent :get
                                  :args {:coll {:as :parsed}
                                         :key {:value :fn-id}
                                         :default nil}}]}}]}}

  {:name :_inline-bind-err-binding-exists
   :parent :const
   :return-type :_error-result-with-reason-shape
   :args {:value {:ok false :error "A binding already exists for this fn+slot — delete it first" :reason :binding-exists}}}

  ;; Phase 4.5 decomposition: `:try` + shared `:atom` journal pattern.
  ;; Body writes vault then storage; rollback replays journal in
  ;; reverse via the shared `:_apply-secret-rollback` defbase.
  {:name :_apply-inline-bind-body
   :description "Body of inline-bind `:try`: vault-put + storage create + journal record. Throws on storage/vault failure."
   :args {:parsed {:type {:fn-id :nullable-uuid
                          :slot-id :nullable-uuid
                          :path :nullable-text
                          :value [:union :null [:secret :text]]}}
          :journal {:type :any :description "Shared rollback-journal atom."}}
