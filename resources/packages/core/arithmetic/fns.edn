;; Arithmetic and comparison base functions
;; All functions require implementations in impls.clj


{:namespace "core.arithmetic"
 :description "Arithmetic and comparison primitives over numbers."
 :fns
 [;; === Arithmetic ===
  {:name :add
   :description "Sum a vector of numbers."
   :args {:nums {:type :sequence :of :any :description "Vector of numbers to add."}}
   :return-type :numeric}

  {:name :sub
   :description "Subtract — first number minus the rest. `[10 3 2]` → 5."
   :args {:nums {:type :sequence :of :any :description "Vector of numbers; first is the minuend."}}
   :return-type :numeric}

  {:name :mul
   :description "Multiply a vector of numbers."
   :args {:nums {:type :sequence :of :any :description "Vector of numbers to multiply."}}
   :return-type :numeric}

  {:name :div
   :description "Divide — first number by the product of the rest. Throws on zero divisor."
   :args {:nums {:type :sequence :of :any :description "Vector of numbers; first is the dividend."}}
   :return-type :numeric}

  {:name :mod
   :description "Remainder of `dividend / divisor` (Clojure's `mod`, follows divisor sign)."
   :args {:dividend {:type :numeric :description "Number being divided."}
          :divisor {:type :numeric :description "Non-zero divisor."}}
   :return-type :numeric}

  {:name :neg
   :description "Negate a number."
   :args {:number {:type :numeric :description "Number to negate."}}
   :return-type :numeric}

  {:name :abs
   :description "Absolute value."
   :args {:number {:type :numeric :description "Number whose absolute value to return."}}
   :return-type :numeric}

  ;; === Comparison ===
  {:name :eq
   :description "Test all values for equality (Clojure's `=`)."
   :args {:values {:type :sequence :of :any :description "Vector of values; all must be equal."}}
   :return-type :bool}

  {:name :neq
   :description "True iff at least one pair differs."
   :args {:values {:type :sequence :of :any :description "Vector of values; comparison is pairwise."}}
   :return-type :bool}

  {:name :lt
   :description "Strictly increasing — `nums[0] < nums[1] < …`."
   :args {:nums {:type :sequence :of :any :description "Vector of numbers in expected order."}}
   :return-type :bool}

  {:name :lte
   :description "Non-decreasing — `nums[0] <= nums[1] <= …`."
   :args {:nums {:type :sequence :of :any :description "Vector of numbers in expected order."}}
   :return-type :bool}

  {:name :gt
   :description "Strictly decreasing — `nums[0] > nums[1] > …`."
   :args {:nums {:type :sequence :of :any :description "Vector of numbers in expected order."}}
   :return-type :bool}

  {:name :gte
   :description "Non-increasing — `nums[0] >= nums[1] >= …`."
   :args {:nums {:type :sequence :of :any :description "Vector of numbers in expected order."}}
   :return-type :bool}]}
