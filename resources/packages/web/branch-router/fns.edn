;; Branch-aware Ring middleware.
;;
;; `:branch-routing-wrap` takes a `:fn`-typed `:base-handler` and
;; returns a Ring callable that dispatches per branch — header
;; `X-Graphden-Branch: <name>` or query `?branch=<name>` picks the
;; per-branch ExecutionContext, builds a fresh compiled registry on
;; first hit (cached), and runs the SAME compiled handler (here,
;; `:_app-ring-response`) against that branch's storage view.
;;
;; The wrap is now a pure graph composition over three primitives:
;;
;;   :current-branch-router   — read the installed router (nil → none)
;;   :dispatch-to-branch      — invoke (br/dispatch router request)
;;   :call (core/system)      — invoke (base-handler request) for the
;;                              no-router / single-branch fallback path
;;
;; Admin extension surface — every dispatch decision is one fn-def the
;; admin can replace without writing Clojure:
;;   * `:_branch-router-installed?` chooses dispatch-vs-fallback. Swap
;;     for an A/B-test predicate (`:if :ab-test-flag :then dispatch
;;     :else fallback`), a header-based opt-in, or a per-tenant guard.
;;   * `:_branch-dispatched` decides how to route. Replace
;;     `:dispatch-to-branch` with a tenant-aware router, a chaos-
;;     monkey, or a logger that wraps the dispatch result.
;;   * `:_base-handler-fallback` chooses what to do when no router
;;     is installed. Replace with a 503 builder, a retry, etc.


{:namespace "web.branch-router"
 :description "Branch-aware Ring middleware — a graph fn-def chain over three router-state primitives."
 :fns
 [;; Three §3.1 boundary primitives over graphden.system.branch-router.
  {:name :current-branch-router
   :description "Read the currently-installed branch router (`@active-router`). Nil when no router has been installed yet — test paths, or the brief window before `:exec/branch-router` fires."
   :args {}
   :return-type :any
   :effects #{}}

  {:name :dispatch-to-branch
   :description "Delegate a Ring request to the appropriate per-branch handler resolved by `:router`. Reads `X-Graphden-Branch` / `?branch=` off the request, builds (or reuses) the per-branch ExecutionContext, and runs the compiled handler against it."
   :args {:router {:type :any :description "BranchRouter instance from `:current-branch-router`."}
          :request {:type :ring-request-shape}}
   :return-type :ring-response-shape
   :effects #{:network}}

  ;; Three intermediate graph fn-defs — each one is its own extension
  ;; point as described in the namespace comment.
  {:name :_branch-router-installed?
   :description "True iff a router has been installed. The handler-vs-fallback gate."
   :parent :some?
   :args {:value :current-branch-router}}

  {:name :_branch-dispatched
   :description "Branch-routed path — delegate to the installed router."
   :parent :dispatch-to-branch
   :args {:router :current-branch-router
          :request {:as :request}}}

  {:name :_base-handler-fallback
   :description "Single-branch fallback — call the base-handler directly with the current Ring request."
   :parent :call
   :args {:func {:as :base-handler}
          :arg {:as :request}}}

  ;; The composed Ring middleware itself.
  {:name :branch-routing-wrap
   :description "Per-request branch dispatcher. Gated by `:_branch-router-installed?`: on `:then` delegates to `:_branch-dispatched`, on `:else` falls back to the base-handler via `:_base-handler-fallback`. `:base-handler` is an own free pin; `:request` propagates from the rename chain inside the branches and is consumed by `:http-server`."
   :parent :if
   :args {:test :_branch-router-installed?
          :then :_branch-dispatched
          :else :_base-handler-fallback
          :base-handler {:type [:fn {} :ring-response-shape]
                         :description "Single-branch Ring fallback handler — invoked when no branch router is installed. Consumers (e.g. `:_branch-routed-handler`) bind this to their full app-level Ring handler."}}}]}
