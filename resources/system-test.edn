;; Test system configuration
;; Minimal config - jdbc-url is injected from testcontainer at runtime
;;
;; NOTE: Test credentials are overridden by test fixtures.
;; These defaults are only used if fixtures don't provide values.

{:db/schema {}

 :db/postgres
 {:jdbc-url nil  ; Will be overridden by test fixture
  :username #or [#env GRAPHDEN_TEST_DB_USER "test"]
  :password #or [#env GRAPHDEN_TEST_DB_PASSWORD "test"]
  :pool-size 2
  :schema #ig/ref :db/schema}

 :db/versioned
 {:base-storage #ig/ref :db/postgres}

 :exec/base-fns
 {:storage #ig/ref :db/versioned}

 :exec/context
 {:storage #ig/ref :db/versioned}}
