{
  // markdownlint-cli2 config — see https://github.com/DavidAnson/markdownlint-cli2.
  //
  // Every disabled rule below has a one-line `// why:` immediately
  // preceding it; no rule silenced just to make the linter quiet. A
  // rule whose violations were all fixed is REMOVED from here, not kept
  // "for safety" — the 2026-09-02 sweep dropped MD001/003/010/012/014/
  // 025/026/040/041/045/046/059 that way.

  "globs": [
    "**/*.md"
  ],

  "ignores": [
    "node_modules/**",
    "**/node_modules/**",
    "target/**",
    ".playwright-mcp/**",
    "tools/visual-tests/tests/editor.spec.js-snapshots/**",
    // Playwright test-run artefacts — auto-generated, gitignored;
    // markdownlint-cli2 doesn't honor .gitignore on its own.
    "tools/visual-tests/playwright-report/**",
    "tools/visual-tests/test-results/**",
    ".git/**",
    ".tools/**"
  ],

  "config": {
    "default": true,

    // why: line-length 80 forces unnatural breaks in URLs / code-spans.
    // The repo's prose wraps at author discretion; render is what matters.
    "MD013": false,

    // why: pipe-table column-style `aligned` requires re-padding every
    // row on edit. `consistent` lets a file pick its style on first
    // table; both render identically.
    "MD060": { "style": "consistent" },

    // note: every doc now opens with an h1 (MD041 is on). The one legitimate exception —
    // .github/PULL_REQUEST_TEMPLATE.md, a PR-body fragment whose top level
    // is `##` under GitHub's own PR title — carries an inline
    // `markdownlint-disable-next-line MD041` with its reason.

    // why: bare URLs (`https://...`) inline in prose are clearer than
    // angle-wrapped; GitHub-flavoured markdown auto-links them.
    "MD034": false,

    // why: `**Note:**` opens a paragraph in many docs; reads better
    // than promoting it to a sub-heading.
    "MD036": false,

    // why: CHANGELOG-style files + tutorial recap sections legitimately
    // reuse the same heading. siblings_only disallows confusion
    // without blocking legitimate reuse.
    "MD024": { "siblings_only": true },

    // why: `<sub>` / `<sup>` / `<details>` etc. are legitimate in
    // markdown that renders to HTML. Skill docs + arch notes use them.
    "MD033": false
  }
}
