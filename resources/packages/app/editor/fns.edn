  {:name :graphden-runtime-script-tag
   :description "`<script src=\"/assets/graphden-runtime.js?v=<hash>\">` — loads the graphden runtime bundle (dispatcher + built-in `submit-form` / `navigate` / `custom` handlers, see `web/runtime/graphden-runtime.js` + `graphden-actions-builtin.js`). Hash-busted so the immutable browser cache is invalidated on every deploy."
   :parent :hiccup
   :return-type :script-tag
   :args {:tag {:value "script"}
          :attrs {:parent :assoc
                  :args {:map {:value {}}
                         :key {:value :src}
                         :value :_graphden-runtime-js-url}}
          :children {:value []}}}

  {:name :graphden-bootstrap-script
   :description "Inline `<script>` calling `bindActionDispatch(document.body)` on DOMContentLoaded — required once per page so the runtime starts routing `data-action` clicks."
   :parent :hiccup
   :return-type :script-tag
   :args {:tag {:value "script"}
          :attrs {:value {}}
          :children {:value ["document.addEventListener('DOMContentLoaded', function () { bindActionDispatch(document.body); });"]}}}

  {:name :graphden-runtime-scripts
   :description "Drop-in `:scripts` list — runtime bundle then dispatcher bootstrap. Bind to `:html-page-route` / `:html-page-handler` / `:html-page` `:scripts` slot when the page has buttons / forms wired through `:dispatch-action` / `:dispatch-custom`."
   :parent :list
   :args {:items [:graphden-runtime-script-tag
                  :graphden-bootstrap-script]}}

  ;; Default <link> tag for the components stylesheet. Pages bind
  ;; this into the `:head` slot of `:html-page-route` (typically via
  ;; the `:graphden-page-head` bundle) so the web.components
  ;; primitives get their default styling automatically.

  {:name :graphden-components-stylesheet-tag
   :description "`<link rel=\"stylesheet\" href=\"/assets/graphden-components.css?v=<hash>\">` — default stylesheet for web.components. Include via `:graphden-page-head` (or directly in a page's `:head` list). Hash-busted to invalidate the immutable browser cache on each deploy."
   :parent :hiccup
   :args {:tag {:value "link"}
          :attrs {:parent :assoc
                  :args {:map {:value {:rel "stylesheet"}}
                         :key {:value :href}
                         :value :_graphden-components-css-url}}
          :children {:value []}}}

  {:name :graphden-page-head
   :description "Drop-in `:head` list — currently the components stylesheet `<link>`. Bind to the `:head` slot of `:html-page-route` / `:html-page-handler` / `:html-page` so pages get sensible default styling without inline `:style` attrs."
   :parent :list
   :args {:items [:graphden-components-stylesheet-tag]}}

  {:name :_editor-css-handler
   :lambda-params []
   :description "Ring handler for `GET /assets/editor.css` — returns the editor stylesheet as `text/css` with `Cache-Control: public, max-age=31536000, immutable`."
   :parent :immutable-css-ok-response
   :args {:body :styles}}

  ;; Components stylesheet — default look for the web.components
  ;; primitives (button, input, form, …) so pages built from them
  ;; don't look like raw browser-default elements. Loaded via
  ;; `:graphden-components-stylesheet-tag` from `:graphden-page-head`.

  ;; One-item bundle for the same reason as `:styles` — see the note there.
  {:name :_graphden-components-css
   :description "Default stylesheet for web.components primitives — read from `packages/app/editor/components.css` through the override tier (despite the path the styles target component tags, not the editor canvas)."
   :parent :concat-resources-overridable
   :return-type :text
   :args {:paths :_components-css-paths}}

  {:name :_graphden-components-css-handler
   :lambda-params []
   :description "Ring handler for `GET /assets/graphden-components.css` — returns the components stylesheet with a 1-year `immutable` Cache-Control. Hash-bust via `?v=` on the inbound `<link href>`."
   :parent :immutable-css-ok-response
   :args {:body :_graphden-components-css}}

