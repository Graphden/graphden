   :parent :hiccup
   :args {:tag {:value "tr"}
          :children [{:parent :_mkx-cell :args {:key {:value :name}}}
                     {:parent :_mkx-cell :args {:key {:value :version}}}
                     {:parent :_mkx-cell :args {:key {:value :kind}}}
                     {:parent :_mkx-cell :args {:key {:value :origin}}}
                     {:parent :_mkx-cell :args {:key {:value :base-fn-count}}}
                     {:parent :_mkx-cell :args {:key {:value :description}}}]}}
  {:name :_mkx-table
   :parent :hiccup
   :args {:tag {:value "table"}
          :attrs {:value {:class "packages-panel-table mk-roster"}}
          :children [{:parent :hiccup :args {:tag {:value "thead"}
                                             :children [{:parent :hiccup :args {:tag {:value "tr"}
                                                                                :children [{:parent :hiccup :args {:tag {:value "th"} :children [{:value "Package"}]}}
                                                                                           {:parent :hiccup :args {:tag {:value "th"} :children [{:value "Version"}]}}
                                                                                           {:parent :hiccup :args {:tag {:value "th"} :children [{:value "Kind"}]}}
                                                                                           {:parent :hiccup :args {:tag {:value "th"} :children [{:value "Origin"}]}}
                                                                                           {:parent :hiccup :args {:tag {:value "th"} :children [{:value "Base-fns"}]}}
                                                                                           {:parent :hiccup :args {:tag {:value "th"} :children [{:value "Description"}]}}]}}]}}
                     {:parent :hiccup :args {:tag {:value "tbody"} :children {:parent :map :args {:func :_mkx-row :coll :loaded-packages}}}}]}}
  {:name :_mkx-note
   :parent :hiccup
   :args {:tag {:value "p"}
          :attrs {:value {:class "mk-note"}}
          :children [{:value "The packages this executor loaded at boot. An impl+fns package ships Clojure base-fns, so it enters through the build, not the registry: a self-hosted operator lists it in executor-packages.edn (git / Maven coord) and rebuilds; on the shared cloud the platform ships the set. Everything published from a namespace, a theme or a keymap is a fns-only artifact and lives in the other tabs."}]}}
  {:name :_mk-executor-tab
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "mk-executor"}} :children [:_mkx-note :_mkx-table]}}

  {:name :_mk-body
   :parent :if
   :args {:test {:parent :equal? :args {:a :_mkq-kind :b {:value "executor"}}}
          :then :_mk-executor-tab
          :else :_mk-results}}

  {:name :marketplace-root
