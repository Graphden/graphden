;; Tagged-variant accessors and predicate.
;;
;; Variants in graphden are union-of-records sugar (declared via the
;; `:variant {:tag T …}` fn-def shape). At runtime
;; they're plain maps `{:tag :ok :value v}`; this module gives the
;; ergonomic way to inspect them without typing `(:get coll :key …)`
;; over and over.
;;
;; Discrimination still flows through the existing `:cond` /
;; `:if` — no new dispatcher base-fn — so authors compose:
;;
;;     {:parent :cond
;;      :args {:pairs [(:variant-is? :coll my-result :tag :ok)
;;                     (:variant-value :coll my-result)
;;                     :else
;;                     (:variant-value :coll my-result)]}}
;;
;; All three fn-defs are pure compositions over `:get` / `:equal?` —
;; no new Clojure impl needed.


{:namespace "core.variants"
 :description "Accessors + predicate for tagged variants — sugar over (:get :coll v :key :tag) / (:get :coll v :key :value) and the equality test."
 :fns
 [{:name :variant-tag
   :description "Read the `:tag` keyword of a tagged variant (a map with `{:tag :keyword :value …}`). Sugar for `(:get coll v :key :tag)`. Keyword key — JSONB-roundtripped variants come back with keyword keys (cheshire/keywordize? + the codec's `normalize-parsed-json` step), so a string `\"tag\"` would miss."
   :parent :get
   :args {:key {:value :tag :type :keyword}}}

  {:name :variant-value
   :description "Read the `:value` payload of a tagged variant. Sugar for `(:get coll v :key :value)`. Same keyword-key rationale as `:variant-tag`."
   :parent :get
   :args {:key {:value :value :type :keyword}}}

  {:name :variant-is?
   :description "True iff the variant's `:tag` equals the supplied `:tag` arg. The variant flows in via `:coll` (free, propagated from `:variant-tag`); `:tag` (renamed from `:b`) carries the keyword to compare against. Use to discriminate branches in a `:cond` over a variant-typed value."
   :parent :equal?
   :args {:a :variant-tag
          :b {:as :tag}}}

  ;; ============================================================================
  ;; Bind / and-then — the missing composer for chaining fallible
  ;; operations across a variant-typed pipeline.
  ;;
  ;; Without this, callers had to manually re-write the
  ;; `(:cond [(:variant-is? v :ok) (next-step (:variant-value v))
  ;;          true v])`
  ;; pattern at every step. `:variant-then` IS that pattern, with
  ;; `:v` and `:f` lifted to free args so it composes uniformly:
  ;;
  ;;   (-> some-ok-or-err
  ;;       (:variant-then :f :step-1)
  ;;       (:variant-then :f :step-2))
  ;;
  ;; Semantics: when v carries `{:tag :ok}`, returns
  ;; `{:tag :ok :value (call f (variant-value v))}`. When v carries
  ;; any other tag (typically `:err`), returns v unchanged — error
  ;; payload short-circuits to the end of the chain. Analogous to
  ;; Haskell's `>>=` / Rust's `?` / Clojure cats's `mlet` for
  ;; Result-shaped values.
  ;; ============================================================================

  {:name :variant-then
   :description "Chain a step over a tagged variant: when v is `{:tag :ok}`, replace its `:value` with `(f current-value)` (still tagged :ok). When v is anything else (typically `:err`), pass v through unchanged. Use to compose fallible operations without unwrapping at every step. Free args propagate up: `:v` (the variant) and `:f` (the callable)."
   :parent :cond
   :args {:clauses [:_variant-then-ok-pair :_variant-then-passthrough-pair]}}

  ;; --- :ok pair: predicate + result for the success branch ---

  {:name :_variant-then-ok-pair
   :parent :list
   :args {:items [:_variant-then-is-ok :_variant-then-mapped]}}

  {:name :_variant-then-is-ok
   :parent :variant-is?
   :args {:coll {:as :v}
          :tag {:value :ok :literal? true}}}

  {:name :_variant-then-mapped
   :description "Build the new :ok variant — keep v's :tag (which IS :ok by the matching predicate above) and replace :value with `(call f current-value)`."
   :parent :assoc
   :args {:map {:as :v}
          :key {:value :value :literal? true}
          :value :_variant-then-applied}}

  {:name :_variant-then-applied
   :parent :call
   :args {:func {:as :f}
          :arg :_variant-then-extracted}}

  {:name :_variant-then-extracted
   :parent :variant-value
   :args {:coll {:as :v}}}

  ;; --- catch-all pair: any other tag → pass v through ---

  {:name :_variant-then-passthrough-pair
   :parent :list
   :args {:items [{:value true :literal? true}
                  :_variant-then-passthrough]}}

  {:name :_variant-then-passthrough
   :parent :identity
   :args {:value {:as :v}}}]}
