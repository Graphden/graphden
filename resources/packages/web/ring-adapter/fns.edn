;; Reusable Ring-request handler pipeline.
;;
;; Produces the `:router-ring-response` building block — the handler
;; bound to `:http-server.handler`. Pipeline:
;;
;;   1. Receives a raw Ring request (single leftover free arg `:request`
;;      via `hof-wrap`'s single-arg callable).
;;   2. Extracts common fields (method/uri/query-string/headers/body)
;;      into an internal map via `:pairs->map` — `:internal-request`.
;;   3. Invokes a router (free arg `:func`) on that internal request
;;      → `:router-result` is a Ring response map.
;;   4. Adds default security headers on top of the router's headers
;;      (`(update response :headers #(merge defaults %))`). Status and
;;      body pass through untouched.
;;
;; Consumers supply the concrete router via `:func` (bound on a child of
;; `:router-ring-response`) and pass that child directly to
;; `:http-server.handler` (`:fn`-typed; the compile-time hof-wrap turns
;; the fn-graph into a single-arg Ring callable).
;;
;; Auth is expressed per-route via reitit middleware (see
;; `:auth-required-middleware` below) — no pre-router path-gating layer.


{:namespace "web.ring-adapter"
 :description "Ring request → router → response pipeline, plus bearer-token auth middleware. The `:router-ring-response` fn-def is the canonical shape bound to `:http-server.handler`."
 :fns
 [;; =============================================================================
  ;; STRUCTURAL TYPE — Ring request shape
  ;; =============================================================================
  ;; The matching `:ring-response-shape` is declared in core/system
  ;; (alongside `:ring-response`, the assoc-chain that builds it).
  ;; Together they let `:http-server.handler` be typed as the fn-type
  ;; `[:fn {:request :ring-request-shape} :ring-response-shape]`
  ;; instead of bare `:fn`, so `:add` (arithmetic) gets rejected at
  ;; sync-time rather than crashing at runtime.

  {:name :ring-request-shape
   :description "Structural shape of an inbound Ring HTTP request map."
   ;; `:headers` is `:text-map` (lowercased string keys / string
   ;; values, per http-kit). `:body` is the canonical Ring body union —
   ;; nil for missing, raw `:input-stream` straight from http-kit,
   ;; pre-slurped `:text` for middlewares that stringify, parsed `:jsonb`
   ;; for middlewares that decode JSON eagerly. Downstream extractors
   ;; (`:ring-body-input-stream`, `:slurp`, `:parse-json-body`) consume
   ;; one branch of the union per call site.
   :type {:request-method :keyword
          :uri            :text
          :query-string   :text
          :headers        :text-map
          :body           [:union :null :input-stream :text :jsonb]}}

  {:name :security-headers-shape
   :description "Default security response headers — `X-Content-Type-Options`, `X-Frame-Options`, `X-XSS-Protection`, `Referrer-Policy`. Keyword-keyed throughout the fn-graph (record-types in graphden are keyword-keyed); the `:http-server` adapter stringifies header keys once on the way to http-kit."
   :type {:X-Content-Type-Options :text
          :X-Frame-Options        :text
          :X-XSS-Protection       :text
          :Referrer-Policy        :text}}

  ;; =============================================================================
  ;; RING REQUEST EXTRACTION
  ;; =============================================================================

  ;; Single holder for the Ring request. All field extractors reference
  ;; this one fn so the same request value flows into each `get`. The
  ;; rename `value/as :request` exposes `:value` as the free arg
  ;; `:request`. Ring HOFs that pass ONE request (`:http-server`,
  ;; per-route handlers via `:assoc-fn`) hand the callable a raw request
  ;; — single-leftover wrap routes it under `:request`. Middleware (which
  ;; also needs to inject `:next-handler`) uses the map-callable wrap and
  ;; supplies both keys; this fn still picks `:request` out of the
  ;; resulting free-args map.
  {:name :ring-request
   :description "Single holder for the inbound Ring request — identity rename that exposes `:value` as the free arg `:request`. All field extractors below source from this one fn so each request flows through it once."
   :parent :identity
   :args {:value {:as :request :type :ring-request-shape}}}

  ;; Shared `:coll :ring-request` lookup — factor out the common binding so
  ;; each field extractor below just names the key it wants. Pinning
  ;; `:coll :ring-request-shape` propagates down through every extractor
  ;; so the editor's `m`/`coll` chip shows the concrete shape instead of
  ;; `:get`'s inherited `:any` contract.
  {:name :ring-request-field
   :description "Helper that binds `:coll :ring-request` once. Children name the field they want via `:key` instead of repeating the request binding."
   :parent :get
   :args {:coll {:ref :ring-request :type :ring-request-shape}}}

  {:name :ring-method
   :description "HTTP method keyword from the Ring request (e.g. `:get`, `:post`)."
   :parent :ring-request-field
   :return-type :keyword
   :args {:key {:value :request-method}}}

  {:name :ring-uri
   :description "Path portion of the request URI (e.g. `\"/api/entities\"`)."
   :parent :ring-request-field
   :return-type :text
   :args {:key {:value :uri}}}

  {:name :ring-query-string
   :description "Raw query string from the request (without leading `?`), nil if absent."
   :parent :ring-request-field
   :return-type :text
   :args {:key {:value :query-string}}}

  {:name :ring-headers
   :description "Header map from the Ring request — string keys, lower-cased per Ring convention."
   :parent :ring-request-field
   :args {:key {:value :headers}}}

  {:name :ring-body-input-stream
   :description "Raw body InputStream from the Ring request — feed into `:slurp` to get a string, or directly into a parser."
   :parent :ring-request-field
   :args {:key {:value :body}}}

  ;; =============================================================================
  ;; URI SEGMENT EXTRACTION — pure graph composition over :str-split /
  ;; :filter / :position-in / :get. Used by request parsers that read
  ;; an id from the URL when reitit's :path-params isn't populated
  ;; (handlers compiled inside a fn-graph sometimes receive the raw
  ;; http-kit request that hasn't been through enrich-request).
  ;; =============================================================================

  {:name :_uri-split
   :description "Raw `:str-split` of the request URI on `/`. Result includes leading-slash empties; `:_uri-segments` filters them out."
   :parent :str-split
   :args {:string :ring-uri
          :separator {:value "/"}}}

  {:name :_uri-filtered-segments
   :description "Lazy-seq of non-blank URI segments — `:filter :non-blank?` over `:_uri-split`. Uses the required-slot `:non-blank?` primitive (NOT `:blank?`, whose `:required false` slot would make the HOF wrap as variadic-ignore, keeping every element)."
   :parent :filter
   :args {:pred :non-blank?
          :coll :_uri-split}}

  {:name :_uri-segments
   :description "Non-blank path segments of the Ring request URI as a vector — `vec(filter non-blank? (str/split (:uri request) #\"/\"))`."
   :parent :vec
   :args {:coll :_uri-filtered-segments}}

  {:name :_uri-marker-pos
   :description "Index of `:marker` in the URI segments, or nil when absent."
   :parent :position-in
   :args {:coll :_uri-segments
          :value {:as :marker}}}

  {:name :_uri-marker-found?
   :description "True iff the marker was found in the URI segments."
   :parent :some?
   :args {:value :_uri-marker-pos}}

  {:name :_uri-marker-next-pos
   :description "Index of the segment AFTER the marker (`marker-pos + 1`). Only computed when `:_uri-marker-found?` is true — `:add` doesn't tolerate a nil position. The `:type :int` override on the ref strips `:_uri-marker-pos`'s nullable surface (the caller `:uri-segment-after`'s `:if` already gates on `:_uri-marker-found?` = `(:some? :_uri-marker-pos)`)."
   :parent :add
   :args {:nums [{:ref :_uri-marker-pos :type :int} {:value 1}]}}

  {:name :_uri-marker-next-segment
   :description "The URI segment at `marker-pos + 1`. Returns nil when the index is out of bounds (marker is the final segment)."
   :parent :get
   :args {:coll :_uri-segments
          :key :_uri-marker-next-pos
          :default nil}}

  {:name :uri-segment-after
   :description "Return the URI segment immediately following `:marker`, or nil if the marker is absent / final. Pure graph composition: split the URI on `/`, filter blanks, look up the marker index, return the next segment. Used by request parsers to read e.g. `:fn-id` from `/api/secrets/:fn-id` when reitit's `:path-params` aren't populated."
   :parent :if
   :args {:test :_uri-marker-found?
          :then :_uri-marker-next-segment
          :else nil
          :marker {:type :text
                   :description "Path segment to search for — caller supplies the literal (e.g. `\"fns\"`, `\"branches\"`, `\"secrets\"`)."}}}

  {:name :ring-method-entry
   :description "`[:request-method <method>]` entry for the internal-request map."
   :parent :list
   :args {:items [{:value :request-method} :ring-method]}}

  {:name :ring-uri-entry
   :description "`[:uri <path>]` entry for the internal-request map."
   :parent :list
   :args {:items [{:value :uri} :ring-uri]}}

  {:name :ring-query-string-entry
   :description "`[:query-string <qs>]` entry for the internal-request map."
   :parent :list
   :args {:items [{:value :query-string} :ring-query-string]}}

  {:name :ring-headers-entry
   :description "`[:headers <headers>]` entry for the internal-request map."
   :parent :list
   :args {:items [{:value :headers} :ring-headers]}}

  {:name :ring-body-entry
   :description "`[:body <input-stream>]` entry for the internal-request map. We pass the raw httpkit InputStream straight through (NOT pre-slurped via `:ring-body`) — slurping at this layer would consume the body before it reaches a handler that lives below an `:auth-required-middleware`, leaving downstream `(:body request)` reads with an empty string. Handlers slurp on demand via the `slurp-body` helper or pass directly to `json/parse-string` (which accepts InputStream)."
   :parent :list
   :args {:items [{:value :body} :ring-body-input-stream]}}

  {:name :internal-request
   :description "Internal request map — `{:request-method :uri :query-string :headers :body}` — fed to the router. All five field extractors plug into one `:pairs->map`, whose static field reconstruction rule proves the computed return IS this record (every entry is a `:list`-built pair with a literal key), so the declared `:return-type :ring-request-shape` is verified by subtyping, not merely asserted."
   :parent :pairs->map
   :return-type :ring-request-shape
   :args {:entries [:ring-method-entry
                    :ring-uri-entry
                    :ring-query-string-entry
                    :ring-headers-entry
                    :ring-body-entry]}}

  ;; =============================================================================
  ;; ROUTER INVOCATION + RESPONSE EXTRACTION
  ;; `:func` is a FREE arg — the consuming fn binds it to a concrete router
  ;; fn-def (e.g. `:_router`). `:arg` is bound to the extracted internal
  ;; request so every router call receives the same shape.
  ;; =============================================================================

  {:name :router-result
   :description "Ring-router invocation: feed the parsed `:internal-request` into `:func` and return whatever the router produced. The full `:func` contract — `[:fn {:arg :ring-request-shape} :ring-response-shape]` — is pinned at the slot, so consumers see the contract directly without reading downstream bindings. Non-Ring routers don't fit; for non-Ring single-arg calls extend `:invoke` directly instead of `:router-result`."
   :parent :invoke
   :return-type :ring-response-shape
   :args {:arg  {:ref :internal-request :type :ring-request-shape}
          :func {:type [:fn {:arg :ring-request-shape} :ring-response-shape]}}}

  ;; Opinionated default security headers — merged into every response's
  ;; `:headers` map. Keyword-keyed because http-kit accepts both string
  ;; and keyword keys in response headers (it calls `name` on them
  ;; before writing to the wire); same convention `:json-content-type`
  ;; and friends already rely on. Keeping the record-shape end-to-end
  ;; lets `:security-headers-shape` flow through the merge-in into
  ;; consumers without a type-erasing stringification step.
  {:name :default-security-headers
   :description "Default security-header map merged into every response — `X-Content-Type-Options`, `X-Frame-Options`, `X-XSS-Protection`, `Referrer-Policy`."
   :parent :const
   :return-type :security-headers-shape
   :args {:value {:X-Content-Type-Options "nosniff"
                  :X-Frame-Options        "DENY"
                  :X-XSS-Protection       "1; mode=block"
                  :Referrer-Policy        "strict-origin-when-cross-origin"}}}

  ;; Take the router-result (a Ring response map) and merge default
  ;; security headers into its `:headers`. One node, no re-assembly:
  ;;   (update response :headers #(merge defaults %))
  {:name :router-ring-response
   :description "Run the router (`:func`) on the parsed `:internal-request` and merge default security headers into the response. The fn-graph bound to `:http-server.handler`."
   :parent :merge-in
   :return-type :ring-response-shape
   :args {:m        :router-result
          :path     [{:value :headers}]
          :defaults :default-security-headers
          :func     {:type [:fn {:arg :ring-request-shape} :ring-response-shape]
                     :description "Concrete router callable invoked per request. Bound by the consumer (typically a `:router` descendant)."}}}

  ;; Same header-merge as :router-ring-response, but as a HANDLER WRAP
  ;; around an arbitrary :base-handler rather than around the main router.
  ;; :router-ring-response only covers responses produced by the main
  ;; :_router; the branch/tenancy dispatch layer
  ;; (`graphden.system.branch-router/dispatch`) also emits responses —
  ;; control-plane admin HTML, unknown-branch 400, tenant app-router —
  ;; that never touch :_router and so would ship WITHOUT security headers
  ;; (latent clickjacking on admin panels). Mounting this wrap OUTSIDE the
  ;; dispatch layer stamps every one of those too. Idempotent: :merge-in
  ;; fills only MISSING keys, so a response already carrying the headers
  ;; (the normal :router-ring-response path) is untouched.
  {:name :_secure-headers-handler-result
   :description "Runs :base-handler on the :request — the response the wrap will stamp headers onto. Named (not inline) so the HOF :call type-checks like :router-result does."
   :parent :call
   :args {:func {:as :base-handler
                 :type [:fn {:request :ring-request-shape} :ring-response-shape]}
          :arg {:as :request}}
   :return-type :ring-response-shape}

  {:name :secure-headers-wrap
   :description "Handler wrap — runs :base-handler on the :request and merges :default-security-headers into the response's :headers (missing keys only; a handler's explicit header wins). Mount OUTSIDE branch/tenancy dispatch so responses that bypass :router-ring-response still carry the headers. Free args: :base-handler, :request."
   :parent :merge-in
   :return-type :ring-response-shape
   :args {:m        :_secure-headers-handler-result
          :path     [{:value :headers}]
          :defaults :default-security-headers}}

  ;; =============================================================================
  ;; AUTH SEAM (PLATFORM_PLAN §3.0) — the authentication DECISION delegates
  ;; to the context's pluggable `:auth-provider`. Core wires the default
  ;; single-token provider; the tenancy addon swaps it for session/JWT.
  ;; The middleware + `:request-authed?` read ONLY `:request-authenticated?`,
  ;; so they're provider-agnostic.
  ;; =============================================================================

  {:name :authenticate-request
   :description "Authenticate the current request via the context's `:auth-provider` (single-token by default; session/JWT in the tenancy addon). Returns the principal — the CORE-visible contract is `{:authenticated? bool}`. A real provider also returns `:user`/`:org`, read by addon fn-defs that know that shape; core only contracts on `:authenticated?`."
   :args {:request {:type :ring-request-shape :description "The Ring request (auth provider extracts creds from it)."}}
   :return-type {:authenticated? :bool}}

  {:name :_request-principal
   :description "Principal map for the current request (free arg `:request` propagates up)."
   :parent :authenticate-request}

  {:name :request-authenticated?
   :description "True iff the current request authenticated, provider-agnostic. The single seam both the auth middleware and `app.lookups/:request-authed?` read."
   :parent :get
   :return-type :bool
   :args {:coll :_request-principal :key {:value :authenticated?} :default false}}

  {:name :auth-active?
   :description "True iff authentication is turned ON for this deployment — i.e. an `:auth-provider` is wired on the context (the `auth` addon's single-token provider, or the tenancy addon's storage-token provider). No provider ⇒ auth OFF ⇒ `:auth-required-middleware` passes everything through, so a self-hosted instance runs with no login. The switch that makes the auth-required routes gate-when-on / open-when-off."
   :return-type :bool
   :effects #{}}

  ;; 401 response used by auth middleware on failure.
  {:name :_default-auth-fail-body
   :parent :ring-response
   :args {:status 401
          :headers {"Content-Type" "text/plain"}}}

  {:name :default-auth-fail-response
   :description "Canonical 401 response used by `auth-required-middleware` when the bearer token is missing or wrong — `{:status 401 :body \"Unauthorized\"}` with text content-type."
   :parent :_default-auth-fail-body
   :return-type :ring-response-shape
   :args {:body "Unauthorized"}}

  ;; =============================================================================
  ;; AUTH MIDDLEWARE
  ;; Body is a Ring-shaped fn-graph: if token valid → proceed to the next
  ;; handler in the middleware chain, else return the 401 response
  ;; directly. Attached to protected routes via `:middleware
  ;; [:auth-required-middleware]` in the route's method-data. No pre-router
  ;; path-gating layer — the router reads route-data once, runs the chain,
  ;; dispatches.
  ;; =============================================================================

  ;; When auth is ACTIVE: authenticated → proceed; otherwise 401.
  {:name :_auth-enforce
   :parent :if
   :args {:test :request-authenticated?
          :then :proceed
          :else :default-auth-fail-response}}

  ;; Provider-aware gate. `:auth-active?` OFF (no provider wired) ⇒ pass through
  ;; (self-hosted with no auth package is fully open); ON ⇒ enforce. This lets
  ;; the SAME auth-required routes be gated on an auth deployment and open on a
  ;; no-auth one, without a second set of route templates.
  {:name :_auth-required-body
   :parent :if
   :args {:test :auth-active?
          :then :_auth-enforce
          :else :proceed}}

  {:name :auth-required-middleware
   :description "Provider-aware auth middleware. When auth is ACTIVE (an `:auth-provider` is wired) an authenticated request calls `:proceed` (next handler) and an unauthenticated one gets a 401; when auth is OFF (no provider) it always `:proceed`s — so the same protected routes are gated on an auth deployment and fully open on a no-auth self-hosted one. Attached per-route via `:middleware [:auth-required-middleware]`."
   :parent :middleware
   :args {:name {:value :auth-required}
          :body :_auth-required-body}}

  ;; =============================================================================
  ;; ENTRY POINT
  ;; The consumer binds a router fn-graph (usually wrapped into
  ;; `:router-ring-response`) directly to the web server's `:handler` slot.
  ;; `:handler` is declared `:fn`-type on `:http-server`, so compile's
  ;; hof-wrap turns the fn-graph into a Ring callable automatically.
  ;; =============================================================================
  ]}
