;; Outgoing HTTP client base function.
;;
;; Counterpart to web/http (server). Thin wrapper around
;; org.httpkit.client/get — enough to demonstrate "call an external
;; API from a fn-graph" and feed the response into downstream
;; processing (parse-json, get, etc.). POST / PUT / DELETE can be
;; added later as siblings if a tutorial needs them.


{:namespace "web.http-client"
 :description "Outgoing HTTP — GET an external URL with custom headers."
 :fns
 [;; Return shape: same keys http-kit emits, but stringified at the
  ;; boundary so the fn-graph stays primitive-typed end-to-end. The
  ;; record subtype rule (open) means downstream `:get` of `"body"`
  ;; / `"status"` works directly without an extra adapter.
  {:name :http-response-shape
   :description "Result of `:http-get` — `{status, headers, body}` mirroring http-kit's response map (headers stringified, body slurped to text)."
   :type {:status :int
          :headers :text-map
          :body :text}}

  {:name :http-get
   :description "Perform an HTTP GET against `:url` with the supplied `:headers` map. Returns `{:status :headers :body}` — body slurped to text, headers stringified. Connect+read timeout via `:timeout-ms` (default 10s). Throws `http-client/request-failed` on transport errors (DNS, refused, timeout); non-2xx responses are returned with their actual status so callers can branch on it. The `:headers` slot is `:text-map` so it REFUSES secret-typed values structurally — use `:http-get-with-authorization` for any auth flow that pulls a token from `:vault-get`."
   :args {:url {:type :text
                :description "Absolute URL, e.g. `https://httpbin.org/bearer`."}
          :headers {:type :text-map
                    :value {}
                    :description "Header map. Keys + values are strings, e.g. `{\"Authorization\" \"bearer …\"}`. Defaults to empty. Plain `:text` values only — secret-typed values are rejected at sync-time."}
          :timeout-ms {:type :positive-int
                       :value 10000
                       :description "Connect+read timeout in milliseconds. Defaults to 10s."}}
   :return-type :http-response-shape
   :effects #{:network}}

  ;; ---------------------------------------------------------------------
  ;; :http-get-with-authorization — generalised auth-aware HTTP GET.
  ;;
  ;; The secret-flow problem: plain `:http-get`'s `:headers` slot is
  ;; `:text-map`, which deliberately refuses secret-typed
  ;; values. That closes the leak path (a literal map can't sneak a
  ;; secret through a generic shape) but also blocks the legitimate
  ;; "wire a vault token into the Authorization header" use case.
  ;;
  ;; The fix is one base-fn whose `:auth-value` slot is `[:secret
  ;; :text]` — accepts a secret structurally, injects it into the
  ;; request headers internally so the secret never crosses a generic
  ;; `:map` slot. The user can build the auth-value with full graph
  ;; composability (different schemes, custom prefixes, multi-secret
  ;; compositions), because `:str` propagates `[:secret :text]` taint.
  ;;
  ;; Scheme-specific variants (e.g. `:http-get-with-bearer`,
  ;; `:http-get-with-token`, `:http-get-with-basic`) would be pure graph
  ;; fn-defs parent-ing this primitive — none ship yet; compose one when a
  ;; tutorial needs it. No JAR rebuild for a new scheme, just a new fn-def.
  ;; ---------------------------------------------------------------------
  {:name :http-get-with-authorization
   :description "Variant of `:http-get` that takes a secret-typed `:auth-value` (the full `Authorization` header value, e.g. `\"Bearer xxx\"`) and injects it directly into the request headers. The slot's `[:secret :text]` shape IS the secret-flow boundary — secret values never cross a generic `:text-map` slot."
   :args {:url {:type :text :description "Absolute URL."}
          :auth-value {:type [:secret :text]
                       :description "Full Authorization header value — scheme keyword (`Bearer`/`Token`/`Basic`/…) included. Slot is `[:secret :text]`, so a secret-typed value (`:vault-get` ref, any `:str`-composed secret) is accepted structurally."}
          :extra-headers {:type :text-map
                          :value {}
                          :description "Additional headers merged BEFORE the Authorization header (auth always wins on key collision). Plain text only — secrets here would leak through the generic `:map` shape."}
          :timeout-ms {:type :positive-int
                       :value 10000
                       :description "Connect+read timeout in milliseconds. Defaults to 10s."}}
   :return-type :http-response-shape
   :effects #{:network}}]}
