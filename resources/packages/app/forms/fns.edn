      :type-expr {:as :type-expr, :type :type-expression}}},
    :default "_form-json"}}

  {:name :_form-build-leaf,
   :parent :if,
   :args
   {:test {:parent :some?, :args {:value :_control-enum}},
    :then :_control-enum-view,
    :else
    {:parent :_control-merged, :args {:target :_control-leaf-target}}},
   :return-type :hiccup-node}

  {:name :_render-recursion,
   :parent :get,
   :args
   {:coll {:as :render-state, :type :keyword-map},
    :key {:value :recur, :type :keyword},
    :default {:value nil, :type :null}},
   :return-type [:fn {:arg :any} :any]}

  {:name :_render-form,
   :parent :get,
   :args {:coll {:as :input}, :key {:value :form}, :default {:value nil}}}

  {:name :_render-type,
   :parent :get,
   :args
   {:coll :_render-form, :key {:value :type}, :default {:value nil}}}

  {:name :_render-kind,
   :parent :get,
   :args
   {:coll :_render-form, :key {:value :kind}, :default {:value nil}}}

  {:name :_render-path,
   :parent :get,
   :args {:coll {:as :input}, :key {:value :path}, :default {:value ""}}}

  {:name :_render-id,
   :parent :get,
   :args {:coll {:as :input}, :key {:value :id}, :default {:value nil}}}

  {:name :_render-value,
   :parent :get,
   :args
   {:coll {:as :input}, :key {:value :value}, :default {:value nil}}}

  {:name :_render-exact-target,
   :parent :if,
   :args
   {:test {:parent :equal?, :args {:a :_render-kind, :b {:value :leaf}}},
    :then nil,
    :else
    {:parent :_form-exact-target,
     :args {:registry :_form-registry, :type-expr :_render-type}}}}

  {:name :_render-exact,
   :parent :_control-merged,
   :args
   {:target {:ref :_render-exact-target, :type :text},
    :type-expr :_render-type,
    :path :_render-path,
    :id :_render-id}}

  {:name :_render-field-name,
   :parent :name,
   :args
   {:value
    {:parent :get,
     :args
     {:coll {:as :field, :type :keyword-map},
      :key {:value :name},
      :default {:value nil}}}}}

  {:name :_render-field-path,
   :parent :if,
   :args
   {:test
    {:parent :blank?,
     :args
     {:string
      {:parent :get,
       :args
       {:coll {:as :render-state, :type :keyword-map},
        :key {:value :path},
        :default {:value ""}}}}},
    :then :_render-field-name,
    :else
    {:parent :str,
     :args
     {:parts
      [{:parent :get,
        :args
        {:coll {:as :render-state, :type :keyword-map},
         :key {:value :path},
         :default {:value ""}}}
       "."
       :_render-field-name]}}}}

  {:name :_render-field-form,
   :parent :get,
   :args
   {:coll {:as :field, :type :keyword-map},
    :key {:value :form},
    :default {:value nil}}}

  {:name :_render-field-id,
   :parent :if,
   :args
   {:test
    {:parent :or,
     :args
     {:values
      [{:parent :equal?,
        :args
        {:a
         {:parent :get,
          :args
          {:coll :_render-field-form,
           :key {:value :kind},
           :default {:value nil}}},
         :b {:value :record}}}
       {:parent :equal?,
        :args
        {:a
         {:parent :get,
          :args
          {:coll :_render-field-form,
           :key {:value :kind},
           :default {:value nil}}},
         :b {:value :union}}}]}},
    :then nil,
    :else {:parent :str, :args {:parts ["vf-" :_render-field-path]}}}}

  {:name :_render-parent-value,
   :parent :get,
   :args
   {:coll {:as :render-state, :type :keyword-map},
    :key {:value :value},
    :default {:value nil}}}

  {:name :_render-field-key,
   :parent :str-to-keyword,
   :args {:string :_render-field-name}}

  {:name :_render-field-value,
   :parent :if,
   :args
   {:test
    {:parent :is-a?,
     :args {:value :_render-parent-value, :type {:value :map}}},
    :then
    {:parent :if,
     :args
     {:test
      {:parent :contains?,
       :args {:coll :_render-parent-value, :key :_render-field-key}},
      :then
      {:parent :get,
       :args
       {:coll :_render-parent-value,
        :key :_render-field-key,
        :default nil}},
      :else
      {:parent :get,
       :args
       {:coll :_render-parent-value,
        :key :_render-field-name,
        :default nil}}}},
    :else nil}}

  {:name :_render-field,
   :parent :_form-record-field,
   :args
   {:field-id :_render-field-id,
    :field-name :_render-field-name,
    :control
    {:parent :invoke,
     :args
     {:func {:ref :_render-recursion, :type [:fn {:arg :any} :any]},
      :arg
      {:parent :zipmap,
       :args
       {:keys
        [{:value :form} {:value :path} {:value :id} {:value :value}],
        :vals
        [:_render-field-form
         :_render-field-path
         :_render-field-id
         :_render-field-value]}}}}},
   :lambda-params [:field],
   :return-type :hiccup-node}

  {:name :_render-record,
   :parent :_form-record-group,
   :args
   {:fields
    {:parent :vec,
     :args
     {:coll
      {:parent :map,
       :args
       {:func :_render-field,
        :coll
        {:parent :get,
         :args
         {:coll :_render-form,
          :key {:value :fields},
          :default {:value []}}},
        :render-state
        {:parent :assoc,
         :args
         {:map {:as :input},
          :key {:value :recur},
          :value {:as :self, :type [:fn {:arg :any} :any]}}}}}}}},
   :return-type :hiccup-node}

  {:name :_render-branches,
   :parent :get,
   :args
   {:coll :_render-form, :key {:value :branches}, :default {:value []}}}

  {:name :_render-indices,
   :parent :range,
   :args
   {:start 0,
    :end {:parent :count, :args {:coll :_render-branches}},
    :step 1}}

  {:name :_render-indexed-branch,
   :parent :get,
   :args
   {:coll {:as :branches, :type [:list :keyword-map]},
    :key {:as :branch-index, :type :int},
    :default nil}}

  {:name :_render-branch-fits?,
   :parent :_form-value-fits?,
   :args
   {:value {:as :current-value, :type :any},
    :type-expr
    {:parent :get,
     :args
     {:coll :_render-indexed-branch,
      :key {:value :type},
      :default {:value nil}}}},
   :lambda-params [:branch-index]}

  {:name :_render-active,
   :parent :coalesce,
   :args
   {:value
    {:parent :find-first,
     :args
     {:pred :_render-branch-fits?,
      :coll :_render-indices,
      :branches :_render-branches,
      :current-value :_render-value}},
    :default 0}}

  {:name :_render-index-text,
   :parent :to-str,
   :args {:value {:as :branch-index, :type :int}}}

  {:name :_render-index-active?,
   :parent :equal?,
   :args
   {:a {:as :branch-index, :type :int},
    :b {:as :selected-index, :type :int}}}

  {:name :_render-option-attrs,
   :parent :if,
   :args
   {:test :_render-index-active?,
    :then
    {:parent :zipmap,
     :args
     {:keys [{:value "value"} {:value "selected"}],
      :vals [:_render-index-text "selected"]}},
    :else
    {:parent :zipmap,
     :args {:keys [{:value "value"}], :vals [:_render-index-text]}}}}

  {:name :_render-option,
   :parent :list,
   :args
   {:items
    ["option"
     :_render-option-attrs
     {:parent :_form-type-label,
      :args
      {:type-expr
       {:parent :get,
        :args
        {:coll :_render-indexed-branch,
         :key {:value :type},
         :default {:value nil}}}}}]},
   :lambda-params [:branch-index],
   :return-type :hiccup-node}

  {:name :_render-union-select,
   :parent :_form-union-select,
   :args
   {:options
    {:parent :vec,
     :args
     {:coll
      {:parent :map,
       :args
       {:func :_render-option,
        :coll :_render-indices,
        :branches :_render-branches,
        :selected-index :_render-active}}}}}}

  {:name :_render-branch-leaf-type,
   :parent :if,
   :args
   {:test
    {:parent :equal?,
     :args
     {:a
      {:parent :get,
       :args
       {:coll
        {:parent :get,
         :args
         {:coll :_render-indexed-branch,
          :key {:value :form},
          :default {:value nil}}},
        :key {:value :kind},
        :default {:value nil}}},
      :b {:value :leaf}}},
    :then
    {:parent :get,
     :args
     {:coll :_render-indexed-branch,
      :key {:value :type},
      :default {:value nil}}},
    :else {:value :any}}}

  {:name :_render-branch,
   :parent :_form-union-branch,
   :args
   {:index :_render-index-text,
    :active? :_render-index-active?,
    :control
    {:parent :_form-build-leaf,
     :args
     {:type-expr :_render-branch-leaf-type,
      :path {:as :path, :type :text},
      :id nil}}},
   :lambda-params [:branch-index],
   :return-type :hiccup-node}

  {:name :_render-union,
   :parent :_form-union-wrap,
   :args
   {:select :_render-union-select,
    :branches
    {:parent :vec,
     :args
     {:coll
      {:parent :map,
       :args
       {:func :_render-branch,
        :coll :_render-indices,
        :branches :_render-branches,
        :selected-index :_render-active,
        :path :_render-path}}}},
    :active {:parent :to-str, :args {:value :_render-active}}},
   :return-type :hiccup-node}

  {:name :_render-leaf,
   :parent :_form-build-leaf,
   :args
   {:type-expr
    {:parent :if,
     :args
     {:test
      {:parent :equal?, :args {:a :_render-kind, :b {:value :list}}},
      :then {:value :any},
      :else :_render-type}},
    :path :_render-path,
    :id :_render-id}}

  {:name :_render-step,
   :parent :cond,
   :args
   {:clauses
    [{:parent :some?, :args {:value :_render-exact-target}}
     :_render-exact
     {:parent :equal?, :args {:a :_render-kind, :b {:value :record}}}
     :_render-record
     {:parent :equal?, :args {:a :_render-kind, :b {:value :union}}}
     :_render-union
     true
     :_render-leaf]},
   :lambda-params [:input :self],
   :return-type :hiccup-node}

  {:name :build-form,
   :parent :fix,
   :args
   {:step :_render-step,
    :input
    {:parent :zipmap,
     :args
     {:keys [{:value :form} {:value :path} {:value :id} {:value :value}],
      :vals
      [{:as :form, :type :keyword-map}
       ""
       nil
       {:as :current-value, :type :any}]}}},
   :return-type :hiccup-node,
   :description
   "Graph form rendering: exact registry override, recursive record fields, union choice and enum/control attributes. Canonical type interpretation and scoped target execution remain native."}

  {:name :_build-value-form-descriptor
   :parent :resolve-form
   :args {:type-expr {:as :eff-type :type :type-expression}}}

  ;; The old opaque base-fn did resolve-form THEN build-form in one
  ;; body — both stages are composed graph functions.
  {:name :build-value-form
   :description "Type-aware form-renderer — classify `:eff-type` into a descriptor (`:resolve-form`) and render it (`:build-form`). Pure graph composition; free args `:eff-type`, `:current-value`."
   :parent :build-form
   :args {:form :_build-value-form-descriptor
          :current-value {:as :current-value :type :any}}
   :return-type :hiccup-node}

  {:name :_slot-type-provenance-facts
   :description "Authorized canonical type and inheritance facts. Shared batched lookup, override precedence, marker restoration and composition visibility remain inside the boundary."
   :args {:parsed {:type :_value-form-parsed-shape}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :_slot-provenance-facts
   :parent :get
   :args {:coll {:as :provenance-facts} :key {:value :facts} :default nil}}

  {:name :_slot-provenance-tier
   :parent :assoc
   :args {:map {:parent :get
                :args {:coll :_slot-provenance-facts :key {:as :item} :default nil}}
          :key {:value :key} :value {:as :item}}}

  {:name :_slot-provenance-tiers
   :parent :map
   :args {:func :_slot-provenance-tier
          :coll {:value [:override :unified :ref-return :slot]}}}

  {:name :_slot-provenance-tier-winner
   :parent :if
   :args {:test {:parent :some?
                 :args {:value {:parent :get
                                :args {:coll {:as :item} :key {:value :type} :default nil}}}}
          :then {:parent :get :args {:coll {:as :item} :key {:value :key} :default nil}}
          :else nil}}

  {:name :_slot-provenance-presentation
   :parent :zipmap
   :args {:keys [:winner :tiers :inheritance-chain]
          :vals [{:parent :some
                  :args {:pred :_slot-provenance-tier-winner :coll :_slot-provenance-tiers}}
                 :_slot-provenance-tiers
                 {:parent :get
                  :args {:coll {:as :provenance-facts}
                         :key {:value :inheritance-chain} :default []}}]}}

  {:name :slot-type-provenance
   :description "Ordered override/unified/ref-return/slot type provenance, its first nonnil winner, and the authorized inheritance chain. nil for hidden or unresolved sites and list items."
   :parent :if
   :args {:test {:parent :some? :args {:value :_slot-type-provenance-facts}}
          :then :_slot-provenance-presentation :else nil
          :provenance-facts :_slot-type-provenance-facts
          :parsed {:type :_value-form-parsed-shape}}
   :return-type :nullable-keyword-map}

  {:name :_value-form-apply
   :description "Stage 3 of value-form — resolve the slot's effective type, pick the matching form-fn, execute it, and wrap the control in a data-form-root div. Returns {:ok true :form <hiccup> :value <current>}."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :form} {:value :value}]
          :vals [{:value true}
                 :_value-form-hiccup
                 :_value-form-current]}
   :return-type :_value-form-result-shape
   :return-type-wide? true}

  ;; The editor's "as:" chooser on a wide (`:any` / `:jsonb`) slot asks
  ;; for a NARROWER type's form by name — `:resolve-form` reads a text
  ;; alias as a type, so the name passes straight through. Absent (the
  ;; normal case), the slot's own effective type decides. Read off the
  ;; request body directly: the parsed record is the slot ADDRESS the
  ;; provenance partial synthesises too, and `as` is not part of it.
  ;; Only a non-blank STRING counts as a request: a blank or non-string
  ;; `as` used to flow straight into `:resolve-form` as a type, and
  ;; `""` / `7` came back as the secret-binding widget instead of the
  ;; slot's own form.
  {:name :_value-form-as-raw
   :parent :get
   :args {:coll :_value-form-body :key {:value :as} :default nil}}
  {:name :_value-form-as-given?
   :description "True iff the body's `as` is a non-blank string — a type NAME the editor's \"as:\" chooser sent."
   :parent :and
   :args {:values [{:parent :is-a? :args {:value :_value-form-as-raw :type {:value :text}}}
                   {:parent :non-blank? :args {:string :_value-form-as-raw}}]}}
  {:name :_value-form-as
   :parent :if
   :args {:test :_value-form-as-given?
          :then :_value-form-as-raw
          :else {:value nil}}}
  {:name :_value-form-slot-type
   :parent :resolve-slot-effective-type
   :args {:parsed {:as :parsed}}}
  ;; `(or as slot-type)` — a text `as` or the slot's own type expression:
  ;; the declared return pins `:coalesce`'s `a` to the wider of the two
  ;; (first-binding-wins would pin it to `as`'s `:text` and refuse the
  ;; default).
  {:name :_value-form-eff-type
   :parent :coalesce
   :args {:value :_value-form-as
          :default :_value-form-slot-type}
   :return-type :type-expression}

  {:name :_value-form-current
   :parent :current-slot-value
   :args {:parsed {:as :parsed}}}

  {:name :_value-form-control
   :parent :build-value-form
   :args {:eff-type :_value-form-eff-type
          :current-value :_value-form-current}}

  {:name :_value-form-hiccup
   :description "`[\"div\" <root-attrs> <control>]` hiccup shell."
   :parent :vec
   :args {:coll [{:value "div"}
                 :_value-form-root-attrs
                 :_value-form-control]}}

  ;; Root attributes: always carries `data-form-root`, conditionally
  ;; adds `data-binding-id` / `data-fn-id` / `data-slot-id` /
  ;; `data-item-id` when the parsed shape has the corresponding id.
  ;; Stringified via `:to-str` to match the legacy `(str (:binding-id parsed))`.
  {:name :_value-form-root-attrs
   :parent :merge
   :args {:maps [{:value {"data-form-root" ""}}
                 :_value-form-binding-id-attr
                 :_value-form-fn-id-attr
                 :_value-form-slot-id-attr
                 :_value-form-item-id-attr]}}

  {:name :_value-form-binding-id-attr
   :parent :if
   :args {:test :_value-form-binding-id-present?
          :then {:parent :zipmap
                 :args {:keys [{:value "data-binding-id"}]
                        :vals [{:parent :to-str
                                :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :binding-id} :default nil}}}}]}}
          :else {:value {}}}}

  {:name :_value-form-binding-id-present?
   :parent :some?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :binding-id} :default nil}}}}

  {:name :_value-form-fn-id-attr
   :parent :if
   :args {:test :_value-form-fn-id-present?
          :then {:parent :zipmap
                 :args {:keys [{:value "data-fn-id"}]
                        :vals [{:parent :to-str
                                :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :fn-id} :default nil}}}}]}}
          :else {:value {}}}}

  {:name :_value-form-fn-id-present?
   :parent :some?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :fn-id} :default nil}}}}

  {:name :_value-form-slot-id-attr
   :parent :if
   :args {:test :_value-form-slot-id-present?
          :then {:parent :zipmap
                 :args {:keys [{:value "data-slot-id"}]
                        :vals [{:parent :to-str
                                :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :slot-id} :default nil}}}}]}}
          :else {:value {}}}}

  {:name :_value-form-slot-id-present?
   :parent :some?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :slot-id} :default nil}}}}

  {:name :_value-form-item-id-attr
   :parent :if
   :args {:test :_value-form-item-id-present?
          :then {:parent :zipmap
                 :args {:keys [{:value "data-item-id"}]
                        :vals [{:parent :to-str
                                :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :item-id} :default nil}}}}]}}
          :else {:value {}}}}

  {:name :_value-form-item-id-present?
   :parent :some?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :item-id} :default nil}}}}

  {:name :value-form
   :description "POST /api/value-form — parse the JSON body identifying a binding/slot, validate, and on success resolve the type-aware editor form. Returns {:ok true :form :value} or {:ok false :error}."
   :parent :if
   :args {:test :rejected?
          :then :_value-form-validation
          :else :_value-form-apply
          :validation :_value-form-validation
          :parsed :_value-form-parsed}}

  {:name :value-form-handler
   :lambda-params [:request]
   :description "Ring handler for `POST /api/value-form` — wraps `:value-form` in a JSON 200 response."
   :parent :json-handler
   :args {:data :value-form}}]}
