;; Building collections from mixed literals and fn-refs.
;;
;; Two arg-shapes for collections, with VERY different semantics:
;;
;;   :type :sequence  →  each item is its own arg-entity, fn-refs resolve.
;;                       This is `:list/:items`, `:cond/:clauses` (sort of),
;;                       and the `:items`-as-vector form anywhere.
;;
;;   :type :jsonb     →  the whole vector is one JSONB blob. Keywords inside
;;                       are DATA, not fn-refs. Used for `:str/:parts`,
;;                       `:concat/:colls`, `:transduce/:coll`, etc.
;;
;; To put a mixed literal+fn-ref collection into a `:jsonb`-typed slot,
;; build it via `:list` first and pass the resulting fn-ref. See
;; examples.sequence-vs-jsonb for the bare contrast.


{:namespace "examples.collections"
 :description "`:list` with mixed items, `:concat` over computed colls, and stacked `:assoc` for map-building."
 :fns
 [;; SEQUENCE arg — each item is a separate arg entity. Mix literals and refs.
  {:name :ex-mixed-list
   :description "A vector with two literals and one fn-ref interleaved. The `:items` slot of `:list` is sequence-typed: each entry becomes its own arg-entity, so a fn-ref can sit next to a literal."
   :parent :list
   :args {:items [{:value 1}
                  {:value 2}
                  :_ex-three]}}

  {:name :_ex-three
   :description "Local helper providing the value 3."
   :parent :const
   :args {:value 3}}

  ;; :concat — `:colls` is `:jsonb`. Each entry must be a single fn-ref
  ;; (or a single literal vector). Interleaving inside :colls' inline
  ;; vector would NOT work; we route through a `:list` helper instead.
  {:name :ex-prepended
   :description "Prepend `[0]` in front of `:ex-mixed-list`. The two collections are wrapped via `:_ex-prepended-colls` (a `:list`) so fn-refs resolve correctly. `:concat/:colls` is `:jsonb`-typed — passing `[{:value [0]} :ex-mixed-list]` directly would store the keyword as data."
   :parent :concat
   :args {:colls :_ex-prepended-colls}}

  {:name :_ex-prepended-colls
   :parent :list
   :args {:items [{:value [0]}
                  :ex-mixed-list]}}

  ;; Stacked :assoc — `:map`/`:value` are `:any`-typed, fn-refs resolve directly.
  {:name :ex-status-map
   :description "Builds `{\"version\" \"1.0\" \"status\" \"ok\"}` by stacking two `:assoc` calls. `:assoc/:map` is `:any`-typed, so `:_ex-status-stage-1` resolves cleanly without a `:list` helper."
   :parent :assoc
   :args {:map :_ex-status-stage-1
          :key "status"
          :value "ok"}}

  {:name :_ex-status-stage-1
   :description "First stage — empty map plus `\"version\" => \"1.0\"`."
   :parent :assoc
   :args {:map {}
          :key "version"
          :value "1.0"}}

  ;; :count over a computed collection
  {:name :ex-count-prepended
   :description "Number of items in `:ex-prepended`. Confirms the prepended collection has 4 items: 0, 1, 2, 3."
   :parent :count
   :args {:coll :ex-prepended}}]}
