;; HTTP server + the per-request handler wrap chain.
;;
;; The chain composed in `app/server/fns.edn` is:
;;
;;   :response-cache-wrap        (outermost; short-circuit on hit)
;;     :encode-stringify-wrap    (encode response + stringify keyword header keys)
;;       :realize-body-wrap      (slurp :body InputStream → String)
;;         <application handler> (the routed Ring handler)
;;
;; Mirrors `web.branch-router/branch-routing-wrap` — wraps are pure
;; fn-defs over `:if` + `:call` + small base-fns; per-request the
;; executor evaluates the wrap graph for each request. Each wrap
;; exposes `:base-handler` as a free arg; composition pins it.


{:namespace "web.http"
 :description "HTTP server primitive (http-kit) plus the per-request handler-wrap chain that injects body realisation, response post-processing, and the immutable-response cache."
 :fns
 [;; Type-alias for the http-kit stop-callable.
  {:name :http-server-handle
   :description "Handle of a running http-kit server — a 0-arg callable that stops the server when invoked. Returned by `:http-server`, consumed by `:http-stop`."
   :fn-type [{} :null]}

  {:name :http-server
   :description "Start an http-kit HTTP server. The `:handler` is a Ring-style fn `(fn [request] response)`; the executor's hof-wrap turns the bound fn-graph into a single-arg Ring callable per request. http-server itself does nothing beyond starting the listener and forwarding the request — body realisation, response post-processing, and the response cache are composed in via the wraps below."
   :args {:handler {:type [:fn {:request :ring-request-shape} :ring-response-shape]
                    :description "Ring-style handler — typically the full wrap chain (see this package's fn-defs below)."}
          :port {:type :port
                 :description "TCP port to listen on (e.g., 8080) — refinement narrows :int to 1..65535."}}
   :return-type :http-server-handle
   :effects #{:network :process}
   :branch-local? true}

  {:name :http-stop
   :description "Stop a running http-kit server returned by `:http-server`."
   :args {:server {:type :http-server-handle
                   :description "Server handle returned by `:http-server`."}}
   :return-type :null
   :effects #{:network}}

  ;; =============================================================================
  ;; PRIMITIVE BASE-FNS that the wrap chain composes against
  ;; =============================================================================

  {:name :realize-request-body
   :description "Slurp `:body InputStream` into a UTF-8 String so downstream handlers can read it more than once. Pass-through on non-stream bodies. Used by `:realize-body-wrap`."
   :args {:request {:type :ring-request-shape
                    :description "Inbound Ring request."}}
   :return-type :ring-request-shape}

  {:name :stringify-response-headers
   :description "Boundary coercion — keyword header keys → strings (the shape http-kit's writer expects). Pass-through when `:headers` isn't a map."
   :args {:response {:type :ring-response-shape
                     :description "Response whose header keys may be keywords."}}
   :return-type :ring-response-shape}

  {:name :header-get
   :description "Case-insensitive-ish header lookup — tries the lower-cased name (Ring convention) first, then the exact spelling. nil when absent."
   :args {:headers {:type [:union :null :text-map]
                    :description "Header map (string keys)."}
          :header-name {:type :text
                        :description "Header name, e.g. `Content-Type`."}}
   :return-type :nullable-text}

  {:name :pick-encoding
   :description "Content negotiation over `Accept-Encoding` (RFC 7231 §5.3): returns `br` when brotli is acceptable (non-zero q), else `gzip`, else `identity`. Self-contained RFC parse — the DECISION to encode (and its thresholds) is composed in the graph (`:encode-response`)."
   :args {:headers {:type [:union :null :text-map]
                    :description "Request header map."}}
   :return-type :text}

  {:name :utf8-bytes
   :description "String → UTF-8 byte[] (byte[] passes through; anything else → nil). The graph has no bytes type — the value flows through `:any` slots into the compressors."
   :args {:value {:type :any :required false
                  :description "Response body — String or byte[]."}}
   :return-type :any}

  {:name :byte-count
   :description "Length of a byte[] — nil-safe."
   :args {:bytes {:type :any :required false
                  :description "byte[] (from `:utf8-bytes` / a compressor), or nil."}}
   :return-type :nullable-int}

  {:name :gzip-bytes
   :description "gzip-compress a byte[] (java.util.zip.GZIPOutputStream)."
   :args {:raw {:type :any :description "byte[] to compress."}}
   :return-type :any}

  {:name :brotli-bytes
   :description "brotli-compress a byte[] (brotli4j). `:quality` 0-11 — higher is smaller/slower."
   :args {:raw {:type :any :description "byte[] to compress."}
          :quality {:required false :type :int :value 6
                    :description "Brotli quality 0-11. Default 6 — the speed/ratio sweet spot for on-the-fly encoding."}}
   :return-type :any}

  ;; =============================================================================
  ;; RESPONSE POST-PROCESSING — composed in the graph.
  ;;
  ;;   :process-response = encode ∘ connection-close ∘ stringify-headers
  ;;
  ;; Both the close POLICY and the encode TRIGGERS (compressible
  ;; content-type pattern, minimum body size, brotli quality) are
  ;; graph-visible: a deployment wanting a smarter policy (e.g. close
  ;; only after heavy endpoints, different compression thresholds)
  ;; composes its own variant from the same pieces — no Clojure change.
  ;; =============================================================================

  {:name :_resp-headers-stringified
   :description "Step 1 — response with keyword header keys stringified."
   :parent :stringify-response-headers
   :args {:response {:as :response :type :ring-response-shape}}}

  ;; `Connection: close` on every response. http-kit honours this —
  ;; flushes the body, then closes the channel and releases its
  ;; write-queue byte[] buffers. WITHOUT this, default HTTP/1.1
  ;; keep-alive leaves the channel + buffers in the server's tracking
  ;; HashMap until idle-timeout. Heap dump 2026-06-21 showed 27,955
  ;; byte[] (1.7 GB) across ~969 long-lived channels — 90.83% of heap.
  ;; Tradeoff: per-request TCP handshake. A smarter policy (close only
  ;; after heavy endpoints) is now a graph edit: swap this node in a
  ;; custom process-response chain.
  {:name :_resp-connection-closed
   :description "Step 2 — the blanket `Connection: close` policy (heap-leak guard; see comment). Graph-visible so a deployment can compose a chain without it."
   :parent :assoc-in
   :args {:m :_resp-headers-stringified
          :path {:value [:headers "Connection"]}
          :v {:value "close"}}}

  {:name :process-response
   :description "Full response post-process: stringify keyword header keys → inject the `Connection: close` policy → content-negotiated encoding (`:encode-response`). Pure graph composition; free args `:request`, `:response`."
   :parent :encode-response
   :args {:unencoded-response :_resp-connection-closed}
   :return-type :ring-response-shape}

  ;; --- :encode-response — the encode decision + application ---

  {:name :_enc-resp-headers
   :description "Header map of the response under consideration."
   :parent :get
   :args {:coll {:as :unencoded-response :type :ring-response-shape}
          :key {:value :headers}}}

  {:name :_enc-prior-encoding
   :description "`Content-Encoding` already present on the response (nil when none)."
   :parent :header-get
   :args {:headers :_enc-resp-headers
          :header-name {:value "Content-Encoding"}}}

  {:name :_enc-content-type
   :description "Response `Content-Type`, defaulted to \"\" for the regex test."
   :parent :coalesce
   :args {:value :_enc-content-type-raw
          :default {:value ""}}}

  {:name :_enc-content-type-raw
   :parent :header-get
   :args {:headers :_enc-resp-headers
          :header-name {:value "Content-Type"}}}

  {:name :_enc-encoding
   :description "Negotiated coding for this request — `br` / `gzip` / `identity`."
   :parent :pick-encoding
   :args {:headers :ring-headers}}

  {:name :_enc-wanted?
   :description "Client accepts a real coding (not `identity`)."
   :parent :not
   :args {:value :_enc-identity?}}

  {:name :_enc-identity?
   :parent :equal?
   :args {:a :_enc-encoding
          :b {:value "identity"}}}

  {:name :_enc-not-already-encoded?
   :parent :nil?
   :args {:value :_enc-prior-encoding}}

  {:name :_enc-compressible?
   :description "Content-Type matches the compressible pattern. The pattern is a graph-visible slot (`:compressible-pattern`) with the platform default."
   :parent :re-find?
   :args {:string :_enc-content-type
          :pattern {:as :compressible-pattern :type :text}}}

  {:name :_enc-raw
   :description "Response body as UTF-8 bytes (nil for non-string/bytes bodies)."
   :parent :utf8-bytes
   :args {:value :_enc-body}}

  {:name :_enc-body
   :parent :get
   :args {:coll {:as :unencoded-response :type :ring-response-shape}
          :key {:value :body}}}

  {:name :_enc-raw-some?
   :parent :some?
   :args {:value :_enc-raw}}

  {:name :_enc-raw-size
   :parent :byte-count
   :args {:bytes :_enc-raw}}

  {:name :_enc-raw-size-nz
   :description "Byte count with the nil case (non-string/bytes body) collapsed to 0 — `:gte` wants `:numeric`, and 0 is always under the threshold."
   :parent :coalesce
   :args {:value :_enc-raw-size
          :default {:value 0}}}

  {:name :_enc-min-size
   :description "The `:min-encode-size` threshold surfaced as a scalar `:const` node — an `{:as …}` rename inside a sequence literal doesn't register as a closure-capture seed."
   :parent :const
   :args {:value {:as :min-encode-size :type :int}}}

  {:name :_enc-size-ok?
   :description "Body at least `:min-encode-size` bytes — smaller payloads aren't worth the CPU + header overhead."
   :parent :gte
   :args {:nums [:_enc-raw-size-nz :_enc-min-size]}}

  ;; Order matters: `:and` short-circuits, so `:_enc-size-ok?` (which
  ;; compares against a possibly-nil byte count) is only forced after
  ;; `:_enc-raw-some?` has proven the bytes exist.
  {:name :_enc-should?
   :description "The encode decision — wanted ∧ not-already-encoded ∧ compressible ∧ body-is-bytes ∧ over-threshold."
   :parent :and
   :args {:values [:_enc-wanted? :_enc-not-already-encoded? :_enc-compressible?
                   :_enc-raw-some? :_enc-size-ok?]}}

  {:name :_enc-br?
   :parent :equal?
   :args {:a :_enc-encoding
          :b {:value "br"}}}

  {:name :_enc-brotli
   :parent :brotli-bytes
   :args {:raw :_enc-raw
          :quality {:as :brotli-quality :type :int}}}

  {:name :_enc-gzip
   :parent :gzip-bytes
   :args {:raw :_enc-raw}}

  {:name :_enc-compressed
   :description "Compressed body bytes — brotli when negotiated, else gzip (`:_enc-should?` already guaranteed a real coding)."
   :parent :if
   :args {:test :_enc-br?
          :then :_enc-brotli
          :else :_enc-gzip}}

  {:name :_enc-compressed-size-text
   :parent :to-str
   :args {:value :_enc-compressed-size}}

  {:name :_enc-compressed-size
   :parent :byte-count
   :args {:bytes :_enc-compressed}}

  ;; Vary handling: append `Accept-Encoding` to an existing Vary
  ;; header, else set it — proxies must key their cache on the
  ;; request coding once the body is negotiated.
  {:name :_enc-vary-existing
   :parent :get
   :args {:coll :_enc-resp-headers
          :key {:value "Vary"}}}

  {:name :_enc-vary-present?
   :parent :some?
   :args {:value :_enc-vary-existing}}

  {:name :_enc-vary-appended
   :parent :str
   :args {:parts [:_enc-vary-existing {:value ", Accept-Encoding"}]}}

  {:name :_enc-vary-value
   :parent :if
   :args {:test :_enc-vary-present?
          :then :_enc-vary-appended
          :else {:value "Accept-Encoding"}}}

  {:name :_enc-headers-with-ce
   :parent :assoc
   :args {:map :_enc-resp-headers
          :key {:value "Content-Encoding"}
          :value :_enc-encoding}}

  {:name :_enc-headers-with-len
   :parent :assoc
   :args {:map :_enc-headers-with-ce
          :key {:value "Content-Length"}
          :value :_enc-compressed-size-text}}

  {:name :_enc-headers-encoded
   :parent :assoc
   :args {:map :_enc-headers-with-len
          :key {:value "Vary"}
          :value :_enc-vary-value}}

  ;; The encode decision is applied FIELD-WISE (`:if` per field, same
  ;; `:_enc-should?` test — result-cached, evaluated once) rather than
  ;; as a whole-response branch: a passthrough branch binding the
  ;; `:response` free arg directly would shadow-collide with the raw
  ;; `:response` of the stringify chain when `:process-response` binds
  ;; one into the other.
  {:name :_enc-final-body
   :parent :if
   :args {:test :_enc-should?
          :then :_enc-compressed
          :else :_enc-body}}

  {:name :_enc-final-headers
   :parent :if
   :args {:test :_enc-should?
          :then :_enc-headers-encoded
          :else :_enc-resp-headers}}

  {:name :_enc-with-body
   :parent :assoc
   :args {:map {:as :unencoded-response :type :ring-response-shape}
          :key {:value :body}
          :value :_enc-final-body}}

  {:name :_enc-final
   :description "The response with the (maybe-)encoded body + headers written back."
   :parent :assoc
   :args {:map :_enc-with-body
          :key {:value :headers}
          :value :_enc-final-headers}}

  ;; The compressed `:body` is a byte[] (`:any` — the graph has no
  ;; bytes type): a valid http-kit body but not provably `:text`, so
  ;; the computed record isn't a provable subtype of the response
  ;; shape. The author `:type` assertion states it still satisfies it.
  {:name :encode-response
   :description "Content-negotiated response encoding: compress `:body` with the coding the request advertises (`br` > `gzip` > identity) when the response is compressible (`:compressible-pattern`), not already encoded, and at least `:min-encode-size` bytes. The triggers are bound slots — a deployment tunes them by composing a variant, no Clojure change. Free args: `:request`, `:unencoded-response` (named distinctly from `:process-response`'s raw `:response` so binding one into the other can't shadow-collide)."
   :parent :const
   :args {:value {:ref :_enc-final :type :ring-response-shape}
          :compressible-pattern {:value "(?i)\\b(?:json|text|javascript|xml|svg|html)\\b"}
          :min-encode-size {:value 1024}
          :brotli-quality {:value 6}}
   :return-type :ring-response-shape}

  ;; =============================================================================
  ;; IMMUTABLE-RESPONSE CACHE — composed entirely from the generic state
  ;; primitives (`:cell` / `:reset` / `:deref`), NOT a bespoke impl.
  ;;
  ;;   store = (reset! cell (assoc (if over-cap? {} (deref cell)) key value))
  ;;   get   = (get (deref cell) key)
  ;;
  ;; The capacity-eviction (flush-all at 64) is a graph `:if`/`:count`,
  ;; the store a `:deref` + `:assoc` + `:reset`, the read a `:deref` +
  ;; `:get`. Nothing lives in Clojure — a user can build the same cache
  ;; for their own graph.
  ;;
  ;; ORG-SAFETY: only `Cache-Control: immutable` responses are ever
  ;; stored (see `:response-cache-wrap`'s `:_fresh-immutable?` gate), and
  ;; those are exclusively the content-hash-versioned static asset
  ;; bundles — byte-identical for every org, carrying no tenant data. So
  ;; a single shared cell across the platform handler leaks nothing.
  ;; =============================================================================

  {:name :response-cache-cell
   :description "Persistent per-registry map `{key → cached-response}`. A `:cell`, so the SAME atom backs every request this compiled registry serves (per-JVM for the server handler); NOT shared across executor instances. Only immutable static-asset responses are ever stored here (org-agnostic — no tenant data)."
   :parent :cell
   :args {:initial-value {:value {}}}}

  {:name :_response-cache-current
   :description "Current cache-map snapshot for this request — `(deref cell)`."
   :parent :deref
   :args {:a :response-cache-cell}}

  {:name :response-cache-get
   :description "Lookup the per-registry immutable-response cache — `(get (deref cell) key)`. Returns the stored Ring response (already post-process) or nil on miss."
   :parent :get
   :args {:coll :_response-cache-current
          :key {:as :key :type [:list :any]}
          :default {:value nil}}
   :return-type [:union :null :ring-response-shape]}

  ;; --- store: (reset! cell (assoc (if over-cap? {} (deref cell)) key value)) ---
  ;; `:reset` (not `:swap`) on purpose: the new map is composed with the
  ;; response `:value` as an ORDINARY `:assoc` binding, so the layout's
  ;; free-arg walker traces `:base-handler` (carried by the response)
  ;; through to its use-site. A `:swap` callback would closure-capture
  ;; `:value`, hiding that flow from the HOF-blind layout walker. The
  ;; cache is idempotent (same key → same immutable-asset bytes), so a
  ;; lost concurrent write is harmless. The eviction (`:if`) picks
  ;; between two ASSOC results — both concrete maps — rather than
  ;; assoc-ing into `(if over-cap {} current)`, which would union
  ;; `:empty-map` with the map type and fail `:assoc`'s `[:map …]` slot.

  {:name :_cache-current-count
   :description "Number of entries in the current cache map."
   :parent :count
   :args {:coll :_response-cache-current}}

  {:name :_cache-over-capacity?
   :description "True once the cache holds ≥ 64 entries — the flush-all trigger (matches the old capacity constant)."
   :parent :gte
   :args {:nums [:_cache-current-count {:value 64}]}}

  {:name :_cache-store-into-current
   :description "`(assoc (deref cell) key value)` — the normal path, below capacity."
   :parent :assoc
   :args {:map :_response-cache-current
          :key {:as :key :type [:list :any]}
          :value {:as :value :type :ring-response-shape}}}

  {:name :_cache-store-fresh
   :description "`(assoc {} key value)` — the flush-all path: start from an empty map when at capacity."
   :parent :assoc-empty
   :args {:key {:as :key :type [:list :any]}
          :value {:as :value :type :ring-response-shape}}}

  {:name :_cache-updated
   :description "The next cache map: flush-all-then-assoc at capacity, else assoc into the current map."
   :parent :if
   :args {:test :_cache-over-capacity?
          :then :_cache-store-fresh
          :else :_cache-store-into-current}}

  {:name :_response-cache-store
   :description "Install the updated cache map into the cell (`reset!`). The response `:value` reaches `:assoc` as an ordinary binding, so the layout can trace `:base-handler` to its use-site."
   :parent :reset
   :args {:a :response-cache-cell
          :v :_cache-updated}}

  {:name :_response-cache-maybe-store
   :description "Store the response only when `:when?` is truthy (the immutable trigger), else no-op. The `:if`'s result is discarded — this node exists for its store side-effect."
   :parent :if
   :args {:test {:as :when? :type :nullable-bool}
          :then :_response-cache-store
          :else {:value nil}}}

  ;; put-if! is a `:do` (NOT an `:if`): force the conditional store for
  ;; its side-effect, then yield `:value`. Keeping the top node a `:do`
  ;; — rather than an `:if` nested directly inside the wrap's own `:if`
  ;; (`:response-cache-wrap`) — keeps the editor's expansion/`:base-
  ;; handler` migration well-formed (an `:if` sitting immediately under
  ;; another `:if`'s branch confuses the layout's node attribution).
  {:name :response-cache-put-if!
   :description "If `:when?` is truthy, store `:value` under `:key` in the immutable-response cell; always return `:value`. The eviction + assoc are graph-visible (`:reset` over `:if`/`:count`/`:assoc`), not a bespoke impl."
   :parent :do
   :args {:steps [:_response-cache-maybe-store {:as :value}]}
   :return-type :ring-response-shape}

  {:name :response-immutable?
   :description "Predicate — does the response carry `Cache-Control: ... immutable ...`? Trigger for the response cache to remember the URL."
   :args {:response {:type :ring-response-shape
                     :description "Response to inspect."}}
   :return-type :nullable-bool}

  ;; =============================================================================
  ;; HANDLER-WRAP CHAIN — fn-def composition over :call + :if
  ;;
  ;; Each wrap has `:base-handler` as a free arg. Composition pins
  ;; it via plain fn-ref. The CALLER (app/server/fns.edn) builds the
  ;; chain by pinning `:base-handler` at each level.
  ;; =============================================================================

  ;; --- Smallest reusable unit: invoke the wrapped handler ---

  {:name :_call-base-handler
   :description "Invoke the wrapped `:base-handler` with the current `:request`. The leaf reused by every wrap below."
   :parent :call
   :args {:func {:as :base-handler :type [:fn {:request :ring-request-shape} :ring-response-shape]}
          :arg  {:as :request      :type :ring-request-shape}}}

  ;; --- realize-body wrap: slurps :body InputStream before the handler ---

  {:name :_realized-request
   :description "Request with `:body` slurped into a String."
   :parent :realize-request-body
   :args {:request {:as :request :type :ring-request-shape}}}

  {:name :realize-body-wrap
   :description "Handler wrap — slurps `:body InputStream` into a String, then invokes `:base-handler` with the realised request. Free args: `:base-handler`, `:request`."
   :parent :call
   :args {:func {:as :base-handler :type [:fn {:request :ring-request-shape} :ring-response-shape]}
          :arg  :_realized-request}
   :return-type :ring-response-shape}

  ;; --- encode-stringify wrap: post-processes the response ---

  {:name :encode-stringify-wrap
   :description "Handler wrap — invokes `:base-handler` and post-processes the response: stringify keyword header keys + maybe-encode body (`br` > `gzip` > identity from `Accept-Encoding`, only for compressible content-types over 1 KB). Free args: `:base-handler`, `:request`."
   :parent :process-response
   :args {:request  {:as :request :type :ring-request-shape}
          :response :_call-base-handler}
   :return-type :ring-response-shape}

  ;; --- response-cache wrap: short-circuit on `Cache-Control: immutable` ---
  ;;
  ;; Key is `[uri method accept-encoding]`. The cache stores POST-process
  ;; responses, so a HIT serves bytes directly — no executor work, no
  ;; encoding, no body realisation. MISS calls `:base-handler` (which
  ;; itself is the chain above), then stores iff `Cache-Control:
  ;; immutable`.

  {:name :_request-accept-encoding
   :description "Raw `Accept-Encoding` header from the request, or `\"\"`. Different headers (`br, gzip` vs `gzip`) land on different cache slots because they get different encoded bodies."
   :parent :get
   :args {:coll :ring-headers
          :key {:value "accept-encoding"}
          :default {:value ""}}}

  {:name :_request-query-string
   :description "Raw query string (e.g. `\"v=abc123\"`), or `\"\"`. Part of the cache key so hash-busted asset URLs cache PER `?v=` — an asset override rolls the effective hash, the new URL is a fresh key, and every node cache-misses into the new bytes without a cross-node flush."
   :parent :get
   :args {:coll {:ref :ring-request :type :ring-request-shape}
          :key {:value :query-string}
          :default {:value ""}}}

  {:name :_response-cache-key
   :description "`[uri method accept-encoding query-string]` — distinguishes one cached response from another. The query string is load-bearing: static assets carry `?v=<effective-hash>`, so a rolled hash (deploy OR asset override) is a new key and the stale entry is simply never requested again — correct across every node without a shared flush."
   :parent :list
   :args {:items [:ring-uri :ring-method :_request-accept-encoding :_request-query-string]}}

  {:name :_cached-response
   :description "Cache lookup result for the current request — nil on miss."
   :parent :response-cache-get
   :args {:key :_response-cache-key}}

  {:name :_cache-hit?
   :description "True iff the cache lookup returned a stored response."
   :parent :some?
   :args {:value :_cached-response}}

  {:name :_fresh-response
   :description "Run the wrapped handler chain to produce a fresh, fully-processed response (used only on cache miss)."
   :parent :encode-stringify-wrap
   :args {:base-handler {:as :base-handler}}}

  {:name :_fresh-immutable?
   :description "Whether the fresh response should be cached for later hits."
   :parent :response-immutable?
   :args {:response :_fresh-response}}

  {:name :_fresh-with-maybe-store
   :description "Compute the fresh response and conditionally store it under the cache key. Returns the response either way."
   :parent :response-cache-put-if!
   :args {:key   :_response-cache-key
          :value :_fresh-response
          :when? :_fresh-immutable?}}

  {:name :response-cache-wrap
   :description "Outermost handler wrap. On cache HIT serves the stored response verbatim — no executor work, no encoding, no body realisation. On MISS calls `:base-handler` to produce a fresh response, then stores iff the response is `Cache-Control: immutable`. Free args: `:base-handler` (the inner chain — typically `:realize-body-wrap` over the app handler), `:request`."
   :parent :if
   :args {:test :_cache-hit?
          :then :_cached-response
          :else :_fresh-with-maybe-store
          :base-handler {:type [:fn {:request :ring-request-shape} :ring-response-shape]
                         :description "Inner handler chain. NOT called on cache hit."}
          :request {:as :request :type :ring-request-shape}}
   :return-type :ring-response-shape}]}
