;; The most painful trap in fn-def composition: an inline vector with
;; fn-refs does NOT resolve them when the receiving slot is `:jsonb`-typed.
;;
;; Two arg shapes carry collections in graphden. They look identical when
;; you write them, but they behave differently:
;;
;;   `:type :sequence` — each item becomes its OWN arg-entity, chained
;;                       via `next-arg-id`. Fn-refs in items DO resolve.
;;                       Used by `:list/:items` and a few others.
;;
;;   `:type :jsonb`    — the whole vector is ONE arg-entity, stored as a
;;                       JSONB blob. Keywords inside are DATA, not fn-refs.
;;                       Used by `:str/:parts`, `:concat/:colls`,
;;                       `:transduce/:coll`, and most "vector of values"
;;                       slots.
;;
;; Symptom when you confuse them: the keyword shows up *as a string* in
;; output ("`:_my-helper{:value \"!\"}`"), or `concat` throws
;; `Don't know how to create ISeq from: clojure.lang.Keyword` because
;; it's literally trying to iterate a keyword.
;;
;; Fix: when you need to mix literals and fn-refs, build the collection
;; via a `:list`-parented helper FIRST, then pass that single fn-ref
;; into the `:jsonb` slot.


{:namespace "examples.sequence-vs-jsonb"
 :description "The `:jsonb` vs `:sequence` trap — why mixing fn-refs and literals inline only works for sequence-typed slots."
 :fns
 [;; ✅ WORKS: `:list/:items` is `:type :sequence`. Each item is a
  ;; separate arg-entity, fn-refs resolve. The result is `[100 1 200]`.
  {:name :ex-seq-list
   :description "`:list` with `[lit ref lit]`. The middle keyword `:_ex-mid` is a real fn-ref and resolves to 1. Result: `[100 1 200]`. This is the SHAPE that supports mixed items."
   :parent :list
   :args {:items [{:value 100}
                  :_ex-mid
                  {:value 200}]}}

  {:name :_ex-mid
   :parent :const
   :args {:value 1}}

  ;; ✅ WORKS: `:str/:parts` is `:jsonb`, but here we feed a SINGLE fn-ref
  ;; to a `:list` helper. The helper returns a vector; `:str` stringifies it.
  {:name :ex-jsonb-via-list
   :description "Correct way to put mixed items into a `:jsonb` slot: build the vector via a `:list` helper, then pass the helper's fn-ref. Result: `\"100 then 200\"` (or similar — `:str` concatenates whatever `:list` yields)."
   :parent :str
   :args {:parts :_ex-jsonb-via-list-parts}}

  {:name :_ex-jsonb-via-list-parts
   :parent :list
   :args {:items [:_ex-prefix
                  {:value " then "}
                  :_ex-suffix]}}

  {:name :_ex-prefix
   :parent :const
   :args {:value "100"}}

  {:name :_ex-suffix
   :parent :const
   :args {:value "200"}}

  ;; ❌ BROKEN: same shape but inline in `:str/:parts` directly.
  ;; Demonstrates the trap. Loads fine, executes — but the `:_ex-prefix`
  ;; and `:_ex-suffix` keywords are treated as DATA inside the JSONB blob.
  ;; The result is something like `":_ex-prefix{:value \" then \"}:_ex-suffix"`:
  ;; the keywords stringified literally, not resolved.
  ;;
  ;; Kept as a learning fixture — execute it once and read the output to
  ;; understand the failure mode at a glance.
  {:name :ex-jsonb-broken-inline
   :description "ANTI-PATTERN — DO NOT COPY. Inline vector in `:str/:parts` (a `:jsonb` slot). The keywords `:_ex-prefix` and `:_ex-suffix` are stored as data, not resolved as fn-refs. Execute it to see the failure mode in the output. Compare with `:ex-jsonb-via-list` for the fix."
   :parent :str
   :args {:parts [:_ex-prefix
                  {:value " then "}
                  :_ex-suffix]}}]}
