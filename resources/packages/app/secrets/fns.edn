   :description "Static 400 rejection — required `:path` field missing/blank. Shared between create-secret + inline-bind."
   :parent :const
   :return-type :_error-result-shape
   :args {:value {:ok false :error "Required field ':path' is missing"}}}

  {:name :_err-value-missing
   :description "Static 400 rejection — required `:value` field missing. Shared between create-secret + inline-bind + rotate-secret."
   :parent :const
   :return-type :_error-result-shape
   :args {:value {:ok false :error "Required field ':value' (string) is missing"}}}

  {:name :_create-secret-err-leaf-missing
   :parent :const
   :return-type :_error-result-shape
   :args {:value {:ok false :error ":secret-leaf base-fn missing — package web.vault not loaded"}}}

  {:name :_create-secret-data
   :description "POST /api/secrets — flat `:cond` of 5 guards + apply. Lazy short-circuit means vault-put + graphden writes only run when every guard passes."
   :parent :cond
   :args {:clauses [:_create-secret-name-blank?    :_err-name-blank
                    :_create-secret-path-blank?    :_err-path-blank
                    :_create-secret-value-missing? :_err-value-missing
                    :_create-secret-leaf-missing?  :_create-secret-err-leaf-missing
                    :_create-secret-name-taken?    :_create-secret-name-taken-error
                    {:value true}                  :_create-secret-apply]
          :parsed :_create-secret-parsed
          :leaf-id :_secret-leaf-fn-id}}

  {:name :create-secret-handler
   :description "Ring handler for POST /api/secrets (auth-required)."
   :parent :json-handler
   :args {:data :_create-secret-data}}

