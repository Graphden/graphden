  {:name :_inline-bind-body
   :description "Parsed JSON body of POST /api/secret-bindings — `{:fn-id :slot-id :path :value}`."
   :parent :parse-json-body}

  {:name :_inline-bind-fn-id-raw
   :parent :get :args {:coll :_inline-bind-body :key {:value :fn-id} :default nil}}

  {:name :_inline-bind-slot-id-raw
   :parent :get :args {:coll :_inline-bind-body :key {:value :slot-id} :default nil}}

  {:name :_inline-bind-path-raw
   :parent :get :args {:coll :_inline-bind-body :key {:value :path} :default nil}}

  {:name :_inline-bind-path-str
   :description "`(str path)` — coerces nil / non-string to a string; nil becomes \"\"."
