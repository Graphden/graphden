;; Refinement / union / variant type declarations + runtime narrowing.
;;
;; Each refinement is a fn-row with `:refine {:base T :constraint C}`;
;; sync-time type-check rejects literal values that violate C, and
;; rejects passing a base-typed value where a refinement is expected
;; (forcing an explicit `:ensure-X` conversion).
;;
;; Each `:ensure-X` is a base-fn that re-validates at runtime and
;; returns the value or throws — see impls.clj.
;;
;; Recognised constraint shapes (sync-time literal checks):
;;   [:>  N]   [:>= N]   [:<  N]   [:<= N]   [:=  N]   [:not= V]
;;   [:in #{vs…}]
;;   [:and c1 c2 …]   [:or c1 c2 …]
;; Unknown shapes are accepted (sync-only, runtime catches the rest).


{:namespace "core.refinements"
 :description "Refinement / union / variant type declarations plus runtime narrowing base-fns."
 :fns
 [;; ---------------------------------------------------------------------
  ;; Refinement-typed declarations (formerly aliases.edn).
  ;; ---------------------------------------------------------------------

  {:name :positive-int
   :refine {:base :int :constraint [:> 0]}}

  {:name :non-negative-int
   :refine {:base :int :constraint [:>= 0]}}

  {:name :negative-int
   :refine {:base :int :constraint [:< 0]}}

  {:name :non-empty-text
   :refine {:base :text :constraint [:not= ""]}}

  {:name :non-blank-text
   :refine {:base :text :constraint [:matches "\\S"]}}

  {:name :url
   :refine {:base :text :constraint [:matches "^https?://"]}}

  {:name :positive-numeric
   :refine {:base :numeric :constraint [:> 0]}}

  {:name :percent
   :refine {:base :numeric :constraint [:and [:>= 0] [:<= 100]]}}

  {:name :probability
   :refine {:base :numeric :constraint [:and [:>= 0] [:<= 1]]}}

  {:name :port
   :refine {:base :int :constraint [:and [:>= 1] [:<= 65535]]}}

  {:name :user-port
   :refine {:base :int :constraint [:and [:>= 1024] [:<= 65535]]}}

  {:name :http-status
   :refine {:base :int :constraint [:and [:>= 100] [:<= 599]]}}

  {:name :bit
   :refine {:base :int :constraint [:or [:= 0] [:= 1]]}}

  ;; ---------------------------------------------------------------------
  ;; Union types — `[T1 T2 …]`. A value satisfies the union iff it
  ;; satisfies at least one branch.
  ;; ---------------------------------------------------------------------
  ;;
  ;; Only `:nullable-text` ships as an alias (12+ sites in the standard
  ;; packages — `:env`, `:bearer-token`, `:auth-token-from-env`, …).
  ;; The other shapes (`:nullable-int`, `:nullable-bool`,
  ;; `:nullable-numeric`, `:nullable-uuid`) had ZERO real uses and
  ;; were retired to keep the alias set tight — write `[:union :null T]`
  ;; inline when needed; it's three keywords, not worth a named row.

  {:name :nullable-text     :union [:null :text]}

  ;; ---------------------------------------------------------------------
  ;; Variant types — Result-style discriminated unions. Each branch is
  ;; `:tag T`; runtime discriminates by value's `:tag` field.
  ;; ---------------------------------------------------------------------

  {:name :result-text   :variant [:ok :text :err :text]}
  {:name :result-int    :variant [:ok :int  :err :text]}
  {:name :validation    :variant [:valid :any :invalid :text]}

  ;; ---------------------------------------------------------------------
  ;; Runtime narrowing — generic template + per-refinement specialisations.
  ;;
  ;; Each `:ensure-*` is now a fn-def composing the shared
  ;; `:_refinement-narrow` template with its own `:test`, `:refine-name`,
  ;; and `:constraint`. Admins can declare a new `:ensure-X` for any
  ;; user-defined refinement by `:parent`-ing `:_refinement-narrow` and
  ;; supplying the three binding args. The `:refinement/violated`
  ;; ex-info shape stays identical to what the previous defbase impls
  ;; threw, so callers and tests see no behavioural change.
  ;; ---------------------------------------------------------------------

  {:name :_refinement-violation-message
   :description "Human-readable violation message — `\"Refinement :foo violated: 42 doesn't satisfy [:> 100]\"`. Free args: `:refine-name`, `:value`, `:constraint`."
   :parent :str
   :args {:parts ["Refinement "
                  {:parent :pr-str :args {:value {:as :refine-name}}}
                  " violated: "
                  {:parent :pr-str :args {:value {:as :value}}}
                  " doesn't satisfy "
                  {:parent :pr-str :args {:value {:as :constraint}}}]}}

  {:name :_refinement-violation-data
   :description "`:ex-data` payload — `{:type :refinement/violated :refine-name … :constraint … :value …}`. Same shape the previous `violated!` helper built."
   :parent :zipmap
   :args {:keys [{:value :type} {:value :refine-name} {:value :constraint} {:value :value}]
          :vals [{:value :refinement/violated}
                 {:as :refine-name}
                 {:as :constraint}
                 {:as :value}]}}

  {:name :_refinement-violation-ex
   :description "Construct the `ExceptionInfo` from message + data so `:throw` can raise it."
   :parent :ex-info
   :args {:message :_refinement-violation-message
          :data :_refinement-violation-data}}

  {:name :_refinement-narrow
   :description "Generic refinement narrower — if `:test` is truthy, return `:value`; otherwise throw the standard `:refinement/violated` ex-info naming `:refine-name` and the original `:constraint` shape. Lazy via `:if` (test passes → no `:ex-info` build, no `:throw`). Admins create a new narrower by `:parent`-ing this fn-def and binding `:test` + `:refine-name` + `:constraint`."
   :parent :if
   :args {:test {:as :test}
          :then {:as :value}
          :else {:parent :throw :args {:exception :_refinement-violation-ex}}}}

  ;; ---------------------------------------------------------------------
  ;; The seven shipped narrowers, written via the template.
  ;; ---------------------------------------------------------------------

  {:name :ensure-positive-int
   :description "Validate that `:value` is an `:int` and `> 0`; return as `:positive-int`. Throws `refinement/violated` otherwise."
   :parent :_refinement-narrow
   :return-type :positive-int
   :args {:test {:parent :and
                 :args {:values [{:parent :is-a? :args {:type {:value :int} :value {:as :value}}}
                                 {:parent :gt :args {:nums [{:as :value} 0]}}]}}
          :refine-name {:value :positive-int}
          :constraint [:> 0]}}

  {:name :ensure-non-empty-text
   :description "Validate that `:value` is a non-empty `:text`; return as `:non-empty-text`. Throws `refinement/violated` otherwise."
   :parent :_refinement-narrow
   :return-type :non-empty-text
   :args {:test {:parent :and
                 :args {:values [{:parent :is-a? :args {:type {:value :text} :value {:as :value}}}
                                 {:parent :neq :args {:values [{:as :value} {:value ""}]}}]}}
          :refine-name {:value :non-empty-text}
          :constraint [:not= ""]}}]}
