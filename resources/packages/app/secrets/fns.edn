;; HTTP endpoints for the admin-side Secrets CRUD.
;;
;; Each operation has two declarations:
;; - a `:_*-data` base-fn (thin shim calling `graphden.crud.secrets`)
;; - a `*-handler` fn-def that wraps the data fn via `:json-handler`
;;   (200 application/json). Concrete routes live in `app.routes`,
;;   wired with the auth-required middleware.
;;
;; Secret VALUES never appear on these endpoints' responses — only
;; metadata (path, created-at, version, description). The actual
;; secret stays in OpenBao; the executor auto-derefs the path at
;; arg-resolution time when a `:secret-leaf`-parented fn-def is
;; executed.


{:namespace "app.secrets"
 :description "Admin-side endpoints for the Secrets-panel CRUD — list / create / rotate / delete. Backed by `graphden.crud.secrets`."
 :fns
 [;; ---------------------------------------------------------------------
  ;; :secret-fn? — shared pure-secret predicate.
  ;;
  ;; True iff `fn-row.parent-ids = [secret-leaf-id]`. Multi-inheritance
  ;; children that mix `:secret-leaf` with a second parent don't count
  ;; — they're regular composed fn-defs, not admin-managed secrets.
  ;;
  ;; Reused by:
  ;;   - GET /api/secrets — per-row filter (only show pure secrets).
  ;;   - DELETE /api/secrets/:id — `not-a-secret?` guard.
  ;;   - POST /api/secrets/:id/rotate — `not-a-secret?` guard.
  ;;
  ;; Admins who want MI-children visible / deletable can declare a
  ;; sibling predicate (e.g. `:secret-or-mi-fn?`) and swap call sites.
  ;; ---------------------------------------------------------------------
  {:name :secret-fn?
   :description "True iff `fn-row`'s `:parent-ids` is exactly `[secret-leaf-id]` — a pure-secret check that excludes MI-children."
   :parent :equal?
   :args {:a {:parent :get
              :args {:coll {:as :fn-row}
                     :key {:value :parent-ids}
                     :default nil}}
          :b {:parent :vec
              :args {:coll [{:as :secret-leaf-id}]}}
          :fn-row {:type :nullable-keyword-map
                   :description "fn entity row — `:parent-ids` is read to test pure-secret membership."}
          :secret-leaf-id {:type :uuid
                           :description "fn-id of `:secret-leaf` (the parent every secret fn-def inherits from)."}}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/secrets — list every secret-shaped fn-def with OpenBao
  ;; metadata (no values). Authentication required.
  ;; ---------------------------------------------------------------------

  ;; --- :query-ref-many-owners — reverse-lookup primitive. Finds
  ;; rows whose ref-many field contains a target id. General-purpose;
  ;; used here for "fns whose parent-ids include :secret-leaf".
  ;; `:query-ref-many-owners` migrated to `web/crud/fns.edn` so the
  ;; web layer (specifically the in-use guard on DELETE /api/entities/fn)
  ;; can reference it without pulling app as a dependency.

  ;; --- :shape-secret — per-secret JSON shape with vault enrichment.
  ;;
  ;; Pure graph composition: lookup the OpenBao path from the `:in`
  ;; binding row, read vault metadata (downgrade failures to nil),
  ;; merge into a fixed response shape. Admins who want a different
  ;; per-row shape parent :shape-secret and override `:_shape-secret-
  ;; base` / `:_shape-secret-enrichment` in their fn-def — or swap
  ;; `:_list-secrets-shape-row`'s `:parent` to a custom builder
  ;; entirely without writing any Clojure.

  {:name :_shape-secret-fn-id
   :description "Stage 1a — pull the fn-row's :id (used as both the binding-lookup filter and the wire-side string id)."
   :parent :get
   :args {:coll {:as :fn-row :type :nullable-keyword-map :description "Secret fn-row from storage."}
          :key {:value :id}
          :default nil}}

  ;; Phase 3: `:binding`'s `:fn-id` and `:slot-id` are both
  ;; version-data, so the post-resolve predicate ANDs equality on
  ;; both fields. Both compare against closure-captured args from
  ;; `:shape-secret`'s outer scope — `:_shape-secret-fn-id` (derived
  ;; from `:fn-row`) and the propagated `:path-slot-id`.
  {:name :_shape-secret-bindings
   :description "Stage 1c — all binding rows matching the (fn-id, path-slot-id) pair. The `:in` slot is single-valued so the list has 0 or 1 entries."
   :parent :filter
   :args {:pred :_shape-secret-binding-matches?
          :coll :_shape-secret-bindings-resolved}}

  {:name :_shape-secret-bindings-resolved
   :parent :resolve-binding-rows
   :args {:identities :_shape-secret-bindings-identities
          :branch-chain :current-branch-chain}}

  {:name :_shape-secret-bindings-identities
   :parent :storage-query-identities
   :args {:entity-type {:value "binding"}}}

  {:name :_shape-secret-binding-matches?
   :parent :and
   :args {:values [:_shape-secret-binding-fn-id-eq?
                   :_shape-secret-binding-slot-id-eq?]}}

  {:name :_shape-secret-binding-fn-id-eq?
   :parent :equal?
   :args {:a {:parent :get :args {:coll {:as :item} :key {:value :fn-id} :default nil}}
          :b :_shape-secret-fn-id}}

  {:name :_shape-secret-binding-slot-id-eq?
   :parent :equal?
   :args {:a {:parent :get :args {:coll {:as :item} :key {:value :slot-id} :default nil}}
          :b {:as :path-slot-id :type :uuid :description "Slot id of the `:in` parameter on `:secret-leaf`."}}}

  {:name :_shape-secret-binding-row
   :description "Stage 1d — the single binding row (nil if no row exists)."
   :parent :first
   :args {:coll :_shape-secret-bindings}}

  {:name :_shape-secret-path
   :description "Stage 1e — OpenBao path stored in the binding's `:value` column. nil if the binding row is absent."
   :parent :get
   :args {:coll :_shape-secret-binding-row
          :key {:value :value}
          :default nil}}

  {:name :_shape-secret-metadata-attempt
   :description "Stage 2a — vault metadata read; on vault failure (path missing, network down) downgrade to nil so the row still surfaces in the listing."
   :parent :try
   :args {:body {:parent :vault-metadata-get
                 :args {:path :_shape-secret-path}}
          :on-throw {:parent :const :args {:value nil}}}}

  {:name :_shape-secret-metadata
   :description "Stage 2b — vault metadata, or nil when the path is missing entirely (skip the vault call to avoid spurious `path is required` errors)."
   :parent :if
   :args {:test {:parent :some? :args {:value :_shape-secret-path}}
          :then :_shape-secret-metadata-attempt
          :else {:value nil}}}

  {:name :_shape-secret-ns-id-raw
   :description "Stage 3a — fn-row's `:namespace-id` (nullable uuid)."
   :parent :get
   :args {:coll {:as :fn-row} :key {:value :namespace-id} :default nil}}

  {:name :_shape-secret-ns-id-str
   :description "Stage 3b — stringified namespace-id, or nil when the fn lives at the root namespace. Preserves the original `(some-> (:namespace-id fn-row) str)` semantics — `:to-str` of nil would have surfaced as the empty string instead of nil."
   :parent :if
   :args {:test {:parent :some? :args {:value :_shape-secret-ns-id-raw}}
          :then {:parent :to-str :args {:value :_shape-secret-ns-id-raw}}
          :else {:value nil}}}

  {:name :_shape-secret-base
   :description "Stage 3c — the canonical secret shape carried by every row, regardless of vault state. Keys are zipmap'd against the per-field readers + the literal `\"secret-leaf\"` discriminator."
   :parent :zipmap
   :args {:keys [{:value :id} {:value :name} {:value :namespace-id}
                 {:value :description} {:value :path} {:value :shape}]
          :vals [{:parent :to-str :args {:value :_shape-secret-fn-id}}
                 {:parent :get :args {:coll {:as :fn-row} :key {:value :name} :default nil}}
                 :_shape-secret-ns-id-str
                 {:parent :get :args {:coll {:as :fn-row} :key {:value :description} :default nil}}
                 :_shape-secret-path
                 {:value "secret-leaf"}]}}

  {:name :_shape-secret-enrichment-then
   :description "Stage 3d — the four metadata fields (snake_case from vault → kebab-case on the wire) when metadata is non-nil."
   :parent :zipmap
   :args {:keys [{:value :created-at} {:value :updated-at}
                 {:value :version} {:value :custom-metadata}]
          :vals [{:parent :get :args {:coll :_shape-secret-metadata :key {:value :created_time} :default nil}}
                 {:parent :get :args {:coll :_shape-secret-metadata :key {:value :updated_time} :default nil}}
                 {:parent :get :args {:coll :_shape-secret-metadata :key {:value :current_version} :default nil}}
                 {:parent :get :args {:coll :_shape-secret-metadata :key {:value :custom_metadata} :default nil}}]}}

  {:name :_shape-secret-enrichment
   :description "Stage 3e — metadata fields when vault returned something; empty map otherwise. The empty map is a no-op against `:merge` so the base shape passes through unchanged."
   :parent :if
   :args {:test {:parent :some? :args {:value :_shape-secret-metadata}}
          :then :_shape-secret-enrichment-then
          :else {:value {}}}}

  {:name :shape-secret
   :description "JSON-shape one secret fn-row — `{:id :name :namespace-id :description :path :shape}` plus optional `:created-at :updated-at :version :custom-metadata` when OpenBao metadata reads succeed."
   :parent :merge
   :args {:maps [:_shape-secret-base :_shape-secret-enrichment]
          :fn-row {:type :nullable-keyword-map
                   :description "fn entity row to shape — all `:_shape-secret-*` fragments read fields off it."}}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/secrets — graph decomposition.
  ;;
  ;; Pipeline:
  ;;   leaf-id        = first fn row named "secret-leaf"
  ;;   if missing     → `{:ok false :error "..."}`
  ;;   else
  ;;     owner-ids   = (query-ref-many-owners :fn :parent-ids leaf-id)
  ;;     candidates  = (list-entities :fn {:id [owner-ids]})
  ;;     filtered    = (filter is-pure-secret? candidates)
  ;;     shaped      = (map shape-secret-with-path filtered)
  ;;     return        `{:ok true :secrets shaped}`
  ;;
  ;; `is-pure-secret?` checks that fn-row's parent-ids is EXACTLY
  ;; `[secret-leaf-id]` (no MI siblings). Admin can swap this filter
  ;; to allow MI-children, name-prefixed children, etc.
  ;; ---------------------------------------------------------------------
  ;; Block 1 Step 2 Phase 3: `:fn` is versioned, `:name` lives in
  ;; the version-data overlay (not on the identity row), so the
  ;; name-filter has to run POST-resolve via `:filter` on the merged
  ;; rows.
  {:name :_list-secrets-leaf-rows
   :description "Find the `:secret-leaf` fn row(s) by name. Empty when `web.vault` isn't loaded."
   :parent :filter
   :args {:pred :_list-secrets-leaf-row-name-eq?
          :coll :_list-secrets-leaf-rows-resolved}}

  {:name :_list-secrets-leaf-rows-resolved
   :parent :resolve-fn-rows
   :args {:identities :_list-secrets-leaf-rows-identities
          :branch-chain :current-branch-chain}}

  {:name :_list-secrets-leaf-rows-identities
   :parent :storage-query-identities
   :args {:entity-type {:value "fn"}}}

  {:name :_list-secrets-leaf-row-name-eq?
   :parent :equal?
   :args {:a {:parent :get :args {:coll {:as :item} :key {:value :name} :default nil}}
          :b {:value "secret-leaf"}}}

  {:name :_list-secrets-leaf-row
   :parent :first
   :args {:coll :_list-secrets-leaf-rows}}

  {:name :_list-secrets-leaf-id
   :parent :get
   :args {:coll :_list-secrets-leaf-row :key {:value :id} :default nil}}

  ;; Find the `:in` slot id on `:secret-leaf`. The `:in` slot's
  ;; binding holds the OpenBao path; `:shape-secret` reads from it.
  ;;
  ;; PERF FIX (2026-06): replaced the all-identities scan with a
  ;; tailored `:pg-query` directly against `fn-slot-version`.
  ;;
  ;; Pre-fix: `:storage-query-identities` returned EVERY fn-slot id
  ;; (~8k on a real graph), then `:resolve-fn-slot-rows` walked each
  ;; identity through `:_rv-resolve-one` to fetch its version, then
  ;; `:filter` discarded everyone whose resolved `:fn-id` ≠ secret-
  ;; leaf-id. On the unit-test golden DB that came to ~130k
  ;; `call-with-cache` invocations and timed out the handler.
  ;;
  ;; Post-fix: the SQL WHERE constrains BOTH `:fn-id` (secret-leaf)
  ;; AND `:branch-id` (current chain) up front, so the storage scan
  ;; returns at most one row per branch level. The graph still
  ;; decodes the raw row via `:decode-row`, so the output shape is
  ;; the same `[{:fn-id … :slot-id … :position …}]` that
  ;; `:resolve-fn-slot-rows` produced — downstream consumers don't
  ;; change.
  ;;
  ;; This bypasses `:resolve-fn-slot-rows` for THIS reader only. The
  ;; generic resolve primitive stays the right tool for callers that
  ;; need branch-version walking; here, we only need rows for one
  ;; specific fn-id, so we can collapse the walk into one SQL call.
  {:name :_list-secrets-leaf-fn-slots
   :parent :map
   :args {:func :_list-secrets-leaf-fn-slots-decode
          :coll :_list-secrets-leaf-fn-slots-raw}}

  {:name :_list-secrets-leaf-fn-slots-raw
   :parent :pg-query
   :args {:hsql :_list-secrets-leaf-fn-slots-hsql}}

  {:name :_list-secrets-leaf-fn-slots-hsql
   :parent :assoc
   :args {:map {:value {:select [:*] :from :fn-slot-version}}
          :key {:value :where}
          :value :_list-secrets-leaf-fn-slots-hsql-where}}

  {:name :_list-secrets-leaf-fn-slots-hsql-where
   :parent :vec
   :args {:coll [{:value :and}
                 :_list-secrets-leaf-fn-slots-fn-id-clause
                 :_list-secrets-leaf-fn-slots-branch-clause]}}

  {:name :_list-secrets-leaf-fn-slots-fn-id-clause
   :parent :vec
   :args {:coll [{:value :=} {:value :fn-id} :_list-secrets-leaf-id]}}

  {:name :_list-secrets-leaf-fn-slots-branch-clause
   :parent :vec
   :args {:coll [{:value :in} {:value :branch-id} :current-branch-chain]}}

  {:name :_list-secrets-leaf-fn-slots-decode
   :parent :decode-row
   :return-type :fn-slot-version-row-shape
   :args {:row {:as :item} :entity-type {:value "fn-slot-version"}}}

  {:name :_list-secrets-leaf-slot-ids
   :description "Slot ids junction'd to the secret-leaf fn-id."
   :parent :map
   :args {:func :_list-secrets-extract-slot-id
          :coll :_list-secrets-leaf-fn-slots}}

  {:name :_list-secrets-extract-slot-id
   :parent :get
   :args {:coll {:as :item} :key {:value :slot-id} :default nil}}

  ;; Block 1 Step 2 migration: `:slot` IN-clause lookup goes through
  ;; `:pg-query` + per-row `:decode-row` directly. `:slot` is
  ;; immutable post-create (NOT in `versioning.storage.resolution/
  ;; entity-config`), so the version-resolution bypass is correct.
  {:name :_list-secrets-leaf-slots
   :parent :map
   :args {:func :_list-secrets-leaf-slots-decode-row
          :coll :_list-secrets-leaf-slots-raw}}

  {:name :_list-secrets-leaf-slots-raw
   :parent :storage-query-call
   :args {:arg :_list-secrets-leaf-slots-hsql}}

  {:name :_list-secrets-leaf-slots-hsql
   :parent :assoc
   :args {:map {:value {:select [:*] :from :slot}}
          :key {:value :where}
          :value :_list-secrets-leaf-slots-hsql-where}}

  {:name :_list-secrets-leaf-slots-hsql-where
   :parent :vec
   :args {:coll [{:value :in}
                 {:value :id}
                 {:parent :vec :args {:coll :_list-secrets-leaf-slot-ids}}]}}

  {:name :_list-secrets-leaf-slots-decode-row
   :parent :decode-row
   :return-type :slot-row-shape
   :args {:row {:as :item} :entity-type {:value "slot"}}}

  {:name :_list-secrets-in-slot
   :description "Find the slot named `\"in\"` — that's `:secret-leaf`'s `:in` arg whose binding holds the OpenBao path."
   :parent :first
   :args {:coll {:parent :filter
                 :args {:pred :_list-secrets-slot-is-in?
                        :coll :_list-secrets-leaf-slots}}}}

  {:name :_list-secrets-slot-is-in?
   :parent :equal?
   :args {:a {:parent :get :args {:coll {:as :item} :key {:value :name} :default nil}}
          :b {:value "in"}}}

  {:name :_list-secrets-path-slot-id
   :parent :get
   :args {:coll :_list-secrets-in-slot :key {:value :id} :default nil}}

  ;; Owners — fns whose parent-ids include the leaf-id.
  {:name :_list-secrets-owner-ids
   :parent :query-ref-many-owners
   :args {:entity-type {:value "fn"}
          :ref-many-field {:value "parent-ids"}
          :target-id :_list-secrets-leaf-id}}

  ;; Phase 3: `:id` is on the identity row, so the IN-clause filter
  ;; pushes into `:storage-query-identities :where` directly — no
  ;; post-resolve filter needed.
  {:name :_list-secrets-candidates-where
   :parent :zipmap
   :args {:keys [{:value :id}]
          :vals [{:parent :vec :args {:coll :_list-secrets-owner-ids}}]}}

  {:name :_list-secrets-candidates-from-storage
   :parent :resolve-fn-rows
   :args {:identities :_list-secrets-candidates-identities
          :branch-chain :current-branch-chain}}

  {:name :_list-secrets-candidates-identities
   :parent :storage-query-identities
   :args {:entity-type {:value "fn"}
          :where :_list-secrets-candidates-where}}

  {:name :_list-secrets-candidates
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_list-secrets-owner-ids}}
          :then {:value []}
          :else :_list-secrets-candidates-from-storage}}

  ;; Filter: keep only rows whose parent-ids is EXACTLY `[leaf-id]`
  ;; (no multi-inheritance siblings). Reuses public `:secret-fn?` with
  ;; the leaf-id closure-captured from the outer scope. Admin who
  ;; wants MI-children visible swaps the predicate to a custom one.
  {:name :_list-secrets-filtered
   :parent :filter
   :args {:pred :_list-secrets-row-is-pure-secret?
          :coll :_list-secrets-candidates}}

  {:name :_list-secrets-row-is-pure-secret?
   :parent :secret-fn?
   :args {:fn-row {:as :item}
          :secret-leaf-id :_list-secrets-leaf-id}}

  ;; Per-row HOF callback — wraps `:shape-secret` with the path-slot-id
  ;; closure-captured from the outer scope.
  {:name :_list-secrets-shape-row
   :parent :shape-secret
   :args {:fn-row {:as :item}
          :path-slot-id :_list-secrets-path-slot-id}}

  {:name :_list-secrets-shaped
   :parent :map
   :args {:func :_list-secrets-shape-row
          :coll :_list-secrets-filtered}}

  ;; Error envelope for the "secret-leaf not installed" case.
  {:name :_list-secrets-err-missing-leaf
   :parent :const
   :args {:value {:ok false :error ":secret-leaf base-fn not found — package web.vault not loaded?"}}}

  {:name :_list-secrets-success
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :secrets}]
          :vals [{:value true} :_list-secrets-shaped]}}

  {:name :_list-secrets-data
   :description "GET /api/secrets — every fn-def with `parent-ids = [secret-leaf-id]`, each enriched with OpenBao metadata. Secret VALUES are never returned. Pure graph composition over `:query-ref-many-owners` + `:list-entities` + `:filter` + `:map :shape-secret` + envelope `:zipmap`."
   :parent :if
   :args {:test {:parent :some? :args {:value :_list-secrets-leaf-id}}
          :then :_list-secrets-success
          :else :_list-secrets-err-missing-leaf}}

  {:name :list-secrets-handler
   :description "Ring handler for GET /api/secrets (auth-required)."
   :parent :json-handler
   :args {:data :_list-secrets-data}}

  ;; ---------------------------------------------------------------------
  ;; GET /partials/secrets-panel — server-rendered sidebar Secrets
  ;; section (header + count + per-row rotate / delete actions). JS
  ;; (`editor-secrets.js`) fetches this on mount + after mutations,
  ;; sets innerHTML, and binds handlers via event-delegation on the
  ;; `[data-act="…"]` attrs the partial emits. Auth-gated; the partial
  ;; assumes signed-in caller — anonymous visitors keep the legacy
  ;; "Sign in to manage secrets" stub rendered client-side.
  ;;
  ;; Decomposed into small named fn-defs (`:_sp-*`) following the
  ;; branch-popover pattern (`:_bp-*`) — the type-checker resolves
  ;; per-fn return types when each step has a name + narrow contract.
  ;; ---------------------------------------------------------------------

  ;; --- Per-row accessors (HOF context: `:item` = one secret-shaped row).
  {:name :_sp-item-id
   :parent :get
   :args {:coll {:as :item} :key {:value :id} :default nil}}

  {:name :_sp-item-name
   :parent :coalesce
   :args {:value {:parent :get
                  :args {:coll {:as :item} :key {:value :name} :default nil}}
          :default {:value "(unnamed)"}}}

  {:name :_sp-item-path
   :parent :coalesce
   :args {:value {:parent :get
                  :args {:coll {:as :item} :key {:value :path} :default nil}}
          :default {:value ""}}}

  ;; --- Row internals — small named span/button fn-defs. Use `:hiccup`
  ;; directly (not `:wrap-element`) so we can pass an `:attrs` map —
  ;; `:wrap-element` pins attrs to `{}` and rejects overrides.
  {:name :_sp-row-lock
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "secret-lock-icon"}}
          :children [{:value "🔒"}]}}

  {:name :_sp-row-name-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "name"}}
          :children [:_sp-item-name]}}

  {:name :_sp-row-path-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "secret-path"}}
          :children [:_sp-item-path]}}

  ;; Per-row button attrs — `:assoc` injects the row-specific
  ;; `:data-fn-id` onto a base attr map.
  {:name :_sp-row-rotate-attrs
   :parent :assoc
   :args {:map {:value {:type "button"
                        :class "sidebar-action"
                        :data-act "rotate"
                        :title "Rotate value"}}
          :key {:value :data-fn-id}
          :value :_sp-item-id}}

  {:name :_sp-row-delete-attrs
   :parent :assoc
   :args {:map {:value {:type "button"
                        :class "sidebar-action sidebar-action-delete"
                        :data-act "delete"
                        :title "Delete secret"}}
          :key {:value :data-fn-id}
          :value :_sp-item-id}}

  {:name :_sp-row-rotate-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_sp-row-rotate-attrs
          :children [{:value "↻"}]}}

  {:name :_sp-row-delete-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_sp-row-delete-attrs
          :children [{:value "×"}]}}

  {:name :_sp-row-actions
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "ns-row-actions"}}
          :children [:_sp-row-rotate-btn :_sp-row-delete-btn]}}

  {:name :_sp-row-attrs
   :parent :assoc
   :args {:map {:value {:class "entity-item entity-secret"
                        :data-act "navigate"}}
          :key {:value :data-fn-id}
          :value :_sp-item-id}}

  {:name :_secrets-panel-row
   :description "HOF callback — full sidebar row for one secret. Composed from `:_sp-*` accessors + sub-elements above."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs :_sp-row-attrs
          :children [:_sp-row-lock :_sp-row-name-span
                     :_sp-row-path-span :_sp-row-actions]}}

  ;; --- Sorted list + container.
  {:name :_sp-name-getter
   :description "HOF callback for `:sort-by` — pulls `:name` (empty string when absent so the comparator never sees nil)."
   :parent :get
   :args {:coll {:as :item} :key {:value :name} :default {:value ""}}}

  {:name :_secrets-panel-sorted
   :description "Secrets sorted by `:name` for stable sidebar order."
   :parent :sort-by
   :args {:key-fn :_sp-name-getter
          :coll :_list-secrets-shaped}}

  {:name :_secrets-panel-rows
   :parent :map
   :args {:func :_secrets-panel-row :coll :_secrets-panel-sorted}}

  ;; --- Header.
  {:name :_sp-header-arrow
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "ns-arrow"}}
          :children [{:value "▼"}]}}

