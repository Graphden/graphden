{:namespace "app.ui-explorer"
 :description "Finite Explorer kind toolbar, projected from existing authorized cache summaries."
 :fns [{:name :_explorer-toolbar-state :type {:handled :bool}}
       {:name :_explorer-toolbar-inputs :type {:selected [:map :text :bool] :counts [:map :text [:union :null :int]] :failed :int :authenticated :bool :apps-available :bool :fx :bool}}
       {:name :_explorer-toolbar-event :type {:kind :text :value :text}}
       {:name :_explorer-toolbar-request :type {:kind :text :value :text}}
       {:name :_explorer-toolbar-requests :list :_explorer-toolbar-request}
       {:name :_explorer-toolbar-transition :type {:state :_explorer-toolbar-state :requests :_explorer-toolbar-requests}}
       {:name :explorer-toolbar-initial :parent :const :args {:value {:value {:handled false}}} :return-type :_explorer-toolbar-state}
       {:name :_explorer-input-selected :parent :get :args {:coll {:as :inputs :type :_explorer-toolbar-inputs} :key {:value :selected} :default {:value {}}}}
       {:name :_explorer-input-counts :parent :get :args {:coll {:as :inputs :type :_explorer-toolbar-inputs} :key {:value :counts} :default {:value {}}}}
       {:name :_explorer-input-failed :parent :get :args {:coll {:as :inputs :type :_explorer-toolbar-inputs} :key {:value :failed} :default {:value 0}}}
       {:name :_explorer-input-authenticated :parent :get :args {:coll {:as :inputs :type :_explorer-toolbar-inputs} :key {:value :authenticated} :default {:value false}}}
       {:name :_explorer-input-apps-available :parent :get :args {:coll {:as :inputs :type :_explorer-toolbar-inputs} :key {:value :apps-available} :default {:value false}}}
       {:name :_explorer-input-fx :parent :get :args {:coll {:as :inputs :type :_explorer-toolbar-inputs} :key {:value :fx} :default {:value false}}}
       {:name :_explorer-event-kind :parent :get :args {:coll {:as :event :type :_explorer-toolbar-event} :key {:value :kind} :default {:value ""}}}
       {:name :_explorer-event-value :parent :get :args {:coll {:as :event :type :_explorer-toolbar-event} :key {:value :value} :default {:value ""}}}
       {:name :_explorer-selected-fn :parent :get :args {:coll :_explorer-input-selected :key {:value "fn"} :default {:value false}}}
       {:name :_explorer-selected-types :parent :get :args {:coll :_explorer-input-selected :key {:value "types"} :default {:value false}}}
       {:name :_explorer-selected-secrets :parent :get :args {:coll :_explorer-input-selected :key {:value "secrets"} :default {:value false}}}
       {:name :_explorer-selected-services :parent :get :args {:coll :_explorer-input-selected :key {:value "services"} :default {:value false}}}
       {:name :_explorer-selected-apps :parent :get :args {:coll :_explorer-input-selected :key {:value "apps"} :default {:value false}}}
       {:name :_explorer-selected-tests :parent :get :args {:coll :_explorer-input-selected :key {:value "tests"} :default {:value false}}}
       {:name :_explorer-selected-failed :parent :get :args {:coll :_explorer-input-selected :key {:value "failed"} :default {:value false}}}
       {:name :_explorer-selected-type-errors :parent :get :args {:coll :_explorer-input-selected :key {:value "type-errors"} :default {:value false}}}
       {:name :_explorer-selected-lint :parent :get :args {:coll :_explorer-input-selected :key {:value "lint"} :default {:value false}}}
       {:name :_explorer-selected-flags :parent :list :args {:items [:_explorer-selected-fn :_explorer-selected-types :_explorer-selected-secrets :_explorer-selected-services :_explorer-selected-apps :_explorer-selected-tests :_explorer-selected-failed :_explorer-selected-type-errors :_explorer-selected-lint]}}
       {:name :_explorer-selected-flag-true :parent :equal? :args {:a {:as :item :type :bool} :b true} :lambda-params [:item]}
       {:name :_explorer-selected-true :parent :filter :args {:pred :_explorer-selected-flag-true :coll :_explorer-selected-flags}}
       {:name :_explorer-selected-count :parent :count :args {:coll :_explorer-selected-true}}
       {:name :_explorer-selected-all :parent :equal? :args {:a :_explorer-selected-count :b 0}}
       {:name :_explorer-valid-kind-values :parent :zipmap :args {:keys ["all" "fn" "types" "secrets" "services" "apps" "tests" "failed" "type-errors" "lint"] :vals [true true true true true true true true true true]}}
       {:name :_explorer-valid-kind :parent :get :args {:coll :_explorer-valid-kind-values :key :_explorer-event-value :default {:value false}}}
       {:name :_explorer-is-toggle :parent :equal? :args {:a :_explorer-event-kind :b "toggle"}}
       {:name :_explorer-is-detail :parent :equal? :args {:a :_explorer-event-kind :b "detail"}}
       {:name :_explorer-is-fx :parent :equal? :args {:a :_explorer-event-value :b "fx"}}
       {:name :_explorer-toggle-request :parent :zipmap :args {:keys [{:value :kind} {:value :value}] :vals ["toggle-filter" :_explorer-event-value]} :return-type :_explorer-toolbar-request}
       {:name :_explorer-detail-request :parent :zipmap :args {:keys [{:value :kind} {:value :value}] :vals ["toggle-detail" "fx"]} :return-type :_explorer-toolbar-request}
       {:name :_explorer-toggle-requests :parent :list :args {:items [:_explorer-toggle-request]} :return-type :_explorer-toolbar-requests}
       {:name :_explorer-detail-requests :parent :list :args {:items [:_explorer-detail-request]} :return-type :_explorer-toolbar-requests}
       {:name :_explorer-no-requests :parent :const :args {:value {:value []}} :return-type :_explorer-toolbar-requests}
       {:name :_explorer-valid-toggle :parent :if :args {:test :_explorer-valid-kind :then :_explorer-toggle-requests :else :_explorer-no-requests}}
       {:name :_explorer-valid-detail :parent :if :args {:test :_explorer-is-fx :then :_explorer-detail-requests :else :_explorer-no-requests}}
       {:name :_explorer-other-requests :parent :if :args {:test :_explorer-is-detail :then :_explorer-valid-detail :else :_explorer-no-requests}}
       {:name :_explorer-requests :parent :if :args {:test :_explorer-is-toggle :then :_explorer-valid-toggle :else :_explorer-other-requests}}
       {:name :_explorer-current-state :parent :const :args {:value {:as :state :type :_explorer-toolbar-state}} :return-type :_explorer-toolbar-state}
       {:name :explorer-toolbar-update :parent :zipmap :args {:keys [{:value :state} {:value :requests}] :vals [:_explorer-current-state :_explorer-requests]} :return-type :_explorer-toolbar-transition}
       {:name :_explorer-has-failed :parent :equal? :args {:a :_explorer-input-failed :b 0}}
       {:name :_explorer-failed-title-suffix :parent :str :args {:parts [" — " :_explorer-input-failed " failed"]}}
       {:name :_explorer-test-suffix :parent :if :args {:test :_explorer-has-failed :then "" :else :_explorer-failed-title-suffix}}
       {:name :_explorer-tests-title :parent :str :args {:parts ["Only tests (fns in a `tests` namespace)" :_explorer-test-suffix]}}
       {:name :_explorer-failed-count-suffix :parent :str :args {:parts [" · " :_explorer-input-failed "✗"]}}
       {:name :_explorer-test-count-suffix :parent :if :args {:test :_explorer-has-failed :then "" :else :_explorer-failed-count-suffix}}
       {:name :_explorer-test-count-class :parent :if :args {:test :_explorer-has-failed :then "kind-count" :else "kind-count kind-count-bad"}}
       {:name :_explorer-pressed-all :parent :if :args {:test :_explorer-selected-all :then "true" :else "false"}}
       {:name :_explorer-glyph-all :parent :hiccup :args {:tag "span" :attrs {:value {:class "kind-glyph" :aria-hidden "true"}} :children ["◍"]}}
       {:name :_explorer-label-all :parent :hiccup :args {:tag "span" :attrs {:value {:class "kind-label"}} :children ["all"]}}
       {:name :_explorer-toggle-attrs :parent :zipmap :args {:keys [{:value :type} {:value :class} {:value :data-kind} {:value :aria-pressed} {:value :title} {:value :hidden}]}}
       {:name :_explorer-attrs-all :parent :_explorer-toggle-attrs :args {:vals ["button" "kind-toggle kind-all" "all" :_explorer-pressed-all "Show everything — clears every filter" false]}}
       {:name :_explorer-button-all :parent :hiccup :args {:tag "button" :attrs :_explorer-attrs-all :children [:_explorer-glyph-all :_explorer-label-all]}}
       {:name :_explorer-pressed-fn :parent :if :args {:test :_explorer-selected-fn :then "true" :else "false"}}
