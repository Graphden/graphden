{:paths ["scripts"]

 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :as p]
             [clojure.string :as str])

  :init (do
          ;; Lint paths cover: src + test (classpath sources) AND
          ;; resources/packages (impls.clj files loaded via load-file —
          ;; previously un-linted, see .clj-kondo/config.edn for the
          ;; namespace-name-mismatch carve-out).
          (def all-paths "src test resources/packages")
          (def green "\u001b[32m")
          (def red "\u001b[31m")
          (def cyan "\u001b[36m")
          (def yellow "\u001b[33m")
          (def reset "\u001b[0m")

          (defn run-parallel
            "Run shell commands in parallel. Wait for all, fail if any fails."
            [cmds]
            (let [procs (mapv (fn [cmd] (p/process cmd {:out :inherit :err :inherit})) cmds)]
              (doseq [proc procs] (p/check proc)))))

  :enter (println (str cyan "▶ " (:name (current-task)) reset))

  ;; === DEVELOPMENT ===

  repl
  {:doc "Start headless nREPL server (writes .nrepl-port for clients to discover)"
   :override-builtin true
   :task (clojure "-A:dev -A:nrepl")}

  nrepl
  {:doc "Synonym for `bb repl` — clearer name when used by tools (Cider, clojure-mcp)"
   :task (clojure "-A:dev -A:nrepl")}

  nrepl-bg
  {:doc "Start headless nREPL in background. Logs → .nrepl.log, PID → .nrepl.pid. Stop via `bb nrepl-stop`."
   :task (let [pid-file (fs/file ".nrepl.pid")
               port-file (fs/file ".nrepl-port")
               running? (and (fs/exists? pid-file)
                             (zero? (:exit (p/shell {:continue true :out nil :err nil}
                                                    "kill" "-0" (str/trim (slurp pid-file))))))]
           (if running?
             (do (println (str red "nREPL already running (PID " (str/trim (slurp pid-file)) ")" reset))
                 (println "  Stop it first via `bb nrepl-stop`."))
             (do
               (when (fs/exists? port-file) (fs/delete port-file))
               ;; setsid + nohup fully detach; redirects free stdin/out/err
               (p/shell "bash" "-c"
                        "nohup setsid clojure -A:dev -A:nrepl >.nrepl.log 2>&1 </dev/null & echo $! >.nrepl.pid")
               (println (str "Starting nREPL... (PID " (str/trim (slurp pid-file)) ")"))
               (loop [tries 0]
                 (cond
                   (>= tries 30)
                   (println (str red "WARN: .nrepl-port did not appear within 30s; check .nrepl.log" reset))
                   (fs/exists? port-file)
                   (println (str green "✓ nREPL ready on port " (str/trim (slurp port-file)) reset
                                 "\n  log:  .nrepl.log"
                                 "\n  pid:  .nrepl.pid"
                                 "\n  stop: bb nrepl-stop"))
                   :else (do (Thread/sleep 1000) (recur (inc tries))))))))}

  nrepl-stop
  {:doc "Stop the backgrounded nREPL started by `bb nrepl-bg`"
   :task (let [pid-file (fs/file ".nrepl.pid")]
           (if (fs/exists? pid-file)
             (let [pid (str/trim (slurp pid-file))]
               (p/shell {:continue true :out nil :err nil} "kill" pid)
               ;; JVM shutdown hook deletes .nrepl-port itself, so use
               ;; delete-if-exists to avoid a race-condition crash.
               (fs/delete-if-exists pid-file)
               (fs/delete-if-exists (fs/file ".nrepl-port"))
               (println (str green "✓ Stopped nREPL (PID " pid ")" reset)))
             (println "No .nrepl.pid found — nothing to stop")))}

  ;; === LINTERS (each takes optional path) ===

  kondo
  {:doc "Run clj-kondo [path]"
   :task (let [path (or (first *command-line-args*) all-paths)
               native? (= 0 (:exit (p/shell {:out :string :err :string :continue true} "which clj-kondo")))]
           (if native?
             (p/shell (str "clj-kondo --lint " path))
             (clojure (str "-M:kondo --lint " path))))}

  splint
  {:doc "Run splint [path]"
   :task (clojure (str "-M:splint " (or (first *command-line-args*) all-paths)))}

  cljstyle
  {:doc "Check formatting [path]"
   :task (clojure (str "-M:cljstyle check " (or (first *command-line-args*) all-paths)))}

  biome
  {:doc "Lint editor JS via biome"
   :task (p/shell "npx" "biome" "check" "resources/packages/app/editor")}

  biome-fix
  {:doc "Auto-fix safe biome violations"
   :task (p/shell "npx" "biome" "check" "--write" "resources/packages/app/editor")}

  stylelint
  {:doc "Lint editor CSS via stylelint (design-token discipline + standard rules)"
   :task (p/shell "npx" "stylelint" "resources/packages/app/editor/**/*.css")}

  stylelint-fix
  {:doc "Auto-fix stylelint violations where possible"
   :task (p/shell "npx" "stylelint" "--fix" "resources/packages/app/editor/**/*.css")}

  ;; === Cross-cutting linters (docker-image or downloaded binary) ===
  ;;
  ;; Each task here works WITHOUT a host install: Docker pulls the
  ;; image on first run, the typos binary is fetched + cached under
  ;; `.tools/`. CI runs on a stock ubuntu-latest with docker + node
  ;; present; no extra `apt-get install …` lines required.

  shellcheck
  {:doc "Lint .sh files via Docker koalaman/shellcheck:stable."
   :task (p/shell "docker" "run" "--rm"
                  "-v" (str (System/getenv "PWD") ":/src")
                  "-w" "/src"
                  "koalaman/shellcheck:stable"
                  "tools/browser-test/run-edit-tests.sh"
                  ".claude/hooks/check-ui-on-stop.sh"
                  ".claude/hooks/remind-packages-quality-on-impls-edit.sh")}

  hadolint
  {:doc "Lint Dockerfile + Dockerfile.build + Dockerfile.crac via Docker hadolint/hadolint:v2.12.0-debian."
   :task (do
           (doseq [df ["Dockerfile" "Dockerfile.build" "Dockerfile.crac"]]
             (println (str "▶ hadolint " df))
             (let [proc (p/shell {:in (slurp df)}
                                 "docker" "run" "--rm" "-i"
                                 "hadolint/hadolint:v2.12.0-debian")]
               (p/check proc))))}

  gitleaks
  {:doc "Scan working tree for committed secrets via Docker zricethezav/gitleaks."
   :task (p/shell "docker" "run" "--rm"
                  "-v" (str (System/getenv "PWD") ":/repo")
                  "-w" "/repo"
                  "zricethezav/gitleaks:latest"
                  "detect" "--no-banner" "--no-git"
                  "--config" "/repo/.gitleaks.toml")}

  typos
  {:doc "Spelling check over docs + src via crate-ci/typos. Downloads the binary to .tools/typos on first run (Linux x86_64). Config: _typos.toml at repo root."
   :task (let [binary ".tools/typos"
               version "v1.31.0"]
           (when-not (fs/exists? binary)
             (println "Downloading typos" version "…")
             (fs/create-dirs ".tools")
             (let [url (str "https://github.com/crate-ci/typos/releases/download/"
                            version "/typos-" version "-x86_64-unknown-linux-musl.tar.gz")]
               (p/shell "curl" "-sL" "-o" ".tools/typos.tar.gz" url)
               (p/shell "tar" "xzf" ".tools/typos.tar.gz" "-C" ".tools/")
               (fs/delete ".tools/typos.tar.gz")))
           (p/shell binary))}

  markdownlint
  {:doc "Lint .md files via markdownlint-cli2 (npm-pinned). Config: .markdownlint-cli2.jsonc at repo root."
   :task (p/shell "npx" "markdownlint-cli2")}

  markdownlint-fix
  {:doc "Auto-fix markdownlint violations where possible."
   :task (p/shell "npx" "markdownlint-cli2" "--fix")}

  actionlint
  {:doc "Lint GitHub Actions workflows via Docker rhysd/actionlint:1.7.7."
   :task (p/shell "docker" "run" "--rm"
                  "-v" (str (System/getenv "PWD") ":/repo")
                  "-w" "/repo"
                  "rhysd/actionlint:1.7.7" "-color")}

  lychee
  {:doc "Offline link-check (.md files) via Docker lycheeverse/lychee. External HTTP links are NOT contacted — run `bb lychee-online` for that. Config: .lychee.toml."
   :task (p/shell "docker" "run" "--rm"
                  "-v" (str (System/getenv "PWD") ":/data")
                  "-w" "/data"
                  "lycheeverse/lychee:sha-467197f-alpine"
                  "--offline" "--no-progress"
                  "--exclude-path" "node_modules"
                  "--exclude-path" "target"
                  "--exclude-path" ".tools"
                  "--exclude-path" ".playwright-mcp"
                  "**/*.md")}

  lychee-online
  {:doc "ONLINE link-check — verifies every external HTTP/HTTPS URL in docs. Slow + network-dependent; run before docs PRs, NOT on every `bb check`. Cached for 1 week (.lycheecache)."
   :task (p/shell "docker" "run" "--rm"
                  "-v" (str (System/getenv "PWD") ":/data")
                  "-w" "/data"
                  "lycheeverse/lychee:sha-467197f-alpine"
                  "--no-progress"
                  "--exclude-path" "node_modules"
                  "--exclude-path" "target"
                  "--exclude-path" ".tools"
                  "--exclude-path" ".playwright-mcp"
                  "**/*.md")}

  trivy
  {:doc "Supply-chain CVE + Dockerfile misconfig scan via Docker aquasec/trivy:0.58.2. Caches vulnerability DB in /tmp/trivy-cache."
   :task (let [pwd (System/getenv "PWD")]
           (println "▶ trivy config (Dockerfile misconfig)")
           (p/shell "docker" "run" "--rm"
                    "-v" (str pwd ":/repo")
                    "-v" "/tmp/trivy-cache:/root/.cache/"
                    "-w" "/repo"
                    "aquasec/trivy:0.58.2"
                    "config" "--severity" "HIGH,CRITICAL"
                    "--skip-dirs" "node_modules,target,.tools"
                    ;; Path-scoped, documented misconfig exceptions for the
                    ;; dev/demo kind manifests (CRIU caps, stock-postgres fs).
                    ;; Not auto-detected — must be passed explicitly.
                    "--ignorefile" ".trivyignore.yaml"
                    "--exit-code" "1" "--quiet" ".")
           (println "▶ trivy fs (CVE in npm + maven deps)")
           (p/shell "docker" "run" "--rm"
                    "-v" (str pwd ":/repo")
                    "-v" "/tmp/trivy-cache:/root/.cache/"
                    "-w" "/repo"
                    "aquasec/trivy:0.58.2"
                    "fs" "--severity" "HIGH,CRITICAL"
                    "--skip-dirs" "node_modules,target,.tools,.playwright-mcp,.git,.lsp"
                    "--exit-code" "1" "--quiet" "."))}

  license-check
  {:doc "Audit npm dep licenses against the allowlist of permissive licenses. Fails on any package outside MIT/BSD/Apache/ISC/CC0/Unlicense family — catches an accidental GPL/AGPL pull before it ships."
   :task (let [allow (str/join ";"
                               ["MIT" "ISC" "BSD" "BSD-2-Clause" "BSD-3-Clause"
                                "Apache-2.0" "CC0-1.0" "Unlicense" "0BSD"
                                "Python-2.0" "MIT OR Apache-2.0" "MIT-0"
                                "Apache-2.0 OR MIT" "(MIT OR CC0-1.0)"])]
           (doseq [dir ["." "tools/browser-test" "tools/visual-tests"]]
             (println (str "▶ license-check " dir))
             (p/shell {:dir dir}
                      "npx" "license-checker-rseidelsohn"
                      "--summary" "--onlyAllow" allow)))}

  commitlint
  {:doc "Lint the commit messages THIS branch adds on top of develop (merge-base..HEAD) against the conventional-commits rules in commitlint.config.cjs. Already-merged history is deliberately out of scope: its messages cannot be fixed without rewriting shared history, so linting them would produce a red CI nobody can act on — and would block every feature branch in the merge queue. On develop the range is empty and the check trivially passes. Pass an explicit range as `bb commitlint HEAD~5..HEAD` to audit a wider window by hand."
   :task (let [default-range
               (let [{:keys [exit out]} (p/shell {:out :string :err :string :continue true}
                                                 "git" "merge-base" "HEAD" "develop")]
                 (if (zero? exit)
                   (str (str/trim out) "..HEAD")
                   "HEAD~20..HEAD"))   ; no develop ref (shallow clone / fresh repo)
               range (or (first *command-line-args*) default-range)
               splitter (re-pattern "\\.\\.")
               parts (str/split range splitter)
               from (first parts)
               to (or (second parts) "HEAD")
               ;; commitlint 21 rejects --from X --to X ("point to the same
               ;; commit", exit 9), so an empty range is an error to it, not a
               ;; no-op. That is exactly the range on develop and in a freshly
               ;; claimed worktree — guard instead of handing it over.
               n-commits (-> (p/shell {:out :string :err :string :continue true}
                                      "git" "rev-list" "--count" (str from ".." to))
                             :out str/trim)]
           (println (str "▶ commitlint " range))
           (if (= "0" n-commits)
             (println "  no commits in range — nothing to lint")
             (p/shell "npx" "commitlint" "--from" from "--to" to)))}

  visual
  {:doc "Run Playwright visual-regression tests against running editor (default http://localhost:9002). Reads AUTH_TOKEN from env or .env. Use `bb visual-update` after intentional UI changes."
   :task (p/shell {:dir "tools/visual-tests"} "npx" "playwright" "test")}

  visual-update
  {:doc "Refresh visual-regression baselines (commit the updated PNGs after intentional UI changes)"
   :task (p/shell {:dir "tools/visual-tests"} "npx" "playwright" "test" "--update-snapshots")}

  ;; NOTE: Eastwood removed - incompatible with Clojure 1.12 qualified methods (Class/.method)
  ;; See: https://github.com/jonase/eastwood/issues/457

  ;; === TESTS ===

  ;; `bb test` runs the in-JVM parallel path (one runner, child NSs on a
  ;; bounded thread pool — wired by `:kaocha.plugin/parallel` in
  ;; `test/kaocha/plugin/parallel.clj`). Faster than the multi-process
  ;; path on most boxes because we pay container-startup once instead
  ;; of per-worker. NSs that redef process-wide vars carry `^:serial`
  ;; in their ns meta and run sequentially BEFORE the parallel pool.
  ;;
  ;; For targeted debugging or `--focus` flows, call kaocha directly:
  ;; `clojure -M:dev:test -m kaocha.runner --focus my.ns`.
  ;;
  ;; The multi-process path lives at `bb test-parallel` if a flake
  ;; reproduces only across separate JVMs.
  ;; -------------------------------------------------------------------
  ;; Test target matrix
  ;; -------------------------------------------------------------------
  ;; Tests split into THREE groups by what they exercise:
  ;;   - unit:        pure logic + light fixtures, in-JVM, ~1.5 min
  ;;   - integration: real PostgreSQL via testcontainers + full Ring
  ;;                  chain, in-JVM, ~10-12 min
  ;;   - e2e:         Playwright browsers against a running graphden
  ;;                  deployment (Node, separate process), ~15-25 min
  ;;                  — requires `bb rebuild` first + AUTH_TOKEN env
  ;;
  ;; Group runners (single group):
  ;;   bb test-unit         — kaocha :unit suite
  ;;   bb test-integration  — kaocha :integration suite
  ;;   bb test-e2e          — Playwright browser-test suite
  ;;
  ;; Combinations:
  ;;   bb test-all              — unit + integration + e2e (sequential)
  ;;   bb test-unit-coverage    — unit with cloverage instrumentation
  ;;   bb test-all-coverage     — unit-with-coverage + integration + e2e
  ;;                              (cloverage covers unit, the rest runs
  ;;                               un-instrumented)
  ;;
  ;; What you can't do (by design):
  ;;   integration / e2e with cloverage — would add ~30 min wall for
  ;;   ~0% per-NS attribution: the CRUD NSes integration would
  ;;   exercise show 0% under cloverage anyway because cr/execute's
  ;;   compiled-closure cache bypasses the instrumented vars. See
  ;;   `bb coverage` docstring + `[[feedback_coverage_measurement]]`
  ;;   memory note for the empirical 2026-06-23 finding.
  ;;
  ;; CI uses `bb test-unit-coverage` (drops the separate unit-tests
  ;; check that was redundant once coverage runs the same suite with
  ;; cloverage on).

  test
  {:doc "Run unit + integration in one kaocha invocation. ~14 min. For e2e too see `bb test-all`. For fast unit-only feedback see `bb test-unit`."
   :task (clojure "-M:dev:test -m kaocha.runner")}

  test-unit
  {:doc "Unit tests only (skips ^:integration). ~1.5 min."
   :task (clojure "-M:dev:test -m kaocha.runner :unit")}

  test-integration
  {:doc "Integration tests only (focus ^:integration; real PG via testcontainers). ~10-12 min."
   :task (clojure "-M:dev:test -m kaocha.runner :integration")}

  test-e2e
  {:doc "Playwright browser-test suite against an ISOLATED ephemeral stack via Testcontainers (postgres + user-postgres + openbao + `graphden-executor:latest`, dynamic host ports, Ryuk reaps everything on JVM exit). Demo on :9002 stays untouched. Requires `bb rebuild` (or `bb deploy`) first so `graphden-executor:latest` is present. ~30-60s for the stack to come healthy + ~15-25 min for the suite itself. See `graphden.dev.e2e-stack`."
   :task (p/shell "clojure" "-M:dev" "-m" "graphden.dev.e2e-stack"
                  "tools/browser-test/run-edit-tests.sh")}

  test-fleet-e2e
  {:doc "Two-container fleet e2e (kaocha :container-e2e) — boots `graphden-executor:latest` TWICE as a real two-pod fleet over a shared Postgres (testcontainers) and drives the cross-container control plane over real HTTP: /health, token-gated /internal/fleet/{status,cell/load}, shared graph, agreed placement view. Requires `bb rebuild` first so the image is present. ~4 min (two cold boots). Ryuk reaps the containers on JVM exit."
   :task (clojure "-M:dev:test -m kaocha.runner :container-e2e")}

  test-all
  {:doc "Run ALL tests (unit + integration + e2e), sequential. ~30-35 min wall. e2e requires `bb rebuild` first + AUTH_TOKEN."
   :task (do (p/shell "bb" "test-unit")
             (p/shell "bb" "test-integration")
             (p/shell "bb" "test-e2e"))}

  test-unit-coverage
  {:doc "Unit tests with cloverage instrumentation. ~15-19 min on a dev host — the full-graph tests (packages.registry / packages.export / executor.effect-gating) recompile the whole graph under instrumentation (~50× amplification); that's also where their real coverage of the loader/compiler comes from. Same as `bb coverage`. Use this for the coverage report; `bb test-unit` for fast feedback without instrumentation."
   :task (clojure "-M:dev:test -m kaocha.runner --config-file tests-coverage.edn :unit")}

  test-all-coverage
  {:doc "Unit-with-coverage + integration + e2e. ~30-35 min. Coverage covers unit only; integration / e2e run un-instrumented (see `bb coverage` docstring for why instrumenting integration adds zero useful per-NS signal). e2e runs in a separate Node process so cloverage can't reach it anyway."
   :task (do (p/shell "bb" "test-unit-coverage")
             (p/shell "bb" "test-integration")
             (p/shell "bb" "test-e2e"))}

  test-sequential
  {:doc "Run all tests sequentially in a single JVM (KAOCHA_PARALLELISM=1); use if a flake reproduces only sequentially."
   :task (p/shell {:extra-env {"KAOCHA_PARALLELISM" "1"}}
                  "clojure" "-M:dev:test" "-m" "kaocha.runner")}

  ;; Same as `bb test` but points all workers at the local docker-compose
  ;; `graphden-postgres` (port 5435) via `GRAPHDEN_TEST_PG_JDBC_URL` so
  ;; the workers skip spinning up their own testcontainer (saves
  ;; ~3-4 s per worker beyond the first). Requires `bb deploy` /
  ;; docker-compose up postgres first. The shared cluster is safe — each
  ;; worker still gets per-NS logical DBs (see
  ;; `graphden.test-infra.shared-container/ensure-ns-database!`); only
  ;; the bootstrap admin DB (`graphden`) is shared, and tests never
  ;; touch it directly.
  test-shared-pg
  {:doc "Run tests using the local docker-compose `graphden-postgres` (port 5435) for all workers."
   :task (let [n (or (first *command-line-args*) "4")]
           (p/shell {:extra-env {"GRAPHDEN_TEST_PG_JDBC_URL"
                                 "jdbc:postgresql://localhost:5435/graphden"
                                 "GRAPHDEN_TEST_PG_USERNAME" "graphden"
                                 "GRAPHDEN_TEST_PG_PASSWORD" "graphden"}}
                    "bb" "test-parallel" n))}

  ;; Parallel test runner — splits test namespaces across N worker JVMs
  ;; (default 4). Each worker spins up its OWN testcontainer (via the
  ;; shared-container plugin in tests.edn — shared inside a worker, not
  ;; across workers), so tests run isolated from each other. Worth ~2x
  ;; speedup on a quad-core dev box; the per-worker JVM + container
  ;; startup overhead (~6-8s) eats into the savings for very small test
  ;; subsets, so `bb test-sequential` exists as the single-process
  ;; escape hatch. CI may override the worker count via the first
  ;; argument: `bb test-parallel 8`.
  ;;
  ;; To skip per-worker testcontainer startup, set
  ;; `GRAPHDEN_TEST_PG_JDBC_URL` (and optionally `_USERNAME` /
  ;; `_PASSWORD`) — workers inherit env and connect to that cluster
  ;; instead. Useful when a docker-compose Postgres is already running;
  ;; see `bb test-shared-pg`.
  test-parallel
  {:doc "Run tests in parallel (N=4 by default; arg overrides)."
   :task (let [n (or (some-> (first *command-line-args*) Long/parseLong)
                     4)
               file->ns (fn [path]
                          (-> (str path)
                              (str/replace (re-pattern "^test/") "")
                              (str/replace (re-pattern "\\.clj$") "")
                              (str/replace "_" "-")
                              (str/replace "/" ".")))
               test-files (->> (fs/glob "test" "**/*_test.clj")
                               (map file->ns)
                               sort)
               ;; Stable round-robin assignment so total time is
               ;; balanced even when one chunk happens to land all the
               ;; slow integration tests.
               chunks (->> test-files
                           (map-indexed (fn [i ns] [(mod i n) ns]))
                           (group-by first)
                           (sort-by key)
                           vals
                           (map (fn [pairs] (map second pairs))))
               start (System/currentTimeMillis)
               procs (mapv (fn [chunk]
                             (let [focus-args (mapcat (fn [ns] ["--focus" ns]) chunk)
                                   args (concat ["clojure" "-M:dev:test"
                                                 "-m" "kaocha.runner"
                                                 "--reporter" "kaocha.report/dots"]
                                                focus-args)]
                               (apply p/process {:out :string :err :string} args)))
                           chunks)
               results (mapv deref procs)
               total-ms (- (System/currentTimeMillis) start)
               failures (filter (fn [r] (not= 0 (:exit r))) results)]
           (println (str cyan "Workers: " (count procs) "  Wall: "
                         (format "%.1fs" (/ total-ms 1000.0)) reset))
           (doseq [[i r] (map-indexed vector results)]
             (let [tail (->> (str/split-lines (:out r))
                             (filter (fn [line]
                                       (re-find (re-pattern "tests, .*assertions|FAIL|ERROR")
                                                line)))
                             last)]
               (println (str (if (zero? (:exit r)) green red)
                             "  worker " i ": " (or tail "(no summary)") reset))))
           (when (seq failures)
             (println (str red "✗ " (count failures) " worker(s) failed" reset))
             (doseq [{:keys [out err]} failures]
               (println out)
               (when (seq err) (println err)))
             (System/exit 1)))}

  coverage
  {:doc "Unit-only coverage (~15-19 min wall on a dev host; 2026-07-03: 72.26% form / 81.91% line — the run is dominated by the full-graph tests that recompile the whole graph under instrumentation, not by test count). Same as `bb test-unit-coverage` — kept for back-compat with scripts that already reference this name.

   Why unit-only: the integration suite (cron / services / secrets / storage / executor-runtime / branch-router / per-handler graph tests) doesn't add useful per-NS attribution under cloverage. Empirical 2026-06-23 finding: every CRUD NS that integration would exercise (`crud.entities`, `crud.fn-execution.*`, `crud.branches`, etc.) reports 0% form/line anyway — `cr/execute`'s pre-compiled closure cache (built by `cr/rebuild!`) holds already-resolved fn objects and never re-derefs through the instrumented vars. Confirmed identical under BOTH kaocha-cloverage AND a 2h32m sequential direct `clj -M:cloverage` audit (per-NS 0% identical). So adding integration to the cloverage pass costs ~30 min wall for ~0% useful per-NS signal; it ran via `bb test` / `bb test-integration` un-instrumented anyway. See `[[feedback_coverage_measurement]]` for the full reasoning.

   What the unit-only number tells you: 'do we need more UNIT tests?'. Low coverage for NSes like `system.demo-branches` (2.98%), `system.branch-router` (5.29%), `versioning.merge.core` (3.36%) here is BY DESIGN — those code paths get their gap-filling from integration tests, which we trust based on their pass/fail signal rather than cloverage attribution. See `docs/E2E_SCENARIO_COVERAGE.md` for the e2e side of the audit."
   :task (clojure "-M:dev:test -m kaocha.runner --config-file tests-coverage.edn :unit")}

  ;; === FULL CHECK ===

  ci
  {:doc "Run ALL checks with live progress display"
   :task (load-file "scripts/ci.clj")}

  check
  {:doc "Run linters only (parallel) — Clojure (kondo/splint/cljstyle), JS (biome), CSS (stylelint), shell (shellcheck), Dockerfile (hadolint), secrets (gitleaks), spelling (typos), markdown (markdownlint)."
   :task (let [kondo-cmd (if (= 0 (:exit (p/shell {:out :string :continue true} "which clj-kondo")))
                           (str "clj-kondo --lint " all-paths)
                           (str "clojure -M:kondo --lint " all-paths))
               cljstyle-cmd (if (= 0 (:exit (p/shell {:out :string :continue true} "which cljstyle")))
                              (str "cljstyle check " all-paths)
                              (str "clojure -M:cljstyle check " all-paths))
               splint-cmd (str "clojure -M:splint " all-paths)
               biome-cmd "npx biome check resources/packages/app/editor"
               stylelint-cmd "npx stylelint resources/packages/app/editor/**/*.css"
               shellcheck-cmd (str "docker run --rm -v " (System/getenv "PWD")
                                   ":/src -w /src koalaman/shellcheck:stable"
                                   " tools/browser-test/run-edit-tests.sh"
                                   " .claude/hooks/check-ui-on-stop.sh"
                                   " .claude/hooks/remind-packages-quality-on-impls-edit.sh")
               gitleaks-cmd (str "docker run --rm -v " (System/getenv "PWD")
                                 ":/repo -w /repo zricethezav/gitleaks:latest"
                                 " detect --no-banner --no-git"
                                 " --config /repo/.gitleaks.toml")
               markdownlint-cmd "npx markdownlint-cli2"
               actionlint-cmd (str "docker run --rm -v " (System/getenv "PWD")
                                   ":/repo -w /repo"
                                   " rhysd/actionlint:1.7.7 -color")
               lychee-cmd (str "docker run --rm -v " (System/getenv "PWD")
                               ":/data -w /data"
                               " lycheeverse/lychee:sha-467197f-alpine"
                               " --offline --no-progress"
                               " --exclude-path node_modules"
                               " --exclude-path target"
                               " --exclude-path .tools"
                               " --exclude-path .playwright-mcp"
                               " **/*.md")]
           ;; hadolint requires stdin redirection, typos downloads its
           ;; binary on first run, trivy + license-check + commitlint
           ;; chain multiple commands — all run sequentially after the
           ;; parallel batch.
           (run-parallel [kondo-cmd splint-cmd cljstyle-cmd
                          biome-cmd stylelint-cmd
                          shellcheck-cmd gitleaks-cmd markdownlint-cmd
                          actionlint-cmd lychee-cmd])
           (p/shell "bb" "hadolint")
           (p/shell "bb" "typos")
           (p/shell "bb" "trivy")
           (p/shell "bb" "license-check")
           (p/shell "bb" "commitlint")
           (println (str green "✓ All linters passed" reset)))}

  wt
  {:doc "Parallel feature dev + merge queue (dev/wtq/README.md). Usage: bb wt <new|start|task|list|merge|status|log|drop|help> ..."
   :task (let [root (-> (p/shell {:out :string} "git" "rev-parse" "--show-toplevel")
                        :out str/trim)
               ;; :continue so a non-zero child (e.g. a failing gate) propagates
               ;; as a clean exit code, not a babashka stack trace.
               res (apply p/shell {:continue true} (str root "/dev/wtq/wt")
                          *command-line-args*)]
           (System/exit (:exit res)))}

