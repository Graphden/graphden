   :parent :str,
   :args {:parts ["Sealed in " :_source " — lift it there."]}}
  {:name :_inherited-list,
   :parent :str,
   :args {:parts ["List closed in " :_source " — reopen it there."]}}
  {:name :_inherited-required,
   :parent :str,
   :args
   {:parts
    ["Required since "
     :_source
     " — a ratchet, it cannot be undone below."]}}
  {:name :_owner-empty, :parent :equal?, :args {:a :_source, :b ""}}
  {:name :_owner-suffix,
   :parent :str,
   :args {:parts [" (" :_source ")"]}}
