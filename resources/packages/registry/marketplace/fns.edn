   :parent :if
   :args {:test :_mka-apply-ok?
          :then {:value "Applied — the editor picks it up now; Settings → Appearance / Keyboard shows it as the active one."}
          :else {:value "Refused: no such version, or not a theme / keymap."}}}
  {:name :_mka-apply-then-item
   :parent :do
   :args {:steps [:_mka-apply-do {:parent :marketplace-item-html :args {:pkg-name :_mka-name :notice :_mka-apply-notice}}]}}
  {:name :_mka-apply-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/marketplace/apply?name=&version= — stores the theme / keymap as the user's active one, then returns the refreshed item."
   :parent :html-ok-response
   :args {:body :_mka-apply-then-item}}
  {:name :api-marketplace-apply
   :description "POST /api/marketplace/apply?name=<pkg>&version=<v> — make a published theme / keymap the current user's active one (writes the `theme` / `keymap` preference with the version's payload); returns the item HTML. Auth-required."
   :parent :post
   :args {:path "/marketplace/apply" :handler :_mka-apply-handler}}

  ;; --- review: upsert (one per author per package) ---
  {:name :_mka-rating-raw
   :parent :_mka-param :args {:param-name {:value "rating"}}}
  {:name :_mka-rating
   :description "The form's rating as 1–5, else 0 (refused) — five equality arms; a `:case` map's literal keys keywordise through jsonb and would not match the string."
   :parent :cond
   :args {:clauses [{:parent :equal? :args {:a :_mka-rating-raw :b {:value "1"}}} {:value 1}
                    {:parent :equal? :args {:a :_mka-rating-raw :b {:value "2"}}} {:value 2}
                    {:parent :equal? :args {:a :_mka-rating-raw :b {:value "3"}}} {:value 3}
                    {:parent :equal? :args {:a :_mka-rating-raw :b {:value "4"}}} {:value 4}
                    {:parent :equal? :args {:a :_mka-rating-raw :b {:value "5"}}} {:value 5}
                    {:value true} {:value 0}]}}
  {:name :_mka-rating-ok?
   :parent :gt :args {:nums [:_mka-rating {:value 0}]}}
  {:name :_mka-body
   :parent :str-clip :args {:string {:parent :_mka-param :args {:param-name {:value "body"}}} :limit {:value 2000}}}
  {:name :_mka-existing-review
   :parent :first
   :args {:coll {:parent :query-entities
                 :args {:entity-type {:value "package-review"}
                        :where {:parent :assoc
                                :args {:map {:parent :assoc-empty :args {:key {:value :package-name} :value :_mka-name}}
                                       :key {:value :author-id} :value :current-user-id}}}}}}
  {:name :_mka-review-fields
   :parent :zipmap
   :args {:keys [{:value :rating} {:value :body} {:value :author-label} {:value :updated-at}]
          :vals [:_mka-rating :_mka-body :current-user-label :current-instant]}}
  {:name :_mka-review-create
   :parent :create-entity
   :args {:entity-type {:value "package-review"}
          :data {:parent :merge
                 :args {:maps [:_mka-review-fields
                               {:parent :zipmap
                                :args {:keys [{:value :package-name} {:value :author-id} {:value :public?} {:value :created-at}]
                                       :vals [:_mka-name :current-user-id {:value true} :current-instant]}}]}}}}
  {:name :_mka-existing-review-id
   :parent :get :args {:coll :_mka-existing-review :key {:value :id} :default nil}}
  {:name :_mka-review-update
   :parent :update-entity
   :args {:entity-type {:value "package-review"}
          :id {:ref :_mka-existing-review-id :type :uuid}
          :data :_mka-review-fields}}
  ;; A MIRROR takes no local review — the origin registry is the authority.
  {:name :_mka-mirrored?
   :parent :some?
   :args {:value {:parent :get :args {:coll {:parent :_mkl-latest-row :args {:pkg-name :_mka-name}} :key {:value :origin} :default nil}}}}
  {:name :_mka-review-write
   :parent :cond
   :args {:clauses [:_mka-mirrored? {:value nil}
                    {:parent :not :args {:value :_mka-rating-ok?}} {:value nil}
                    {:parent :nil? :args {:value :_mka-existing-review}} :_mka-review-create
                    {:value true} :_mka-review-update]}}
  {:name :_mka-review-notice
   :parent :cond
   :args {:clauses [:_mka-mirrored? {:value "Refused: this package is mirrored from another registry — reviews are written there."}
                    :_mka-rating-ok? {:value "Thanks — your review is posted."}
                    {:value true} {:value "Refused: pick a rating from 1 to 5."}]}}
  {:name :_mka-review-then-item
   :parent :do
   :args {:steps [:_mka-review-write {:parent :marketplace-item-html :args {:pkg-name :_mka-name :notice :_mka-review-notice}}]}}
  {:name :_mka-review-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/marketplace/review (form: name, rating 1–5, body) — upserts the current user's review of the package, then returns the refreshed item."
   :parent :html-ok-response
   :args {:body :_mka-review-then-item}}
  {:name :api-marketplace-review
   :description "POST /api/marketplace/review — form `name`, `rating` (1–5), `body`: write or update the current user's review; one per author per package. Returns the item HTML. Auth-required."
   :parent :post
   :args {:path "/marketplace/review" :handler :_mka-review-handler}}

  ;; --- review: delete own ---
  {:name :_mka-review-delete-do
   :parent :if
   :args {:test {:parent :nil? :args {:value :_mka-existing-review}}
          :then {:value nil}
          :else {:parent :delete-entity
                 :args {:entity-type {:value "package-review"}
                        :id {:ref :_mka-existing-review-id :type :uuid}}}}}
  {:name :_mka-review-delete-then-item
   :parent :do
   :args {:steps [:_mka-review-delete-do {:parent :marketplace-item-html :args {:pkg-name :_mka-name :notice {:value "Your review is deleted."}}}]}}
  {:name :_mka-review-delete-handler
   :lambda-params [:request]
   :description "Ring handler for DELETE /api/marketplace/unreview?name= — deletes the current user's review of the package, then returns the refreshed item."
   :parent :html-ok-response
   :args {:body :_mka-review-delete-then-item}}
  ;; Its own path, not a DELETE on /review: reitit refuses two leaves on one
  ;; path (the registry's uninstall / withdraw follow the same convention).
  {:name :api-marketplace-review-delete
   :description "DELETE /api/marketplace/unreview?name=<pkg> — remove the current user's review. Returns the item HTML. Auth-required."
   :parent :delete
   :args {:path "/marketplace/unreview" :handler :_mka-review-delete-handler}}

  ;; =====================================================================
  ;; POST /api/marketplace/listing — edit the latest version's listing
  ;; (description / category / tags) without a new version. Own package,
  ;; published here (a mirror's listing is its origin's). The decorator
  ;; keeps the write own-org.
  ;; =====================================================================
  {:name :_mkl-latest-row
   :description "The newest visible `:package-version` row of `:pkg-name` (full row, `:payload` and all) — nil when none. Free arg: `:pkg-name`."
   :parent :first
   :args {:coll {:parent :reverse
                 :args {:coll {:parent :sort-by
                               :args {:key-fn :_mkr-rank
                                      :coll {:parent :query-entities
                                             :args {:entity-type {:value "package-version"}
                                                    :where {:parent :assoc-empty :args {:key {:value :name} :value {:as :pkg-name :type :text}}}}}}}}}}}
  {:name :_mkl-row
   :parent :_mkl-latest-row :args {:pkg-name :_mka-name}}
  {:name :_mkl-editable?
   :description "Own (this org's), published here — not a mirror."
   :parent :and
   :args {:values [{:parent :some? :args {:value :_mkl-row}}
                   {:parent :nil? :args {:value {:parent :get :args {:coll :_mkl-row :key {:value :origin} :default nil}}}}
                   {:parent :equal? :args {:a {:parent :to-str :args {:value {:parent :get :args {:coll :_mkl-row :key {:value :org-id} :default {:value ""}}}}}
                                           :b :current-org-id}}]}}
  {:name :_mkl-listing
   :parent :listing-normalize
   :args {:kind {:parent :coalesce :args {:value {:parent :get :args {:coll :_mkl-row :key {:value :kind} :default nil}} :default {:value "fns"}}}
          :description {:parent :_mka-param :args {:param-name {:value "description"}}}
          :category {:parent :_mka-param :args {:param-name {:value "category"}}}
          :tags {:parent :_mka-param :args {:param-name {:value "tags"}}}
          :payload {:value nil}}}
  {:name :_mkl-write
   :parent :update-entity
   :args {:entity-type {:value "package-version"}
          :id {:ref :_mkl-row-id :type :uuid}
          :data {:parent :select-keys :args {:m :_mkl-listing :ks [{:value :description} {:value :category} {:value :tags}]}}}}
  {:name :_mkl-row-id
   :parent :get :args {:coll :_mkl-row :key {:value :id} :default nil}}
  {:name :_mkl-do
   :parent :cond
   :args {:clauses [{:parent :not :args {:value :_mkl-editable?}} {:value nil}
                    {:parent :listing-invalid? :args {:listing :_mkl-listing}} {:value nil}
                    {:value true} :_mkl-write]}}
  {:name :_mkl-notice
   :parent :cond
   :args {:clauses [{:parent :not :args {:value :_mkl-editable?}} {:value "Refused: only the publisher edits a listing, and a mirror's listing is its origin's."}
                    {:parent :listing-invalid? :args {:listing :_mkl-listing}} {:value "Refused: pick a category from the list."}
                    {:value true} {:value "Listing saved — the card shows it."}]}}
  {:name :_mkl-then-item
   :parent :do
   :args {:steps [:_mkl-do {:parent :marketplace-item-html :args {:pkg-name :_mka-name :notice :_mkl-notice}}]}}
  {:name :_mkl-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/marketplace/listing (form: name, description, category, tags) — updates the latest version's listing of an own, locally published package; returns the refreshed item."
   :parent :html-ok-response
   :args {:body :_mkl-then-item}}
  {:name :api-marketplace-listing
   :description "POST /api/marketplace/listing — form `name`, `description`, `category`, `tags`: edit the newest version's listing without publishing a new version. Own packages published on this registry only. Returns the item HTML. Auth-required."
   :parent :post
   :args {:path "/marketplace/listing" :handler :_mkl-handler}}

  ;; =====================================================================
  ;; POST /api/marketplace/publish — a theme or keymap (payload IS the artifact)
  ;; =====================================================================

  {:name :_mkp-body
   :parent :parse-json-body}
  {:name :_mkp-field
   :parent :get :args {:coll :_mkp-body :key {:as :key} :default nil}}
  {:name :_mkp-kind
   :parent :to-str :args {:value {:parent :_mkp-field :args {:key {:value :kind}}}}}
  {:name :_mkp-name
   :parent :str-trim :args {:string :json-body-name}}
  {:name :_mkp-version
   :parent :str-trim :args {:string :_body-version}}
  {:name :_mkp-payload
   :parent :_mkp-field :args {:key {:value :payload}}}
  {:name :_mkp-listing
   :parent :listing-normalize
   :args {:kind :_mkp-kind
          :description {:parent :_mkp-field :args {:key {:value :description}}}
          :category {:parent :_mkp-field :args {:key {:value :category}}}
          :tags {:parent :_mkp-field :args {:key {:value :tags}}}
          :payload {:ref :_mkp-payload :type :nullable-keyword-map}}}
  {:name :_mkp-kind-ok?
   :description "This route publishes the NON-fns kinds — a fns package is a namespace export (POST /api/packages/publish)."
   :parent :or
   :args {:values [{:parent :equal? :args {:a :_mkp-kind :b {:value "theme"}}}
                   {:parent :equal? :args {:a :_mkp-kind :b {:value "keymap"}}}]}}
  {:name :_mkp-empty-bundle
   :description "A theme / keymap carries no fn-defs — the bundle shape with nothing in it."
   :parent :const
   :args {:value {:namespace "" :namespaces [] :fns [] :dependencies [] :package-dependencies []
                  :secrets [] :secret-paths-included? false}}}
  {:name :_mkp-apply
   :parent :publish-package-apply
   :args {:pkg-name :_mkp-name :pkg-version :_mkp-version
          :bundle {:ref :_mkp-empty-bundle :type :package-bundle-shape}
          :pkg-public {:parent :_mkp-field :args {:key {:value :public}}}
          :listing :_mkp-listing}}
  {:name :_mkp-err
   :description "`{:ok false :reason R}` — free arg `:reason`."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :reason} {:value :name} {:value :version}]
          :vals [{:value false} {:as :reason :type :text} :_mkp-name :_mkp-version]}}
  ;; The envelope is a 1-arg CALLEE over the apply's ROW: `:call` runs the
  ;; write ONCE and hands the row-or-nil in under the `row` lambda-param,
  ;; so reading `:id` / `:public?` never re-references the effectful apply
  ;; (which would run it again and answer `version-exists` against its own
  ;; first write — the same trap the panel publish documents).
  {:name :_mkp-ok
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :id} {:value :name} {:value :version} {:value :kind} {:value :public}]
          :vals [{:value true}
                 {:parent :to-str :args {:value {:parent :get :args {:coll {:as :row :type :nullable-keyword-map} :key {:value :id} :default nil}}}}
                 :_mkp-name :_mkp-version :_mkp-kind
                 {:parent :get :args {:coll {:as :row :type :nullable-keyword-map} :key {:value :public?} :default nil}}]}}
  {:name :_mkp-outcome
   :lambda-params [:row]
   :description "The publish envelope for one apply outcome (`row` = the created row, nil = the version existed)."
   :parent :if
   :args {:test {:parent :nil? :args {:value {:as :row :type :nullable-keyword-map}}}
          :then {:parent :_mkp-err :args {:reason {:value "version-exists"}}}
          :else :_mkp-ok}}
  {:name :_mkp-write-result
   :parent :call :args {:func :_mkp-outcome :arg :_mkp-apply}}
  {:name :marketplace-publish-result
   :description "Publish a theme / keymap: refuses `unsupported-kind` (fns go through the namespace publish), `missing-name`, `missing-version`, `missing-payload`, the listing's `bad-category`, and `version-exists`; else `{:ok true :id :name :version :kind :public}`."
   :parent :cond
   :args {:clauses [{:parent :not :args {:value :_mkp-kind-ok?}} {:parent :_mkp-err :args {:reason {:value "unsupported-kind"}}}
                    {:parent :empty? :args {:coll :_mkp-name}} {:parent :_mkp-err :args {:reason {:value "missing-name"}}}
                    {:parent :empty? :args {:coll :_mkp-version}} {:parent :_mkp-err :args {:reason {:value "missing-version"}}}
                    {:parent :empty? :args {:coll :_mkp-payload}} {:parent :_mkp-err :args {:reason {:value "missing-payload"}}}
                    {:parent :listing-invalid? :args {:listing :_mkp-listing}} {:parent :listing-error-envelope :args {:listing :_mkp-listing}}
                    {:value true} :_mkp-write-result]}}
  {:name :_mkp-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/marketplace/publish — JSON `{kind name version description category tags public payload}` → `{ok …}`."
   :parent :json-handler
   :args {:data :marketplace-publish-result}}
  {:name :api-marketplace-publish
   :description "POST /api/marketplace/publish — publish a THEME or KEYMAP version: body `{kind, name, version, description?, category?, tags? (comma string), public?, payload}`. The payload is the artifact (a theme's tokens / a keymap's bindings). Requires the publish-packages capability under tenancy. Auth-required."
   :parent :post
   :args {:path "/marketplace/publish" :handler :_mkp-handler}}]}
