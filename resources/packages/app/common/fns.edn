;; Common fn-def building blocks shared between web components
;; Route composition, response status, content-type responses, health status


{:namespace "app.common"
 :description "Shared application building blocks — route assembly, response status × content-type matrix, health status."
 :fns
 [;; =============================================================================
  ;; COLLECTION BUILDING BLOCKS
  ;; =============================================================================

  ;; NOTE: cascade-based vector builders (`triple`, `list-10-N`, `list-11`,
  ;; `:pair`, `:pair-1`, `:conj-empty`) have been retired in favour of the
  ;; `:list` base-fn (sequence-arg). Routes, request-shape entries, and
  ;; defaults-map entries that previously used `:parent :pair` now use
  ;; `:parent :list :args {:items [a b]}` directly.

  ;; =============================================================================
  ;; ROUTE BUILDING BLOCKS
  ;; Pass-Through Args Pattern: each level sets one arg, free args propagate up
  ;; =============================================================================

  ;; Level 1: assoc with empty map preset (free: key, value)
  {:name :assoc-empty
   :description "`:assoc` with `:map` pre-bound to `{}` — start with a fresh map and add one entry. Free args: `:key`, `:value`."
   :parent :assoc
   :args {:map {}}}

  ;; Level 2: assoc-handler (free: handler) - sets key="handler", renames value->handler
  ;; Diamond inheritance from :assoc: :assoc-fn refines :value to :fn-typed
  ;; (its arg wins for `:value` because it appears first in :parents —
  ;; the child arg name `value` resolves through `:assoc-fn.value`
  ;; whose slot type is `:fn`, which IS the HOF marker). :assoc-empty
  ;; contributes :map={}. Result: handler ref becomes a hof-wrap'd
  ;; Ring callable stored in the route's method-map.
  {:name :assoc-handler
   :description "Build `{\"handler\" <handler-fn>}` — sets `:key=\"handler\"` and the value slot is `:fn`-typed via `:assoc-fn` so the bound fn-graph stays a Ring callable rather than being executed."
   :parents [:assoc-fn :assoc-empty]
   :args {:key "handler"
          :value {:as :handler}}}

  ;; Level 2: method-map (free: method, handler via pass-through from assoc-handler)
  ;; Renames key -> method (HTTP method) and value -> handler (the bound handler fn)
  {:name :method-map
   :description "Build the method-data map reitit consumes — `{<method> {\"handler\" <handler-fn>}}`. Free args: `:method` (HTTP verb string), `:handler` (Ring fn-graph)."
   :parent :assoc-empty
   :args {:value {:as :handler :ref :assoc-handler}
          :key {:as :method}}}

  ;; Level 3: route = [path, method-map] using :list
  ;; First item is the renamed free :path; second is the method-map.
  {:name :route
   :description "Generic reitit route — `[path method-data]`. Own pins: `:path`, `:method`, `:handler`. Method-specific shortcuts below bind `:method`."
   :parent :list
   :args {:items [{:as :path} :method-map]
          :method {:type [:union :text :keyword]
                   :description "HTTP method literal — e.g. `\"GET\"` / `\"POST\"`. Bound to a concrete value by method shortcuts (`:get-route`, `:post-route`, …)."}}}

  ;; Level 4: HTTP method shortcuts (`get-route`, `post-route`, …) live in
  ;; `app.routes.method`. They keep the `-route` suffix because bare
  ;; `:get`/`:post` would clash with base-fns and the auth presets.

  ;; =============================================================================
  ;; ROUTES WITH MIDDLEWARE
  ;; Reitit reads `:middleware` at the route-data level and composes the
  ;; chain around this route's handler. Generic template: the caller
  ;; supplies the middleware list. Method-specific shorthands below
  ;; mirror the plain route family.
  ;; =============================================================================

  ;; Add a "middleware" key to the method-map (route-level middleware).
  {:name :_method-map-with-middleware
   :parent :assoc
   :args {:map :method-map
          :key "middleware"
          :value {:as :middleware}}}

  ;; Route carrying its own middleware list (free: path, handler, middleware).
  {:name :route-with-middleware
   :description "Reitit route that carries its own `:middleware` list — `[path {<method> {\"handler\" h \"middleware\" mw}}]`. Own pins: `:path`, `:method`, `:handler`, `:middleware`."
   :parent :list
   :args {:items [{:as :path} :_method-map-with-middleware]
          :method {:type [:union :text :keyword]
                   :description "HTTP method literal — bound to a concrete value by `:*-route-with-middleware` shortcuts."}
          :middleware {:type [:list :any]
                       :description "Reitit middleware spec list — composed around the route handler."}}}

  ;; Method shortcuts (`get-route-with-middleware`, …) live in
  ;; `app.routes.method` next to their plain-method twins.

  ;; =============================================================================
  ;; RESPONSE MATRIX (status × content-type via multiple inheritance)
  ;;
  ;; Two orthogonal axes inherit from :ring-response and bind one arg each:
  ;;   STATUS axis     binds :status
  ;;   CONTENT-TYPE    binds :headers
  ;;
  ;; Concrete responses combine one of each via :parents [<ct> <status>].
  ;; Diamond inheritance from :ring-response is OK: each axis binds a
  ;; different arg, the remaining :body propagates to the child.
  ;; =============================================================================

  ;; --- STATUS axis ---

  {:name :ok-response
   :description "Status axis: 200. Combine with a content-type fn-def to get a concrete response (e.g. `:json-ok-response`)."
   :parent :ring-response
   :args {:status 200}}

  {:name :not-found-response
   :description "Status axis: 404 Not Found."
   :parent :ring-response
   :args {:status 404}}

  {:name :method-not-allowed-response
   :description "Status axis: 405 Method Not Allowed."
   :parent :ring-response
   :args {:status 405}}

  {:name :error-response
   :description "Status axis: 500 Internal Server Error."
   :parent :ring-response
   :args {:status 500}}

  ;; --- CONTENT-TYPE axis ---

  {:name :json-content-type
   :description "Content-type axis: `application/json`. Combine with a status fn-def via MI to make a concrete response."
   :parent :ring-response
   :args {:headers {"Content-Type" "application/json"}}}

  {:name :html-content-type
   :description "Content-type axis: `text/html; charset=utf-8`."
   :parent :ring-response
   :args {:headers {"Content-Type" "text/html; charset=utf-8"}}}

  {:name :text-content-type
   :description "Content-type axis: `text/plain`."
   :parent :ring-response
   :args {:headers {"Content-Type" "text/plain"}}}

  ;; Cached SVG content-type — its own fn because the :headers map can't be
  ;; merged via MI (it's a single arg, so the whole map is set in one place).
  {:name :cached-svg-content-type
   :description "Content-type axis: `image/svg+xml` + `Cache-Control: public, max-age=86400`. Separate fn because the headers map can't be merged via MI."
   :parent :ring-response
   :args {:headers {"Content-Type" "image/svg+xml"
                    "Cache-Control" "public, max-age=86400"}}}

  ;; --- MATRIX (status × content-type) ---

  {:name :json-ok-response
   :description "200 OK with `application/json` content-type. Free arg: `:body` (already a JSON string)."
   :parents [:json-content-type :ok-response]}
  {:name :html-ok-response
   :description "200 OK with `text/html` content-type. Free arg: `:body` (already an HTML string)."
   :parents [:html-content-type :ok-response]}
  {:name :text-ok-response
   :description "200 OK with `text/plain` content-type. Free arg: `:body`."
   :parents [:text-content-type :ok-response]}
  {:name :cached-svg-ok-response
   :description "200 OK with `image/svg+xml` content-type and a 24-hour `Cache-Control` header. Used for the favicon."
   :parents [:cached-svg-content-type :ok-response]}

  {:name :text-method-not-allowed-response
   :description "405 Method Not Allowed with `text/plain` content-type. Used by the reitit fallback handler."
   :parents [:text-content-type :method-not-allowed-response]}

  {:name :text-not-found-response
   :description "404 Not Found with `text/plain` content-type. Used by the reitit fallback handler."
   :parents [:text-content-type :not-found-response]}

  {:name :text-error-response
   :description "500 Internal Server Error with `text/plain` content-type. Used by the reitit fallback handler."
   :parents [:text-content-type :error-response]}

  ;; =============================================================================
  ;; HEALTH STATUS COMPOSITION
  ;; =============================================================================

  ;; Renames value -> status (the status string being assoc'd)
  {:name :assoc-status
   :description "Add a `\"status\" <status-string>` entry to a fresh map. Free arg: `:status`."
   :parent :assoc-empty
   :args {:key "status"
          :value {:as :status}}}

  ;; Renames value -> timestamp (the timestamp value being assoc'd)
  {:name :assoc-timestamp
   :description "Add a `\"timestamp\" <ts>` entry to a map. Free args: `:map`, `:timestamp`."
   :parent :assoc
   :args {:key "timestamp"
          :value {:as :timestamp}}}

  {:name :health-status-base
   :description "Base health-status map — `{\"status\" \"healthy\"}`. Used as the seed for the timestamped `:health-status`."
   :parent :assoc-status
   :args {:status "healthy"}}

  {:name :health-status
   :description "Full health-status payload — `{\"status\" \"healthy\" \"timestamp\" <ms-since-epoch>}`. Bound under `/health` via the `:_health-handler`."
   :parent :assoc-timestamp
   :args {:map :health-status-base
          :timestamp :current-time-ms}}]}
