                 :_delete-branch-err-not-found]}}

  {:name :_delete-branch-apply-on-throw
   :description "`:try`'s `:on-throw` handler — dispatches on `(:type (ex-data e))`. The 3 ex-info-shaped cases produce structured envelopes; default falls through to a generic `{:ok false :error <message>}`."
   :parent :case
   :args {:value :_delete-branch-apply-ex-type
          :clauses :_delete-branch-apply-clauses
          :default :_delete-branch-err-generic}}

  {:name :_delete-branch-apply
   :description "Delete a branch with structured 4-shape rejection: main-undeletable / has-children / not-found / generic. Pure graph composition over `:delete-branch!` + `:try` + `:case` dispatch on `(ex-data e :type)`."
   :parent :try
   :args {:body :_delete-branch-apply-success
          :on-throw :_delete-branch-apply-on-throw}}

  {:name :_delete-branch-data
   :description "DELETE /api/branches/:ref — flat `:cond` of `[branch-missing? → 404-shape, true → apply]`. The constraint-rejection cases (main / has-children) come from apply."
   :parent :cond
   :args {:clauses [:_delete-branch-missing? :_delete-branch-err-missing
                    {:value true}            :_delete-branch-apply]
          :parsed :_delete-branch-parsed
          :resolved :_delete-branch-resolved}}

  {:name :delete-branch-handler
   :lambda-params [:request :default]
   :description "Ring handler for DELETE /api/branches/:ref (auth-required)."
   :parent :json-handler
   :args {:data :_delete-branch-data}}

