   :parent :get-auth-required
   :args {:path "/partials/inspector-detail" :handler :_partial-inspector-detail-handler}}

  {:name :partial-inspector-overview
   :description "GET /partials/inspector-overview?fn-id={uuid} — the inspector's Overview tab (parent chips with named-ancestor resolution, return type, effects chips), computed server-side off the fn row + rich-types registry. Auth-required (`:get-auth-required`) for the same reason as `/partials/inspector-detail`: it projects tenant-private graph structure and so gates identically to `/api/graph/entities` — closed to anonymous when auth is active, open when auth is off. editor-shell.js swaps it into #gd-insp-overview and post-formats `.gd-prov-mono` type texts."
   :parent :get-auth-required
   :args {:path "/partials/inspector-overview" :handler :_partial-inspector-overview-handler}}

  {:name :partial-settings-build
   :description "GET /partials/settings-build — the Settings 'About this build' backend/packages hash rows as text/html, off the same baked `:build-hashes` resource `/version` serves. PUBLIC like `/version` itself. editor-shell.js swaps it into #gd-set-version."
   :parent :get-route
   :args {:path "/partials/settings-build" :handler :_partial-settings-build-handler}}

  {:name :partial-settings-access
   :description "GET /partials/settings-access — the Settings access card body as text/html: the requester's OWN write/execute capability chips under a tenancy addon (the fact every response already carries in `X-Graphden-Capabilities`), or the single-tenant copy. PUBLIC — per-request, per-principal, nothing cross-principal readable. editor-shell.js swaps it into #gd-set-caps."
