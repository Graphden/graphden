;; Route groups — the top-level entry reitit consumes via `app.server._router`.
;;
;; After the nested-routes refactor, `:all` is no longer a flat list of
;; every endpoint — it's a small list of TOP-LEVEL reitit entries:
;; standalone leaves (`:health`, `:metrics`, `:favicon`, `:editor`) and
;; the `:api-routes` prefix group. Reitit walks the nested vectors and
;; assembles full paths itself.


{:namespace "app.routes.groups"
 :description "The `:all` route bundle — the top-level nested-tree input to reitit's router."
 :fns
 [;; Graphden-owned routes — the editor, /api, partials, asset
  ;; handlers, the contact-demo. Stable list edited only by the
  ;; graphden package itself.
  {:name :_base-routes
   :description "Graphden-owned top-level reitit entries. The user-site-routes mount-point appends after these via :all's :concat."
   :parent :list
   :args {:items [:favicon
                  :editor
                  :editor-js-asset
                  :api-routes-js-asset
                  :graphden-runtime-js-asset
                  :editor-css-asset
                  :partial-effect
                  :partial-fn-versions
                  :partial-fn-version-executions
                  :partial-execute-history
                  :partial-branch-diff
                  :partial-execute-result-effects
                  :partial-mismatch-explainer
                  :partial-provenance
                  :partial-fn-picker-incompat
                  :partial-execute-result
                  :partial-execute-result-inline
                  :partial-branch-popover
                  :partial-service-popover
                  :partial-secrets-panel
                  :partial-row-actions
                  :demo-contact
                  :health
                  :metrics
                  :version
                  :api-routes]}}

  ;; :concat lets user-site-routes (a possibly-empty list) splice
  ;; in as siblings of :_base-routes' entries — if the user has
  ;; no routes the concat is a no-op; if they do, each entry
  ;; appears at the top level of the router.
  {:name :all
   :description "Full reitit route tree — graphden's own routes followed by user-site entries spliced in via :concat. Adding a graphden route = extend :_base-routes; adding a user-site route = extend :user-site-routes (app/user-site/)."
   :parent :concat
   :args {:colls [:_base-routes :user-site-routes]}}]}
