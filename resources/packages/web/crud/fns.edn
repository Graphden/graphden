  {:name :_parse-fn-form-effects-trimmed-items
   :parent :map
   :args {:func :_parse-fn-form-pid-trim-item
          :coll {:parent :str-split
                 :args {:string :_parse-fn-form-effects-raw
                        :separator {:value ","}
                        :limit nil}}}}

  {:name :_parse-fn-form-effects-non-blank
   :parent :filter
   :args {:pred :non-blank?
          :coll :_parse-fn-form-effects-trimmed-items}}

  {:name :_parse-fn-form-effects-parsed
   :description "Parsed effects vec — `nil` on blank/`\"null\"`, `[]` on literal `\"[]\"`, otherwise the CSV-derived vec with leading-colons stripped."
   :parent :cond
