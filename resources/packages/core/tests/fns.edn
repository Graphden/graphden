  ;; --- core.recursion ---------------------------------------------------
  ;; Factorial as a `:fix` worklist: state `{:n :acc}`, one multiplication
  ;; per step, base case at n ≤ 1. The same idiom `:render-prometheus`
  ;; and the registry's install loop use.

  {:name :_fact-n
   :parent :get :args {:coll {:as :input} :key {:value :n} :default nil}}
  {:name :_fact-acc
   :parent :get :args {:coll {:as :input} :key {:value :acc} :default nil}}
  {:name :_fact-next
   :description "The next state — `n - 1`, `acc * n`."
   :parent :zipmap
   :args {:keys [{:value :n} {:value :acc}]
          :vals [{:parent :sub :args {:nums [{:ref :_fact-n :type :int} 1]}}
                 {:parent :mul :args {:nums [{:ref :_fact-acc :type :int} {:ref :_fact-n :type :int}]}}]}}
  {:name :_fact-step
   :description "One step: at `n ≤ 1` return the accumulator, else re-enter with the next state."
   :parent :if
   :args {:test {:parent :lte :args {:nums [{:ref :_fact-n :type :int} 1]}}
          :then :_fact-acc
          :else {:parent :invoke :args {:func {:as :self} :arg :_fact-next}}}}

  {:name :fix-recurses-until-the-step-stops-calling-self
   :description "`:fix` over the factorial step from `{:n 5 :acc 1}` is 120 — five re-entries through `:self`, then the base case."
   :parent :assert-eq
   :args {:actual {:parent :fix :args {:step :_fact-step :input {:value {:n 5 :acc 1}}}}
          :expected 120}}]}
