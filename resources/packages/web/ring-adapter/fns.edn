;; Reusable Ring-request handler pipeline.
;;
;; Produces the `:router-ring-response` building block — the handler
;; bound to `:http-server.handler`. Pipeline:
;;
;;   1. Receives a raw Ring request (single leftover free arg `:request`
;;      via `hof-wrap`'s single-arg callable).
;;   2. Extracts common fields (method/uri/query-string/headers/body)
;;      into an internal map via `:pairs->map` — `:internal-request`.
;;   3. Invokes a router (free arg `:func`) on that internal request
;;      → `:router-result` is a Ring response map.
;;   4. Adds default security headers on top of the router's headers
;;      (`(update response :headers #(merge defaults %))`). Status and
;;      body pass through untouched.
;;
;; Consumers supply the concrete router via `:func` (bound on a child of
;; `:router-ring-response`) and pass that child directly to
;; `:http-server.handler` (`:fn`-typed; the compile-time hof-wrap turns
;; the fn-graph into a single-arg Ring callable).
;;
;; Auth is expressed per-route via reitit middleware (see
;; `:auth-required-middleware` below) — no pre-router path-gating layer.


{:namespace "web.ring-adapter"
 :description "Ring request → router → response pipeline, plus bearer-token auth middleware. The `:router-ring-response` fn-def is the canonical shape bound to `:http-server.handler`."
 :fns
 [;; =============================================================================
  ;; STRUCTURAL TYPE — Ring request shape
  ;; =============================================================================
  ;; The matching `:ring-response-shape` is declared in core/system
  ;; (alongside `:ring-response`, the assoc-chain that builds it).
  ;; Together they let `:http-server.handler` be typed as the fn-type
  ;; `[:fn {:request :ring-request-shape} :ring-response-shape]`
  ;; instead of bare `:fn`, so `:add` (arithmetic) gets rejected at
  ;; sync-time rather than crashing at runtime.

  {:name :ring-request-shape
   :description "Structural shape of an inbound Ring HTTP request map."
   :type {:request-method :keyword
          :uri            :text
          :query-string   :text
          :headers        :jsonb
          :body           :any}}

  ;; =============================================================================
  ;; RING REQUEST EXTRACTION
  ;; =============================================================================

  ;; Single holder for the Ring request. All field extractors reference
  ;; this one fn so the same request value flows into each `get`. The
  ;; rename `value/as :request` exposes `:value` as the free arg
  ;; `:request`. Ring HOFs that pass ONE request (`:http-server`,
  ;; per-route handlers via `:assoc-fn`) hand the callable a raw request
  ;; — single-leftover wrap routes it under `:request`. Middleware (which
  ;; also needs to inject `:next-handler`) uses the map-callable wrap and
  ;; supplies both keys; this fn still picks `:request` out of the
  ;; resulting free-args map.
  {:name :ring-request
   :description "Single holder for the inbound Ring request — identity rename that exposes `:value` as the free arg `:request`. All field extractors below source from this one fn so each request flows through it once."
   :parent :identity
   :args {:value {:as :request :type :ring-request-shape}}}

  ;; Shared `:coll :ring-request` lookup — factor out the common binding so
  ;; each field extractor below just names the key it wants.
  {:name :ring-request-field
   :description "Helper that binds `:coll :ring-request` once. Children name the field they want via `:key` instead of repeating the request binding."
   :parent :get
   :args {:coll :ring-request}}

  {:name :ring-method
   :description "HTTP method keyword from the Ring request (e.g. `:get`, `:post`)."
   :parent :ring-request-field
   :args {:key {:value :request-method}}}

  {:name :ring-uri
   :description "Path portion of the request URI (e.g. `\"/api/entities\"`)."
   :parent :ring-request-field
   :args {:key {:value :uri}}}

  {:name :ring-query-string
   :description "Raw query string from the request (without leading `?`), nil if absent."
   :parent :ring-request-field
   :args {:key {:value :query-string}}}

  {:name :ring-headers
   :description "Header map from the Ring request — string keys, lower-cased per Ring convention."
   :parent :ring-request-field
   :args {:key {:value :headers}}}

  {:name :ring-body-input-stream
   :description "Raw body InputStream from the Ring request — feed into `:slurp` to get a string, or directly into a parser."
   :parent :ring-request-field
   :args {:key {:value :body}}}

  {:name :ring-body
   :description "Request body slurped to a string."
   :parent :slurp
   :args {:input :ring-body-input-stream}}

  ;; =============================================================================
  ;; INTERNAL REQUEST SHAPE — one :pairs->map with 5 pair entries.
  ;; =============================================================================

  {:name :ring-method-entry
   :description "`[:request-method <method>]` entry for the internal-request map."
   :parent :list
   :args {:items [{:value :request-method :literal? true} :ring-method]}}

  {:name :ring-uri-entry
   :description "`[:uri <path>]` entry for the internal-request map."
   :parent :list
   :args {:items [{:value :uri :literal? true} :ring-uri]}}

  {:name :ring-query-string-entry
   :description "`[:query-string <qs>]` entry for the internal-request map."
   :parent :list
   :args {:items [{:value :query-string :literal? true} :ring-query-string]}}

  {:name :ring-headers-entry
   :description "`[:headers <headers>]` entry for the internal-request map."
   :parent :list
   :args {:items [{:value :headers :literal? true} :ring-headers]}}

  {:name :ring-body-entry
   :description "`[:body <input-stream>]` entry for the internal-request map. We pass the raw httpkit InputStream straight through (NOT pre-slurped via `:ring-body`) — slurping at this layer would consume the body before it reaches a handler that lives below an `:auth-required-middleware`, leaving downstream `(:body request)` reads with an empty string. Handlers slurp on demand via the `slurp-body` helper or pass directly to `json/parse-string` (which accepts InputStream)."
   :parent :list
   :args {:items [{:value :body :literal? true} :ring-body-input-stream]}}

  {:name :internal-request
   :description "Internal request map — `{:request-method :uri :query-string :headers :body}` — fed to the router. All five field extractors plug into one `:pairs->map`."
   :parent :pairs->map
   :args {:entries [:ring-method-entry
                    :ring-uri-entry
                    :ring-query-string-entry
                    :ring-headers-entry
                    :ring-body-entry]}}

  ;; =============================================================================
  ;; ROUTER INVOCATION + RESPONSE EXTRACTION
  ;; `:func` is a FREE arg — the consuming fn binds it to a concrete router
  ;; fn-def (e.g. `:_router`). `:arg` is bound to the extracted internal
  ;; request so every router call receives the same shape.
  ;; =============================================================================

  {:name :router-result
   :description "Invoke the router callable (`:func`, free arg supplied by the consuming fn) on the parsed `:internal-request`. The result is a Ring response map."
   :parent :invoke
   :args {:arg :internal-request}}

  ;; Opinionated default security headers — merged into every response.
  ;; Stringified once (JSONB roundtrip turns string keys into keywords;
  ;; http-kit needs strings).
  {:name :_default-security-headers-raw
   :parent :const
   :args {:value {"X-Content-Type-Options" "nosniff"
                  "X-Frame-Options" "DENY"
                  "X-XSS-Protection" "1; mode=block"
                  "Referrer-Policy" "strict-origin-when-cross-origin"}}}

  {:name :default-security-headers
   :description "Default security-header map merged into every response — `X-Content-Type-Options`, `X-Frame-Options`, `X-XSS-Protection`, `Referrer-Policy`. Keys are stringified for http-kit."
   :parent :stringify-map-keys
   :args {:m :_default-security-headers-raw}}

  ;; Take the router-result (a Ring response map) and merge default
  ;; security headers into its `:headers`. One node, no re-assembly:
  ;;   (update response :headers #(merge defaults %))
  {:name :router-ring-response
   :description "Run the router (`:func`) on the parsed `:internal-request` and merge default security headers into the response. The fn-graph bound to `:http-server.handler`."
   :parent :merge-in
   :args {:m :router-result
          :path [{:value :headers :literal? true}]
          :defaults :default-security-headers}}

  ;; =============================================================================
  ;; AUTH — Bearer token primitives (opinionated defaults)
  ;; =============================================================================

  ;; nil when AUTH_TOKEN is unset. `token-valid?` below explicitly
  ;; rejects nil env-tokens (`(and (some? env) (= bearer env))`), so
  ;; an unconfigured server cleanly returns 401 for every auth-required
  ;; request instead of 500-ing through `env-required`'s throw. The
  ;; `(= nil nil)` bypass is closed by the `some?` gate, not by env's
  ;; throw.
  {:name :auth-token-from-env
   :description "`AUTH_TOKEN` env var, or nil when unset. `token-valid?` rejects nil-vs-nil to prevent the bypass — so missing AUTH_TOKEN means \"every authed request returns 401\", not \"server crashes with 500\"."
   :parent :env
   :args {:name "AUTH_TOKEN"}}

  {:name :_auth-token-configured?
   :parent :some?
   :args {:value :auth-token-from-env}}

  {:name :_bearer-equals-env?
   :parent :equal?
   :args {:a :bearer-token :b :auth-token-from-env}}

  ;; Missing `Authorization` header → `get` returns nil; downstream
  ;; `has-bearer-prefix?` is nil-safe (returns false), so no default
  ;; needed here. Keeps the node free of literal-default clutter.
  {:name :authorization-header
   :description "Raw `Authorization` header from the request (nil when absent)."
   :parent :get
   :args {:coll :ring-headers :key "authorization"}}

  {:name :has-bearer-prefix?
   :description "True iff the `Authorization` header starts with `\"Bearer \"`. Nil-safe — false for missing header."
   :parent :str-starts-with?
   :args {:string :authorization-header :prefix "Bearer "}}

  {:name :bearer-token-raw
   :description "Substring of the `Authorization` header after the `\"Bearer \"` prefix — only meaningful when `:has-bearer-prefix?` is true."
   :parent :subs
   :args {:string :authorization-header :start 7}}

  {:name :bearer-token
   :description "Bearer token value when the header has the `\"Bearer \"` prefix, else nil. Guards against treating arbitrary header content as a token."
   :parent :if
   :args {:test :has-bearer-prefix? :then :bearer-token-raw :else nil}}

  {:name :token-valid?
   :description "True iff AUTH_TOKEN is configured AND the request's bearer token equals it. The `some?` gate closes the `(= nil nil)` bypass — when AUTH_TOKEN is unset, requests without a header would otherwise spuriously validate."
   :parent :and
   :args {:values [:_auth-token-configured? :_bearer-equals-env?]}}

  ;; 401 response used by auth middleware on failure.
  {:name :_default-auth-fail-body
   :parent :ring-response
   :args {:status 401
          :headers {"Content-Type" "text/plain"}}}

  {:name :default-auth-fail-response
   :description "Canonical 401 response used by `auth-required-middleware` when the bearer token is missing or wrong — `{:status 401 :body \"Unauthorized\"}` with text content-type."
   :parent :_default-auth-fail-body
   :args {:body "Unauthorized"}}

  ;; =============================================================================
  ;; AUTH MIDDLEWARE
  ;; Body is a Ring-shaped fn-graph: if token valid → proceed to the next
  ;; handler in the middleware chain, else return the 401 response
  ;; directly. Attached to protected routes via `:middleware
  ;; [:auth-required-middleware]` in the route's method-data. No pre-router
  ;; path-gating layer — the router reads route-data once, runs the chain,
  ;; dispatches.
  ;; =============================================================================

  {:name :_auth-required-body
   :parent :if
   :args {:test :token-valid?
          :then :proceed
          :else :default-auth-fail-response}}

  {:name :auth-required-middleware
   :description "Bearer-token auth middleware. When the request's token matches `AUTH_TOKEN`, calls `:proceed` (next handler in the chain); otherwise returns the 401 response directly. Attached per-route via `:middleware [:auth-required-middleware]` in route-data."
   :parent :middleware
   :args {:name {:value :auth-required}
          :body :_auth-required-body}}

  ;; =============================================================================
  ;; ENTRY POINT
  ;; The consumer binds a router fn-graph (usually wrapped into
  ;; `:router-ring-response`) directly to the web server's `:handler` slot.
  ;; `:handler` is declared `:fn`-type on `:http-server`, so compile's
  ;; hof-wrap turns the fn-graph into a Ring callable automatically.
  ;; =============================================================================
  ]}
