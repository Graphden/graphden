;; Common fn-def building blocks shared between web components
;; Route composition, response status, content-type responses, health status

[;; =============================================================================
 ;; COLLECTION BUILDING BLOCKS
 ;; =============================================================================

 ;; conj to empty vector - first element of a list (free: item)
 {:name :conj-empty
  :parent :conj-any
  :args {:coll []}}

 ;; pair: builds [item1, item2] - a 2-element vector
 ;; pair-1 starts chain, renames item->item1 (free: item1)
 {:name :pair-1
  :parent :conj-empty
  :args {:item {:as :item1}}}

 ;; pair adds second item (free: item1 from pair-1, item2)
 {:name :pair
  :parent :conj-any
  :args {:coll :pair-1
         :item {:as :item2}}}

 ;; triple: builds [item1, item2, item3] - a 3-element vector
 ;; triple adds third item to pair (free: item1, item2 from pair, item3)
 {:name :triple
  :parent :conj-any
  :args {:coll :pair
         :item {:as :item3}}}

 ;; =============================================================================
 ;; LIST-10: 10-element vector builder
 ;; Hidden cascade of conj-any calls, exposes item1...item10 as free args
 ;; =============================================================================
 {:name :list-10-4
  :parent :conj-any
  :args {:coll :triple :item {:as :item4}}}

 {:name :list-10-5
  :parent :conj-any
  :args {:coll :list-10-4 :item {:as :item5}}}

 {:name :list-10-6
  :parent :conj-any
  :args {:coll :list-10-5 :item {:as :item6}}}

 {:name :list-10-7
  :parent :conj-any
  :args {:coll :list-10-6 :item {:as :item7}}}

 {:name :list-10-8
  :parent :conj-any
  :args {:coll :list-10-7 :item {:as :item8}}}

 {:name :list-10-9
  :parent :conj-any
  :args {:coll :list-10-8 :item {:as :item9}}}

 {:name :list-10
  :parent :conj-any
  :args {:coll :list-10-9 :item {:as :item10}}}

 {:name :list-11
  :parent :conj-any
  :args {:coll :list-10 :item {:as :item11}}}

 ;; =============================================================================
 ;; ROUTE BUILDING BLOCKS
 ;; Pass-Through Args Pattern: each level sets one arg, free args propagate up
 ;; =============================================================================

 ;; Level 1: assoc with empty map preset (free: key, value)
 {:name :assoc-empty
  :parent :assoc-any
  :args {:map {}}}

 ;; Level 2: assoc-handler (free: handler) - sets key="handler", renames value->handler
 ;; handler is executed and result (Clojure fn) is stored in map
 {:name :assoc-handler
  :parent :assoc-empty
  :args {:key "handler"
         :value {:as :handler}}}

 ;; Level 2: method-map (free: key, handler via pass-through from assoc-handler)
 {:name :method-map
  :parent :assoc-empty
  :args {:value :assoc-handler}}

 ;; Level 3: route = [path, method-map] using pair
 ;; Rename item1 -> path (handler is already renamed in method-map)
 {:name :route
  :parent :pair
  :args {:item2 :method-map
         :item1 {:as :path}}}

 ;; Level 4: HTTP method routes (free: path, handler)
 {:name :get-route
  :parent :route
  :args {:key "get"}}

 {:name :post-route
  :parent :route
  :args {:key "post"}}

 {:name :put-route
  :parent :route
  :args {:key "put"}}

 {:name :delete-route
  :parent :route
  :args {:key "delete"}}

 {:name :patch-route
  :parent :route
  :args {:key "patch"}}

 ;; =============================================================================
 ;; RESPONSE STATUS HIERARCHY
 ;; =============================================================================

 {:name :ok-response
  :parent :ring-response
  :args {:status 200}}

 {:name :not-found-response
  :parent :ring-response
  :args {:status 404}}

 {:name :error-response
  :parent :ring-response
  :args {:status 500}}

 ;; =============================================================================
 ;; CONTENT-TYPE RESPONSE HIERARCHY
 ;; =============================================================================

 ;; JSON responses
 {:name :json-ok-response
  :parent :ok-response
  :args {:headers {"Content-Type" "application/json"}}}

 ;; HTML responses
 {:name :html-ok-response
  :parent :ok-response
  :args {:headers {"Content-Type" "text/html; charset=utf-8"}}}

 ;; Plain text responses
 {:name :text-ok-response
  :parent :ok-response
  :args {:headers {"Content-Type" "text/plain"}}}

 {:name :text-not-found-response
  :parent :not-found-response
  :args {:headers {"Content-Type" "text/plain"}}}

 {:name :text-error-response
  :parent :error-response
  :args {:headers {"Content-Type" "text/plain"}}}

 ;; JSON error/not-found responses
 {:name :json-error-response
  :parent :error-response
  :args {:headers {"Content-Type" "application/json"}}}

 {:name :json-not-found-response
  :parent :not-found-response
  :args {:headers {"Content-Type" "application/json"}}}

 ;; HTML error/not-found responses
 {:name :html-error-response
  :parent :error-response
  :args {:headers {"Content-Type" "text/html; charset=utf-8"}}}

 {:name :html-not-found-response
  :parent :not-found-response
  :args {:headers {"Content-Type" "text/html; charset=utf-8"}}}

 ;; HTML with bad request status
 {:name :bad-request-response
  :parent :ring-response
  :args {:status 400}}

 {:name :html-bad-request-response
  :parent :bad-request-response
  :args {:headers {"Content-Type" "text/html; charset=utf-8"}}}

 ;; SVG responses
 {:name :svg-ok-response
  :parent :ok-response
  :args {:headers {"Content-Type" "image/svg+xml"}}}

 ;; Cached SVG (for static assets like favicon)
 ;; Inherits from ok-response directly to avoid header override
 {:name :cached-svg-ok-response
  :parent :ok-response
  :args {:headers {"Content-Type" "image/svg+xml"
                   "Cache-Control" "public, max-age=86400"}}}

 ;; =============================================================================
 ;; HEALTH STATUS COMPOSITION
 ;; =============================================================================

 {:name :assoc-status
  :parent :assoc-empty
  :args {:key "status"}}

 {:name :assoc-timestamp
  :parent :assoc
  :args {:key "timestamp"}}

 {:name :health-status-base
  :parent :assoc-status
  :args {:value "healthy"}}

 {:name :health-status
  :parent :assoc-timestamp
  :args {:map :health-status-base
         :value :current-time-ms}}]
