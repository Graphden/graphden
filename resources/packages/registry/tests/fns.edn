          :expected {:value {:count 1 :avg 3.0}}}}

  {:name :card-installs-are-looked-up-by-name-in-the-install-map
   :parent :assert-eq
   :args {:actual {:parent :get :args {:coll :_t-card-q :key {:value :installs} :default nil}}
          :expected 7}}

