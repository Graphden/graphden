;; Logic and conditional base functions
;; All functions require implementations in impls.clj


{:namespace "core.logic"
 :description "Boolean logic, branching, defaults, and constant primitives."
 :fns
 [;; === Logic ===
  {:name :and
   :description "Logical AND over a vector — true iff every value is truthy."
   :args {:values {:type :jsonb :description "Vector of values to AND."}}
   :return-type :bool}

  {:name :or
   :description "Logical OR over a vector — true iff at least one value is truthy."
   :args {:values {:type :jsonb :description "Vector of values to OR."}}
   :return-type :bool}

  {:name :not
   :description "Boolean negation."
   :args {:value {:type :any :description "Any value; truthy → false, falsy → true."}}
   :return-type :bool}

  {:name :some?
   :description "True iff value is non-nil."
   :args {:value {:type :any :description "Value to test for nilness."}}
   :return-type :bool}

  {:name :nil?
   :description "True iff value is nil."
   :args {:value {:type :any :description "Value to test for nilness."}}
   :return-type :bool}

  ;; === Conditionals ===
  {:name :if
   :description "Two-branch conditional. Returns `then` when `test` is truthy, else `else` (nil if omitted)."
   :args {:test {:type :any :description "Truthy/falsy expression."}
          :then {:type :any :description "Returned when test is truthy."}
          :else {:type :any :required false
                 :description "Returned when test is falsy. Defaults to nil."}}
   :return-type :any}

  {:name :cond
   :description "Multi-branch — evaluates pairs `[test result …]`, returns the first result whose test is truthy."
   :args {:clauses {:type :jsonb :description "Vector of alternating tests and result expressions."}}
   :return-type :any}

  {:name :case
   :description "Constant-time dispatch on `value`; returns the matching clause's result, else `default`."
   :args {:value {:type :any :description "Value to match."}
          :clauses {:type :jsonb :description "Vector of `[match result …]` pairs."}
          :default {:type :any :required false
                    :description "Fallback when no clause matches. Defaults to nil."}}
   :return-type :any}

  ;; === Defaults ===
  {:name :coalesce
   :description "Returns `value` if non-nil, else `default`."
   :args {:value {:type :any :description "Primary value; used when non-nil."}
          :default {:type :any :description "Fallback used when value is nil."}}
   :return-type :any}

  ;; === Constants ===
  {:name :const
   :description "Identity-style passthrough — returns `:value` unchanged. Building block for capture renames `{:as :name}`."
   :args {:value {:type :any :description "Value to return as-is."}}
   :return-type :any}

  {:name :identity
   :description "Alias of `:const`."
   :parent :const}

  {:name :equal?
   :description "Two-arg equality (Clojure's `=`). Composition-friendly variant of `:eq`."
   :args {:a {:type :any :description "Left operand."}
          :b {:type :any :description "Right operand."}}
   :return-type :bool}]}
