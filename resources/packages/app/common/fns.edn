;; Common fn-def building blocks shared between web components
;; Route composition, health status. (The HTTP response matrix lives in
;; the web.response module.)


{:namespace "app.common"
 :description "Shared application building blocks — route assembly + health status. (HTTP response matrix lives in web.response.)"
 :fns
 [;; =============================================================================
  ;; COLLECTION BUILDING BLOCKS
  ;; =============================================================================

  ;; =============================================================================
  ;; ROUTE BUILDING BLOCKS
  ;; Pass-Through Args Pattern: each level sets one arg, free args propagate up
  ;; =============================================================================

  ;; Level 1 (`:assoc-empty`) lives in `core.collections` — it's a generic
  ;; collection primitive that `core.system` / `web.crud` also use, so it
  ;; can't live in `app.*`. Referenced by name below; resolves globally.

  ;; Level 2: assoc-handler (free: handler) - sets key="handler", renames value->handler
  ;; Diamond inheritance from :assoc: :assoc-fn refines :value to :fn-typed
  ;; (its arg wins for `:value` because it appears first in :parents —
  ;; the child arg name `value` resolves through `:assoc-fn.value`
  ;; whose slot type is `:fn`, which IS the HOF marker). :assoc-empty
  ;; contributes :map={}. Result: handler ref becomes a hof-wrap'd
  ;; Ring callable stored in the route's method-map.
  {:name :assoc-handler
   :description "Build `{\"handler\" <handler-fn>}` — sets `:key=\"handler\"` and the value slot is `:fn`-typed via `:assoc-fn` so the bound fn-graph stays a Ring callable rather than being executed."
   :parents [:assoc-fn :assoc-empty]
   :args {:key "handler"
          :value {:as :handler}}}

  ;; Level 2: method-map (free: method, handler via pass-through from assoc-handler)
  ;; Renames key -> method (HTTP method) and value -> handler (the bound handler fn)
  {:name :method-map
   :description "Build the method-data map reitit consumes — `{<method> {\"handler\" <handler-fn>}}`. Free args: `:method` (HTTP verb string), `:handler` (Ring fn-graph)."
   :parent :assoc-empty
   :args {:value {:as :handler :ref :assoc-handler}
          :key {:as :method}}}

  ;; Level 3: route = [path, method-map] using :list
  ;; First item is the renamed free :path; second is the method-map.
  {:name :route
   :description "Generic reitit route — `[path method-data]`. Own pins: `:path`, `:method`, `:handler`. Method-specific shortcuts below bind `:method`."
   :parent :list
   :args {:items [{:as :path} :method-map]
          :method {:type :keyword-or-text
                   :description "HTTP method literal — e.g. `\"GET\"` / `\"POST\"`. Bound to a concrete value by method shortcuts (`:get-route`, `:post-route`, …)."}}}

  ;; Level 4: HTTP method shortcuts (`get-route`, `post-route`, …) live in
  ;; `app.routes.method`. They keep the `-route` suffix because bare
  ;; `:get`/`:post` would clash with base-fns and the auth presets.

  ;; =============================================================================
  ;; ROUTES WITH MIDDLEWARE
  ;; Reitit reads `:middleware` at the route-data level and composes the
  ;; chain around this route's handler. Generic template: the caller
  ;; supplies the middleware list. Method-specific shorthands below
  ;; mirror the plain route family.
  ;; =============================================================================

  ;; Add a "middleware" key to the method-map (route-level middleware).
  {:name :_method-map-with-middleware
   :parent :assoc
   :args {:map :method-map
          :key "middleware"
          :value {:as :middleware}}}

  ;; Route carrying its own middleware list (free: path, handler, middleware).
  {:name :route-with-middleware
   :description "Reitit route that carries its own `:middleware` list — `[path {<method> {\"handler\" h \"middleware\" mw}}]`. Own pins: `:path`, `:method`, `:handler`, `:middleware`."
   :parent :list
   :args {:items [{:as :path} :_method-map-with-middleware]
          :method {:type :keyword-or-text
                   :description "HTTP method literal — bound to a concrete value by `:*-route-with-middleware` shortcuts."}
          :middleware {:type [:list :any]
                       :description "Reitit middleware spec list — composed around the route handler."}}}

  ;; Method shortcuts (`get-route-with-middleware`, …) live in
  ;; `app.routes.method` next to their plain-method twins.

  ;; The HTTP RESPONSE MATRIX (status × content-type — `:ok-response`,
  ;; `:json-content-type`, `:json-ok-response`, `:text-*-response`, …)
  ;; lives in the `web.response` module: `web.crud` / `web.reitit-text`
  ;; reach into it, and a web package can't depend on app. Referenced by
  ;; name (resolves globally); app's uses are app→web.

  ;; =============================================================================
  ;; HEALTH STATUS COMPOSITION
  ;; =============================================================================

  ;; Renames value -> status (the status string being assoc'd)
  {:name :assoc-status
   :description "Add a `\"status\" <status-string>` entry to a fresh map. Free arg: `:status`."
   :parent :assoc-empty
   :args {:key "status"
          :value {:as :status}}}

  ;; Renames value -> timestamp (the timestamp value being assoc'd)
  {:name :assoc-timestamp
   :description "Add a `\"timestamp\" <ts>` entry to a map. Free args: `:map`, `:timestamp`."
   :parent :assoc
   :args {:key "timestamp"
          :value {:as :timestamp}}}

  {:name :health-status-base
   :description "Base health-status map — `{\"status\" \"healthy\"}`. Used as the seed for the timestamped `:health-status`."
   :parent :assoc-status
   :args {:status "healthy"}}

  {:name :health-status
   :description "Full health-status payload — `{\"status\" \"healthy\" \"timestamp\" <ms-since-epoch>}`. Bound under `/health` via the `:_health-handler`."
   :parent :assoc-timestamp
   :args {:map :health-status-base
          :timestamp :current-time-ms}}]}
