# Graphden Executor Server Configuration
# Copy this file to .env and adjust values as needed

# Server settings
PORT=8080

# Storage type: memory | postgres
# - memory: In-memory storage (for testing, data lost on restart)
# - postgres: PostgreSQL with full stack (versioning + caching + metrics)
STORAGE_TYPE=postgres

# PostgreSQL connection settings (required when STORAGE_TYPE=postgres)
JDBC_URL=jdbc:postgresql://localhost:5432/graphden
DB_USERNAME=graphden
DB_PASSWORD=graphden
DB_POOL_SIZE=10
