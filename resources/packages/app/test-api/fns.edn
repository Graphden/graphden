;; Tests API — the `tests` namespace convention (Roadmap Block 3.1).
;;
;; A test is a named fn in a namespace whose dotted path contains the
;; segment `tests`; it passes when it executes without a throw
;; (`:assert` / `:assert-eq` are the failure vocabulary). Discovery,
;; the sequential runner and the latest-status join live in
;; `graphden.crud.test-runs`; this module is the HTTP face — request
;; parsing as graph composition (the `:_execute-parsed` pattern) over
;; two thin boundary base-fns. The editor's surfaces (the ✓ tests lens
;; with its Run-all action, the Inspector's Test section with its
;; Run-this-test action) are composed over the same two base-fns —
;; `app/editor-provenance/fns.edn` `_insp-test-*`.

{:namespace "app.test-api"
 :description "Tests API: POST /api/tests/run (run the branch's tests through the execute pipeline), GET /api/tests/status (per-test latest status of the current version) and the SSE ping stream the editor's ✓ tests lens re-primes on."
 :fns
 [;; ---------------------------------------------------------------------
  ;; POST /api/tests/run — body `{fn-ids?: [uuid-str …], timeout-ms?: int}`
  ;; ---------------------------------------------------------------------

  {:name :_tests-run-body
   :description "POST /api/tests/run request body parsed as JSON; nil for an empty body (= run all tests)."
   :parent :parse-json-body}

  {:name :_tests-run-fn-ids
   :parent :get :args {:coll :_tests-run-body :key {:value :fn-ids} :default nil}}

  {:name :_tests-run-timeout-ms
   :parent :get :args {:coll :_tests-run-body :key {:value :timeout-ms} :default nil}}

  {:name :_tests-run-apply
   :description "Single `test-runs/run-tests!` call — sequential execution of the branch's tests through the standard execute pipeline (effect gating, redaction, per-org caps, persistence), summarised as `{:total :passed :failed :other :results}`. `:request` is unused data-wise but pins the fn to the request scope so the summary is never call-cached across requests."
   :args {:request {:type :ring-request-shape
                    :description "The Ring request (scope pin only)."}
          :fn-ids {:type [:union :null [:list :text]]
                   :description "Optional fn-id strings — run only these tests; nil = every test on the branch."}
          :timeout-ms {:type :nullable-int
                       :description "Per-test deref timeout; nil = 10000 ms. An overrunning test reports `:pending` and its terminal status lands on the execution row asynchronously."}}
   :return-type {:total :int :passed :int :failed :int :other :int
                 :results [:list :keyword-map]}
   :effects #{:db}}

  {:name :_tests-run
   :description "The apply stage with the body fields bound — `:request` stays free and unifies with the parse chain's request."
   :parent :_tests-run-apply
   :args {:fn-ids :_tests-run-fn-ids
          :timeout-ms :_tests-run-timeout-ms}}

  {:name :tests-run-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/tests/run."
   :parent :json-handler
   :args {:data :_tests-run}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/tests/status
  ;; ---------------------------------------------------------------------

  {:name :_tests-status-apply
   :description "Single `test-runs/tests-with-statuses` call — every test fn on the current branch joined with the newest execution of its CURRENT version (`:status` nil = never ran since last edit; keying by current version makes an edited test read as stale by construction). `:request` pins the request scope, as in `:_tests-run-apply`."
   :args {:request {:type :ring-request-shape
                    :description "The Ring request (scope pin only)."}}
   :return-type [:list :keyword-map]
   :effects #{:db}}

  {:name :tests-status-handler
   :lambda-params [:request]
   :description "Ring handler for GET /api/tests/status."
   :parent :json-handler
   :args {:data :_tests-status-apply}}

  ;; ---------------------------------------------------------------------
  ;; LIVE signal — GET /partials/tests-stream. A PING (server time) over
  ;; SSE: `:wake-on-writes` fires on any graphden_events event (graph
  ;; writes AND the `test:updated` nudge run-tests! emits after every
  ;; test), ~200 ms debounce; `:interval-ms` is the keepalive ceiling.
  ;; The editor keeps this stream open while the ✓ tests lens is active
  ;; and re-primes `/api/tests/status` on each ping, so the Explorer's
  ;; status dots move as runs land (editor-tests.js).
  ;;
  ;; A ping, deliberately not data: a long-lived stream's captured render
  ;; freezes data-dependent fragments (observed live — a body pushed on
  ;; every tick re-rendered stale), whereas a `:time`-effect fragment
  ;; re-renders every tick by construction (cacheability excludes :time).
  ;; ---------------------------------------------------------------------
  {:name :_tests-ping
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "tests-ping"}}
          :children [{:parent :to-str :args {:value {:parent :current-time-ms :args {}}}}]}}

  {:name :_tests-stream-handler
   :lambda-params [:request]
   :description "SSE ping stream for the ✓ tests lens — write-wakes + 30 s keepalive; each pushed ping tells the editor to re-prime `/api/tests/status`."
   :parent :sse-fragment-handler
   :args {:fragment :_tests-ping
          :interval-ms 30000
          :wake-on-writes true}}]}
