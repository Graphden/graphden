// Graphden Graph Data Schema (2-Entity Model)
// This schema defines the structure for storing function composition graphs.
//
// === Core Entities ===
// Only 2 entities: fn and arg
// - fn: function (base-fn if parent_id=null, composed otherwise)
// - arg: argument with value/ref-id, inheritance via source_id, HOF via is_fn
//
// === Versioning ===
// Versioned entities use two-table pattern: stable id + version table.
// Version tables are append-only: each change adds a new record.
//
// === Version Resolution Algorithm ===
// To resolve current version of entity E on branch B:
//   1. Find latest version record for E where branch_id = B (own version).
//   2. Find all branch_merge records where target_branch_id = B
//      and target_timestamp > own version's created_at (or all, if no own version).
//   3. For each such merge, find latest version of E in source_branch
//      where created_at <= source_timestamp.
//   4. Among all candidates (own + from merges), pick the one with the
//      greatest effective timestamp (own created_at, or merge's target_timestamp).
//   5. If no version found on B, walk up to base_branch_id and repeat.
//
// This avoids duplicating version records on merge. A single branch_merge
// record makes all source branch versions visible in the target branch.

Enum value_kind {
  null
  bool
  int
  numeric
  text
  uuid
  timestamptz
  jsonb
  bytes
  fn
  any
}

// === Branching ===

Table branch {
  id uuid [primary key]
  name text [not null]
  base_branch_id uuid [ref: > branch.id]
  created_at timestamptz [not null]
}

// Merge record: makes source branch versions visible in target branch.
// source_timestamp = snapshot point in source (versions created_at <= this are included).
// target_timestamp = effective time in target (for ordering among multiple merges).
// No version records are copied — this single record is sufficient.
// Conflict detection: entity modified in both source and target after fork point = conflict.
Table branch_merge {
  id uuid [primary key]
  source_branch_id uuid [not null, ref: > branch.id]
  source_timestamp timestamptz [not null]
  target_branch_id uuid [not null, ref: > branch.id]
  target_timestamp timestamptz [not null]
  created_at timestamptz [not null]

  indexes {
    (target_branch_id, target_timestamp) [name: 'idx_branch_merge_target_lookup']
  }
}

// === Entity: fn ===

// Function entity (stable identity).
// - parent_id = null: base function (name references Clojure implementation)
// - parent_id set: composed function (inherits from parent)
Table fn {
  id uuid [primary key]
}

// Version of a function. Append-only history.
// Can change: name, parent_id, return_type, impl_hash.
// Current version: latest by created_at for (fn_id, branch_id).
//
// Fields:
// - name: unique function name (null allowed for local/anonymous functions)
// - parent_id: reference to parent fn for inheritance (null = base function)
// - return_type: return type of the function
// - impl_hash: SHA-256 hash for base-fn version tracking
Table fn_version {
  id uuid [primary key]
  fn_id uuid [not null, ref: > fn.id]
  branch_id uuid [not null, ref: > branch.id]
  name text
  parent_id uuid [ref: > fn.id]
  return_type value_kind
  impl_hash text
  created_at timestamptz [not null]

  indexes {
    (fn_id, branch_id, created_at) [name: 'idx_fn_version_lookup']
    (name) [unique, name: 'idx_fn_version_unique_name']
  }
}

// === Entity: arg ===

// Argument entity (stable identity).
// fn_id is stable — arg always belongs to the same fn.
Table arg {
  id uuid [primary key]
  fn_id uuid [not null, ref: > fn.id]
}

// Version of an argument. Append-only history.
// Can change: name, type, required, value, ref_id, is_fn, source_id.
// Current version: latest by created_at for (arg_id, branch_id).
//
// Fields:
// - source_id: reference to parent's arg for inheritance chain
// - name: argument name (unique within fn)
// - type: argument type
// - required: whether argument is required
// - value: literal value (JSONB) - mutually exclusive with ref_id
// - ref_id: reference to another fn - mutually exclusive with value
// - is_fn: HOF flag - when true, ref_id is passed without execution
//
// Inheritance model:
// - Args inherit from parent fn's args via source_id
// - Child can override value/ref_id while keeping source_id link
//
// Result caching:
// - Results are cached by ref_id within execution context
// - Same ref_id in multiple args = function executes once
Table arg_version {
  id uuid [primary key]
  arg_id uuid [not null, ref: > arg.id]
  branch_id uuid [not null, ref: > branch.id]
  source_id uuid [ref: > arg.id]
  name text
  type value_kind
  required bool
  value jsonb
  ref_id uuid [ref: > fn.id]
  is_fn bool
  created_at timestamptz [not null]

  indexes {
    (arg_id, branch_id, created_at) [name: 'idx_arg_version_lookup']
    (fn_id, source_id) [unique, name: 'idx_arg_version_unique_source']
    (fn_id, name) [unique, name: 'idx_arg_version_unique_name']
  }
}
