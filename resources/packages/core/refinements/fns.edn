;; Refinement / union / variant type declarations + runtime narrowing.
;;
;; Each refinement is a fn-row with `:refine {:base T :constraint C}`;
;; sync-time type-check rejects literal values that violate C, and
;; rejects passing a base-typed value where a refinement is expected
;; (forcing an explicit `:ensure-X` conversion).
;;
;; Each `:ensure-X` is a base-fn that re-validates at runtime and
;; returns the value or throws — see impls.clj.
;;
;; Recognised constraint shapes (sync-time literal checks):
;;   [:>  N]   [:>= N]   [:<  N]   [:<= N]   [:=  N]   [:not= V]
;;   [:in #{vs…}]
;;   [:and c1 c2 …]   [:or c1 c2 …]
;; Unknown shapes are accepted (sync-only, runtime catches the rest).


{:namespace "core.refinements"
 :description "Refinement / union / variant type declarations plus runtime narrowing base-fns."
 :fns
 [;; ---------------------------------------------------------------------
  ;; Refinement-typed declarations.
  ;; ---------------------------------------------------------------------

  {:name :positive-int
   :refine {:base :int :constraint [:> 0]}}

  {:name :non-negative-int
   :refine {:base :int :constraint [:>= 0]}}

  {:name :negative-int
   :refine {:base :int :constraint [:< 0]}}

  {:name :non-empty-text
   :refine {:base :text :constraint [:not= ""]}}

  {:name :non-blank-text
   :refine {:base :text :constraint [:matches "\\S"]}}

  {:name :url
   :refine {:base :text :constraint [:matches "^https?://"]}}

  ;; JavaScript source code. No syntactic constraint (any text is
  ;; accepted — runtime JS parser is the only honest validator).
  ;; The named type lets the editor's value-form widget dispatch to
  ;; a textarea instead of a single-line input, and gives static
  ;; analysers a hook for future linting / safety checks. Used by
  ;; the inline-JS escape hatch (`:custom-script` /
  ;; `:wrap-custom-script` / `:dispatch-custom`).
  {:name :js-source
   :refine {:base :text}}

  {:name :positive-numeric
   :refine {:base :numeric :constraint [:> 0]}}

  {:name :percent
   :refine {:base :numeric :constraint [:and [:>= 0] [:<= 100]]}}

  {:name :probability
   :refine {:base :numeric :constraint [:and [:>= 0] [:<= 1]]}}

  {:name :port
   :refine {:base :int :constraint [:and [:>= 1] [:<= 65535]]}}

  {:name :user-port
   :refine {:base :int :constraint [:and [:>= 1024] [:<= 65535]]}}

  {:name :http-status
   :refine {:base :int :constraint [:and [:>= 100] [:<= 599]]}}

  ;; HTTP request-method types — the two upper rungs of the
  ;; `:http-request` specialization ladder (web/http-client):
  ;;   :http-method-token — ANY method the protocol admits (RFC 9110
  ;;     token grammar; custom/extension methods like PROPFIND welcome),
  ;;   :http-method       — narrowed to the standard set; per-method
  ;;     presets (`:http-get` / `:http-post` / …) then PIN one literal.
  ;; Lower-case is the graph convention (mirrors `:route`'s `:method
  ;; "get"`); the impl upper-cases at the wire boundary.
  {:name :http-method-token
   :description "Any HTTP request-method token (RFC 9110 tchar+) — the widest rung of the :http-request method ladder; admits custom/extension methods."
   :refine {:base :text :constraint [:matches "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"]}}

  {:name :http-method
   :description "A standard HTTP request method (lower-case). Narrowing of :http-method-token used by :standard-http-request; per-method presets pin one literal."
   :refine {:base :http-method-token
            :constraint [:in #{"get" "post" "put" "delete" "patch" "head" "options"}]}}

  {:name :bit
   :refine {:base :int :constraint [:or [:= 0] [:= 1]]}}

  ;; ---------------------------------------------------------------------
  ;; Union types — `[T1 T2 …]`. A value satisfies the union iff it
  ;; satisfies at least one branch.
  ;; ---------------------------------------------------------------------
  ;;
  ;; `:nullable-*` ship as aliases when their inline `[:union :null T]`
  ;; form appears at ≥10 call sites across the standard packages —
  ;; the threshold is approximate but the goal is to keep the alias
  ;; set tight and only name the genuine high-frequency shapes.
  ;; Current call-site counts (`grep -c '[:union :null :T]' …/*.edn`):
  ;; Inline-site counts when each alias was extracted:
  ;; text=37 · uuid=24 · bool=19 · jsonb=6 · int=3 · keyword=2 — each is
  ;; aliased below so the shape carries one name.

  {:name :nullable-text    :union [:null :text]}
  {:name :nullable-uuid    :union [:null :uuid]}
  {:name :nullable-jsonb   :union [:null :jsonb]}
  {:name :nullable-int     :union [:null :int]}
  {:name :nullable-bool    :union [:null :bool]}
  ;; variant tags often parse to either form.
  {:name :nullable-keyword :union [:null :keyword]}
  ;; `:keyword-or-text` — keyword OR string, the post-JSONB-roundtrip
  ;; ambiguity for identifiers. 4 inline sites.
  {:name :keyword-or-text  :union [:keyword :text]}

  ;; ---------------------------------------------------------------------
  ;; Compound aliases used at ≥5 call sites — collapses long inline
  ;; unions so consumer slot declarations read at the contract level
  ;; instead of restating the structural shape every time.
  ;; ---------------------------------------------------------------------

  ;; A graphden TYPE expression, as seen by `:subtype?` / `:json-to-type`
  ;; / the value-form renderer / etc. Four representations a type can
  ;; take:
  ;;   - atomic kw (`:int`, `:text`)
  ;;   - legacy text alias (`"int"` — kept for wire-shape compat)
  ;;   - compound vector (`[:list :text]`, `[:union :null :uuid]`)
  ;;   - record shape (`{:fn-id :uuid …}`)
  ;; Used at 14 sites before this alias landed.
  {:name :type-expression
   :union [:keyword :text [:list :any] :keyword-map]}

  ;; A keyword-keyed map of mostly heterogeneous values — the canonical
  ;; shape of decoded entity rows, parsed form payloads, and other
  ;; "structured but per-field-varying" maps. Used at 50+ sites before
  ;; this alias landed.
  {:name :keyword-map :map {:key :keyword :value :any}}

  ;; Nullable entity row — `:get-entity` / `:resolve-*-row` / the
  ;; secret-leaf load chain / etc. Used at 15+ sites in the long form.
  {:name :nullable-keyword-map :union [:null :keyword-map]}

  ;; HTTP headers, form-urlencoded payloads, vault custom-metadata —
  ;; anywhere a wire-format demands string keys AND string values.
  ;; Used at 12 sites before this alias landed.
  {:name :text-map :map {:key :text :value :text}}

  ;; Raw JDBC rows, layout expansion maps — string-keyed but values
  ;; are heterogeneous. The `:Storage :query` return-element shape,
  ;; `:pg-query` return element, `:decode-row :row` arg. 4 sites.
  {:name :text-keyed-map :map {:key :text :value :any}}

  ;; A path-item for `:get-in` / `:assoc-in` / `:update-in` — each
  ;; segment may be a keyword (record field), int (vector index), or
  ;; text (string-keyed map key). 3 inline sites in the long form.
  {:name :path-segment :union [:keyword :int :text]}

  ;; NOTE: `:ring-handler` lives in `web/ring-adapter/fns.edn` — it
  ;; needs `:ring-request-shape` / `:ring-response-shape` (declared in
  ;; that package) and adding it here would invert the dependency
  ;; (`core` doesn't depend on `web`).

  ;; ---------------------------------------------------------------------
  ;; Variant types — Result-style discriminated unions. Each branch is
  ;; `:tag T`; runtime discriminates by value's `:tag` field.
  ;; ---------------------------------------------------------------------

  {:name :result-text   :variant [:ok :text :err :text]}
  {:name :result-int    :variant [:ok :int  :err :text]}
  {:name :validation    :variant [:valid :any :invalid :text]}

  ;; ---------------------------------------------------------------------
  ;; Runtime narrowing — generic template + per-refinement specialisations.
  ;;
  ;; Each `:ensure-*` is now a fn-def composing the shared
  ;; `:_refinement-narrow` template with its own `:test`, `:refine-name`,
  ;; and `:constraint`. Admins can declare a new `:ensure-X` for any
  ;; user-defined refinement by `:parent`-ing `:_refinement-narrow` and
  ;; supplying the three binding args. The `:refinement/violated`
  ;; ex-info shape stays identical to what the previous defbase impls
  ;; threw, so callers and tests see no behavioural change.
  ;; ---------------------------------------------------------------------

  {:name :_refinement-violation-message
   :description "Human-readable violation message — `\"Refinement :foo violated: 42 doesn't satisfy [:> 100]\"`. Free args: `:refine-name`, `:value`, `:constraint`."
   :parent :str
   :args {:parts ["Refinement "
                  {:parent :pr-str :args {:value {:as :refine-name}}}
                  " violated: "
                  {:parent :pr-str :args {:value {:as :value}}}
                  " doesn't satisfy "
                  {:parent :pr-str :args {:value {:as :constraint}}}]}}

  {:name :_refinement-violation-data
   :description "`:ex-data` payload — `{:type :refinement/violated :refine-name … :constraint … :value …}`. Same shape the previous `violated!` helper built."
   :parent :zipmap
   :args {:keys [{:value :type} {:value :refine-name} {:value :constraint} {:value :value}]
          :vals [{:value :refinement/violated}
                 {:as :refine-name}
                 {:as :constraint}
                 {:as :value}]}}

  {:name :_refinement-violation-ex
   :description "Construct the `ExceptionInfo` from message + data so `:throw` can raise it."
   :parent :ex-info
   :args {:message :_refinement-violation-message
          :data :_refinement-violation-data}}

  {:name :_refinement-narrow
   :description "Generic refinement narrower — if `:test` is truthy, return `:value`; otherwise throw the standard `:refinement/violated` ex-info naming `:refine-name` and the original `:constraint` shape. Lazy via `:if` (test passes → no `:ex-info` build, no `:throw`). Admins create a new narrower by `:parent`-ing this fn-def and binding `:test` + `:refine-name` + `:constraint`."
   :parent :if
   :args {:test {:as :test}
          :then {:as :value}
          :else {:parent :throw :args {:exception :_refinement-violation-ex}}}}

  ;; ---------------------------------------------------------------------
  ;; The shipped narrowers, written via the template. Admins declare
  ;; more for any refinement on demand by `:parent`-ing
  ;; `:_refinement-narrow`.
  ;; ---------------------------------------------------------------------

  {:name :ensure-positive-int
   :description "Validate that `:value` is an `:int` and `> 0`; return as `:positive-int`. Throws `refinement/violated` otherwise."
   :parent :_refinement-narrow
   :return-type :positive-int
   :args {:test {:parent :and
                 :args {:values [{:parent :is-a? :args {:type {:value :int} :value {:as :value}}}
                                 {:parent :gt :args {:nums [{:as :value} 0]}}]}}
          :refine-name {:value :positive-int}
          :constraint [:> 0]}}

  {:name :ensure-non-empty-text
   :description "Validate that `:value` is a non-empty `:text`; return as `:non-empty-text`. Throws `refinement/violated` otherwise."
   :parent :_refinement-narrow
   :return-type :non-empty-text
   :args {:test {:parent :and
                 :args {:values [{:parent :is-a? :args {:type {:value :text} :value {:as :value}}}
                                 {:parent :neq :args {:values [{:as :value} {:value ""}]}}]}}
          :refine-name {:value :non-empty-text}
          :constraint [:not= ""]}}]}
