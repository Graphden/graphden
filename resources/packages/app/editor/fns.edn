   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "auth-input-wrap"}}
          :children [:_auth-password-input :_auth-eye-btn]}}


  {:name :_auth-save-btn
   :parent :hiccup
   :args {:tag {:value "button"} :attrs {:value {:id "auth-save-btn" :class "auth-popover-btn"}}
          :children [{:value "Save"}]}}

  {:name :_auth-cancel-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:id "auth-cancel-btn" :class "auth-popover-btn auth-popover-btn-secondary"}}
          :children [{:value "Cancel"}]}}

  {:name :_auth-popover-row
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "auth-popover-row"}}
          :children [:_auth-save-btn :_auth-cancel-btn]}}

  {:name :_auth-error
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:id "auth-error" :class "auth-error hidden"
