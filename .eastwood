;; Eastwood configuration
;; https://github.com/jonase/eastwood

{:linters [:all]

 ;; Disable some noisy linters
 :exclude-linters [:keyword-typos
                   :constant-test]

 ;; Source paths
 :source-paths ["components/schema/src"
                "components/schema-malli/src"
                "components/storage/src"
                "components/storage-memory/src"
                "components/cache/src"
                "components/cache-eager/src"
                "components/graph/src"
                "bases/dev/src"]

 :test-paths ["components/graph/test"]

 ;; Namespaces to exclude
 :exclude-namespaces []

 ;; Add reflection warnings
 :add-linters [:reflection]}
