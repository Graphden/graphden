<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender with correlation ID -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Include correlation-id from MDC if present -->
            <pattern>%d{ISO8601} [%thread] %-5level %logger{36} [%X{correlation-id:-}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- JSON appender for production (structured logging) -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="ch.qos.logback.contrib.json.classic.JsonLayout">
                <jsonFormatter class="ch.qos.logback.contrib.jackson.JacksonJsonFormatter">
                    <prettyPrint>false</prettyPrint>
                </jsonFormatter>
                <timestampFormat>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampFormat>
                <appendLineSeparator>true</appendLineSeparator>
            </layout>
        </encoder>
    </appender>

    <!-- Silence noisy loggers -->
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.postgresql" level="WARN"/>

    <!-- Application loggers -->
    <logger name="graphden" level="INFO"/>

    <!-- Root logger - use CONSOLE by default, JSON in production -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
