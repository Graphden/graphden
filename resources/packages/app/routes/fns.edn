   :description "PUT /api/secrets/:fn-id/value — body `{value:\"…\"}`. Writes a new KV v2 version at the secret's existing path. Auth-required."
   :parent :put
   :args {:path "/secrets/:fn-id/value" :handler :rotate-secret-handler}}

  ;; --- /api top group (combines all /api/* sub-groups + the standalone leaves) ---

  {:name :api-routes
   :description "/api/* — full API surface. To add API versioning (e.g. `/v1`), wrap this in a list with the version prefix as first item — one change instead of one-per-endpoint."
   :parent :list
   :args {:items ["/api"
                  :api-assets-save
                  :api-assets-revert
                  :api-assets-baseline
                  :entity-routes
                  :sequence-routes
                  :bindings-routes
                  :types-routes
                  :graph-routes
                  :api-value-kinds
                  :api-value-form
                  :api-execute
                  :api-execution-by-id
                  :api-execution-cancel
                  :api-executions-list
                  :api-debug-catch-arm
                  :api-debug-catch-cancel
                  :api-debug-catch-status
                  :api-tests-run
                  :api-tests-status
                  :api-services-reconcile
                  :api-services-list
                  :api-branches-root
                  :api-branch-by-ref
                  :api-branch-diff
                  :api-branch-conflicts
                  :api-branch-merge
                  :api-branch-policy
                  :api-fn-versions
                  ;; The registry's `/api/packages/*` + `/api/export/*` routes
                  ;; live in the OPTIONAL `registry` package now and install via
