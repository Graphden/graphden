  ;; ---------------------------------------------------------------------
  ;; POST /api/secrets — create a secret. Body `{:name :path :value
  ;; :namespace-id? :description?}`. Writes to OpenBao first, then
  ;; creates the fn-def + path-binding in graphden. Compensates by
  ;; deleting the OpenBao entry on graphden write failure.
  ;; ---------------------------------------------------------------------

  ;; --- C7 atoms: create-secret variant-2 decomposition.
  ;; Multi-field JSON body parser. `:nm` / `:path` use the nil-safe
  ;; trim pattern (`:if :some? then :str-trim else nil`), `:ns-id`
  ;; runs through `:parse-uuid`, `:description` is a nil-safe `(str
  ;; …)` coerce, `:custom-metadata` is a conditional Vault metadata
  ;; map: `{:description …}` when present, `{}` otherwise.
  {:name :_create-secret-body
   :description "Parsed JSON body of POST /api/secrets."
   :parent :parse-json-body}

  {:name :_create-secret-nm-raw
   :parent :get :args {:coll :_create-secret-body :key {:value :name} :default nil}}

  {:name :_create-secret-nm-str
   :parent :to-str :args {:value :_create-secret-nm-raw}}

  {:name :_create-secret-nm
   :description "Nil-safe trim: `(some-> body :name str str/trim)`."
   :parent :if
   :args {:test {:parent :some? :args {:value :_create-secret-nm-raw}}
          :then {:parent :str-trim :args {:string :_create-secret-nm-str}}
          :else nil}}

  {:name :_create-secret-path-raw
   :parent :get :args {:coll :_create-secret-body :key {:value :path} :default nil}}

  {:name :_create-secret-path-str
   :parent :to-str :args {:value :_create-secret-path-raw}}

  {:name :_create-secret-path
   :description "Nil-safe trim of `:path`."
   :parent :if
   :args {:test {:parent :some? :args {:value :_create-secret-path-raw}}
          :then {:parent :str-trim :args {:string :_create-secret-path-str}}
          :else nil}}

  {:name :_create-secret-description-raw
   :parent :get :args {:coll :_create-secret-body :key {:value :description} :default nil}}

  {:name :_create-secret-description
   :description "Nil-safe `(str description)` — no trim. `(some-> (:description body) str)`."
   :parent :if
   :args {:test {:parent :some? :args {:value :_create-secret-description-raw}}
          :then {:parent :to-str :args {:value :_create-secret-description-raw}}
          :else nil}}

  {:name :_create-secret-metadata-empty
   :description "Vault custom-metadata default — `{}`."
   :parent :const
   :args {:value {}}}

  {:name :_create-secret-metadata-with-desc
   :description "Vault custom-metadata when a non-empty description is supplied — `{:description description}`."
   :parent :zipmap
   :args {:keys [{:value :description}]
          :vals [:_create-secret-description]}}

  {:name :_create-secret-description-non-empty?
   :description "True iff the description string is non-empty (matches Clojure's `(seq description)` — whitespace counts as non-empty unlike `:blank?`)."
   :parent :not
   :args {:value {:parent :empty? :args {:coll :_create-secret-description}}}}

  {:name :_create-secret-custom-metadata
   :description "Conditional Vault custom-metadata: `{:description …}` when supplied + non-empty, else `{}`. Matches `(cond-> {} (and d (seq d)) (assoc :description d))`."
   :parent :if
   :args {:test :_create-secret-description-non-empty?
          :then :_create-secret-metadata-with-desc
          :else :_create-secret-metadata-empty}}

  {:name :_create-secret-parsed
   :description "Parse the JSON body of POST /api/secrets into `{:nm :ns-id :path :value :description :custom-metadata}`. Pure graph composition."
   :parent :zipmap
   :args {:keys [{:value :nm} {:value :ns-id} {:value :path} {:value :value} {:value :description} {:value :custom-metadata}]
          :vals [:_create-secret-nm
                 {:parent :parse-uuid
                  :args {:string {:parent :get :args {:coll :_create-secret-body :key {:value :namespace-id} :default nil}}}}
                 :_create-secret-path
                 {:parent :get :args {:coll :_create-secret-body :key {:value :value} :default nil}}
                 :_create-secret-description
                 :_create-secret-custom-metadata]}}

