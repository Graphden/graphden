{:namespace "app.editor"
 :description "Branch/version UI partials — fn-versions popover (+ per-version executions sub-panel), branch-diff modal, and the merge-conflicts resolution card."
 :fns
 [;; ---------------------------------------------------------------------
  ;; fn-versions popover (second migration). Pulls the existing
  ;; `:list-fn-versions` data chain (in `app.branches`) for one fn-id
  ;; from a query-string param, then maps each enriched version row
  ;; into a hiccup `<div class="fn-versions-row">`. JS keeps only
  ;; the fetch, anchoring, dismissal, AND the per-row switch /
  ;; restore handlers (those rebind after innerHTML swap via the
  ;; existing `data-switch-to-branch` / `data-fn-version-id` markers
  ;; this fragment carries — same shape the legacy JS-built rows
  ;; produced, so the e2e contract is preserved).
  ;; ---------------------------------------------------------------------


  {:name :_partial-fn-versions-current-branch
   :description "Currently-selected branch name (from `?current-branch=`), used to highlight the matching row in the timeline. Empty string when absent — no row gets the `-current` class."
   :parent :query-param
   :args {:request {:as :request}
          :param-name {:value "current-branch"}}}

  {:name :_partial-fn-versions-data
   :description "Live versions data for the requested fn — wraps `:list-fn-versions`."
   :parent :list-fn-versions
   :args {:fn-id :fn-id-param}}

  {:name :_partial-fn-versions-rows
   :description "The `:versions` list out of `:list-fn-versions`'s envelope — already sorted latest-first, each row enriched with `:branch-name` and `:execution-count`."
   :parent :get
   :args {:coll :_partial-fn-versions-data
          :key {:value :versions}
          :default {:value []}}}

  {:name :_partial-fn-versions-count
   :parent :count
   :args {:coll :_partial-fn-versions-rows}}

  {:name :_partial-fn-versions-empty?
   :parent :empty?
   :args {:coll :_partial-fn-versions-rows}}

  ;; --- Per-row HOF callback. Pure rendering: takes one enriched
  ;; version row (`:item`), returns a hiccup `<div class="fn-versions-row">`
  ;; with the same CSS classes + data-attributes the legacy JS produced
  ;; (post-swap JS binds switch / restore handlers by selector).

  {:name :_partial-fnv-row-branch-name
   :parent :get
   :args {:coll {:as :item} :key {:value :branch-name} :default {:value "(unknown)"}}}

  {:name :_partial-fnv-row-version-id
   :parent :get
   :args {:coll {:as :item} :key {:value :id} :default {:value ""}}}

  {:name :_partial-fnv-row-created-at
   :parent :get
   :args {:coll {:as :item} :key {:value :created-at} :default {:value ""}}}

  ;; Timestamp shown as "YYYY-MM-DD HH:MM" — first 16 chars of either
  ;; "2026-05-24 06:21:21.103" (SQL) or "2026-05-24T06:35Z" (ISO).
  ;; `:subs` errors on shorter strings; coalesce to "" via the default
  ;; above keeps us out of the edge.
  {:name :_partial-fnv-row-ts-short
   :parent :subs
   :args {:string :_partial-fnv-row-created-at
          :start {:value 0}
          :end {:value 16}}}

  {:name :_partial-fnv-row-on-current?
   :parent :equal?
   :args {:a :_partial-fnv-row-branch-name
          :b :_partial-fn-versions-current-branch}}

  {:name :_partial-fnv-row-branch-class
   :description "`fn-versions-branch` plus `fn-versions-branch-current` when the row's branch matches the current-branch query param."
   :parent :if
   :args {:test :_partial-fnv-row-on-current?
          :then {:value "fn-versions-branch fn-versions-branch-current"}
          :else {:value "fn-versions-branch"}}}

  {:name :_partial-fnv-row-branch-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:parent :assoc
                  :args {:map {:value {}}
                         :key {:value :class}
                         :value :_partial-fnv-row-branch-class}}
          :children [:_partial-fnv-row-branch-name]}}

  {:name :_partial-fnv-row-ts-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "fn-versions-ts"}}
          :children [:_partial-fnv-row-ts-short]}}

  ;; Description text (e.g. "desc=hello world") — same
  ;; describeVersionContent logic the JS does. v1: just description
  ;; when present, otherwise empty span — keeps the row layout stable.
  {:name :_partial-fnv-row-description-text
   :parent :get
   :args {:coll {:as :item} :key {:value :description} :default {:value ""}}}

  {:name :_partial-fnv-row-meta-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "fn-versions-row-meta"}}
          :children [:_partial-fnv-row-description-text]}}

  ;; Restore button — always rendered. The API rejects no-op restores,
  ;; so leaving it visible on the current-branch latest is fine.
  {:name :_partial-fnv-row-restore-attrs
   :parent :assoc
   :args {:map {:value {:class "fn-versions-restore"
                        :title "Restore this version’s fn-level fields on the current branch"}}
          :key {:value :data-fn-version-id}
          :value :_partial-fnv-row-version-id}}

  {:name :_partial-fnv-row-restore-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_partial-fnv-row-restore-attrs
          :children ["restore"]}}

  ;; Switch button — only when this row's branch differs from the
  ;; currently-active branch. Stays as an empty placeholder span on
  ;; the current-branch row so the children-list length is stable.
  {:name :_partial-fnv-row-switch-title-prefix
   :parent :str-join
   :args {:coll [{:value "Switch the editor to "}
                 :_partial-fnv-row-branch-name]
          :separator {:value ""}}}

  {:name :_partial-fnv-row-switch-attrs-base
   :description "First step — `{:class \"fn-versions-switch\" :data-switch-to-branch <branch-name>}`."
   :parent :assoc
   :args {:map {:value {:class "fn-versions-switch"}}
          :key {:value :data-switch-to-branch}
          :value :_partial-fnv-row-branch-name}}

  {:name :_partial-fnv-row-switch-attrs
   :description "Second step — also assoc `:title \"Switch the editor to <branch>\"`."
   :parent :assoc
   :args {:map :_partial-fnv-row-switch-attrs-base
          :key {:value :title}
          :value :_partial-fnv-row-switch-title-prefix}}

  {:name :_partial-fnv-row-switch-btn-shown
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_partial-fnv-row-switch-attrs
          :children ["switch"]}}

  {:name :_partial-fnv-row-switch-btn-hidden
   :description "Empty span on current-branch rows — keeps the children-vector shape uniform across rows."
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "fn-versions-switch-placeholder" :hidden "1"}}
          :children {:value []}}}

  {:name :_partial-fnv-row-switch-btn
   :parent :if
   :args {:test :_partial-fnv-row-on-current?
          :then :_partial-fnv-row-switch-btn-hidden
          :else :_partial-fnv-row-switch-btn-shown}}

  ;; URL for HTMX hx-get on this row — points at the executions
  ;; sub-partial, parameterised by THIS row's version-id.
  {:name :_partial-fnv-row-execs-url
   :parent :str-join
   :args {:coll [{:value "/partials/fn-version-executions?fn-version-id="}
                 :_partial-fnv-row-version-id]
          :separator {:value ""}}}

  ;; Top row: branch chip + timestamp + restore + switch.
  ;; Carries the HTMX trigger that fetches the executions sub-list
  ;; for THIS row into the sibling `[data-execs-mount]` div. Switch /
  ;; restore button clicks call `event.stopPropagation()` in JS so
  ;; they don't ALSO trigger the row-level hx-get.
  ;; Three-step assoc — inline `{:parent :assoc :args …}` anon fn-defs
  ;; aren't supported, so each assoc step gets a named helper.
  {:name :_partial-fnv-row-top-attrs-base
   :description "Step 1 — base attrs map: class + hx-target + hx-swap + hx-trigger."
   :parent :assoc
   :args {:map {:value {:class "fn-versions-row-top"
                        :hx-target "next [data-execs-mount]"
                        :hx-swap "innerHTML"}}
          :key {:value :hx-trigger}
          :value {:value "click"}}}

  {:name :_partial-fnv-row-top-attrs-with-get
   :description "Step 2 — add hx-get pointing at THIS row's executions URL."
   :parent :assoc
   :args {:map :_partial-fnv-row-top-attrs-base
          :key {:value :hx-get}
          :value :_partial-fnv-row-execs-url}}

  {:name :_partial-fnv-row-top-attrs
   :description "Step 3 — add the human-facing tooltip."
   :parent :assoc
   :args {:map :_partial-fnv-row-top-attrs-with-get
          :key {:value :title}
          :value {:value "Click to expand executions"}}}

  {:name :_partial-fnv-row-top
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs :_partial-fnv-row-top-attrs
          :children [:_partial-fnv-row-branch-span
                     :_partial-fnv-row-ts-span
                     :_partial-fnv-row-restore-btn
                     :_partial-fnv-row-switch-btn]}}

  {:name :_partial-fnv-row-execs-mount
   :description "Empty mount-div that HTMX swaps the executions sub-list into. Sibling of `.fn-versions-row-top` so `hx-target=\"next [data-execs-mount]\"` resolves cleanly."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "fn-versions-execs" :data-execs-mount "1"}}
          :children {:value []}}}

  {:name :_partial-fnv-row-attrs
   :parent :assoc
   :args {:map {:value {:class "fn-versions-row" :role "listitem"}}
          :key {:value :data-fn-version-id}
          :value :_partial-fnv-row-version-id}}

  {:name :_partial-fnv-row
   :description "Per-row hiccup. Carries `data-fn-version-id` for post-swap action wiring (switch / restore bindings in JS). The trailing `[data-execs-mount]` div is the HTMX swap target for the executions sub-partial, lazy-fetched on row click."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs :_partial-fnv-row-attrs
          :children [:_partial-fnv-row-top
                     :_partial-fnv-row-meta-div
                     :_partial-fnv-row-execs-mount]}}

  ;; Map each enriched version row to a hiccup row.
  {:name :_partial-fnv-rendered-rows
   :parent :map
   :args {:func :_partial-fnv-row :coll :_partial-fn-versions-rows}}

  {:name :_partial-fnv-list
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "fn-versions-list" :role "list"}}
          :children :_partial-fnv-rendered-rows}}

  {:name :_partial-fnv-header-title
   :description "`<{name}> · {N} versions` — concise header line. Title text passed via `?title=` so the JS doesn't need to fetch the fn first."
   :parent :query-param
   :args {:request {:as :request}
          :param-name {:value "title"}}}

  {:name :_partial-fnv-count-text
   :parent :to-str
   :args {:value :_partial-fn-versions-count}}

  ;; "<title> · <N> versions" — joined with literal separator. Singular/
  ;; plural handling deferred (v1 always uses "versions", JS legacy
  ;; matched singular when count == 1; can refine in v2 with an :if).
  {:name :_partial-fnv-header-text
   :parent :str-join
   :args {:coll [:_partial-fnv-header-title
                 {:value " · "}
                 :_partial-fnv-count-text
                 {:value " versions"}]
          :separator {:value ""}}}

  {:name :_partial-fnv-header
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "fn-versions-header"}}
          :children [:_partial-fnv-header-text]}}

  {:name :_partial-fnv-empty-msg
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "fn-versions-empty"}}
          :children ["No version history rows yet."]}}

  ;; On empty → header + empty-msg; otherwise header + list.
  {:name :_partial-fnv-body
   :parent :if
   :args {:test :_partial-fn-versions-empty?
          :then :_partial-fnv-empty-msg
          :else :_partial-fnv-list}}

  {:name :_partial-fnv-fragment
   :description "Full hiccup fragment for the fn-versions popover — header + body (list or empty message)."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "fn-versions-content"}}
          :children [:_partial-fnv-header :_partial-fnv-body]}}

  {:name :_partial-fnv-html
   :parent :render-hiccup
   :args {:hiccup :_partial-fnv-fragment}}

  {:name :_partial-fn-versions-handler
   :lambda-params [:request :storage-query]
   :description "Ring handler for `GET /partials/fn-versions?fn-id=X&current-branch=Y&title=Z` — returns the popover hiccup as `text/html`. JS swaps the response into the popover. Row-expand is HTMX-driven (each row carries `hx-get` for its own executions); switch + restore still rebind in JS by selector."
   :parent :html-ok-response
   :args {:body :_partial-fnv-html}}

  ;; ---------------------------------------------------------------------
  ;; fn-version executions sub-panel — lazy-loaded into a row when the
  ;; user expands it via HTMX. The row's `hx-get` points here; the
  ;; response is just the executions-list hiccup, swapped into the
  ;; row's `data-execs-mount` div. No JS needed for expand.
  ;; ---------------------------------------------------------------------

  {:name :_partial-fnv-execs-rows
   :description "Live executions list for `?fn-version-id=`. Reuses the same decoded rows `/api/executions?fn-version-id=` exposes — already newest-first + capped by the SQL `ORDER BY started_at DESC LIMIT <clamped>` (see `:_list-exec-by-version-hsql`); the partial is the HTML projection of that data. Shadows `:parsed` with `:_list-exec-parsed` so the version-id (+limit) come from THIS partial's own query-string — the handler doesn't otherwise bind `:parsed`, which is why the expander used to show 'No runs' for every version."
   :parent :_list-exec-by-version-decoded
   :args {:parsed :_list-exec-parsed}}

  {:name :_partial-fnv-execs-empty?
   :parent :empty?
   :args {:coll :_partial-fnv-execs-rows}}

  ;; Per-row HOF cells.
  {:name :_partial-fnv-exec-status
   :parent :get
   :args {:coll {:as :item} :key {:value :status} :default {:value "?"}}}

  {:name :_partial-fnv-exec-started-at
   :parent :get
   :args {:coll {:as :item} :key {:value :started-at} :default {:value ""}}}

  ;; `:started-at` is a `java.sql.Timestamp` off the decoded row — must
  ;; stringify before `:subs`, or `count`-on-Timestamp 500s the handler.
  ;; Mirror of `:_partial-eh-row-started-at-text`.
  {:name :_partial-fnv-exec-started-at-text
   :parent :to-str
   :args {:value :_partial-fnv-exec-started-at}}

  {:name :_partial-fnv-exec-ts-short
   :parent :subs
   :args {:string :_partial-fnv-exec-started-at-text
          :start {:value 0}
          :end {:value 16}}}

  ;; Status colour class is `fn-versions-execs-status-<status>` —
  ;; same shape the legacy JS produced (CSS keys on it).
  {:name :_partial-fnv-exec-status-class
   :parent :str-join
   :args {:coll [{:value "fn-versions-execs-status fn-versions-execs-status-"}
                 :_partial-fnv-exec-status]
          :separator {:value ""}}}

  {:name :_partial-fnv-exec-status-attrs
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :class}
          :value :_partial-fnv-exec-status-class}}

  {:name :_partial-fnv-exec-status-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs :_partial-fnv-exec-status-attrs
          :children [:_partial-fnv-exec-status]}}

  {:name :_partial-fnv-exec-ts-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "fn-versions-execs-ts"}}
          :children [:_partial-fnv-exec-ts-short]}}

  {:name :_partial-fnv-exec-row
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "fn-versions-execs-row"}}
          :children [:_partial-fnv-exec-status-span
                     :_partial-fnv-exec-ts-span]}}

  {:name :_partial-fnv-exec-rendered-rows
   :parent :map
   :args {:func :_partial-fnv-exec-row :coll :_partial-fnv-execs-rows}}

  {:name :_partial-fnv-exec-list
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "fn-versions-execs-list"}}
          :children :_partial-fnv-exec-rendered-rows}}

  {:name :_partial-fnv-exec-empty-msg
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "fn-versions-execs-empty"}}
          :children ["No runs of this version."]}}

  {:name :_partial-fnv-exec-body
   :parent :if
   :args {:test :_partial-fnv-execs-empty?
          :then :_partial-fnv-exec-empty-msg
          :else :_partial-fnv-exec-list}}

  {:name :_partial-fnv-exec-html
   :parent :render-hiccup
   :args {:hiccup :_partial-fnv-exec-body}}

  {:name :_partial-fn-version-executions-handler
   :lambda-params []
   :description "Ring handler for `GET /partials/fn-version-executions?fn-version-id=X` — returns the executions sub-list as `text/html`. HTMX-driven from each fn-versions row's `hx-get`; no JS expansion code needed."
   :parent :html-ok-response
   :args {:body :_partial-fnv-exec-html}}

  ;; ---------------------------------------------------------------------
  ;; (The branch-diff modal partial lived here until UX-v3, 2026-08-31:
  ;; Δ now toggles COMPARE MODE — the diff renders in the Explorer /
  ;; canvas / inspector from the `/api/branches/:ref/diff-view` JSON,
  ;; and the review dialog builds its change list client-side from the
  ;; same payload. See editor-diff-mode.js / editor-branch-diff.js.)
  ;; ---------------------------------------------------------------------

  ;; ---------------------------------------------------------------------
  ;; MERGE-CONFLICTS PARTIAL (graph-first §6) — POST /partials/merge-conflicts
  ;; with the JSON body `{conflicts, source, target}` the failed merge
  ;; already returned to JS. The server RENDERS those conflicts as the
  ;; resolution CARD hiccup (header + help + (>1) batch toolbar +
  ;; per-conflict rows with source/target radios + version previews +
  ;; error slot + Cancel/Apply). It does NOT re-detect — the conflicts are
  ;; already in hand, so this mirrors `:_partial-execute-result-inline-*`
  ;; (POST the already-computed data, server owns only the markup) rather
  ;; than duplicating `detect-conflicts`. Client data is trusted for
  ;; DISPLAY only — the re-submitted merge re-validates every resolution
  ;; server-side. JS in editor-branches.js owns the modal chrome (the
  ;; full-viewport overlay div — a flex sibling of the card, so it can't
  ;; live under this single-root fragment) + the radio/apply lifecycle (it
  ;; reads each row's `data-entity-*` + checked radio on submit).
  ;; ---------------------------------------------------------------------

  {:name :_partial-mc-body
   :description "JSON request body — `{:conflicts [...] :source <name> :target <name>}`, the shape the failed merge returned to JS. `:parse-json-body` types its return `:nullable-jsonb`; the modal only POSTs a keyword-keyed map, so narrow to `:nullable-keyword-map` for the downstream `:get` reads."
   :parent :parse-json-body
   :return-type :nullable-keyword-map
   :args {:request {:as :request}}}

  {:name :_partial-mc-conflicts
   :description "The conflict list straight from the POST body — `[{:entity-name :entity-id :source-version :target-version}]`, exactly as the merge's `:merge-conflict` response carried it."
   :parent :get
   :args {:coll :_partial-mc-body :key {:value :conflicts} :default {:value []}}}

  {:name :_partial-mc-count
   :parent :count
   :args {:coll :_partial-mc-conflicts}}

  {:name :_partial-mc-count-text
   :parent :to-str
   :args {:value :_partial-mc-count}}

  {:name :_partial-mc-source-name
   :parent :get
   :args {:coll :_partial-mc-body :key {:value :source} :default {:value "(source)"}}}

  {:name :_partial-mc-target-name
   :parent :get
   :args {:coll :_partial-mc-body :key {:value :target} :default {:value "(target)"}}}

  ;; --- Version preview (server mirror of `previewVersion`): "(deleted)"
  ;; for a nil version map, else the space-joined present fields
  ;; (name / "desc" / pos=N / value=…), long fields ellipsised at 32.

  {:name :_partial-mc-trunc-long?
   :parent :gt
   :args {:nums [{:parent :str-len :args {:string {:as :string}}} {:value 32}]}}

  {:name :_partial-mc-trunc-cut
   :parent :str
   :args {:parts [{:parent :subs :args {:string {:as :string} :start {:value 0} :end {:value 31}}}
                  {:value "…"}]}}

  {:name :_partial-mc-truncate
   :description "Truncate a string to 32 chars + ellipsis (mirrors JS `truncate(s, 32)`). `:string` is a free arg so the description and value previews reuse the same chain."
   :parent :if
   :args {:test :_partial-mc-trunc-long?
          :then :_partial-mc-trunc-cut
          :else {:as :string}}}

  {:name :_partial-mc-part-present?
   :description "Filter pred — keep non-empty preview parts (drops the `\"\"` an absent field contributes so `:str-join` doesn't emit stray separators)."
   :parent :not
   :args {:value {:parent :empty? :args {:coll {:as :item}}}}}

  {:name :_partial-mc-pv-name
   :parent :coalesce
   :args {:value {:parent :get :args {:coll {:as :version} :key {:value :name} :default nil}}
          :default {:value ""}}}

  {:name :_partial-mc-pv-desc-raw
   :parent :get
   :args {:coll {:as :version} :key {:value :description} :default nil}}

  {:name :_partial-mc-pv-desc-part
   :parent :if
   :args {:test {:parent :some? :args {:value :_partial-mc-pv-desc-raw}}
          :then {:parent :str
                 :args {:parts [{:value "\""}
                                {:parent :_partial-mc-truncate :args {:string :_partial-mc-pv-desc-raw}}
                                {:value "\""}]}}
          :else {:value ""}}}

  {:name :_partial-mc-pv-pos-raw
   :parent :get
   :args {:coll {:as :version} :key {:value :position} :default nil}}

  {:name :_partial-mc-pv-pos-part
   :parent :if
   :args {:test {:parent :some? :args {:value :_partial-mc-pv-pos-raw}}
          :then {:parent :str :args {:parts [{:value "pos="} :_partial-mc-pv-pos-raw]}}
          :else {:value ""}}}

  {:name :_partial-mc-pv-value-raw
   :parent :get
   :args {:coll {:as :version} :key {:value :value} :default nil}}

  {:name :_partial-mc-pv-value-part
   :parent :if
   :args {:test {:parent :some? :args {:value :_partial-mc-pv-value-raw}}
          :then {:parent :str
                 :args {:parts [{:value "value="}
                                {:parent :_partial-mc-truncate
                                 :args {:string {:parent :to-str :args {:value :_partial-mc-pv-value-raw}}}}]}}
          :else {:value ""}}}

  {:name :_partial-mc-pv-parts
   :parent :filter
   :args {:pred :_partial-mc-part-present?
          :coll [:_partial-mc-pv-name :_partial-mc-pv-desc-part
                 :_partial-mc-pv-pos-part :_partial-mc-pv-value-part]}}

  {:name :_partial-mc-pv-joined
   :parent :str-join
   :args {:coll :_partial-mc-pv-parts :separator {:value " "}}}

  {:name :_partial-mc-pv-nonempty
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_partial-mc-pv-joined}}
          :then {:value "(empty)"}
          :else :_partial-mc-pv-joined}}

  {:name :_partial-mc-preview
   :description "Server mirror of `previewVersion` — `(deleted)` when the version map is nil (side removed the entity), else the space-joined present fields. `:version` is a free arg so the row renderer feeds source-version and target-version through the same chain."
   :parent :if
   :args {:test {:parent :nil? :args {:value {:as :version}}}
          :then {:value "(deleted)"}
          :else :_partial-mc-pv-nonempty}}

  ;; --- Per-conflict HOF callback (`{:as :item}` = one conflict row) ---

  {:name :_partial-mc-row-entity-name-raw
   :parent :get
   :args {:coll {:as :item} :key {:value :entity-name} :default {:value ""}}}

  {:name :_partial-mc-row-entity-name
   :description "Entity-type as bare text (`fn`, not `:fn`) — the e2e asserts `.merge-conflict-entity` textContent `=== 'fn'`, and it also becomes the `data-entity-name` the JS submit reads."
   :parent :name
   :args {:value :_partial-mc-row-entity-name-raw}}

  {:name :_partial-mc-row-entity-id
   :parent :get
   :args {:coll {:as :item} :key {:value :entity-id} :default {:value ""}}}

  {:name :_partial-mc-row-source-version
   :parent :get
   :args {:coll {:as :item} :key {:value :source-version} :default nil}}

  {:name :_partial-mc-row-target-version
   :parent :get
   :args {:coll {:as :item} :key {:value :target-version} :default nil}}

  {:name :_partial-mc-row-source-preview
   :parent :_partial-mc-preview
   :args {:version :_partial-mc-row-source-version}}

  {:name :_partial-mc-row-target-preview
   :parent :_partial-mc-preview
   :args {:version :_partial-mc-row-target-version}}

  {:name :_partial-mc-row-radio-name
   :description "Per-row radio-group name — unique via the entity-id so the two radios in a row are mutually exclusive but independent of other rows."
   :parent :str
   :args {:parts [{:value "mc-"} :_partial-mc-row-entity-id]}}

  {:name :_partial-mc-row-source-radio
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:parent :zipmap
                  :args {:keys [{:value :type} {:value :name} {:value :value} {:value :checked}]
                         :vals [{:value "radio"} :_partial-mc-row-radio-name {:value "source"} {:value true}]}}
          :children {:value []}}}

  {:name :_partial-mc-row-target-radio
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:parent :zipmap
                  :args {:keys [{:value :type} {:value :name} {:value :value}]
                         :vals [{:value "radio"} :_partial-mc-row-radio-name {:value "target"}]}}
          :children {:value []}}}

  {:name :_partial-mc-strong-source
   :parent :hiccup
   :args {:tag {:value "strong"} :attrs {:value {}} :children ["source"]}}

  {:name :_partial-mc-strong-target
   :parent :hiccup
   :args {:tag {:value "strong"} :attrs {:value {}} :children ["target"]}}

  {:name :_partial-mc-row-source-code
   :parent :hiccup
   :args {:tag {:value "code"} :attrs {:value {}} :children [:_partial-mc-row-source-preview]}}

  {:name :_partial-mc-row-target-code
   :parent :hiccup
   :args {:tag {:value "code"} :attrs {:value {}} :children [:_partial-mc-row-target-preview]}}

  {:name :_partial-mc-row-source-label
   :parent :hiccup
   :args {:tag {:value "label"} :attrs {:value {}}
          :children [:_partial-mc-row-source-radio {:value " "} :_partial-mc-strong-source
                     {:value " "} :_partial-mc-row-source-code]}}

  {:name :_partial-mc-row-target-label
   :parent :hiccup
   :args {:tag {:value "label"} :attrs {:value {}}
          :children [:_partial-mc-row-target-radio {:value " "} :_partial-mc-strong-target
                     {:value " "} :_partial-mc-row-target-code]}}

  {:name :_partial-mc-row-choice
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflict-choice"}}
          :children [:_partial-mc-row-source-label :_partial-mc-row-target-label]}}

  {:name :_partial-mc-row-entity-span
   :parent :hiccup
   :args {:tag {:value "span"} :attrs {:value {:class "merge-conflict-entity"}}
          :children [:_partial-mc-row-entity-name]}}

  {:name :_partial-mc-row-id-span
   :parent :hiccup
   :args {:tag {:value "span"} :attrs {:value {:class "merge-conflict-id"}}
          :children [:_partial-mc-row-entity-id]}}

  {:name :_partial-mc-row-head
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflict-row-head"}}
          :children [:_partial-mc-row-entity-span :_partial-mc-row-id-span]}}

  {:name :_partial-mc-row-attrs
   :description "Row div attrs — class + the two `data-entity-*` attrs the JS submit reads to build `:conflict-resolutions`."
   :parent :zipmap
   :args {:keys [{:value :class} {:value :data-entity-name} {:value :data-entity-id}]
          :vals [{:value "merge-conflict-row"} :_partial-mc-row-entity-name :_partial-mc-row-entity-id]}}

  {:name :_partial-mc-row
   :parent :hiccup
   :args {:tag {:value "div"} :attrs :_partial-mc-row-attrs
          :children [:_partial-mc-row-head :_partial-mc-row-choice]}}

  {:name :_partial-mc-rendered
   :parent :map
   :args {:func :_partial-mc-row :coll :_partial-mc-conflicts}}

  {:name :_partial-mc-rows-div
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflicts-rows"}}
          :children :_partial-mc-rendered}}

  ;; --- Card chrome: header / help / batch toolbar / error / actions ---

  {:name :_partial-mc-plural
   :description "\"\" for exactly 1 conflict, \"s\" otherwise (mirrors JS `length === 1 ? '' : 's'`)."
   :parent :if
   :args {:test {:parent :equal? :args {:a :_partial-mc-count :b {:value 1}}}
          :then {:value ""}
          :else {:value "s"}}}

  {:name :_partial-mc-header-prefix
   :parent :str
   :args {:parts [{:value "Resolve "} :_partial-mc-count-text {:value " conflict"}
                  :_partial-mc-plural {:value " merging "}]}}

  {:name :_partial-mc-header-strong-src
   :parent :hiccup
   :args {:tag {:value "strong"} :attrs {:value {}} :children [:_partial-mc-source-name]}}

  {:name :_partial-mc-header-strong-tgt
   :parent :hiccup
   :args {:tag {:value "strong"} :attrs {:value {}} :children [:_partial-mc-target-name]}}

  {:name :_partial-mc-header
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflicts-header"}}
          :children [:_partial-mc-header-prefix :_partial-mc-header-strong-src
                     {:value " → "} :_partial-mc-header-strong-tgt]}}

  {:name :_partial-mc-help-em-src
   :parent :hiccup
   :args {:tag {:value "em"} :attrs {:value {}} :children ["source"]}}

  {:name :_partial-mc-help-em-tgt
   :parent :hiccup
   :args {:tag {:value "em"} :attrs {:value {}} :children ["target"]}}

  {:name :_partial-mc-help
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflicts-help"}}
          :children [{:value "For each entity, pick which side wins. "}
                     :_partial-mc-help-em-src {:value " = "} :_partial-mc-source-name
                     {:value ", "} :_partial-mc-help-em-tgt {:value " = "} :_partial-mc-target-name
                     {:value "."}]}}

  {:name :_partial-mc-batch-multi?
   :parent :gt
   :args {:nums [:_partial-mc-count {:value 1}]}}

  {:name :_partial-mc-batch-src-title
   :parent :str
   :args {:parts [{:value "Set every row to source — "} :_partial-mc-source-name]}}

  {:name :_partial-mc-batch-tgt-title
   :parent :str
   :args {:parts [{:value "Set every row to target — "} :_partial-mc-target-name]}}

  {:name :_partial-mc-batch-src-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:parent :zipmap
                  :args {:keys [{:value :id} {:value :class} {:value :title}]
                         :vals [{:value "merge-conflicts-pick-all-source"}
                                {:value "branch-popover-btn merge-conflicts-batch-btn"}
                                :_partial-mc-batch-src-title]}}
          :children ["source"]}}

  {:name :_partial-mc-batch-tgt-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:parent :zipmap
                  :args {:keys [{:value :id} {:value :class} {:value :title}]
                         :vals [{:value "merge-conflicts-pick-all-target"}
                                {:value "branch-popover-btn merge-conflicts-batch-btn"}
                                :_partial-mc-batch-tgt-title]}}
          :children ["target"]}}

  {:name :_partial-mc-batch-label
   :parent :hiccup
   :args {:tag {:value "span"} :attrs {:value {:class "merge-conflicts-batch-label"}}
          :children ["Pick all:"]}}

  {:name :_partial-mc-batch-shown
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflicts-batch"}}
          :children [:_partial-mc-batch-label :_partial-mc-batch-src-btn :_partial-mc-batch-tgt-btn]}}

  {:name :_partial-mc-batch-hidden
   :description "Empty (hidden) span when the modal has a single conflict — a batch toolbar would just be noise. Keeps the card children-vector shape uniform."
   :parent :hiccup
   :args {:tag {:value "span"} :attrs {:value {:hidden "1"}} :children {:value []}}}

  {:name :_partial-mc-batch
   :parent :if
   :args {:test :_partial-mc-batch-multi?
          :then :_partial-mc-batch-shown
          :else :_partial-mc-batch-hidden}}

  {:name :_partial-mc-error
   :description "Error slot — starts hidden; JS un-hides it + fills textContent when the re-submitted merge fails."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "merge-conflicts-error hidden" :id "merge-conflicts-error"}}
          :children {:value []}}}

  {:name :_partial-mc-cancel-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:id "merge-conflicts-cancel"
                          :class "branch-popover-btn merge-conflicts-cancel"}}
          :children ["Cancel"]}}

  {:name :_partial-mc-apply-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:id "merge-conflicts-submit" :class "branch-popover-btn"}}
          :children ["Apply merge"]}}

  {:name :_partial-mc-actions
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflicts-actions"}}
          :children [:_partial-mc-cancel-btn :_partial-mc-apply-btn]}}

  {:name :_partial-mc-card
   :description "Full resolution card (single hiccup root). JS mounts it as a flex sibling of the overlay div it creates; the overlay CAN'T live here because `.merge-conflicts-modal` centres its two direct children and an extra wrapper would break that."
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "merge-conflicts-card"}}
          :children [:_partial-mc-header :_partial-mc-help :_partial-mc-batch
                     :_partial-mc-rows-div :_partial-mc-error :_partial-mc-actions]}}

  {:name :_partial-mc-html
   :parent :render-hiccup
   :args {:hiccup :_partial-mc-card}}

  {:name :_partial-merge-conflicts-handler
   :lambda-params [:request]
   :description "Ring handler for `POST /partials/merge-conflicts` — body is the `{conflicts, source, target}` JSON the failed merge returned to JS; returns the resolution card hiccup as `text/html`. Renders the POSTed conflicts (no re-detection). JS in editor-branches.js owns the overlay chrome + radio/apply lifecycle."
   :parent :html-ok-response
   :args {:body :_partial-mc-html}}]}
