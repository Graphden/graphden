 ;; --------------------------------------------------------------- keymaps
 ;; Overrides only (§ 6): a command not listed keeps its default keys.
 ;; `Space` is the leader; `:leader false` makes a key bare.
 {:kind "keymap"
  :name "graphden.vim-keys"
  :version "1.0.0"
  :description "Vim's two prefixes: `z` for the view (z z fits, z t goes to the root, z p resets positions) and `g` for going places (g e explorer, g b branches, g r runs, g o overview, g t / g x / g y / g w the four lenses). Search stays `/`."
  :category "vim-like"
  :tags ["vim" "modal" "keyboard"]
  :payload {:bindings {"graph-fit" {:keys "z z" :leader true}
                       "graph-root" {:keys "z t" :leader true}
                       "graph-reset-positions" {:keys "z p" :leader true}
                       "sidebar" {:keys "g e" :leader true}
                       "branches" {:keys "g b" :leader true}
                       "inspector-runs" {:keys "g r" :leader true}
                       "inspector-overview" {:keys "g o" :leader true}
                       "lens-tests" {:keys "g t" :leader true}
                       "lens-failed" {:keys "g x" :leader true}
                       "lens-type-errors" {:keys "g y" :leader true}
                       "lens-lint" {:keys "g w" :leader true}}}}

