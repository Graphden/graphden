{:name "web"
 :version "1.0.0"
 :description "Web primitives: HTTP, routing, HTML, CRUD."
 ;; `storage` is required because `web/crud` migrations off
 ;; `:list-entities` reference storage primitives (`:resolve-fn-rows`,
 ;; `:current-branch-chain`, …) defined under `storage/branches` +
 ;; `storage/versioned`.
 :dependencies ["core" "storage"]
 :modules ["http" "http-client" "vault" "sql" "reitit" "reitit-text" "html"
           ;; One namespace ("web.crud"), seven modules — see
           ;; `web/crud/fns.edn` for the layout. Order matters only for
           ;; load determinism, not for reference resolution.
           "crud" "crud-types" "crud-write" "crud-delete" "crud-seq"
           "crud-parse" "crud-routes"
           "ring-adapter" "branch-router" "runtime" "components" "htmx" "sse" "response" "errors"
           ;; Service-to-service: a service fn as a VALUE (`:service-endpoint`
           ;; over a `:fn-ref` slot) + the call templates over http-client.
           "service"]}
