;; Graph Editor fn-defs
;; CSS / JS loaded via the core :read-resource / :concat-resources
;; chain. No base-fns in this package.


{:namespace "app.editor"
 :description "Graph-editor application — HTML/CSS/JS assembly via fn-defs (no base-fns), plus the routes for editor UI + API endpoints."
 :fns
 [;; =============================================================================
  ;; CSS + JS asset loading (fn-def compositions)
  ;; =============================================================================

  {:name :styles
   :description "Editor stylesheet — read from `packages/app/editor/editor-styles.css`. Served by `:_editor-css-handler` at `/assets/editor.css?v=<hash>` with a 1-year `immutable` `Cache-Control` so the browser fetches the body exactly once per deploy."
   :parent :read-resource
   :return-type :text
   :args {:path "packages/app/editor/editor-styles.css"}}

  ;; Editor JS modules — loaded from resources and concatenated in order.
  ;; Order matters: tooltips/icons/drag must come BEFORE overlays (which
  ;; calls into them); ui/render come after overlays (they call
  ;; into the overlay management API).
  {:name :_editor-script-paths
   :parent :const
   :args {:value ["packages/app/editor/editor-state.js"
                  ;; The graph itself: two maps and a tween. No library.
                  "packages/app/editor/editor-graph-model.js"
                  ;; Viewport (pan / zoom / gestures) — owns the two numbers the
                  ;; graph layer's transform is built from. `gv` reads it.
                  "packages/app/editor/editor-viewport.js"
                  ;; `gv` — the graph-view seam every module downstream reads.
                  "packages/app/editor/editor-graph-view.js"
                  "packages/web/runtime/graphden-popover.js"
                  "packages/app/editor/editor-busy.js"
                  "packages/app/editor/editor-prefs.js"
                  "packages/app/editor/editor-auth.js"
                  "packages/app/editor/editor-branches.js"
                  "packages/app/editor/editor-branch-diff.js"
                  "packages/app/editor/editor-create.js"
                  ;; Per-kind field builders + prefill parsers — split out of
                  ;; editor-create-type.js; loaded first so the popover shell
                  ;; can call buildKindFields at open time.
                  "packages/app/editor/editor-create-type-fields.js"
                  "packages/app/editor/editor-create-type.js"
                  "packages/app/editor/editor-data.js"
                  "packages/app/editor/editor-layout.js"
                  ;; SVG edge layer — needs `taxiBendX` from editor-layout.js.
                  "packages/app/editor/editor-edges-svg.js"
                  "packages/app/editor/editor-literal-types.js"
                  ;; Presentation half of the type helpers — split out of
                  ;; editor-literal-types.js.
                  "packages/app/editor/editor-type-format.js"
                  "packages/web/runtime/graphden-forms.js"
                  "packages/app/editor/editor-value-form.js"
                  "packages/app/editor/editor-widget-rating.js"
                  "packages/app/editor/editor-tooltips.js"
                  "packages/app/editor/editor-icons.js"
                  "packages/web/runtime/graphden-runtime.js"
                  "packages/web/runtime/graphden-actions-builtin.js"
                  "packages/app/editor/editor-row-actions.js"
                  "packages/app/editor/editor-drag.js"
                  "packages/app/editor/editor-fn-picker.js"
                  "packages/app/editor/editor-namespace-picker.js"
                  "packages/app/editor/editor-edit-validation.js"
                  "packages/app/editor/editor-edit-modes.js"
                  ;; fn-level + type-level edit modes — split out of
                  ;; editor-edit-modes.js (which keeps the skeleton).
                  "packages/app/editor/editor-edit-modes-fn.js"
                  "packages/app/editor/editor-edit-modes-type.js"
                  "packages/app/editor/editor-edit-reparent.js"
                  "packages/app/editor/editor-execute-result.js"
                  "packages/app/editor/editor-execute-history.js"
                  "packages/app/editor/editor-execute.js"
                  "packages/app/editor/editor-fn-versions.js"
                  "packages/app/editor/editor-service-popover.js"
                  "packages/app/editor/editor-mismatch-explainer.js"
                  "packages/app/editor/editor-effect-explainer.js"
                  ;; Structural type-interpretation half of the inline
                  ;; `▸/▾` panel — split out of editor-overlay-type-expand.js.
                  "packages/app/editor/editor-type-expand-render.js"
                  "packages/app/editor/editor-overlay-type-expand.js"
                  "packages/app/editor/editor-provenance-popover.js"
                  "packages/app/editor/editor-overlay-arg.js"
                  "packages/app/editor/editor-overlay-edge-label.js"
                  "packages/app/editor/editor-overlay-fn-rows.js"
                  "packages/app/editor/editor-overlay-fn.js"
                  "packages/app/editor/editor-overlay-strips.js"
                  "packages/app/editor/editor-overlay-manager.js"
                  "packages/app/editor/editor-secrets.js"
                  "packages/app/editor/editor-grants-admin.js"
                  "packages/app/editor/editor-users-admin.js"
                  "packages/app/editor/editor-packages.js"
                  "packages/app/editor/editor-sidebar.js"
                  "packages/app/editor/editor-expansion.js"
                  "packages/app/editor/editor-ui.js"
                  "packages/app/editor/editor-render.js"
                  "packages/app/editor/editor-main.js"]}}

  ;; Raw concatenation of every editor module — still contains the
  ;; literal `__BUILD_HASH__` placeholder from `editor-state.js`.
  {:name :_script-raw
   :description "Concatenated editor JS bundle, BEFORE the build-hash substitution."
   :parent :concat-resources
   :return-type :text
   :args {:paths :_editor-script-paths}}

  ;; The placeholder is replaced with the FRONTEND-section build hash
  ;; (see `:build-hash-frontend-short` in core.system). The console
  ;; marker thus reflects exactly which JS/CSS the browser is running
  ;; — and matches the `frontend` key returned by `GET /version`.
  {:name :script
   :description "Bundled editor JS with `__BUILD_HASH__` substituted by `:build-hash-frontend-short`. The in-page console marker mirrors the `frontend` value returned by `GET /version`, so the browser bundle's identity is never out of step with what the server reports. `:str-replace` is nil-flow-through; `:_script-raw` is loaded from a baked-in JAR resource and is never nil, but the declared return follows the parent's union to keep the contract explicit."
   :parent :str-replace
   :return-type :nullable-text
   :args {:string   {:ref :_script-raw                :type :text}
          :match    "__BUILD_HASH__"
          :replacement :build-hash-frontend-short}}

  ;; =============================================================================
  ;; FN-DEFS: Editor UI structure
  ;; =============================================================================

  ;; Editor body — HTML structure as hiccup constant
  {:name :body
   :description "Hiccup constant for the editor's `<body>` content — sidebar (filter input + entity list), graph container, and zoom/home/reset nav controls."
   :parent :const
   :args {:value
          ;; Semantic landmarks \u2014 <aside> for the namespace tree,
          ;; <main> for the graph canvas. axe-core's `region` rule
          ;; requires every page element be inside a landmark; without
          ;; this, screen-readers see flat content with no structure.
          [:div {:id "app"}
           [:div {:id "main-container"}
            ;; Side menu \u2014 semantic <aside> + ARIA label since the
            ;; visible <h2>"Graphden" doubles as the app title rather
            ;; than the sidebar's heading.
            [:aside {:id "side-menu" :aria-label "Function browser"}
             [:div {:class "menu-header"}
              [:h2 "Graphden"]
              ;; Right-side header buttons. `editor-prefs.js` mounts
              ;; theme + collapse buttons here on DOMContentLoaded;
              ;; `editor-auth.js` mounts the lock + popover next to
              ;; them. The "+ New namespace" affordance lives at the
              ;; bottom of `#entity-list`.
              [:div {:class "menu-header-actions"}
               [:div {:id "prefs-mount"}]
               [:div {:id "branch-mount"}]
               [:div {:id "auth-mount"}]]]
             [:div {:id "search-bar" :role "search"}
              [:label {:for "search-input" :class "visually-hidden"} "Filter functions"]
              [:input {:id "search-input" :type "text" :placeholder "Filter..."
                       :aria-label "Filter functions"
                       :oninput "onSearchInput(this.value)"}]
              [:button {:id "search-clear" :onclick "clearSearch()" :aria-label "Clear filter"} "\u00D7"]
              ;; Entity-kind visibility toggles. Each is an eye that dims +
              ;; gets a slash when its kind is hidden; state persists in
              ;; localStorage and is synced onto these buttons at load
              ;; (syncKindFilterBar in editor-sidebar.js). The trailing
              ;; `+` opens the New-secret form (shown only when authed).
              ;; NOTE: this is EDN (literal hiccup), so no let/fn — the
              ;; four eye buttons are spelled out; the SVG eye is shared
              ;; by class .kind-eye (slashed via CSS on aria-pressed=false).
              [:div {:id "kind-filters" :role "group"
                     :aria-label "Show or hide entity kinds"}
               [:button {:type "button" :class "kind-toggle" :data-kind "fn"
                         :aria-pressed "true" :onclick "toggleKind('fn', this)"
                         :title "Show / hide fn"}
                [:span {:class "kind-eye" :aria-hidden "true"}
                 [:svg {:viewBox "0 0 16 16" :width "14" :height "14"}
                  [:path {:d "M1 8s2.5-4.5 7-4.5 7 4.5 7 4.5-2.5 4.5-7 4.5S1 8 1 8Z"
                          :fill "none" :stroke "currentColor" :stroke-width "1.2"}]
                  [:circle {:cx "8" :cy "8" :r "2" :fill "none"
                            :stroke "currentColor" :stroke-width "1.2"}]]]
                [:span {:class "kind-label"} "fn"]]
               [:button {:type "button" :class "kind-toggle" :data-kind "types"
                         :aria-pressed "true" :onclick "toggleKind('types', this)"
                         :title "Show / hide types"}
                [:span {:class "kind-eye" :aria-hidden "true"}
                 [:svg {:viewBox "0 0 16 16" :width "14" :height "14"}
                  [:path {:d "M1 8s2.5-4.5 7-4.5 7 4.5 7 4.5-2.5 4.5-7 4.5S1 8 1 8Z"
                          :fill "none" :stroke "currentColor" :stroke-width "1.2"}]
                  [:circle {:cx "8" :cy "8" :r "2" :fill "none"
                            :stroke "currentColor" :stroke-width "1.2"}]]]
                [:span {:class "kind-label"} "types"]]
               [:button {:type "button" :class "kind-toggle" :data-kind "secrets"
                         :aria-pressed "true" :onclick "toggleKind('secrets', this)"
                         :title "Show / hide secrets"}
                [:span {:class "kind-eye" :aria-hidden "true"}
                 [:svg {:viewBox "0 0 16 16" :width "14" :height "14"}
                  [:path {:d "M1 8s2.5-4.5 7-4.5 7 4.5 7 4.5-2.5 4.5-7 4.5S1 8 1 8Z"
                          :fill "none" :stroke "currentColor" :stroke-width "1.2"}]
                  [:circle {:cx "8" :cy "8" :r "2" :fill "none"
                            :stroke "currentColor" :stroke-width "1.2"}]]]
                [:span {:class "kind-label"} "secrets"]]
               [:button {:type "button" :class "kind-toggle" :data-kind "services"
                         :aria-pressed "true" :onclick "toggleKind('services', this)"
                         :title "Show / hide services"}
                [:span {:class "kind-eye" :aria-hidden "true"}
                 [:svg {:viewBox "0 0 16 16" :width "14" :height "14"}
                  [:path {:d "M1 8s2.5-4.5 7-4.5 7 4.5 7 4.5-2.5 4.5-7 4.5S1 8 1 8Z"
                          :fill "none" :stroke "currentColor" :stroke-width "1.2"}]
                  [:circle {:cx "8" :cy "8" :r "2" :fill "none"
                            :stroke "currentColor" :stroke-width "1.2"}]]]
                [:span {:class "kind-label"} "services"]]
               [:button {:id "secret-add-btn" :type "button" :class "kind-add"
                         :hidden "hidden" :title "New secret"
                         :aria-label "New secret"
                         :onclick "openCreateSecretForm(this)"} "+"]]]
             [:nav {:id "entity-list" :aria-label "Namespace tree"}]]
            ;; Graph container \u2014 <main> landmark
            ;; `#graph-surface` is a `group`, not an `img`: it hosts the
            ;; SVG edge layer AND the interactive HTML overlays (fn cards,
            ;; arg rows, action buttons). `role="img"` would make a screen
            ;; reader treat it as one atomic graphic and skip every
            ;; overlay control inside (axe `nested-interactive`).
            [:main {:id "graph-container" :aria-label "Function graph"}
             [:div {:id "graph-surface" :role "group" :aria-label "Composition graph"}]
             ;; Navigation controls \u2014 group with role="toolbar" so
             ;; screen readers announce the buttons as a related set.
             [:div {:id "nav-controls" :role "toolbar" :aria-label "Graph navigation"}
              [:div {:class "nav-zoom-col"}
               [:button {:class "nav-btn" :onclick "navZoom(1)"
                         :aria-label "Zoom in" :title "Zoom in"} "+"]
               [:input {:id "zoom-slider" :type "range" :min "10" :max "300" :value "100"
                        :orient "vertical"
                        :aria-label "Zoom level"
                        :oninput "navZoomTo(this.value/100)" :title "Zoom"}]
               [:button {:class "nav-btn" :onclick "navZoom(-1)"
                         :aria-label "Zoom out" :title "Zoom out"} "\u2212"]]
              [:div {:class "nav-bottom-row"}
               [:button {:class "nav-btn" :onclick "navGoToRoot()"
                         :aria-label "Go to root node" :title "Go to root node"} "\u2302"]
               [:button {:class "nav-btn" :onclick "navResetPositions()"
                         :aria-label "Reset node positions" :title "Reset all node positions"} "\u27F2"]
               [:button {:class "nav-btn" :onclick "navResetZoom()"
                         :aria-label "Reset zoom" :title "Reset zoom"} "\u2299"]]]]]]}}

  ;; =============================================================================
  ;; HASH-BUSTED ASSET URLs + LINK/SCRIPT-SRC ELEMENTS
  ;;
  ;; The editor JS/CSS bundles are not inlined into the HTML response —
  ;; they're served at `/assets/editor.{js,css}?v=<hash>` with a 1-year
  ;; `immutable` `Cache-Control`. The query-string hash is the
  ;; FRONTEND build hash (`:build-hash-frontend-short`), so a new
  ;; deploy changes the URL and the browser fetches the new bundle;
  ;; in between deploys the browser serves the bundle from cache
  ;; without even a conditional request.
  ;; =============================================================================

  {:name :_editor-js-url
   :description "`/assets/editor.js?v=<frontend-build-hash>` — `<script src>` URL for the bundled editor JS. Hash busts the cache when the frontend section changes."
   :parent :str-join
   :return-type :text
   :args {:coll ["/assets/editor.js?v=" :build-hash-frontend-short]
          :separator ""}}

  {:name :_editor-css-url
   :description "`/assets/editor.css?v=<frontend-build-hash>` — `<link href>` URL for the bundled editor stylesheet."
   :parent :str-join
   :return-type :text
   :args {:coll ["/assets/editor.css?v=" :build-hash-frontend-short]
          :separator ""}}

  ;; `<script src=…>` element. NOT `:_cdn-script-element` — that template
  ;; type-checks `:url` against the `:url` refinement (`^https?://`),
  ;; which our same-origin `/assets/editor.js?v=…` path doesn't match.
  ;; Build hiccup directly, mirroring the `:_editor-css-link` shape.
  {:name :_editor-script-attrs
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :src}
          :value {:ref :_editor-js-url}}}

  {:name :_editor-script-tag
   :description "`<script src=\"/assets/editor.js?v=…\"></script>` element appended at end of `<body>`. Replaces the previous inline `<script>` so the bundle is cached across page loads."
   :parent :hiccup
   :args {:tag {:value "script"}
          :attrs :_editor-script-attrs
          :children {:value []}}}

  ;; `<script src="/assets/api-routes.js?v=…">` — loads the boot-
  ;; time-cached `window.API = {…}` module so every editor JS
  ;; module can address `/api/*` routes by symbolic name
  ;; (`window.API.api_branches`) instead of duplicating path
  ;; literals.
  ;;
  ;; Served as a SEPARATE static asset rather than inlined as
  ;; `<script>{…}</script>` because an inline `<script>` with raw
  ;; children placed before another `<script>` sibling triggered a
  ;; hiccup-normalisation bug where the next sibling was silently
  ;; dropped from the rendered HTML (editor.js never loaded, page
  ;; came up blank). Standalone repro of the hiccup chain on the
  ;; same inputs renders both siblings correctly, so the bug lives
  ;; somewhere graphden-specific between fn-def execution and the
  ;; hiccup output — see `test/graphden/regressions/inline_script_
  ;; sibling_drop_test.clj` for the pinned regression. Using two
  ;; `<script src>` siblings sidesteps the issue entirely.
  {:name :_api-routes-js-url
   :description "`/assets/api-routes.js?v=<frontend-build-hash>` — `<script src>` URL for the cached `window.API` module."
   :parent :str-join
   :return-type :text
   :args {:coll ["/assets/api-routes.js?v=" :build-hash-frontend-short]
          :separator ""}}

  {:name :_api-routes-js-handler
   :description "Ring handler for `GET /assets/api-routes.js` — returns the boot-cached `window.API` JS module as `application/javascript` with 1-year `immutable` `Cache-Control`."
   :parent :immutable-js-ok-response
   :args {:body :cached-api-routes-js}}

  {:name :_editor-api-routes-script-attrs
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :src}
          :value {:ref :_api-routes-js-url}}}

  {:name :_editor-api-routes-script-tag
   :description "`<script src=\"/assets/api-routes.js?v=…\"></script>` — loads the boot-cached `window.API` module before the main editor.js bundle so every editor module can read `window.API.<key>` at file-eval time."
   :parent :hiccup
   :args {:tag {:value "script"}
          :attrs :_editor-api-routes-script-attrs
          :children {:value []}}}

  ;; `<link rel="stylesheet" href="…">` attrs map — built via two
  ;; assoc calls because the editor-css URL is a runtime composition
  ;; over `:build-hash-frontend-short` (can't be a literal map).
  {:name :_editor-css-link-attrs-rel
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :rel}
          :value {:value "stylesheet"}}}

  {:name :_editor-css-link-attrs
   :parent :assoc
   :args {:map :_editor-css-link-attrs-rel
          :key {:value :href}
          :value {:ref :_editor-css-url}}}

  {:name :_editor-css-link
   :description "`<link rel=\"stylesheet\" href=\"/assets/editor.css?v=…\">` element in `<head>`. Replaces the previous inline `<style>` so the browser can cache the CSS body across page loads."
   :parent :hiccup
   :args {:tag {:value "link"}
          :attrs :_editor-css-link-attrs
          :children {:value []}}}

  ;; =============================================================================
  ;; PAGE COMPOSITION (fn-defs)
  ;; =============================================================================

  ;; Build head elements list for cytoscape
  {:name :head-elements-0
   :description "Initial head-elements vector — single entry: `:_editor-css-link` (`<link rel=\"stylesheet\">` to the cached `/assets/editor.css` bundle). Subsequent fn-defs append CDN scripts."
   :parent :conj
   :args {:coll [] :item :_editor-css-link}}

  ;; Final editor <head> — stylesheet link + HTMX CDN.
  ;; HTMX (2.x) lets server-rendered popover fragments declare their
  ;; own interactivity (`hx-get` for row-expand, `hx-on:click` for
  ;; declarative dismissal, etc.) without per-module JS post-swap
  ;; binding code — the graph fragment owns the contract end to end.
  ;;
  ;; The graph itself needs no library: nodes are HTML overlays, edges are SVG
  ;; paths, and the viewport is one CSS transform.
  {:name :head
   :description "Final editor `<head>` element vector — `:_editor-css-link` (cached stylesheet) + HTMX 2.x CDN. HTMX is the declarative-interaction layer the `/partials/*` fragments rely on."
   :parent :with-cdn-script
   :args {:head :head-elements-0
          :url "https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js"}}

  ;; Complete HTML page
  ;; Scripts: API constants module (inline) THEN the editor JS
  ;; bundle. Order matters — every module in editor.js may read
  ;; `window.API.<key>` at file-eval time.
  {:name :_editor-scripts
   :parent :list
   :args {:items [:_editor-api-routes-script-tag :_editor-script-tag]}}

  {:name :page
   :description "Full editor HTML page — title, head (stylesheet link + CDN scripts), body (sidebar + graph), and an end-of-body `<script src>` pointing at the cached editor JS bundle. Rendered by `:_editor-handler` on `GET /`."
   :parent :html-page
   :args {:title "Graphden - Graph Editor"
          :head :head
          :body :body
          :scripts :_editor-scripts}}

  ;; Handler — :html-ok-response sets status 200 + html content-type;
  ;; :render-hiccup converts the hiccup page to an HTML string. With
  ;; :assoc-fn at the route binding the whole graph is hof-wrap'd into
  ;; a constant Ring callable.
  {:name :_editor-rendered-page
   :parent :render-hiccup
   :return-type :text
   :args {:hiccup :page}}

  {:name :_editor-handler
   :parent :html-ok-response
   :args {:body :_editor-rendered-page}}

  ;; =============================================================================
  ;; ASSET HANDLERS — bundled JS / CSS at /assets/editor.{js,css}
  ;; Each returns the bundle body with a 1-year `immutable`
  ;; `Cache-Control`. Hash-busting lives in the URL query string.
  ;; =============================================================================

  ;; `:script` is declared `:nullable-text` because `:str-replace` is
  ;; nil-flow-through; in practice the placeholder substitution over a
  ;; baked-in resource is never nil. `:assert-some` is the type-system
  ;; bridge — narrows back to `:text` for the strict `:body` slot.
  {:name :_editor-js-body
   :description "`:script` narrowed from `:nullable-text` to `:text` via `:assert-some` — the JS bundle is a baked-in resource that can't be nil at runtime, but `:str-replace`'s nil-flow-through type forces the explicit narrowing."
   :parent :assert-some
   :return-type :text
   :args {:value :script}}

  {:name :_editor-js-handler
   :description "Ring handler for `GET /assets/editor.js` — returns the concatenated editor JS bundle (with `__BUILD_HASH__` substituted) as `application/javascript` with `Cache-Control: public, max-age=31536000, immutable`."
   :parent :immutable-js-ok-response
   :args {:body :_editor-js-body}}

  ;; Standalone runtime bundle for graph-composed pages (e.g.
  ;; /demo/contact). Includes graphden-runtime.js (the dispatcher
  ;; / registry / loadPartial primitives) + graphden-actions-
  ;; builtin.js (navigate + submit-form + custom). Loaded INSTEAD
  ;; of editor.js on pages that don't host the editor canvas
  ;; (editor.js is ~700 KB and initialises Cytoscape + WebSocket
  ;; subscriptions that crash a stripped-down page).
  {:name :_graphden-runtime-js-paths
   :parent :const
   :args {:value ["packages/web/runtime/graphden-popover.js"
                  "packages/web/runtime/graphden-forms.js"
                  "packages/web/runtime/graphden-runtime.js"
                  "packages/web/runtime/graphden-actions-builtin.js"]}}

  {:name :_graphden-runtime-js-body
   :description "Concatenated `graphden-popover.js` + `graphden-forms.js` + `graphden-runtime.js` + `graphden-actions-builtin.js` (in `web/runtime/`) — the platform JS primitives graph-composed pages need (popover positioning + dismiss; hiccup form render / collect / fill / widgets; action dispatch + built-in navigate / submit-form / custom handlers)."
   :parent :concat-resources
   :return-type :text
   :args {:paths :_graphden-runtime-js-paths}}

  {:name :_graphden-runtime-js-handler
   :description "Ring handler for `GET /assets/graphden-runtime.js` — minimal runtime bundle for graph-composed pages. Same 1-year `immutable` cache headers as editor.js (hash-bust via `?v=` on the script tag)."
   :parent :immutable-js-ok-response
   :args {:body :_graphden-runtime-js-body}}

  ;; Reusable `<script>` tags + bundle list for graph-composed
  ;; pages that need the dispatcher to be live. Bound to a page's
  ;; `:scripts` slot via :graphden-runtime-scripts (one binding,
  ;; two tags). See :html-page-route in app/page for the
  ;; one-fn-def page-route template that pairs with these.

  {:name :_graphden-runtime-js-url
   :description "`/assets/graphden-runtime.js?v=<frontend-build-hash>` — `<script src>` URL for the runtime bundle. The query-string hash is the FRONTEND build hash so a new deploy invalidates the immutable browser cache; in between deploys the bundle is served from cache without even a conditional request."
   :parent :str-join
   :return-type :text
   :args {:coll ["/assets/graphden-runtime.js?v=" :build-hash-frontend-short]
          :separator ""}}

  {:name :_graphden-components-css-url
   :description "`/assets/graphden-components.css?v=<frontend-build-hash>` — `<link href>` URL for the components stylesheet. Hash-busted on every frontend-section change."
   :parent :str-join
   :return-type :text
   :args {:coll ["/assets/graphden-components.css?v=" :build-hash-frontend-short]
          :separator ""}}

  {:name :graphden-runtime-script-tag
   :description "`<script src=\"/assets/graphden-runtime.js?v=<hash>\">` — loads the graphden runtime bundle (dispatcher + built-in `submit-form` / `navigate` / `custom` handlers, see `web/runtime/graphden-runtime.js` + `graphden-actions-builtin.js`). Hash-busted so the immutable browser cache is invalidated on every deploy."
   :parent :hiccup
   :args {:tag {:value "script"}
          :attrs {:parent :assoc
                  :args {:map {:value {}}
                         :key {:value :src}
                         :value :_graphden-runtime-js-url}}
