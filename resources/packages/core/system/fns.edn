;; System information and Ring response primitives
;; ring-response, make-handler, to-json-string, jvm-info, current-time-ms


{:namespace "core.system"
 :description "System primitives — Ring response shape, JSON, JVM info, timing, env, resources."
 :fns
 [;; ---------------------------------------------------------------------
  ;; Record-type declarations (formerly aliases.edn). Open-record
  ;; subtyping (`{a:int b:text} ⊆ {a:int}`) means handlers that produce
  ;; a SUPERSET of the named fields still satisfy the type — matches
  ;; how http-kit consumes the response map.
  ;; ---------------------------------------------------------------------

  {:name :ring-response-shape
   :type {:status :http-status
          :headers [:map :text :text]
          :body :text}}

  {:name :jvm-version-shape
   :type {:name :text
          :version :text
          :uptime-ms :int}}

  {:name :heap-memory-shape
   :type {:heap-used :int
          :heap-max :int
          :heap-committed :int
          :free :int
          :total :int
          :max :int}}

  {:name :os-info-shape
   :type {:name :text
          :arch :text
          :processors :int
          :load-average :numeric}}

  ;; ring-response — pure-declaration constructor for `:ring-response-shape`.
  ;; Built as an :assoc chain: each step adds one field to a growing
  ;; record, threading the lifted free args (`:status` `:headers` `:body`)
  ;; through. No defbase needed — the type-system's `:assoc` rule
  ;; computes the record shape, which `:return-type :ring-response-shape`
  ;; pins (computed ⊆ declared check at sync time).
  ;;
  ;; `:headers` flows through keyword-keyed (JSONB roundtrip keywordizes
  ;; literal map keys). The `:http-server` adapter (web/http/impls.clj)
  ;; stringifies once on the way to http-kit, so no in-graph
  ;; `:stringify-map-keys` step is needed here.

  {:name :_ring-response--w-status
   :parent :assoc
   :args {:map {}
          :key {:value :status}
          :value {:as :status :type :http-status}}}

  {:name :_ring-response--w-headers
   :parent :assoc
   :args {:map :_ring-response--w-status
          :key {:value :headers}
          :value {:as :headers :type [:map :text :text]}}}

  {:name :ring-response
   :description "Build a Ring response: `{:status :headers :body}`. Free args: `:status` (refined `:http-status`), `:headers` (jsonb, stringified), `:body` (text)."
   :parent :assoc
   :args {:map :_ring-response--w-headers
          :key {:value :body}
          :value {:as :body :type :text}}
   :return-type :ring-response-shape}

  ;; Ring-handler shape over `:constantly` — the result is a one-arg
  ;; callable that returns `:response` for any request, ignoring the
  ;; input. Used for reitit's default-handler trio (`:not-found`,
  ;; `:method-not-allowed`, `:not-acceptable`) where the slot expects a
  ;; raw Clojure callable; per-route handlers use `:assoc-fn` instead.
  ;; Pure rename of `:constantly`'s `:value` arg to `:response` — no
  ;; new impl, just a semantic alias.
  {:name :make-handler
   :description "Ring-handler shape over `:constantly` — binds `:response` so the resulting callable returns it for every request, ignoring the input."
   :parent :constantly
   :args {:value {:as :response}}}

  {:name :to-json-string
   :description "Serialize a Clojure value to a JSON string."
   :args {:data {:type :jsonb :description "Any JSON-encodable value."}}
   :return-type :text}

  {:name :parse-json
   :description "Parse a JSON string into a Clojure value."
   :args {:string {:type :text :description "JSON text to parse."}
          :keywordize {:type :bool :value true
                       :description "When true, convert string keys to keywords."}}
   :return-type :jsonb}

  {:name :jvm-version
   :description "Java runtime version string (`java.version` system property)."
   :args {}
   :return-type :jvm-version-shape
   :effects #{:io}}                 ; system-property read

  {:name :heap-memory
   :description "JVM heap usage snapshot — `{:heap-used :heap-max :heap-committed :free :total :max}` in bytes."
   :args {}
   :return-type :heap-memory-shape
   :effects #{:io}}                 ; live runtime state — varies per call

  {:name :thread-count
   :description "Live thread count from the JVM ThreadMXBean."
   :args {}
   :return-type :int
   :effects #{:io}}                 ; live runtime state — varies per call

  {:name :os-info
   :description "Host operating-system info — name, arch, processors, load-average."
   :args {}
   :return-type :os-info-shape
   :effects #{:io}}                 ; system-property read

  ;; jvm-info composed from atomic base-fns via assoc chain
  {:name :jvm-info
   :description "Aggregate JVM/system snapshot — version, heap, threads, OS."
   :parent :assoc
   :args {:map :_threads-section :key "os" :value :os-info}}

  {:name :_jvm-section
   :parent :assoc-empty
   :args {:key "jvm" :value :jvm-version}}

  {:name :_memory-section
   :parent :assoc
   :args {:map :_jvm-section :key "memory" :value :heap-memory}}

  {:name :_threads-section
   :parent :assoc
   :args {:map :_memory-section :key "threads" :value :thread-count}}

  {:name :current-time-ms
   :description "Wall-clock milliseconds since Unix epoch."
   :args {}
   :return-type :int
   :effects #{:time}}

  {:name :env
   :description "Read an OS environment variable. Returns nil if the variable is unset, hence the `:nullable-text` (`[:union :null :text]`) return — callers narrow to non-null via `:coalesce` (or an `:if`/`:nil?` guard)."
   :args {:name {:type :text :description "Environment variable name."}}
   :return-type :nullable-text
   :effects #{:env}}

  ;; Construct an ExceptionInfo. Paired with :throw to raise from
  ;; graph code; also usable as a plain value if something wants a
  ;; ready-made exception without raising.
  {:name :ex-info
   :description "Construct a Clojure `clojure.lang.ExceptionInfo` from a message + data map. Pair with `:throw` to raise; the value can also flow through the graph as a plain exception object."
   :args {:message {:type :text :description "Human-readable error message."}
          :data {:type :jsonb :description "Structured `:data` payload attached to the exception."}}
   :return-type :any}

  ;; Raise the given exception. Control flow never returns, so the
  ;; result type is `:never` — the bottom type, a subtype of every
  ;; type. In `(:if cond :then "ok" :else (:throw …))` the union of
  ;; the branches is `[:union :text :never]`, which `make-union`
  ;; collapses to `:text` — the throwing branch contributes nothing.
  {:name :throw
   :description "Raise an exception from graph code. Control flow never returns; `:return-type` is `:never` (the bottom type) so a throwing branch is accepted in any context and vanishes from a branch union."
   :args {:exception {:type :any :description "Exception to raise (typically built via `:ex-info`)."}}
   :return-type :never}

  ;; Look up a classpath resource and slurp it. Returns nil if missing.
  {:name :read-resource-or-nil
   :description "Read a classpath resource as a string, or return nil if the path doesn't resolve. Building block for `:read-resource` (which throws on miss)."
   :args {:path {:type :text :description "Resource path relative to the classpath root."}}
   :return-type :text
   :effects #{:io}}

  ;; Read file from classpath resources, or throw with a clear message
  ;; if the path doesn't resolve. fn-def composition on top of
  ;; `:read-resource-or-nil` + `:if` + `:throw` + `:ex-info`.
  {:name :read-resource
   :description "Read a classpath resource as a string, throwing `execution-error/resource-not-found` when the path doesn't resolve. Pure composition over `:read-resource-or-nil`/`:if`/`:throw`/`:ex-info`."
   :parent :if
   :args {:test :_resource-nil?
          :then :_resource-not-found-throw
          :else :_resource-or-nil}}

  {:name :_resource-or-nil
   :parent :read-resource-or-nil
   :args {:path {:as :path}}}

  {:name :_resource-nil?
   :parent :nil?
   :args {:value :_resource-or-nil}}

  {:name :_resource-not-found-message
   :parent :str
   :args {:parts [{:value "Resource not found: "}
                  {:as :path}]}}

  {:name :_resource-not-found-error
   :parent :ex-info
   :args {:message :_resource-not-found-message
          :data {"type" "execution-error/resource-not-found"}}}

  {:name :_resource-not-found-throw
   :parent :throw
   :args {:exception :_resource-not-found-error}}

  ;; Load multiple resource files and concatenate with separator.
  ;; Pure composition over `:map :read-resource` + `:str-join`.
  {:name :concat-resources
   :description "Read each path in `:paths` via `:read-resource` and join the contents with a separator (default `\\n\\n`). Used to bundle CSS/JS asset modules."
   :parent :str-join
   :args {:coll :_concat-resources-list
          :separator {:type :text :value "\n\n"}}}

  {:name :_concat-resources-list
   :parent :map
   :args {:func :read-resource
          :coll {:as :paths}}}

  ;; SHA-256 of a UTF-8 string, returned as 64 hex chars. Used as a
  ;; lower-level primitive when a one-off content hash is needed
  ;; somewhere; deploy verification uses the build-time hash below
  ;; instead (single source of truth across front- and back-end).
  {:name :sha256-hex
   :description "Lower-case 64-char hex SHA-256 digest of a UTF-8 string. Use `:subs` to take a shorter prefix when a concise build identifier is needed."
   :args {:s {:type :text :description "Input string. Returns nil for nil input."}}
   :return-type :text}

  ;; ============================================================================
  ;; Build identifiers (3-section)
  ;;
  ;; The uberjar carries `graphden-build-hashes.json`, written at build
  ;; time by `build.clj`'s `compute-section-hashes` step. It splits the
  ;; deploy into three independently-hashed sections so a `/version`
  ;; check tells you WHAT moved, not just whether anything did:
  ;;
  ;;   :frontend  — every `.js` / `.css` / `.html` / `.svg` under
  ;;                `resources/packages/` (the editor browser bundle)
  ;;   :packages  — every `.edn` / `.clj` under `resources/packages/`
  ;;                (graph fn-defs + their base-fn impls)
  ;;   :backend   — `src/**/*.clj` plus non-package resources
  ;;                (`system-*.edn`, `logback.xml`, …)
  ;;
  ;; All three flow into `GET /version`; the editor's console marker
  ;; uses the frontend hash specifically (it's the bit the user can
  ;; visually verify against what they have open in the editor).
  ;; ============================================================================

  {:name :_build-hashes-raw
   :parent :read-resource
   :args {:path "graphden-build-hashes.json"}}

  {:name :build-hashes
   :description "Map `{\"frontend\" … \"backend\" … \"packages\" …}` — each value is the lower-case 64-char hex SHA-256 of that section of the deploy at build time. Keys stay strings (`:keywordize false`) so the `:get` lookups below match the JSON shape verbatim."
   :parent :parse-json
   :args {:string :_build-hashes-raw
          :keywordize false}}

  {:name :build-hash-frontend
   :description "Frontend-section SHA-256 — every `.js` / `.css` under `resources/packages/`. Changes only when a browser-side asset changes."
   :parent :get
   :args {:coll :build-hashes :key "frontend"}}

  {:name :build-hash-frontend-short
   :description "First 12 chars of `:build-hash-frontend` — used by the editor's `BUILD_HASH` console marker so the in-page identifier reflects exactly which JS/CSS the user is running."
   :parent :subs
   :args {:string :build-hash-frontend :start 0 :end 12}}

  ;; Invoke a value (that happens to be a Clojure fn) with one arg.
  ;; `:func :any` — the value is deref'd and used as-is. Use this when
  ;; :func is a fn-graph that PRODUCES a callable (e.g. :_router
  ;; returns a reitit ring-handler).
  ;;
  ;; NOTE: the slot's `:any` type is load-bearing for the executor's
  ;; runtime dispatch — `:fn`-typed slots trigger `hof-wrap` (treat
  ;; the bound fn-graph as something to wrap into a callable);
  ;; `:any`-typed slots pass the value through as-is. Type-system
  ;; polymorphism on this slot would require splitting the slot's
  ;; runtime-dispatch tag from its type-check shape (separate task).
  ;; Type-check still gets call-site narrowing via the rich-types
  ;; ref re-firing mechanism (`effective-ref-return`).
  {:name :invoke
   :description "Invoke a value that's already a Clojure callable with one argument. Polymorphic via type-vars `a`/`b`: a fn-graph whose `:return-type` is itself a fn-type produces the callable; type-checker unifies and propagates `b` from the produced fn's return through to consumers. Runtime detects callable-producer via `:produces-callable?` and uses thunk semantics."
   :args {:func {:type [:fn {:arg a} b]
                 :description "Bound fn-graph whose `:return-type` is a fn-type — its evaluation produces a Clojure callable."}
          :arg {:type a :description "Single argument passed to the callable."}}
   :return-type b}

  ;; Call a fn-graph-as-callable with one arg. `:func :fn` — the ref is
  ;; hof-wrap'd into a callable (the fn-graph's leftover free-arg
  ;; receives :arg). Use this when :func is a fn-graph that IS a
  ;; callable (Ring-handler-shaped: has `:request` or similar free arg,
  ;; returns a response).
  {:name :call
   :description "Invoke a fn-graph (hof-wrap'd into a Clojure callable) with one argument. Use when `:func` IS a callable; for already-built Clojure fns use `:invoke`."
   :args {:func {:type [:fn {:arg a} b] :description "Fn-graph to wrap into a callable. Single-arg slot; positional unify (the callee's leftover free-arg name is alpha-equivalent)."}
          :arg {:type a :description "Single argument passed to the callable."}}
   :return-type b}

  ;; Call a fn-graph-as-callable with NO args. `:func [:fn {} a]` —
  ;; bare-shape HOF slot. The ref is hof-wrap'd; with zero call-site
  ;; lambda-params, the wrap produces a variadic-ignore callable
  ;; that closes over the outer free-args (closure-capture; see
  ;; docs/CLOSURE_CAPTURE.md). Companion to `:call` (1-arg) for
  ;; cases where the target takes no per-invocation input — e.g.
  ;; cron fire-targets, signal handlers, scheduled cleanup tasks.
  {:name :call-noargs
   :description "Invoke a fn-graph (hof-wrap'd into a 0-arg callable) with no arguments. Use when `:func` IS a callable that takes nothing. Mirrors `:call` for the no-arg case."
   :args {:func {:type [:fn {} a] :description "Fn-graph wrapped as a 0-arg callable. Captured args resolve from the calling fn's binding-chain at wrap time."}}
   :return-type a}

  ;; Read an InputStream/Reader to string
  {:name :slurp
   :description "Read an InputStream/Reader to a string (Clojure's `slurp`). Used to materialise Ring request bodies."
   :args {:input {:type :any :description "InputStream, Reader, or any source `clojure.core/slurp` accepts."}}
   :return-type :text}]}
