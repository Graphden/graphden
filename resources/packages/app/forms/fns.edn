;; Type-aware value-form system — built-in form-fns + the dispatch
;; registry.
;;
;; A "form-fn" is a `:const` fn-def holding a STATIC hiccup template
;; for one input control. The hiccup is authored with plain-string
;; tags and string attribute keys so it survives the JSONB / JSON
;; round-trip to the editor unchanged — no keyword sugar.
;;
;; The control carries the `data-*` contract the editor's form
;; runtime reads:
;;   data-form-field   — presence marks a value-bearing control
;;   data-field-kind   — text | number | bool | keyword | json | edn | enum
;;                       (how the JS reads + coerces the raw value)
;; A scalar control omits `data-field-path` (absent = the whole
;; value IS this one field).
;;
;; `:_value-form-registry` maps a type to the form-fn that renders
;; it. The `/api/value-form` resolver reads this list and matches a
;; leaf type by `subtype?`, most-specific wins — the same shared-list
;; pattern as `:api-routes :items`. Add a form-fn here to extend the
;; system; no executor / resolver change needed.

{:namespace "app.forms"
 :description "Type-aware value-edit forms — built-in scalar form-fns (static hiccup control templates) and the type -> form-fn dispatch registry consumed by the /api/value-form resolver."
 :fns
 [;; --- scalar leaf form-fns ---

  {:name :_form-text
   :description "Single-line text input — the form for a `:text` slot."
   :parent :const
   :args {:value ["input" {"type" "text"
                           "class" "arg-value-edit-input"
                           "data-form-field" ""
                           "data-field-kind" "text"}]}}

  {:name :_form-color
   :description "HEX color editor with a native color picker, alpha and manual text input; uses the standard field collection and refinement validation."
   :parent :const
   :args {:value ["div" {"class" "value-form-widget"
                         "data-form-widget" "color"}
                  ["input" {"type" "color" "aria-label" "Color"}]
                  ["input" {"type" "number" "min" "0" "max" "255" "step" "1"
                            "data-color-alpha" "" "aria-label" "Alpha (0–255)"}]
                  ["input" {"type" "text" "class" "arg-value-edit-input"
                            "aria-label" "HEX color" "placeholder" "#RRGGBB"
                            "data-form-field" "" "data-field-kind" "text"}]
                  ["svg" {"width" "24" "height" "24" "aria-hidden" "true"}
                   ["rect" {"width" "24" "height" "24" "rx" "3"}]]]}}

  {:name :_form-number
   :description "Numeric input — the form for `:int` / `:numeric` / `:float` slots."
   :parent :const
   :args {:value ["input" {"type" "number"
                           "class" "arg-value-edit-input"
                           "data-form-field" ""
                           "data-field-kind" "number"}]}}

  {:name :_form-bool
   :description "Checkbox — the form for a `:bool` slot."
   :parent :const
   :args {:value ["input" {"type" "checkbox"
                           "data-form-field" ""
                           "data-field-kind" "bool"}]}}

  {:name :_form-keyword
   :description "Text input for a `:keyword` slot. The runtime stores the entry colon-prefixed so it round-trips AS a keyword."
   :parent :const
   :args {:value ["input" {"type" "text"
                           "class" "arg-value-edit-input"
                           "placeholder" ":keyword"
                           "data-form-field" ""
                           "data-field-kind" "keyword"}]}}

  ;; `data-field-kind="any"` is the SMART parse (graphden-forms.js): JSON
  ;; when it parses, the raw text otherwise — so a reader binding a word
  ;; to a `:const` types `tick`, not `"tick"` (lesson 35 used to teach the
  ;; quotes), while `42`, `true`, `[]` and `{"a": 1}` still land typed.
  ;; Strict JSON (`json`) is what the "as: JSON" choice in the editor asks
  ;; for explicitly.
  {:name :_form-json
   :description "Multi-line smart-parse textarea — the fallback form for `:jsonb` / `:any` and any type with no more specific form-fn: JSON when it parses, text otherwise. `data-lang` upgrades it to a CodeMirror editor client-side (editor-code.js)."
   :parent :const
   :args {:value ["textarea" {"class" "arg-value-edit-input"
                              "rows" 6
                              "data-form-field" ""
                              "data-lang" "json"
                              "data-field-kind" "any"}]}}

  ;; JS source body textarea. Same shape as `:_form-json`
  ;; but `data-field-kind="text"` so the value round-trips as a
  ;; plain string instead of being JSON.parse'd. Used by
  ;; `:custom-script` / `:wrap-custom-script` / `:dispatch-custom`
  ;; (the inline-JS escape hatch). `data-lang` upgrades it to a
  ;; CodeMirror editor client-side (editor-code.js, vendored bundle).
  {:name :_form-js-source
   :description "Multi-line textarea — the form for `:js-source` slots (escape-hatch JS bodies). Plain string, no JSON parsing; CodeMirror-upgraded client-side."
   :parent :const
   :args {:value ["textarea" {"class" "arg-value-edit-input"
                              "rows" 8
                              "spellcheck" "false"
                              "data-form-field" ""
                              "data-lang" "js"
                              "data-field-kind" "text"}]}}

  ;; CSS source textarea — same shape as :_form-js-source (plain
  ;; string, no JSON parsing), for `:css-source` slots
  ;; (`:custom-stylesheet` / `:stylesheet-route` bodies).
  {:name :_form-css-source
   :description "Multi-line textarea — the form for `:css-source` slots (stylesheet bodies). Plain string, no JSON parsing."
   :parent :const
   :args {:value ["textarea" {"class" "arg-value-edit-input value-form-hiccup"
                              "rows" 12
                              "spellcheck" "false"
                              "data-form-field" ""
                              "data-lang" "css"
                              "data-field-kind" "text"}]}}

  ;; Hiccup source textarea — EDN, not JSON. Dispatched through the
  ;; registry's EXACT-type tier (`hiccup-node` row below): the whole
  ;; union type gets ONE editor instead of decomposing into a 6-branch
  ;; selector whose list branch would land in the JSON fallback.
  ;; `data-field-kind="edn"` — the client (graphden-edn.js) parses EDN
  ;; and normalizes keywords to the stored string form, so the author
  ;; writes `[:div {:class "x"} "hi"]` exactly like the docs even
  ;; though storage / transit are JSON-shaped.
  {:name :_form-hiccup
   :description "Multi-line EDN textarea — the form for `:hiccup-node` slots. The author writes hiccup as EDN (`[:div {:class \"x\"} \"hi\"]`); the client parses it and normalizes keywords to the stored string form."
   :parent :const
   :args {:value ["textarea" {"class" "arg-value-edit-input value-form-hiccup"
                              "rows" 12
                              "spellcheck" "false"
                              "placeholder" "[:div {:class \"box\"} \"text\"]"
                              "data-form-field" ""
                              "data-lang" "clojure"
                              "data-field-kind" "edn"}]}}

  ;; --- Tier 2 demo: a custom-widget form-fn ---
  ;;
  ;; `:vf-rating` is a 1-5 integer refinement; `:_form-rating` renders
  ;; it via the `rating` custom widget — a registered JS module that
  ;; mounts itself on the `data-form-widget` node — instead of a plain
  ;; number input. This is the reference example for Tier 2: a user
  ;; adds a widget by shipping its JS, a `:const` form-fn carrying
  ;; `data-form-widget`, and a registry entry.

  {:name :vf-rating
   :description "Demo refinement — an integer star-rating in [1, 5]. Rendered by the `rating` custom widget."
   :refine {:base :int :constraint [:and [:>= 1] [:<= 5]]}}

  {:name :_form-rating
   :description "Custom-widget form for `:vf-rating` — emits a `data-form-widget` mount point the editor's `rating` widget hydrates into a slider control."
   :parent :const
   :args {:value ["div" {"class" "value-form-widget"
                         "data-form-widget" "rating"}]}}

  ;; --- dispatch registry ---
  ;;
  ;; Vector of [type-name form-fn-name] pairs, both as plain strings
  ;; (string form-fn names can never be mistaken for fn-refs inside a
  ;; `:const` literal). The resolver reads this, keywordises each
  ;; entry, and picks the form-fn whose type is the most-specific
  ;; supertype of the slot's effective type via `subtype?`.

  ;; --- marker-typed slots: resolver-binding widget ---
  ;;
  ;; A slot whose effective type carries a hide-result MARKER
  ;; (`[:secret :text]`, or any graph-declared marker with
  ;; `:hide-result? true`) is not edited as a literal — the editor
  ;; mounts the `secret-binding` widget (path + initial value,
  ;; saved via POST /api/secrets/binding as a resolver binding).
  ;; The dispatch is a REGISTRY row like any other form: the seeded
  ;; `:secret` marker registers `["secret" "any"]` below; a new
  ;; graph-declared marker opts into the same widget by adding its
  ;; own `[["<tag>" "any"] "_form-secret-binding"]` row. Nothing in
  ;; the editor JS knows the tag names.

  {:name :_form-secret-binding
   :description "Marker-typed slot form — mounts the editor's `secret-binding` widget (vault path + initial value, resolver-binding save) instead of a literal control."
   :parent :const
   :args {:value ["div" {"class" "value-form-widget"
                         "data-form-widget" "secret-binding"}]}}

  ;; ===================================================================
  ;; COMPOSITE structure templates (round-2 decomposition): the
  ;; record/union WRAPPERS the server-side assembler
  ;; (`app.forms/build-form`) renders through the graph — restyle
  ;; the composite editors here, exactly like the leaf controls above.
  ;; Graph composition owns recursion, union branch fit, refinement
  ;; bounds and enum members as well as the presentational shells. Hiccup tags
  ;; and attr keys are STRINGS by design (the editor renders this form
  ;; data client-side), same as the leaf consts.
  ;; ===================================================================

  ;; A record field's label — <label for> when the control has an id,
  ;; a plain heading div for a nested group.
  {:name :_form-field-has-id?
   :parent :some?
   :args {:value {:as :field-id :type :nullable-text}}}
  {:name :_form-field-label-attrs
   :parent :zipmap
   :args {:keys [{:value "class"} {:value "for"}]
          :vals [{:value "value-form-label"} {:as :field-id}]}}
  {:name :_form-field-label-el
   :parent :list
   :args {:items [{:value "label"} :_form-field-label-attrs {:as :field-name :type :text}]}}
  {:name :_form-field-heading-el
   :parent :list
   :args {:items [{:value "div"} {:value {"class" "value-form-label"}} {:as :field-name}]}}
  {:name :_form-field-label
   :parent :if
   :args {:test :_form-field-has-id?
          :then :_form-field-label-el
          :else :_form-field-heading-el}}

  {:name :_form-record-field
   :description "One record field row — the label/heading plus the field's control, in the `value-form-field` wrapper."
   :parent :list
   :args {:items [{:value "div"} {:value {"class" "value-form-field"}}
                  :_form-field-label
                  {:as :control :type :hiccup-node}]}}

  {:name :_form-record-group
   :description "A record editor — the `value-form-group` wrapper around the already-rendered field rows."
   :parent :concat
   :args {:colls [{:value ["div" {"class" "value-form-group"}]}
                  {:as :fields :type [:list :hiccup-node]}]}}

  {:name :_form-union-select
   :description "The union's branch `<select>` — wrapper attrs here; the `<option>` rows (type labels + the pre-selected branch) come computed from the assembler."
   :parent :concat
   :args {:colls [{:value ["select" {"class" "arg-value-edit-input value-form-union-select"
                                     "data-union-select" ""}]}
                  {:as :options :type [:list :hiccup-node]}]}}

  ;; One union branch wrapper — indexed, hidden unless active.
  {:name :_form-union-branch-attrs-base
   :parent :zipmap
   :args {:keys [{:value "class"} {:value "data-union-branch"}]
          :vals [{:value "value-form-union-branch"} {:as :index :type :text}]}}
  {:name :_form-union-branch-attrs-hidden
   :parent :assoc
   :args {:map :_form-union-branch-attrs-base
          :key {:value "hidden"}
          :value {:value "hidden"}}}
  {:name :_form-union-branch-attrs
   :parent :if
   :args {:test {:as :active? :type :bool}
          :then :_form-union-branch-attrs-base
          :else :_form-union-branch-attrs-hidden}}
  {:name :_form-union-branch
   :description "One union branch — the indexed `value-form-union-branch` wrapper (hidden unless active) around the branch's control."
   :parent :list
   :args {:items [{:value "div"} :_form-union-branch-attrs {:as :control :type :hiccup-node}]}}

  {:name :_form-union-wrap-attrs
   :parent :zipmap
   :args {:keys [{:value "class"} {:value "data-form-union"} {:value "data-union-active"}]
          :vals [{:value "value-form-union"} {:value ""} {:as :active :type :text}]}}
  {:name :_form-union-head
   :parent :list
   :args {:items [{:value "div"} :_form-union-wrap-attrs {:as :select :type :hiccup-node}]}}
  {:name :_form-union-wrap
   :description "The union editor — outer wrapper (active-branch marker) around the branch `<select>` and the branch divs."
   :parent :concat
   :args {:colls [:_form-union-head
                  {:as :branches :type [:list :hiccup-node]}]}}

  {:name :_value-form-registry
   :description "Type -> form-fn dispatch table for /api/value-form. Each pair is [type-name form-fn-name] (type-name may be a VECTOR for structural keys — the marker row [\"secret\" \"any\"] means [:secret :any]). Leaf types subtype-match, most-specific wins, falling back to _form-json; a COMPOSITE type matches only its exact row (the hiccup-node row) — see `app.forms/_form-exact-target`."
   :parent :const
   :args {:value [["text" "_form-text"]
                  ["core.refinements/color" "_form-color"]
                  ["int" "_form-number"]
                  ["numeric" "_form-number"]
                  ["float" "_form-number"]
                  ["bool" "_form-bool"]
                  ["keyword" "_form-keyword"]
                  ["jsonb" "_form-json"]
                  ["any" "_form-json"]
                  ["js-source" "_form-js-source"]
                  ["css-source" "_form-css-source"]
                  ["hiccup-node" "_form-hiccup"]
                  ["vf-rating" "_form-rating"]
                  [["secret" "any"] "_form-secret-binding"]]}}

  ;; --- /api/value-form endpoint — parse -> validate -> apply ---
  ;;
  ;; Mirrors the type-API handler pattern (web/crud): three base-fns
  ;; glued by an `:if` over the validation result. POST with a JSON
  ;; body `{binding-id | fn-id+slot-id, item-id?}`; the body shape
  ;; matches the type-API endpoints rather than parsing a GET query
  ;; string (no query-param precedent in the codebase).

  {:name :_value-form-parsed-shape
   :description "Output of `:_value-form-parsed` — the slot-identifying ids (a binding-id, or an fn-id + slot-id, optionally an item-id). Each field is `:nullable-uuid` because the JSON parser returns nil for missing keys, and the validation step (`:_value-form-validation`) — NOT this shape — is what enforces the actual contract (either `:binding-id` is present, or both `:fn-id` + `:slot-id` are). Consumer base-fns (`:resolve-slot-effective-type`, `:current-slot-value`, `:build-value-form`) all handle nil-id inputs gracefully via `when` / `or` guards in the Clojure impl."
   :type {:binding-id :nullable-uuid :fn-id :nullable-uuid :slot-id :nullable-uuid :item-id :nullable-uuid}}

  {:name :_value-form-result-shape
   :description "Output of `:_value-form-apply` — the resolved editor form: `:form` is the control hiccup, `:value` the binding's current value (any type the slot holds)."
   :type {:ok :bool :form :hiccup-node :value :any}}

  ;; --- :_value-form-parsed — pure graph composition over
  ;; :parse-json-body + 4 :parse-uuid + :zipmap (4 UUID fields off
  ;; the JSON body).

  {:name :_value-form-body
   :parent :parse-json-body
   :args {:request {:as :request}}}

  {:name :value-form-record
   :description "`{:binding-id :fn-id :slot-id :item-id}` over `:vals` — the value-form parse and the provenance partial's synthesised twin inherit it."
   :parent :zipmap
   :args {:keys [{:value :binding-id} {:value :fn-id} {:value :slot-id} {:value :item-id}]}}

  {:name :_value-form-parsed
   :description "Stage 1 of value-form — JSON body -> {:binding-id :fn-id :slot-id :item-id}, each coerced to a UUID."
   :parent :value-form-record
   :args {:vals [{:parent :parse-uuid :args {:string {:parent :get :args {:coll :_value-form-body :key {:value :binding-id} :default nil}}}}
                 {:parent :parse-uuid :args {:string {:parent :get :args {:coll :_value-form-body :key {:value :fn-id} :default nil}}}}
                 {:parent :parse-uuid :args {:string {:parent :get :args {:coll :_value-form-body :key {:value :slot-id} :default nil}}}}
                 {:parent :parse-uuid :args {:string {:parent :get :args {:coll :_value-form-body :key {:value :item-id} :default nil}}}}]}}

  ;; --- :_value-form-validation — pure graph: `:if` over an `:or` of
  ;; `:some?` / `:and :some?` guards + a `:const` envelope. The
  ;; request must identify a slot (binding-id, or fn-id+slot-id).

  {:name :_value-form-binding-id
   :parent :get
   :args {:coll {:as :parsed} :key {:value :binding-id} :default nil}}

  {:name :_value-form-fn-id
   :parent :get
   :args {:coll {:as :parsed} :key {:value :fn-id} :default nil}}

  {:name :_value-form-slot-id
   :parent :get
   :args {:coll {:as :parsed} :key {:value :slot-id} :default nil}}

  {:name :_value-form-well-formed?
   :description "True iff the request identifies a slot — `binding-id`, OR both `fn-id` and `slot-id`."
   :parent :or
   :args {:values [{:parent :some? :args {:value :_value-form-binding-id}}
                   {:parent :and
                    :args {:values [{:parent :some? :args {:value :_value-form-fn-id}}
                                    {:parent :some? :args {:value :_value-form-slot-id}}]}}]}}

  {:name :_value-form-err-no-slot
   :parent :const
   :args {:value {:ok false
                  :error "Request must include 'binding-id', or both 'fn-id' and 'slot-id'"}}}

  {:name :_value-form-validation
   :description "Stage 2 of value-form — the request must identify a slot (binding-id, or fn-id+slot-id). Returns the {:ok false :error} rejection, or nil when well-formed."
   :parent :if
   :args {:test :_value-form-well-formed?
          :then nil
          :else :_value-form-err-no-slot}}

  ;; value-form apply. The §3.3 type-aware form-renderer
  ;; (`:build-value-form`) stays atomic; the slot-type lookup, value
  ;; pre-read, and response shape are graph composition. Admin who
  ;; wants a different per-row attr set or response envelope reparents
  ;; `:_value-form-root` or `:_value-form-apply` itself.
  {:name :_slot-effective-type-raw
   :description "Resolve the slot's effective type from the parsed shape — nil when the slot can't be located."
   :args {:parsed {:type :_value-form-parsed-shape}}
   :return-type [:union :null :type-expression]
   :effects #{:db}}

  {:name :_slot-effective-type-resolved
   :parent :_slot-effective-type-raw
   :args {:parsed {:as :parsed :type :_value-form-parsed-shape}}}

  ;; The `:any` fallback for an unlocatable slot is a graph-visible
  ;; `:coalesce` default, not a literal buried in Clojure.
  {:name :resolve-slot-effective-type
   :description "Resolve the slot's effective type from the parsed shape, falling back to `:any` when the slot can't be located (`:coalesce` default — graph-visible)."
   :parent :coalesce
   :args {:value :_slot-effective-type-resolved
          :default {:value :any}}
   :return-type :type-expression}

  {:name :current-slot-value
   :description "Pre-read the slot's currently-bound value (used to seed the form)."
   :args {:parsed {:type :_value-form-parsed-shape}}
   :return-type :any
   :effects #{:db}}

  ;; Canonical adapters below retain type algebra and registry execution only.
  ;; Descriptor and renderer policy are graph compositions. Recursive callable
  ;; projections declare typed literal args so their return contracts seed
  ;; even when the fixture skips the type sweep (no implicit callable wrapping).
  {:name :_form-canonical-type,
   :args {:type-expr {:type :type-expression}},
   :return-type :type-expression}

  {:name :_form-union-type?,
   :args {:type-expr {:type :type-expression}},
   :return-type :bool}

  {:name :_form-list-type?,
   :args {:type-expr {:type :type-expression}},
   :return-type :bool}

  {:name :_form-record-type?,
   :args {:type-expr {:type :type-expression}},
   :return-type :bool}

  {:name :_form-union-members,
   :args {:type-expr {:type :type-expression}},
   :return-type [:list :type-expression]}

  {:name :_form-list-element,
   :args {:type-expr {:type :type-expression}},
   :return-type :type-expression}

  {:name :_form-refinement-base,
   :args {:type-expr {:type :type-expression}},
   :return-type :type-expression}

  {:name :_form-registry,
   :args {},
   :return-type [:list :any],
   :effects #{:db}}

  {:name :_form-run-target,
   :args {:target {:type :text}},
   :return-type :hiccup-node,
   :effects #{:db}}

  {:name :_form-refinement-type?,
   :args {:type-expr {:type :type-expression}},
   :return-type :bool}

  {:name :_form-refinement-constraint,
   :args {:type-expr {:type :type-expression}},
   :return-type :any}

  {:name :_form-literal-refinement-verdict,
   :args {:value {:type :any}, :constraint {:type :any}},
   :return-type [:union :bool :keyword]}

  {:name :_dispatch-pair,
   :parent :const,
   :args {:value {:as :pair, :type [:list :any]}}}

  {:name :_dispatch-pair-type,
   :parent :first,
   :args {:coll :_dispatch-pair}}

  {:name :_dispatch-accepts,
   :parent :subtype?,
   :args
   {:candidate {:as :type-expr, :type :type-expression},
    :expected :_dispatch-pair-type},
   :return-type :bool,
   :lambda-params [:pair]}

  {:name :_dispatch-type
   :parent :const
   :args {:value {:as :type-expr :type :type-expression}}}

  {:name :_dispatch-accepting,
   :parent :filter,
   :args
   {:pred :_dispatch-accepts, :coll {:as :registry, :type [:list :any]}
    :type-expr :_dispatch-type}}

  {:name :_dispatch-candidate,
   :parent :const,
   :args {:value {:as :choice, :type [:list :any]}}}

  {:name :_dispatch-candidate-type,
   :parent :first,
   :args {:coll :_dispatch-candidate}}

  {:name :_dispatch-narrower,
   :parent :subtype?,
   :args
   {:candidate :_dispatch-candidate-type,
    :expected :_dispatch-pair-type},
   :return-type :bool,
   :lambda-params [:pair]}

  {:name :_dispatch-most-specific?,
   :parent :every?,
   :args
   {:pred :_dispatch-narrower,
    :coll :_dispatch-accepting,
    :choice :_dispatch-candidate},
   :return-type :bool,
   :lambda-params [:choice]}

  {:name :_dispatch-most-specific,
   :parent :first,
   :args
   {:coll
    {:parent :filter,
     :args
     {:pred :_dispatch-most-specific?, :coll :_dispatch-accepting}}}}

  {:name :_dispatch-sort-key,
   :parent :vec,
   :args
   {:coll {:parent :list :args {:items
                                [{:parent :if,
                                  :args
                                  {:test
                                   {:parent :equal?,
                                    :args {:a :_dispatch-pair-type, :b {:value :any}}},
                                   :then 1,
                                   :else 0}}
                                 {:parent :to-str, :args {:value :_dispatch-pair-type}}]}}},
   :return-type [:list :any],
   :lambda-params [:pair]}

  {:name :_dispatch-fallback,
   :parent :first,
   :args
   {:coll
    {:parent :sort-by,
     :args {:key-fn :_dispatch-sort-key, :coll :_dispatch-accepting}}}}

  {:name :_dispatch-selected,
   :parent :coalesce,
   :args {:value :_dispatch-most-specific, :default :_dispatch-fallback}}

  {:name :form-registry-target,
   :description "Select the first most-specific accepting registry row; incomparable matches prefer non-any, then alphabetical type order. Shared by forms and safe representations."
   :parent :get,
   :args {:coll :_dispatch-selected, :key {:value 1}, :default nil},
   :return-type :nullable-text}

  {:name :_form-leaf-target, :parent :form-registry-target, :args {}}

  {:name :_dispatch-exact?,
   :parent :and,
   :args
   {:values
    [{:parent :subtype?,
      :args
      {:candidate {:as :type-expr, :type :type-expression},
       :expected :_dispatch-pair-type}}
     {:parent :subtype?,
      :args
      {:candidate :_dispatch-pair-type,
