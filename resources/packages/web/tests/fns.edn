  ;; web.response — status × content-type matrix
  ;; =========================================================================

  {:name :ok-response-is-200-with-the-bound-headers-and-body
   :description "`:ok-response` pins status 200 and passes headers + body through."
   :parent :assert-eq
   :args {:actual {:parent :_wt-resp-sig :args {:resp {:parent :ok-response :args {:headers {"Content-Type" "x/y"} :body "b"}}}}
          :expected {:value [200 "x/y" nil "b"]}}}

  {:name :not-modified-response-is-304
   :description "`:not-modified-response` pins status 304."
   :parent :assert-eq
   :args {:actual {:parent :_wt-resp-sig :args {:resp {:parent :not-modified-response :args {:headers {} :body ""}}}}
          :expected {:value [304 nil nil ""]}}}

  {:name :unauthorized-response-is-401
   :description "`:unauthorized-response` pins status 401."
   :parent :assert-eq
   :args {:actual {:parent :_wt-resp-sig :args {:resp {:parent :unauthorized-response :args {:headers {} :body "no"}}}}
          :expected {:value [401 nil nil "no"]}}}

  {:name :too-many-requests-response-is-429
