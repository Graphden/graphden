{:paths ["scripts"]

 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :as p]
             [clojure.string :as str])

  :init (do
          (def all-paths "src test")
          (def green "\u001b[32m")
          (def red "\u001b[31m")
          (def cyan "\u001b[36m")
          (def reset "\u001b[0m")

          (defn run-parallel
            "Run shell commands in parallel. Wait for all, fail if any fails."
            [cmds]
            (let [procs (mapv (fn [cmd] (p/process cmd {:out :inherit :err :inherit})) cmds)]
              (doseq [proc procs] (p/check proc)))))

  :enter (println (str cyan "▶ " (:name (current-task)) reset))

  ;; === DEVELOPMENT ===

  repl
  {:doc "Start headless nREPL server (writes .nrepl-port for clients to discover)"
   :override-builtin true
   :task (clojure "-A:dev -A:nrepl")}

  nrepl
  {:doc "Synonym for `bb repl` — clearer name when used by tools (Cider, clojure-mcp)"
   :task (clojure "-A:dev -A:nrepl")}

  nrepl-bg
  {:doc "Start headless nREPL in background. Logs → .nrepl.log, PID → .nrepl.pid. Stop via `bb nrepl-stop`."
   :task (let [pid-file (fs/file ".nrepl.pid")
               port-file (fs/file ".nrepl-port")
               running? (and (fs/exists? pid-file)
                             (zero? (:exit (p/shell {:continue true :out nil :err nil}
                                                    "kill" "-0" (str/trim (slurp pid-file))))))]
           (if running?
             (do (println (str red "nREPL already running (PID " (str/trim (slurp pid-file)) ")" reset))
                 (println "  Stop it first via `bb nrepl-stop`."))
             (do
               (when (fs/exists? port-file) (fs/delete port-file))
               ;; setsid + nohup fully detach; redirects free stdin/out/err
               (p/shell "bash" "-c"
                        "nohup setsid clojure -A:dev -A:nrepl >.nrepl.log 2>&1 </dev/null & echo $! >.nrepl.pid")
               (println (str "Starting nREPL... (PID " (str/trim (slurp pid-file)) ")"))
               (loop [tries 0]
                 (cond
                   (>= tries 30)
                   (println (str red "WARN: .nrepl-port did not appear within 30s; check .nrepl.log" reset))
                   (fs/exists? port-file)
                   (println (str green "✓ nREPL ready on port " (str/trim (slurp port-file)) reset
                                 "\n  log:  .nrepl.log"
                                 "\n  pid:  .nrepl.pid"
                                 "\n  stop: bb nrepl-stop"))
                   :else (do (Thread/sleep 1000) (recur (inc tries))))))))}

  nrepl-stop
  {:doc "Stop the backgrounded nREPL started by `bb nrepl-bg`"
   :task (let [pid-file (fs/file ".nrepl.pid")]
           (if (fs/exists? pid-file)
             (let [pid (str/trim (slurp pid-file))]
               (p/shell {:continue true :out nil :err nil} "kill" pid)
               ;; JVM shutdown hook deletes .nrepl-port itself, so use
               ;; delete-if-exists to avoid a race-condition crash.
               (fs/delete-if-exists pid-file)
               (fs/delete-if-exists (fs/file ".nrepl-port"))
               (println (str green "✓ Stopped nREPL (PID " pid ")" reset)))
             (println "No .nrepl.pid found — nothing to stop")))}

  ;; === LINTERS (each takes optional path) ===

  kondo
  {:doc "Run clj-kondo [path]"
   :task (let [path (or (first *command-line-args*) all-paths)
               native? (= 0 (:exit (p/shell {:out :string :err :string :continue true} "which clj-kondo")))]
           (if native?
             (p/shell (str "clj-kondo --lint " path))
             (clojure (str "-M:kondo --lint " path))))}

  splint
  {:doc "Run splint [path]"
   :task (clojure (str "-M:splint " (or (first *command-line-args*) all-paths)))}

  cljstyle
  {:doc "Check formatting [path]"
   :task (clojure (str "-M:cljstyle check " (or (first *command-line-args*) all-paths)))}

  ;; NOTE: Eastwood removed - incompatible with Clojure 1.12 qualified methods (Class/.method)
  ;; See: https://github.com/jonase/eastwood/issues/457

  ;; === TESTS ===

  test
  {:doc "Run all tests"
   :task (clojure "-M:dev:test -m kaocha.runner")}

  coverage
  {:doc "Run tests with coverage report"
   :task (clojure "-M:dev:test:cloverage --src-ns-path src --test-ns-path test --ns-regex \"graphden\\..*\" --ns-exclude-regex \".*-test\" --ns-exclude-regex \".*contract-tests\" --ns-exclude-regex \".*test-helpers\" --ns-exclude-regex \".*test-mocks\"")}

  ;; === FULL CHECK ===

  ci
  {:doc "Run ALL checks with live progress display"
   :task (load-file "scripts/ci.clj")}

  check
  {:doc "Run linters only (parallel)"
   :task (let [kondo-cmd (if (= 0 (:exit (p/shell {:out :string :continue true} "which clj-kondo")))
                           (str "clj-kondo --lint " all-paths)
                           (str "clojure -M:kondo --lint " all-paths))
               cljstyle-cmd (if (= 0 (:exit (p/shell {:out :string :continue true} "which cljstyle")))
                              (str "cljstyle check " all-paths)
                              (str "clojure -M:cljstyle check " all-paths))
               splint-cmd (str "clojure -M:splint " all-paths)]
           (run-parallel [kondo-cmd splint-cmd cljstyle-cmd])
           (println (str green "✓ All linters passed" reset)))}

  ;; === HELPERS ===

  fix
  {:doc "Auto-fix formatting [path]"
   :task (clojure (str "-M:cljstyle fix " (or (first *command-line-args*) all-paths)))}

  outdated
  {:doc "Check outdated dependencies"
   :task (clojure "-M:outdated")}

  security
  {:doc "Scan for CVE vulnerabilities (set GITHUB_TOKEN or NVD_API_KEY, or use --slow)"
   :task (let [github-token (System/getenv "GITHUB_TOKEN")
               nvd-api-key (System/getenv "NVD_API_KEY")
               slow-mode? (some #{"--slow"} *command-line-args*)
               warn-color "\u001b[33m"
               reset-color "\u001b[0m"
               props-file ".clj-watson.properties"]
           (cond
             ;; Prefer GitHub Advisory (faster)
             (and github-token (not (str/blank? github-token)))
             (do
               (println "Using GitHub Advisory Database...")
               (clojure "-M:watson -p deps.edn -t github-advisory"))

             ;; Fall back to NVD with API key
             (and nvd-api-key (not (str/blank? nvd-api-key)))
             (do
               (println "Using NVD Database...")
               (spit props-file (str "nvd.api.key=" nvd-api-key))
               (try
                 (clojure (str "-M:watson -p deps.edn -t dependency-check -w " props-file))
                 (finally
                   (fs/delete-if-exists props-file))))

             ;; Slow mode without API key
             slow-mode?
             (do
               (println (str warn-color "Running in slow mode without API key..." reset-color))
               (clojure "-M:watson -p deps.edn -t dependency-check --run-without-nvd-api-key"))

             ;; No tokens - show help
             :else
             (do
               (println (str warn-color "No API tokens configured." reset-color))
               (println)
               (println "Options:")
               (println "  1. Set GITHUB_TOKEN (recommended, fastest):")
               (println "     export GITHUB_TOKEN=ghp_...")
               (println "     Get at: https://github.com/settings/tokens")
               (println)
               (println "  2. Set NVD_API_KEY (more comprehensive):")
               (println "     export NVD_API_KEY=...")
               (println "     Get at: https://nvd.nist.gov/developers/request-an-api-key")
               (println)
               (println "  3. Run without API key (very slow, 10+ minutes):")
               (println "     bb security --slow")
               (System/exit 1))))}

  bench
  {:doc "Run performance benchmarks [--quick]"
   :task (clojure (str "-M:bench -m graphden.bench " (str/join " " *command-line-args*)))}

  ;; === DOCKER DEPLOYMENT ===

  rebuild
  {:doc "Rebuild jar + docker and restart (keeps DB data)"
   :task (do
           (println "1. Building uberjar...")
           (p/shell "clojure -T:build uber")

           (println "2. Rebuilding docker image...")
           (p/shell "docker-compose build executor")

           (println "3. Restarting container...")
           (p/shell "docker-compose up -d executor")

           (println "4. Waiting for server...")
           (loop [attempts 0]
             (Thread/sleep 2000)
             (let [result (p/shell {:continue true :out :string :err :string}
                                   "docker exec graphden-executor curl -sf http://localhost:8080/health")]
               (if (= 0 (:exit result))
                 (println (str green "✓ Server ready at http://localhost:9002/" reset))
                 (if (< attempts 30)
                   (do (print ".") (flush) (recur (inc attempts)))
                   (do (println (str red "✗ Server failed to start" reset))
                       (System/exit 1)))))))}

  deploy
  {:doc "Build and deploy to docker (clean rebuild with DB truncate)"
   :task (do
           (println "1. Cleaning target...")
           (fs/delete-tree "target")
           (fs/create-dirs "target")

           (println "2. Building uberjar...")
           (p/shell "clojure -T:build uber")

           (println "3. Resetting database schema...")
           (p/shell "docker exec graphden-postgres psql -U graphden -d graphden -c \"DROP SCHEMA public CASCADE; CREATE SCHEMA public;\"")

           (println "4. Rebuilding docker image...")
           (p/shell "docker-compose build --no-cache executor")

           (println "5. Restarting container...")
           (p/shell "docker-compose up -d executor")

           (println "6. Waiting for server...")
           (loop [attempts 0]
             (Thread/sleep 2000)
             (let [result (p/shell {:continue true :out :string :err :string}
                                   "docker exec graphden-executor curl -sf http://localhost:8080/health")]
               (if (= 0 (:exit result))
                 (println (str green "✓ Server ready at http://localhost:9002/" reset))
                 (if (< attempts 30)
                   (do (print ".") (flush) (recur (inc attempts)))
                   (do (println (str red "✗ Server failed to start" reset))
                       (System/exit 1)))))))}

  clean
  {:doc "Clean generated files"
   :task (do
           (fs/delete-tree "target")
           (fs/delete-tree ".cpcache")
           (fs/delete-tree ".clj-kondo/.cache")
           (println (str green "✓ Cleaned" reset)))}}}
