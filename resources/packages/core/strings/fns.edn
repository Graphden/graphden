;; String manipulation base functions
;; str, subs, str-len, str-upper, str-lower, str-trim, str-split, str-join,
;; str-to-keyword, keyword-to-str

[{:name :str
  :args {:args :jsonb}
  :return-type :text}

 {:name :subs
  :args {:s :text
         :start :int
         :end {:type :int :required false}}
  :return-type :text}

 {:name :str-len
  :args {:s :text}
  :return-type :int}

 {:name :str-upper
  :args {:s :text}
  :return-type :text}

 {:name :str-lower
  :args {:s :text}
  :return-type :text}

 {:name :str-trim
  :args {:s :text}
  :return-type :text}

 {:name :str-split
  :args {:s :text, :sep :text}
  :return-type :jsonb}

 {:name :str-join
  :args {:coll :jsonb
         :sep {:type :text :required false}}
  :return-type :text}

 {:name :str-to-keyword
  :args {:s :text}
  :return-type :any}

 {:name :keyword-to-str
  :args {:k :any}
  :return-type :text}]
