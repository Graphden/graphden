   :args {:coll {:as :parsed} :key {:value :fields}}}

  {:name :_update-record-type-fn-id-nil?
   :description "True when the parsed `:fn-id` is missing (not a valid UUID)."
   :parent :nil?
   :args {:value :_update-record-type-parsed-fn-id}}

  {:name :_update-record-type-fields-empty?
   :description "True when the parsed `:fields` vector is empty."
   :parent :empty?
   :args {:coll :_update-record-type-parsed-fields}}

  {:name :_update-record-type-where
   :description "Build the `{:id <fn-id>}` filter for the storage lookup. `:assoc-empty` writes the single field into a fresh map."
   :parent :assoc-empty
   :args {:key {:value :id} :value :_update-record-type-parsed-fn-id}}

  ;; Phase 3: `:id`-only IN-clause pushes into the identity SQL.
  ;; `:resolve-fn-rows` then overlays version data on the (at most one)
  ;; identity row matching the id.
  {:name :_update-record-type-fn-rows
   :description "Look up the target fn row by parsed fn-id. Empty when the row doesn't exist."
   :parent :resolve-fn-rows
   :args {:identities :_update-record-type-fn-identities
          :branch-chain :current-branch-chain}}

  {:name :_update-record-type-fn-identities
   :parent :storage-query-identities
   :args {:entity-type {:value "fn"}
          :where :_update-record-type-where}}

  {:name :_update-record-type-fn-row
   :description "First (and only) fn row from the lookup — nil when none."
   :parent :first
   :args {:coll :_update-record-type-fn-rows}}

  {:name :_update-record-type-fn-not-found?
   :description "True when the storage lookup didn't find a fn row with the parsed fn-id."
   :parent :nil?
   :args {:value :_update-record-type-fn-row}}

  {:name :_update-record-type-err-id-required
   :description "Static 400 rejection — id missing or not a UUID."
   :parent :const
   :return-type :_error-result-shape
   :args {:value {:ok false :error "id required (UUID)"}}}

  {:name :_update-record-type-err-not-found
   :description "Dynamic error builder — cites the parsed fn-id of the row that didn't exist. `:return-type` pinned to keep the parent cond's union of precise record shapes."
   :parent :zipmap
   :return-type :_error-result-shape
   :args {:keys [:ok :error]
          :vals [false
                 {:parent :str
                  :args {:parts ["fn "
                                 {:parent :get
                                  :args {:coll {:as :parsed}
                                         :key {:value :fn-id}
                                         :default nil}}
                                 " not found"]}}]}}

  {:name :_update-record-type-validation
   :description "Stage 2 of update-record-type — guards (missing id, empty field list, fn-row not found) wired as a flat `:cond`. The third clause reads storage (`:list-entities`) lazily — runs only when the first two guards passed."
   :parent :cond
   :args {:clauses [:_update-record-type-fn-id-nil?     :_update-record-type-err-id-required
                    :_update-record-type-fields-empty?  :_err-fields-required
                    :_update-record-type-fn-not-found?  :_update-record-type-err-not-found
                    {:value true}                       {:value nil}]
          :parsed :_update-record-type-parsed}
   :effects #{:db}}

  ;; --- Stage 3 of update-record-type — journalled txn split for graph.
  ;; Was one 141-line Clojure defn; now a `:try` (core.system) over an
  ;; `:atom` (core.concurrency) journal so the try/catch boundary,
  ;; rollback log, and success/failure split are visible at the graph
  ;; level. The atom value is resolved ONCE at `:try`'s call cache and
  ;; passed as a free arg to BOTH `:body` and `:on-throw` — so phases
  ;; and rollback see the same instance. Phases 2-5 + invalidate +
  ;; success live inside `:_apply-update-record-type-body` (one Clojure
  ;; helper — atomic-or-rolled-back is one concept per skill §3 §1);
  ;; cleanup lives inside `:_apply-update-record-type-rollback`. ---

  {:name :_apply-update-record-type-journal
   :description "Fresh atom-of-vector to collect rollback entries. Referenced from `:_update-record-type-apply` at the `:try`-call site (extra `:journal` binding); body and on-throw both see the same instance via wrap-time-capture."
   :parent :atom
   :args {:initial-value {:value []}}}

  {:name :_apply-update-record-type-body
   :description "Phases 2-5 + invalidate + success of update-record-type-apply. Mutates `:journal` for rollback hints; throws on storage/type-resolve failure (caught by `:try`)."
   :args {:parsed {:type :_update-record-type-parsed-shape :description "Output of `:_update-record-type-parsed`."}
          :journal {:type :any :description "Shared rollback-journal atom (captured from `:_update-record-type-apply`'s `:journal` binding at wrap time)."}}
   :return-type :_type-row-result-shape
   :effects #{:db}}

  {:name :_apply-update-record-type-rollback
   :description "`:try`'s on-throw branch — derefs `:journal` and replays entries in reverse. Returns the partial 400 response carrying the exception's message + ex-data. Both `:journal` (captured) and `:exception` (call-time) come from `:try`'s environment."
   :args {:journal {:type :any :description "Shared rollback-journal atom (captured from `:_update-record-type-apply`'s `:journal` binding)."}
          :exception {:type :any :description "Caught Exception, provided by `:try` at call time as the single lambda-param."}}
   :return-type :_error-result-shape
   :effects #{:db}}

  {:name :_update-record-type-apply
   :description "Stage 3 of update-record-type — `:try` over a shared `:atom` journal. Body runs phases 2-5 + invalidate + success; on-throw runs rollback. Returns `{:ok true :id :name}` on success or `{:ok false :error :data}` on rollback. `:journal` is an extra binding at the `:try`-call site (synthetic slot owned by `:try`); HOF wrap-time-capture treats it as a captured env-binding for both `:body` and `:on-throw` callables, so they share one atom instance per request. Caveat: orphaned slots are NOT garbage-collected (slot rows are shared)."
   :parent :try
   :args {:body :_apply-update-record-type-body
          :on-throw :_apply-update-record-type-rollback
          :journal :_apply-update-record-type-journal
          :parsed {:as :parsed}}}

  ;; --- entity create / update pipeline primitives. The handlers
  ;; themselves are `:if` graph fn-defs below; these base-fns are the
  ;; parse / validate / apply stages. `_rejected?` + `_rejection-response`
  ;; are shared by both create and update. ---
  ;; --- :_create-parsed (Variant-2). Was defbase delegating to a
  ;; since-removed `parse-create-request` helper. Now graph composition
  ;; over the new `:extract-entity-params` primitive + body→form-data
  ;; parsing + per-type-dispatch through `:cond` + `:try` to capture
  ;; parse exceptions as `:parse-error`. NOTE: body slurp is implicit —
  ;; `realize-body` in `web/http/impls.clj` has already coerced the
  ;; InputStream to a String by the time any handler sees the request.
  ;;
  ;; Per-type dispatch matches the legacy `case` in
  ;; `parse-create-request`. Adding a new entity type means adding a
  ;; new clause here AND a per-type `parse-<TYPE>-from-form` fn-def —
  ;; both at the graph level, no Clojure rebuild.

  {:name :_create-extracted
   :parent :extract-entity-params
   :args {:request {:as :request}}}

  ;; Form-data: use the `:parse-form-body` defbase (which CHECKS
  ;; `Content-Type: application/x-www-form-urlencoded` and returns
  ;; `{}` otherwise), then keywordise keys. The earlier inline
  ;; `:parse-query-string` chain preserved a legacy bug — it parsed
  ;; ANY non-nil body regardless of CT, so `Content-Type: text/plain`
  ;; with body `name=foo` slipped through guard #2 and the entity was
  ;; created with the parsed fields. Routing through `:parse-form-body`
  ;; closes that hole.

  {:name :_create-form-data-stringly
   :description "Form-data with string keys, parsed only when content-type matches `application/x-www-form-urlencoded`; `{}` otherwise. Reuses `:parse-form-body`."
   :parent :parse-form-body
   :args {:request {:as :request}}}

  {:name :_create-str-to-kw-callback
   :description "HOF callback — `:str-to-keyword` of the `:value` HOF-iteration argument."
   :parent :str-to-keyword
   :args {:string {:as :value}}}

  {:name :_create-form-data
   :description "Form-data with keyword keys. `{}` when no body OR wrong content-type — guard #2 (`:_create-form-data-empty?`) catches both via `:empty?`."
   :parent :update-keys
   :args {:m :_create-form-data-stringly
          :f :_create-str-to-kw-callback}}

  {:name :_create-base
   :description "Static fields of the parsed shape — `:entity-type :type-str :form-data`. `:entity-data` / `:parse-error` get merged onto this if the per-type parser runs."
   :parent :zipmap
   :args {:keys [{:value :entity-type} {:value :type-str} {:value :form-data}]
          :vals [{:parent :get
                  :args {:coll :_create-extracted :key {:value :entity-type} :default nil}}
                 {:parent :get
                  :args {:coll :_create-extracted :key {:value :type-str} :default nil}}
                 :_create-form-data]}}

  ;; --- Per-type dispatch as a :cond chain. Lazy — only the matching
  ;; parser runs per request. Each clause's body captures the cond's
  ;; shared :form-data binding.
  {:name :_create-entity-data-by-type
   :description "Dispatch to the per-type parser based on `:type-str`. Mirrors the legacy `case`-style dispatch."
   :parent :cond
   :args {:clauses [{:parent :equal? :args {:a {:as :type-str} :b {:value "fn"}}}
                    {:parent :parse-fn-from-form :args {:form-data {:as :form-data}}}
                    {:parent :equal? :args {:a {:as :type-str} :b {:value "ns"}}}
                    {:parent :parse-ns-from-form :args {:form-data {:as :form-data}}}
                    {:parent :equal? :args {:a {:as :type-str} :b {:value "slot"}}}
                    {:parent :parse-slot-from-form :args {:form-data {:as :form-data}}}
                    {:parent :equal? :args {:a {:as :type-str} :b {:value "fn-slot"}}}
                    {:parent :parse-fn-slot-from-form :args {:form-data {:as :form-data}}}
                    {:parent :equal? :args {:a {:as :type-str} :b {:value "binding"}}}
                    {:parent :parse-binding-from-form :args {:form-data {:as :form-data}}}
                    {:parent :equal? :args {:a {:as :type-str} :b {:value "binding-list-item"}}}
                    {:parent :parse-binding-list-item-from-form :args {:form-data {:as :form-data}}}
                    {:parent :equal? :args {:a {:as :type-str} :b {:value "service"}}}
                    {:parent :parse-service-from-form :args {:form-data {:as :form-data}}}
                    {:value true}
                    {:value nil}]}}

  ;; --- :try-wrapped per-type call. On success returns the parsed
  ;; entity-data; on throw, returns `{:parse-error <message>}` for
  ;; downstream merge.

  {:name :_create-entity-data-attempt
   :description "0-arg `:try` body — invokes the per-type dispatch. Captures the cond shared-args (`:form-data`, `:type-str`) for inner clauses."
   :parent :_create-entity-data-by-type
   :args {:form-data {:as :form-data}
          :type-str {:as :type-str}}}

  {:name :_create-parse-error-shape
   :description "`:try` on-throw branch — surfaces the exception message as `:parse-error` text."
   :parent :zipmap
   :args {:keys [{:value :parse-error}]
          :vals [{:parent :throwable-message :args {:ex {:as :exception}}}]}}

  {:name :_create-entity-data-or-error
   :description "Per-type parse attempt wrapped in `:try`. Success → entity-data map; throw → `{:parse-error msg}`."
   :parent :try
   :args {:body :_create-entity-data-attempt
          :on-throw :_create-parse-error-shape
          :form-data :_create-form-data
          :type-str {:parent :get :args {:coll :_create-extracted :key {:value :type-str} :default nil}}}}

  ;; --- Merge layers: on success → `{base + :entity-data <result>}`;
  ;; on throw → `{base + :parse-error <message>}`; when entity-type or
  ;; form-data missing → just `base`.

  {:name :_create-can-dispatch?
   :description "Only run the per-type parser when both entity-type AND form-data are present."
   :parent :and
   :args {:values [{:parent :some?
                    :args {:value {:parent :get
                                   :args {:coll :_create-extracted
                                          :key {:value :entity-type}
                                          :default nil}}}}
                   {:parent :some? :args {:value :_create-form-data}}]}}

  {:name :_create-dispatched-merge
   :description "When :try succeeded, `:_create-entity-data-or-error` is the entity-data map; merge under `:entity-data`. When :try caught, it's `{:parse-error msg}` — `:merge` adds that key directly."
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll :_create-entity-data-or-error
                        :key {:value :parse-error}}}
          :then {:parent :merge
                 :args {:maps [:_create-base :_create-entity-data-or-error]}}
          :else {:parent :merge
                 :args {:maps [:_create-base
                               {:parent :zipmap
                                :args {:keys [{:value :entity-data}]
                                       :vals [:_create-entity-data-or-error]}}]}}}}

  {:name :_create-parsed
   :description "Stage 1 of create — URI entity-type + form-decoded body routed through the per-type parser. `{:entity-type :type-str :form-data :entity-data :parse-error}`."
   :parent :if
   :args {:test :_create-can-dispatch?
          :then :_create-dispatched-merge
          :else :_create-base}
   :return-type :_create-parsed-shape}

  ;; --- C22: stage 2 of create as a graph `:cond`.
  ;; Same shape as C19/C20/C21 but with eight guards covering every
  ;; entity-type create can land on (ns / fn / slot / fn-slot / binding
  ;; / binding-list-item / service). Each `:_create-…-rej` base-fn
  ;; returns `{:reason …}` on rejection or nil; the matching `…-rej?`
  ;; fn-def is just `:some?` over that. The `:cond` short-circuits, so
  ;; only the work for the FIRST firing guard runs (call-cache means
  ;; even a guard whose result feeds both predicate and result lane
  ;; computes once). ---

  ;; --- Guards 1–3 (Variant-2). Pure §3.1c removals: each was a thin
  ;; defbase wrapping a Clojure helper that returned a `{:reason …}`
  ;; map or nil. Now graph-composed with no new base-fns — `:if`
  ;; over a `:nil?` / `:some?` predicate + `:zipmap` reason envelope.
  ;; The `:_*-rej?` predicates stay as `:some?` over the graph result
  ;; for cond-readability; result-cache dedupes the underlying eval.

  {:name :_create-parsed-entity-type
   :parent :get
   :args {:coll {:as :parsed} :key {:value :entity-type} :default nil}}

  {:name :_create-parsed-type-str
   :parent :get
   :args {:coll {:as :parsed} :key {:value :type-str} :default nil}}

  {:name :_create-parsed-form-data
   :parent :get
   :args {:coll {:as :parsed} :key {:value :form-data} :default nil}}

  {:name :_create-parsed-parse-error
   :parent :get
   :args {:coll {:as :parsed} :key {:value :parse-error} :default nil}}

  ;; --- Guard 1: unknown entity type
  {:name :_create-entity-type-nil?
   :parent :nil?
   :args {:value :_create-parsed-entity-type}}

  {:name :_create-entity-type-suffix
   :description "': <type-str>' when the URI segment was supplied, else empty string. Lets the rejection cite the offending segment without leaking the literal `nil`."
   :parent :if
   :args {:test {:parent :some? :args {:value :_create-parsed-type-str}}
          :then {:parent :str
                 :args {:parts [{:value ": "} :_create-parsed-type-str]}}
          :else {:value ""}}}

  {:name :_create-entity-type-reason
   :parent :str
   :args {:parts [{:value "Unknown entity type"} :_create-entity-type-suffix]}}

  {:name :_create-entity-type-rej-data
   :parent :zipmap
   :args {:keys [{:value :reason}] :vals [:_create-entity-type-reason]}}

  {:name :_create-entity-type-rej
   :description "Guard 1 — URI segment didn't resolve to a known entity type. `{:reason \"Unknown entity type[: <segment>]\"}` or nil."
   :parent :if
   :args {:test :_create-entity-type-nil?
          :then :_create-entity-type-rej-data
          :else nil}}

  {:name :_create-entity-type-rej?
   :description "True when guard 1 fired (`:some?` over `:_create-entity-type-rej`)."
   :parent :some?
   :args {:value :_create-entity-type-rej}}

  ;; --- Guard 2: empty / non-form body. `:empty?` catches both
  ;; the truly missing case (form-data = nil — no body / wrong
  ;; content-type) AND the empty-map case (form-data = `{}` —
  ;; legacy `:nil?` guard let an empty body through and let the
  ;; downstream apply create entities with zero fields).
  {:name :_create-form-data-empty?
   :parent :empty?
   :args {:coll :_create-parsed-form-data}}

  {:name :_create-form-data-rej-data
   :parent :const
   :args {:value {:reason "Request body is empty (expected url-encoded form fields)"}}}

  {:name :_create-form-data-rej
   :description "Guard 2 — request body wasn't url-encoded form data (missing OR empty). Static reason."
   :parent :if
   :args {:test :_create-form-data-empty?
          :then :_create-form-data-rej-data
          :else nil}}

  {:name :_create-form-data-rej?
   :description "True when guard 2 fired."
   :parent :some?
   :args {:value :_create-form-data-rej}}

  ;; --- Guard 3: per-type parser surfaced a 400-grade error
  {:name :_create-parse-error-some?
   :parent :some?
   :args {:value :_create-parsed-parse-error}}

  {:name :_create-parse-error-rej-data
   :description "Passes the parser message verbatim as `:reason`."
   :parent :zipmap
   :args {:keys [{:value :reason}] :vals [:_create-parsed-parse-error]}}

  {:name :_create-parse-error-rej
   :description "Guard 3 — per-type parser surfaced a 400-grade error (bad UUID / malformed JSON / etc.). Reason is the parser message verbatim."
   :parent :if
   :args {:test :_create-parse-error-some?
          :then :_create-parse-error-rej-data
          :else nil}}

  {:name :_create-parse-error-rej?
   :description "True when guard 3 fired."
   :parent :some?
   :args {:value :_create-parse-error-rej}}

  ;; --- Guard 4 (Variant-2): `:fn-slot` creates only — a composed fn
  ;; can only own slots that rename an inherited one. Pure graph
  ;; composition over `:get-entity` (the existing read-by-id+type
  ;; primitive). The DB reads are gated behind a lazy `:and` so that
  ;; non-fn-slot creates short-circuit before any storage hit.

  {:name :_create-fn-slot-fn-id
   :parent :get
   :args {:coll :_create-entity-data :key {:value :fn-id} :default nil}}

  {:name :_create-fn-slot-slot-id
   :parent :get
   :args {:coll :_create-entity-data :key {:value :slot-id} :default nil}}

  {:name :_create-fn-slot-fn-row
   :description "Owner fn row (the fn being given a slot). Read lazily — `:_create-fn-slot-rename-fires?`'s outer `:and` short-circuits non-fn-slot creates before this evaluates."
   :parent :get-entity
   :return-type [:union :null :fn-row-shape]
   :args {:entity-type {:value "fn"} :id :_create-fn-slot-fn-id}}

  {:name :_create-fn-slot-slot-row
   :description "Slot row being attached. Read lazily — see `:_create-fn-slot-fn-row`."
   :parent :get-entity
   :return-type [:union :null :slot-row-shape]
   :args {:entity-type {:value "slot"} :id :_create-fn-slot-slot-id}}

  {:name :_create-fn-slot-fn-row-name
   :parent :get
   :args {:coll :_create-fn-slot-fn-row :key {:value :name} :default nil}}

  {:name :_create-fn-slot-fn-row-parent-ids
   :parent :get
   :args {:coll :_create-fn-slot-fn-row :key {:value :parent-ids} :default nil}}

  {:name :_create-fn-slot-slot-row-source-slot-id
   :parent :get
   :args {:coll :_create-fn-slot-slot-row :key {:value :source-slot-id} :default nil}}

  {:name :_create-fn-slot-is-fn-slot-create?
   :description "Lazy short-circuit guard — only fire DB reads + checks when this is actually a `:fn-slot` create."
   :parent :and
   :args {:values [{:parent :some? :args {:value :_create-entity-data}}
                   {:parent :equal? :args {:a :_create-parsed-type-str :b {:value "fn-slot"}}}]}}

  {:name :_create-fn-slot-violation?
   :description "Both rows resolved AND the fn is composed AND the slot isn't a rename. Each clause is lazy via `:and`."
   :parent :and
   :args {:values [{:parent :some? :args {:value :_create-fn-slot-fn-row}}
                   {:parent :some? :args {:value :_create-fn-slot-slot-row}}
                   {:parent :not :args {:value {:parent :empty? :args {:coll :_create-fn-slot-fn-row-parent-ids}}}}
                   {:parent :nil? :args {:value :_create-fn-slot-slot-row-source-slot-id}}]}}

  {:name :_create-fn-slot-rename-fires?
   :parent :and
   :args {:values [:_create-fn-slot-is-fn-slot-create?
                   :_create-fn-slot-violation?]}}

  {:name :_create-fn-slot-rename-reason
   :description "`Composed fn \":foo\" can only own slots that rename an inherited slot ...`"
   :parent :str
   :args {:parts [{:value "Composed fn "}
                  {:parent :pr-str :args {:value :_create-fn-slot-fn-row-name}}
                  {:value " can only own slots that rename an inherited slot (set :source-slot-id). To add a new arg create a new fn-def with this one as parent."}]}}

  {:name :_create-fn-slot-rename-rej-data
   :parent :zipmap
   :args {:keys [{:value :reason}] :vals [:_create-fn-slot-rename-reason]}}

  {:name :_create-fn-slot-rename-rej
   :description "Guard 4 (fn-slot creates only) — a composed fn (`parent-ids` non-empty) may only own a slot that renames an inherited one (`:source-slot-id` set). Direct HTTP-CRUD requests are the only path that lands here; internal flows bypass via `sp/create-entity`."
   :parent :if
   :args {:test :_create-fn-slot-rename-fires?
          :then :_create-fn-slot-rename-rej-data
          :else nil}}

  {:name :_create-fn-slot-rename-rej?
   :description "True when guard 4 fired."
   :parent :some?
   :args {:value :_create-fn-slot-rename-rej}}

  ;; --- Guard 5 (Variant-2): `:service` creates only — refuse if the
  ;; target fn has any free-arg slot. Pure graph composition over the
  ;; new `:free-arg-slot-map` primitive; admins can vary the
  ;; "permissive" / "strict" definition by composing a different free-
  ;; arg-filter at the graph layer (e.g. allow optional slots).

  {:name :_create-entity-data
   :parent :get
   :args {:coll {:as :parsed} :key {:value :entity-data} :default nil}}

  {:name :_create-svc-fn-id
   :description "`:fn-id` from the create payload (only meaningful for service creates)."
   :parent :get
   :args {:coll :_create-entity-data :key {:value :fn-id} :default nil}}

  {:name :_create-is-service-create?
   :description "True iff this request creates a `:service` row AND carries a target `:fn-id`."
   :parent :and
   :args {:values [{:parent :some? :args {:value :_create-entity-data}}
                   {:parent :equal? :args {:a :_create-parsed-type-str :b {:value "service"}}}
                   {:parent :some? :args {:value :_create-svc-fn-id}}]}}

  {:name :_create-svc-free-args
   :description "`{name → slot-id}` of the target fn's free args. `{}` when fn-id missing."
   :parent :free-arg-slot-map
   :args {:fn-id :_create-svc-fn-id}}

  {:name :_create-svc-free-keys
   :parent :keys
   :args {:map :_create-svc-free-args}}

  {:name :_create-svc-has-free-args?
   :description "True iff the target fn has at least one free-arg slot."
   :parent :not
   :args {:value {:parent :empty? :args {:coll :_create-svc-free-keys}}}}

  {:name :_create-svc-free-args-fires?
   :parent :and
   :args {:values [:_create-is-service-create? :_create-svc-has-free-args?]}}

  {:name :_create-svc-free-args-reason
   :description "`Cannot make a :service for a fn that has free args: [:foo :bar]. Create a derived fn-def...`"
   :parent :str
   :args {:parts [{:value "Cannot make a :service for a fn that has free args: "}
                  {:parent :vec :args {:coll :_create-svc-free-keys}}
                  {:value ". Create a derived fn-def that binds them, then declare a :service for the derived fn."}]}}

  {:name :_create-service-free-args-rej-data
   :parent :zipmap
   :args {:keys [{:value :reason}] :vals [:_create-svc-free-args-reason]}}

  {:name :_create-service-free-args-rej
   :description "Guard 5 (`:service` creates only) — refuse if the target fn has any free arg slot. The supervisor invokes the service with empty args; a free slot would crash at startup."
   :parent :if
   :args {:test :_create-svc-free-args-fires?
          :then :_create-service-free-args-rej-data
          :else nil}}

  {:name :_create-service-free-args-rej?
   :description "True when guard 5 fired."
   :parent :some?
   :args {:value :_create-service-free-args-rej}}

  ;; --- :chain-has-process-effect? — atomic graph-traversal primitive.
  ;; True iff `fn-id` or any ancestor declares the `:process` effect.
  ;; The BFS itself has cycle-tracking shared state (§3.3 carve-out)
  ;; and stays inside the Clojure primitive. False for nil fn-id.
  {:name :chain-has-process-effect?
   :description "True iff `fn-id` or any ancestor (via `parent-ids`) declares the `:process` effect in its rich-type entry. False for nil fn-id."
   :args {:fn-id {:type :nullable-uuid :description "Target fn-id; nil short-circuits to false."}}
   :return-type :bool
   :effects #{:db}}

  ;; --- Guard 6 (Variant-2): `:service` creates only — refuse if the
  ;; target fn doesn't declare the `:process` effect (directly or via
  ;; an ancestor). Pure graph composition over `:chain-has-process-
  ;; effect?` + `:get-entity` for the fn-name citation.

  {:name :_create-svc-no-proc-has-process?
   :description "Lazy DB lookup; gated by the outer `:and` so it only fires for `:service` creates."
   :parent :chain-has-process-effect?
   :args {:fn-id :_create-svc-fn-id}}

  {:name :_create-svc-no-proc-fires?
   :parent :and
   :args {:values [:_create-is-service-create?
                   {:parent :not :args {:value :_create-svc-no-proc-has-process?}}]}}

  ;; For the dynamic message we cite the fn's NAME, not the id.
  {:name :_create-svc-fn-row
   :description "Used solely for `(pr-str (:name fn-row))` in the rejection message; lazy via the outer `:if`'s short-circuit."
   :parent :get-entity
   :return-type [:union :null :fn-row-shape]
   :args {:entity-type {:value "fn"} :id :_create-svc-fn-id}}

  {:name :_create-svc-fn-row-name
   :parent :get
   :args {:coll :_create-svc-fn-row :key {:value :name} :default nil}}

  {:name :_create-svc-no-proc-reason
   :description "`Cannot make a :service for fn \":foo\" — neither it nor any ancestor declares the :process effect ...`"
   :parent :str
   :args {:parts [{:value "Cannot make a :service for fn "}
                  {:parent :pr-str :args {:value :_create-svc-fn-row-name}}
                  {:value " — neither it nor any ancestor declares the :process effect. :service is reserved for fns that spawn supervised background work (long-running listeners, scheduled loops, etc.). Either add `:effects #{:process …}` to the fn-def if it really does spawn a background process, or wrap a one-shot fn in :schedule to get cron-style execution."}]}}

  {:name :_create-service-no-process-rej-data
   :parent :zipmap
   :args {:keys [{:value :reason}] :vals [:_create-svc-no-proc-reason]}}

  {:name :_create-service-no-process-rej
   :description "Guard 6 (`:service` creates only) — `:service` is reserved for fns whose own (or any ancestor's) declared effects include `:process`. The chain walk lets composed fn-defs with a missing rich-type entry still pass when an ancestor declares the effect."
   :parent :if
   :args {:test :_create-svc-no-proc-fires?
          :then :_create-service-no-process-rej-data
          :else nil}}

  {:name :_create-service-no-process-rej?
   :description "True when guard 6 fired."
   :parent :some?
   :args {:value :_create-service-no-process-rej}}

  {:name :_create-write-rej
   :description "Guard 7 — generic cycle / MI / value-override / `:list-closed` write-time checks via `:write-rej`. Reuses the same primitive `:_update-validation` does. Server-only enforcement: editor pre-runs the cycle / MI subset, other API consumers don't."
   :parent :write-rej
   :args {:entity-type :_create-parsed-type-str
          :entity-data :_create-entity-data}}

  {:name :_create-write-rej?
   :description "True when guard 7 fired."
   :parent :some?
   :args {:value :_create-write-rej}}

  {:name :_create-is-binding-create?
   :description "Lazy gate — only fire `:type-check-binding-rej` for binding creates."
   :parent :and
   :args {:values [{:parent :some? :args {:value :_create-entity-data}}
                   {:parent :equal? :args {:a :_create-parsed-type-str :b {:value "binding"}}}]}}

  {:name :_create-binding-type-rej
   :description "Guard 8 (binding creates only) — save-time type-check for the binding's `:value`/`:ref`. The underlying `:type-check-binding-rej` primitive THROWS `ExceptionInfo` with structured `:data` on mismatch (executor surfaces it); returns nil otherwise. `:id` is nil on CREATE."
   :parent :if
   :args {:test :_create-is-binding-create?
          :then {:parent :type-check-binding-rej
                 :args {:entity-data :_create-entity-data
                        :id {:value nil}}}
          :else nil}}

  {:name :_create-binding-type-rej?
   :description "True when guard 8 fired (almost never — guard 8 prefers to throw)."
   :parent :some?
   :args {:value :_create-binding-type-rej}}

  {:name :_create-validation
   :description "Stage 2 of create — eight write-time guards wired as a flat `:cond`. Returns the rejection `{:reason …}` from the first matching guard, or `nil` (`{:value nil}` clause) when the create may proceed."
   :parent :cond
   :args {:clauses [:_create-entity-type-rej?        :_create-entity-type-rej
                    :_create-form-data-rej?          :_create-form-data-rej
                    :_create-parse-error-rej?        :_create-parse-error-rej
                    :_create-fn-slot-rename-rej?     :_create-fn-slot-rename-rej
                    :_create-service-free-args-rej?  :_create-service-free-args-rej
                    :_create-service-no-process-rej? :_create-service-no-process-rej
                    :_create-write-rej?              :_create-write-rej
                    :_create-binding-type-rej?       :_create-binding-type-rej
                    {:value true}                    {:value nil}]
          :parsed :_create-parsed}}

  ;; Phase 4.2 decomposition: success branch of POST /api/entities/:type
  ;; is now graph composition. The §3.3 transactional unit
  ;; (`sp/create-entity` + Phase-6c rename-slot + post-check + rollback)
  ;; lives inside the `:try-apply-create` primitive — its body and
  ;; rollback share a row-id that can't be split across graph nodes
  ;; without risking a stale-id read. Everything else — error
  ;; dispatch, invalidate, NOTIFY, response envelope — is composed
  ;; here.
  {:name :_create-apply
   :description "Stage 3 of create — atomic-create-with-rollback + invalidate + notify + 200, or 400 with the error message."
   :parent :if
   :args {:test :_create-apply-error?
          :then :_create-apply-err-response
          :else :_create-apply-success
          :result :_create-apply-result}}

  {:name :_create-apply-result
   :description "Outcome of the atomic create unit. `{:created <id>}` on success, `{:error <human-msg>}` on capability-rej / write-failure / post-check rejection (the rollback is internal)."
   :parent :try-apply-create
   :args {:entity-type :_create-apply-entity-type-str
          :entity-data :_create-apply-entity-data
          :type-str :_create-apply-type-str
          :form-data :_create-apply-form-data}}

  {:name :_create-apply-entity-type-str
   :parent :name
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :entity-type} :default nil}}}}

  {:name :_create-apply-entity-data
   :parent :get
   :args {:coll {:as :parsed} :key {:value :entity-data} :default nil}}

  {:name :_create-apply-type-str
   :parent :get
   :args {:coll {:as :parsed} :key {:value :type-str} :default nil}}

  {:name :_create-apply-form-data
   :parent :get
   :args {:coll {:as :parsed} :key {:value :form-data} :default nil}}

  {:name :_create-apply-error?
   :parent :some?
   :args {:value :_create-apply-error-msg}}

  {:name :_create-apply-error-msg
   :parent :get
   :args {:coll {:as :result} :key {:value :error} :default nil}}

  {:name :_create-apply-created-id
   :parent :get
   :args {:coll {:as :result} :key {:value :created} :default nil}}

  {:name :_create-apply-err-response
   :parent :html-error-response
   :args {:status {:value 400}
          :reason :_create-apply-error-msg}}

  ;; Success: invalidate cache → emit NOTIFY → 200 response. `:do :steps`
  ;; sequences the side effects left-to-right.
  {:name :_create-apply-success
   :parent :do
   :args {:steps [:_create-apply-do-invalidate
                  :_create-apply-do-notify
                  :_create-apply-ok-response]}}

  ;; Payload for invalidate / notify: the just-created id assoc'd back
  ;; into the original entity-data so seed-derivation sees the row's
  ;; FKs (binding-list-item needs `:binding-id`).
  {:name :_create-apply-success-payload
   :parent :assoc
   :args {:map :_create-apply-entity-data
          :key {:value :id}
          :value :_create-apply-created-id}}

  {:name :_create-apply-do-invalidate
   :parent :invalidate-after-write
   :args {:entity-type :_create-apply-entity-type-str
          :entity-data :_create-apply-success-payload}}

  {:name :_create-apply-do-notify
   :parent :notify-after-write
   :args {:entity-type :_create-apply-entity-type-str
          :op {:value "write"}
          :entity-data :_create-apply-success-payload}}

  {:name :_create-apply-ok-response
   :parent :const
   :args {:value {:status 200 :body "<p>Entity created successfully</p>"}}}

  ;; --- :_update-parsed (Variant-2). Mirrors :_create-parsed plus
  ;; (a) `:id-str` + `:id-uuid` from the URI, (b) `:pre-existing` row
  ;; pre-read (so validation can build the merged post-write view +
  ;; the response can name the affected row even when form-data omits
  ;; immutable FK fields).

  {:name :_update-id-str
   :parent :get
   :args {:coll :_create-extracted :key {:value :id-str} :default nil}}

  {:name :_update-id-uuid
   :parent :parse-uuid
   :args {:string :_update-id-str}}

  ;; Pre-existing row read — guarded by entity-type + id-uuid both
  ;; present. When entity-type is nil OR id-uuid didn't parse, return
  ;; nil without touching storage. Mirrors the legacy
  ;; `(when (and entity-type id-uuid) (try (sp/read-entity ...)))`.
  {:name :_update-pre-existing-fetched
   :description "Read the pre-existing row by type + id. Only executed under the `:_update-pre-existing` `:if`-guard that asserts both are non-nil, so the `:type` overrides on the bindings strip the nullable surface from `:_create-extracted.get` / `:parse-uuid` — without them the type-checker correctly rejects nullable values flowing into `:get-entity`'s strict slots. The return-type stays the unrefined `:nullable-keyword-map` from `:get-entity` — at this site the entity-type is dynamic (parsed from form body) so we can't pin a specific entity-shape alias without lying about non-`:fn` callers."
   :parent :get-entity
   :args {:entity-type {:parent :get
                        :type :text
                        :args {:coll :_create-extracted
                               :key {:value :type-str}
                               :default nil}}
          :id {:ref :_update-id-uuid :type :uuid}}}

  {:name :_update-pre-existing
   :description "Pre-read of the existing row when entity-type AND id-uuid are both resolved; nil otherwise. The return-type stays the unrefined `:nullable-keyword-map` because the entity-type is dynamic (parsed from request body) — see `:_update-pre-existing-fetched` for the same rationale."
   :parent :if
   :args {:test {:parent :and
                 :args {:values [{:parent :some?
                                  :args {:value {:parent :get
                                                 :args {:coll :_create-extracted
                                                        :key {:value :entity-type}
                                                        :default nil}}}}
                                 {:parent :some? :args {:value :_update-id-uuid}}]}}
          :then :_update-pre-existing-fetched
          :else nil}}

  ;; Update-side base — `:_create-base` extended with id-str, id-uuid,
  ;; pre-existing.
  {:name :_update-base
   :parent :zipmap
   :args {:keys [{:value :entity-type} {:value :type-str} {:value :id-str}
                 {:value :id-uuid} {:value :form-data} {:value :pre-existing}]
          :vals [{:parent :get
                  :args {:coll :_create-extracted :key {:value :entity-type} :default nil}}
                 {:parent :get
                  :args {:coll :_create-extracted :key {:value :type-str} :default nil}}
                 :_update-id-str
                 :_update-id-uuid
                 :_create-form-data
                 :_update-pre-existing]}}

  ;; Update dispatch gate — entity-type AND id-str AND form-data.
  {:name :_update-can-dispatch?
   :parent :and
   :args {:values [{:parent :some?
                    :args {:value {:parent :get
                                   :args {:coll :_create-extracted
                                          :key {:value :entity-type}
                                          :default nil}}}}
                   {:parent :some? :args {:value :_update-id-str}}
                   {:parent :some? :args {:value :_create-form-data}}]}}

  ;; Reuse the create-side per-type :try result. Same dispatch, same
  ;; parse-error shape.
  {:name :_update-dispatched-merge
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll :_create-entity-data-or-error
                        :key {:value :parse-error}}}
          :then {:parent :merge
                 :args {:maps [:_update-base :_create-entity-data-or-error]}}
          :else {:parent :merge
                 :args {:maps [:_update-base
                               {:parent :zipmap
                                :args {:keys [{:value :entity-data}]
                                       :vals [:_create-entity-data-or-error]}}]}}}}

  {:name :_update-parsed
   :description "Stage 1 of update — like `:_create-parsed` plus the `:id` segment and a pre-read of the existing row."
   :parent :if
   :args {:test :_update-can-dispatch?
          :then :_update-dispatched-merge
          :else :_update-base}
   :return-type :_update-parsed-shape}

  ;; --- :write-rej / :type-check-binding-rej — atomic §3.1 boundaries
  ;; over the §3.3 validators. Used by both create + update chains so
  ;; both `:_create-write-rej` / `:_create-binding-type-rej` and the
  ;; per-guard graph fn-defs below can reach the same algorithm
  ;; without each call site re-implementing the cycle / MI / type-check
  ;; logic at the graph layer.
  {:name :write-rej
   :description "Stage-2 write-time validation for create/update flows. Returns `{:reason …}` rejection or nil."
   :args {:entity-type {:type :text :description "Canonical entity-name as text (`fn`, `slot`, `binding`, …)."}
          :entity-data {:type :nullable-keyword-map :description "Entity row to validate (the merged post-write view on update). Nullable at type level; validation upstream guarantees non-null at runtime."}}
   :return-type :_rejection-shape
   :effects #{:db}}

  {:name :type-check-binding-rej
   :description "Stage-2 type-check for `:binding` flows. nil on success. Throws structured ExceptionInfo on mismatch (the executor surfaces the throw with `:data` intact)."
   :args {:entity-data {:type :nullable-keyword-map :description "Binding row to type-check. Nullable at type level."}
          :id {:type :nullable-uuid :description "Existing binding id (UPDATE) or nil (CREATE)."}}
   :return-type :_rejection-shape
   :effects #{:db}}

  ;; --- Stage 2 of update (Variant-2). Was defbase delegating to a
  ;; since-removed `validate-update` helper which ran a 4-guard `cond`
  ;; then `or`'d `write-rej` and `type-check-binding-rej` against the
  ;; merged post-write view. Now graph-composed as a `:cond` whose first three
  ;; guards REUSE the create-side rej-builders (`_create-entity-type-
  ;; rej`/`-form-data-rej`/`-parse-error-rej`) since both `_create-
  ;; parsed-shape` and `_update-parsed-shape` carry the same
  ;; `:entity-type` / `:type-str` / `:form-data` / `:parse-error`
  ;; fields. A new `:_update-id-str-nil?` guard handles the URI-id-
  ;; required case unique to update.
  ;;
  ;; The `:else` branch builds the merged-data (pre-existing +
  ;; entity-data + {:id id-uuid}) and runs write-rej; if write-rej is
  ;; nil and this is a binding update, type-check-binding-rej runs.
  ;; `:if`-gated so non-binding updates skip the type-check.

  {:name :_update-parsed-entity-data
   :parent :get
   :args {:coll {:as :parsed} :key {:value :entity-data} :default nil}}

  {:name :_update-parsed-id-str
   :parent :get
   :args {:coll {:as :parsed} :key {:value :id-str} :default nil}}

  {:name :_update-parsed-id-uuid
   :parent :get
   :args {:coll {:as :parsed} :key {:value :id-uuid} :default nil}}

  {:name :_update-parsed-pre-existing
   :parent :get
   :args {:coll {:as :parsed} :key {:value :pre-existing} :default nil}}

  ;; --- Guard: id-str missing in the URI.
  {:name :_update-id-str-nil?
   :parent :nil?
   :args {:value :_update-parsed-id-str}}

  {:name :_update-err-id-required
   :parent :const
   :args {:value {:reason "Missing entity id in URI"}}}

  ;; --- :else branch — merged-data → write-rej → optional binding-type-rej.
  {:name :_update-id-as-map
   :description "`{:id <id-uuid>}` fragment to inject into the merged view so write-time validators see the canonical id."
   :parent :zipmap
   :args {:keys [{:value :id}] :vals [:_update-parsed-id-uuid]}}

  {:name :_update-merged-data
   :description "`(merge pre-existing entity-data {:id id-uuid})` — the post-write picture that write-time validators check."
   :parent :merge
   :args {:maps [:_update-parsed-pre-existing
                 :_update-parsed-entity-data
                 :_update-id-as-map]}}

  {:name :_update-write-rej-result
   :description "Generic write-time check against the merged view. nil when entity-data was empty (no actual update)."
   :parent :if
   :args {:test {:parent :some? :args {:value :_update-parsed-entity-data}}
          :then {:parent :write-rej
                 :args {:entity-type :_create-parsed-type-str
                        :entity-data :_update-merged-data}}
          :else nil}}

  {:name :_update-is-binding-update?
   :description "Lazy gate — only fire `:type-check-binding-rej` for binding updates with a resolved id."
   :parent :and
   :args {:values [{:parent :some? :args {:value :_update-parsed-entity-data}}
                   {:parent :equal? :args {:a :_create-parsed-type-str :b {:value "binding"}}}
                   {:parent :some? :args {:value :_update-parsed-id-uuid}}]}}

  {:name :_update-binding-type-rej-result
   :description "Binding-specific type-check; throws on mismatch (executor surfaces structured ExceptionInfo). Gated on binding-update-with-id."
   :parent :if
   :args {:test :_update-is-binding-update?
          :then {:parent :type-check-binding-rej
                 :args {:entity-data :_update-parsed-entity-data
                        :id :_update-parsed-id-uuid}}
          :else nil}}

  {:name :_update-validation-tail
   :description "Combine write-rej and binding-type-rej: first non-nil wins (mirrors Clojure's `(or write-rej binding-type-rej)`). `:coalesce` is eager but the binding-type-rej path is itself `:if`-gated so non-binding updates collapse to nil cheaply."
   :parent :coalesce
   :args {:value :_update-write-rej-result
          :default :_update-binding-type-rej-result}}

  {:name :_update-validation
   :description "Stage 2 of update — `:cond` over the 4 simple guards (3 of which reuse the create-side rej-builders) then a tail `:coalesce` of write-rej and (when applicable) binding-type-rej. Returns the first rejection `{:reason …}` or nil."
   :parent :cond
   :args {:clauses [:_create-entity-type-rej?        :_create-entity-type-rej
                    :_update-id-str-nil?             :_update-err-id-required
                    :_create-form-data-rej?          :_create-form-data-rej
                    :_create-parse-error-rej?        :_create-parse-error-rej
                    {:value true}                    :_update-validation-tail]
          :parsed :_update-parsed}}

  ;; Phase 4.2 decomposition: success branch of PUT /api/entities/:type/:id
  ;; is now graph composition. `:try-apply-update` is the atomic
  ;; write unit (sp/update-entity + Phase-6c rename-slot). Update has
  ;; no post-write type-check + rollback so the primitive is §3.1
  ;; (not §3.3 like create).
  {:name :_update-apply
   :description "Stage 3 of update — atomic update + invalidate + notify + 200, or 400 with the error message."
   :parent :if
   :args {:test :_update-apply-error?
          :then :_update-apply-err-response
          :else :_update-apply-success
          :result :_update-apply-result}}

  {:name :_update-apply-result
   :description "Outcome of the atomic update unit. `{:updated <id>}` on success, `{:error <msg>}` on write failure."
   :parent :try-apply-update
   :args {:entity-type :_update-apply-entity-type-str
          :id-uuid :_update-apply-id-uuid
          :entity-data :_update-apply-entity-data
          :type-str :_update-apply-type-str
          :form-data :_update-apply-form-data}}

  {:name :_update-apply-entity-type-str
   :parent :name
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :entity-type} :default nil}}}}

  {:name :_update-apply-id-uuid
   :parent :get
   :args {:coll {:as :parsed} :key {:value :id-uuid} :default nil}}

  {:name :_update-apply-entity-data
   :parent :get
   :args {:coll {:as :parsed} :key {:value :entity-data} :default nil}}

  {:name :_update-apply-type-str
   :parent :get
   :args {:coll {:as :parsed} :key {:value :type-str} :default nil}}

  {:name :_update-apply-form-data
   :parent :get
   :args {:coll {:as :parsed} :key {:value :form-data} :default nil}}

  {:name :_update-apply-pre-existing
   :parent :get
   :args {:coll {:as :parsed} :key {:value :pre-existing} :default nil}}

  {:name :_update-apply-error?
   :parent :some?
   :args {:value :_update-apply-error-msg}}

  {:name :_update-apply-error-msg
   :parent :get
   :args {:coll {:as :result} :key {:value :error} :default nil}}

  {:name :_update-apply-err-response
   :parent :html-error-response
   :args {:status {:value 400}
          :reason :_update-apply-error-msg}}

  {:name :_update-apply-success
   :parent :do
   :args {:steps [:_update-apply-do-invalidate
                  :_update-apply-do-notify
                  :_update-apply-ok-response]}}

  ;; Invalidate / notify payload: pre-existing row merged with entity-data
  ;; merged with `{:id id-uuid}`. Matches legacy `(merge pre-existing
  ;; entity-data {:id id-uuid})` so seed-derivation sees both the
  ;; pre-update FKs and any updated FKs.
  {:name :_update-apply-success-payload
   :parent :merge
   :args {:maps [:_update-apply-pre-existing
                 :_update-apply-entity-data
                 :_update-apply-success-id-only]}}

  {:name :_update-apply-success-id-only
   :parent :zipmap
   :args {:keys [{:value :id}]
          :vals [:_update-apply-id-uuid]}}

  {:name :_update-apply-do-invalidate
   :parent :invalidate-after-write
   :args {:entity-type :_update-apply-entity-type-str
          :entity-data :_update-apply-success-payload}}

  {:name :_update-apply-do-notify
   :parent :notify-after-write
   :args {:entity-type :_update-apply-entity-type-str
          :op {:value "write"}
          :entity-data :_update-apply-success-payload}}

  {:name :_update-apply-ok-response
   :parent :const
   :args {:value {:status 200 :body "<p>Entity updated successfully</p>"}}}

  {:name :_rejected?
   :description "True when a `validate-*` stage produced a rejection. `:some? :validation`."
   :parent :some?
   :args {:value {:as :validation}}}

  ;; --- C25: `:_rejection-response` was a `defbase` whose body was
  ;; literally `{:status 400 :body (str "<p class=\"error\">"
  ;; (:reason validation) "</p>")}`. Pure composition: `:get` + `:str`
  ;; + `:assoc`. Now expressed in the graph so a user wanting a
  ;; different status, different HTML wrapper, JSON body, etc. can
  ;; vary it by composing differently without admin help. ---

  {:name :_rejection-reason
   :description "Pull the `:reason` text out of a `validate-*` rejection map."
   :parent :get
   :args {:coll {:as :validation :type :_rejection-shape
                 :description "The `{:reason …}` rejection map."}
          :key {:value :reason}}}

  {:name :_rejection-response-body
   :description "Wrap the rejection reason in a `<p class=\"error\">` paragraph — the HTML body of the 400."
   :parent :str
   :args {:parts [{:value "<p class=\"error\">"}
                  :_rejection-reason
                  {:value "</p>"}]}}

  {:name :_rejection-response
   :description "Render a `validate-*` rejection as a 400 partial Ring response. Pure graph composition over `:assoc` + `:str` + `:get` — the free arg `:validation` propagates up from `:_rejection-reason`."
   :parent :assoc
   :args {:map {:value {:status 400}}
          :key {:value :body}
          :value :_rejection-response-body}
   :return-type :_partial-response-shape}

  ;; --- :html-error-response — reusable Ring-response builder with
  ;; canonical `<p class=\"error\">…</p>` body. Free args: `:status`
  ;; (any 4xx/5xx int) and `:reason` (text). Descendants with
  ;; `:reason {:as :their-shared-arg}` get the env-translation via
  ;; `build-ref-renames` — now traverses ref-target chains so the
  ;; rename whose source lives on `:_html-error-body` (reached via
  ;; `:html-error-response.value` ref) is picked up correctly. See
  ;; `compile/renames.clj :: build-ref-renames` and
  ;; `feedback_capture_through_parent_chain.md`.

  {:name :_html-error-body
   :description "Wrap `:reason` in `<p class=\"error\">…</p>` for the response body."
   :parent :str
   :args {:parts [{:value "<p class=\"error\">"}
                  {:as :reason :type :text :description "Human-readable error reason for the 4xx/5xx response body."}
                  {:value "</p>"}]}}

  {:name :html-error-response
   :description "Build a Ring partial response with `<p class=\"error\">…</p>` body and `text/html; charset=utf-8` content-type. Owns `:status` and `:reason` as explicit free pins — concrete error responses inherit them via parent-ids and bind them to specific values."
   :parent :assoc
   :args {:map {:parent :zipmap
                :args {:keys [{:value :status} {:value :headers}]
                       :vals [{:as :status :type :int :description "HTTP status code (e.g. 400, 409, 500)."}
                              {:value {"Content-Type" "text/html; charset=utf-8"}}]}}
          :key {:value :body}
          :value :_html-error-body
          :status {:type :int
                   :description "HTTP status code (e.g. 400, 409, 500). Flows into the response's `:status` field."}
          :reason {:type :text
                   :description "Human-readable failure reason — rendered inside the `<p class=\"error\">…</p>` body."}}
   :return-type {:status :int :headers :text-map :body :text}}

  ;; --- delete-entity primitives (C5 decomposition). The handler
  ;; itself is the `:process-delete-entity` `:cond` graph fn-def below.
  ;; Four rejection paths with mixed static / dynamic-reason 409s, plus
  ;; the success path. The two dynamic-reason 409s share their reason
  ;; via a separate "compute reason once" base-fn fed into BOTH the
  ;; predicate and the error-builder.
  ;; --- :extract-entity-params — atomic boundary. Pulls
  ;; `{:type-str :id-str :entity-type}` from a Ring request with
  ;; reitit `:path-params` preferred over URI parsing.
  {:name :extract-entity-params
   :description "Pull `{:type-str :id-str :entity-type}` from a Ring request — reitit `:path-params` preferred, URI fallback for the http-kit passthrough path."
   :args {:request {:type :ring-request-shape}}
   :return-type {:type-str :nullable-text :id-str :nullable-text :entity-type :nullable-keyword}}

  ;; --- :query-param — atomic boundary. Pulls a named query-string
  ;; parameter from a Ring request; tolerates both reitit-enriched
  ;; `:query-params` (string OR keyword keys) AND raw `:query-string`.
  {:name :query-param
   :description "Read a named query-string parameter from a Ring request. Returns nil when absent."
   :args {:request {:type :ring-request-shape}
          :param-name {:type :text :description "Parameter name (e.g. `\"fn-id\"`)."}}
   :return-type :nullable-text}

  ;; --- :_delete-parsed (Variant-2). Was defbase delegating to a
  ;; since-removed `parse-delete-entity-request` helper. Now graph
  ;; composition:
  ;; `:extract-entity-params` + `:parse-uuid` of the id-str + `:zipmap`
  ;; envelope. `:parse-uuid` already swallows bad UUIDs to nil, so the
  ;; legacy `try/catch` collapse is no longer needed.
  {:name :_delete-parsed-extracted
   :parent :extract-entity-params
   :args {:request {:as :request}}}

  {:name :_delete-parsed
   :description "Parse `DELETE /api/entities/:type/:id` into `{:entity-type <kw|nil> :id <uuid|nil>}`."
   :parent :zipmap
   :args {:keys [{:value :entity-type} {:value :id}]
          :vals [{:parent :get
                  :args {:coll :_delete-parsed-extracted
                         :key {:value :entity-type}
                         :default nil}}
                 {:parent :parse-uuid
                  :args {:string {:parent :get
                                  :args {:coll :_delete-parsed-extracted
                                         :key {:value :id-str}
                                         :default nil}}}}]}
   :return-type :_delete-parsed-shape}

  {:name :_delete-request-invalid?
   :description "Guard #1 — entity-type or id is missing / malformed in the URL. `:or [nil? :entity-type] [nil? :id]`."
   :parent :or
   :args {:values [{:parent :nil? :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :entity-type} :default nil}}}}
                   {:parent :nil? :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :id} :default nil}}}}]}}

  ;; Phase 4 decomposition: the secret-shape guard is now a graph
  ;; composition. Three parts:
  ;;   1. entity-type = :fn AND id present (cheap gate)
  ;;   2. resolve the target fn row by id
  ;;   3. compare its `:parent-ids` against `[<secret-leaf-fn-id>]`
  ;; The secret-leaf id is discovered via `:fn-names-with-tag` so
  ;; admins can swap which tag carries "secret-shape" by editing
  ;; `web/vault/fns.edn`'s `:tags` declaration — no Clojure rebuild.
  {:name :_delete-fn-is-secret?
   :description "Guard #2 — the targeted entity is a secret-shaped fn-def (`:vault-get` / `:secret-leaf`). Bounce to `DELETE /api/secrets/:fn-id` so OpenBao stays in sync."
   :parent :and
   :args {:values [:_delete-target-is-fn?
                   :_delete-target-id-present?
                   :_delete-target-has-secret-shape?]}}

  {:name :_delete-target-entity-type
   :parent :get
   :args {:coll {:as :parsed} :key {:value :entity-type} :default nil}}

  {:name :_delete-target-id
   :parent :get
   :args {:coll {:as :parsed} :key {:value :id} :default nil}}

  {:name :_delete-target-is-fn?
   :parent :equal?
   :args {:a :_delete-target-entity-type :b {:value :fn}}}

  {:name :_delete-target-id-present?
   :parent :some?
   :args {:value :_delete-target-id}}

  {:name :_delete-target-fn-row
   :parent :get-entity
   :return-type [:union :null :fn-row-shape]
   :args {:entity-type {:value "fn"} :id :_delete-target-id}}

  {:name :_delete-target-parent-ids
   :parent :get
   :args {:coll :_delete-target-fn-row :key {:value :parent-ids} :default nil}}

  {:name :_delete-target-has-secret-shape?
   :description "True iff `parent-ids` is exactly `[<secret-leaf-fn-id>]` — pure secret, no MI siblings."
   :parent :equal?
   :args {:a :_delete-target-parent-ids
          :b :_delete-secret-leaf-parent-vec}}

  ;; Secret-leaf id discovered via `:fn-names-with-tag` so changing
  ;; the "secret-shape" tag declaration in `web/vault/fns.edn` flows
  ;; through here automatically.
  {:name :_delete-secret-leaf-names
   :parent :fn-names-with-tag
   :args {:tag {:value "secret-shape"}}}

  {:name :_delete-secret-leaf-name
   :parent :first :args {:coll :_delete-secret-leaf-names}}

  {:name :_delete-secret-leaf-rows
   :parent :resolve-fn-rows
   :args {:identities :_delete-secret-leaf-identities
          :branch-chain :current-branch-chain}}

  {:name :_delete-secret-leaf-identities
   :parent :storage-query-identities
   :args {:entity-type {:value "fn"} :where {:value {}}}}

  {:name :_delete-secret-leaf-filtered
   :parent :filter
   :args {:pred :_delete-secret-leaf-name-eq?
          :coll :_delete-secret-leaf-rows}}

  {:name :_delete-secret-leaf-name-eq?
   :parent :equal?
   :args {:a {:parent :get :args {:coll {:as :item} :key {:value :name} :default nil}}
          :b :_delete-secret-leaf-name}}

  {:name :_delete-secret-leaf-row
   :parent :first :args {:coll :_delete-secret-leaf-filtered}}

  {:name :_delete-secret-leaf-id
   :parent :get :args {:coll :_delete-secret-leaf-row :key {:value :id} :default nil}}

  {:name :_delete-secret-leaf-parent-vec
   :description "Single-element vec `[<secret-leaf-id>]` used as the comparison target for `:parent-ids`. nil id ⇒ `[nil]` which never matches a real `:parent-ids` row."
   :parent :vec
   :args {:coll [:_delete-secret-leaf-id]}}

  ;; Phase 4 decomposition: in-use reason is now graph composition
  ;; over three storage queries. Counts:
  ;;   - parent-owners — fns whose `:parent-ids` ref the target
  ;;   - ref-bindings  — bindings whose `:ref-fn-id` is the target
  ;;   - ref-items     — binding-list-items whose `:ref-fn-id` is the target
  ;; …then renders the same human-readable message the legacy defbase
  ;; produced (so the UI's 409 toast text doesn't shift).
  {:name :_delete-fn-in-use-reason
   :description "Compute the human-readable reason when a fn-def delete is rejected for being referenced; nil otherwise. Shared by the predicate + the dynamic-reason error builder."
   :parent :if
   :args {:test :_delete-fn-in-use-gate?
          :then :_delete-fn-in-use-conditional-message
          :else {:value nil}}}

  {:name :_delete-fn-in-use-gate?
   :description "Cheap gate — short-circuit when target isn't a :fn delete with a present id."
   :parent :and
   :args {:values [:_delete-fn-target-is-fn?
                   :_delete-fn-target-id-present?]}}

  {:name :_delete-fn-target-is-fn?
   :parent :equal?
   :args {:a :_delete-target-entity-type :b {:value :fn}}}

  {:name :_delete-fn-target-id-present?
   :parent :some? :args {:value :_delete-target-id}}

  ;; Conditional final message.
  {:name :_delete-fn-in-use-conditional-message
   :parent :if
   :args {:test :_delete-fn-has-dependents?
          :then :_delete-fn-in-use-message
          :else {:value nil}}}

  ;; Three reverse-reference queries.
  {:name :_delete-fn-parent-owners-all
   :parent :query-ref-many-owners
   :args {:entity-type {:value "fn"}
          :ref-many-field {:value "parent-ids"}
          :target-id :_delete-target-id}}

  ;; Drop the target itself so a self-ref isn't counted as a dependent.
  {:name :_delete-fn-parent-owners
   :parent :filter
   :args {:pred :_delete-fn-not-self?
          :coll :_delete-fn-parent-owners-all}}

  {:name :_delete-fn-not-self?
   :parent :not
   :args {:value {:parent :equal? :args {:a {:as :item} :b :_delete-target-id}}}}

  {:name :_delete-fn-used-as-parent-count
   :parent :count :args {:coll :_delete-fn-parent-owners}}

  ;; Ref-bindings via versioned :binding resolution + filter on
  ;; `:ref-fn-id` (which lives in version-data).
  {:name :_delete-fn-ref-bindings
   :parent :filter
   :args {:pred :_delete-fn-ref-binding-eq?
          :coll :_delete-fn-ref-bindings-resolved}}

  {:name :_delete-fn-ref-bindings-resolved
   :parent :resolve-binding-rows
   :args {:identities :_delete-fn-ref-bindings-identities
          :branch-chain :current-branch-chain}}

  {:name :_delete-fn-ref-bindings-identities
   :parent :storage-query-identities
   :args {:entity-type {:value "binding"} :where {:value {}}}}

  {:name :_delete-fn-ref-binding-eq?
   :parent :equal?
   :args {:a {:parent :get :args {:coll {:as :item} :key {:value :ref-fn-id} :default nil}}
          :b :_delete-target-id}}

  {:name :_delete-fn-ref-bindings-count
   :parent :count :args {:coll :_delete-fn-ref-bindings}}

  ;; Ref-items via versioned :binding-list-item resolution.
  {:name :_delete-fn-ref-items
   :parent :filter
   :args {:pred :_delete-fn-ref-item-eq?
          :coll :_delete-fn-ref-items-resolved}}

  {:name :_delete-fn-ref-items-resolved
   :parent :resolve-binding-list-item-rows
   :args {:identities :_delete-fn-ref-items-identities
          :branch-chain :current-branch-chain}}

  {:name :_delete-fn-ref-items-identities
   :parent :storage-query-identities
   :args {:entity-type {:value "binding-list-item"} :where {:value {}}}}

  {:name :_delete-fn-ref-item-eq?
   :parent :equal?
   :args {:a {:parent :get :args {:coll {:as :item} :key {:value :ref-fn-id} :default nil}}
          :b :_delete-target-id}}

  {:name :_delete-fn-ref-items-count
   :parent :count :args {:coll :_delete-fn-ref-items}}

  {:name :_delete-fn-refs-total
   :description "Sum of binding-ref + list-item-ref counts; matches the legacy `(+ ref-bindings ref-items)`."
   :parent :add
   :args {:nums [:_delete-fn-ref-bindings-count :_delete-fn-ref-items-count]}}

  ;; Predicates over the counts.
  {:name :_delete-fn-has-dependents?
   :parent :or
   :args {:values [:_delete-fn-has-parent-owners?
                   :_delete-fn-has-refs?]}}

  {:name :_delete-fn-has-parent-owners?
   :parent :not
   :args {:value {:parent :empty? :args {:coll :_delete-fn-parent-owners}}}}

  {:name :_delete-fn-has-refs?
   :parent :gt
   :args {:nums [:_delete-fn-refs-total {:value 0}]}}

  ;; Message build mirroring the legacy text:
  ;;   "Graph is a parent of N other graph(s) and referenced by M binding(s) — remove the dependents first."
  {:name :_delete-fn-in-use-message
   :parent :str
   :args {:parts ["Graph is "
                  :_delete-fn-parent-clause
                  :_delete-fn-and-clause
                  :_delete-fn-refs-clause
                  " — remove the dependents first."]}}

  {:name :_delete-fn-parent-clause
   :parent :if
   :args {:test :_delete-fn-has-parent-owners?
          :then :_delete-fn-parent-clause-text
          :else {:value ""}}}

  {:name :_delete-fn-parent-clause-text
   :parent :str
   :args {:parts ["a parent of "
                  :_delete-fn-used-as-parent-count
                  " other graph"
                  :_delete-fn-parent-clause-plural]}}

  {:name :_delete-fn-parent-clause-plural
   :parent :if
   :args {:test :_delete-fn-parent-multi?
          :then {:value "s"} :else {:value ""}}}

  {:name :_delete-fn-parent-multi?
   :parent :gt
   :args {:nums [:_delete-fn-used-as-parent-count {:value 1}]}}

  {:name :_delete-fn-and-clause
   :parent :if
   :args {:test :_delete-fn-both-deps?
          :then {:value " and "}
          :else {:value ""}}}

  {:name :_delete-fn-both-deps?
   :parent :and
   :args {:values [:_delete-fn-has-parent-owners?
                   :_delete-fn-has-refs?]}}

  {:name :_delete-fn-refs-clause
   :parent :if
   :args {:test :_delete-fn-has-refs?
          :then :_delete-fn-refs-clause-text
          :else {:value ""}}}

  {:name :_delete-fn-refs-clause-text
   :parent :str
   :args {:parts ["referenced by "
                  :_delete-fn-refs-total
                  " binding"
                  :_delete-fn-refs-clause-plural]}}

  {:name :_delete-fn-refs-clause-plural
   :parent :if
   :args {:test :_delete-fn-refs-multi?
          :then {:value "s"} :else {:value ""}}}

  {:name :_delete-fn-refs-multi?
   :parent :gt
   :args {:nums [:_delete-fn-refs-total {:value 1}]}}

  {:name :_delete-fn-in-use?
   :description "Guard #3 — the fn-in-use reason is non-nil."
   :parent :some?
   :args {:value {:as :fn-in-use-reason}}}

  {:name :_delete-err-fn-in-use
   :description "Wrap the precomputed in-use reason in a 409 partial response. Reuses `:html-error-response`; the `:reason → :fn-in-use-reason` rename captures the cond's `:fn-in-use-reason` shared-arg."
   :parent :html-error-response
   :args {:status {:value 409}
          :reason {:as :fn-in-use-reason}}}

  ;; Phase 4 decomposition: ns-non-empty reason is now pure graph
  ;; composition. Counts child :ns + :fn rows under the target ns-id,
  ;; builds a human-readable message with plurality, returns nil when
  ;; the ns is empty (or when target isn't a :ns at all).
  ;;
  ;; `:ns` is NON-versioned (immutable parent-id), so the child-ns
  ;; lookup goes via `:pg-query` directly. `:fn` IS versioned —
  ;; `:resolve-fn-rows` over `:storage-query-identities :where {:namespace-id …}`
  ;; (push the identity filter into SQL since `:namespace-id` is on
  ;; the identity row).
  {:name :_delete-ns-non-empty-reason
   :description "Compute the human-readable reason when a namespace delete is rejected for being non-empty; nil otherwise."
   :parent :if
   :args {:test :_delete-ns-non-empty-gate?
          :then :_delete-ns-non-empty-conditional-message
          :else {:value nil}}}

  {:name :_delete-ns-non-empty-gate?
   :description "Cheap gate — short-circuit when target isn't a :ns delete with a present id."
   :parent :and
   :args {:values [:_delete-ns-target-is-ns?
                   :_delete-ns-target-id-present?]}}

  {:name :_delete-ns-target-is-ns?
   :parent :equal?
   :args {:a :_delete-target-entity-type :b {:value :ns}}}

  {:name :_delete-ns-target-id-present?
   :parent :some? :args {:value :_delete-target-id}}

  ;; Conditional message: nil when no children, the human-readable
  ;; string otherwise.
  {:name :_delete-ns-non-empty-conditional-message
   :parent :if
   :args {:test :_delete-ns-has-children?
          :then :_delete-ns-non-empty-message
          :else {:value nil}}}

  {:name :_delete-ns-has-children?
   :parent :or
   :args {:values [:_delete-ns-has-child-ns?
                   :_delete-ns-has-child-fns?]}}

  {:name :_delete-ns-has-child-ns?
   :parent :not
   :args {:value {:parent :empty? :args {:coll :_delete-ns-child-ns-rows}}}}

  {:name :_delete-ns-has-child-fns?
   :parent :not
   :args {:value {:parent :empty? :args {:coll :_delete-ns-child-fns}}}}

  ;; Counts (used by the message; cached once via shared refs).
  {:name :_delete-ns-child-ns-count
   :parent :count :args {:coll :_delete-ns-child-ns-rows}}

  {:name :_delete-ns-child-fns-count
   :parent :count :args {:coll :_delete-ns-child-fns}}

  ;; `:ns` row lookup: non-versioned, raw pg-query.
  {:name :_delete-ns-child-ns-rows
   :parent :map
   :args {:func :_delete-ns-child-ns-decode :coll :_delete-ns-child-ns-raw}}

  {:name :_delete-ns-child-ns-raw
   :parent :storage-query-call
   :args {:arg :_delete-ns-child-ns-hsql}}

  {:name :_delete-ns-child-ns-hsql
   :parent :assoc
   :args {:map {:value {:select [:*] :from :ns}}
          :key {:value :where}
          :value :_delete-ns-child-ns-hsql-where}}

  {:name :_delete-ns-child-ns-hsql-where
   :parent :vec
   :args {:coll [{:value :=} {:value :parent-id} :_delete-target-id]}}

  {:name :_delete-ns-child-ns-decode
   :parent :decode-row
   :return-type :ns-row-shape
   :args {:row {:as :item} :entity-type {:value "ns"}}}

  ;; `:fn` rows: versioned, push `:namespace-id` filter into the
  ;; identity SQL (identity field), then resolve the version overlay.
  {:name :_delete-ns-child-fns
   :parent :resolve-fn-rows
   :args {:identities :_delete-ns-child-fn-identities
          :branch-chain :current-branch-chain}}

  {:name :_delete-ns-child-fn-identities
   :parent :storage-query-identities
   :args {:entity-type {:value "fn"}
          :where :_delete-ns-child-fn-where}}

  {:name :_delete-ns-child-fn-where
   :parent :zipmap
   :args {:keys [{:value :namespace-id}]
          :vals [:_delete-target-id]}}

  ;; Message build. Mirrors the original:
  ;;   "Namespace contains <ns-clause><and><fns-clause> — remove the contents first."
  ;; Each clause is "" when its count is zero so the join stays tidy.
  {:name :_delete-ns-non-empty-message
   :parent :str
   :args {:parts ["Namespace contains "
                  :_delete-ns-ns-clause
                  :_delete-ns-and-clause
                  :_delete-ns-fns-clause
                  " — remove the contents first."]}}

  {:name :_delete-ns-ns-clause
   :parent :if
   :args {:test :_delete-ns-has-child-ns?
          :then :_delete-ns-ns-clause-text
          :else {:value ""}}}

  {:name :_delete-ns-ns-clause-text
   :parent :str
   :args {:parts [:_delete-ns-child-ns-count
                  " sub-namespace"
                  :_delete-ns-ns-clause-plural]}}

  {:name :_delete-ns-ns-clause-plural
   :parent :if
   :args {:test :_delete-ns-ns-multi?
          :then {:value "s"}
          :else {:value ""}}}

  {:name :_delete-ns-ns-multi?
   :parent :gt
   :args {:nums [:_delete-ns-child-ns-count {:value 1}]}}

  {:name :_delete-ns-and-clause
   :parent :if
   :args {:test :_delete-ns-both-children?
          :then {:value " and "}
          :else {:value ""}}}

  {:name :_delete-ns-both-children?
   :parent :and
   :args {:values [:_delete-ns-has-child-ns? :_delete-ns-has-child-fns?]}}

  {:name :_delete-ns-fns-clause
   :parent :if
   :args {:test :_delete-ns-has-child-fns?
          :then :_delete-ns-fns-clause-text
          :else {:value ""}}}

  {:name :_delete-ns-fns-clause-text
   :parent :str
   :args {:parts [:_delete-ns-child-fns-count
                  " graph"
                  :_delete-ns-fns-clause-plural]}}

  {:name :_delete-ns-fns-clause-plural
   :parent :if
   :args {:test :_delete-ns-fns-multi?
          :then {:value "s"}
          :else {:value ""}}}

  {:name :_delete-ns-fns-multi?
   :parent :gt
   :args {:nums [:_delete-ns-child-fns-count {:value 1}]}}

  {:name :_delete-ns-non-empty?
   :description "Guard #4 — the ns-non-empty reason is non-nil."
   :parent :some?
   :args {:value {:as :ns-non-empty-reason}}}

  {:name :_delete-err-ns-non-empty
   :description "Wrap the precomputed ns-non-empty reason in a 409 partial response. Reuses `:html-error-response`; the `:reason → :ns-non-empty-reason` rename captures the cond's `:ns-non-empty-reason` shared-arg."
   :parent :html-error-response
   :args {:status {:value 409}
          :reason {:as :ns-non-empty-reason}}}

  ;; Phase 4.2 decomposition: success branch of DELETE /api/entities/:type/:id
  ;; is now pure graph composition:
  ;;   1. pre-read the existing row (404 if absent — guard against
  ;;      silently-OK on a missing row, which previously misled the UI)
  ;;   2. atomic `:delete-entity` via the existing CRUD wrap
  ;;   3. entity-type-aware `:invalidate-after-write` for the delta-
  ;;      invalidate seeds (handles fn / fn-slot / binding / binding-
  ;;      list-item case dispatch internally)
  ;;   4. entity-type-aware `:notify-after-write` for cross-pod NOTIFY
  ;;   5. 200 OK response
  ;;
  ;; Steps 2-5 run via `:do :steps` so side effects fire left-to-right.
  ;; The pre-read snapshot is bound once via `:_delete-apply-existing`
  ;; and shared across the not-found-check + the invalidate-seed
  ;; computation (which needs the row's FKs for binding-list-item).
  {:name :_delete-apply
   :description "Success branch — pre-read the snapshot for invalidate seeds where the row's foreign keys are needed (`:binding-list-item` and others), delete, invalidate, return 200."
   :parent :if
   :args {:test :_delete-apply-not-found?
          :then :_delete-apply-err-not-found
          :else :_delete-apply-success
          :existing :_delete-apply-existing}}

  {:name :_delete-apply-entity-type-str
   :description "Bare-identifier text form of the entity-type — `:fn` becomes `\"fn\"`. Used by the storage-facing slots (`:get-entity`/`:delete-entity`/`:invalidate-after-write`/`:notify-after-write`) which keyword the text via `keyword`."
   :parent :name
   :args {:value :_delete-target-entity-type}}

  {:name :_delete-apply-existing
   :description "Pre-read snapshot of the row about to be deleted. nil when no such row exists. The return-type stays the unrefined `:nullable-keyword-map` from `:get-entity` because the entity-type is dynamic (parsed from the URL) — every entity-type-shape alias would lie about non-matching callers."
   :parent :get-entity
   :args {:entity-type :_delete-apply-entity-type-str
          :id :_delete-target-id}}

  {:name :_delete-apply-not-found?
   :parent :nil? :args {:value {:as :existing}}}

  {:name :_delete-apply-err-not-found
   :parent :html-error-response
   :args {:status {:value 404}
          :reason {:parent :str
                   :args {:parts ["Entity not found: "
                                  :_delete-apply-entity-type-str
                                  " "
                                  :_delete-target-id]}}}}

  ;; The invalidate / notify primitives need a payload carrying the
  ;; row's FKs (so seed derivation works for `:binding-list-item` etc.).
  ;; Existing row data + the id ensures the same `:id`-anchored shape
  ;; the Clojure version used (`(or existing {:id id})`).
  {:name :_delete-apply-payload
   :parent :assoc
   :args {:map {:as :existing}
          :key {:value :id}
          :value :_delete-target-id}}

  ;; Sequence: delete → invalidate → notify → 200. `:do :steps`
  ;; guarantees left-to-right firing of side effects.
  {:name :_delete-apply-success
   :parent :do
   :args {:steps [:_delete-apply-do-delete
                  :_delete-apply-do-invalidate
                  :_delete-apply-do-notify
                  :_delete-apply-ok-response]}}

  {:name :_delete-apply-do-delete
   :parent :delete-entity
   :args {:entity-type :_delete-apply-entity-type-str
          :id :_delete-target-id}}

  {:name :_delete-apply-do-invalidate
   :parent :invalidate-after-write
   :args {:entity-type :_delete-apply-entity-type-str
          :entity-data :_delete-apply-payload}}

  ;; NOTIFY uses just `{:id id}` (matching the legacy delete payload —
  ;; service deletes carry `:id`, fn-graph deletes are full-clear via
  ;; the empty-seed fallback because `affected-fn-ids` can't derive
  ;; from just `:id` for fn-slot/binding/binding-list-item).
  {:name :_delete-apply-notify-payload
   :parent :zipmap
   :args {:keys [{:value :id}]
          :vals [:_delete-target-id]}}

  {:name :_delete-apply-do-notify
   :parent :notify-after-write
   :args {:entity-type :_delete-apply-entity-type-str
          :op {:value "delete"}
          :entity-data :_delete-apply-notify-payload}}

  {:name :_delete-apply-ok-response
   :parent :const
   :args {:value {:status 200 :body ""}}}

  {:name :_delete-err-invalid-request
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 400 :body "<p class=\"error\">Invalid request</p>"}}}

  {:name :_delete-err-secret-fn
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 409 :body "<p class=\"error\">Secret fn-defs must be deleted via DELETE /api/secrets/:fn-id (cleans up OpenBao alongside the row)</p>"}}}

  {:name :process-delete-entity
   :description "DELETE /api/entities/:type/:id — flat `:cond` of `[invalid-request? → 400, secret-fn? → 409, fn-in-use? → 409, ns-non-empty? → 409, true → apply]`. `:cond` is lazy, so the delete + invalidate (and the secret-shape DB lookup) only run when every guard up to that point passes. `parsed`, `fn-in-use-reason`, `ns-non-empty-reason` are shared sub-results bound once at the `:cond` fn-def — the two dynamic-reason error builders consume the same reason their predicate observed."
   :parent :cond
   :args {:clauses [:_delete-request-invalid? :_delete-err-invalid-request
                    :_delete-fn-is-secret?    :_delete-err-secret-fn
                    :_delete-fn-in-use?       :_delete-err-fn-in-use
                    :_delete-ns-non-empty?    :_delete-err-ns-non-empty
                    {:value true}             :_delete-apply]
          :parsed :_delete-parsed
          :fn-in-use-reason :_delete-fn-in-use-reason
          :ns-non-empty-reason :_delete-ns-non-empty-reason}}

  ;; Sequence operations: append/remove items of a sequence arg on any fn
  ;; that has a `:sequence`-typed anchor (e.g. :list, :pairs->map children).

  ;; --- sequence-append primitives (C3 decomposition). The handler
  ;; itself is the `:process-sequence-append` `:cond` graph fn-def
  ;; below; these are its atoms.
  ;; URL = /api/sequence/append/:fn-id — :fn-id from `:path-params`
  ;; when reitit's enrich-request ran, else the URI segment after
  ;; "append/". Body is parsed JSON (nil when missing).
  {:name :_seq-append-fn-id-from-path
   :parent :get-in
   :args {:map {:as :request}
          :path [{:value :path-params} {:value :fn-id}]
          :default nil}}

  {:name :_seq-append-fn-id-from-uri
   :parent :uri-segment-after
   :args {:marker {:value "append"}}}

  {:name :_seq-append-fn-id-raw
   :parent :coalesce
   :args {:value :_seq-append-fn-id-from-path
          :default :_seq-append-fn-id-from-uri}}

  {:name :_seq-append-body
   :parent :parse-json-body}

  {:name :_seq-append-parsed
   :description "Parse the URI + body of `POST /api/sequence/append/:fn-id` into `{:fn-id <uuid|nil> :body <map|nil>}`."
   :parent :zipmap
   :args {:keys [{:value :fn-id} {:value :body}]
          :vals [{:parent :parse-uuid :args {:string :_seq-append-fn-id-raw}}
                 :_seq-append-body]}}

  {:name :_seq-append-fn-id-invalid?
   :description "Guard #1 — the fn-id path-segment didn't parse as a UUID."
   :parent :nil?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :fn-id} :default nil}}}}

  {:name :_seq-append-body-invalid?
   :description "Guard #2 — the request body didn't parse as JSON."
   :parent :nil?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :body} :default nil}}}}

  {:name :_seq-append-load-binding
   :description "Read-only sequence-binding lookup. Returns the existing binding row, a synthetic placeholder (materialized by apply), or nil when the fn has no sequence slot. The synthetic placeholder carries extra non-canonical fields; the open `:binding-row-shape` admits supersets."
   :args {:parsed {:type :_seq-append-parsed-shape}}
   :return-type [:union :null :binding-row-shape]
   :effects #{:db}}

  {:name :_seq-append-no-seq-slot?
   :description "Guard #3 — the target fn has no sequence-typed slot in its inheritance closure."
   :parent :nil?
   :args {:value {:as :seq-binding}}}

  ;; Phase 4 follow-up — sequence-append apply decomposition.
  ;; §3.3 atomic write unit `:try-apply-seq-append` returns
  ;; `{:created :position :fn-id}` or `{:error}`. Graph dispatches on
  ;; the shape, runs delta-invalidate over the owner fn-id, and
  ;; builds the 200 JSON response (or 400 with the pre-write rej).
  {:name :_seq-append-apply
   :description "Success branch — materializes a synthetic binding if needed, appends the item, invalidates caches. Either 200 (with JSON `{:item-id :position}`) or 400 with the write-rej reason."
   :parent :if
   :args {:test :_seq-append-apply-error?
          :then :_seq-append-apply-err-response
          :else :_seq-append-apply-success
          :result :_seq-append-apply-result}}

  {:name :_seq-append-apply-result
   :parent :try-apply-seq-append
   :args {:parsed {:as :parsed}
          :seq-binding {:as :seq-binding}}}

  {:name :_seq-append-apply-error?
   :parent :some?
   :args {:value :_seq-append-apply-error-msg}}

  {:name :_seq-append-apply-error-msg
   :parent :get
   :args {:coll {:as :result} :key {:value :error} :default nil}}

  {:name :_seq-append-apply-err-response
   :parent :html-error-response
   :args {:status {:value 400}
          :reason :_seq-append-apply-error-msg}}

  {:name :_seq-append-apply-success
   :parent :do
   :args {:steps [:_seq-append-apply-do-invalidate
                  :_seq-append-apply-ok-response]}}

  {:name :_seq-append-apply-do-invalidate
   :parent :invalidate-graph-cache
   :args {:seeds :_seq-append-apply-seeds}}

  {:name :_seq-append-apply-seeds
   :parent :vec
   :args {:coll [{:parent :get :args {:coll {:as :result} :key {:value :fn-id} :default nil}}]}}

  {:name :_seq-append-apply-ok-response
   :parent :zipmap
   :args {:keys [{:value :status} {:value :headers} {:value :body}]
          :vals [{:value 200}
                 {:value {:Content-Type "application/json"}}
                 :_seq-append-apply-ok-body]}}

  {:name :_seq-append-apply-ok-body
   :description "JSON body `{:item-id :position}` rendered via `:to-json-string` over the result map."
   :parent :to-json-string
   :args {:data :_seq-append-apply-ok-body-data}}

  {:name :_seq-append-apply-ok-body-data
   :parent :zipmap
   :args {:keys [{:value :item-id} {:value :position}]
          :vals [{:parent :get :args {:coll {:as :result} :key {:value :created} :default nil}}
                 {:parent :get :args {:coll {:as :result} :key {:value :position} :default nil}}]}}

  {:name :_seq-append-err-invalid-fn-id
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 400 :body "<p class=\"error\">Invalid fn-id</p>"}}}

  {:name :_seq-append-err-no-seq-slot
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 404 :body "<p class=\"error\">Fn has no sequence slot</p>"}}}

  {:name :process-sequence-append
   :description "POST /api/sequence/append/:fn-id — append an item to a `:sequence`-typed arg. Validation guards + success path are a flat `:cond` — `[invalid-fn-id? → 400, invalid-body? → 400, no-seq-slot? → 404, true → apply]`. `:cond` is lazy, so the synthetic-binding materialization + the item write only run when every guard passes. `parsed` + `seq-binding` are shared sub-results bound once at the `:cond` fn-def."
   :parent :cond
   :args {:clauses [:_seq-append-fn-id-invalid?  :_seq-append-err-invalid-fn-id
                    :_seq-append-body-invalid?   :_html-err-invalid-body
                    :_seq-append-no-seq-slot?    :_seq-append-err-no-seq-slot
                    {:value true}                :_seq-append-apply]
          :parsed :_seq-append-parsed
          :seq-binding :_seq-append-load-binding}}

  ;; --- sequence-remove primitives (C2 decomposition). The handler
  ;; itself is the `:process-sequence-remove` `:cond` graph fn-def
  ;; below; these are its atoms.
  ;; URL = /api/sequence/item/:item-id — :item-id from `:path-params`
  ;; or the URI segment after "item/".
  {:name :_seq-remove-item-id-from-path
   :parent :get-in
   :args {:map {:as :request}
          :path [{:value :path-params} {:value :item-id}]
          :default nil}}

  {:name :_seq-remove-item-id-from-uri
   :parent :uri-segment-after
   :args {:marker {:value "item"}}}

  {:name :_seq-remove-item-id-raw
   :parent :coalesce
   :args {:value :_seq-remove-item-id-from-path
          :default :_seq-remove-item-id-from-uri}}

  {:name :_seq-remove-parsed
   :description "Parse the URI path of `DELETE /api/sequence/item/:item-id` into `{:item-id <uuid|nil>}`."
   :parent :zipmap
   :args {:keys [{:value :item-id}]
          :vals [{:parent :parse-uuid :args {:string :_seq-remove-item-id-raw}}]}}

  {:name :_seq-remove-item-id-invalid?
   :description "Guard #1 — the item-id path-segment didn't parse as a UUID."
   :parent :nil?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :item-id} :default nil}}}}

  {:name :_seq-remove-load-item
   :description "Read the binding-list-item row for the parsed item-id. Returns nil when the id is invalid (caught by guard #1) OR when no row matches."
   :args {:parsed {:type {:item-id :uuid}}}
   :return-type [:union :null :binding-list-item-row-shape]
   :effects #{:db}}

  {:name :_seq-remove-item-not-found?
   :description "Guard #2 — no binding-list-item matches the parsed id."
   :parent :nil?
   :args {:value {:as :item}}}

  ;; Phase 4 follow-up — sequence-remove apply decomposition.
  ;; `:delete-entity` → `:invalidate-after-write` (with the pre-read
  ;; item snapshot so seed derivation walks `:binding-id` → `:fn-id`)
  ;; → 200 response. Sequenced via `:do`.
  {:name :_seq-remove-apply
   :description "Success branch — delete the row, invalidate caches, return 200."
   :parent :do
   :args {:steps [:_seq-remove-apply-do-delete
                  :_seq-remove-apply-do-invalidate
                  :_seq-remove-apply-ok-response]}}

  {:name :_seq-remove-apply-do-delete
   :parent :delete-entity
   :args {:entity-type {:value "binding-list-item"}
          ;; `:type :uuid` author-assertion — the validation guard
          ;; upstream rejects the request when `:item-id` is missing
          ;; or malformed, so by the time this fn runs the parsed
          ;; UUID is non-null. (Phase #170 control-flow narrowing
          ;; cannot eliminate this assertion because the inline
          ;; `:get` here is a per-use-site anon, distinct from the
          ;; one in the upstream `:nil?` guard.)
          :id {:parent :get :type :uuid
               :args {:coll {:as :parsed} :key {:value :item-id} :default nil}}}}

  {:name :_seq-remove-apply-do-invalidate
   :parent :invalidate-after-write
   :args {:entity-type {:value "binding-list-item"}
          :entity-data {:as :item}}}

  {:name :_seq-remove-apply-ok-response
   :parent :const
   :args {:value {:status 200 :body ""}}}

  {:name :process-sequence-remove
   :description "DELETE /api/sequence/item/:item-id — remove one binding-list-item. The two validation guards and the success path are a flat `:cond` — `[invalid-id? → 400, not-found? → 404, true → apply]`. `:cond` is lazy, so the DB delete runs only when both guards pass. `parsed` + `item` are shared sub-results bound once at the `:cond` fn-def."
   :parent :cond
   :args {:clauses [:_seq-remove-item-id-invalid?  :_html-err-invalid-item-id
                    :_seq-remove-item-not-found?   :_html-err-item-not-found
                    {:value true}                  :_seq-remove-apply]
          :parsed :_seq-remove-parsed
          :item :_seq-remove-load-item}}

  ;; --- sequence-update primitives (C4 decomposition).
  ;; Shares `:_seq-remove-item-id-raw` (same URL shape — both routes
  ;; have :item-id at the same path position) with `:_seq-remove-parsed`.
  {:name :_seq-update-body
   :parent :parse-json-body}

  {:name :_seq-update-parsed
   :description "Parse `PUT /api/sequence/item/:item-id` into `{:item-id <uuid|nil> :body <map|nil>}`. Reuses `:_seq-remove-item-id-raw` for URL extraction."
   :parent :zipmap
   :args {:keys [{:value :item-id} {:value :body}]
          :vals [{:parent :parse-uuid :args {:string :_seq-remove-item-id-raw}}
                 :_seq-update-body]}}

  {:name :_seq-update-item-id-invalid?
   :description "Guard #1 — bad UUID in the path-segment."
   :parent :nil?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :item-id} :default nil}}}}

  {:name :_seq-update-body-invalid?
   :description "Guard #2 — the request body didn't parse as JSON."
   :parent :nil?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :body} :default nil}}}}

  {:name :_seq-update-load-item
   :description "Read the binding-list-item row for the parsed id."
   :args {:parsed {:type :_seq-update-parsed-shape}}
   :return-type [:union :null :binding-list-item-row-shape]
   :effects #{:db}}

  {:name :_seq-update-item-not-found?
   :description "Guard #3 — no binding-list-item matches the parsed id."
   :parent :nil?
   :args {:value {:as :item}}}

  ;; Phase 4 follow-up — sequence-update apply decomposition.
  ;; Same pattern as seq-append.
  {:name :_seq-update-apply
   :description "Success branch — resolve body payload, run write-rej, update the row. Returns 200 or 400."
   :parent :if
   :args {:test :_seq-update-apply-error?
          :then :_seq-update-apply-err-response
          :else :_seq-update-apply-success
          :result :_seq-update-apply-result}}

  {:name :_seq-update-apply-result
   :parent :try-apply-seq-update
   :args {:parsed {:as :parsed}
          :item {:as :item}}}

  {:name :_seq-update-apply-error?
   :parent :some?
   :args {:value :_seq-update-apply-error-msg}}

  {:name :_seq-update-apply-error-msg
   :parent :get
   :args {:coll {:as :result} :key {:value :error} :default nil}}

  {:name :_seq-update-apply-err-response
   :parent :html-error-response
   :args {:status {:value 400}
          :reason :_seq-update-apply-error-msg}}

  {:name :_seq-update-apply-success
   :parent :do
   :args {:steps [:_seq-update-apply-do-invalidate
                  :_seq-update-apply-ok-response]}}

  {:name :_seq-update-apply-do-invalidate
   :parent :invalidate-after-write
   :args {:entity-type {:value "binding-list-item"}
          :entity-data {:as :item}}}

  {:name :_seq-update-apply-ok-response
   :parent :const
   :args {:value {:status 200 :body ""}}}

  {:name :process-sequence-update
   :description "PUT /api/sequence/item/:item-id — replace the value/ref of one existing binding-list-item. Validation guards + success path are a flat `:cond` — `[invalid-id? → 400, invalid-body? → 400, item-not-found? → 404, true → apply]`. `:cond` is lazy, so the DB update + write-rej payload-resolution only run when every guard passes."
   :parent :cond
   :args {:clauses [:_seq-update-item-id-invalid?  :_html-err-invalid-item-id
                    :_seq-update-body-invalid?     :_html-err-invalid-body
                    :_seq-update-item-not-found?   :_html-err-item-not-found
                    {:value true}                  :_seq-update-apply]
          :parsed :_seq-update-parsed
          :item :_seq-update-load-item}}

  ;; --- tighten-fn-effects primitives. The handler itself is a
  ;; `:cond` graph fn-def (`:process-tighten-binding-effects` below);
  ;; these are its parse / guard-predicate / apply primitives. ---
  ;; --- :_tighten-parsed (Variant-2). Was defbase delegating to a
  ;; since-removed `parse-tighten-request` helper. Now graph composition:
  ;;   - binding-id-str via :get-in path-params OR :uri-segment-after,
  ;;     parsed via :parse-uuid (returns nil on bad input).
  ;;   - body via :parse-json-body (already a defbase).
  ;;   - effects-val / args-val / ret-val are :get'd from body.
  ;;   - :delta is a :merge of per-field fragments (assoc-only-when-
  ;;     :some?), same pattern as parse-*-from-form.
  ;;   - final shape :zipmap'd.

  {:name :_tighten-binding-id-from-path-params
   :parent :get-in
   :args {:map {:as :request}
          :path [{:value :path-params} {:value :binding-id}]
          :default nil}}

  {:name :_tighten-binding-id-from-uri
   :parent :uri-segment-after
   :args {:marker {:value "bindings"}}}

  {:name :_tighten-binding-id-str
   :parent :coalesce
   :args {:value :_tighten-binding-id-from-path-params
          :default :_tighten-binding-id-from-uri}}

  {:name :_tighten-binding-id
   :parent :parse-uuid
   :args {:string :_tighten-binding-id-str}}

  {:name :_tighten-body
   :parent :parse-json-body
   :args {:request {:as :request}}}

  {:name :_tighten-effects-val
   :parent :get
   :args {:coll :_tighten-body :key {:value :effects} :default nil}}

  {:name :_tighten-args-val
   :parent :get
   :args {:coll :_tighten-body :key {:value :args} :default nil}}

  {:name :_tighten-ret-val
   :parent :get
   :args {:coll :_tighten-body :key {:value :ret} :default nil}}

  ;; --- :delta = (cond-> {} (some? effects-val) (assoc :effects ...) …)
  {:name :_tighten-delta-effects-fragment
   :parent :if
   :args {:test {:parent :some? :args {:value :_tighten-effects-val}}
          :then {:parent :zipmap
                 :args {:keys [{:value :effects}] :vals [:_tighten-effects-val]}}
          :else {:value {}}}}

  {:name :_tighten-delta-args-fragment
   :parent :if
   :args {:test {:parent :some? :args {:value :_tighten-args-val}}
          :then {:parent :zipmap
                 :args {:keys [{:value :args}] :vals [:_tighten-args-val]}}
          :else {:value {}}}}

  {:name :_tighten-delta-ret-fragment
   :parent :if
   :args {:test {:parent :some? :args {:value :_tighten-ret-val}}
          :then {:parent :zipmap
                 :args {:keys [{:value :ret}] :vals [:_tighten-ret-val]}}
          :else {:value {}}}}

  {:name :_tighten-delta
   :parent :merge
   :args {:maps [{:value {}}
                 :_tighten-delta-effects-fragment
                 :_tighten-delta-args-fragment
                 :_tighten-delta-ret-fragment]}}

  {:name :_tighten-parsed
   :description "Parse a tighten-fn-effects request into `{:binding-id :effects-val :args-val :ret-val :delta}` — no validation."
   :parent :zipmap
   :args {:keys [{:value :binding-id}
                 {:value :effects-val}
                 {:value :args-val}
                 {:value :ret-val}
                 {:value :delta}]
          :vals [:_tighten-binding-id
                 :_tighten-effects-val
                 :_tighten-args-val
                 :_tighten-ret-val
                 :_tighten-delta]}}

  {:name :_tighten-binding-id-invalid?
   :description "Guard predicate — true when the request carries no valid binding-id."
   :parent :nil?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :binding-id} :default nil}}}}

  {:name :_tighten-effects-invalid?
   :description "Guard predicate — true when `effects` is present but not a JSON array. `:and [some? :_effects-val] [not :is-a? :sequence :_effects-val]`."
   :parent :and
   :args {:values [{:parent :some? :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :effects-val} :default nil}}}}
                   {:parent :not
                    :args {:value {:parent :is-a?
                                   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :effects-val} :default nil}}
                                          :type {:value :sequence}}}}}]}}

  {:name :_tighten-args-invalid?
   :description "Guard predicate — true when `args` is present but not a JSON object. `:and [some? :_args-val] [not :is-a? :map :_args-val]`."
   :parent :and
   :args {:values [{:parent :some? :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :args-val} :default nil}}}}
                   {:parent :not
                    :args {:value {:parent :is-a?
                                   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :args-val} :default nil}}
                                          :type {:value :map}}}}}]}}

  {:name :_tighten-delta-empty?
   :description "Guard predicate — true when the body carried none of args / ret / effects. `:empty? (get parsed :delta)`."
   :parent :empty?
   :args {:coll {:parent :get :args {:coll {:as :parsed} :key {:value :delta} :default nil}}}}

  ;; Phase 4 follow-up — tighten-effects apply decomposition.
  ;; §3.3 atomic write unit `:try-apply-tighten` returns `{:status
  ;; :reason :result}`. Graph dispatches on `:status`, runs delta-
  ;; invalidate over the binding's owning fn-id, and builds the
  ;; 200 JSON / 400 error response.
  {:name :_tighten-apply
   :description "Success branch — narrow the fn-typed binding's effective type to a 4-arity `[:fn args ret #{eff-set}]`, dedupe the anonymous constraint fn-row, write the binding's `:type-override-fn-id`, and return the partial Ring response."
   :parent :if
   :args {:test :_tighten-apply-ok?
          :then :_tighten-apply-success
          :else :_tighten-apply-err-response
          :result :_tighten-apply-result}}

  {:name :_tighten-apply-result
   :parent :try-apply-tighten
   :args {:parsed {:as :parsed}}}

  {:name :_tighten-apply-status
   :parent :get
   :args {:coll {:as :result} :key {:value :status} :default nil}}

  {:name :_tighten-apply-ok?
   :parent :equal?
   :args {:a :_tighten-apply-status :b {:value 200}}}

  {:name :_tighten-apply-err-response
   :parent :html-error-response
   :args {:status :_tighten-apply-status
          :reason {:parent :get :args {:coll {:as :result} :key {:value :reason} :default nil}}}}

  {:name :_tighten-apply-success
   :parent :do
   :args {:steps [:_tighten-apply-do-invalidate
                  :_tighten-apply-ok-response]}}

  {:name :_tighten-apply-success-result
   :parent :get
   :args {:coll {:as :result} :key {:value :result} :default nil}}

  {:name :_tighten-apply-do-invalidate
   :parent :invalidate-after-write
   :args {:entity-type {:value "binding"}
          :entity-data :_tighten-apply-success-result}}

  {:name :_tighten-apply-ok-response
   :parent :zipmap
   :args {:keys [{:value :status} {:value :headers} {:value :body}]
          :vals [{:value 200}
                 {:value {:Content-Type "application/json"}}
                 {:parent :to-json-string :args {:data :_tighten-apply-success-result}}]}}

  {:name :try-apply-tighten
   :description "§3.3 core of tighten-fn-effects: narrows the fn-typed binding's effective type. Returns `{:status :reason :result}` — graph dispatches on `:status`."
   :args {:parsed {:type :_tighten-parsed-shape}}
   :return-type :keyword-map
   :effects #{:db}}

  ;; --- :parse-form-body / :parse-json-body (Variant-2). Both were
  ;; defbase wrapping
  ;;   `(let [body (:body request) ct (get-in request [:headers
  ;;     "content-type"] "")]
  ;;      (when (and body (str/includes? ct <marker>)) (<parse> body)))`
  ;; Pure graph composition over existing primitives — :get + :get-in
  ;; + :and + :some? + :str-contains? + :parse-query-string /
  ;; :parse-json. Admins extend the content-type allowlist or swap
  ;; the parser by editing fragment fn-defs in the graph.

  {:name :_request-body
   :parent :get
   :args {:coll {:as :request} :key {:value :body} :default nil}}

  {:name :_request-content-type
   :parent :get-in
   :args {:map {:as :request}
          :path [{:value :headers} {:value "content-type"}]
          :default ""}}

  ;; --- :parse-form-body — `application/x-www-form-urlencoded`.

  {:name :_form-body?
   :parent :and
   :args {:values [{:parent :some? :args {:value :_request-body}}
                   {:parent :str-contains?
                    :args {:string :_request-content-type
                           :substring {:value "application/x-www-form-urlencoded"}}}]}}

  {:name :parse-form-body
   :description "Parse an `application/x-www-form-urlencoded` request body into a `{key value}` map. Empty map when body is missing OR content-type doesn't match — matches the legacy `(when matches? (or (parse) {}))` semantics."
   :parent :if
   :args {:test :_form-body?
          :then {:parent :coalesce
                 :args {:value {:parent :parse-query-string
                                :args {:string :_request-body}}
                        :default {:value {}}}}
          :else {:value {}}}}

  ;; --- :parse-json-body — `application/json`. nil when missing or
  ;; content-type doesn't match.

  {:name :_json-body?
   :parent :and
   :args {:values [{:parent :some? :args {:value :_request-body}}
                   {:parent :str-contains?
                    :args {:string :_request-content-type
                           :substring {:value "application/json"}}}]}}

  {:name :parse-json-body
   :description "Parse a JSON request body into a Clojure value (keywordizing string keys). nil when body is missing OR content-type doesn't match."
   :parent :if
   :args {:test :_json-body?
          :then {:parent :parse-json
                 :args {:string :_request-body :keywordize {:value true}}}
          :else nil}}

  {:name :str-to-uuid
   :description "Coerce a string to `java.util.UUID`. Throws on malformed input."
   :args {:string {:type :text :description "UUID in canonical 8-4-4-4-12 form."}}
   :return-type :uuid}

  ;; Form data parsing helpers
  ;; --- :resolve-type-fn-id / :parse-constraint — atomic primitives
  ;; over the fn-create form's complex coercions. resolve-type-fn-id
  ;; bridges the editor's two-shape `:return-type`/`:base-fn-id`/
  ;; `:element-fn-id` field (UUID-or-name). parse-constraint runs a
  ;; recursive keyword-restore walk over the JSON-encoded constraint
  ;; vector — the recursion is the §3.3 invariant (no atomic graph
  ;; counterpart without `:fix`).
  {:name :resolve-type-fn-id
   :description "Resolve a type-row reference (UUID string OR fn name) to its fn-id. nil on blank input; throws `:crud/unknown-type-ref` when a name doesn't match."
   :args {:v {:type :text :description "Form value — UUID string or type-row fn name."}}
   :return-type :nullable-uuid
   :effects #{:db}}

  {:name :parse-constraint
   :description "JSON-parse + recursive keyword-restore for the `:constraint` form field. nil on blank input."
   :args {:raw {:type :text :description "Raw JSON-encoded constraint string from the form."}}
   :return-type :jsonb}

  ;; --- :parse-fn-from-form (Variant-2). The heavy lifter: 10 fields
  ;; with the broadest coercion surface in the CRUD form set.
  ;; Simple fragments (same pattern as the other parsers):
  ;;   :name, :namespace-id (empty-as-clear), :description.
  ;; Fragments using the new primitives:
  ;;   :return-type → :return-type-fn-id (via :resolve-type-fn-id),
  ;;   :base-fn-id, :element-fn-id (both via :resolve-type-fn-id when
  ;;   non-blank),
  ;;   :constraint (via :parse-constraint).
  ;; Special-shape fragments:
  ;;   :parent-id — non-blank-only assoc (no `contains?` check —
  ;;     legacy `cond->` semantics).
  ;;   :parent-ids — comma-separated UUID list → vec of UUIDs.
  ;;   :expects-effects — comma-separated bare effect names → vec,
  ;;     with literal "[]" / "null" handling.

  {:name :_parse-fn-form-name-fragment
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll {:as :form-data} :key {:value :name}}}
          :then {:parent :zipmap
                 :args {:keys [{:value :name}]
                        :vals [{:parent :to-str
                                :args {:value {:parent :get
                                               :args {:coll {:as :form-data}
                                                      :key {:value :name}
                                                      :default nil}}}}]}}
          :else {:value {}}}}

  {:name :_parse-fn-form-parent-id-raw
   :parent :get
   :args {:coll {:as :form-data} :key {:value :parent-id} :default nil}}

  {:name :_parse-fn-form-parent-id-fragment
   :description "Legacy `cond->` semantics — assoc :parent-id ONLY when non-blank (no `contains?` check). Different from the ns parser; matches the legacy fn parser."
   :parent :if
   :args {:test {:parent :not
                 :args {:value {:parent :blank?
                                :args {:string :_parse-fn-form-parent-id-raw}}}}
          :then {:parent :zipmap
                 :args {:keys [{:value :parent-id}]
                        :vals [{:parent :parse-uuid
                                :args {:string :_parse-fn-form-parent-id-raw}}]}}
          :else {:value {}}}}

  {:name :_parse-fn-form-namespace-id-raw
   :parent :get
   :args {:coll {:as :form-data} :key {:value :namespace-id} :default nil}}

  {:name :_parse-fn-form-namespace-id-coerced
   :parent :if
   :args {:test {:parent :not
                 :args {:value {:parent :blank?
                                :args {:string :_parse-fn-form-namespace-id-raw}}}}
          :then {:parent :parse-uuid
                 :args {:string :_parse-fn-form-namespace-id-raw}}
          :else nil}}

  {:name :_parse-fn-form-namespace-id-fragment
   :description "Empty-as-clear — `:namespace-id` is present in result when form has key (so nil clears the column on update)."
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll {:as :form-data} :key {:value :namespace-id}}}
          :then {:parent :zipmap
                 :args {:keys [{:value :namespace-id}]
                        :vals [:_parse-fn-form-namespace-id-coerced]}}
          :else {:value {}}}}

  {:name :_parse-fn-form-description-fragment
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll {:as :form-data} :key {:value :description}}}
          :then {:parent :zipmap
                 :args {:keys [{:value :description}]
                        :vals [{:parent :get
                                :args {:coll {:as :form-data}
                                       :key {:value :description}
                                       :default nil}}]}}
          :else {:value {}}}}

  {:name :_parse-fn-form-return-type-fragment
   :description "`:return-type` form field → `:return-type-fn-id` storage column via `:resolve-type-fn-id`."
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll {:as :form-data} :key {:value :return-type}}}
          :then {:parent :zipmap
                 :args {:keys [{:value :return-type-fn-id}]
                        :vals [{:parent :resolve-type-fn-id
                                :args {:v {:parent :get
                                           :args {:coll {:as :form-data}
                                                  :key {:value :return-type}
                                                  :default nil}}}}]}}
          :else {:value {}}}}

  ;; --- parent-ids: comma-sep UUID list, empty → [].
  {:name :_parse-fn-form-parent-ids-raw
   :parent :get
   :args {:coll {:as :form-data} :key {:value :parent-ids} :default nil}}

  {:name :_parse-fn-form-pid-trim-item
