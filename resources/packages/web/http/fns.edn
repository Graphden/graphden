;; HTTP server base functions using http-kit


{:namespace "web.http"
 :fns
 [;; Starts http-kit server. `:handler` is `:fn`-typed — compile's
  ;; `hof-wrap` runs at the call-site, turning the bound fn-graph into
  ;; a Ring callable based on its leftover free-args (one leftover →
  ;; `(fn [request] …)`). No adapter fn needed in between.
  {:name :http-server
   :args {:handler :fn
          :port :int}
   :return-type :any}

  {:name :http-stop
   :args {:server :any}
   :return-type :any}]}
