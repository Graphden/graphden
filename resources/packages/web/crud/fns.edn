          :else {:value {}}}}

  {:name :_parse-fn-slot-form-slot-id-fragment
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll {:as :form-data} :key {:value :slot-id}}}
          :then {:parent :zipmap
                 :args {:keys [{:value :slot-id}]
                        :vals [{:parent :parse-uuid
                                :args {:string {:parent :get
                                                :args {:coll {:as :form-data}
                                                       :key {:value :slot-id}
                                                       :default nil}}}}]}}
          :else {:value {}}}}

  {:name :_parse-fn-slot-form-position-fragment
   :description "`{:position (parse-int …)}` when form-data contains `:position`; else `{}`. `:parse-int` (Long/parseLong) throws NumberFormatException on non-numeric input — same semantics as the legacy `Integer/parseInt` call; downstream catches reach the parse-error guard."
   :parent :if
   :args {:test {:parent :contains?
