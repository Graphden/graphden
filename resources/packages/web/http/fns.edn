;; HTTP server base functions using http-kit


{:namespace "web.http"
 :description "HTTP server primitive (http-kit) and the slurp helper for request bodies."
 :fns
 [;; Type-alias for the http-kit stop-callable. http-kit's
  ;; `run-server` returns a 0-arg fn whose only effect is to stop
  ;; the running server — `(server)` shuts it down. Typing it as
  ;; `[:fn {} :null]` documents the contract AND lets type-check
  ;; reject any non-callable argument to `:http-stop`.
  {:name :http-server-handle
   :description "Handle of a running http-kit server — a 0-arg callable that stops the server when invoked. Returned by `:http-server`, consumed by `:http-stop`."
   :fn-type [{} :null]}

  ;; Starts http-kit server. `:handler` is structurally typed —
  ;; `[:fn {:request :ring-request-shape} :ring-response-shape]`
  ;; declares only the SINGLE arg http-kit will pass per call.
  ;; The consuming fn-graph (`:_app-ring-response` etc.) typically
  ;; lists more compile-time free args; graphden's fn-subtype rule
  ;; recognises that hof-wrap captures the rest from the environment,
  ;; so `extra args on the callee are fine`. The `:request` key and
  ;; the return shape ARE checked structurally — passing `:add` (an
  ;; arithmetic fn-def whose return is `:numeric`) gets rejected at
  ;; sync time instead of crashing on the first request.
  {:name :http-server
   :description "Start an http-kit HTTP server. The `:handler` is a Ring-style fn `(fn [request] response)`; the executor's hof-wrap turns the bound fn-graph into a single-arg Ring callable per request."
   :args {:handler {:type [:fn {:request :ring-request-shape} :ring-response-shape]
                    :description "Ring-style handler — receives the request map, returns the response map."}
          :port {:type :port
                 :description "TCP port to listen on (e.g., 8080) — refinement narrows :int to 1..65535."}}
   :return-type :http-server-handle
   ;; :process marks this fn as service-eligible: it spawns a
   ;; supervised background listener that lives past the call and
   ;; requires explicit stopping. validate-create's :service branch
   ;; consults this set; without :process, /api/entities/service is
   ;; rejected with a "must declare :process" message. :http-stop
   ;; stays :network-only — it kills the server but doesn't spawn
   ;; anything itself.
   :effects #{:network :process}
   ;; Runtime-config marker — see graphden.versioning.branch-local.
   ;; A web-server's port + handler are environment-specific; merging
   ;; a dev http-server config into prod would clobber the production
   ;; listener. The monotonic-OR walker makes every descendant
   ;; ({:parent :http-server …}) sticky-local too, so user-defined
   ;; servers inherit the policy without per-fn-def opt-in.
   :branch-local? true}

  {:name :http-stop
   :description "Stop a running http-kit server returned by `:http-server`."
   :args {:server {:type :http-server-handle
                   :description "Server handle returned by `:http-server`."}}
   :return-type :null
   :effects #{:network}}]}
