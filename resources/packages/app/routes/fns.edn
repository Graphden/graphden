;; All concrete app routes — one fn-def per HTTP endpoint reitit serves.
;; Names drop the redundant `-route` suffix because the namespace
;; (`app.routes`) and the parent fn-def (`get-route`, `post-auth-required-route`,
;; …) already say "this is a route".
;;
;; Handlers and request-body fn-defs live in their feature modules
;; (`app/editor`, `app/layout`); this module only assembles
;; `path + handler` into the route shape reitit consumes via the parent.


{:namespace "app.routes"
 :description "Concrete HTTP routes — one fn-def per endpoint. The leaf assembled from a method-template parent (`get-route`, `post-auth-required-route`, …) plus a `:path` and a `:handler` ref into `app/editor` or `app/layout`."
 :fns
 [{:name :health
   :description "GET /health — returns the current health status as JSON."
   :parent :get-route
   :args {:path "/health" :handler :_health-handler}}

  {:name :metrics
   :description "GET /metrics — returns JVM info (heap, threads, uptime) as JSON."
   :parent :get-route
   :args {:path "/metrics" :handler :_metrics-handler}}

  {:name :favicon
   :description "GET /favicon.ico — returns the inlined SVG icon, cached for 24 hours."
   :parent :get-route
   :args {:path "/favicon.ico" :handler :_favicon-handler}}

  {:name :editor
   :description "GET / — serves the graph-editor HTML page."
   :parent :get-route
   :args {:path "/" :handler :_editor-handler}}

  {:name :api-entities
   :description "GET /api/graph/entities — full graph dump as JSON (every fn, arg, ns)."
   :parent :get-route
   :args {:path "/api/graph/entities" :handler :all-entities-handler}}

  {:name :entity-details
   :description "GET /partials/entity-details/:type/:id — HTML partial showing one entity's fields."
   :parent :get-route
   :args {:path "/partials/entity-details/:type/:id" :handler :entity-details-handler}}

  {:name :entity-form-create
   :description "GET /partials/entity-form/:type — HTML partial with the create form for an entity type."
   :parent :get-route
   :args {:path "/partials/entity-form/:type" :handler :entity-form-create-handler}}

  {:name :entity-form-edit
   :description "GET /partials/entity-form/:type/:id — HTML partial with the edit form for one entity."
   :parent :get-route
   :args {:path "/partials/entity-form/:type/:id" :handler :entity-form-edit-handler}}

  ;; Write-facing endpoints — gated by auth-required-middleware via
  ;; post/delete-auth-required-route templates (see app/server).
  ;; Verb-at-end (`entity-create` over `create-entity`) avoids the
  ;; name clash with the `web.crud` base-fns of the same root verb.
  {:name :entity-create
   :description "POST /api/entities/:type — creates an entity from the form-encoded body. Auth-required."
   :parent :post
   :args {:path "/api/entities/:type" :handler :create-entity-handler}}

  {:name :entity-update
   :description "PUT /api/entities/:type/:id — updates an entity from a form-encoded body (e.g. rename a namespace from the inline edit field in the sidebar). Auth-required."
   :parent :put
   :args {:path "/api/entities/:type/:id" :handler :update-entity-handler}}

  {:name :entity-delete
   :description "DELETE /api/entities/:type/:id — soft-deletes an entity by id. Auth-required."
   :parent :delete
   :args {:path "/api/entities/:type/:id" :handler :delete-entity-handler}}

  ;; Sequence-arg editing endpoints. Paths disambiguated by leading verb so
  ;; reitit doesn't see conflicting parameter positions (`:fn-id` vs `item`).
  {:name :sequence-append
   :description "POST /api/sequence/append/:fn-id — appends an item to a `:sequence`-typed arg. Auth-required."
   :parent :post
   :args {:path "/api/sequence/append/:fn-id" :handler :sequence-append-handler}}

  {:name :sequence-remove
   :description "DELETE /api/sequence/item/:item-id — removes an item from its sequence-arg by item id. Auth-required."
   :parent :delete
   :args {:path "/api/sequence/item/:item-id" :handler :sequence-remove-handler}}

  ;; POST /api/graph/layout - accepts root-id and expansions
  {:name :layout-api
   :description "POST /api/graph/layout — accepts `{root-id, expansions}` and returns the laid-out graph (nodes + edges + grid positions)."
   :parent :post-route
   :args {:path "/api/graph/layout" :handler :_layout-api-handler}}

  ;; GET /api/auth/check — auth-required endpoint that simply returns 200
  ;; "ok" if the bearer token matches AUTH_TOKEN. Used by the editor's
  ;; lock-icon popover to validate the password BEFORE the user attempts
  ;; a real mutation, so wrong passwords surface immediately rather than
  ;; on the first failed POST/DELETE.
  {:name :auth-check
   :description "GET /api/auth/check — auth-required ping endpoint. Returns 200 `\"ok\"` when `Authorization: Bearer <AUTH_TOKEN>` matches; 401 otherwise (handled by `auth-required-middleware`). Used by the UI to validate the admin password before showing edit affordances."
   :parent :get-auth-required
   :args {:path "/api/auth/check" :handler :_auth-check-handler}}

  {:name :_auth-check-handler
   :description "Ring handler returning `200 \"ok\"` as plain text. Used by `:auth-check` — the auth-required-middleware short-circuits to 401 before this runs when the token is wrong, so reaching this handler confirms the token matched."
   :parent :text-ok-response
   :args {:body "ok"}}]}
