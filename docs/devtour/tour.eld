;; -*- lisp-data -*-
;; generated by `bb devtour` from docs/devtour/tour.edn — do not edit.
;; Consumed by docs/devtour/devtour.el; every step carries the anchor
;; (:file + :head) rather than baked source, so emacs shows live code.
(:title "Graphden — developer tour"
 :definition-return "Return to the tour"
 :mins 819.7
 :glossary ((:id "graph-function" :title "Graph function" :say "A stored definition of a computation, identified by a function ID. It can declare arguments or specialize parent functions by [inheritance](#term/inheritance) and [bindings](#term/binding). A function ID identifies the definition; its name is a label within a namespace.")
 (:id "base-function" :title "Base function" :say "A [graph function](#term/graph-function) with a registered host-language implementation. Composed functions obtain the implementation through their parents and supply arguments through graph [bindings](#term/binding). A base function is distinct from the base branch used in version resolution.")
 (:id "context" :title "Execution context" :say "The runtime value carrying storage, implementations, caches, and execution policy. It determines the data and branch visible to a call. A branch-specific context may resolve the same function ID differently from another context.")
 (:id "compiled-registry" :title "Compiled registry" :say "A map from [graph function](#term/graph-function) IDs to callable Clojure [closures](#term/closure) produced by compilation. It is cached in an [execution context](#term/context) and updated or invalidated after relevant graph changes. This is different from the type registry or package inventory.")
 (:id "closure" :title "Closure" :say "A callable function that retains values from the environment in which it was created. In this tour, graph reachability is called the [reachable graph](#term/reachable-graph); it must not be confused with a callable closure.")
 (:id "slot" :title "Argument slot" :say "The identity of a named, typed graph argument. Functions expose slots through `fn-slot` links; the same slot identity can be shared by several functions. Renaming may create a view linked through source-slot-id. Slot identity is different from its displayed name and from a [concurrency permit](#term/concurrency-permit).")
 (:id "binding" :title "Binding" :say "Stored information specifying a graph argument: a literal value, a reference, sequence items, or caller-supplied input. Effective bindings can be inherited. This differs from Clojure [dynamic bindings](#term/dynamic-binding), which temporarily supply values to dynamic vars during execution.")
 (:id "dynamic-binding" :title "Clojure dynamic binding" :say "A Clojure var declared `^:dynamic` can receive a temporary, thread-local value through `binding`. Nested calls see that value until the scope exits and restores the earlier value. Graphden uses this for execution policy, tracing, and cancellation. Asynchronous work must convey these bindings when it needs the same context. This does not create a stored graph [binding](#term/binding) or a lexical [closure capture](#term/capture).")
 (:id "free-argument" :title "Free argument" :say "An input that the current function has not supplied internally and exposes to its caller. Identity comes from the underlying [slot](#term/slot) even when its public name changes. Some free arguments reached through a callback are supplied by [capture](#term/capture).")
 (:id "inheritance" :title "Function inheritance" :say "A [graph function](#term/graph-function) names parent functions and inherits their argument structure and [bindings](#term/binding), subject to the graph rules. Multiple inheritance combines several parents. This parent relation uses parent-ids; branch ancestry uses base-branch-id and is separate.")
 (:id "thunk" :title "Deferred computation / thunk" :say "A callable wrapper representing work to perform when an argument is read. A delay also defers work and caches its result. Deferral allows a conditional to leave the unselected branch unevaluated; it is not a promise that every deferred result is cached forever.")
 (:id "hof" :title "Higher-order function / HOF" :say "A function that accepts or returns another callable function, such as map accepting a per-element callback. Graphden uses function types and parameter metadata to distinguish arguments passed on each callback invocation from [captured input](#term/capture).")
 (:id "capture" :title "Closure capture" :say "Supplying a callback [free argument](#term/free-argument) from the enclosing caller instead of treating it as a per-invocation parameter. For example, a callback can receive each item from map while retaining a threshold supplied by its caller.")
 (:id "effect" :title "Effect" :say "An operation involving external state or the environment, such as network access or a database write. Declared effect information supports checks; runtime enforcement checks actual recorded effects against the currently allowed set. A pure function has no such effects.")
 (:id "invalidation" :title "Cache invalidation" :say "Marking cached data as no longer current, removing it, or updating affected entries after a change. An epoch is a counter used to detect whether cached data was built before relevant changes. Notifications can accelerate this process but may be missed.")
 (:id "memoization" :title "Memoization" :say "Remembering a function result under a key derived from its inputs so a repeated request can reuse it. Correctness depends on the key including relevant inputs and on the lifetime of the cache; per-execution caching differs from process-wide caching.")
 (:id "topological-order" :title "Dependency order" :say "An ordering in which each dependency is processed before the function or package that needs it. A topological ordering exists for an acyclic directed graph. This is not necessarily the visual order of nodes on the canvas.")
 (:id "reachable-graph" :title "Reachable graph / BFS / DFS" :say "The nodes reached by repeatedly following the relevant reference edges from a starting node. Breadth-first search (BFS) visits one distance level at a time; depth-first search (DFS) follows a path before returning. Which edges count depends on the traversal contract.")
 (:id "protocol" :title "Protocol and storage decorator" :say "A Clojure protocol declares methods implemented by different backends. A storage decorator implements the same protocol while wrapping another storage object, adding behavior such as branch resolution without changing caller method names.")
 (:id "advisory-lock" :title "Advisory lock" :say "A PostgreSQL lock selected explicitly by application code using a shared key. It coordinates cooperating callers, for example around a uniqueness check and write. Transaction-scoped locks release at transaction end; session locks belong to the connection.")
 (:id "cte" :title "Recursive SQL / CTE" :say "A common table expression (CTE) gives a named intermediate query result using WITH. WITH RECURSIVE allows subsequent rows to refer to earlier results; Graphden uses it to traverse references in the database.")
 (:id "branch-view" :title "Resolved branch view" :say "The effective entity rows visible on a branch after considering own versions, branch ancestry, merged versions, and [deletion markers](#term/tombstone). Identity rows identify entities; version rows carry branch-dependent content. A comparison resolves each branch independently.")
 (:id "tombstone" :title "Deletion marker / tombstone" :say "A version recording that an entity is deleted in a branch view. It can hide inherited content without physically deleting a shared identity. Physical deletion has stricter cross-branch safety checks.")
 (:id "branch-local" :title "Branch-local function" :say "A function excluded from normal merge propagation when it or an ancestor has branch-local? true. The effective flag is inherited by OR: false on a descendant does not undo a true ancestor. This mechanism is intended for branch-specific configuration.")
 (:id "subtype" :title "Subtyping and refinement" :say "Actual is a subtype of expected when every value allowed by actual is also allowed by expected. A refinement restricts a base type with a condition, such as an integer greater than zero. Nullability concerns whether null is allowed, not whether a field must be present.")
 (:id "unification" :title "Type variables and unification" :say "A type variable stands for a type not yet fixed, such as the element type a in a list. Unification chooses compatible substitutions for variables. The occurs check rejects substitutions that make a variable contain itself. Directional assignment still needs a separate check.")
 (:id "rich-types" :title "Rich-types registry" :say "A registry of computed argument types, return type, [effects](#term/effect), and related metadata for each function. It is scoped to the active branch. The compiler and UI read it, but it is separate from the [compiled registry](#term/compiled-registry) of executable [closures](#term/closure).")
 (:id "secret" :title "Secret marking and redaction" :say "A secret type marker tracks whether a value may reveal sensitive input. Propagation keeps that marker through computations. Redaction removes sensitive data from persisted or displayed results; it does not mean the computation never used the original value.")
 (:id "hiccup" :title "Hiccup and DOM" :say "Hiccup represents markup as Clojure data: vectors contain a tag, optional attribute map, and children. Rendering produces HTML. DOM is the browser representation of the page; constructing Hiccup does not itself install browser event handlers.")
 (:id "ring" :title "Ring, Reitit, and middleware" :say "Ring represents HTTP requests and responses as Clojure maps; a handler maps a request to a response. Middleware wraps a handler to add processing. Reitit matches request paths and methods to route handlers.")
 (:id "htmx" :title "HTMX and partial fragments" :say "HTMX uses HTML attributes to request and replace page fragments. In this editor, partials are server-rendered HTML inserted into an existing host element. Local action dispatch and stale-response protection are still browser-runtime responsibilities.")
 (:id "reconciliation" :title "Reconciliation" :say "Comparing desired configuration with actual state and applying the differences. A periodic pass can recover from missed notifications or process failure. Service reconciliation starts and stops instances; package synchronization reconciles authored definitions with stored rows.")
 (:id "concurrency-permit" :title "Execution concurrency permit" :say "An admission token used to limit concurrent execution requests, such as runs admitted for an organisation or process. A run acquires it before submission and releases it on completion or failed submission. It is not an argument [slot](#term/slot), and it is separate from the advisory-lock permits coordinating [service instances](#term/cardinality).")
 (:id "cardinality" :title "Service cardinality" :say "The service placement rule: one instance across participating executors (singleton), up to N coordinated instances (pool), or an instance per executor process (per-pod). An [advisory-lock](#term/advisory-lock) permit enforces coordinated counts; it is unrelated to a function [argument slot](#term/slot).")
 (:id "fleet" :title "Execution fleet and cell" :say "A fleet is a group of executor processes. A cell identifies the workload for an organisation and entry function. Placement maps that cell to the executor serving it; a heartbeat records that an instance is still active.")
 (:id "sse" :title "Server-sent events / SSE" :say "A long-lived HTTP stream that lets a server deliver events to a client. Graphden uses it for [invalidation](#term/invalidation) and UI updates. PostgreSQL LISTEN/NOTIFY is a separate database notification mechanism that can feed these updates.")
 (:id "integrant" :title "Integrant and addon" :say "Integrant initializes and halts application components from configuration data and dependency references. An addon supplies extra configuration and component implementations through existing interfaces. It need not be a fork of the core application.")
 (:id "auth" :title "Authentication, authorization, and capability" :say "Authentication identifies the caller. Authorization decides whether that caller may perform an operation. A capability names one permission checked by policy. An authenticated principal is the identity information returned by an authentication provider.")
 (:id "ssrf" :title "SSRF and address revalidation" :say "Server-side request forgery makes a server contact a destination the attacker could not reach directly. Address validation must consider DNS changes and redirects: checking a name earlier is insufficient if the actual connection later uses a different address.")
 (:id "checkpoint" :title "CRaC checkpoint / restore" :say "An optional JVM facility for saving a prepared process state and restoring it later. Open sockets and other external resources need coordinated shutdown and reopening around the snapshot. Availability depends on the runtime and deployment setup.")
 (:id "edn" :title "EDN, keywords, and classpath" :say "EDN is a data format used for Graphden definitions. A keyword such as :name is distinct from the string \"name\"; namespaced keywords can identify references. The classpath is the collection of code and resource locations visible to the JVM.")
 (:id "mcp" :title "MCP" :say "Model Context Protocol: a communication protocol through which tools such as coding assistants call server-provided operations. Graphden exposes optional graph operations through its MCP package; those writes still use the normal branch and graph validation paths.")
 (:id "semver" :title "Semantic version and installation pin" :say "Semantic versions describe major, minor, and patch releases and support dependency constraints. An installation pin selects a particular package version. A pin is not the [branch-local](#term/branch-local) flag that excludes function changes from merging."))
 :blocks
 ((:id "executor" :title "Executor — running graph functions" :status "toured" :mins 89.9 :summary "From stored definitions to callable code and results."
   :steps
   ((:key "executor/execute" :n 1 :gi 0 :defn "execute" :ns "graphden.executor.interface" :file "src/graphden/executor/interface.clj" :line 72 :lang "clj" :mins 2.8 :head "(defn execute" :see (("executor/create-context" . "create-context") ("packages/add" . "add") ("executor/arg-builder" . "arg-builder")) :refs nil :siblings nil
     :say "Graphden puts composition in stored data and small operations in Clojure. For example, `{:name :three :parent :add :args {:nums [1 2]}}` describes a function returning 3; it does not define a Clojure function body. It inherits `:add`'s `:nums` slot and binds that slot to two list items. The stored form has a `fn` row, a `binding` row targeting the inherited slot, and two `binding-list-item` rows. The parent's `fn-slot` links its function to the immutable slot. See the existing arithmetic examples in [core.tests](../../resources/packages/core/tests/fns.edn).

The executor compiles this description into a callable Clojure function. References prepare deferred inputs: an `:if` implementation reads only its selected branch, so the other branch does not run. Defaults and composition belong in `fns.edn`; add an `impls.clj` primitive when an operation needs a host library or runtime facility. This keeps dependencies visible instead of hiding a pipeline inside one implementation.

`execute` accepts an [execution context](#term/context), a [graph function](#term/graph-function) ID (`fn-id`), and named [free arguments](#term/free-argument). The context determines which storage and branch the call sees. This public entry validates the argument map and delegates execution to `compile-runtime`.")
    (:key "executor/execute~2" :n 2 :gi 1 :defn "execute" :ns "graphden.executor.compile-runtime" :file "src/graphden/executor/compile_runtime.clj" :line 1621 :lang "clj" :mins 4.0 :head "(defn execute" :see (("executor/registry" . "registry")) :refs nil :siblings (("executor/registry" . "registry") ("executor/rebuild!" . "rebuild!") ("executor/record-effect!" . "record-effect!") ("platform/cloud-forbidden-effects" . "cloud-forbidden-effects"))
     :say "Runs a previously compiled [graph function](#term/graph-function). It first checks cancellation and any configured execution-permission guard, then binds the [allowed effects](#term/effect) for the call. The [compiled registry](#term/compiled-registry) maps function IDs to [closures](#term/closure): callable Clojure functions retaining their prepared dependencies. `execute` looks up the [closure](#term/closure), translates named input into slot-ID and name keys, and calls `(closure translated ctx)`.")
    (:key "executor/create-context" :n 3 :gi 2 :defn "create-context" :ns "graphden.executor.context" :file "src/graphden/executor/context.clj" :line 409 :lang "clj" :mins 9.5 :head "(defn create-context" :see nil :refs (("executor/execute" . "execute") ("versioning/build-branch-ctx" . "build-branch-ctx") ("boot/context" . "context")) :siblings (("executor/fill-graph-cache!" . "fill-graph-cache!"))
     :say "Creates an [execution context](#term/context): storage, [base-function](#term/base-function) implementations, [compiled registry](#term/compiled-registry), graph caches, and permission/[effect](#term/effect) checks. The [compiled registry](#term/compiled-registry) is filled when needed. Two contexts can resolve the same `fn-id` differently, for example when they select different branches.")
    (:key "executor/fill-graph-cache!" :n 4 :gi 3 :defn "fill-graph-cache!" :ns "graphden.executor.context" :file "src/graphden/executor/context.clj" :line 362 :lang "clj" :mins 2.4 :head "(defn fill-graph-cache!" :see nil :refs nil :siblings (("executor/create-context" . "create-context"))
     :say "Loads the graph cache while protecting concurrent writes. Before reading storage, the loader records the [invalidation](#term/invalidation) [epoch](#term/invalidation), a counter incremented when data changes. It installs its result under a lock only if that counter is unchanged; otherwise an older read could overwrite the graph installed by a newer write.")
    (:key "executor/registry" :n 5 :gi 4 :defn "registry" :ns "graphden.executor.compile-runtime" :file "src/graphden/executor/compile_runtime.clj" :line 1049 :lang "clj" :mins 2.8 :head "(defn registry" :see (("executor/rebuild!" . "rebuild!")) :refs (("executor/execute~2" . "execute") ("boot/compiled-registry" . "compiled-registry")) :siblings (("executor/execute~2" . "execute") ("executor/rebuild!" . "rebuild!") ("executor/record-effect!" . "record-effect!") ("platform/cloud-forbidden-effects" . "cloud-forbidden-effects"))
     :say "Returns the [compiled registry](#term/compiled-registry), a map from function IDs to Clojure [closures](#term/closure). An existing registry can be served while a background rebuild refreshes it. If no registry exists yet, compilation runs under the [invalidation](#term/invalidation) lock; a second check prevents concurrent callers from compiling the same context twice. Later writes can invalidate or update this registry.")
    (:key "executor/rebuild!" :n 6 :gi 5 :defn "rebuild!" :ns "graphden.executor.compile-runtime" :file "src/graphden/executor/compile_runtime.clj" :line 698 :lang "clj" :mins 3.4 :head "(defn rebuild!" :see (("executor/build-lookups" . "build-lookups") ("executor/compile-all" . "compile-all")) :refs (("executor/registry" . "registry") ("storage/ExecutionGraph" . "ExecutionGraph") ("boot/compiled-registry" . "compiled-registry")) :siblings (("executor/execute~2" . "execute") ("executor/registry" . "registry") ("executor/record-effect!" . "record-effect!") ("platform/cloud-forbidden-effects" . "cloud-forbidden-effects"))
     :say "Reads stored graph rows, builds lookup indexes, and compiles functions. It then fills the graph and dependency caches and replaces the [compiled registry](#term/compiled-registry). The following steps explain how persisted function definitions become callable Clojure [closures](#term/closure).")
    (:key "executor/sync-fns-to-storage!" :n 7 :gi 6 :defn "sync-fns-to-storage!" :ns "graphden.executor.composition.core" :file "src/graphden/executor/composition/core.clj" :line 394 :lang "clj" :mins 1.5 :head "(defn sync-fns-to-storage!" :see nil :refs (("packages/sync-namespaces!" . "sync-namespaces!") ("web/sync-fn-defs-branch!" . "sync-fn-defs-branch!")) :siblings nil
     :say "Synchronizes authored function definitions into function, [slot](#term/slot), and [binding](#term/binding) rows. This writes the persisted graph later read by `rebuild!`. Package declarations and runtime compilation therefore share the same stored graph model.")
    (:key "executor/build-lookups" :n 8 :gi 7 :defn "build-lookups" :ns "graphden.executor.compile.lookups" :file "src/graphden/executor/compile/lookups.clj" :line 103 :lang "clj" :mins 7.0 :head "(defn build-lookups" :see nil :refs (("executor/rebuild!" . "rebuild!") ("packages/resolve-slot-owner" . "resolve-slot-owner") ("editor/buildLookups" . "buildLookups") ("editor/export-plan" . "export-plan")) :siblings (("executor/root-fn" . "root-fn"))
     :say "Builds lookup maps for functions, [slots](#term/slot), [bindings](#term/binding), and list items, including `:fn-map`, `:slot-map`, and `:bindings-by-fn`. Compiler helpers use these indexes instead of repeatedly searching the raw rows. The inheritance-chain cache records the ancestors used to resolve inherited values.")
    (:key "executor/root-fn" :n 9 :gi 8 :defn "root-fn" :ns "graphden.executor.compile.lookups" :file "src/graphden/executor/compile/lookups.clj" :line 292 :lang "clj" :mins 2.0 :head "(defn root-fn" :see nil :refs nil :siblings (("executor/build-lookups" . "build-lookups"))
     :say "Follows `parent-ids` to find the root [base function](#term/base-function), whose implementation computes the result. A composed [graph function](#term/graph-function) supplies inherited or overridden arguments to that implementation. These function parents are distinct from the version branches discussed later.")
    (:key "executor/collect-bindings" :n 10 :gi 9 :defn "collect-bindings" :ns "graphden.executor.compile.bindings" :file "src/graphden/executor/compile/bindings.clj" :line 333 :lang "clj" :mins 1.5 :head "(defn collect-bindings" :see (("executor/arg-builder" . "arg-builder")) :refs nil :siblings (("executor/ref-produces-callable?" . "ref-produces-callable?"))
     :say "Classifies the root [slots](#term/slot) through `classify-slot`: `:value`, `:free`, `:ref`, `:seq`, `:resolved-value`, or `:fn-ref`. These describe how to obtain each argument: read a value, receive caller input, evaluate a reference, assemble a sequence, use a resolved value, or pass function identity. Results are [memoized](#term/memoization) in the lookup data for compilation.")
    (:key "executor/compile-all" :n 11 :gi 10 :defn "compile-all" :ns "graphden.executor.compile-eager" :file "src/graphden/executor/compile_eager.clj" :line 1574 :lang "clj" :mins 4.7 :head "(defn compile-all" :see (("executor/compile-fn" . "compile-fn")) :refs (("executor/rebuild!" . "rebuild!") ("types/record-rich-types!" . "record-rich-types!")) :siblings (("executor/compile-fn" . "compile-fn") ("executor/arg-builder" . "arg-builder") ("executor/resolve-impl" . "resolve-impl") ("executor/call-with-cache" . "call-with-cache") ("executor/hof-wrap" . "hof-wrap"))
     :say "Compiles functions in [dependency order](#term/topological-order): a referenced function must be available before a caller uses it. The process cache is keyed by graph structure, [base-function](#term/base-function) implementations, and [rich type information](#term/rich-types). Types affect whether a referenced function is passed as a callable or evaluated, so different type information must not share the same compiled result.")
    (:key "executor/compile-fn" :n 12 :gi 11 :defn "compile-fn" :ns "graphden.executor.compile-eager" :file "src/graphden/executor/compile_eager.clj" :line 1280 :lang "clj" :mins 8.3 :head "(defn compile-fn" :see (("executor/arg-builder" . "arg-builder") ("executor/resolve-impl" . "resolve-impl")) :refs (("executor/compile-all" . "compile-all")) :siblings (("executor/compile-all" . "compile-all") ("executor/arg-builder" . "arg-builder") ("executor/resolve-impl" . "resolve-impl") ("executor/call-with-cache" . "call-with-cache") ("executor/hof-wrap" . "hof-wrap"))
     :say "Builds one runtime [closure](#term/closure) `(fn [fa ctx])`. It prepares argument builders, [bindings](#term/binding) to inputs outside the root's slots, and name aliases at compile time. At execution time the [closure](#term/closure) assembles the argument map from caller input and those builders, then calls `(impl args ctx)`.")
    (:key "executor/arg-builder" :n 13 :gi 12 :defn "arg-builder" :ns "graphden.executor.compile-eager" :file "src/graphden/executor/compile_eager.clj" :line 1055 :lang "clj" :mins 8.7 :head "(defn- arg-builder" :see (("executor/resolve-arg" . "resolve-arg")) :refs (("executor/execute" . "execute") ("executor/collect-bindings" . "collect-bindings") ("executor/compile-fn" . "compile-fn") ("executor/resolve-arg" . "resolve-arg") ("executor/map-fn" . "map-fn")) :siblings (("executor/compile-all" . "compile-all") ("executor/compile-fn" . "compile-fn") ("executor/resolve-impl" . "resolve-impl") ("executor/call-with-cache" . "call-with-cache") ("executor/hof-wrap" . "hof-wrap"))
     :say "Builds a [deferred computation](#term/thunk) for one argument. Values are constants; [free arguments](#term/free-argument) read caller input by [slot](#term/slot) ID with a name fallback; references use [thunks](#term/thunk) or delays; sequences compute their elements lazily. A base implementation therefore evaluates only the arguments it reads, which permits short-circuiting conditionals.")
    (:key "executor/resolve-impl" :n 14 :gi 13 :defn "resolve-impl" :ns "graphden.executor.compile-eager" :file "src/graphden/executor/compile_eager.clj" :line 814 :lang "clj" :mins 1.0 :head "(defn- resolve-impl" :see (("executor/defbase" . "defbase")) :refs (("executor/compile-fn" . "compile-fn") ("packages/fn-def->base-fn-def" . "fn-def->base-fn-def")) :siblings (("executor/compile-all" . "compile-all") ("executor/compile-fn" . "compile-fn") ("executor/arg-builder" . "arg-builder") ("executor/call-with-cache" . "call-with-cache") ("executor/hof-wrap" . "hof-wrap"))
     :say "Finds the root [base function](#term/base-function)'s Clojure implementation in `lookups[:base-fns]` by name. A missing registration raises `:compile/missing-impl`. This lookup connects a stored graph definition to executable host code.")
    (:key "executor/defbase" :n 15 :gi 14 :defn "defbase" :ns "graphden.executor.defbase" :file "src/graphden/executor/defbase.clj" :line 141 :lang "clj" :mins 2.5 :head "(defmacro defbase" :see (("executor/resolve-arg" . "resolve-arg")) :refs (("executor/resolve-impl" . "resolve-impl") ("packages/add" . "add")) :siblings nil
     :say "Defines a base implementation whose argument symbols read from the runtime argument map through `resolve-arg`. The macro rewrites the declaration into a Clojure function receiving arguments and context, while preserving lazy access to referenced arguments.")
    (:key "executor/resolve-arg" :n 16 :gi 15 :defn "resolve-arg" :ns "graphden.executor.runtime" :file "src/graphden/executor/runtime.clj" :line 59 :lang "clj" :mins 1.4 :head "(defn resolve-arg" :see (("executor/arg-builder" . "arg-builder")) :refs (("executor/arg-builder" . "arg-builder") ("executor/defbase" . "defbase")) :siblings nil
     :say "Reads one argument: evaluates a [thunk](#term/thunk) when needed, dereferences a delay or another value implementing `IDeref` (the Clojure interface for `deref`/`@`), or returns an ordinary value. The base implementation triggers referenced computations only by reading the corresponding argument. Compare with `arg-builder`, which prepared that deferred value.")
    (:key "executor/record-effect!" :n 17 :gi 16 :defn "record-effect!" :ns "graphden.executor.compile-runtime" :file "src/graphden/executor/compile_runtime.clj" :line 1563 :lang "clj" :mins 2.1 :head "(defn record-effect!" :see (("platform/cloud-forbidden-effects" . "cloud-forbidden-effects") ("editor/evaluate" . "evaluate")) :refs (("editor/submitExecution" . "submitExecution") ("editor/aggregatePathTrace" . "aggregatePathTrace") ("editor/evaluate" . "evaluate")) :siblings (("executor/execute~2" . "execute") ("executor/registry" . "registry") ("executor/rebuild!" . "rebuild!") ("platform/cloud-forbidden-effects" . "cloud-forbidden-effects"))
     :say "An effectful primitive calls this before touching external state. It rejects an operation outside the execution's allowed effect set, then records the effect for tracing. Declaring effects for type inference is a separate responsibility; this runtime check enforces the current policy. An empty allowed set rejects every recorded effect, while nil means unrestricted execution.")
    (:key "executor/call-with-cache" :n 18 :gi 17 :defn "call-with-cache" :ns "graphden.executor.compile-eager" :file "src/graphden/executor/compile_eager.clj" :line 706 :lang "clj" :mins 3.1 :head "(defn- call-with-cache" :see nil :refs nil :siblings (("executor/compile-all" . "compile-all") ("executor/compile-fn" . "compile-fn") ("executor/arg-builder" . "arg-builder") ("executor/resolve-impl" . "resolve-impl") ("executor/hof-wrap" . "hof-wrap"))
     :say "Caches referenced-function results during one top-level execution. The key includes the referenced function ID and the relevant [free arguments](#term/free-argument); a sentinel distinguishes a cached nil from a missing entry. Reusing a result avoids evaluating the same dependency repeatedly within that call.")
    (:key "executor/map-fn" :n 19 :gi 18 :defn "map-fn" :ns "resources/packages/core/hof/impls.clj" :file "resources/packages/core/hof/impls.clj" :line 11 :lang "clj" :mins 1.4 :head "(defbase map-fn [func coll]" :see (("executor/arg-builder" . "arg-builder")) :refs nil :siblings nil
     :say "`map-fn` is a [higher-order function](#term/hof): `func` receives a callable prepared by `hof-wrap`. `doall` realizes the result sequence while the Clojure [dynamic bindings](#term/dynamic-binding) for [effect](#term/effect) checks, tracing, and cancellation are still active. Deferring realization beyond this scope would run the callbacks after those [dynamic bindings](#term/dynamic-binding) had ended.")
    (:key "executor/fix-fn" :n 20 :gi 19 :defn "fix-fn" :ns "resources/packages/core/recursion/impls.clj" :file "resources/packages/core/recursion/impls.clj" :line 20 :lang "clj" :mins 2.4 :head "(defbase fix-fn" :see nil :refs nil :siblings nil
     :say "Implements explicit recursion. Direct cycles through `ref-fn-id` are rejected during writes; `:fix` instead passes `{:input … :self …}` to its step function, which may call `:self`. `*max-recursion-depth*` bounds recursion depth. [Recursion design](../../docs/RECURSION.md) explains the alternatives considered.")
    (:key "executor/hof-lambda-params" :n 21 :gi 20 :defn "hof-lambda-params" :ns "graphden.executor.compile.renames" :file "src/graphden/executor/compile/renames.clj" :line 1011 :lang "clj" :mins 7.2 :head "(defn hof-lambda-params" :see nil :refs (("executor/ref-produces-callable?" . "ref-produces-callable?") ("executor/hof-wrap" . "hof-wrap")) :siblings (("executor/build-ref-renames" . "build-ref-renames") ("executor/compute-rename-aliases" . "compute-rename-aliases"))
     :say "Determines which [free arguments](#term/free-argument) are callback parameters and which are captured from the caller. An explicit `:lambda-params` takes precedence; an empty vector [captures](#term/capture) every [free argument](#term/free-argument). Otherwise an unambiguous structural function type supplies the parameter names. See [closure capture](../../docs/CLOSURE_CAPTURE.md).")
    (:key "executor/ref-produces-callable?" :n 22 :gi 21 :defn "ref-produces-callable?" :ns "graphden.executor.compile.bindings" :file "src/graphden/executor/compile/bindings.clj" :line 220 :lang "clj" :mins 1.9 :head "(defn- ref-produces-callable?" :see (("executor/hof-lambda-params" . "hof-lambda-params")) :refs (("executor/hof-wrap" . "hof-wrap")) :siblings (("executor/collect-bindings" . "collect-bindings"))
     :say "Distinguishes a callback from a constructor that returns a callback. A reference whose registered return type is a function type is evaluated to obtain the callable value. Other references in function-typed slots are wrapped without executing their bodies. The decision follows types and inherited return declarations, never function names. A marked callable keeps its marker in the stored type; invocation propagates that marker to its result and retains the callable's effect requirements. The [query constructor example](../../docs/tutorial/09-higher-order-functions.md) uses this distinction to capture connection parameters in an ordinary graph.")
    (:key "executor/hof-wrap" :n 23 :gi 22 :defn "hof-wrap" :ns "graphden.executor.compile-eager" :file "src/graphden/executor/compile_eager.clj" :line 975 :lang "clj" :mins 1.8 :head "(defn- hof-wrap" :see (("executor/hof-lambda-params" . "hof-lambda-params") ("executor/ref-produces-callable?" . "ref-produces-callable?")) :refs nil :siblings (("executor/compile-all" . "compile-all") ("executor/compile-fn" . "compile-fn") ("executor/arg-builder" . "arg-builder") ("executor/resolve-impl" . "resolve-impl") ("executor/call-with-cache" . "call-with-cache"))
     :say "Prepares an ordinary referenced function as a callable. The wrapper captures the current input values and execution context; its declared callback parameters receive values at each invocation. This is the runtime counterpart of `:lambda-params`, with no separate environment object in the stored graph. Callable constructors take the evaluation path described by `ref-produces-callable?` instead.")
    (:key "executor/build-ref-renames" :n 24 :gi 23 :defn "build-ref-renames" :ns "graphden.executor.compile.renames" :file "src/graphden/executor/compile/renames.clj" :line 1120 :lang "clj" :mins 3.9 :head "(defn build-ref-renames" :see (("crud/public-free-entries" . "public-free-entries")) :refs (("packages/build-rename-slot-records" . "build-rename-slot-records")) :siblings (("executor/hof-lambda-params" . "hof-lambda-params") ("executor/compute-rename-aliases" . "compute-rename-aliases"))
     :say "Builds the name translation at a reference call. If a caller exposes an argument under a new name but the referenced function still uses its original name, the translation supplies the value under the referenced function's name. See the [inherited rename design](../../docs/adr/ADR-inherited-rename-surface.md).")
    (:key "executor/compute-rename-aliases" :n 25 :gi 24 :defn "compute-rename-aliases" :ns "graphden.executor.compile.renames" :file "src/graphden/executor/compile/renames.clj" :line 1204 :lang "clj" :mins 2.6 :head "(defn compute-rename-aliases" :see nil :refs nil :siblings (("executor/hof-lambda-params" . "hof-lambda-params") ("executor/build-ref-renames" . "build-ref-renames"))
     :say "Computes aliases for inherited rename chains that reach outside the root's own [slot](#term/slot) set. For example, an internal reader of `:branch-row` can receive input exposed publicly as `:item`. The aliases are prepared at compile time and copied into the input map at runtime; the docstring contains a worked example.")))
  (:id "storage" :title "Storage — schemas and graph reads" :status "toured" :mins 64.2 :summary "Protocols, rows, traversal, and change notifications."
   :steps
   ((:key "storage/Storage" :n 1 :gi 25 :defn "Storage" :ns "graphden.storage.protocol.core" :file "src/graphden/storage/protocol/core.clj" :line 79 :lang "clj" :mins 1.0 :head "(defprotocol Storage" :see nil :refs nil :siblings (("storage/StorageCRUD" . "StorageCRUD") ("storage/ExecutionGraph" . "ExecutionGraph"))
     :say "Defines the storage lifecycle [protocol](#term/protocol): initialize a backend with a data schema, then close its resources when finished. Row operations and reachable-graph queries are separate [protocols](#term/protocol) shown next.")
    (:key "storage/StorageCRUD" :n 2 :gi 26 :defn "StorageCRUD" :ns "graphden.storage.protocol.core" :file "src/graphden/storage/protocol/core.clj" :line 115 :lang "clj" :mins 3.3 :head "(defprotocol StorageCRUD" :see nil :refs (("storage/resolve-execution-graph" . "resolve-execution-graph") ("platform/RemoteStorage" . "RemoteStorage")) :siblings (("storage/Storage" . "Storage") ("storage/ExecutionGraph" . "ExecutionGraph"))
     :say "Defines row operations such as `read-entity`, `query-entities`, and `create-entity`. These [protocol](#term/protocol) methods let graph code read and write entities without depending on a concrete database implementation.")
    (:key "storage/ExecutionGraph" :n 3 :gi 27 :defn "ExecutionGraph" :ns "graphden.storage.protocol.core" :file "src/graphden/storage/protocol/core.clj" :line 276 :lang "clj" :mins 0.9 :head "(defprotocol ExecutionGraph" :see (("executor/rebuild!" . "rebuild!")) :refs nil :siblings (("storage/Storage" . "Storage") ("storage/StorageCRUD" . "StorageCRUD"))
     :say "Defines `resolve-execution-graph`: given a root function ID, return the [reachable graph](#term/reachable-graph) and its indexes. Generic and PostgreSQL implementations follow below. This is a separate API from the executor's full-registry rebuild, which currently queries the graph entity tables through `StorageCRUD`.")
    (:key "storage/DataSchema" :n 4 :gi 28 :defn "DataSchema" :ns "graphden.schema.protocol.protocol" :file "src/graphden/schema/protocol/protocol.clj" :line 28 :lang "clj" :mins 5.8 :head "(defprotocol DataSchema" :see nil :refs nil :siblings nil
     :say "Defines how consumers inspect entity declarations, fields, and field types such as references, enums, and unions. Storage uses this schema data to understand rows before reading or writing them.")
    (:key "storage/MalliDataSchema" :n 5 :gi 29 :defn "MalliDataSchema" :ns "graphden.schema.malli.core" :file "src/graphden/schema/malli/core.clj" :line 12 :lang "clj" :mins 2.1 :head "(defrecord MalliDataSchema" :see (("boot/postgres" . "postgres")) :refs nil :siblings nil
     :say "Implements `DataSchema` with immutable maps of entities, enums, entity UUIDs, and retired fields. [Protocol](#term/protocol) methods read those maps. `create-builder` constructs the initial schema; each subsystem's `extend-builder` adds its declarations.")
    (:key "storage/extend-builder" :n 6 :gi 30 :defn "extend-builder" :ns "graphden.schema.graph.schema" :file "src/graphden/schema/graph/schema.clj" :line 641 :lang "clj" :mins 11.4 :head "(defn extend-builder" :see nil :refs nil :siblings nil
     :say "Declares the graph entities, their fields, reference edges, and uniqueness constraints. The schema builder turns these declarations into database tables and indexes. Retired-field declarations prevent obsolete columns such as `binding.rename-to` from being recreated.")
    (:key "storage/valid-type?" :n 7 :gi 31 :defn "valid-type?" :ns "graphden.schema.fields.types" :file "src/graphden/schema/fields/types.clj" :line 160 :lang "clj" :mins 1.0 :head "(defn valid-type?" :see nil :refs nil :siblings nil
     :say "Checks actual field values against declared storage types. Known types have predicates; unknown types are currently accepted. Row-write validation calls this function, so its permissiveness is part of the current storage contract.")
    (:key "storage/ExecutionGraphResult" :n 8 :gi 32 :defn "ExecutionGraphResult" :ns "graphden.storage.protocol.graph" :file "src/graphden/storage/protocol/graph.clj" :line 86 :lang "clj" :mins 0.7 :head "(defrecord ExecutionGraphResult" :see nil :refs nil :siblings (("storage/->execution-graph" . "->execution-graph") ("storage/process-fn-node" . "process-fn-node") ("storage/resolve-execution-graph-bfs" . "resolve-execution-graph-bfs"))
     :say "Defines the resolved execution-graph result: entity collections together with indexes by function and [binding](#term/binding). Both generic and PostgreSQL resolvers return this same structure.")
    (:key "storage/->execution-graph" :n 9 :gi 33 :defn "->execution-graph" :ns "graphden.storage.protocol.graph" :file "src/graphden/storage/protocol/graph.clj" :line 96 :lang "clj" :mins 1.8 :head "(defn ->execution-graph" :see nil :refs (("storage/resolve-execution-graph~2" . "resolve-execution-graph")) :siblings (("storage/ExecutionGraphResult" . "ExecutionGraphResult") ("storage/process-fn-node" . "process-fn-node") ("storage/resolve-execution-graph-bfs" . "resolve-execution-graph-bfs"))
     :say "Assembles an execution-graph result and its lookup indexes from loaded entity collections. Both resolver implementations share this construction step.")
    (:key "storage/process-fn-node" :n 10 :gi 34 :defn "process-fn-node" :ns "graphden.storage.protocol.graph" :file "src/graphden/storage/protocol/graph.clj" :line 149 :lang "clj" :mins 2.2 :head "(defn process-fn-node" :see nil :refs (("storage/reachable-fns-sql" . "reachable-fns-sql")) :siblings (("storage/ExecutionGraphResult" . "ExecutionGraphResult") ("storage/->execution-graph" . "->execution-graph") ("storage/resolve-execution-graph-bfs" . "resolve-execution-graph-bfs"))
     :say "Collects the outgoing references of one function: parents, type references, and functions referenced by [bindings](#term/binding) or list items. The reachable-graph traversal uses these edges to decide which functions to visit next.")
    (:key "storage/resolve-execution-graph-bfs" :n 11 :gi 35 :defn "resolve-execution-graph-bfs" :ns "graphden.storage.protocol.graph" :file "src/graphden/storage/protocol/graph.clj" :line 176 :lang "clj" :mins 2.3 :head "(defn resolve-execution-graph-bfs" :see nil :refs nil :siblings (("storage/ExecutionGraphResult" . "ExecutionGraphResult") ("storage/->execution-graph" . "->execution-graph") ("storage/process-fn-node" . "process-fn-node"))
     :say "Traverses the [reachable graph](#term/reachable-graph) [breadth first](#term/reachable-graph) ([BFS](#term/reachable-graph)): visit the current functions, collect their references, then visit previously unseen targets. PostgreSQL's [recursive query](#term/cte) implements the same edge traversal in the database.")
    (:key "storage/resolve-execution-graph" :n 12 :gi 36 :defn "resolve-execution-graph" :ns "graphden.storage.protocol.generic-graph" :file "src/graphden/storage/protocol/generic_graph.clj" :line 36 :lang "clj" :mins 1.5 :head "(defn resolve-execution-graph" :see (("storage/StorageCRUD" . "StorageCRUD")) :refs nil :siblings nil
     :say "Implements reachable-graph resolution using generic row loaders and [breadth-first](#term/reachable-graph) traversal. It works with any `StorageCRUD` backend, but the number of database calls grows with the visited graph. The PostgreSQL-specific resolver below batches those reads.")
    (:key "storage/PostgresStorage" :n 13 :gi 37 :defn "PostgresStorage" :ns "graphden.storage.postgres.core" :file "src/graphden/storage/postgres/core.clj" :line 136 :lang "clj" :mins 12.4 :head "(defrecord PostgresStorage" :see nil :refs nil :siblings nil
     :say "Implements the storage [protocols](#term/protocol) for PostgreSQL, mostly by delegating each method to a helper. Its `ExecutionGraph` implementation selects the optimized PostgreSQL resolver rather than the generic traversal. Read the [protocol](#term/protocol) headings to distinguish lifecycle, row operations, constraints, and graph resolution.")
    (:key "storage/do-initialize" :n 14 :gi 38 :defn "do-initialize" :ns "graphden.storage.postgres.migration" :file "src/graphden/storage/postgres/migration.clj" :line 286 :lang "clj" :mins 2.9 :head "(defn do-initialize" :see nil :refs nil :siblings nil
     :say "Compares the declared schema with stored metadata and applies the required database changes in a transaction. A transaction-scoped [advisory lock](#term/advisory-lock) is acquired before reading metadata, so concurrent process startups do not plan migrations against the same outdated state. See [operations](../../docs/OPERATIONS.md).")
    (:key "storage/reachable-fns-sql" :n 15 :gi 39 :defn "reachable-fns-sql" :ns "graphden.storage.postgres.graph" :file "src/graphden/storage/postgres/graph.clj" :line 44 :lang "clj" :mins 4.4 :head "(def ^:private reachable-fns-sql" :see (("storage/process-fn-node" . "process-fn-node")) :refs nil :siblings (("storage/resolve-execution-graph~2" . "resolve-execution-graph"))
     :say "Builds a [recursive SQL](#term/cte) [common table expression](#term/cte) ([CTE](#term/cte)) that follows outgoing references from the starting function and returns reachable function IDs. Compare its edge list with `process-fn-node` to check that SQL and Clojure traversals include the same dependencies.")
    (:key "storage/resolve-execution-graph~2" :n 16 :gi 40 :defn "resolve-execution-graph" :ns "graphden.storage.postgres.graph" :file "src/graphden/storage/postgres/graph.clj" :line 118 :lang "clj" :mins 4.6 :head "(defn resolve-execution-graph" :see (("storage/->execution-graph" . "->execution-graph")) :refs nil :siblings (("storage/reachable-fns-sql" . "reachable-fns-sql"))
     :say "Runs the [recursive query](#term/cte) for reachable function IDs, checks the graph-size limit, then loads related entity rows in batches and assembles the result. Batching keeps database round trips independent of the number of visited functions.")
    (:key "storage/candidate-ids" :n 17 :gi 41 :defn "candidate-ids" :ns "graphden.storage.bounded-query" :file "src/graphden/storage/bounded_query.clj" :line 29 :lang "clj" :mins 1.3 :head "(defn candidate-ids" :see nil :refs nil :siblings nil
     :say "Loads a limited set of identity IDs before reading their values. The optional `StorageBoundedQuery` [protocol](#term/protocol) supports owner queries for function slots, bindings, and list items. Ownership can change in version rows, so candidate discovery considers every stored version; ordinary branch resolution then selects the visible rows. Exceeding the candidate limit or using an unsupported backend rejects the operation rather than returning an incomplete component graph. UI component export uses this path.")
    (:key "storage/make-emitter" :n 18 :gi 42 :defn "make-emitter" :ns "graphden.storage.postgres.notify" :file "src/graphden/storage/postgres/notify.clj" :line 319 :lang "clj" :mins 2.4 :head "(defn make-emitter" :see (("crud/notify-after-write!" . "notify-after-write!")) :refs nil :siblings (("storage/create-listener" . "create-listener"))
     :say "Creates the write-notification sender. After a write, it sends `pg_notify` through the pooled DataSource so other processes can refresh their state promptly. Notification failure does not undo the stored write; [reconciliation](#term/reconciliation) remains responsible for recovering current state.")
    (:key "storage/create-listener" :n 19 :gi 43 :defn "create-listener" :ns "graphden.storage.postgres.notify" :file "src/graphden/storage/postgres/notify.clj" :line 259 :lang "clj" :mins 2.2 :head "(defn create-listener" :see (("versioning/dispatch*" . "dispatch*") ("services/reconcile-once!" . "reconcile-once!")) :refs nil :siblings (("storage/make-emitter" . "make-emitter"))
     :say "Receives `graphden_events` on a dedicated PostgreSQL connection because `LISTEN` belongs to a connection session. A background thread polls and reconnects with increasing delays after failures. Callback failures are isolated; branch [invalidation](#term/invalidation), service [reconciliation](#term/reconciliation), and browser update notifications subscribe here.")))
  (:id "versioning" :title "Branches — versions and merges" :status "toured" :mins 103.7 :summary "Branch-specific reads, conflict detection, and cache refresh."
   :steps
   ((:key "versioning/wrap-with-versioning" :n 1 :gi 44 :defn "wrap-with-versioning" :ns "graphden.versioning.storage.core" :file "src/graphden/versioning/storage/core.clj" :line 1092 :lang "clj" :mins 2.1 :head "(defn wrap-with-versioning" :see nil :refs (("crud/resolve-branch-ref" . "resolve-branch-ref") ("boot/postgres" . "postgres")) :siblings (("versioning/VersionedStorage" . "VersionedStorage") ("versioning/create-entity-versioned!" . "create-entity-versioned!"))
     :say "Wraps ordinary storage with versioning, ensures a `main` branch exists, and returns storage bound to that branch. Callers retain the same storage [protocol](#term/protocol) while reads and writes gain branch-specific behavior.")
    (:key "versioning/VersionedStorage" :n 2 :gi 45 :defn "VersionedStorage" :ns "graphden.versioning.storage.core" :file "src/graphden/versioning/storage/core.clj" :line 770 :lang "clj" :mins 15.9 :head "(defrecord VersionedStorage" :see nil :refs (("editor/writeBindingFields" . "writeBindingFields")) :siblings (("versioning/wrap-with-versioning" . "wrap-with-versioning") ("versioning/create-entity-versioned!" . "create-entity-versioned!"))
     :say "This [storage decorator](#term/protocol) forwards non-versioned entities unchanged. For versioned entities it resolves reads in the current branch and appends [version rows](#term/branch-view) on writes. Follow the delegated functions to inspect each operation separately.")
    (:key "versioning/create-entity-versioned!" :n 3 :gi 46 :defn "create-entity-versioned!" :ns "graphden.versioning.storage.core" :file "src/graphden/versioning/storage/core.clj" :line 243 :lang "clj" :mins 6.0 :head "(defn- create-entity-versioned!" :see nil :refs nil :siblings (("versioning/wrap-with-versioning" . "wrap-with-versioning") ("versioning/VersionedStorage" . "VersionedStorage"))
     :say "Creates an [identity row](#term/branch-view) and a [version row](#term/branch-view), accounting for an existing deterministic ID. Function names and list positions must be unique in the [resolved branch view](#term/branch-view), so their checks and writes use an [advisory lock](#term/advisory-lock). A global table constraint would incorrectly reject legitimate differences between branches.")
    (:key "versioning/in-transaction" :n 4 :gi 47 :defn "in-transaction" :ns "graphden.storage.tx" :file "src/graphden/storage/tx.clj" :line 124 :lang "clj" :mins 2.6 :head "(defn in-transaction" :see nil :refs nil :siblings nil
     :say "Finds the underlying database pool and rebuilds the [storage-decorator](#term/protocol) chain around a transaction connection. Each write still passes through its existing [decorators](#term/protocol). Transaction-scoped [advisory locks](#term/advisory-lock) used by uniqueness checks remain held until the transaction ends.")
    (:key "versioning/call-with-write" :n 5 :gi 48 :defn "call-with-write" :ns "graphden.storage.graph-writer" :file "src/graphden/storage/graph_writer.clj" :line 145 :lang "clj" :mins 1.8 :head "(defn call-with-write" :see nil :refs (("editor/apply!" . "apply!")) :siblings nil
     :say "Keeps decisive graph reads, validation and all related writes in one database transaction. Its advisory locks serialize edits of the same organization while private writes in separate organizations can proceed together. A write to a public identity takes the shared graph's exclusive lock, including a version-only edit by a private actor. Ownership is checked again after waiting. Cache invalidation, notifications and type diagnostics are published after commit, with compilation outside the writer lock.")
    (:key "versioning/entity-config" :n 6 :gi 49 :defn "entity-config" :ns "graphden.versioning.storage.resolution" :file "src/graphden/versioning/storage/resolution.clj" :line 147 :lang "clj" :mins 3.1 :head "(def entity-config" :see nil :refs nil :siblings (("versioning/resolve-version" . "resolve-version") ("versioning/collect-branch-chain" . "collect-branch-chain") ("versioning/resolve-version-from-cache" . "resolve-version-from-cache"))
     :say "Lists the versioned entities: `:fn`, `:fn-slot`, `:binding`, `:binding-list-item`, and `:resource-override`. For each entity it distinguishes identity fields in the base table from `version-data-fields` stored in [version rows](#term/branch-view). Resolution and writes use this configuration.")
    (:key "versioning/derive-version-fields" :n 7 :gi 50 :defn "derive-version-fields" :ns "graphden.schema.versioned.schema" :file "src/graphden/schema/versioned/schema.clj" :line 561 :lang "clj" :mins 3.8 :head "(defn derive-version-fields" :see nil :refs nil :siblings nil
     :say "Derives version-table fields from the base entity declarations. Identity-level fields remain outside the version table; other fields require stable mirror IDs. Deriving both schema and write configuration from the same source prevents newly added fields from being silently omitted.")
    (:key "versioning/resolve-version" :n 8 :gi 51 :defn "resolve-version" :ns "graphden.versioning.storage.resolution" :file "src/graphden/versioning/storage/resolution.clj" :line 298 :lang "clj" :mins 1.6 :head "(defn resolve-version" :see nil :refs nil :siblings (("versioning/entity-config" . "entity-config") ("versioning/collect-branch-chain" . "collect-branch-chain") ("versioning/resolve-version-from-cache" . "resolve-version-from-cache"))
     :say "Resolves one entity as visible on a branch by reading and combining its version candidates. The selected version is returned, or nil when a [deletion marker](#term/tombstone) wins.")
    (:key "versioning/collect-branch-chain" :n 9 :gi 52 :defn "collect-branch-chain" :ns "graphden.versioning.storage.resolution" :file "src/graphden/versioning/storage/resolution.clj" :line 499 :lang "clj" :mins 1.9 :head "(defn collect-branch-chain" :see nil :refs nil :siblings (("versioning/entity-config" . "entity-config") ("versioning/resolve-version" . "resolve-version") ("versioning/resolve-version-from-cache" . "resolve-version-from-cache"))
     :say "Follows `:base-branch-id` from a branch to its parent and root, caching the resulting chain. Version resolution and [cache invalidation](#term/invalidation) use it to determine which branches can contribute visible data. This is branch ancestry, separate from [function inheritance](#term/inheritance) through `:parent-ids`.")
    (:key "versioning/resolve-version-from-cache" :n 10 :gi 53 :defn "resolve-version-from-cache" :ns "graphden.versioning.storage.resolution" :file "src/graphden/versioning/storage/resolution.clj" :line 690 :lang "clj" :mins 1.4 :head "(defn- resolve-version-from-cache" :see nil :refs nil :siblings (("versioning/entity-config" . "entity-config") ("versioning/resolve-version" . "resolve-version") ("versioning/collect-branch-chain" . "collect-branch-chain"))
     :say "Resolves cached version candidates along a branch's ancestry. At each level it considers locally written and merged versions using their effective timestamps. Single-entity and whole-graph resolution share this algorithm.")
    (:key "versioning/effective-branch-local?" :n 11 :gi 54 :defn "effective-branch-local?" :ns "graphden.versioning.branch-local" :file "src/graphden/versioning/branch_local.clj" :line 122 :lang "clj" :mins 1.6 :head "(defn effective-branch-local?" :see nil :refs (("layout/annotate" . "annotate")) :siblings nil
     :say "Returns true when a function or one of its ancestors has `:branch-local? true`. Merge resolution uses that effective flag to exclude branch-specific configuration. Setting false on a descendant does not cancel a true flag inherited from an ancestor.")
    (:key "versioning/check-list-item-position-collisions!" :n 12 :gi 55 :defn "check-list-item-position-collisions!" :ns "graphden.versioning.storage.uniqueness" :file "src/graphden/versioning/storage/uniqueness.clj" :line 27 :lang "clj" :mins 6.4 :head "(defn check-list-item-position-collisions!" :see nil :refs nil :siblings (("versioning/check-resource-override-path-collision!" . "check-resource-override-path-collision!"))
     :say "Checks list-item position uniqueness in the [resolved branch view](#term/branch-view). Both ordinary writes and merges use this check. A database constraint across all branches would prevent legitimate divergence; the write path therefore serializes the branch-specific check and write with an [advisory lock](#term/advisory-lock). Function-name uniqueness uses the same approach.")
    (:key "versioning/check-resource-override-path-collision!" :n 13 :gi 56 :defn "check-resource-override-path-collision!" :ns "graphden.versioning.storage.uniqueness" :file "src/graphden/versioning/storage/uniqueness.clj" :line 300 :lang "clj" :mins 0.8 :head "(defn check-resource-override-path-collision!" :see nil :refs nil :siblings (("versioning/check-list-item-position-collisions!" . "check-list-item-position-collisions!"))
     :say "Checks that a branch view has at most one resource override per asset path. `:resource-override` stores replacement JS/CSS content; `:read-resource-overridable` chooses the effective content when serving it. Saving changes the asset version hash so browsers request the updated file.")
    (:key "versioning/purgeable-identity-ids" :n 14 :gi 57 :defn "purgeable-identity-ids" :ns "graphden.versioning.storage.purge" :file "src/graphden/versioning/storage/purge.clj" :line 63 :lang "clj" :mins 3.5 :head "(defn purgeable-identity-ids" :see nil :refs nil :siblings nil
     :say "Decides which [identity rows](#term/branch-view) may be physically deleted. Ordinary user deletion writes a [tombstone](#term/tombstone); synchronization and rollback sometimes need physical deletion. An identity may be removed only when no other branch keeps a version and no child identity still references it, preventing dangling identities without deleting another branch's data.")
    (:key "versioning/repoint-refs!" :n 15 :gi 58 :defn "repoint-refs!" :ns "graphden.versioning.identity-repair" :file "src/graphden/versioning/identity_repair.clj" :line 52 :lang "clj" :mins 3.2 :head "(defn repoint-refs!" :see nil :refs (("packages/sync-fn-entities-from-packages!" . "sync-fn-entities-from-packages!")) :siblings nil
     :say "Repairs references after moving a packaged function between namespaces, which changes its deterministic ID. Updates references in both identity and [version rows](#term/branch-view); `purge-fn-subgraph!` removes the abandoned data when safe. The live-reference check counts current versions on live branches rather than every historical reference.")
    (:key "versioning/diff-branches" :n 16 :gi 59 :defn "diff-branches" :ns "graphden.versioning.storage.merge" :file "src/graphden/versioning/storage/merge.clj" :line 504 :lang "clj" :mins 4.4 :head "(defn diff-branches" :see nil :refs nil :siblings (("versioning/detect-conflicts" . "detect-conflicts") ("versioning/merge-branch!" . "merge-branch!"))
     :say "Compares the resolved contents of two branches, considering entities visible from either side. This read-only comparison reports their differences without deciding how a merge should resolve conflicts.")
    (:key "versioning/diff-branches-view" :n 17 :gi 60 :defn "diff-branches-view" :ns "graphden.versioning.storage.diff-view" :file "src/graphden/versioning/storage/diff_view.clj" :line 131 :lang "clj" :mins 6.0 :head "(defn diff-branches-view" :see nil :refs nil :siblings nil
     :say "Groups branch differences by owning function and adds per-field before/after values. It also resolves [slot](#term/slot) names and function references in batches. The editor's comparison and review interfaces consume this display model; the older API retains its flat row format.")
    (:key "versioning/detect-conflicts" :n 18 :gi 61 :defn "detect-conflicts" :ns "graphden.versioning.storage.merge" :file "src/graphden/versioning/storage/merge.clj" :line 295 :lang "clj" :mins 2.8 :head "(defn detect-conflicts" :see nil :refs nil :siblings (("versioning/diff-branches" . "diff-branches") ("versioning/merge-branch!" . "merge-branch!"))
     :say "Finds entities changed to different content on both branches after their fork point, excluding [branch-local functions](#term/branch-local). Effective timestamps include changes that arrived through earlier merges, not only rows originally written on that branch. These conflicts need resolution before merging.")
    (:key "versioning/merge-branch!" :n 19 :gi 62 :defn "merge-branch!" :ns "graphden.versioning.storage.merge" :file "src/graphden/versioning/storage/merge.clj" :line 760 :lang "clj" :mins 8.0 :head "(defn merge-branch!" :see nil :refs nil :siblings (("versioning/diff-branches" . "diff-branches") ("versioning/detect-conflicts" . "detect-conflicts"))
     :say "Validates conflicts and approval requirements, then writes a `branch-merge` record and any conflict-resolution overrides in one transaction. Resolution makes source versions visible through this record without copying all source rows. The result also reports rows excluded as [branch-local](#term/branch-local).")
    (:key "versioning/merge-transitively!" :n 20 :gi 63 :defn "merge-transitively!" :ns "graphden.versioning.merge.core" :file "src/graphden/versioning/merge/core.clj" :line 308 :lang "clj" :mins 4.2 :head "(defn merge-transitively!" :see nil :refs nil :siblings (("versioning/validate-approval-policy!" . "validate-approval-policy!") ("versioning/branch-content-stamp" . "branch-content-stamp"))
     :say "Merges missing ancestor branches before the requested source branch, starting with the oldest required ancestor. Each merge passes the same policy checks as a direct merge. The result lists preliminary merges in `:merged-first`. See [versioning limits](../../docs/VERSIONING.md).")
    (:key "versioning/validate-approval-policy!" :n 21 :gi 64 :defn "validate-approval-policy!" :ns "graphden.versioning.merge.core" :file "src/graphden/versioning/merge/core.clj" :line 257 :lang "clj" :mins 2.7 :head "(defn validate-approval-policy!" :see nil :refs nil :siblings (("versioning/merge-transitively!" . "merge-transitively!") ("versioning/branch-content-stamp" . "branch-content-stamp"))
     :say "Enforces a target branch's review policy. Required approvals must be distinct, current, bound to this merge target, and from allowed reviewers when `:approver-ids` restricts them. Missing valid approvals produce `:branch/approval-required` rather than allowing the merge.")
    (:key "versioning/branch-content-stamp" :n 22 :gi 65 :defn "branch-content-stamp" :ns "graphden.versioning.merge.core" :file "src/graphden/versioning/merge/core.clj" :line 141 :lang "clj" :mins 1.7 :head "(defn branch-content-stamp" :see nil :refs nil :siblings (("versioning/merge-transitively!" . "merge-transitively!") ("versioning/validate-approval-policy!" . "validate-approval-policy!"))
     :say "Computes a content stamp from the count and latest timestamp of the branch's own [version rows](#term/branch-view). An approval stores this stamp. Later edits append rows and change the stamp, so the approval no longer counts for the changed content.")
    (:key "versioning/bump!" :n 23 :gi 66 :defn "bump!" :ns "graphden.storage.postgres.graph-epoch" :file "src/graphden/storage/postgres/graph_epoch.clj" :line 118 :lang "clj" :mins 2.3 :head "(defn bump!" :see nil :refs nil :siblings nil
     :say "Increments the graph [epoch](#term/invalidation) before a graph-changing write. The branch router checks this counter when retrieving a context, so it can detect missed invalidations even when a request was interrupted or a notification was lost. Immediate cache updates and notifications reduce refresh latency.")
    (:key "versioning/build-branch-ctx" :n 24 :gi 67 :defn "build-branch-ctx" :ns "graphden.system.branch-router" :file "src/graphden/system/branch_router.clj" :line 75 :lang "clj" :mins 4.2 :head "(defn- build-branch-ctx" :see (("executor/create-context" . "create-context")) :refs nil :siblings (("versioning/dispatch*" . "dispatch*"))
     :say "Creates a branch-specific [execution context](#term/context) with storage bound to that branch, independent graph and compiled-registry caches, and a copy of the branch's [rich type information](#term/rich-types). The router binds those types while compiling and handling requests, preventing another branch's types from determining this branch's behavior.")
    (:key "versioning/dispatch*" :n 25 :gi 68 :defn "dispatch*" :ns "graphden.system.branch-router" :file "src/graphden/system/branch_router.clj" :line 892 :lang "clj" :mins 8.4 :head "(defn- dispatch*" :see nil :refs (("storage/create-listener" . "create-listener") ("web/dispatch-to-branch" . "dispatch-to-branch")) :siblings (("versioning/build-branch-ctx" . "build-branch-ctx"))
     :say "Resolves a request's branch reference from a header or query parameter and invokes that branch's handler. Unknown branches return 400. The public wrapper handles `/livez` before branch compilation so the liveness probe does not depend on the [compiled registry](#term/compiled-registry).")
    (:key "versioning/validate-graph-epoch!" :n 26 :gi 69 :defn "validate-graph-epoch!" :ns "graphden.system.branch-router.epoch" :file "src/graphden/system/branch_router/epoch.clj" :line 292 :lang "clj" :mins 3.3 :head "(defn validate-graph-epoch!" :see nil :refs nil :siblings nil
     :say "Checks graph [epochs](#term/invalidation) since the context's last recorded position and distinguishes applied, notified, in-progress, and missed changes. Missed changes trigger a background rebuild for the base context and eviction of other cached branch contexts, which rebuild on demand.")))
  (:id "types" :title "Types — validation and inference" :status "toured" :mins 84.2 :summary "Type expressions, compatibility, inference, and secret markings."
   :steps
   ((:key "types/primitives" :n 1 :gi 70 :defn "primitives" :ns "graphden.types.core.shapes" :file "src/graphden/types/core/shapes.clj" :line 23 :lang "clj" :mins 2.7 :head "(def primitives" :see nil :refs nil :siblings (("types/child-types" . "child-types") ("types/taint-with-secret-if-tainted" . "taint-with-secret-if-tainted"))
     :say "Lists primitive value types and the special types `:any` and `:never`. `:any` accepts every type; `:never` has no values. Compound types such as lists, records, and functions build on this vocabulary.")
    (:key "types/child-types" :n 2 :gi 71 :defn "child-types" :ns "graphden.types.core.shapes" :file "src/graphden/types/core/shapes.clj" :line 452 :lang "clj" :mins 1.7 :head "(defn child-types" :see nil :refs nil :siblings (("types/primitives" . "primitives") ("types/taint-with-secret-if-tainted" . "taint-with-secret-if-tainted"))
     :say "Returns the nested types inside each compound type: records, lists, maps, tuples, refinements, secrets, unions, and functions. This traversal shows the data representation used by the rest of the type checker.")
    (:key "types/well-formed?" :n 3 :gi 72 :defn "well-formed?" :ns "graphden.types.core" :file "src/graphden/types/core.clj" :line 154 :lang "clj" :mins 2.8 :head "(defn well-formed?" :see nil :refs nil :siblings (("types/make-union" . "make-union") ("types/desugar-variant" . "desugar-variant") ("types/subtype?" . "subtype?") ("types/constraint-implies?" . "constraint-implies?") ("types/unify" . "unify") ("types/strip-null" . "strip-null"))
     :say "Validates the syntax of type expressions before later checker stages use them. Cases verify the required shape of function arguments, [effects](#term/effect), refinements, secret wrappers, and other supported types.")
    (:key "types/make-union" :n 4 :gi 73 :defn "make-union" :ns "graphden.types.core" :file "src/graphden/types/core.clj" :line 231 :lang "clj" :mins 5.4 :head "(defn make-union" :see nil :refs nil :siblings (("types/well-formed?" . "well-formed?") ("types/desugar-variant" . "desugar-variant") ("types/subtype?" . "subtype?") ("types/constraint-implies?" . "constraint-implies?") ("types/unify" . "unify") ("types/strip-null" . "strip-null"))
     :say "Normalizes a union type: flattens nested unions, removes duplicates and `:never`, and removes alternatives already covered by another member. A union means that a value may have any one of its member types.")
    (:key "types/desugar-variant" :n 5 :gi 74 :defn "desugar-variant" :ns "graphden.types.core" :file "src/graphden/types/core.clj" :line 330 :lang "clj" :mins 2.5 :head "(defn desugar-variant" :see nil :refs nil :siblings (("types/well-formed?" . "well-formed?") ("types/make-union" . "make-union") ("types/subtype?" . "subtype?") ("types/constraint-implies?" . "constraint-implies?") ("types/unify" . "unify") ("types/strip-null" . "strip-null"))
     :say "Converts a variant declaration into a union of records whose tag field has a fixed value. This lets the checker use existing record, union, and [refinement](#term/subtype) rules instead of a separate runtime representation for variants.")
    (:key "types/subtype?" :n 6 :gi 75 :defn "subtype?" :ns "graphden.types.core" :file "src/graphden/types/core.clj" :line 1239 :lang "clj" :mins 13.3 :head "(defn subtype?" :see nil :refs (("types/constraint-implies?" . "constraint-implies?") ("types/taint-with-secret-if-tainted" . "taint-with-secret-if-tainted")) :siblings (("types/well-formed?" . "well-formed?") ("types/make-union" . "make-union") ("types/desugar-variant" . "desugar-variant") ("types/constraint-implies?" . "constraint-implies?") ("types/unify" . "unify") ("types/strip-null" . "strip-null"))
     :say "Tests whether every value allowed by `actual` is also allowed by `expected`. Its ordered cases handle special types, unions, primitives, refinements, structural types, and [secret markers](#term/secret). For unions, every actual alternative must fit, while an expected union needs at least one matching alternative. Read the case for the two shapes being compared.")
    (:key "types/constraint-implies?" :n 7 :gi 76 :defn "constraint-implies?" :ns "graphden.types.core" :file "src/graphden/types/core.clj" :line 1175 :lang "clj" :mins 2.6 :head "(defn constraint-implies?" :see (("types/subtype?" . "subtype?")) :refs nil :siblings (("types/well-formed?" . "well-formed?") ("types/make-union" . "make-union") ("types/desugar-variant" . "desugar-variant") ("types/subtype?" . "subtype?") ("types/unify" . "unify") ("types/strip-null" . "strip-null"))
     :say "Checks whether one [refinement condition](#term/subtype) implies another, including numeric bounds and set membership. [Subtype](#term/subtype) checking uses it to compare types such as positive and non-negative integers.")
    (:key "types/unify" :n 8 :gi 77 :defn "unify" :ns "graphden.types.core" :file "src/graphden/types/core.clj" :line 1685 :lang "clj" :mins 9.8 :head "(defn unify" :see nil :refs nil :siblings (("types/well-formed?" . "well-formed?") ("types/make-union" . "make-union") ("types/desugar-variant" . "desugar-variant") ("types/subtype?" . "subtype?") ("types/constraint-implies?" . "constraint-implies?") ("types/strip-null" . "strip-null"))
     :say "[Unification](#term/unification) finds substitutions for [type variables](#term/unification) that make two type expressions compatible. The [occurs check](#term/unification) prevents a variable from being defined recursively through itself. Structural cases recurse into function, collection, and record types; the result is a substitution map or `::fail`. Directional assignability is checked separately.")
    (:key "types/strip-null" :n 9 :gi 78 :defn "strip-null" :ns "graphden.types.core" :file "src/graphden/types/core.clj" :line 307 :lang "clj" :mins 1.8 :head "(defn strip-null" :see nil :refs nil :siblings (("types/well-formed?" . "well-formed?") ("types/make-union" . "make-union") ("types/desugar-variant" . "desugar-variant") ("types/subtype?" . "subtype?") ("types/constraint-implies?" . "constraint-implies?") ("types/unify" . "unify"))
     :say "Removes null from a top-level union; a type containing only null becomes `:never`. Secret wrappers remain intact. Control-flow checks and `:coalesce` use this shared narrowing operation.")
    (:key "types/taint-with-secret-if-tainted" :n 10 :gi 79 :defn "taint-with-secret-if-tainted" :ns "graphden.types.core.shapes" :file "src/graphden/types/core/shapes.clj" :line 520 :lang "clj" :mins 3.2 :head "(defn taint-with-secret-if-tainted" :see (("types/subtype?" . "subtype?")) :refs (("crud/apply-create-secret-body" . "apply-create-secret-body")) :siblings (("types/primitives" . "primitives") ("types/child-types" . "child-types"))
     :say "Marks a return type as secret when an input contains a secret and the function's rule propagates that marker. The `[:secret …]` wrapper carries information needed for subsequent type checks and result [redaction](#term/secret); it does not itself store the secret value.")
    (:key "types/classify-literal" :n 11 :gi 80 :defn "classify-literal" :ns "graphden.types.check.literals" :file "src/graphden/types/check/literals.clj" :line 39 :lang "clj" :mins 3.4 :head "(defn classify-literal" :see nil :refs nil :siblings nil
     :say "Infers a structural type from a literal Clojure value, including collections, records, and primitive values. [Binding](#term/binding) checks use this inferred type when checking concrete supplied values.")
    (:key "types/check-binding!" :n 12 :gi 81 :defn "check-binding!" :ns "graphden.types.check" :file "src/graphden/types/check.clj" :line 484 :lang "clj" :mins 5.6 :head "(defn- check-binding!" :see nil :refs nil :siblings (("types/signature-return" . "signature-return") ("types/rule-return" . "rule-return") ("types/check-fn-def!" . "check-fn-def!") ("types/check-all-defs!" . "check-all-defs!"))
     :say "Checks one [binding](#term/binding)'s actual type against the [slot](#term/slot)'s expected type. It combines literal classification, [subtype](#term/subtype) checks, and type-variable [unification](#term/unification). Since [unification](#term/unification) chooses substitutions rather than proving assignment direction, `gradual/fits?` checks the resulting direction afterward.")
    (:key "types/fits?" :n 13 :gi 82 :defn "fits?" :ns "graphden.types.check.gradual" :file "src/graphden/types/check/gradual.clj" :line 228 :lang "clj" :mins 1.0 :head "(defn fits?" :see nil :refs nil :siblings nil
     :say "Checks assignment direction after [unification](#term/unification). A wider type must not pass into a narrower [slot](#term/slot), such as `:numeric` into `:int` or a [nullable](#term/subtype) type into a non-nullable type. `erase` handles the checker's explicit gradual-typing allowances before `subtype?` compares the remaining types.")
    (:key "types/signature-return" :n 14 :gi 83 :defn "signature-return" :ns "graphden.types.check" :file "src/graphden/types/check.clj" :line 2152 :lang "clj" :mins 3.9 :head "(defn signature-return" :see nil :refs nil :siblings (("types/check-binding!" . "check-binding!") ("types/rule-return" . "rule-return") ("types/check-fn-def!" . "check-fn-def!") ("types/check-all-defs!" . "check-all-defs!"))
     :say "Infers a return type from a [polymorphic signature](#term/unification) when there is no custom `:return-type-rule`. It unifies declared argument types with actual types and substitutes the resulting variable values into the declared return type. Custom rules remain necessary when inference depends on literal values or registry data.")
    (:key "types/rule-return" :n 15 :gi 84 :defn "rule-return" :ns "graphden.types.check" :file "src/graphden/types/check.clj" :line 2205 :lang "clj" :mins 2.5 :head "(defn rule-return" :see nil :refs nil :siblings (("types/check-binding!" . "check-binding!") ("types/signature-return" . "signature-return") ("types/check-fn-def!" . "check-fn-def!") ("types/check-all-defs!" . "check-all-defs!"))
     :say "Chooses return-type inference for the root [base function](#term/base-function): custom rule first, declared signature next, then static return type. If the root propagates [secret markings](#term/secret) and an input is secret, the result is wrapped accordingly.")
    (:key "types/check-fn-def!" :n 16 :gi 85 :defn "check-fn-def!" :ns "graphden.types.check" :file "src/graphden/types/check.clj" :line 2478 :lang "clj" :mins 8.8 :head "(defn check-fn-def!" :see nil :refs (("crud/type-check-fn-after-mutation!" . "type-check-fn-after-mutation!")) :siblings (("types/check-binding!" . "check-binding!") ("types/signature-return" . "signature-return") ("types/rule-return" . "rule-return") ("types/check-all-defs!" . "check-all-defs!"))
     :say "Checks one function definition against its parents and inherited [slots](#term/slot). It validates argument changes and [effects](#term/effect), checks [bindings](#term/binding), computes the return type, and records detailed type information for later dependent functions.")
    (:key "types/check-all-defs!" :n 17 :gi 86 :defn "check-all-defs!" :ns "graphden.types.check" :file "src/graphden/types/check.clj" :line 2606 :lang "clj" :mins 1.9 :head "(defn check-all-defs!" :see nil :refs (("packages/sync-fn-entities-from-packages!" . "sync-fn-entities-from-packages!")) :siblings (("types/check-binding!" . "check-binding!") ("types/signature-return" . "signature-return") ("types/rule-return" . "rule-return") ("types/check-fn-def!" . "check-fn-def!"))
     :say "Checks definitions in [dependency order](#term/topological-order), registering each result before dependent definitions need it. This performs the full graph type sweep using the same single-definition checker.")
    (:key "types/record-rich-types!" :n 18 :gi 87 :defn "record-rich-types!" :ns "graphden.executor.registry.core" :file "src/graphden/executor/registry/core.clj" :line 436 :lang "clj" :mins 10.0 :head "(defn record-rich-types!" :see (("executor/compile-all" . "compile-all") ("web/api-rich-types" . "api-rich-types")) :refs nil :siblings (("types/rich-type-of-id" . "rich-type-of-id"))
     :say "Stores each function's computed argument types, return type, and [effects](#term/effect) in the [rich-types registry](#term/rich-types). Compiler decisions, runtime checks, [secret redaction](#term/secret), and editor labels read this data. Writes target the active branch's registry, so checking one branch does not overwrite another branch's types.")
    (:key "types/rich-type-of-id" :n 19 :gi 88 :defn "rich-type-of-id" :ns "graphden.executor.registry.core" :file "src/graphden/executor/registry/core.clj" :line 644 :lang "clj" :mins 1.3 :head "(defn rich-type-of-id" :see nil :refs nil :siblings (("types/record-rich-types!" . "record-rich-types!"))
     :say "Looks up [rich type information](#term/rich-types) by function ID. Names may repeat across namespaces and are not a unique identity. The remaining name index supports [base functions](#term/base-function) and older call sites; new consumers should use IDs. See the [identity model](../../docs/adr/ADR-identity-model.md).")))
  (:id "crud" :title "Graph API — reads, writes, and execution" :status "toured" :mins 67.5 :summary "Request validation, stored edits, execution results, and views."
   :steps
   ((:key "crud/extract-entity-params" :n 1 :gi 89 :defn "extract-entity-params" :ns "graphden.crud.request" :file "src/graphden/crud/request.clj" :line 128 :lang "clj" :mins 1.5 :head "(defn extract-entity-params" :see nil :refs nil :siblings (("crud/read-json-body" . "read-json-body"))
     :say "Extracts entity type and ID from an HTTP mutation request. It prefers parsed [Reitit](#term/ring) path parameters and falls back to parsing the request URI.")
    (:key "crud/read-json-body" :n 2 :gi 90 :defn "read-json-body" :ns "graphden.crud.request" :file "src/graphden/crud/request.clj" :line 147 :lang "clj" :mins 2.2 :head "(defn read-json-body" :see nil :refs nil :siblings (("crud/extract-entity-params" . "extract-entity-params"))
     :say "Normalizes a [Ring](#term/ring) request body supplied as text, an input stream, or an already parsed value. JSON object keys become Clojure [keywords](#term/edn) for the write handlers.")
    (:key "crud/resolve-branch-ref" :n 3 :gi 91 :defn "resolve-branch-ref" :ns "graphden.crud.branches" :file "src/graphden/crud/branches.clj" :line 32 :lang "clj" :mins 1.1 :head "(defn resolve-branch-ref" :see (("versioning/wrap-with-versioning" . "wrap-with-versioning")) :refs nil :siblings nil
     :say "Resolves the requested branch by UUID or name before writing. The resulting branch determines which versioned-storage view receives the change.")
    (:key "crud/create-entity" :n 4 :gi 92 :defn "create-entity" :ns "graphden.crud.entities" :file "src/graphden/crud/entities.clj" :line 189 :lang "clj" :mins 0.8 :head "(defn create-entity" :see nil :refs (("constellation/every-addon-facing-var-still-resolves-test" . "every-addon-facing-var-still-resolves-test")) :siblings (("crud/apply-create-core" . "apply-create-core"))
     :say "Creates one row through the generic write API. It checks the caller's [capability](#term/auth), validates the proposed change with `write-rej`, writes through `sp/create-entity`, then invalidates caches and sends notifications.")
    (:key "crud/write-rej" :n 5 :gi 93 :defn "write-rej" :ns "graphden.crud.validation" :file "src/graphden/crud/validation.clj" :line 878 :lang "clj" :mins 2.4 :head "(defn write-rej" :see nil :refs (("web/write-rej" . "write-rej")) :siblings nil
     :say "Checks whether a proposed mutation must be rejected before storage is changed. Checks include reference cycles, [multiple-inheritance](#term/inheritance) collisions, terminal functions, closed lists, and secret paths. Both create and update operations use this validation.")
    (:key "crud/apply-create-record-type-body" :n 6 :gi 94 :defn "apply-create-record-type-body" :ns "graphden.crud.entities.record-type" :file "src/graphden/crud/entities/record_type.clj" :line 439 :lang "clj" :mins 0.9 :head "(defn apply-create-record-type-body" :see nil :refs nil :siblings (("crud/apply-create-rollback" . "apply-create-rollback"))
     :say "Creates the function row, [slot](#term/slot) rows, and function-slot links for a record type under the semantic writer guard in one database transaction. Cache invalidation runs after commit; a failed transaction clears the legacy compensation journal.")
    (:key "crud/apply-create-rollback" :n 7 :gi 95 :defn "apply-create-rollback" :ns "graphden.crud.entities.record-type" :file "src/graphden/crud/entities/record_type.clj" :line 118 :lang "clj" :mins 1.8 :head "(defn apply-create-rollback" :see nil :refs nil :siblings (("crud/apply-create-record-type-body" . "apply-create-record-type-body"))
     :say "On failure, traverses the creation journal backward and attempts to delete each created row for storage implementations without database transactions. PostgreSQL failures have already rolled back and cleared the journal, so replay cannot damage restored rows.")
    (:key "crud/apply-create-core" :n 8 :gi 96 :defn "apply-create-core" :ns "graphden.crud.entities" :file "src/graphden/crud/entities.clj" :line 850 :lang "clj" :mins 1.4 :head "(defn apply-create-core" :see nil :refs (("web/write-rej" . "write-rej")) :siblings (("crud/create-entity" . "create-entity"))
     :say "Repeats structural validation under the semantic writer guard, then creates the row, optional rename view, and checks the resulting function in one SQL transaction. Binding writes follow rename views only within the edited function's inheritance. A view belonging to a separately captured call retains its slot UUID and argument name; following it into that call would bind a different argument. See the [inherited rename design](../../docs/adr/ADR-inherited-rename-surface.md). Ordinary type errors keep the edit and return `:type-warnings`; an optional rename failure rolls back its savepoint without losing the binding. [Secret-flow](#term/secret) rejection rolls back the whole SQL change, independently of the diagnostics store. See [secrets](../../docs/SECRETS.md).")
    (:key "crud/type-check-fn-after-mutation!" :n 9 :gi 97 :defn "type-check-fn-after-mutation!" :ns "graphden.crud.type-check" :file "src/graphden/crud/type_check.clj" :line 518 :lang "clj" :mins 4.8 :head "(defn type-check-fn-after-mutation!" :see (("types/check-fn-def!" . "check-fn-def!")) :refs (("editor/writeBindingFields" . "writeBindingFields")) :siblings nil
     :say "Reconstructs and checks the changed function, updating branch-specific diagnostics. `:reject-secret?` marks secret-related failures for the caller to reject instead of storing them as ordinary warnings. The following `type-check-fn-and-dependents!` also checks direct callers using the compiler's reverse dependency index.")
    (:key "crud/notify-after-write!" :n 10 :gi 98 :defn "notify-after-write!" :ns "graphden.crud.entities.invalidation" :file "src/graphden/crud/entities/invalidation.clj" :line 219 :lang "clj" :mins 5.0 :head "(defn notify-after-write!" :see nil :refs (("storage/make-emitter" . "make-emitter") ("editor/writeBindingFields" . "writeBindingFields")) :siblings nil
     :say "Invalidates affected caches after a stored change and emits a PostgreSQL notification for other processes. The notification carries update information so their compiled functions can refresh.")
    (:key "crud/resolve-fn" :n 11 :gi 99 :defn "resolve-fn" :ns "graphden.crud.fn-execution.lookup" :file "src/graphden/crud/fn_execution/lookup.clj" :line 97 :lang "clj" :mins 1.2 :head "(defn resolve-fn" :see nil :refs nil :siblings nil
     :say "Resolves the function ID or name from an execution request into the stored function row. This lookup begins request execution and result persistence.")
    (:key "crud/public-free-entries" :n 12 :gi 100 :defn "public-free-entries" :ns "graphden.executor.compile.surface" :file "src/graphden/executor/compile/surface.clj" :line 85 :lang "clj" :mins 5.5 :head "(defn public-free-entries" :see nil :refs (("executor/build-ref-renames" . "build-ref-renames")) :siblings nil
     :say "Computes public [free arguments](#term/free-argument) for execution forms, service validation, and graph placeholders. It combines renamed public arguments with [captured arguments](#term/capture) found inside [higher-order functions](#term/hof), removes inputs supplied by enclosing scopes, and deduplicates by [slot](#term/slot) identity. These consumers therefore share one definition of required input.")
    (:key "crud/apply-execute" :n 13 :gi 101 :defn "apply-execute" :ns "graphden.crud.fn-execution" :file "src/graphden/crud/fn_execution.clj" :line 140 :lang "clj" :mins 2.1 :head "(defn apply-execute" :see nil :refs (("editor/submitExecution" . "submitExecution") ("editor/evaluate" . "evaluate")) :siblings nil
     :say "Coordinates `/api/execute`: resolves the function, version, and [free arguments](#term/free-argument); acquires a [concurrency permit](#term/concurrency-permit); submits execution to a future; then handles pending, successful, or failed results. This is a request-management layer around the executor from the first block.")
    (:key "crud/create-pending-with-args!" :n 14 :gi 102 :defn "create-pending-with-args!" :ns "graphden.crud.fn-execution.persist" :file "src/graphden/crud/fn_execution/persist.clj" :line 340 :lang "clj" :mins 1.5 :head "(defn create-pending-with-args!" :see nil :refs nil :siblings (("crud/write-finished!" . "write-finished!"))
     :say "Writes a pending execution row together with its argument and argument-item rows atomically. This records which inputs belong to the execution before its final outcome is available.")
    (:key "crud/write-finished!" :n 15 :gi 103 :defn "write-finished!" :ns "graphden.crud.fn-execution.persist" :file "src/graphden/crud/fn_execution/persist.clj" :line 585 :lang "clj" :mins 3.1 :head "(defn write-finished!" :see nil :refs nil :siblings (("crud/create-pending-with-args!" . "create-pending-with-args!"))
     :say "Stores a completed future's result, error, or cancellation on the execution row. Secret-derived values are [redacted](#term/secret) before persistence so polling sees the final safe result.")
    (:key "crud/render-repr" :n 16 :gi 104 :defn "render-repr" :ns "graphden.crud.value-repr" :file "src/graphden/crud/value_repr.clj" :line 163 :lang "clj" :mins 2.0 :head "(defn render-repr" :see nil :refs (("platform/sanitize-hiccup" . "sanitize-hiccup")) :siblings nil
     :say "Chooses a [graph function](#term/graph-function) that renders a result value as [Hiccup](#term/hiccup), using the declared or inferred type and falling back to literal classification. It runs with `:allowed-effects #{}` and sanitizes the output before insertion into the editor [DOM](#term/hiccup). See [typed result representations](../../docs/EXECUTION.md).")
    (:key "crud/resolve-form" :n 17 :gi 105 :defn "resolve-form" :ns "graphden.crud.value-form" :file "src/graphden/crud/value_form.clj" :line 480 :lang "clj" :mins 3.5 :head "(defn resolve-form" :see nil :refs (("editor/enterArgValueEditMode" . "enterArgValueEditMode")) :siblings (("crud/build-form" . "build-form"))
     :say "Converts an effective [slot](#term/slot) type into a pure form descriptor for a record, list, union, or leaf. It resolves aliases and variants on the server and bounds recursion depth, so the browser need not reimplement the type grammar.")
    (:key "crud/build-form" :n 18 :gi 106 :defn "build-form" :ns "graphden.crud.value-form" :file "src/graphden/crud/value_form.clj" :line 786 :lang "clj" :mins 5.8 :head "(defn build-form" :see nil :refs nil :siblings (("crud/resolve-form" . "resolve-form"))
     :say "Renders a form descriptor as [Hiccup](#term/hiccup): records become field groups, unions get a choice of variant, and leaf types use the registered form functions. `GET /partials/value-form` returns this [server-rendered fragment](#term/htmx), which [HTMX](#term/htmx) inserts into the inspector. See [partials](../../docs/PARTIALS.md).")
    (:key "crud/run-captured!" :n 19 :gi 107 :defn "run-captured!" :ns "graphden.crud.debug-capture" :file "src/graphden/crud/debug_capture.clj" :line 292 :lang "clj" :mins 2.4 :head "(defn run-captured!" :see nil :refs nil :siblings nil
     :say "Runs the next matching HTTP request with tracing when a one-shot debugger interception is armed for its organisation and branch. The interception expires after a limited time. Sanitized request and response data are stored as an execution so the existing call-tree interface can display the handler run. See [debugging](../../docs/EXECUTION.md).")
    (:key "crud/apply-create-secret-body" :n 20 :gi 108 :defn "apply-create-secret-body" :ns "graphden.crud.secrets" :file "src/graphden/crud/secrets.clj" :line 227 :lang "clj" :mins 4.2 :head "(defn apply-create-secret-body" :see (("types/taint-with-secret-if-tainted" . "taint-with-secret-if-tainted")) :refs nil :siblings nil
     :say "Claims the secret path and creates its graph rows in one guarded SQL transaction. After commit, stores the value and metadata in OpenBao without holding the graph writer. The value never enters graph rows. SQL failures roll back and clear their journal entries; later Vault failures use compensation for the already committed rows. Request parsing remains composed in `app/secrets/fns.edn`. See [secrets](../../docs/SECRETS.md).")
    (:key "crud/run-tests!" :n 21 :gi 109 :defn "run-tests!" :ns "graphden.crud.test-runs" :file "src/graphden/crud/test_runs.clj" :line 194 :lang "clj" :mins 4.0 :head "(defn run-tests!" :see nil :refs nil :siblings nil
     :say "Runs functions from `tests` namespaces through the ordinary execution API with empty arguments; a run passes if it does not throw. Status belongs to the current function version, so an edit makes earlier results stale. Each completed test notifies the editor. Tests owned by shipped packages are excluded from the default user test run. See [tests](../../docs/TESTS.md).")
    (:key "crud/schedule-affected!" :n 22 :gi 110 :defn "schedule-affected!" :ns "graphden.crud.test-autorun" :file "src/graphden/crud/test_autorun.clj" :line 170 :lang "clj" :mins 2.4 :head "(defn schedule-affected!" :see nil :refs nil :siblings nil
     :say "Finds tests affected by a write through reverse dependencies. It selects tests with no [effects](#term/effect), combines closely spaced requests into one delayed run, and runs them with conveyed [dynamic bindings](#term/dynamic-binding). `:allowed-effects #{}` enforces the no-effects restriction during execution as well.")
    (:key "crud/graph-list-env" :n 23 :gi 111 :defn "graph-list-env" :ns "graphden.crud.entities.list" :file "src/graphden/crud/entities/list.clj" :line 497 :lang "clj" :mins 3.3 :head "(defn- graph-list-env" :see nil :refs nil :siblings nil
     :say "Builds a shared lazy read environment over the graph cache. Separate projections produce namespace trees, function lists, searches, subtrees, or a full graph listing. Server-assigned roles distinguish types from functions. This is the shared data source behind editor list refreshes.")
    (:key "crud/view-members" :n 24 :gi 112 :defn "view-members" :ns "graphden.crud.entities.views" :file "src/graphden/crud/entities/views.clj" :line 365 :lang "clj" :mins 2.6 :head "(defn view-members" :see nil :refs nil :siblings nil
     :say "Evaluates graph filters for the Explorer and saved graph views. Filter dimensions are combined with AND; `:uses` follows reverse dependencies by function ID, and `:views` intersects other views with a cycle check. Ad-hoc filtering and the saved `:explorer-view` function use this same evaluator. Problems come from current-branch diagnostics, failures and lint; apps use the installed org-scoped route reader. Intersections run before the final result limit, so a nested view never loses later matches.")
    (:key "crud/save!" :n 25 :gi 113 :defn "save!" :ns "graphden.crud.views" :file "src/graphden/crud/views.clj" :line 53 :lang "clj" :mins 2.0 :head "(defn save!" :see nil :refs nil :siblings nil
     :say "Saves a complete filter set as an ordinary explorer-view function and bindings. The owned writer transaction repeats authorization and validation before applying every row. Existing scalar identity slots remain valid; additional references are lists of const compositions with fn-ref bindings, so targets are named without being executed. Unrepresentable inherited or computed clauses reject the whole write. Cache invalidation and notifications happen after commit, and a publication failure is reported as committed rather than pretending the database rolled back.")))
  (:id "packages" :title "Packages — loading and distribution" :status "toured" :mins 100.0 :summary "Declarations, implementations, synchronization, import, and lint."
   :steps
   ((:key "packages/load-packages" :n 1 :gi 114 :defn "load-packages" :ns "graphden.packages.loader" :file "src/graphden/packages/loader.clj" :line 653 :lang "clj" :mins 5.2 :head "(defn load-packages" :see nil :refs (("boot/packages" . "packages") ("constellation/read-manifest" . "read-manifest")) :siblings (("packages/resolve-dependencies" . "resolve-dependencies") ("packages/validate-dep-constraints!" . "validate-dep-constraints!") ("packages/load-single-package" . "load-single-package") ("packages/process-module" . "process-module") ("packages/base-fn?" . "base-fn?") ("packages/load-module-fns" . "load-module-fns") ("packages/load-impls-via-eval" . "load-impls-via-eval") ("packages/fn-def->base-fn-def" . "fn-def->base-fn-def") ("packages/sync-namespaces!" . "sync-namespaces!"))
     :say "Loads configured packages in [dependency order](#term/topological-order) and combines their module definitions into `:base-fn-defs`, `:fn-defs`, and `:namespaces`. Boot uses these results to populate the stored graph and implementation registry.")
    (:key "packages/resolve-dependencies" :n 2 :gi 115 :defn "resolve-dependencies" :ns "graphden.packages.loader" :file "src/graphden/packages/loader.clj" :line 610 :lang "clj" :mins 2.9 :head "(defn resolve-dependencies" :see nil :refs nil :siblings (("packages/load-packages" . "load-packages") ("packages/validate-dep-constraints!" . "validate-dep-constraints!") ("packages/load-single-package" . "load-single-package") ("packages/process-module" . "process-module") ("packages/base-fn?" . "base-fn?") ("packages/load-module-fns" . "load-module-fns") ("packages/load-impls-via-eval" . "load-impls-via-eval") ("packages/fn-def->base-fn-def" . "fn-def->base-fn-def") ("packages/sync-namespaces!" . "sync-namespaces!"))
     :say "Orders packages by their declared dependencies using [depth-first search](#term/reachable-graph) ([DFS](#term/reachable-graph)). Transitive dependencies are included, so a package's required primitives load before functions that use them.")
    (:key "packages/validate-dep-constraints!" :n 3 :gi 116 :defn "validate-dep-constraints!" :ns "graphden.packages.loader" :file "src/graphden/packages/loader.clj" :line 589 :lang "clj" :mins 1.8 :head "(defn- validate-dep-constraints!" :see nil :refs nil :siblings (("packages/load-packages" . "load-packages") ("packages/resolve-dependencies" . "resolve-dependencies") ("packages/load-single-package" . "load-single-package") ("packages/process-module" . "process-module") ("packages/base-fn?" . "base-fn?") ("packages/load-module-fns" . "load-module-fns") ("packages/load-impls-via-eval" . "load-impls-via-eval") ("packages/fn-def->base-fn-def" . "fn-def->base-fn-def") ("packages/sync-namespaces!" . "sync-namespaces!"))
     :say "Checks each package's declared [semantic-version constraints](#term/semver) against the available [classpath](#term/edn) packages. A mismatch stops boot with `:packages/version-conflict`, before missing or incompatible definitions can cause later loading errors.")
    (:key "packages/load-single-package" :n 4 :gi 117 :defn "load-single-package" :ns "graphden.packages.loader" :file "src/graphden/packages/loader.clj" :line 528 :lang "clj" :mins 2.3 :head "(defn- load-single-package" :see nil :refs nil :siblings (("packages/load-packages" . "load-packages") ("packages/resolve-dependencies" . "resolve-dependencies") ("packages/validate-dep-constraints!" . "validate-dep-constraints!") ("packages/process-module" . "process-module") ("packages/base-fn?" . "base-fn?") ("packages/load-module-fns" . "load-module-fns") ("packages/load-impls-via-eval" . "load-impls-via-eval") ("packages/fn-def->base-fn-def" . "fn-def->base-fn-def") ("packages/sync-namespaces!" . "sync-namespaces!"))
     :say "Reads one package's `package.edn` and loads its listed modules. The result combines the [base-function](#term/base-function) definitions and composed function definitions from those modules.")
    (:key "packages/process-module" :n 5 :gi 118 :defn "process-module" :ns "graphden.packages.loader" :file "src/graphden/packages/loader.clj" :line 469 :lang "clj" :mins 3.7 :head "(defn- process-module" :see nil :refs nil :siblings (("packages/load-packages" . "load-packages") ("packages/resolve-dependencies" . "resolve-dependencies") ("packages/validate-dep-constraints!" . "validate-dep-constraints!") ("packages/load-single-package" . "load-single-package") ("packages/base-fn?" . "base-fn?") ("packages/load-module-fns" . "load-module-fns") ("packages/load-impls-via-eval" . "load-impls-via-eval") ("packages/fn-def->base-fn-def" . "fn-def->base-fn-def") ("packages/sync-namespaces!" . "sync-namespaces!"))
     :say "Loads a module's `fns.edn` and `impls.clj`, then separates [base functions](#term/base-function) requiring implementations from composed functions and type declarations. This is where the two module files are combined.")
    (:key "packages/base-fn?" :n 6 :gi 119 :defn "base-fn?" :ns "graphden.packages.loader" :file "src/graphden/packages/loader.clj" :line 362 :lang "clj" :mins 1.1 :head "(defn- base-fn?" :see nil :refs nil :siblings (("packages/load-packages" . "load-packages") ("packages/resolve-dependencies" . "resolve-dependencies") ("packages/validate-dep-constraints!" . "validate-dep-constraints!") ("packages/load-single-package" . "load-single-package") ("packages/process-module" . "process-module") ("packages/load-module-fns" . "load-module-fns") ("packages/load-impls-via-eval" . "load-impls-via-eval") ("packages/fn-def->base-fn-def" . "fn-def->base-fn-def") ("packages/sync-namespaces!" . "sync-namespaces!"))
     :say "Classifies an entry as a [base function](#term/base-function) when it has no parent declarations and is not a type row. [Base functions](#term/base-function) require a host implementation; composed definitions inherit their implementation through parents.")
    (:key "packages/load-module-fns" :n 7 :gi 120 :defn "load-module-fns" :ns "graphden.packages.loader" :file "src/graphden/packages/loader.clj" :line 210 :lang "clj" :mins 1.9 :head "(defn- load-module-fns" :see nil :refs nil :siblings (("packages/load-packages" . "load-packages") ("packages/resolve-dependencies" . "resolve-dependencies") ("packages/validate-dep-constraints!" . "validate-dep-constraints!") ("packages/load-single-package" . "load-single-package") ("packages/process-module" . "process-module") ("packages/base-fn?" . "base-fn?") ("packages/load-impls-via-eval" . "load-impls-via-eval") ("packages/fn-def->base-fn-def" . "fn-def->base-fn-def") ("packages/sync-namespaces!" . "sync-namespaces!"))
     :say "Reads a module's [EDN](#term/edn) definitions while retaining source file and line information. Later validation and type errors use those locations to identify the authored definition.")
    (:key "packages/parse-module" :n 8 :gi 121 :defn "parse-module" :ns "graphden.packages.records.parse" :file "src/graphden/packages/records/parse.clj" :line 1240 :lang "clj" :mins 4.3 :head "(defn parse-module" :see nil :refs nil :siblings (("packages/parse-composed" . "parse-composed"))
     :say "Converts module definitions into stored rows in two passes. First it assigns deterministic IDs; then it parses definitions using the module and previously known definitions to resolve inherited [slot](#term/slot) ownership before writing any rows.")
    (:key "packages/parse-composed" :n 9 :gi 122 :defn "parse-composed" :ns "graphden.packages.records.parse" :file "src/graphden/packages/records/parse.clj" :line 713 :lang "clj" :mins 6.5 :head "(defn- parse-composed" :see nil :refs nil :siblings (("packages/parse-module" . "parse-module"))
     :say "Parses a composed function's parents and arguments. A bound argument creates a [binding](#term/binding) to an inherited [slot](#term/slot); a type-only argument declaration can add an own [slot](#term/slot). `resolve-slot-owner` determines which ancestor owns the targeted [slot](#term/slot).")
    (:key "packages/resolve-slot-owner" :n 10 :gi 123 :defn "resolve-slot-owner" :ns "graphden.packages.records.slot-resolution" :file "src/graphden/packages/records/slot_resolution.clj" :line 552 :lang "clj" :mins 5.1 :head "(defn resolve-slot-owner" :see (("executor/build-lookups" . "build-lookups")) :refs nil :siblings (("packages/build-rename-slot-records" . "build-rename-slot-records"))
     :say "Finds the function that declared an argument's [slot](#term/slot), searching [inheritance](#term/inheritance) and referenced-function paths and using types to disambiguate names. The resulting [slot](#term/slot) ID is stored in the [binding](#term/binding) so later compilation preserves argument identity.")
    (:key "packages/build-rename-slot-records" :n 11 :gi 124 :defn "build-rename-slot-records" :ns "graphden.packages.records.slot-resolution" :file "src/graphden/packages/records/slot_resolution.clj" :line 725 :lang "clj" :mins 5.1 :head "(defn build-rename-slot-records" :see (("executor/build-ref-renames" . "build-ref-renames")) :refs nil :siblings (("packages/resolve-slot-owner" . "resolve-slot-owner"))
     :say "Represents `{Y {:as :X}}` by creating an own rename [slot](#term/slot) linked to the original [slot](#term/slot) through `source-slot-id`. Parser, executor, and editor use this link to keep public names separate from underlying [slot](#term/slot) identity.")
    (:key "packages/load-impls-via-eval" :n 12 :gi 125 :defn "load-impls-via-eval" :ns "graphden.packages.loader" :file "src/graphden/packages/loader.clj" :line 270 :lang "clj" :mins 2.5 :head "(defn- load-impls-via-eval" :see nil :refs nil :siblings (("packages/load-packages" . "load-packages") ("packages/resolve-dependencies" . "resolve-dependencies") ("packages/validate-dep-constraints!" . "validate-dep-constraints!") ("packages/load-single-package" . "load-single-package") ("packages/process-module" . "process-module") ("packages/base-fn?" . "base-fn?") ("packages/load-module-fns" . "load-module-fns") ("packages/fn-def->base-fn-def" . "fn-def->base-fn-def") ("packages/sync-namespaces!" . "sync-namespaces!"))
     :say "Evaluates `impls.clj` forms in a namespace and reads its `impls` map from function names to Clojure implementations. During coverage tests, an already instrumented namespace can be reused so those calls remain visible to the coverage tool.")
    (:key "packages/fn-def->base-fn-def" :n 13 :gi 126 :defn "fn-def->base-fn-def" :ns "graphden.packages.loader" :file "src/graphden/packages/loader.clj" :line 386 :lang "clj" :mins 4.6 :head "(defn- fn-def->base-fn-def" :see (("executor/resolve-impl" . "resolve-impl")) :refs nil :siblings (("packages/load-packages" . "load-packages") ("packages/resolve-dependencies" . "resolve-dependencies") ("packages/validate-dep-constraints!" . "validate-dep-constraints!") ("packages/load-single-package" . "load-single-package") ("packages/process-module" . "process-module") ("packages/base-fn?" . "base-fn?") ("packages/load-module-fns" . "load-module-fns") ("packages/load-impls-via-eval" . "load-impls-via-eval") ("packages/sync-namespaces!" . "sync-namespaces!"))
     :say "Combines an `fns.edn` declaration with its Clojure implementation. Argument types, return type, [effects](#term/effect), and implementation become one [base-function](#term/base-function) registry entry.")
    (:key "packages/add" :n 14 :gi 127 :defn "add" :ns "resources/packages/core/arithmetic/impls.clj" :file "resources/packages/core/arithmetic/impls.clj" :line 54 :lang "clj" :mins 0.6 :head "(defbase add [nums]" :see (("executor/defbase" . "defbase")) :refs (("executor/execute" . "execute")) :siblings nil
     :say "A concrete arithmetic [base function](#term/base-function): `(defbase add [nums] (safe-arith + nums :add))`. The loader collects this implementation and pairs it with the `:add` declaration from `fns.edn`.")
    (:key "packages/sync-namespaces!" :n 15 :gi 128 :defn "sync-namespaces!" :ns "graphden.packages.loader" :file "src/graphden/packages/loader.clj" :line 732 :lang "clj" :mins 4.8 :head "(defn sync-namespaces!" :see (("executor/sync-fns-to-storage!" . "sync-fns-to-storage!")) :refs (("editor/gdTourRecordPackageInstall" . "gdTourRecordPackageInstall")) :siblings (("packages/load-packages" . "load-packages") ("packages/resolve-dependencies" . "resolve-dependencies") ("packages/validate-dep-constraints!" . "validate-dep-constraints!") ("packages/load-single-package" . "load-single-package") ("packages/process-module" . "process-module") ("packages/base-fn?" . "base-fn?") ("packages/load-module-fns" . "load-module-fns") ("packages/load-impls-via-eval" . "load-impls-via-eval") ("packages/fn-def->base-fn-def" . "fn-def->base-fn-def"))
     :say "Creates the stored namespace hierarchy, such as `core` and `core.arithmetic`, and returns a map from namespace paths to IDs. Function synchronization uses these IDs to place each definition in its namespace. Metadata also records only namespace IDs actually created by this synchronization. Package installation returns those IDs alongside the pin and version identities, so lesson cleanup can remove its own resources without claiming pre-existing namespaces by name.")
    (:key "packages/sync-fn-entities-from-packages!" :n 16 :gi 129 :defn "sync-fn-entities-from-packages!" :ns "graphden.packages.sync" :file "src/graphden/packages/sync.clj" :line 1091 :lang "clj" :mins 10.9 :head "(defn sync-fn-entities-from-packages!" :see (("types/check-all-defs!" . "check-all-defs!") ("versioning/repoint-refs!" . "repoint-refs!")) :refs (("boot/packages" . "packages")) :siblings (("packages/adopt-bundle-identities!" . "adopt-bundle-identities!") ("packages/reconcile-bundle-scope!" . "reconcile-bundle-scope!"))
     :say "Synchronizes packaged definitions into storage, repairs moved identities, removes unused retired definitions, and checks types in [dependency order](#term/topological-order). Packages on disk describe the desired state. Test bootstraps may skip the full type sweep; production boot and `bb type-sweep` run it explicitly.")
    (:key "packages/records->fn-defs" :n 17 :gi 130 :defn "records->fn-defs" :ns "graphden.packages.export" :file "src/graphden/packages/export.clj" :line 555 :lang "clj" :mins 1.8 :head "(defn records->fn-defs" :see nil :refs nil :siblings (("packages/ref-kw" . "ref-kw") ("packages/external-deps" . "external-deps") ("packages/strip-secret-paths" . "strip-secret-paths"))
     :say "Converts stored graph records back into function definitions for export and distribution. Parsing the exported definitions must reconstruct the same graph: `parse(export(parse(x))) == parse(x)`. The corpus test verifies this property on actual packages.")
    (:key "packages/ref-kw" :n 18 :gi 131 :defn "ref-kw" :ns "graphden.packages.export" :file "src/graphden/packages/export.clj" :line 106 :lang "clj" :mins 1.9 :head "(defn- ref-kw" :see nil :refs nil :siblings (("packages/records->fn-defs" . "records->fn-defs") ("packages/external-deps" . "external-deps") ("packages/strip-secret-paths" . "strip-secret-paths"))
     :say "Chooses an unqualified [keyword](#term/edn) for a unique reference name and a namespace-qualified [keyword](#term/edn) when names repeat. Some version-qualified namespaces produce valid in-memory [keywords](#term/edn) whose printed form is not valid [EDN](#term/edn); the next step handles that text boundary.")
    (:key "packages/encode-unreadable-kws" :n 19 :gi 132 :defn "encode-unreadable-kws" :ns "graphden.packages.records.wire" :file "src/graphden/packages/records/wire.clj" :line 70 :lang "clj" :mins 1.4 :head "(defn encode-unreadable-kws" :see nil :refs nil :siblings nil
     :say "Before writing [EDN](#term/edn) text, replaces otherwise unreadable [keywords](#term/edn) with tagged literals such as `#graphden/ref`. Registered readers restore the original [keywords](#term/edn) during import. This step protects the EDN text boundary. JSONB storage has a different contract: its JSON reader keywordizes object keys.")
    (:key "packages/external-deps" :n 20 :gi 133 :defn "external-deps" :ns "graphden.packages.export" :file "src/graphden/packages/export.clj" :line 913 :lang "clj" :mins 4.8 :head "(defn external-deps" :see nil :refs nil :siblings (("packages/records->fn-defs" . "records->fn-defs") ("packages/ref-kw" . "ref-kw") ("packages/strip-secret-paths" . "strip-secret-paths"))
     :say "Finds references leaving an exported namespace subtree and records them as dependencies. References into version-qualified package namespaces also produce package dependencies. The surrounding `:export-namespace` [graph function](#term/graph-function) assembles the final bundle.")
    (:key "packages/strip-secret-paths" :n 21 :gi 134 :defn "strip-secret-paths" :ns "graphden.packages.export" :file "src/graphden/packages/export.clj" :line 769 :lang "clj" :mins 1.9 :head "(defn strip-secret-paths" :see nil :refs nil :siblings (("packages/records->fn-defs" . "records->fn-defs") ("packages/ref-kw" . "ref-kw") ("packages/external-deps" . "external-deps"))
     :say "Removes vault paths from shared bundles by default and leaves the corresponding secret arguments free. The `:secrets` manifest tells the installer which values need to be defined locally; publishing a function therefore does not publish its secret locations.")
    (:key "packages/publish-package-apply" :n 22 :gi 135 :defn "publish-package-apply" :ns "resources/packages/registry/registry/impls.clj" :file "resources/packages/registry/registry/impls.clj" :line 145 :lang "clj" :mins 2.0 :head "(defbase publish-package-apply" :see nil :refs nil :siblings (("packages/upsert-pin!" . "upsert-pin!"))
     :say "Stores a published bundle as an immutable `:package-version` row identified by version and content hash. Installation materializes definitions in a version-qualified namespace and records a [pin](#term/semver). Updating or rolling back changes references to the selected package version.")
    (:key "packages/upsert-pin!" :n 23 :gi 136 :defn "upsert-pin!" :ns "resources/packages/registry/registry/impls.clj" :file "resources/packages/registry/registry/impls.clj" :line 347 :lang "clj" :mins 2.2 :head "(defn- upsert-pin!" :see nil :refs nil :siblings (("packages/publish-package-apply" . "publish-package-apply"))
     :say "Creates or updates an [installation pin](#term/semver). Only a new installation increments the global package statistic, using an atomic database upsert; moving an existing [pin](#term/semver) to another version does not. See [marketplace](../../docs/MARKETPLACE.md).")
    (:key "packages/moderate-package-version!" :n 24 :gi 137 :defn "moderate-package-version!" :ns "resources/packages/registry/marketplace/impls.clj" :file "resources/packages/registry/marketplace/impls.clj" :line 54 :lang "clj" :mins 3.1 :head "(defbase moderate-package-version!" :see nil :refs nil :siblings nil
     :say "Applies a platform administrator's moderation decision. The [capability](#term/auth) check is inside the write operation; the read uses platform storage so organisation scoping does not hide another publisher's row. After the change, `tc/notify!` lets the [addon](#term/integrant) notify the publisher. See [marketplace moderation](../../docs/MARKETPLACE.md).")
    (:key "packages/install!" :n 25 :gi 138 :defn "install!" :ns "graphden.packages.loaded" :file "src/graphden/packages/loaded.clj" :line 63 :lang "clj" :mins 1.2 :head "(defn install!" :see nil :refs (("constellation/extra-deps" . "extra-deps")) :siblings nil
     :say "Records the packages actually loaded by this executor, including version, origin, and whether they include Clojure implementations. The editor displays this inventory. Packages containing executable Clojure code enter through the trusted build, not through this inventory API.")
    (:key "packages/seed!" :n 26 :gi 139 :defn "seed!" :ns "graphden.packages.starter-catalogue" :file "src/graphden/packages/starter_catalogue.clj" :line 84 :lang "clj" :mins 1.7 :head "(defn seed!" :see nil :refs nil :siblings nil
     :say "Seeds starter themes, keymaps, and examples from `starter-catalogue.edn` at boot. It uses the same package-version representation as publishing and skips existing name/version pairs. Changing an immutable listing requires a new version. See [starter catalogue](../../docs/MARKETPLACE.md).")
    (:key "packages/adopt-bundle-identities!" :n 27 :gi 140 :defn "adopt-bundle-identities!" :ns "graphden.packages.sync" :file "src/graphden/packages/sync.clj" :line 591 :lang "clj" :mins 3.2 :head "(defn adopt-bundle-identities!" :see nil :refs nil :siblings (("packages/sync-fn-entities-from-packages!" . "sync-fn-entities-from-packages!") ("packages/reconcile-bundle-scope!" . "reconcile-bundle-scope!"))
     :say "During bundle import, aligns editor-created same-name identities with deterministic IDs and redirects their references. The surrounding graph pipeline chooses the target branch, excludes package-owned definitions, synchronizes the bundle, and optionally removes missing definitions. This identity-level repair is specific to import, not ordinary [MCP](#term/mcp) upsert.")
    (:key "packages/reconcile-bundle-scope!" :n 28 :gi 141 :defn "reconcile-bundle-scope!" :ns "graphden.packages.sync" :file "src/graphden/packages/sync.clj" :line 634 :lang "clj" :mins 4.4 :head "(defn reconcile-bundle-scope!" :see nil :refs nil :siblings (("packages/sync-fn-entities-from-packages!" . "sync-fn-entities-from-packages!") ("packages/adopt-bundle-identities!" . "adopt-bundle-identities!"))
     :say "Implements `?prune=true` within the bundle's namespaces. Definitions absent from the snapshot receive branch-specific [tombstones](#term/tombstone), including inherited definitions. It does not physically purge shared identities; referenced removals are retained and reported.")
    (:key "packages/bundle->files" :n 29 :gi 142 :defn "bundle->files" :ns "graphden.packages.git-format" :file "src/graphden/packages/git_format.clj" :line 163 :lang "clj" :mins 2.0 :head "(defn bundle->files" :see nil :refs nil :siblings nil
     :say "Writes a bundle as namespace module files plus a manifest with deterministic output for Git comparison. Nested argument-map order is preserved because parsing derives [slot](#term/slot) positions from it. The CLI uses these files for HTTP export, import, push, and pull.")
    (:key "packages/lint" :n 30 :gi 143 :defn "lint" :ns "graphden.lint.core" :file "src/graphden/lint/core.clj" :line 800 :lang "clj" :mins 1.8 :head "(defn lint" :see nil :refs nil :siblings nil
     :say "Checks function definitions for duplicate implementations, unused private definitions, redundant inherited [bindings](#term/binding), siblings that could share a parent, and excessively deep [inheritance](#term/inheritance). Both CI and the editor use this same linter over function-definition data. See [graph lint](../../docs/GRAPH_LINT.md).")
    (:key "packages/lint-branch" :n 31 :gi 144 :defn "lint-branch" :ns "graphden.lint.graph" :file "src/graphden/lint/graph.clj" :line 363 :lang "clj" :mins 3.3 :head "(defn lint-branch" :see nil :refs nil :siblings nil
     :say "Converts the current organisation and branch's graph snapshot into function definitions and runs the graph linter. Results are cached while the snapshot object is unchanged. The lint filter and inspector section share this result; graph-stored suppressions remove acknowledged findings.")))
  (:id "boot" :title "Boot — starting the system" :status "toured" :mins 21.1 :summary "Configuration, component dependencies, startup, and shutdown."
   :steps
   ((:key "boot/-main" :n 1 :gi 145 :defn "-main" :ns "graphden.executor-runtime.core" :file "src/graphden/executor_runtime/core.clj" :line 187 :lang "clj" :mins 1.1 :head "(defn -main" :see (("boot/boot!" . "boot!") ("services/reconcile-once!" . "reconcile-once!")) :refs nil :siblings (("boot/boot!" . "boot!") ("constellation/-main" . "-main"))
     :say "The JVM entry point starts the [Integrant](#term/integrant) component system, installs a shutdown hook, optionally opens nREPL, then keeps the process alive. The HTTP server starts separately through service [reconciliation](#term/reconciliation); `-main` does not itself handle requests.")
    (:key "boot/boot!" :n 2 :gi 146 :defn "boot!" :ns "graphden.executor-runtime.core" :file "src/graphden/executor_runtime/core.clj" :line 167 :lang "clj" :mins 1.8 :head "(defn boot!" :see nil :refs (("boot/-main" . "-main") ("constellation/-main" . "-main")) :siblings (("boot/-main" . "-main") ("constellation/-main" . "-main"))
     :say "Starts the system and, on failure, halts components that already initialized before exiting with an error. [Integrant](#term/integrant) does not automatically halt a partially initialized system, so this cleanup prevents surviving threads from keeping a failed startup alive.")
    (:key "boot/read-config" :n 3 :gi 147 :defn "read-config" :ns "graphden.system.config" :file "src/graphden/system/config.clj" :line 83 :lang "clj" :mins 1.7 :head "(defn read-config" :see (("platform/platform-tier?" . "platform-tier?")) :refs (("constellation/addon-config-resources" . "addon-config-resources") ("constellation/-main" . "-main")) :siblings (("constellation/addon-config-resources" . "addon-config-resources") ("constellation/merge-addon" . "merge-addon"))
     :say "Reads profile configuration with Aero, then merges [addon](#term/integrant) fragments listed in `GRAPHDEN_ADDON_CONFIGS`. [Addons](#term/integrant) can replace or add [Integrant](#term/integrant) component keys without changing core configuration files. With no [addons](#term/integrant), the core configuration is used unchanged. See [addon configuration](../../docs/TENANCY_SEAM.md).")
    (:key "boot/start!" :n 4 :gi 148 :defn "start!" :ns "graphden.system.interface" :file "src/graphden/system/interface.clj" :line 38 :lang "clj" :mins 1.0 :head "(defn start!" :see nil :refs nil :siblings nil
     :say "Passes the loaded configuration to `ig/init`, which initializes components in [dependency order](#term/topological-order). Requiring the `init.*` namespaces registers their `ig/init-key` implementations before this call. The next steps show the main components.")
    (:key "boot/postgres" :n 5 :gi 149 :defn "postgres" :ns "graphden.system.init.storage" :file "src/graphden/system/init/storage.clj" :line 110 :lang "clj" :mins 1.1 :head "(defmethod ig/init-key :db/postgres [_ {:keys [datasource-wrap] :as opts}]" :see (("versioning/wrap-with-versioning" . "wrap-with-versioning")) :refs (("storage/MalliDataSchema" . "MalliDataSchema")) :siblings nil
     :say "Opens the PostgreSQL connection pool and initializes the declared schema. An optional `:datasource-wrap` lets the tenancy [addon](#term/integrant) attach organisation context to each connection for row-level security. The versioned-storage component subsequently wraps this storage.")
    (:key "boot/packages" :n 6 :gi 150 :defn "packages" :ns "graphden.system.init.packages" :file "src/graphden/system/init/packages.clj" :line 18 :lang "clj" :mins 1.4 :head "(defmethod ig/init-key :app/packages [_ {:keys [package-names extra-package-names]}]" :see (("packages/load-packages" . "load-packages") ("packages/sync-fn-entities-from-packages!" . "sync-fn-entities-from-packages!")) :refs (("constellation/read-manifest" . "read-manifest")) :siblings nil
     :say "Loads core, web, app, [addon](#term/integrant) packages, and external packages from the operator manifest. The following [base-function](#term/base-function) and function-entity components register implementations and synchronize graph definitions into storage.")
    (:key "boot/context" :n 7 :gi 151 :defn "context" :ns "graphden.system.init.exec" :file "src/graphden/system/init/exec.clj" :line 136 :lang "clj" :mins 6.7 :head "(defmethod ig/init-key :exec/context" :see (("executor/create-context" . "create-context")) :refs (("constellation/merge-addon" . "merge-addon")) :siblings (("boot/compiled-registry" . "compiled-registry"))
     :say "Builds the base [execution context](#term/context), including [authentication](#term/auth), request scoping, execution checks, vault access, notifications, and [fleet](#term/fleet) forwarding. Branch-specific contexts are derived later. `:compile-storage` may provide a privileged structural graph view; it must not be confused with organisation-scoped application data reads.")
    (:key "boot/compiled-registry" :n 8 :gi 152 :defn "compiled-registry" :ns "graphden.system.init.exec" :file "src/graphden/system/init/exec.clj" :line 237 :lang "clj" :mins 0.9 :head "(defmethod ig/init-key :exec/compiled-registry [_ {:keys [context]}]" :see (("executor/rebuild!" . "rebuild!") ("executor/registry" . "registry")) :refs nil :siblings (("boot/context" . "context"))
     :say "Compiles the graph before serving the first request so the base context starts with a populated [compiled registry](#term/compiled-registry). Subsequent graph changes can still invalidate or update it; this startup compilation does not make the registry permanent.")
    (:key "boot/dispatch-first" :n 9 :gi 153 :defn "dispatch-first" :ns "graphden.system.route-collection" :file "src/graphden/system/route_collection.clj" :line 91 :lang "clj" :mins 1.1 :head "(defn dispatch-first" :see nil :refs (("web/sync-fn-defs-branch!" . "sync-fn-defs-branch!") ("constellation/merge-addon" . "merge-addon")) :siblings nil
     :say "Tries optional registered [Ring](#term/ring) routers in order. A router returns nil to let the next router handle the request; when none handles it, the application router is used. Packages and [addons](#term/integrant) can register routes without changing the core handler chain.")
    (:key "boot/check-router!" :n 10 :gi 154 :defn "check-router!" :ns "graphden.system.api-url-drift" :file "src/graphden/system/api_url_drift.clj" :line 285 :lang "clj" :mins 1.4 :head "(defn check-router!" :see nil :refs nil :siblings nil
     :say "Compares literal `/api/*` and `/partials/*` paths in editor JavaScript with the actual router during boot. A missing route prevents startup. This catches changes to those statically discoverable paths; dynamically constructed URLs still need their own tests.")
    (:key "boot/-main~2" :n 11 :gi 155 :defn "-main" :ns "graphden.cli" :file "src/graphden/cli.clj" :line 304 :lang "clj" :mins 1.6 :head "(defn -main" :see nil :refs nil :siblings nil
     :say "The CLI is a second entry point using the same application artifact. It transfers and compares graph branches through authenticated HTTP APIs using export, import, diff, push, and pull. It does not require direct database access.")
    (:key "boot/register-checkpoint-hooks!" :n 12 :gi 156 :defn "register-checkpoint-hooks!" :ns "graphden.crac" :file "src/graphden/crac.clj" :line 202 :lang "clj" :mins 1.3 :head "(defn register-checkpoint-hooks!" :see nil :refs nil :siblings nil
     :say "Registers optional [CRaC](#term/checkpoint) [checkpoint/restore](#term/checkpoint) hooks. Before a [checkpoint](#term/checkpoint), schedulers pause and open connections and listeners close; restore resumes them. These hooks do nothing on an ordinary JVM. See [fleet checkpoint design](../../docs/FLEET_RFC.md) and `development/crac/`.")))
  (:id "web" :title "Web — HTTP handlers and rendering" :status "toured" :mins 28.1 :summary "Requests, routing, markup, and graph-backed APIs."
   :steps
   ((:key "web/http-server" :n 1 :gi 157 :defn "http-server" :ns "resources/packages/web/http/impls.clj" :file "resources/packages/web/http/impls.clj" :line 233 :lang "clj" :mins 4.8 :head "(defbase http-server" :see nil :refs nil :siblings (("web/realize-request-body" . "realize-request-body") ("web/pick-encoding-fn" . "pick-encoding-fn"))
     :say "Starts an http-kit listener with the composed [Ring](#term/ring) handler on a configured port and records network/process [effects](#term/effect). This [base function](#term/base-function) manages the listener; surrounding request and response behavior is composed in `web/http/fns.edn`.")
    (:key "web/realize-request-body" :n 2 :gi 158 :defn "realize-request-body" :ns "resources/packages/web/http/impls.clj" :file "resources/packages/web/http/impls.clj" :line 137 :lang "clj" :mins 0.7 :head "(defbase realize-request-body" :see nil :refs nil :siblings (("web/http-server" . "http-server") ("web/pick-encoding-fn" . "pick-encoding-fn"))
     :say "Reads an incoming request body completely so graph handlers receive reusable data rather than a stream that can be consumed only once.")
    (:key "web/ring-handler-fn" :n 3 :gi 159 :defn "ring-handler-fn" :ns "resources/packages/web/reitit/impls.clj" :file "resources/packages/web/reitit/impls.clj" :line 45 :lang "clj" :mins 0.9 :head "(defbase ring-handler-fn" :see nil :refs nil :siblings (("web/ring-router-fn" . "ring-router-fn") ("web/ring-create-default-handler-fn" . "ring-create-default-handler-fn") ("web/middleware" . "middleware"))
     :say "Combines a compiled [Reitit](#term/ring) router with the default handler into the [Ring](#term/ring) function called for each HTTP request. The router selects the route; the default handler covers requests it cannot handle.")
    (:key "web/ring-router-fn" :n 4 :gi 160 :defn "ring-router-fn" :ns "resources/packages/web/reitit/impls.clj" :file "resources/packages/web/reitit/impls.clj" :line 21 :lang "clj" :mins 1.1 :head "(defbase ring-router-fn" :see nil :refs nil :siblings (("web/ring-handler-fn" . "ring-handler-fn") ("web/ring-create-default-handler-fn" . "ring-create-default-handler-fn") ("web/middleware" . "middleware"))
     :say "Builds a [Reitit](#term/ring) [Ring](#term/ring) router from route data composed as graph values. The resulting routing table associates request paths with handlers.")
    (:key "web/ring-create-default-handler-fn" :n 5 :gi 161 :defn "ring-create-default-handler-fn" :ns "resources/packages/web/reitit/impls.clj" :file "resources/packages/web/reitit/impls.clj" :line 32 :lang "clj" :mins 1.2 :head "(defbase ring-create-default-handler-fn" :see nil :refs nil :siblings (("web/ring-handler-fn" . "ring-handler-fn") ("web/ring-router-fn" . "ring-router-fn") ("web/middleware" . "middleware"))
     :say "Builds the fallback handler for requests with no matching route, method, or acceptable response. The corresponding 404, 405, and 406 responses are graph-composed values.")
    (:key "web/middleware" :n 6 :gi 162 :defn "middleware" :ns "resources/packages/web/reitit/impls.clj" :file "resources/packages/web/reitit/impls.clj" :line 64 :lang "clj" :mins 1.3 :head "(defbase middleware" :see nil :refs nil :siblings (("web/ring-handler-fn" . "ring-handler-fn") ("web/ring-router-fn" . "ring-router-fn") ("web/ring-create-default-handler-fn" . "ring-create-default-handler-fn"))
     :say "Builds [middleware](#term/ring) from a [graph function](#term/graph-function) with [free arguments](#term/free-argument) `:request` and `:next-handler`. The returned [Reitit](#term/ring) `:wrap` function surrounds each route handler, allowing request processing shared across routes to be expressed in the graph.")
    (:key "web/current-branch-router" :n 7 :gi 163 :defn "current-branch-router" :ns "resources/packages/web/branch-router/impls.clj" :file "resources/packages/web/branch-router/impls.clj" :line 10 :lang "clj" :mins 0.9 :head "(defbase current-branch-router" :see nil :refs nil :siblings (("web/dispatch-to-branch" . "dispatch-to-branch"))
     :say "Reads the installed branch router from its shared holder. It returns nil before boot installs the router; branch-dispatch [middleware](#term/ring) uses this value to reach branch-specific handlers.")
    (:key "web/dispatch-to-branch" :n 8 :gi 164 :defn "dispatch-to-branch" :ns "resources/packages/web/branch-router/impls.clj" :file "resources/packages/web/branch-router/impls.clj" :line 18 :lang "clj" :mins 1.8 :head "(defbase dispatch-to-branch" :see (("versioning/dispatch*" . "dispatch*")) :refs nil :siblings (("web/current-branch-router" . "current-branch-router"))
     :say "Delegates a [Ring](#term/ring) request to the handler for its selected branch. One listening server can therefore execute different branch-specific graphs. This is the package-level caller of the branch router explained in the versioning block.")
    (:key "web/authenticate-request" :n 9 :gi 165 :defn "authenticate-request" :ns "resources/packages/web/ring-adapter/impls.clj" :file "resources/packages/web/ring-adapter/impls.clj" :line 12 :lang "clj" :mins 1.0 :head "(defbase authenticate-request" :see nil :refs nil :siblings nil
     :say "Authenticates the request before page or action execution. This is part of the handler chain after routing, separate from later checks of what the authenticated caller may do.")
    (:key "web/write-rej" :n 10 :gi 166 :defn "write-rej" :ns "resources/packages/web/crud-write/impls.clj" :file "resources/packages/web/crud-write/impls.clj" :line 35 :lang "clj" :mins 1.9 :head "(defbase write-rej" :see (("crud/write-rej" . "write-rej") ("crud/apply-create-core" . "apply-create-core")) :refs (("editor/writeBindingFields" . "writeBindingFields")) :siblings nil
     :say "Exposes pre-write validation as one [base function](#term/base-function) returning a rejection reason or nil. The surrounding CRUD routes compose parsing, validation, and application as [graph functions](#term/graph-function). Reference-cycle, [inheritance](#term/inheritance), override, and closed-list checks remain shared with the CRUD implementation.")
    (:key "web/form-decode" :n 11 :gi 167 :defn "form-decode" :ns "resources/packages/web/crud-parse/impls.clj" :file "resources/packages/web/crud-parse/impls.clj" :line 80 :lang "clj" :mins 1.6 :head "(defbase form-decode" :see nil :refs nil :siblings nil
     :say "Decodes form data and normalizes repeated-key values to the declared text-map result. It uses the form codec rather than a regular expression, avoiding regex input-length limits for large values such as edited assets.")
    (:key "web/hiccup-element" :n 12 :gi 168 :defn "hiccup-element" :ns "resources/packages/web/html/impls.clj" :file "resources/packages/web/html/impls.clj" :line 26 :lang "clj" :mins 0.9 :head "(defbase hiccup-element" :see (("editor/bindActionDispatch" . "bindActionDispatch") ("editor/loadPartial" . "loadPartial")) :refs (("editor/bindActionDispatch" . "bindActionDispatch") ("editor/mount" . "mount")) :siblings (("web/h-raw" . "h-raw") ("web/render-hiccup" . "render-hiccup"))
     :say "Constructs a [Hiccup](#term/hiccup) element from tag, attributes, and children. Graph-composed pages use it to build markup, including `data-action` attributes handled by the browser runtime and [HTMX](#term/htmx) attributes requesting [server-rendered fragments](#term/htmx). This creates markup; browser interaction still requires the corresponding runtime.")
    (:key "web/h-raw" :n 13 :gi 169 :defn "h-raw" :ns "resources/packages/web/html/impls.clj" :file "resources/packages/web/html/impls.clj" :line 18 :lang "clj" :mins 1.0 :head "(defbase h-raw" :see nil :refs nil :siblings (("web/hiccup-element" . "hiccup-element") ("web/render-hiccup" . "render-hiccup"))
     :say "Marks a string as raw [Hiccup](#term/hiccup) content so trusted script or style text is emitted without HTML escaping. This is used for bundled frontend assets. It must not be confused with sanitization of user-authored markup.")
    (:key "web/render-hiccup" :n 14 :gi 170 :defn "render-hiccup" :ns "resources/packages/web/html/impls.clj" :file "resources/packages/web/html/impls.clj" :line 13 :lang "clj" :mins 0.7 :head "(defbase render-hiccup" :see nil :refs nil :siblings (("web/hiccup-element" . "hiccup-element") ("web/h-raw" . "h-raw"))
     :say "Serializes a [Hiccup](#term/hiccup) tree into HTML. Its type rule propagates [secret markings](#term/secret) so rendering a secret-derived value does not remove the information needed for [redaction](#term/secret).")
    (:key "web/pick-encoding-fn" :n 15 :gi 171 :defn "pick-encoding-fn" :ns "resources/packages/web/http/impls.clj" :file "resources/packages/web/http/impls.clj" :line 159 :lang "clj" :mins 1.3 :head "(defbase pick-encoding-fn" :see nil :refs nil :siblings (("web/http-server" . "http-server") ("web/realize-request-body" . "realize-request-body"))
     :say "Chooses response encoding from `Accept-Encoding`. The surrounding `:process-response` [graph function](#term/graph-function) decides whether compression is appropriate and prepares headers and body. This primitive contains the header-parsing logic shared by that composition.")
    (:key "web/compatible-type-names" :n 16 :gi 172 :defn "compatible-type-names" :ns "graphden.crud.types-api" :file "src/graphden/crud/types_api.clj" :line 216 :lang "clj" :mins 1.2 :head "(defn compatible-type-names" :see nil :refs nil :siblings (("web/api-rich-types" . "api-rich-types") ("web/candidate-fit" . "candidate-fit"))
     :say "Finds named types that may narrow the expected type, resolving aliases and checking [subtyping](#term/subtype) on the server. The picker receives one rendered set of options instead of issuing a separate compatibility request for each type name.")
    (:key "web/api-rich-types" :n 17 :gi 173 :defn "api-rich-types" :ns "graphden.crud.types-api" :file "src/graphden/crud/types_api.clj" :line 844 :lang "clj" :mins 1.2 :head "(defn api-rich-types" :see nil :refs (("types/record-rich-types!" . "record-rich-types!")) :siblings (("web/compatible-type-names" . "compatible-type-names") ("web/candidate-fit" . "candidate-fit"))
     :say "Shapes the [rich-types registry](#term/rich-types) into the compact `/api/types` response used by the editor. Fields unnecessary for the bulk listing are omitted; specialized interfaces fetch or render the details they need separately.")
    (:key "web/candidate-fit" :n 18 :gi 174 :defn "candidate-fit" :ns "graphden.crud.types-api" :file "src/graphden/crud/types_api.clj" :line 595 :lang "clj" :mins 2.2 :head "(defn candidate-fit" :see nil :refs nil :siblings (("web/compatible-type-names" . "compatible-type-names") ("web/api-rich-types" . "api-rich-types"))
     :say "Ranks already-admissible function candidates by how their parameters fit a callable [slot](#term/slot). `:exact` uses the supplied parameter count, `:captures` needs additional [captured input](#term/capture), and `:ignores` consumes fewer parameters. Ranking changes display order, not whether the type checker admits a candidate.")
    (:key "web/sync-fn-defs-branch!" :n 19 :gi 175 :defn "sync-fn-defs-branch!" :ns "resources/packages/storage/branches/impls.clj" :file "resources/packages/storage/branches/impls.clj" :line 49 :lang "clj" :mins 2.4 :head "(defbase sync-fn-defs-branch!" :see (("executor/sync-fns-to-storage!" . "sync-fns-to-storage!") ("boot/dispatch-first" . "dispatch-first")) :refs nil :siblings nil
     :say "Synchronizes function definitions into a specified branch for [MCP](#term/mcp) and bundle-import callers. It uses the same synchronization checks as packaged definitions and invalidates the target branch's [compiled registry](#term/compiled-registry). The target may differ from the branch carrying the HTTP request.")))
  (:id "layout" :title "Layout — graph structure and coordinates" :status "toured" :mins 20.9 :summary "From graph rows and expansion state to nodes, edges, and a grid."
   :steps
   ((:key "layout/load-graph-entities-uncached" :n 1 :gi 176 :defn "load-graph-entities-uncached" :ns "graphden.layout.data" :file "src/graphden/layout/data.clj" :line 341 :lang "clj" :mins 1.0 :head "(defn load-graph-entities-uncached" :see nil :refs nil :siblings (("layout/derive-fn-slot-views" . "derive-fn-slot-views"))
     :say "Loads the graph entity rows needed for layout as a snapshot. Versioned storage can supply a branch-cached batch; ordinary storage uses separate entity queries. Later layout stages transform this snapshot, while the context cache avoids repeated database reads.")
    (:key "layout/derive-fn-slot-views" :n 2 :gi 177 :defn "derive-fn-slot-views" :ns "graphden.layout.data" :file "src/graphden/layout/data.clj" :line 275 :lang "clj" :mins 4.6 :head "(defn derive-fn-slot-views" :see nil :refs (("editor/createFnOverlay" . "createFnOverlay")) :siblings (("layout/load-graph-entities-uncached" . "load-graph-entities-uncached"))
     :say "Derives each function's visible argument rows from inherited [slots](#term/slot) and effective [bindings](#term/binding). Nearer [bindings](#term/binding) override more distant ones. `:source-id` retains the declaring ancestor's provenance for inherited [slots](#term/slot); it is not simply the current displayed function ID.")
    (:key "layout/build-graph-elements" :n 3 :gi 178 :defn "build-graph-elements" :ns "graphden.layout.graph" :file "src/graphden/layout/graph.clj" :line 994 :lang "clj" :mins 5.5 :head "(defn build-graph-elements" :see nil :refs (("editor/fetchBackendLayout" . "fetchBackendLayout")) :siblings nil
     :say "Walks the requested node expansions with cycle protection and collects graph elements. Post-processing adds optional-argument and [HOF](#term/hof) badges, adjusts captured-argument edges, removes duplicate overlays, and attaches display facts. The result supplies the client's node and edge lists.")
    (:key "layout/emit-root-deep-frees!" :n 4 :gi 179 :defn "emit-root-deep-frees!" :ns "graphden.layout.builder-helpers" :file "src/graphden/layout/builder_helpers.clj" :line 1131 :lang "clj" :mins 5.7 :head "(defn emit-root-deep-frees!" :see nil :refs nil :siblings nil
     :say "Adds placeholders for required public inputs reached through bound references, including required [HOF](#term/hof) [captures](#term/capture) reported by `surface/public-free-entries`. Optional [captures](#term/capture) do not create required holes. The placeholder keeps the inner [slot](#term/slot) identity while targeting the root function so [binding](#term/binding) an input matches the Run form's public argument model.")
    (:key "layout/compute-layout-matrix" :n 5 :gi 180 :defn "compute-layout-matrix" :ns "graphden.layout.core" :file "src/graphden/layout/core.clj" :line 308 :lang "clj" :mins 1.8 :head "(defn compute-layout-matrix" :see nil :refs (("editor/fetchBackendLayout" . "fetchBackendLayout")) :siblings nil
     :say "Assigns graph elements to grid columns and rows and reports layout validation results. The browser later measures actual card sizes and converts the grid into pixel coordinates. This separates graph ordering from DOM-dependent geometry.")
    (:key "layout/annotate" :n 6 :gi 181 :defn "annotate" :ns "graphden.layout.strip-facts" :file "src/graphden/layout/strip_facts.clj" :line 85 :lang "clj" :mins 2.3 :head "(defn annotate" :see (("versioning/effective-branch-local?" . "effective-branch-local?")) :refs nil :siblings nil
     :say "Attaches computed facts to function nodes: the inherited return-type alias, the [base function](#term/base-function) owning a return-type rule, and the ancestor responsible for [branch-local](#term/branch-local) behavior. The editor displays these server-computed facts instead of repeating the same traversals in JavaScript.")))
  (:id "editor" :title "Editor — browser behavior" :status "toured" :mins 131.2 :summary "Loading, graph-backed controls, actions, forms, and preferences."
   :steps
   ((:key "editor/initGraph" :n 1 :gi 182 :defn "initGraph" :ns "resources/packages/app/editor/editor-main.js" :file "resources/packages/app/editor/editor-main.js" :line 318 :lang "js" :mins 4.3 :head "async function initGraph() {" :see (("editor/authFetch" . "authFetch")) :refs nil :siblings nil
     :say "Initializes the editor's plain JavaScript modules, concatenated in a fixed order. It first requests the namespace tree to determine [authentication](#term/auth) state, then starts secondary loads; function details load on demand. A 401 opens sign-in. See the [module map](../../docs/EDITOR_MODULES.md).")
    (:key "editor/buildLookups" :n 2 :gi 183 :defn "buildLookups" :ns "resources/packages/app/editor/editor-data.js" :file "resources/packages/app/editor/editor-data.js" :line 118 :lang "js" :mins 6.7 :head "function buildLookups(data) {" :see (("executor/build-lookups" . "build-lookups")) :refs (("editor/writeBindingFields" . "writeBindingFields")) :siblings nil
     :say "Indexes downloaded function, [slot](#term/slot), [binding](#term/binding), and list-item rows for client rendering. Maps such as `fnMap` and `bindingByFnSlot` replace repeated scans of the same arrays. Because writes rebuild these lookups, their cost affects editor refresh latency.")
    (:key "editor/graph" :n 3 :gi 184 :defn "graph" :ns "resources/packages/app/editor/editor-graph-model.js" :file "resources/packages/app/editor/editor-graph-model.js" :line 16 :lang "js" :mins 1.1 :head "const graph = {" :see nil :refs nil :siblings nil
     :say "Stores nodes, edges, adjacency indexes, and animation state without a graph-rendering library. `window.graphView` exposes readiness and animation status used by browser tests. Rendering and measurement live in the surrounding editor modules.")
    (:key "editor/fetchBackendLayout" :n 4 :gi 185 :defn "fetchBackendLayout" :ns "resources/packages/app/editor/editor-layout.js" :file "resources/packages/app/editor/editor-layout.js" :line 330 :lang "js" :mins 10.2 :head "async function fetchBackendLayout() {" :see (("layout/build-graph-elements" . "build-graph-elements") ("layout/compute-layout-matrix" . "compute-layout-matrix")) :refs (("editor/writeBindingFields" . "writeBindingFields")) :siblings nil
     :say "Requests grid layout from `/api/graph/layout` using the selected root and expansion state. The browser then measures cards and edge labels to calculate column widths and gaps. The server determines graph order; the browser fits that order to actual pixel sizes.")
    (:key "editor/renderGraph" :n 5 :gi 186 :defn "renderGraph" :ns "resources/packages/app/editor/editor-render.js" :file "resources/packages/app/editor/editor-render.js" :line 96 :lang "js" :mins 9.9 :head "async function renderGraph(shouldFit = true) {" :see nil :refs nil :siblings nil
     :say "Coordinates one asynchronous render. A generation counter prevents an older render from replacing a newer one; a remembered anchor preserves the user's position while data loads. After applying layout changes, it measures [DOM](#term/hiccup) cards and adjusts positions to their actual sizes.")
    (:key "editor/createFnOverlay" :n 6 :gi 187 :defn "createFnOverlay" :ns "resources/packages/app/editor/editor-overlay-fn.js" :file "resources/packages/app/editor/editor-overlay-fn.js" :line 215 :lang "js" :mins 8.9 :head "function createFnOverlay(node, container) {" :see (("layout/derive-fn-slot-views" . "derive-fn-slot-views")) :refs nil :siblings nil
     :say "Builds an absolutely positioned HTML function card; edges are separate SVG elements. The card contains inherited levels, a use-site heading for expanded references, and [slot](#term/slot) rows. These controls present the stored function/[slot](#term/slot)/[binding](#term/binding) model for editing.")
    (:key "editor/bindActionDispatch" :n 7 :gi 188 :defn "bindActionDispatch" :ns "resources/packages/web/runtime/graphden-runtime.js" :file "resources/packages/web/runtime/graphden-runtime.js" :line 78 :lang "js" :mins 2.2 :head "function bindActionDispatch(host) {" :see (("web/hiccup-element" . "hiccup-element")) :refs (("web/hiccup-element" . "hiccup-element")) :siblings (("editor/loadPartial" . "loadPartial"))
     :say "Registers one delegated event listener on a host and resolves `data-action` through the action-handler registry. Newly inserted server fragments become interactive without individual listener registration. Registering the listener once prevents repeated openings of a reused popover from executing the same action multiple times.")
    (:key "editor/loadPartial" :n 8 :gi 189 :defn "loadPartial" :ns "resources/packages/web/runtime/graphden-runtime.js" :file "resources/packages/web/runtime/graphden-runtime.js" :line 141 :lang "js" :mins 1.9 :head "async function loadPartial(host, url, opts) {" :see nil :refs (("web/hiccup-element" . "hiccup-element")) :siblings (("editor/bindActionDispatch" . "bindActionDispatch"))
     :say "Loads a [server-rendered HTML fragment](#term/htmx) into a host and attaches action dispatch. A request token ensures that a later request wins even if an earlier response arrives last. See the [partial-fragment contract](../../docs/PARTIALS.md).")
    (:key "editor/loadRowActionsContent" :n 9 :gi 190 :defn "loadRowActionsContent" :ns "resources/packages/app/editor/editor-row-actions.js" :file "resources/packages/app/editor/editor-row-actions.js" :line 421 :lang "js" :mins 3.8 :head "async function loadRowActionsContent(host, fnId, context, opts) {" :see nil :refs nil :siblings nil
     :say "Loads the row-action menu as a server fragment, caching HTML by request URL. Compatibility for adding a parent is recalculated against current client lookups rather than trusted from stale HTML. See [row actions](../../docs/EDITOR_ROW_ACTIONS.md).")
    (:key "editor/publishHttpHost" :n 10 :gi 191 :defn "publishHttpHost" :ns "resources/packages/app/editor/editor-http-host.js" :file "resources/packages/app/editor/editor-http-host.js" :line 61 :lang "js" :mins 2.1 :head "async function publishHttpHost(state) {" :see nil :refs nil :siblings nil
     :say "Stages a create-only publication UUID before sending the request. The graph partial owns dialog markup; this client operation preserves exact cleanup after a lost response and displays a public URL only after the server confirms publication.")
    (:key "editor/_tourTrackHttpPublication" :n 11 :gi 192 :defn "_tourTrackHttpPublication" :ns "resources/packages/app/editor/editor-tour-session.js" :file "resources/packages/app/editor/editor-tour-session.js" :line 290 :lang "js" :mins 1.1 :head "function _tourTrackHttpPublication(id, fn) {" :see nil :refs nil :siblings nil
     :say "Records the exact lease, handler, namespace, branch, lesson session, and principal before publication. Cleanup can revoke that lease after its lesson branches disappear without guessing identity from a name or deleting another account's publication.")
    (:key "editor/applyInheritancePreview" :n 12 :gi 193 :defn "applyInheritancePreview" :ns "resources/packages/app/editor/editor-inheritance-api.js" :file "resources/packages/app/editor/editor-inheritance-api.js" :line 45 :lang "js" :mins 1.4 :head "async function applyInheritancePreview(preview, beforeApply) {" :see nil :refs nil :siblings nil
     :say "Inheritance changes use an authoritative preview followed by one atomic apply. The browser confirms the exact orphan binding IDs and echoes the snapshot digest; a stale request never silently accepts a refreshed deletion set. Parent-edge variation creates a sibling source and reparents the target, preserving its own composition. All consumers of that target in the branch see the change; the original source stays unchanged. The graph partial owns availability and scope wording. See [lesson 7](../../docs/tutorial/07-optional-required-sealed.md).")
    (:key "editor/pickerArrange" :n 13 :gi 194 :defn "pickerArrange" :ns "resources/packages/app/editor/editor-fn-picker-rank.js" :file "resources/packages/app/editor/editor-fn-picker-rank.js" :line 122 :lang "js" :mins 5.0 :head "function pickerArrange(candidates, opts) {" :see nil :refs (("editor/createRuntime" . "createRuntime")) :siblings nil
     :say "Orders function-picker candidates without accessing the [DOM](#term/hiccup) or network. Exact-name matches come first, followed by namespace groups and compatibility/fit ranking. Typed searches show all matches; browsing can fold groups. The server's `candidate-fit` in the Web block supplies fit metadata without changing type admissibility.")
    (:key "editor/export-plan" :n 14 :gi 195 :defn "export-plan" :ns "graphden.executor.browser-plan" :file "src/graphden/executor/browser_plan.clj" :line 337 :lang "clj" :mins 2.7 :head "(defn export-plan" :see (("executor/build-lookups" . "build-lookups") ("editor/createRuntime" . "createRuntime")) :refs nil :siblings nil
     :say "The ordinary account menu, function picker and Explorer navigation trail use bundled graph plans for their local state or markup. This exporter resolves inheritance, bindings, and renames on the server and emits an ID-based plan for supported primitives; the browser does not resolve graph names itself. Shipped plans are generated during development. The generic editable-graph export takes a whole snapshot and remains unavailable under tenancy. Personal components instead use `graphden.editor.components/export-current`, which authorizes every source dependency and exports only a bounded component plan. See the [graph-backed UI contract](../../resources/packages/app/ui-preview/README.md).")
    (:key "editor/createRuntime" :n 15 :gi 196 :defn "createRuntime" :ns "resources/packages/app/ui-preview/browser-runtime.js" :file "resources/packages/app/ui-preview/browser-runtime.js" :line 226 :lang "js" :mins 5.1 :head "  function createRuntime(plan, {operationLimit = 10000} = {}) {" :see (("editor/mount" . "mount") ("editor/pickerArrange" . "pickerArrange")) :refs (("editor/export-plan" . "export-plan") ("editor/renderRecentFns" . "renderRecentFns") ("editor/mount" . "mount")) :siblings nil
     :say "Creates the bounded browser interpreter for that plan. Each entry invocation has lazy argument reads, memoized calls, and an operation limit; unsupported primitives fail. This backend supports a small part of the graph vocabulary, separate from the JVM executor. `editor-shell-menu-graph.js` and `editor-fn-picker-graph.js` connect shipped plans to real controls; native host code retains authentication, search, type verdicts, authorized actions, and focus.")
    (:key "editor/create" :n 16 :gi 197 :defn "create" :ns "resources/packages/app/ui-preview/graph-component.js" :file "resources/packages/app/ui-preview/graph-component.js" :line 5 :lang "js" :mins 5.9 :head "  function create(runtime, {inputs, validateState, validateView, requests, render = null, onError = error => { throw error; }, rendererOptions = {}}) {" :see (("editor/mount" . "mount") ("editor/renderRecentFns" . "renderRecentFns")) :refs nil :siblings nil
     :say "Owns component state and serializes events independently of the DOM renderer. Initial, update and view remain ordinary graph functions. Every transition validates the next state, complete Hiccup/styles and all fixed host requests before rendering, committing state and running effects. Runtime replacement preserves validated state; cancellation discards late effect completions after replacement or disposal.")
    (:key "editor/renderRecentFns" :n 17 :gi 198 :defn "renderRecentFns" :ns "resources/packages/app/editor/editor-recents.js" :file "resources/packages/app/editor/editor-recents.js" :line 164 :lang "js" :mins 1.6 :head "function renderRecentFns() {" :see (("editor/mount" . "mount") ("editor/createRuntime" . "createRuntime")) :refs (("editor/create" . "create")) :siblings nil
     :say "The Explorer trail executes the shipped `app.ui-recents` initial and view graphs. Its update graph returns state and fixed persistence/navigation requests, deduplicates selections, limits the trail and toggles pins; the view excludes the selected function and pinned duplicates and hides during searches or filters. Ordinary row functions produce Hiccup and scoped styles. The host persists localStorage, resolves namespace paths and delegates navigation; keyed rendering preserves focused pin buttons.")
    (:key "editor/mount" :n 18 :gi 199 :defn "mount" :ns "resources/packages/app/ui-preview/graph-renderer.js" :file "resources/packages/app/ui-preview/graph-renderer.js" :line 82 :lang "js" :mins 2.7 :head "  function mount(host, {idPrefix = null, nodeLimit = 5000} = {}) {" :see (("editor/createRuntime" . "createRuntime") ("web/hiccup-element" . "hiccup-element")) :refs (("editor/createRuntime" . "createRuntime") ("editor/create" . "create") ("editor/renderRecentFns" . "renderRecentFns")) :siblings nil
     :say "Gives a graph component its own empty DOM host. `render` validates live Hiccup and scoped style rules before applying them, preserving keyed elements across updates. `dispose` removes the subtree and releases its stylesheet. The renderer consumes values rather than executing graph functions; host code still owns the control's events and authorized callbacks. Follow this lifecycle when changing a graph-backed menu or picker.")
    (:key "editor/enterArgValueEditMode" :n 19 :gi 200 :defn "enterArgValueEditMode" :ns "resources/packages/app/editor/editor-edit-modes.js" :file "resources/packages/app/editor/editor-edit-modes.js" :line 226 :lang "js" :mins 7.2 :head "function enterArgValueEditMode(arg, anchorEl) {" :see (("crud/resolve-form" . "resolve-form") ("editor/writeBindingFields" . "writeBindingFields")) :refs nil :siblings (("editor/writeBindingFields" . "writeBindingFields"))
     :say "Asks `/api/value-form` for a widget appropriate to the [slot](#term/slot), then dispatches by `data-form-widget`. The client does not choose the widget from raw type tags. After saving, it reloads [bindings](#term/binding) and lookups because changing a value changes stored graph rows.")
    (:key "editor/writeBindingFields" :n 20 :gi 201 :defn "writeBindingFields" :ns "resources/packages/app/editor/editor-edit-modes.js" :file "resources/packages/app/editor/editor-edit-modes.js" :line 531 :lang "js" :mins 2.6 :head "async function writeBindingFields(arg, fields, opts) {" :see (("web/write-rej" . "write-rej") ("versioning/VersionedStorage" . "VersionedStorage") ("crud/type-check-fn-after-mutation!" . "type-check-fn-after-mutation!") ("crud/notify-after-write!" . "notify-after-write!") ("editor/buildLookups" . "buildLookups") ("editor/fetchBackendLayout" . "fetchBackendLayout")) :refs (("editor/enterArgValueEditMode" . "enterArgValueEditMode")) :siblings (("editor/enterArgValueEditMode" . "enterArgValueEditMode"))
     :say "Follow a user saving a literal input: this writer targets its function and slot, creating an own binding with POST or updating an existing one with PUT. `authMutate` sends the form body through `authFetch`; `editor-branch-context.js` attaches the current branch to API requests. The public handler is composed in [web/crud-write/fns.edn](../../resources/packages/web/crud-write/fns.edn): parse, reject unsafe changes, apply the write, then invalidate and notify. Versioned storage records the change in that branch. Ordinary type diagnostics can accompany a successful save; structural or secret-flow violations reject it. The caller reloads rows and lookups, then layout and rendering show the new value. Use the reading route in [setup](../../docs/devtour/README.md) to follow the whole round trip.")
    (:key "editor/gdEnterDiffMode" :n 21 :gi 202 :defn "gdEnterDiffMode" :ns "resources/packages/app/editor/editor-diff-mode.js" :file "resources/packages/app/editor/editor-diff-mode.js" :line 532 :lang "js" :mins 2.4 :head "async function gdEnterDiffMode(otherBranch) {" :see nil :refs nil :siblings nil
     :say "Loads grouped differences for a selected comparison branch. Explorer badges, canvas highlights, field changes, [effect](#term/effect) changes, and review comments use this data; comparison-only functions appear as additional display rows. Reads and edits still target the current branch. The comparison menu provides review and merge actions.")
    (:key "editor/submitExecution" :n 22 :gi 203 :defn "submitExecution" :ns "resources/packages/app/editor/editor-execute.js" :file "resources/packages/app/editor/editor-execute.js" :line 291 :lang "js" :mins 6.5 :head "async function submitExecution(fnEntity, args, persist, trace, captureValues," :see (("crud/apply-execute" . "apply-execute") ("executor/record-effect!" . "record-effect!") ("editor/aggregatePathTrace" . "aggregatePathTrace")) :refs (("editor/aggregatePathTrace" . "aggregatePathTrace")) :siblings nil
     :say "The selected card's Run button delegates to the existing Inspector Run owner; it does not create another execution form. That form resolves typed inputs, keeps [effect acknowledgement](#term/effect) visible, and submits through this shared function. History, Trace path and Capture values are independent request options. Capture values requires tracing and explicit cost consent; cancelling consent clears that option. The submitted function UUID and generation identify this run. A new submission stops the previous poll, clears its result identity and ignores late replies; changing selection cannot relabel an earlier run. Pending runs use the same result host and cancellation path. Server execution checks remain authoritative.")
    (:key "editor/aggregatePathTrace" :n 23 :gi 204 :defn "aggregatePathTrace" :ns "resources/packages/app/editor/editor-path-view.js" :file "resources/packages/app/editor/editor-path-view.js" :line 53 :lang "js" :mins 2.9 :head "function aggregatePathTrace(entries) {" :see (("editor/submitExecution" . "submitExecution") ("executor/record-effect!" . "record-effect!")) :refs (("editor/submitExecution" . "submitExecution")) :siblings nil
     :say "Groups a trace's invocations by function UUID, keeping call counts, cache hits and timings. Trace path without Capture values records execution without return values. With capture enabled, the latest fresh invocation owns the displayed value, including null or false. A later invocation without a value clears an earlier capture; when its capture exceeded the budget, the badge explains that the value is unavailable. It never substitutes an older result or promises to recover data that was not captured. A shortened inline preview of an available value opens the complete captured value with keyboard access. The shared popover lifecycle provides Close, bounded placement, focus return and cleanup when its anchor disappears. Secret entries carry no value.")
    (:key "editor/gdApplyThemePayload" :n 24 :gi 205 :defn "gdApplyThemePayload" :ns "resources/packages/app/editor/editor-prefs.js" :file "resources/packages/app/editor/editor-prefs.js" :line 363 :lang "js" :mins 2.0 :head "function gdApplyThemePayload(payload) {" :see (("editor/evaluate" . "evaluate")) :refs (("editor/evaluate" . "evaluate")) :siblings nil
     :say "Applies a validated theme payload as inline CSS custom properties on the body. The sanitizer permits known tokens and supported color values, rejecting injected declarations or URLs. A localStorage copy applies before first paint; saved server preferences reconcile afterward. A selected personal theme graph is evaluated on the server before this function receives its validated colors. See [themes](../../docs/MARKETPLACE.md).")
    (:key "editor/evaluate" :n 25 :gi 206 :defn "evaluate" :ns "graphden.editor.theme" :file "src/graphden/editor/theme.clj" :line 182 :lang "clj" :mins 1.7 :head "(defn evaluate" :see (("crud/apply-execute" . "apply-execute") ("executor/record-effect!" . "record-effect!") ("editor/gdApplyThemePayload" . "gdApplyThemePayload")) :refs (("executor/record-effect!" . "record-effect!") ("editor/gdApplyThemePayload" . "gdApplyThemePayload")) :siblings nil
     :say "Evaluates a selected personal theme graph in the request's existing organisation and branch. It uses the normal execution access checks, requires a non-secret pure graph, permits no effects, and limits execution to 750 ms. Only a validated theme payload reaches CSS; source graphs and execution traces are not returned. This server path is independent of the bundled local menu and picker plans. `editor-theme-graph.js` applies successful results and keeps saved colors when evaluation is unavailable.")
    (:key "editor/definitions" :n 26 :gi 207 :defn "definitions" :ns "graphden.editor.component-templates" :file "src/graphden/editor/component_templates.clj" :line 68 :lang "clj" :mins 5.5 :head "(defn definitions" :see nil :refs nil :siblings nil
     :say "Copies fixed shipped theme, menu and picker definitions into a fresh named namespace. Four configuration [bindings](#term/binding) select menu initial state, event handler, menu view and picker view by function ID. The picker graph authors presentation; native browser code retains search and navigation. Shared menu colors reference the copied theme leaves; menu hover owns a local literal. Color wrappers retain the canonical color type and ordinary editor form.")
    (:key "editor/apply!" :n 27 :gi 208 :defn "apply!" :ns "graphden.editor.component-creation" :file "src/graphden/editor/component_creation.clj" :line 217 :lang "clj" :mins 2.0 :head "(defn apply!" :see (("versioning/call-with-write" . "call-with-write")) :refs nil :siblings nil
     :say "Rebuilds the manifest, the fixed list of proposed objects and UUIDs, while holding the graph writer lock. It rejects a changed user, branch, source snapshot or existing identity. One transaction through the existing [storage decorators](#term/protocol) creates all rows with ordinary access checks. Cache-publication warnings preserve a successful commit and its identities. An internal preview lets lesson cleanup record exact new UUIDs before sending APPLY, so a lost network reply does not leave untracked objects.")
    (:key "editor/collect-closure" :n 28 :gi 209 :defn "collect-closure" :ns "graphden.executor.browser-source" :file "src/graphden/executor/browser_source.clj" :line 152 :lang "clj" :mins 1.0 :head "(defn collect-closure" :see nil :refs nil :siblings nil
     :say "Collects only the selected [reachable graph](#term/reachable-graph) and its type dependencies, limiting function and row counts. Each function's [source authorization](#term/auth) precedes its binding and literal reads. The caller supplies a snapshot-local policy; generic whole-graph preview remains unavailable to cloud tenants. Narrow exceptions for fixed shipped primitive/type interfaces verify identity and installed origin; a matching name is insufficient.")
    (:key "editor/export-current" :n 29 :gi 210 :defn "export-current" :ns "graphden.editor.components" :file "src/graphden/editor/components.clj" :line 100 :lang "clj" :mins 2.1 :head "(defn export-current" :see nil :refs nil :siblings nil
     :say "Reads the current user's authoritative configuration preference and exports a bounded JSON plan for one component. It never evaluates selected code to discover entry UUIDs. Source and policy use one snapshot; fresh checking cannot erase cached secret metadata. The editor host still owns callbacks, search, navigation and the validated DOM contract.")
    (:key "editor/gdTourRestoreUIComponentPreferences" :n 30 :gi 211 :defn "gdTourRestoreUIComponentPreferences" :ns "resources/packages/app/editor/editor-tour-ui-components.js" :file "resources/packages/app/editor/editor-tour-ui-components.js" :line 55 :lang "js" :mins 2.6 :head "async function gdTourRestoreUIComponentPreferences(created, failed) {" :see nil :refs nil :siblings nil
     :say "Restores Appearance preferences only after the lesson's exact selected graph UUID was deleted. Unrelated selections survive. Failed persistence stays in the lesson ledger and retries even when the preference owner's optimistic local value already changed.")
    (:key "editor/gdApplyKeymap" :n 31 :gi 212 :defn "gdApplyKeymap" :ns "resources/packages/app/editor/editor-shortcuts.js" :file "resources/packages/app/editor/editor-shortcuts.js" :line 81 :lang "js" :mins 1.0 :head "function gdApplyKeymap(bindings) {" :see nil :refs nil :siblings nil
     :say "Applies user key overrides by stable shortcut ID. The registry keeps defaults for reset and applies overrides when late shortcuts register too. Settings and shortcut help read the same registry so they display the effective keys.")
    (:key "editor/authFetch" :n 32 :gi 213 :defn "authFetch" :ns "resources/packages/app/editor/editor-auth.js" :file "resources/packages/app/editor/editor-auth.js" :line 114 :lang "js" :mins 1.2 :head "async function authFetch(url, opts = {}) {" :see nil :refs (("editor/initGraph" . "initGraph") ("editor/gdTourBeginBranchCreation" . "gdTourBeginBranchCreation") ("editor/gdTourRecordAppCreation" . "gdTourRecordAppCreation")) :siblings nil
     :say "Sends authenticated editor requests and handles 401 by clearing the stored credential and opening sign-in. HTTP 4xx responses still resolve normally: callers must inspect the response status. A `try/catch` alone detects network exceptions, not rejected HTTP writes.")
    (:key "editor/_tourTick" :n 33 :gi 214 :defn "_tourTick" :ns "resources/packages/app/editor/editor-tour.js" :file "resources/packages/app/editor/editor-tour.js" :line 309 :lang "js" :mins 3.7 :head "function _tourTick() {" :see nil :refs (("editor/_tourStartPositioning" . "_tourStartPositioning")) :siblings nil
     :say "Evaluates the current interactive lesson step against editor state. Lesson data comes from `app.tour/_tour-lessons`; this engine ensures required panels and targets are visible, checks the declared completion condition, and advances when it succeeds.")
    (:key "editor/gdTourBeginBranchCreation" :n 34 :gi 215 :defn "gdTourBeginBranchCreation" :ns "resources/packages/app/editor/editor-tour-receipts.js" :file "resources/packages/app/editor/editor-tour-receipts.js" :line 52 :lang "js" :mins 1.3 :head "async function gdTourBeginBranchCreation(name, baseRef) {" :see (("editor/authFetch" . "authFetch")) :refs (("editor/gdTourRecordPackageInstall" . "gdTourRecordPackageInstall") ("editor/gdTourRecordAppCreation" . "gdTourRecordAppCreation")) :siblings (("editor/gdTourRecordPackageInstall" . "gdTourRecordPackageInstall"))
     :say "Records a proposed branch UUID, its actual base branch UUID, and the current signed-in user before sending the create request. A lost response does not prove creation failed: cleanup checks these exact identities rather than deleting similarly named branches. A definite rejection clears the attempt; a transport failure keeps it for reconciliation.")
    (:key "editor/gdTourRecordPackageInstall" :n 35 :gi 216 :defn "gdTourRecordPackageInstall" :ns "resources/packages/app/editor/editor-tour-receipts.js" :file "resources/packages/app/editor/editor-tour-receipts.js" :line 123 :lang "js" :mins 1.9 :head "function gdTourRecordPackageInstall(ticket, body) {" :see (("packages/sync-namespaces!" . "sync-namespaces!") ("editor/gdTourBeginBranchCreation" . "gdTourBeginBranchCreation")) :refs nil :siblings (("editor/gdTourBeginBranchCreation" . "gdTourBeginBranchCreation"))
     :say "Records a successful lesson installation using the returned pin, branch, package-version, content hash, and newly created namespace identities. Cleanup removes only resources attributed to this lesson. Existing namespaces and installations remain untouched; a missing or mismatched response cannot establish ownership.")
    (:key "editor/gdTourRecordAppCreation" :n 36 :gi 217 :defn "gdTourRecordAppCreation" :ns "resources/packages/app/editor/editor-tour-app-receipts.js" :file "resources/packages/app/editor/editor-tour-app-receipts.js" :line 38 :lang "js" :mins 1.9 :head "async function gdTourRecordAppCreation(ticket, xhr) {" :see (("editor/gdTourBeginBranchCreation" . "gdTourBeginBranchCreation") ("editor/authFetch" . "authFetch")) :refs nil :siblings nil
     :say "An Apps form is an ordinary server mutation, not a tutorial-only endpoint. Before the request, the lesson saves a proposed create-only UUID and the exact handler and label. The returned receipt must match that UUID and the current organization's authoritative app list before the step completes. A missing response stays pending; a definite rejection grants no ownership. Both cleanup paths remove this exact route before its handler or branch, and retain the entire journal if removal cannot be confirmed.")
    (:key "editor/_tourStartPositioning" :n 37 :gi 218 :defn "_tourStartPositioning" :ns "resources/packages/app/editor/editor-tour-spot.js" :file "resources/packages/app/editor/editor-tour-spot.js" :line 28 :lang "js" :mins 5.1 :head "function _tourStartPositioning() {" :see (("editor/_tourTick" . "_tourTick")) :refs nil :siblings nil
     :say "Follows the lesson's current DOM target independently of the 600 ms completion poll. DOM, size, scroll and viewport changes coalesce into one requestAnimationFrame update; short finite CSS motion and native Web Animations reported by their owners keep updates running while active. Native motion must affect a declared step target; pause, cancellation or detachment ends frame following. The observer excludes the tour's own overlay writes, so a stationary lesson performs no geometry scans. Pause, Lessons, lesson end and teardown call `_tourStopFollowing` to release observers, event handlers, the viewport subscription and any queued frame.")))
  (:id "services" :title "Services — instances and placement" :status "toured" :mins 57.0 :summary "Reconciliation, service discovery, tracing, and executor placement."
   :steps
   ((:key "services/extend-builder" :n 1 :gi 219 :defn "extend-builder" :ns "graphden.schema.services.schema" :file "src/graphden/schema/services/schema.clj" :line 295 :lang "clj" :mins 5.5 :head "(defn extend-builder" :see nil :refs nil :siblings (("services/effective-pool-size" . "effective-pool-size"))
     :say "Declares stored service configuration and the restart-policy and [cardinality](#term/cardinality) enums. A service row specifies a function to keep running; it is not versioned. [Reconciliation](#term/reconciliation) compares this desired configuration with actual running instances.")
    (:key "services/effective-pool-size" :n 2 :gi 220 :defn "effective-pool-size" :ns "graphden.schema.services.schema" :file "src/graphden/schema/services/schema.clj" :line 154 :lang "clj" :mins 1.5 :head "(defn effective-pool-size" :see nil :refs nil :siblings (("services/extend-builder" . "extend-builder"))
     :say "Converts [cardinality](#term/cardinality) into the number of [advisory-lock](#term/advisory-lock) permits: `:singleton` allows one instance, `:pool` allows N, and `:per-pod` runs independently on each process. These permits are concurrency controls, not graph [argument slots](#term/slot).")
    (:key "services/diff-desired" :n 3 :gi 221 :defn "diff-desired" :ns "graphden.services.reconciler" :file "src/graphden/services/reconciler.clj" :line 80 :lang "clj" :mins 1.4 :head "(defn diff-desired" :see nil :refs nil :siblings (("services/reconcile-once!" . "reconcile-once!") ("services/start-service!" . "start-service!"))
     :say "Purely compares enabled service rows with the in-process running set and returns `:to-start` and `:to-stop`. Separating this decision from starting or stopping services makes [reconciliation](#term/reconciliation) policy directly testable.")
    (:key "services/reconcile-once!" :n 4 :gi 222 :defn "reconcile-once!" :ns "graphden.services.reconciler" :file "src/graphden/services/reconciler.clj" :line 392 :lang "clj" :mins 3.6 :head "(defn reconcile-once!" :see nil :refs (("storage/create-listener" . "create-listener") ("boot/-main" . "-main")) :siblings (("services/diff-desired" . "diff-desired") ("services/start-service!" . "start-service!"))
     :say "Performs one [reconciliation](#term/reconciliation) pass: reads desired services, detects configuration changes, plans starts/stops, and attempts to acquire [execution permits](#term/cardinality). Both write notifications and periodic ticks invoke it, so later passes can recover after missed notifications or a crashed instance owner.")
    (:key "services/start-service!" :n 5 :gi 223 :defn "start-service!" :ns "graphden.services.reconciler" :file "src/graphden/services/reconciler.clj" :line 164 :lang "clj" :mins 4.1 :head "(defn start-service!" :see nil :refs nil :siblings (("services/diff-desired" . "diff-desired") ("services/reconcile-once!" . "reconcile-once!"))
     :say "Starts the service function through the executor and retries startup failures according to the restart policy. When retries are exhausted it records `:start-failed-at`, preventing the [reconciler](#term/reconciliation) from continuously retrying without delay.")
    (:key "services/endpoint-of" :n 6 :gi 224 :defn "endpoint-of" :ns "graphden.services.instances" :file "src/graphden/services/instances.clj" :line 48 :lang "clj" :mins 1.1 :head "(defn endpoint-of" :see nil :refs nil :siblings nil
     :say "Reads endpoint metadata from the service handle and adds the starting executor's reachable host. The resulting host and port are recorded on the service-instance row, whose [heartbeat](#term/fleet) is refreshed during [reconciliation](#term/reconciliation). Other services resolve this row to find an active endpoint.")
    (:key "services/dependency-closure" :n 7 :gi 225 :defn "dependency-closure" :ns "graphden.storage.protocol.generic-constraints" :file "src/graphden/storage/protocol/generic_constraints.clj" :line 125 :lang "clj" :mins 3.3 :head "(defn dependency-closure" :see nil :refs nil :siblings nil
     :say "Loads a referenced function's execution graph in one batch, then walks execution dependencies in memory for cycle detection. Identity-only references are excluded because naming a service does not execute it. Constraint-vector type names are resolved during traversal.")
    (:key "services/check-liveness!" :n 8 :gi 226 :defn "check-liveness!" :ns "graphden.services.liveness" :file "src/graphden/services/liveness.clj" :line 119 :lang "clj" :mins 2.3 :head "(defn check-liveness!" :see nil :refs nil :siblings nil
     :say "Checks service handles for liveness and exit status. A stopped instance loses its stored row and [execution permit](#term/cardinality); restart policy then determines whether to restart any exit, only a failure, or neither. Active instances refresh their [heartbeats](#term/fleet).")
    (:key "services/resolve-endpoint" :n 9 :gi 227 :defn "resolve-endpoint" :ns "graphden.services.endpoint" :file "src/graphden/services/endpoint.clj" :line 93 :lang "clj" :mins 1.7 :head "(defn resolve-endpoint" :see nil :refs nil :siblings nil
     :say "Resolves a service identity to an active endpoint on the caller's branch, preferring a live local instance, then a finite HTTP publication and an addon resolver; otherwise it reports `:service/not-running`. The `:fn-ref` argument passes identity without executing the named function.")
    (:key "services/publish!" :n 10 :gi 228 :defn "publish!" :ns "graphden.http-host.core" :file "src/graphden/http_host/core.clj" :line 199 :lang "clj" :mins 3.4 :head "(defn publish!" :see nil :refs nil :siblings (("services/serve" . "serve"))
     :say "Authorizes a typed request handler on an exact branch without invoking it. The existing graph writer and branch guards precede the publication capacity lock; the session lease and optional isolated app route commit together. The client supplies a create-only UUID so lost-response cleanup can revoke the exact publication.")
    (:key "services/serve" :n 11 :gi 229 :defn "serve" :ns "graphden.http-host.core" :file "src/graphden/http_host/core.clj" :line 282 :lang "clj" :mins 2.0 :head "(defn serve" :see nil :refs nil :siblings (("services/publish!" . "publish!"))
     :say "Checks deadline, branch existence, current owner and execute grants before each public request. A bounded shared-pool invocation receives sanitized request fields and returns only bounded text or JSON. It starts no persistent service or tenant listener.")
    (:key "services/call-with-capacity-lock" :n 12 :gi 230 :defn "call-with-capacity-lock" :ns "graphden.http-host.lease" :file "src/graphden/http_host/lease.clj" :line 54 :lang "clj" :mins 1.6 :head "(defn call-with-capacity-lock" :see nil :refs nil :siblings nil
     :say "Serializes finite publication admission and cleanup across all pods using a short PostgreSQL advisory transaction lock. Callbacks must not acquire graph or branch locks; this preserves graph → branch → capacity lock ordering during branch deletion.")
    (:key "services/run-traced!" :n 13 :gi 231 :defn "run-traced!" :ns "graphden.crud.fn-execution.trace" :file "src/graphden/crud/fn_execution/trace.clj" :line 120 :lang "clj" :mins 1.7 :head "(defn run-traced!" :see nil :refs nil :siblings nil
     :say "Connects traced service calls across HTTP using `X-Graphden-Trace`. The handler execution receives its own execution ID and stores its result linked to the caller's trace. Requests without that header do not create these linked trace rows.")
    (:key "services/extend-builder~2" :n 14 :gi 232 :defn "extend-builder" :ns "graphden.schema.queue.schema" :file "src/graphden/schema/queue/schema.clj" :line 74 :lang "clj" :mins 3.4 :head "(defn extend-builder" :see nil :refs nil :siblings nil
     :say "Declares a PostgreSQL-backed job queue with status, attempts, due time, and a visibility lock. Claiming uses `FOR UPDATE SKIP LOCKED`; notifications wake waiting consumers. The consumer loop is composed in graph definitions, while database operations remain small primitives.")
    (:key "services/placement-for" :n 15 :gi 233 :defn "placement-for" :ns "graphden.fleet.placement" :file "src/graphden/fleet/placement.clj" :line 11 :lang "clj" :mins 1.1 :head "(defn placement-for" :see nil :refs nil :siblings nil
     :say "Finds the placement of an [execution cell](#term/fleet), identified by organisation and entry-function ID. Placement records identify the responsible executor; the highest [epoch](#term/invalidation) wins when records differ. Routing and relocation use this shared placement information.")
    (:key "services/forward-or-nil" :n 16 :gi 234 :defn "forward-or-nil" :ns "graphden.fleet.router" :file "src/graphden/fleet/router.clj" :line 114 :lang "clj" :mins 1.3 :head "(defn forward-or-nil" :see nil :refs nil :siblings nil
     :say "Forwards an internal request when it arrives at an executor that does not own the target [cell](#term/fleet). It looks up the current placement and sends HTTP to that executor, allowing callers to reach a [cell](#term/fleet) through another [fleet](#term/fleet) member.")
    (:key "services/cell-weight" :n 17 :gi 235 :defn "cell-weight" :ns "graphden.fleet.metrics" :file "src/graphden/fleet/metrics.clj" :line 60 :lang "clj" :mins 1.4 :head "(defn cell-weight" :see nil :refs nil :siblings nil
     :say "Combines a [cell](#term/fleet)'s dependency-graph size and current organisation load into a numeric weight. Placement algorithms use this estimate to compare [cells](#term/fleet); it is a scheduling estimate, not a measurement of every function's execution cost.")
    (:key "services/pack" :n 18 :gi 236 :defn "pack" :ns "graphden.fleet.packer" :file "src/graphden/fleet/packer.clj" :line 69 :lang "clj" :mins 2.7 :head "(defn pack" :see nil :refs nil :siblings nil
     :say "Builds a placement by sorting [cells](#term/fleet) from heaviest to lightest and assigning each to the currently least-loaded executor. This greedy longest-processing-time-first strategy is an approximation for balancing load, not an exhaustive search for an optimal arrangement.")
    (:key "services/rebalance" :n 19 :gi 237 :defn "rebalance" :ns "graphden.fleet.rebalance" :file "src/graphden/fleet/rebalance.clj" :line 81 :lang "clj" :mins 5.0 :head "(defn rebalance" :see nil :refs nil :siblings nil
     :say "Improves an existing placement one move at a time, moving a [cell](#term/fleet) from a busier executor when that reduces load spread sufficiently. `:min-improvement` prevents moves for negligible gains. This heuristic limits unnecessary moves but does not prove a globally minimum move count.")
    (:key "services/plan-tick" :n 20 :gi 238 :defn "plan-tick" :ns "graphden.fleet.control-loop" :file "src/graphden/fleet/control_loop.clj" :line 63 :lang "clj" :mins 2.6 :head "(defn plan-tick" :see nil :refs nil :siblings (("services/run-tick!" . "run-tick!"))
     :say "Plans one control tick without performing moves. Unassigned [cells](#term/fleet) receive initial placements immediately; rebalancing waits for imbalance to persist for `:sustain-ticks`. This delay avoids reacting to brief load spikes.")
    (:key "services/run-tick!" :n 21 :gi 239 :defn "run-tick!" :ns "graphden.fleet.control-loop" :file "src/graphden/fleet/control_loop.clj" :line 191 :lang "clj" :mins 2.6 :head "(defn run-tick!" :see nil :refs nil :siblings (("services/plan-tick" . "plan-tick"))
     :say "Reads current [cells](#term/fleet) and placements, calls `plan-tick`, then applies planned assignments and moves through the supplied `move-fn`. The leader-controlled component invokes this side-effecting control loop periodically.")
    (:key "services/move-cell!" :n 22 :gi 240 :defn "move-cell!" :ns "graphden.fleet.controller" :file "src/graphden/fleet/controller.clj" :line 67 :lang "clj" :mins 3.7 :head "(defn move-cell!" :see nil :refs nil :siblings nil
     :say "Relocates one [cell](#term/fleet) in order: prepare and compile on the target, update placement with a newer [epoch](#term/invalidation), then evict the source copy. Preparing the target before rerouting keeps the old copy available during setup.")))
  (:id "platform" :title "Platform — extension interfaces and isolation" :status "toured" :mins 26.6 :summary "Access policy, safe rendering, monitoring, and remote executors."
   :steps
   ((:key "platform/platform-tier?" :n 1 :gi 241 :defn "platform-tier?" :ns "graphden.tenancy.context" :file "src/graphden/tenancy/context.clj" :line 62 :lang "clj" :mins 1.3 :head "(defn platform-tier?" :see nil :refs (("boot/read-config" . "read-config") ("constellation/install-org-cap-fn!" . "install-org-cap-fn!")) :siblings (("platform/notify!" . "notify!") ("constellation/install-org-cap-fn!" . "install-org-cap-fn!") ("constellation/tenancy-addon-active?" . "tenancy-addon-active?"))
     :say "Tests whether the current request has platform-level context rather than an organisation context. The tenancy [addon](#term/integrant) binds `*current-org*`; core code reads this shared interface without importing private policy implementation.")
    (:key "platform/notify!" :n 2 :gi 242 :defn "notify!" :ns "graphden.tenancy.context" :file "src/graphden/tenancy/context.clj" :line 257 :lang "clj" :mins 1.0 :head "(defn notify!" :see nil :refs nil :siblings (("platform/platform-tier?" . "platform-tier?") ("constellation/install-org-cap-fn!" . "install-org-cap-fn!") ("constellation/tenancy-addon-active?" . "tenancy-addon-active?"))
     :say "Passes a domain event to an installed notification handler, such as a package-moderation decision. The [addon](#term/integrant) decides recipients and delivery. With no handler the event is ignored; delivery failure does not reverse the domain write.")
    (:key "platform/single-token-provider" :n 3 :gi 243 :defn "single-token-provider" :ns "graphden.auth.provider" :file "src/graphden/auth/provider.clj" :line 65 :lang "clj" :mins 1.0 :head "(defn single-token-provider" :see nil :refs nil :siblings nil
     :say "Provides core's single-token [authentication](#term/auth) behind the replaceable `:auth/provider` component. It compares credentials in constant time. An [addon](#term/integrant) can install session- or account-based [authentication](#term/auth) through the same provider interface.")
    (:key "platform/cloud-forbidden-effects" :n 4 :gi 244 :defn "cloud-forbidden-effects" :ns "graphden.executor.compile-runtime" :file "src/graphden/executor/compile_runtime.clj" :line 1340 :lang "clj" :mins 2.9 :head "(def cloud-forbidden-effects" :see nil :refs (("executor/record-effect!" . "record-effect!")) :siblings (("executor/execute~2" . "execute") ("executor/registry" . "registry") ("executor/rebuild!" . "rebuild!") ("executor/record-effect!" . "record-effect!"))
     :say "Lists [effects](#term/effect) forbidden for sandboxed graph execution, including environment, I/O, network, process, and raw SQL access. Core's `record-effect!` enforces the currently allowed set; the [addon](#term/integrant) selects that set. `:raw-sql` is separate from controlled database operations.")
    (:key "platform/check-target!" :n 5 :gi 245 :defn "check-target!" :ns "graphden.clients.egress" :file "src/graphden/clients/egress.clj" :line 90 :lang "clj" :mins 1.4 :head "(defn check-target!" :see nil :refs nil :siblings nil
     :say "Validates outbound destinations to prevent [server-side request forgery](#term/ssrf) ([SSRF](#term/ssrf)). Resolution rejects prohibited local, private, and metadata addresses. DNS and socket checks repeat validation at connection time, reducing the risk that an address changes between validation and use.")
    (:key "platform/sanitize-hiccup" :n 6 :gi 246 :defn "sanitize-hiccup" :ns "graphden.web.hiccup-sanitize" :file "src/graphden/web/hiccup_sanitize.clj" :line 116 :lang "clj" :mins 2.8 :head "(defn sanitize-hiccup" :see (("crud/render-repr" . "render-repr")) :refs nil :siblings nil
     :say "Sanitizes graph-authored [Hiccup](#term/hiccup) before it enters the editor [DOM](#term/hiccup). It allows selected tags and attributes, limits depth and node count, and converts unsupported content to safe text where possible. Unrepresentable output returns nil.")
    (:key "platform/count!" :n 7 :gi 247 :defn "count!" :ns "graphden.util.counters" :file "src/graphden/util/counters.clj" :line 65 :lang "clj" :mins 1.0 :head "(defn count!" :see nil :refs nil :siblings nil
     :say "Increments process-wide event counters. Readers compare two snapshots to obtain changes over an interval without resetting shared counters, so independent monitoring consumers do not invalidate one another's measurements. See [monitoring](../../docs/MONITORING.md).")
    (:key "platform/decide" :n 8 :gi 248 :defn "decide" :ns "graphden.monitoring.alerts" :file "src/graphden/monitoring/alerts.clj" :line 59 :lang "clj" :mins 3.2 :head "(defn decide" :see nil :refs nil :siblings nil
     :say "Decides whether to raise, resolve, or leave an alert unchanged from interval counters and prior alert state. Scheduling and webhook delivery are separate from this pure decision. See [alerting](../../docs/MONITORING.md).")
    (:key "platform/start-relay!" :n 9 :gi 249 :defn "start-relay!" :ns "graphden.system.sse" :file "src/graphden/system/sse.clj" :line 199 :lang "clj" :mins 2.3 :head "(defn start-relay!" :see nil :refs nil :siblings nil
     :say "Relays branch and organisation [invalidation](#term/invalidation) events to subscribed customer-hosted executors through [server-sent events](#term/sse) ([SSE](#term/sse)). The remote executor can refresh its compiled graph after a change without periodically downloading the entire bundle.")
    (:key "platform/RemoteStorage" :n 10 :gi 250 :defn "RemoteStorage" :ns "graphden.storage.remote.core" :file "src/graphden/storage/remote/core.clj" :line 132 :lang "clj" :mins 3.6 :head "(defrecord RemoteStorage" :see (("storage/StorageCRUD" . "StorageCRUD")) :refs nil :siblings nil
     :say "Implements read-only `StorageCRUD` over graph rows fetched from the hub through HTTP. Writes are rejected. `refresh!` replaces the in-memory bundle, and the [SSE](#term/sse) relay described above triggers refresh after [invalidation](#term/invalidation) events.")
    (:key "platform/start-byo!" :n 11 :gi 251 :defn "start-byo!" :ns "graphden.byo" :file "src/graphden/byo.clj" :line 154 :lang "clj" :mins 6.1 :head "(defn start-byo!" :see nil :refs nil :siblings nil
     :say "Assembles a customer-hosted executor using remote read-only graph storage, [SSE](#term/sse) [invalidation](#term/invalidation), and a local HTTP server. The same execution core runs the downloaded graph while the hub remains responsible for writes.")))
  (:id "accounts" :title "Accounts — identity and sessions" :status "toured" :mins 15.9 :summary "Sign-in, account linking, tokens, and second-factor validation."
   :steps
   ((:key "accounts/resolve-social-identity!" :n 1 :gi 252 :defn "resolve-social-identity!" :ns "graphden.accounts.core" :file "src/graphden/accounts/core.clj" :line 168 :lang "clj" :mins 3.2 :head "(defn resolve-social-identity!" :see nil :refs nil :siblings (("accounts/mint-session!" . "mint-session!"))
     :say "Resolves a social sign-in to an existing identity, links it to an account with the same verified email when allowed, or creates an account. The resulting stable account ID is used for [authorization](#term/auth) independently of the sign-in method.")
    (:key "accounts/mint-session!" :n 2 :gi 253 :defn "mint-session!" :ns "graphden.accounts.core" :file "src/graphden/accounts/core.clj" :line 228 :lang "clj" :mins 1.9 :head "(defn mint-session!" :see nil :refs nil :siblings (("accounts/resolve-social-identity!" . "resolve-social-identity!"))
     :say "Creates a stored session whose raw token is returned once; storage keeps its SHA-256 hash. Session kinds also distinguish verification links and pending second-factor steps, which must not authenticate as ordinary API sessions.")
    (:key "accounts/accounts-provider" :n 3 :gi 254 :defn "accounts-provider" :ns "graphden.accounts.provider" :file "src/graphden/accounts/provider.clj" :line 67 :lang "clj" :mins 0.9 :head "(defn accounts-provider" :see nil :refs nil :siblings nil
     :say "Authenticates an API bearer token or the HttpOnly session cookie and returns an account [principal](#term/auth). Organisation membership is resolved separately by the tenancy layer, so the accounts provider does not choose an organisation.")
    (:key "accounts/make-router" :n 4 :gi 255 :defn "make-router" :ns "graphden.accounts.routes" :file "src/graphden/accounts/routes.clj" :line 493 :lang "clj" :mins 8.7 :head "(defn make-router" :see nil :refs nil :siblings nil
     :say "Builds the account HTTP routes for sign-in, identity management, verification, and two-factor [authentication](#term/auth). It returns nil for unhandled paths so later routers can continue. Page presentation uses an injected graph renderer with a built-in fallback when graph rendering is unavailable.")
    (:key "accounts/valid?" :n 5 :gi 256 :defn "valid?" :ns "graphden.accounts.totp" :file "src/graphden/accounts/totp.clj" :line 103 :lang "clj" :mins 1.2 :head "(defn valid?" :see nil :refs nil :siblings nil
     :say "Validates time-based one-time passwords according to RFC 6238, allowing the adjacent time steps for clock skew and comparing codes in constant time. Reference vectors test the algorithm; account flows handle enrollment and confirmation separately.")))
  (:id "constellation" :title "Repositories — composition and release boundaries" :status "toured" :mins 9.4 :summary "Core, addons, external packages, and revision consistency."
   :steps
   ((:key "constellation/addon-config-resources" :n 1 :gi 257 :defn "addon-config-resources" :ns "graphden.system.config" :file "src/graphden/system/config.clj" :line 57 :lang "clj" :mins 1.2 :head "(defn addon-config-resources" :see (("boot/read-config" . "read-config")) :refs nil :siblings (("boot/read-config" . "read-config") ("constellation/merge-addon" . "merge-addon"))
     :say "Reads [addon](#term/integrant) configuration resources from `GRAPHDEN_ADDON_CONFIGS`. Without them, core runs independently. The public core must not depend on private [addons](#term/integrant): tenancy depends on core, and cloud assembly depends on both. This configuration boundary preserves that dependency direction.")
    (:key "constellation/merge-addon" :n 2 :gi 258 :defn "merge-addon" :ns "graphden.system.config" :file "src/graphden/system/config.clj" :line 68 :lang "clj" :mins 1.4 :head "(defn- merge-addon" :see (("boot/context" . "context") ("boot/dispatch-first" . "dispatch-first")) :refs nil :siblings (("boot/read-config" . "read-config") ("constellation/addon-config-resources" . "addon-config-resources"))
     :say "Loads an [addon](#term/integrant)'s required namespaces, then merges its configuration over core configuration. Loading registers component implementations before initialization. Cloud and self-hosted deployments assemble the same core with different components rather than maintaining divergent copies. See [distribution](../../docs/PACKAGE_DISTRIBUTION.md).")
    (:key "constellation/install-org-cap-fn!" :n 3 :gi 259 :defn "install-org-cap-fn!" :ns "graphden.tenancy.context" :file "src/graphden/tenancy/context.clj" :line 175 :lang "clj" :mins 1.0 :head "(defn install-org-cap-fn!" :see (("platform/platform-tier?" . "platform-tier?")) :refs nil :siblings (("platform/platform-tier?" . "platform-tier?") ("platform/notify!" . "notify!") ("constellation/tenancy-addon-active?" . "tenancy-addon-active?"))
     :say "Installs the [addon](#term/integrant) predicate used to check organisation [capabilities](#term/auth). Core call sites depend on this interface rather than private [authorization](#term/auth) implementation. Platform [capability](#term/auth) checks have a corresponding installer. See the [tenancy extension interface](../../docs/TENANCY_SEAM.md) for default and [addon](#term/integrant) behavior.")
    (:key "constellation/tenancy-addon-active?" :n 4 :gi 260 :defn "tenancy-addon-active?" :ns "graphden.tenancy.context" :file "src/graphden/tenancy/context.clj" :line 184 :lang "clj" :mins 1.0 :head "(defn tenancy-addon-active?" :see nil :refs nil :siblings (("platform/platform-tier?" . "platform-tier?") ("platform/notify!" . "notify!") ("constellation/install-org-cap-fn!" . "install-org-cap-fn!"))
     :say "Reports whether the tenancy [addon](#term/integrant) is installed. Server-rendered text can use this fact when deciding whether organisation-specific wording applies. It is distinct from the current user's tier or a general feature flag.")
    (:key "constellation/every-addon-facing-var-still-resolves-test" :n 5 :gi 261 :defn "every-addon-facing-var-still-resolves-test" :ns "test/graphden/open_core_seam_test.clj" :file "test/graphden/open_core_seam_test.clj" :line 33 :lang "clj" :mins 1.4 :head "(deftest every-addon-facing-var-still-resolves-test" :see (("crud/create-entity" . "create-entity")) :refs nil :siblings nil
     :say "Verifies that public extension variables used by the private [addon](#term/integrant) still resolve. `tools/open-core-seam.edn` records that interface so removing an apparently unused core function fails core CI before breaking an external consumer.")
    (:key "constellation/read-manifest" :n 6 :gi 262 :defn "read-manifest" :ns "graphden.packages.manifest" :file "src/graphden/packages/manifest.clj" :line 32 :lang "clj" :mins 1.1 :head "(defn read-manifest" :see (("boot/packages" . "packages") ("packages/load-packages" . "load-packages")) :refs nil :siblings (("constellation/extra-deps" . "extra-deps"))
     :say "Reads the operator manifest of external packages containing code and function definitions. The build includes these libraries in the application artifact, and boot loads their named packages. A name-only entry refers to a package already available on the [classpath](#term/edn).")
    (:key "constellation/extra-deps" :n 7 :gi 263 :defn "extra-deps" :ns "graphden.packages.manifest" :file "src/graphden/packages/manifest.clj" :line 48 :lang "clj" :mins 1.1 :head "(defn extra-deps" :see (("packages/install!" . "install!")) :refs nil :siblings (("constellation/read-manifest" . "read-manifest"))
     :say "Adds manifest dependencies to the build basis. [Pin](#term/semver) checks ensure the manifest and `deps.edn` select the same revisions; copy checks ensure local test copies match available sibling repositories. This keeps tested package content aligned with the shipped artifact.")
    (:key "constellation/-main" :n 8 :gi 264 :defn "-main" :ns "graphden.executor-runtime.core" :file "src/graphden/executor_runtime/core.clj" :line 187 :lang "clj" :mins 1.2 :head "(defn -main" :see (("boot/boot!" . "boot!") ("boot/read-config" . "read-config")) :refs nil :siblings (("boot/-main" . "-main") ("boot/boot!" . "boot!"))
     :say "Cloud assembly starts the same core `-main` rather than supplying another executor. Release checks must keep the core revision used by cloud and by tenancy identical; otherwise the assembled deployment differs from the combination tested. Documentation, translations, and organisation templates live in separate repositories without becoming runtime dependencies.")))))
