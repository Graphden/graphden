;; Logic and conditional base functions
;; All functions require implementations in impls.clj

[;; === Logic ===
 {:name :and
  :args {:values :jsonb}
  :return-type :bool}

 {:name :or
  :args {:values :jsonb}
  :return-type :bool}

 {:name :not
  :args {:value :any}
  :return-type :bool}

 ;; === Conditionals ===
 {:name :if
  :args {:test :any
         :then :any
         :else {:type :any :required false}}
  :return-type :any}

 {:name :cond
  :args {:clauses :jsonb}
  :return-type :any}

 ;; === Defaults ===
 {:name :coalesce
  :args {:value :any
         :default :any}
  :return-type :any}

 ;; === Constants ===
 {:name :const
  :args {:value :any}
  :return-type :any}

 {:name :identity
  :args {:value :any}
  :return-type :any}]
