   :args
   {:coll {:as :inputs, :type :_inputs},
    :key {:value :authenticated},
    :default {:value false}}}
  {:name :_any,
   :parent :get,
   :args
   {:coll {:as :inputs, :type :_inputs},
    :key {:value :any},
    :default {:value false}}}
  {:name :_editable,
   :parent :get,
   :args
   {:coll {:as :inputs, :type :_inputs},
    :key {:value :editable},
    :default {:value false}}}
  {:name :_optional,
