  {:name :_pstats-row-runs
   :parent :get :args {:coll {:as :item} :key {:value :runs} :default {:value 0}}}
  {:name :_pstats-row-failed
   :parent :get :args {:coll {:as :item} :key {:value :failed} :default {:value 0}}}
  {:name :_pstats-row-sum
   :parent :get :args {:coll {:as :item} :key {:value :duration-ms-sum} :default {:value 0}}}
  {:name :_pstats-row-has-runs?
   :parent :gt :args {:nums [:_pstats-row-runs {:value 0}]}}
  {:name :_pstats-row-avg-raw
   :parent :quot :args {:dividend :_pstats-row-sum :divisor :_pstats-row-runs}}
  {:name :_pstats-row-avg
   :parent :if
   :args {:test :_pstats-row-has-runs?
          :then :_pstats-row-avg-raw
          :else {:value 0}}}

  {:name :_pstats-day-label-cell
   :parent :hiccup
   :args {:tag {:value "td"} :attrs {:value {:class "stats-day"}}
          :children [:_pstats-day-label]}}
  {:name :_pstats-row-runs-cell
   :parent :hiccup
   :args {:tag {:value "td"} :attrs {:value {:class "stats-num"}}
          :children [:_pstats-row-runs]}}
  {:name :_pstats-row-failed-cell
   :parent :hiccup
   :args {:tag {:value "td"} :attrs {:value {:class "stats-num stats-failed"}}
          :children [:_pstats-row-failed]}}
  {:name :_pstats-row-avg-cell
   :parent :hiccup
   :args {:tag {:value "td"} :attrs {:value {:class "stats-num"}}
          :children [{:parent :to-str :args {:value :_pstats-row-avg}}]}}

  ;; CSS bar — width % comes server-computed (`:runs-pct`, share of the
  ;; window max) so the graph does no cross-row arithmetic.
  {:name :_pstats-row-pct
   :parent :get :args {:coll {:as :item} :key {:value :runs-pct} :default {:value 0}}}
  {:name :_pstats-row-bar-style
   :parent :str :args {:parts [{:value "width:"} :_pstats-row-pct {:value "%"}]}}
  {:name :_pstats-row-bar-attrs
   :parent :assoc
   :args {:map {:value {:class "stats-bar-fill"}}
          :key {:value :style} :value :_pstats-row-bar-style}}
  {:name :_pstats-row-bar-fill
   :parent :hiccup
   :args {:tag {:value "div"} :attrs :_pstats-row-bar-attrs :children []}}
  {:name :_pstats-row-bar
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "stats-bar"}}
          :children [:_pstats-row-bar-fill]}}
  {:name :_pstats-row-bar-cell
   :parent :hiccup
   :args {:tag {:value "td"} :attrs {:value {:class "stats-bar-cell"}}
          :children [:_pstats-row-bar]}}

  {:name :_pstats-day-row
   :description "One trend row — `[:tr [:td day] [:td bar] [:td runs] [:td failed] [:td avg]]`."
   :parent :hiccup
   :args {:tag {:value "tr"}
          :attrs {:value {:class "stats-row"}}
          :children [:_pstats-day-label-cell :_pstats-row-bar-cell
                     :_pstats-row-runs-cell
                     :_pstats-row-failed-cell :_pstats-row-avg-cell]}}

  {:name :_pstats-day-rows
   :parent :map :args {:func :_pstats-day-row :coll :_pstats-daily}}

  {:name :_pstats-daily-table
   :parent :hiccup
   :args {:tag {:value "table"}
          :attrs {:value {:class "stats-table"}}
          :children [{:value [:thead [:tr [:th "Day"] [:th ""] [:th "Runs"] [:th "Failed"] [:th "Avg ms"]]]}
                     :_pstats-day-rows]}}

  {:name :_pstats-daily-empty?
   :parent :empty? :args {:coll :_pstats-daily}}

  {:name :_pstats-daily-section
   :parent :if
   :args {:test :_pstats-daily-empty?
          :then {:value [:div {:class "stats-empty"} "No runs in the last 7 days."]}
          :else :_pstats-daily-table}}

  ;; --- Top-fns table ----------------------------------------------------
  {:name :_pstats-top-fns
   :parent :usage-org-fn-stats
   :args {:days :_pstats-window-days :limit {:value 20}}}

  {:name :_pstats-fn-link-attrs
   :parent :assoc
   :args {:map {:value {:class "stats-fn"}} :key {:value :href} :value :item-fn-href}}
  {:name :_pstats-fn-link
   :parent :hiccup
