;; String manipulation base functions
;; str, subs, str-len, str-upper, str-lower, str-trim, str-split, str-join,
;; str-to-keyword, keyword-to-str


{:namespace "core.strings"
 :fns
[{:name :str
  :args {:parts :jsonb}
  :return-type :text}

 {:name :subs
  :args {:string :text
         :start :int
         :end {:type :int :required false}}
  :return-type :text}

 {:name :str-len
  :args {:string :text}
  :return-type :int}

 {:name :str-upper
  :args {:string :text}
  :return-type :text}

 {:name :str-lower
  :args {:string :text}
  :return-type :text}

 {:name :str-trim
  :args {:string :text}
  :return-type :text}

 {:name :str-split
  :args {:string :text, :separator :text}
  :return-type :jsonb}

 {:name :str-join
  :args {:coll :jsonb
         :separator {:type :text :required false}}
  :return-type :text}

 {:name :str-to-keyword
  :args {:string :text}
  :return-type :any}

 {:name :keyword-to-str
  :args {:keyword :any}
  :return-type :text}

 {:name :pr-str
  :args {:value :any}
  :return-type :text}

 {:name :to-str
  :args {:value :any}
  :return-type :text}]}
