;; Part of the `web.crud` namespace — see `web/crud/fns.edn` for the
;; module layout and why the ids are unchanged.


{:namespace "web.crud"
 :description "The type API — `:json-to-type`, subtype / mismatch, compatible + candidates — and the record / list type-row compound stages."
 :fns
 [;; --- type-API handler primitives. The handlers themselves are `:if`
  ;; graph fn-defs below; these base-fns are the parse / validate /
  ;; apply stages. `validate-*` returns the `{:ok false :error}`
  ;; rejection response directly (or nil), so the `:if`'s `:then` branch
  ;; is the validation result itself; `_rejected?` is shared with the
  ;; entity create/update + type-row handlers. ---
  ;; --- :json-to-type — atomic boundary over `types-api/json->type`.
  {:name :json-to-type
   :description "Decode the JSON wire-shape of a type expression back to its Clojure AST. Strings become keywords (except inside refinement constraints, where literal-string predicates like `[:not= \"\"]` stay strings — `:non-empty-text` depends on this)."
   :args {:json {:type :jsonb :description "JSON-decoded value (post-cheshire) — string / vector / map / scalar."}}
   :return-type :type-expression}

  {:name :_types-compatible-parsed
   :description "Stage 1 of types-compatible — JSON body → `{:expected :candidate}`, each decoded from the wire shape produced by `/api/types`."
   :parent :zipmap
   :args {:keys [{:value :expected} {:value :candidate}]
          :vals [{:parent :json-to-type
                  :args {:json {:parent :get
                                :args {:coll :_parsed-body
                                       :key {:value :expected}
                                       :default nil}}}}
                 {:parent :json-to-type
                  :args {:json {:parent :get
                                :args {:coll :_parsed-body
                                       :key {:value :candidate}
                                       :default nil}}}}]}
   :return-type :_types-compatible-parsed-shape}

  {:name :_types-compatible-validation
   :description "Stage 2 of types-compatible — guards (both `expected` and `candidate` present). Returns the `{:ok false :error}` rejection response, or nil when well-formed."
   :parent :cond
   :args {:clauses
          [{:parent :nil? :args {:value {:parent :get
                                         :args {:coll {:as :parsed :type :_types-compatible-parsed-shape
                                                       :description "Output of `:_types-compatible-parsed`."}
                                                :key {:value :expected}
                                                :default nil}}}}
           {:parent :const :args {:value {:ok false :error "Request body must include 'expected'"}}}
           {:parent :nil? :args {:value {:parent :get
                                         :args {:coll {:as :parsed}
                                                :key {:value :candidate}
                                                :default nil}}}}
           {:parent :const :args {:value {:ok false :error "Request body must include 'candidate'"}}}
           {:value true} {:value nil}]}}

  ;; --- :subtype? + :describe-type-mismatch — atomic library
  ;; boundaries. The dispatch logic + structural recursion live in
  ;; `types/core` (§3.3 invariant); admins can vary the response shape
  ;; by reparenting the per-row composition below.
  {:name :subtype?
   :description "True iff `candidate` is a subtype of `expected` under graphden's type hierarchy (refinement / list / union / record / fn-shape recursion in `types/core`)."
   :args {:expected {:type :type-expression :description "The expected (slot-side) type expression — atomic (`:int`, `\"int\"`), vector (`[:list :text]`), or record (`{...}`)."}
          :candidate {:type :type-expression :description "The candidate (binding-side) type expression."}}
   :return-type :bool}

  {:name :fn-type?
   :description "True iff the type expression is a callable shape (`[:fn args ret]` / `[:fn args ret effects]`). Lets a graph branch on \"is this slot expecting a function?\" without reimplementing the shape test."
   :args {:type {:type :type-expression :description "Type expression to test."}}
   :return-type :bool}

  {:name :fn-signature
   :description "`[:fn args ret effects]` — the callable shape of the fn named `fn-name`, or nil when the registry has no entry. Single boundary over `types.check/assemble-fn-type`, the assembler the WRITE path (`check-binding!`) uses, so a callable slot's candidate list and its binding check answer the same question."
   :args {:fn-name {:type :keyword-or-text :description "Name of the candidate fn."}}
   :return-type [:union :null :type-expression]}

  {:name :describe-type-mismatch
   :description "One-line human-readable explanation of why `candidate` ⊄ `expected`. Used by the editor's type-picker tooltip."
   :args {:expected {:type :type-expression :description "The expected (slot-side) type expression — atomic (`:int`, `\"int\"`), vector (`[:list :text]`), or record (`{...}`)."}
          :candidate {:type :type-expression :description "The candidate (binding-side) type expression."}}
   :return-type :text}

  {:name :classify-literal
   :description "Infer the structural type expression of a literal Clojure value — `:text`, `:int`, `:bool`, `:keyword`, `:uuid`, `:null`, `[:list T]`, or a record-shape `{k T}` for keyword-keyed maps. nil for shapes the classifier can't decide (caller falls back to `:any`)."
   :args {:value {:type :any :description "Literal value to classify (binding's `:value`, list-item's `:value`, etc.)."}}
   :return-type :type-expression}

  {:name :diff-value-against-type
   :description "Leaf-level disagreements between `value` and `expected` — `[{:path :expected :actual}, …]`, empty when the value satisfies the type. Used by the mismatch-explainer popover to point users at the EXACT failing field / element."
   :args {:value {:type :any :description "Literal value to diff against the expected type."}
          :expected {:type :type-expression :description "Expected type expression — atomic, vector (`[:list T]`, `[:map K V]`, `[:tuple …]`, `[:union …]`, `[:refine base constraint]`), or record (`{k T …}`)."}}
   :return-type [:list {:path :text :expected :type-expression :actual :any}]}

  {:name :closed-enum-of
   :description "Returns `{:base :members}` when `expected` resolves to a closed-enum refinement (`[:refine base [:in [members]]]`). Members are sorted + colon-prefixed for `:keyword`-based enums. nil for any other shape (caller suppresses the section)."
   :args {:expected {:type :type-expression
                     :description "Type expression to test for the closed-enum shape."}}
   :return-type [:union :null {:base :type-expression
                               :members [:list {:value :text :label :text}]}]}

  {:name :fn-type-bound-effects
   :description "Vec of effect-name strings (without leading colon) when `expected` is a `[:fn args ret eff]` with CONCRETE `eff` (not `:any`); nil otherwise. Used by the provenance popover to surface the slot-level effect constraint server-side."
   :args {:expected {:type :type-expression
                     :description "Type expression to test for the fn-type shape with a bound effect set."}}
   :return-type [:union :null [:list :text]]}

  {:name :rich-type-of-name
   :description "Full rich-types registry entry for the named fn — one registry lookup; nil for nil / unknown names."
   :args {:fn-name {:type :nullable-text :required false :description "Fn name; keywordized at the boundary."}}
   :return-type :nullable-keyword-map}

  {:name :rule-owner-of-name
   :description "`{:name :fn-id}` of the base-fn whose `:return-type-rule` computed the named fn's return type — the canonical `registry/root-base-fn-name` walk over `:primary-parent`, iff that root carries a rule; `:fn-id` is the registry entry's own id (no name→id graph query). nil for unknown names, base-fns, and rule-less chains. Used by `/partials/return-type-rule`; the layout strip-facts annotation uses the name-only registry walk."
   :args {:fn-name {:type :nullable-text :required false :description "Fn name; keywordized at the boundary."}}
   :return-type [:union :null {:name :text :fn-id :uuid}]}

  {:name :declarable-effect-categories
   :description "Sorted declarable effect-category names — the canonical `types.check/known-effect-categories` set (what sync accepts). Roster of `/partials/expects-effects-form`'s checkboxes."
   :args {}
   :return-type [:list :text]}

  {:name :type-name-kinds
   :description "Sorted `{:name :kind}` rows for the editor's type-name datalist — named type-rows classified via `compute-fn-role` plus the bare primitives. Backs `/partials/type-name-datalist`."
   :args {}
   :return-type [:list {:name :text :kind :text}]
   :effects #{:db}}

  {:name :compatible-type-names
   :description "`type-name-kinds` rows filtered to the names that can legally narrow `expected` — one alias-aware `subtype?` sweep. Backs `/partials/compatible-type-options` (replaces the editor's per-name /api/types/compatible fan-out)."
   :args {:expected {:type :type-expression :description "Type expression candidates must be subtypes of."}}
   :return-type [:list {:name :text :kind :text}]
   :effects #{:db}}

  ;; fn-id → row → name → registry entry → :return, all graph-visible.
  {:name :_rrof-fn-id-nil?
   :parent :nil?
   :args {:value {:as :fn-id}}}

  ;; Runs only in the non-nil branch of the `:if` below; `:assert-some`
  ;; narrows the nullable free arg to `:uuid` for `:get-entity`.
  {:name :_rrof-id-narrowed
   :parent :assert-some
   :args {:value {:as :fn-id :type :nullable-uuid}}}

  {:name :_rrof-row
   :parent :get-entity
   :args {:entity-type {:value "fn"} :id {:ref :_rrof-id-narrowed :type :uuid}}}

  {:name :_rrof-name
   :parent :get
   :args {:coll :_rrof-row :key {:value :name} :default nil}}

  {:name :_rrof-entry
   :parent :rich-type-of-name
   :args {:fn-name {:ref :_rrof-name :type :nullable-text}}}

  {:name :_rrof-return
   :parent :get
   :args {:coll :_rrof-entry :key {:value :return} :default nil}}

  {:name :_rrof-resolved
   :parent :if
   :args {:test :_rrof-fn-id-nil?
          :then {:value nil}
          :else :_rrof-return}}

  ;; `:const` wrapper carries the author `:type` assertion — the
  ;; declared contract of the old base-fn (nil flows through consumers
  ;; that already handled it).
  {:name :rich-return-of-fn
   :description "Rich-types registry view of the named fn's `:return` field. Pure graph composition: `:get-entity` fn-row → `:get :name` → `:rich-type-of-name` → `:get :return`. nil for nil fn-id / anonymous / unregistered / unknown fns. Used by the fn-picker incompat-explainer partial."
   :parent :const
   :args {:value {:ref :_rrof-resolved :type :type-expression}}
   :return-type :type-expression}

  ;; --- :_types-compatible-apply — pure graph composition over
  ;; `:subtype?` + `:if`-wrapped `:describe-type-mismatch` + envelope.
  ;; Admins can vary the response shape (e.g. add `:expected-kind`,
  ;; rename `:reason` to `:why`) without touching Clojure.

  {:name :_types-compatible-parsed-expected
   :parent :get :args {:coll {:as :parsed} :key {:value :expected} :default nil}}

  {:name :_types-compatible-parsed-candidate
   :parent :get :args {:coll {:as :parsed} :key {:value :candidate} :default nil}}

  {:name :_types-compatible-ok?
   :description "Stage 3a — single library call to the subtype predicate."
   :parent :subtype?
   :args {:expected :_types-compatible-parsed-expected
          :candidate :_types-compatible-parsed-candidate}}

  {:name :_types-compatible-reason
   :description "Stage 3b — one-line mismatch explanation; only forced on the `:not-ok` branch via `:if`'s laziness."
   :parent :describe-type-mismatch
   :args {:expected :_types-compatible-parsed-expected
          :candidate :_types-compatible-parsed-candidate}}

  {:name :_types-compatible-ok-shape
   :description "Stage 3c-ok — `{:ok true :expected :candidate}` envelope."
   :parent :zipmap
   :return-type {:ok :bool
                 :expected :type-expression
                 :candidate :type-expression}
   :args {:keys [{:value :ok} {:value :expected} {:value :candidate}]
          :vals [{:value true}
                 :_types-compatible-parsed-expected
                 :_types-compatible-parsed-candidate]}}

  {:name :_types-compatible-not-ok-shape
   :description "Stage 3c-not-ok — `{:ok false :expected :candidate :reason}` envelope."
   :parent :zipmap
   :return-type {:ok :bool
                 :expected :type-expression
                 :candidate :type-expression
                 :reason :text}
   :args {:keys [{:value :ok} {:value :expected} {:value :candidate} {:value :reason}]
          :vals [{:value false}
                 :_types-compatible-parsed-expected
                 :_types-compatible-parsed-candidate
                 :_types-compatible-reason]}}

  {:name :_types-compatible-apply
   :description "Stage 3 of types-compatible — the single-pair subtype check between an `expected` (slot-side) and `candidate` (binding-side) type. Returns `{:ok :expected :candidate :reason?}`. Reached only after validation passes. Pure graph composition over `:subtype?` + `:if`-wrapped `:describe-type-mismatch` + envelope `:zipmap`. Computed return is opaque `:jsonb` because both `:if` branches were declared `:jsonb` to keep the case-style unify cheap."
   :parent :if
   :args {:test :_types-compatible-ok?
          :then :_types-compatible-ok-shape
          :else :_types-compatible-not-ok-shape}}

  ;; --- :to-set — atomic boundary over `clojure.core/set`. Used to
  ;; turn the wire's effect list into a containment predicate.
  {:name :to-set
   :description "Coerce a sequence into a Clojure set. Useful when the result is consumed as a containment predicate (`every? the-set xs`) — vector/list would silently mis-behave there."
   :args {:coll {:type [:list a] :description "Source sequence."}}
   :return-type [:list a]}

  {:name :_types-candidates-effects-raw
   :description "Stage 1b — the raw `:effects` list off the JSON body (vector of strings), or nil when omitted."
   :parent :get
   :args {:coll :_parsed-body :key {:value :effects} :default nil}}

  {:name :_types-candidates-effect-to-keyword
   :description "HOF callback per effect-list item — `:str-to-keyword` keeps already-keyword values intact (`(keyword :kw)` is identity)."
   :parent :str-to-keyword
   :args {:string {:as :item}}}

  {:name :_types-candidates-effects-kws
   :description "Keywordized effect list (`[\"db\" \"io\"]` → `[:db :io]`)."
   :parent :map
   :args {:func :_types-candidates-effect-to-keyword
          :coll :_types-candidates-effects-raw}}

  {:name :_types-candidates-allowed-effects
   :description "The allowed-effects set when `:effects` was supplied, nil otherwise — preserves the original `(when-let [effs …] (set …))` semantics. Downstream `:_types-candidates-apply` consumes it as `(every? allowed-effects eff-set)` — set semantics are required."
   :parent :if
   :args {:test {:parent :some? :args {:value :_types-candidates-effects-raw}}
          :then {:parent :to-set :args {:coll :_types-candidates-effects-kws}}
          :else {:value nil}}}

  {:name :_types-candidates-name-prefix-raw
   :parent :get
   :args {:coll :_parsed-body :key {:value :name-prefix} :default nil}}

  {:name :_types-candidates-name-prefix
   :description "Stringified `:name-prefix`, or nil when absent. Preserves the original `(some-> raw str)` shape — `:to-str` of nil would have surfaced as the empty string instead of nil."
   :parent :if
   :args {:test {:parent :some? :args {:value :_types-candidates-name-prefix-raw}}
          :then {:parent :to-str :args {:value :_types-candidates-name-prefix-raw}}
          :else {:value nil}}}

  {:name :_types-candidates-parsed
   :description "Stage 1 of types-candidates — JSON body → `{:expected :allowed-effects :name-prefix}`."
   :parent :zipmap
   :args {:keys [{:value :expected} {:value :allowed-effects} {:value :name-prefix}]
          :vals [{:parent :json-to-type
                  :args {:json {:parent :get
                                :args {:coll :_parsed-body
                                       :key {:value :expected}
                                       :default nil}}}}
                 :_types-candidates-allowed-effects
                 :_types-candidates-name-prefix]}
   :return-type :_types-candidates-parsed-shape}

  {:name :_types-candidates-validation
   :description "Stage 2 of types-candidates — guards `expected` present. Returns the `{:ok false :error}` rejection response, or nil when well-formed."
   :parent :if
   :args {:test {:parent :nil? :args {:value {:parent :get
                                              :args {:coll {:as :parsed :type :_types-candidates-parsed-shape
                                                            :description "Output of `:_types-candidates-parsed`."}
                                                     :key {:value :expected}
                                                     :default nil}}}}
          :then {:parent :const :args {:value {:ok false :error "Request body must include 'expected'"}}}
          :else {:value nil}}}

  ;; --- _types-candidates-apply. Mirrors
  ;; `types-api/apply-types-candidates`: snapshot registry → filter by
  ;; (not-type-row, subtype, effect-subset, name-prefix) → reshape
  ;; per-row → sort by name → envelope. Closure-captured `:parsed`
  ;; carries the 3 filter dimensions into the per-row HOF.

  {:name :_types-candidates-snapshot
   :description "Augmented rich-types snapshot — base-fns + composed fn-defs + storage type-rows. Single source of truth for /api/types and /api/types/candidates."
   :parent :all-rich-types
   :args {}}

  {:name :_types-candidates-fn-names
   :parent :keys
   :args {:map :_types-candidates-snapshot}}

  ;; --- Closure-captured filter dimensions extracted from `:parsed` ---
  {:name :_types-candidates-apply-expected
   :parent :get :args {:coll {:as :parsed} :key {:value :expected} :default nil}}

  {:name :_types-candidates-apply-allowed-effects
   :parent :get :args {:coll {:as :parsed} :key {:value :allowed-effects} :default nil}}

  {:name :_types-candidates-apply-name-prefix
   :parent :get :args {:coll {:as :parsed} :key {:value :name-prefix} :default nil}}

  ;; --- Per-row predicates + reshape. `:item` is one fn-name keyword;
  ;; `:snapshot` (closure-captured) is the augmented rich-types map.

  {:name :_types-candidates-info
   :parent :get :args {:coll {:as :snapshot} :key {:as :item} :default nil}}

  {:name :_types-candidates-return
   :parent :get :args {:coll :_types-candidates-info :key {:value :return} :default nil}}

  {:name :_types-candidates-args
   :parent :get :args {:coll :_types-candidates-info :key {:value :args} :default {}}}

  {:name :_types-candidates-apply-effects-raw
   :parent :get :args {:coll :_types-candidates-info :key {:value :effects} :default #{}}}

  {:name :_types-candidates-type-row?
   :parent :get :args {:coll :_types-candidates-info :key {:value :type-row?} :default false}}

  ;; --- 4 filter predicates ---
  {:name :_types-candidates-not-type-row?
   :parent :not :args {:value :_types-candidates-type-row?}}

  ;; A CALLABLE slot (`[:fn …]`, e.g. `:future`'s `:body`) never receives
  ;; the candidate's result — the executor hof-wraps the ref and the
  ;; callable itself is the value. So admissibility is "signature ⊆ slot",
  ;; the rule `check-binding!` applies on write. Comparing the RETURN there
  ;; answered "Compatible · 0" for every ordinary fn, hiding legal binds
  ;; behind "Other" and teaching readers to override the diagnostic.
  {:name :_types-candidates-expected-callable?
   :parent :fn-type?
   :args {:type {:as :expected}}}

  {:name :_types-candidates-signature
   :parent :fn-signature
   :args {:fn-name {:as :item}}}

  ;; `:fn-signature` answers nil for a name the registry hasn't seen yet.
  ;; `:subtype?`'s `:candidate` slot is a bare `:type-expression`, so the
  ;; nullable form can't be handed to it — and a candidate with no signature
  ;; must not pass anyway. `:any` is the right stand-in: it is NOT a subtype
  ;; of any fn-type, so such a candidate falls out of the list.
  {:name :_types-candidates-signature-or-any
   :parent :coalesce
   :args {:value :_types-candidates-signature :default {:value :any :literal? true}}}

  ;; A `:fn-ref` slot takes a fn's IDENTITY — the bound fn is never run,
  ;; so its return type is no filter at all. Every non-type-row fn is a
  ;; candidate, the rule `check-one-binding`'s `:fn-ref` arm applies on
  ;; write. Mirrors `identity-slot?` in `types-api/apply-types-candidates`.
  {:name :_types-candidates-expected-identity?
   :parent :eq
   :args {:values [{:as :expected} {:value :fn-ref :literal? true}]}}

  {:name :_types-candidates-subtype-ok?
   :parent :cond
   :args {:clauses [:_types-candidates-expected-identity?
                    {:value true}
                    :_types-candidates-expected-callable?
                    {:parent :subtype?
                     :args {:expected {:as :expected}
                            :candidate :_types-candidates-signature-or-any}}
                    {:value true}
                    {:parent :subtype?
                     :args {:expected {:as :expected}
                            :candidate :_types-candidates-return}}]}}

  {:name :_types-candidates-effects-ok?
   :description "True iff allowed-effects is nil (no filter) OR every effect on the row is in allowed-effects."
   :parent :or
   :args {:values [{:parent :nil? :args {:value {:as :allowed-effects}}}
                   {:parent :every?
                    :args {:pred {:as :allowed-effects}
                           :coll :_types-candidates-apply-effects-raw}}]}}

  {:name :_types-candidates-name-str
   :description "The registry stores fn-names as KEYWORDS. `:keyword-to-str` returns the bare name (no leading colon) so prefix matching against `\"my-fn\"` works as the user expects; `:to-str` would emit `\":my-fn\"` and break the predicate."
   :parent :keyword-to-str
   :args {:keyword {:as :item}}}

  {:name :_types-candidates-name-prefix-ok?
   :description "True iff name-prefix is nil OR the fn name starts with it."
   :parent :or
   :args {:values [{:parent :nil? :args {:value {:as :name-prefix}}}
                   {:parent :str-starts-with?
                    :args {:string :_types-candidates-name-str
                           :prefix {:as :name-prefix}}}]}}

  {:name :_types-candidates-row-ok?
   :description "CHEAP FILTERS FIRST. `:and` short-circuits, so the order here is
                 the query plan. `:_types-candidates-subtype-ok?` is a recursive
                 walk of the type hierarchy (refinement / list / union / record /
                 fn-shape); the other three are a map lookup and two string /
                 set comparisons. Running the expensive one first meant every fn
                 in the registry was type-checked before the prefix the user had
                 already typed threw it away — the endpoint's cost was O(whole
                 graph) even when the answer was a single fn. Measured: identical
                 ~0.11 s whether the prefix matched 57 candidates or 1, and 45 s
                 under concurrent load, which is what timed out the e2e type
                 tests and got written off as GC pauses."
   :parent :and
   :args {:values [:_types-candidates-not-type-row?
                   :_types-candidates-name-prefix-ok?
                   :_types-candidates-effects-ok?
                   :_types-candidates-subtype-ok?]}}

  ;; --- Per-row candidate shape (when matched) ---
  {:name :_types-candidates-effects-vec
   :description "Sort the effect set into a vector for stable JSON output (mirrors `(vec (sort eff-set))`)."
   :parent :vec
   :args {:coll {:parent :sort :args {:coll :_types-candidates-apply-effects-raw}}}}

  {:name :_types-candidates-row
   :parent :zipmap
   :args {:keys [{:value :name} {:value :return} {:value :args} {:value :effects}]
          :vals [{:as :item}
                 :_types-candidates-return
                 :_types-candidates-args
                 :_types-candidates-effects-vec]}}

  {:name :_types-candidates-row-or-nil
   :description "HOF callback per fn-name — return the reshaped candidate map when filters pass, nil otherwise."
   :parent :if
   :args {:test :_types-candidates-row-ok?
          :then :_types-candidates-row
          :else {:value nil}}}

  ;; --- Narrow the SCAN, not just the result ---
  {:name :_types-candidates-names
   :description "The name list the scan actually walks, prefix-filtered FIRST.

                 The prefix predicate needs only the name — not the snapshot,
                 not the type — so it can run before any per-fn work at all.
                 Previously it ran INSIDE the per-row callback, so every fn in
                 the registry was looked up, reshaped and type-checked before a
                 string comparison threw it away. The endpoint cost O(whole
                 graph) even when the user had typed a prefix that matched one
                 fn — and the picker in the editor almost always has one.

                 With this, the common path is O(matching names). The no-prefix
                 path (picker opened cold) is unchanged and still walks the
                 registry: that one wants an index, which is a separate change."
   :parent :filter
   :args {:pred :_types-candidates-name-prefix-ok?
          :coll :_types-candidates-fn-names
          :name-prefix :_types-candidates-apply-name-prefix}}

  ;; --- Map + filter-nil + sort + envelope ---
  {:name :_types-candidates-mapped
   :parent :map
   :args {:func :_types-candidates-row-or-nil
          :coll :_types-candidates-names
          :snapshot :_types-candidates-snapshot
          :expected :_types-candidates-apply-expected
          :allowed-effects :_types-candidates-apply-allowed-effects
          :name-prefix :_types-candidates-apply-name-prefix}}

  {:name :_types-candidates-filtered
   :parent :filter
   :args {:pred :some? :coll :_types-candidates-mapped}}

  {:name :_types-candidates-sort-key
   :parent :get :args {:coll {:as :item} :key {:value :name} :default nil}}

  {:name :_types-candidates-sorted
   :parent :sort-by
   :args {:key-fn :_types-candidates-sort-key :coll :_types-candidates-filtered}}

  {:name :_types-candidates-count
   :parent :count
   :args {:coll :_types-candidates-sorted}}

