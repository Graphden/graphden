   :args {:actual {:parent :version-qualified-ns :args {:ns-root {:value "web.components"} :version {:value "1.3.0"} :fn-ns {:value "web.components.foo"}}}
          :expected "web.components@1-3-0.foo"}}

  {:name :version-qualified-ns-qualifies-the-root-itself
   :parent :assert-eq
   :args {:actual {:parent :version-qualified-ns :args {:ns-root {:value "web.components"} :version {:value "1.3.0"} :fn-ns {:value "web.components"}}}
          :expected "web.components@1-3-0"}}

  {:name :version-qualified-ns-leaves-a-foreign-namespace-alone
