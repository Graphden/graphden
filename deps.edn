{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.5"}
  ;; Logging
  org.clojure/tools.logging {:mvn/version "1.3.1"}
  ch.qos.logback/logback-classic {:mvn/version "1.6.2"}
  ;; Schema validation
  metosin/malli {:mvn/version "0.20.1"}
  ;; PostgreSQL
  org.postgresql/postgresql {:mvn/version "42.7.13"}
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
  com.github.seancorfield/honeysql {:mvn/version "2.7.1437"}
  com.zaxxer/HikariCP {:mvn/version "7.1.0"}
  cheshire/cheshire {:mvn/version "6.2.0"}
  ;; Pin jackson to the CVE-patched 2.21.4 (cheshire 6.2.0 pulls 2.21.1, which
  ;; has HIGH RCE advisories — jackson-databind CVE-2026-54512/54513 via a
  ;; PolymorphicTypeValidator bypass + jackson-core GHSA-r7wm-3cxj-wff9). A
  ;; direct dep wins over cheshire's transitive one; 2.21.4 is patch-compatible.
  ;; Surfaced by `bb trivy`'s JVM classpath scan — keep in sync with it.
  com.fasterxml.jackson.core/jackson-core {:mvn/version "2.22.1"}
  com.fasterxml.jackson.core/jackson-databind {:mvn/version "2.22.1"}
  ;; Web
  http-kit/http-kit {:mvn/version "2.8.1"}
  ;; OkHttp — used ONLY for a tenant's RESTRICTED outbound call, where its
  ;; custom `Dns` hook lets us pin the connection to a validated-public IP
  ;; (closes the SSRF DNS-rebind window httpkit can't — httpkit re-resolves at
  ;; dial time with no resolver hook). TLS/SNI/cert stay on the hostname. See
  ;; graphden.clients.egress. (Apache-2.0; pulls okio + kotlin-stdlib.
  ;; okhttp 5.x is Kotlin-multiplatform — the bare `okhttp` coord is Gradle
  ;; module metadata; Maven/tools.deps consumers need the -jvm artifact.)
  com.squareup.okhttp3/okhttp-jvm {:mvn/version "5.4.0"}
  metosin/reitit {:mvn/version "0.10.1"}
  ;; HTML templating
  hiccup/hiccup {:mvn/version "2.0.0"}
  ;; System lifecycle
  integrant/integrant {:mvn/version "1.0.1"}
  aero/aero {:mvn/version "1.1.6"}
  ;; Cron expression parser — used by the :cron-next-after base-fn
  ;; (org.quartz.CronExpression). We only depend on the cron-parser
  ;; class, not the Quartz scheduler runtime — graphden's own
  ;; :future + :loop-until-interrupted primitives drive the firing.
  org.quartz-scheduler/quartz {:mvn/version "2.5.2"}
  ;; Opt-in nREPL server — booted by `-main` when
  ;; `GRAPHDEN_NREPL_PORT` is set. Production deployments leave it
  ;; unset; dev / debugging sessions expose it through compose.
  nrepl/nrepl {:mvn/version "1.7.0"}
  ;; Brotli encoder — wrapped by the `:brotli-bytes` base-fn for the
  ;; encode-response handler wrap. Java API + the Linux x86_64
  ;; native binary that the deploy target runs on; ARM / macOS
  ;; would need their own native jar.
  com.aayushatharva.brotli4j/brotli4j {:mvn/version "1.23.0"}
  com.aayushatharva.brotli4j/native-linux-x86_64 {:mvn/version "1.23.0"}
  ;; bcrypt password hashing — `tenancy.users` (§4.1). Static API
  ;; (BCrypt/hashpw, BCrypt/checkpw, BCrypt/gensalt); standard $2a$ format.
  org.mindrot/jbcrypt {:mvn/version "0.4"}
  ;; CRaC portable API — used by `graphden.crac` to quiesce/resume live
  ;; resources (DB pool, LISTEN + advisory-lock connections) around a
  ;; Coordinated Restore at Checkpoint (docs/FLEET_RFC.md §5.1). A no-op shim
  ;; on a non-CRaC JVM (the API resolves to a global context that never fires),
  ;; so it's inert in the normal Temurin build and active under a CRaC JDK.
  org.crac/crac {:mvn/version "1.5.0"}

  ;; mathx — an EXTERNAL Type-2 (impl+fns) package, loaded by NAME via the
  ;; executor-packages.edn manifest. This is the REAL distribution form: a
  ;; git coord onto the standalone graphden/graphden-mathx repo (Track B).
  ;; The repo is PUBLIC and the coord is an https URL, so the build resolves it
  ;; anonymously — no credentials, no ssh-agent, no deploy key. `bb test` /
  ;; `bb dev` carry an :override-deps onto the in-tree copy anyway, so lint/test
  ;; stay offline + hermetic (a speed/determinism convenience, not an access
  ;; workaround).
  mathx/mathx {:git/url "https://github.com/Graphden/graphden-mathx.git"
               :git/sha "a99354d1d2cae3b36bedca07523bf133921c595d"}}

 :aliases
 {:test
  {:extra-paths ["test" "external-packages/examples/resources"]
   ;; `examples` is an EXTERNAL, dev/test-only package (graphden/graphden-examples),
   ;; kept in-tree under external-packages/ so lint/test stay offline. It rides
   ;; the classpath here (NOT under the prod `resources` path), so a production
   ;; build never carries it.
   ;; Keep lint/test hermetic + offline for `mathx` too: resolve it from the
   ;; in-tree copy instead of fetching the (public) git coord over the network.
   ;; Production build/run uses the git coord (root :deps).
   :override-deps {mathx/mathx {:local/root "external-packages/mathx"}}
   :extra-deps
   {lambdaisland/kaocha {:mvn/version "1.91.1392"}
    ;; Cloverage-via-kaocha — activated only by `bb coverage` (see
    ;; `tests-coverage.edn`). Plugin stays off in normal `bb test`
    ;; runs so we don't pay bytecode-instrumentation cost.
    lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}
    org.testcontainers/testcontainers {:mvn/version "1.21.4"}
    org.testcontainers/postgresql {:mvn/version "1.21.4"}}}

  :dev
  {:extra-paths ["test" "development/src" "external-packages/examples/resources"]
   ;; Same hermetic override as :test — REPL / dev runs use the in-tree mathx +
   ;; the in-tree `examples` package (dev/test-only, off the prod resources path).
   :override-deps {mathx/mathx {:local/root "external-packages/mathx"}}
   :extra-deps
   {org.testcontainers/testcontainers {:mvn/version "1.21.4"}
    org.testcontainers/postgresql {:mvn/version "1.21.4"}
    integrant/repl {:mvn/version "0.5.1"}}}

  :bench
  {:extra-paths ["development/bench"]
   :extra-deps
   {criterium/criterium {:mvn/version "0.4.6"}
    org.testcontainers/testcontainers {:mvn/version "1.21.4"}
    org.testcontainers/postgresql {:mvn/version "1.21.4"}}}

  :cloverage
  {:extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}}
   :main-opts ["-m" "cloverage.coverage"]}

  :nrepl
  {:extra-deps
   {nrepl/nrepl {:mvn/version "1.7.0"}
    cider/cider-nrepl {:mvn/version "0.62.2"}
    refactor-nrepl/refactor-nrepl {:mvn/version "3.14.0"}}
   :main-opts
   ["-m" "nrepl.cmdline"
    "--middleware" "[cider.nrepl/cider-middleware,refactor-nrepl.middleware/wrap-refactor]"]}

  ;; Linters
  :kondo
  {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
   :main-opts ["-m" "clj-kondo.main"]}

  :cljstyle
  {:extra-deps {mvxcvi/cljstyle {:mvn/version "0.17.642"}}
   ;; Same hermetic/offline override as :splint / :watson / :outdated — tool
   ;; aliases resolve the ROOT :deps, which include the mathx git coord; the
   ;; override resolves it from the in-tree copy so lint needs no network fetch
   ;; (the public repo would resolve over https, but offline is faster + deterministic).
   :override-deps {mathx/mathx {:local/root "external-packages/mathx"}}
   :main-opts ["-m" "cljstyle.main"]}

  :splint
  {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.24.0"}}
   ;; Tool aliases resolve the ROOT :deps too, which include the mathx git
   ;; coord. This override resolves it from the in-tree copy so lint needs no
   ;; network fetch (the repo is public and would resolve over https, but
   ;; offline is faster + deterministic). Same hermetic override the
   ;; :dev/:test aliases carry.
   :override-deps {mathx/mathx {:local/root "external-packages/mathx"}}
   :main-opts ["-m" "noahtheduke.splint"]}

  ;; NOTE: Eastwood removed - incompatible with Clojure 1.12 qualified methods (Class/.method)
  ;; See: https://github.com/jonase/eastwood/issues/457
  ;; Re-add when tools.analyzer supports Clojure 1.12

  ;; Utilities
  :outdated
  {:extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
   ;; The `--exclude` below keeps mathx out of the REPORT; this keeps it out
   ;; of CLASSPATH RESOLUTION, which antq does first — resolving it from the
   ;; in-tree copy so the report needs no network fetch.
   :override-deps {mathx/mathx {:local/root "external-packages/mathx"}}
   :main-opts
   ["-m" "antq.core"
    "--exclude=org.testcontainers/testcontainers"
    "--exclude=org.testcontainers/postgresql"
    ;; why: `mathx` is a git coord pinned to an exact SHA. An antq version
    ;; report on it would be noise: the pin is deliberate (see § mathx above),
    ;; and moving it is a manifest decision made in
    ;; `resources/executor-packages.edn`, not a version bump.
    "--exclude=mathx/mathx"]}

  :watson
  {:extra-deps {io.github.clj-holmes/clj-watson {:git/tag "v6.1.0" :git/sha "be98e4d"}}
   ;; Tool aliases resolve the ROOT :deps too, which include the mathx git
   ;; coord. This override resolves it from the in-tree copy so the scan needs
   ;; no network fetch. Same hermetic override the :dev/:test aliases carry.
   :override-deps {mathx/mathx {:local/root "external-packages/mathx"}}
   :main-opts ["-m" "clj-watson.cli" "scan"]}

  ;; Build uberjar
  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default build}

  ;; Run server
  :run
  {:main-opts ["-m" "graphden.executor-runtime.core"]}}}
