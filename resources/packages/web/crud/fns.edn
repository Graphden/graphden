  {:name :_seq-remove-item-not-found?
   :description "Guard #2 — no binding-list-item matches the parsed id."
   :args {:item {:type :jsonb}}
   :return-type :bool
   :effects #{}}

  {:name :_seq-remove-apply
   :description "Success branch — delete the row, invalidate caches, return 200."
