  {:name :secrets-list-data
   :description "Method-data for GET on `/api/secrets`. Combined into `:api-secrets-root`."
   :parent :_method-map-with-middleware
   :args {:method "get"
          :handler :list-secrets-handler
          :middleware :_middleware-list}}

  {:name :secrets-create-data
   :description "Method-data for POST on `/api/secrets` — body `{name, path, value, namespace-id?, description?}`. Combined into `:api-secrets-root`."
   :parent :_method-map-with-middleware
   :args {:method "post"
          :handler :create-secret-handler
          :middleware :_middleware-list}}

