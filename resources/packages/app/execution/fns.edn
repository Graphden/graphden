   :args {:keys [{:value :arg} {:value :raw-ref}]
          :vals [{:parent :keyword-to-str :args {:keyword {:as :item}}}
                 :_execute-arg-ref]}}

  {:name :_execute-malformed
   :parent :map
   :args {:func :_execute-malformed-shape
          :coll :_execute-malformed-keys}}

  {:name :_execute-any-malformed?
