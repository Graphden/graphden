;; Server-side lookups for partial renderers — Phase 0 of the
;; HTMX migration plan (docs/EDITOR_HTMX_MIGRATION_PLAN.md).
;;
;; Each fn-def here reads a single piece of graph state and is the
;; canonical primitive for partials that need it. They're built on
;; top of the existing `:storage-query-call` / `:decode-row` chain
;; that other modules use directly today; centralising them avoids
;; duplicating the `:assoc` + `:vec` HSQL boilerplate at every
;; call site.
;;
;; Naming convention: public (no `_`) primitives are intended for
;; cross-module reuse. `_`-private fn-defs are scaffolding for the
;; public ones in this same file.


{:namespace "app.lookups"
 :description "Server-side lookups for partial renderers — read fn rows / namespace paths / usage counts / request auth state. Primitives for the HTMX-migration row-actions + tooltip partials (docs/EDITOR_HTMX_MIGRATION_PLAN.md)."
 :fns
 [;; =============================================================================
  ;; AUTH — per-partial request auth check
  ;; =============================================================================
  ;;
  ;; The route-level `:get-auth-required` parent 401s anonymous
  ;; visitors. Some partials (row-actions) need to render content
  ;; for BOTH anonymous and authenticated callers but vary the
  ;; affordance set (e.g. show ✎ rename only when authed). They use
  ;; the public `:get-route` parent and consume `:request-authed?`
  ;; inline to gate conditional buttons.

  {:name :request-authed?
   :description "True iff the current request authenticated. Public wrapper over the provider-agnostic `:request-authenticated?` seam (web/ring-adapter) — promoted so app-level partials read it without crossing the `_`-private boundary. (Was the bearer-specific `:_bearer-equals-env?`; now follows whatever auth provider is wired — single-token in core, session/JWT in the tenancy addon.)"
   :parent :request-authenticated?}

  ;; =============================================================================
  ;; FN ROW READER — single fn entity by id
  ;; =============================================================================
  ;;
  ;; HSQL → storage-query-call → first → decode-row. Returns nil
  ;; when no row matches the id, matching the JS-side `lookups?.fnMap?.get(id)`
  ;; semantics (also returns undefined for unknown ids). Callers
  ;; that need to fail-loud should `:assert-some` the result.

  {:name :_fn-row-by-id-where
   :description "Build `[:= :id <fn-id>]` HSQL where clause from the free arg `:fn-id`."
   :parent :vec
   :args {:coll [{:value :=} {:value :id} {:as :fn-id}]}}

  {:name :_fn-row-by-id-hsql
   :description "Full HSQL bundle: `{:select [:*] :from :fn :where [:= :id <fn-id>]}`."
   :parent :assoc
   :args {:map {:value {:select [:*] :from :fn}}
          :key {:value :where}
          :value :_fn-row-by-id-where}}

  {:name :_fn-row-by-id-raw
   :description "Raw row vector (length 0 or 1) from `:storage-query-call`. Undecoded — string column keys, undecoded enum strings, jsonb PGobjects."
   :parent :storage-query-call
   :args {:arg :_fn-row-by-id-hsql}}

  {:name :_fn-row-by-id-first
   :description "First (and only) raw row, or nil when no fn matches the id."
   :parent :first
   :args {:coll :_fn-row-by-id-raw}}

  {:name :fn-row-by-id
   :description "Decoded fn entity row by id; nil when not found. Free arg: `:fn-id` (uuid). Returns `:nullable-keyword-map` matching `:decode-row`'s shape (kebab-case kw keys, decoded enums/jsonb)."
   :parent :decode-row
   :args {:row :_fn-row-by-id-first
          :entity-type {:value "fn"}}}

  ;; =============================================================================
  ;; FN ID BY NAME — resolve a global fn name to its row id
  ;; =============================================================================
  ;;
  ;; One `:query-entities` protocol call (versioned-resolved,
  ;; branch-aware). Fn names are validated globally unique at sync
  ;; time, so first-row IS the row. Used by partials that emit
  ;; `data-fn-id` nav-links for a fn they only know by name (e.g.
  ;; the return-type-rule popover's rule-owner link).

  {:name :_fibn-where
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :name}
          :value {:as :fn-name}}}

  {:name :_fibn-rows
   :parent :query-entities
   :args {:entity-type {:value "fn"}
          :where :_fibn-where}}

  {:name :_fibn-row
   :parent :first
   :args {:coll :_fibn-rows}}

  {:name :fn-id-by-name
   :description "Fn row id (uuid) for a global fn name; nil when no fn with that name exists on the current branch. Free arg: `:fn-name` (text)."
   :parent :get
   :args {:coll :_fibn-row :key {:value :id} :default nil}}

  ;; =============================================================================
  ;; NAMESPACE PATH WALKER — joins ns chain into a dotted path
  ;; =============================================================================
  ;;
  ;; Pure `:fix` graph composition (the promised rewrite of the old
  ;; base-fn loop — `:fix` shipped in core/recursion; pattern mirrors
  ;; `storage.branches/:branch-chain`). State is
  ;; `{:acc [names…] :cur ns-id :depth n}`; each step reads the cur
  ;; ns row via `:get-entity`, appends its name and recurses to the
  ;; parent. The 20-level depth cap of the old loop is preserved
  ;; graph-visibly (`:_nsp-depth-capped?`) — a corrupt/cyclic chain
  ;; terminates with a partial path, same graceful behaviour as
  ;; before, instead of hitting `:fix`'s 1000-depth throw.

  ;; Type-row exposing `:ns-id` as a declared slot — same reason as
  ;; `:BranchChainInput`: a free arg that only exists inside the
  ;; `:input` composition can't be resolved on the inheritance walk.
  {:name :FnNsPathInput
   :description "Type-row exposing the `:ns-id :nullable-uuid` input slot of `:fn-ns-path`."
   :type {:ns-id :nullable-uuid}}

  ;; `:fix` returns `:any`; the `:const` wrapper carries the author
  ;; `:type :text` assertion (the step's terminal is always a
  ;; `:str-join`), keeping the public return-type callers see.
  {:name :fn-ns-path
   :description "Walk the `:ns` parent-id chain from `ns-id` to root, joining each name with `.`. `:_<core.refinements ns-id>` → `\"core.refinements\"`. Empty string when `ns-id` is nil. Depth-capped at 20. Pure graph composition over `:fix` + `:get-entity`."
   :parent :const
   :args {:value {:ref :_nsp-run :type :text}}
   :return-type :text}

  {:name :_nsp-run
   :description "The `:fix` walk itself — see `:fn-ns-path`."
   :parents [:fix :FnNsPathInput]
   :args {:step :_nsp-step
          :input :_nsp-initial}}

  {:name :_nsp-initial
   :description "Initial walk state — empty name accumulator, cursor at the starting ns, depth 0."
   :parent :zipmap
   :args {:keys [{:value :acc} {:value :cur} {:value :depth}]
          :vals [{:value []} {:as :ns-id} {:value 0}]}}

  {:name :_nsp-step
   :parent :if
   :args {:test :_nsp-done?
          :then :_nsp-result
          :else :_nsp-recurse}}

  {:name :_nsp-cur
   :parent :get
   :args {:coll {:as :input} :key {:value :cur}}}

  {:name :_nsp-acc
   :parent :get
   :args {:coll {:as :input} :key {:value :acc}}}

  {:name :_nsp-depth
   :parent :get
   :args {:coll {:as :input} :key {:value :depth}}}

  {:name :_nsp-depth-capped?
   :description "Defence in depth: storage constraints forbid ns cycles, but a corrupt chain must terminate (with a partial path) rather than run away. 20 ≫ any real hierarchy (3-4 levels)."
   :parent :gte
   :args {:nums [:_nsp-depth {:value 20}]}}

  {:name :_nsp-cur-nil?
   :parent :nil?
   :args {:value :_nsp-cur}}

  ;; Only forced when the cursor is non-nil — `:or` short-circuits, so
  ;; the row read never sees a nil id.
  {:name :_nsp-row
   :parent :get-entity
   :args {:entity-type {:value "ns"} :id {:ref :_nsp-cur :type :uuid}}}

  {:name :_nsp-row-nil?
   :parent :nil?
   :args {:value :_nsp-row}}

  {:name :_nsp-done?
   :parent :or
   :args {:values [:_nsp-depth-capped? :_nsp-cur-nil? :_nsp-row-nil?]}}

  ;; The accumulator is appended leaf→root; reverse for the root-first
  ;; dotted path.
  {:name :_nsp-acc-root-first
   :parent :reverse
   :args {:coll :_nsp-acc}}

  {:name :_nsp-result
   :parent :str-join
   :args {:coll :_nsp-acc-root-first :separator {:value "."}}}

  {:name :_nsp-row-name
   :parent :get
   :args {:coll :_nsp-row :key {:value :name}}}

  {:name :_nsp-parent-id
   :parent :get
   :args {:coll :_nsp-row :key {:value :parent-id}}}

  {:name :_nsp-acc-extended
   :parent :conj
   :args {:coll :_nsp-acc :item :_nsp-row-name}}

  {:name :_nsp-depth-inc
   :parent :add
   :args {:nums [:_nsp-depth {:value 1}]}}

  {:name :_nsp-next
   :parent :zipmap
   :args {:keys [{:value :acc} {:value :cur} {:value :depth}]
          :vals [:_nsp-acc-extended :_nsp-parent-id :_nsp-depth-inc]}}

  {:name :_nsp-recurse
   :parent :invoke
   :args {:func {:as :self} :arg :_nsp-next}}]}
