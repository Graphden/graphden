  ;; routes in its `:api-routes`/`:all`, so when `"registry"` is omitted from
  ;; :package-names this router is never built and the `/api/packages/*`,
  ;; `/api/export/*` + `/partials/packages-panel` paths 404 while the rest of
  ;; the app is unaffected (the editor hides its Packages panel — it probes
  ;; `window.API` for the registry route). The `["/api" …]` nesting reproduces
  ;; reitit's prefix walk exactly as app's `:api-routes` did.
  {:name :_registry-api-routes
   :description "The registry's `/api/*` endpoints, nested under the `/api` prefix (reitit walks the tree) — packages publish/list/fetch/install/update/fork/installed/uninstall + the panel-* variants + graph/namespace export."
   :parent :list
   :args {:items ["/api"
                  :api-packages-publish
                  :api-packages-list
                  :api-packages-fetch
                  :api-packages-install
                  :api-packages-update
                  :api-packages-fork
                  :api-packages-installed
                  :api-packages-uninstall
                  :api-packages-panel-install
                  :api-packages-panel-update
                  :api-packages-panel-fork
                  :api-packages-panel-publish
                  :api-export-graph
                  :api-export-graph-rows]}}

  {:name :_registry-routes
   :description "The registry package's full route list — the `/api/*` group plus the flat `/partials/packages-panel` + `/partials/packages-governance` leaves."
   :parent :list
   :args {:items [:_registry-api-routes :partial-packages-panel :partial-packages-governance]}}

  {:name :registry-router
   :description "Fall-through reitit router over `:_registry-routes` — returns nil on no-match (`:router-or-nil`) so the branch-router falls through to the main app router for any non-registry path."
   :parent :router-or-nil
   :args {:routes :_registry-routes}}

  ;; Per-branch Ring handler — invokes `:registry-router` on the parsed
  ;; request and returns its result (nil on no-match, for fall-through). This
  ;; is the OPTIONAL analogue of `app.server/_app-ring-response`: the
  ;; branch-router builds a per-branch closure for it (only when the registry
  ;; package is loaded) and consults it BEFORE the main handler, so registry's
  ;; routes are served through the SAME per-branch, invalidation-fresh
  ;; machinery as the main router — NOT the boot-frozen route-collection seam
  ;; (whose baked constant-arg queries served stale data). No `:storage-query`
  ;; binding needed: registry's handlers query via `:query-entities` (ctx
