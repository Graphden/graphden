{:namespace "app.editor"
 :description "Inheritance intent partial: authoritative preview, UUID navigation and explicit mutation scope."
 :fns
 [{:name :_inheritance-query-command
   :parent :assert-some
   :args {:value {:parent :query-param
                  :args {:request {:as :request} :param-name "command"}}}}
  {:name :_inheritance-intent-command
   :parent :parse-inheritance-command
   :args {:body {:parent :parse-json
                 :args {:string :_inheritance-query-command :keywordize true}}}}
  {:name :_inheritance-intent-preview
   :parent :preview-inheritance
   :args {:command :_inheritance-intent-command :request {:as :request}}}
  {:name :_inheritance-parent-edge?
   :parent :equal?
   :args {:a {:parent :get :args {:coll :_inheritance-intent-command :key {:value :kind} :default nil}}
          :b "parent-edge"}}
  {:name :_inheritance-long-path?
   :parent :some?
   :args {:value {:parent :get
                  :args {:coll :_inheritance-intent-command
                         :key {:value :occurrence-path} :default nil}}}}
  {:name :_inheritance-ancestor-choice?
   :parent :and
   :args {:values [:_inheritance-parent-edge?
                   {:parent :not :args {:value :_inheritance-long-path?}}]}}
  {:name :_inheritance-source-id
   :parent :get
   :args {:coll :_inheritance-intent-command :key {:value :source-fn-id} :default nil}}
  {:name :_inheritance-allowed?
   :parent :get
   :args {:coll :_inheritance-intent-preview :key {:value :allowed} :default false}}
  {:name :_inheritance-reason
   :parent :get
   :args {:coll :_inheritance-intent-preview :key {:value :reason} :default ""}}
  {:name :_inheritance-target
   :parent :get
   :args {:coll :_inheritance-intent-preview :key {:value :target} :default {:value {}}}}
  {:name :_inheritance-target-name
   :parent :coalesce
   :args {:value {:parent :get
                  :args {:coll :_inheritance-target :key {:value :qualified-name} :default nil}}
          :default {:parent :coalesce
                    :args {:value {:parent :get
                                   :args {:coll :_inheritance-target :key {:value :name} :default nil}}
                           :default "this function"}}}}
  {:name :_inheritance-variation-label
   :parent :str
   :args {:parts ["Create variation for " :_inheritance-target-name]}}
  {:name :_inheritance-preview-json
   :parent :to-json-string
   :args {:data :_inheritance-intent-preview}}
  {:name :_inheritance-proposed-name
   :parent :get
   :args {:coll {:parent :get
                 :args {:coll :_inheritance-intent-preview :key {:value :proposed} :default {:value {}}}}
          :key {:value :name} :default ""}}
  {:name :_inheritance-name-input
   :parent :hiccup
   :args {:tag "input"
          :attrs {:parent :assoc
                  :args {:map {:value {:type "text" :data-variation-name "true"
                                       :aria-label "Variation name" :placeholder "Variation name"}}
                         :key {:value :value} :value :_inheritance-proposed-name}}
          :children {:value []}}}
  {:name :_inheritance-name-or-nil
   :parent :if
   :args {:test :_inheritance-allowed? :then :_inheritance-name-input :else nil}}
  {:name :_inheritance-source-button
   :parent :hiccup
   :args {:tag "button"
          :attrs {:parent :assoc
                  :args {:map {:value {:type "button" :data-action "inheritance-source"}}
                         :key {:value :data-fn-id} :value {:parent :to-str :args {:value :_inheritance-source-id}}}}
          :children ["Go to source"]}}
  {:name :_inheritance-variation-button
   :parent :hiccup
   :args {:tag "button"
          :attrs {:parent :zipmap
                  :args {:keys [{:value :type} {:value :data-action} {:value :disabled}
                                {:value :aria-describedby}]
                         :vals ["button" "inheritance-variation"
                                {:parent :not :args {:value :_inheritance-allowed?}}
                                "inheritance-intent-reason inheritance-intent-scope"]}}
          :children [:_inheritance-variation-label]}}
  {:name :_inheritance-ancestor-button
   :parent :if
   :args {:test :_inheritance-ancestor-choice?
          :then {:parent :hiccup
                 :args {:tag "button"
                        :attrs {:value {:type "button" :data-action "inheritance-ancestors"}}
                        :children ["Choose ancestor…"]}}
          :else nil}}
  {:name :_inheritance-scope
   :parent :if
   :args {:test :_inheritance-parent-edge?
          :then "Changes this function for all its consumers in this branch. Other children of the source keep the original."
          :else "Replaces this own reference. All consumers of its owner see the change. Other references to the source stay unchanged."}}
  {:name :_inheritance-scope-node
   :parent :hiccup
   :args {:tag "p" :attrs {:value {:id "inheritance-intent-scope" :class "inheritance-intent-scope"}}
          :children [:_inheritance-scope]}}
  {:name :_inheritance-effective-slots
   :parent :get
   :args {:coll :_inheritance-intent-preview :key {:value :effective-slots} :default {:value []}}}
  {:name :_inheritance-slot-line
   :lambda-params [:slot]
   :parent :hiccup
   :args {:tag "li"
          :attrs {:value {:class "inheritance-intent-slot"}}
          :children [{:parent :to-str
                      :args {:value {:parent :get
                                     :args {:coll {:as :slot} :key {:value :name} :default ""}}}}
                     " — declared by "
                     {:parent :str-join
                      :args {:coll {:parent :get
                                    :args {:coll {:as :slot} :key {:value :declared-by-names}
                                           :default {:value []}}}
                             :separator ", "}}
                     {:parent :if
                      :args {:test {:parent :gt
                                    :args {:nums [{:parent :count
                                                   :args {:coll {:parent :get
                                                                 :args {:coll {:as :slot}
                                                                        :key {:value :via-parent-ids}
                                                                        :default {:value []}}}}}
                                                  {:value 1}]}}
                             :then " (shared through multiple parents)"
                             :else ""}}
                     {:parent :if
                      :args {:test {:parent :get
                                    :args {:coll {:as :slot} :key {:value :competing-overlay?}
                                           :default false}}
                             :then " — different bindings from the parents"
                             :else ""}}]}}
  {:name :_inheritance-slot-lines
   :parent :map
   :args {:func :_inheritance-slot-line :coll :_inheritance-effective-slots}}
  {:name :_inheritance-slot-list
   :parent :hiccup
   :args {:tag "ul" :attrs {:value {:class "inheritance-intent-slots"}}
          :children [:_inheritance-slot-lines]}}
  {:name :_inheritance-slot-count
   :parent :to-str
   :args {:value {:parent :count :args {:coll :_inheritance-effective-slots}}}}
  {:name :_inheritance-slot-impact
   :parent :get
   :args {:coll :_inheritance-intent-preview :key {:value :slot-impact} :default {:value {}}}}
  {:name :_inheritance-added-count
   :parent :to-str
   :args {:value {:parent :count
                  :args {:coll {:parent :get
                                :args {:coll :_inheritance-slot-impact
                                       :key {:value :added-slot-ids} :default {:value []}}}}}}}
  {:name :_inheritance-removed-count
   :parent :to-str
   :args {:value {:parent :count
                  :args {:coll {:parent :get
                                :args {:coll :_inheritance-slot-impact
                                       :key {:value :removed-slot-ids} :default {:value []}}}}}}}
  {:name :_inheritance-renamed-count
   :parent :to-str
   :args {:value {:parent :count
                  :args {:coll {:parent :get
                                :args {:coll :_inheritance-slot-impact
                                       :key {:value :renamed-slot-ids} :default {:value []}}}}}}}
  {:name :_inheritance-slot-summary
   :parent :str
   :args {:parts ["Effective slots (" :_inheritance-slot-count "; +" :_inheritance-added-count
                  ", -" :_inheritance-removed-count ", renamed " :_inheritance-renamed-count ")"]}}
  {:name :_inheritance-slot-details
   :parent :if
   :args {:test :_inheritance-allowed?
          :then {:parent :hiccup
                 :args {:tag "details" :attrs {:value {:class "inheritance-intent-slot-details"}}
                        :children [{:parent :hiccup
                                    :args {:tag "summary" :attrs {:value {}}
                                           :children [:_inheritance-slot-summary]}}
                                   :_inheritance-slot-list]}}
          :else nil}}
  {:name :_inheritance-reason-node
   :parent :hiccup
   :args {:tag "p" :attrs {:value {:id "inheritance-intent-reason" :class "inheritance-intent-reason"}}
          :children [:_inheritance-reason]}}
  {:name :_inheritance-actions
   :parent :hiccup
   :args {:tag "div" :attrs {:value {:class "inheritance-intent-actions"}}
          :children [:_inheritance-source-button :_inheritance-name-or-nil
                     :_inheritance-variation-button :_inheritance-ancestor-button]}}
  {:name :_inheritance-intent-view
   :parent :hiccup
   :args {:tag "div"
          :attrs {:parent :assoc
                  :args {:map {:value {:class "inheritance-intent"}}
                         :key {:value :data-preview} :value :_inheritance-preview-json}}
          :children [:_inheritance-actions :_inheritance-reason-node :_inheritance-scope-node
                     :_inheritance-slot-details]}}
  {:name :_partial-inheritance-intent-handler
   :lambda-params [:request]
   :parent :html-ok-response
   :args {:body {:parent :render-hiccup :args {:hiccup :_inheritance-intent-view}}}}]}
