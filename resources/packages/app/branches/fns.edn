  {:name :_delete-branch-err-generic-msg
   :parent :coalesce
   :args {:value {:parent :throwable-message :args {:ex {:as :exception}}}
          :default "Unknown error"}}

  {:name :_delete-branch-err-generic
   :parent :zipmap
   :return-type :_error-result-shape
   :args {:keys [{:value :ok} {:value :error}]
          :vals [{:value false} :_delete-branch-err-generic-msg]}}

  {:name :_delete-branch-apply-clauses
   :description "Dynamic `:case` clauses — built via `:zipmap` so the vals stay as refs (resolving to the per-type envelope), not literal keywords."
   :parent :zipmap
   :args {:keys [{:value :constraint-violation/root-branch-undeletable}
