;; Explorer views — the ONE evaluator behind every way the editor narrows
;; its tree by graph facts.
;;
;; A FILTER is one typed predicate (a chip in the Explorer): by name, by
;; the fn it transitively uses, by effect kind, by row kind or problem, by namespace
;; (include roots / exclude paths), or "unused". A VIEW is a named set of
;; filters. The editor keeps personal views in the browser; a view worth
;; sharing is saved IN THE GRAPH as an fn-def extending `:explorer-view`
;; — versioned, branch-scoped, identity-based (references survive renames),
;; runnable (▶ gives the member list), and
;; listed back to every editor by `GET /api/views`.
;;
;; Both the ad-hoc endpoint and the base-fn answer through
;; `crud.entities.views/view-members`; the shape of a member row is the
;; `:search` light row.
{:namespace "app.views"
 :description "Explorer views — structured filter evaluation (`POST /api/views/members`), views saved in the graph as `:explorer-view` fn-defs, and their listing (`GET /api/views`)."
 :fns
 [;; ---------------------------------------------------------------------
  ;; Base-fns
  ;; ---------------------------------------------------------------------

  {:name :view-members
   :description "Light rows (`{:fns :total :truncated?}`, the `:search` shape, capped at 500; `:missing {:uses :views}` names ids the graph no longer holds) for every named fn of the current branch view matching ALL the given axes. Axes AND; `kinds` / `namespaces` OR within; `uses` / `effects` AND within (uses ALL of, carries ALL of). An empty filter set is an empty answer. Kinds include apps through the installed org-scoped Apps callback; problems are current branch failed/type-errors/lint predicates. Referenced views are intersected before the final 500-row limit. Evaluated over the graph AS THE VIEWER SEES IT (the view-impl seam): a fn whose composition the viewer may not see matches no `uses` THROUGH its internals and ships with empty `:parent-ids`."
   :args {:name {:required false :type :nullable-text
                 :description "Case-insensitive substring of the qualified name."}
          :views {:required false :type [:list :uuid] :value []
                  :description "Ids of `:explorer-view` fn-defs; a member is in every one of them too (their axes, recursively through their own `also`)."}
          :uses {:required false :type [:list :uuid] :value []
                 :description "Fn ids; a member transitively extends or references every one of them."}
          :effects {:required false :type [:list :text] :value []
                    :description "Effect kinds (`io`, `db`, `state`, …) the member's computed footprint carries — all of them. Text, as they arrive over JSON; the evaluator keywordizes."}
          :kinds {:required false :type [:list :text] :value []
                  :description "Row kinds (text) — a member is ONE of: `fn`, `types`, `secrets`, `services`, `apps`, `tests`."}
          :problems {:required false
                     :type [:list [:refine :text {:constraint [:in #{"failed" "type-errors" "lint"}]}]]
                     :value []
                     :description "Current branch problems; matches any selected problem, together with all other axes."}
          :namespaces {:required false :type [:list :text] :value []
                       :description "Dotted namespace paths; a member lives in one of them or below (segment match)."}
          :exclude {:required false :type [:list :text] :value []
                    :description "Dotted namespace paths a member must NOT live in or below."}
          :unused {:required false :type :bool :value false
                   :description "Only fns nothing references or extends."}}
   :return-type :keyword-map
   :effects #{:db}}

  {:name :explorer-view
   :description "A view SAVED IN THE GRAPH — extend this and bind the axes you mean; the Explorer lists every such fn-def (`GET /api/views`) and applies it like a personal view, and ▶ Run answers the member list (`{:fns :truncated?}`). Same evaluation as `:view-members`, Legacy `uses` and `also` remain identity slots. `uses-all` and `also-all` add lists; ordinary const compositions with :fn-ref bindings preserve target identities without executing them. All clauses intersect, and problems are evaluated on the current branch."
   :args {:name {:required false :type :nullable-text
                 :description "Case-insensitive substring of the qualified name."}
          :uses {:required false :type :fn-ref
                 :description "The fn every member transitively extends or references — bound by reference; the impl receives its id."}
          :uses-all {:required false :type [:list :uuid] :value []
                     :description "Additional identities every member transitively uses. List items may reference const functions with :fn-ref value bindings."}
          :also-all {:required false :type [:list :uuid] :value []
                     :description "Additional graph view identities whose complete member sets must all match."}
          :effects {:required false :type [:list :text] :value []
                    :description "Effect kinds the member's footprint carries — all of them."}
          :kinds {:required false :type [:list :text] :value []
                  :description "Row kinds — ONE of `fn`, `types`, `secrets`, `services`, `apps`, `tests`."}
          :problems {:required false
                     :type [:list [:refine :text {:constraint [:in #{"failed" "type-errors" "lint"}]}]]
                     :value []
                     :description "Current branch problems; matches any selected problem, together with all other axes."}
          :namespaces {:required false :type [:list :text] :value []
                       :description "Dotted namespace paths; in one of them or below."}
          :exclude {:required false :type [:list :text] :value []
                    :description "Dotted namespace paths NOT in or below."}
          :unused {:required false :type :bool :value false
                   :description "Only fns nothing references or extends."}
          :also {:required false :type :fn-ref
                 :description "Another `:explorer-view` fn-def, bound by reference — the member set is intersected with its members (that view may `also` a third, and so on: compose views by chaining)."}}
   :return-type :keyword-map
   :effects #{:db}}

  {:name :explorer-views
   :description "Every named fn-def extending `:explorer-view` on the current branch view, with its bound axes decoded — `[{:id :name :namespace-id :filters} …]`, `:filters` in the `:view-members` argument shape plus `:also` (view ids). The Explorer's \"views in the graph\" list."
   :args {}
   :return-type [:list :keyword-map]
   :effects #{:db}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/views — the views saved in the graph
  ;; ---------------------------------------------------------------------

  {:name :api-views-handler
   :lambda-params []
   :description "Ring handler for GET /api/views — `[{id name namespace-id filters} …]` as JSON."
   :parent :json-handler
   :args {:data :explorer-views}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/views/members — evaluate an ad-hoc filter set
  ;;   body: {name, uses:[id…], effects:[…], kinds:[…], namespaces:[…],
  ;;          exclude:[…], unused}
  ;; ---------------------------------------------------------------------


  {:name :_vm-field
   :description "One axis of the parsed JSON body, `:default` when the body or the key is missing."
   :parent :get
   :args {:coll :parse-json-body}}

  {:name :_vm-members
   :parent :view-members
   :args {:name {:parent :_vm-field :args {:key {:value :name} :default nil}}
          :uses {:parent :_vm-field :args {:key {:value :uses} :default []}}
          :effects {:parent :_vm-field :args {:key {:value :effects} :default []}}
          :problems {:parent :_vm-field :args {:key {:value :problems} :default []}}
          :kinds {:parent :_vm-field :args {:key {:value :kinds} :default []}}
          :namespaces {:parent :_vm-field :args {:key {:value :namespaces} :default []}}
          :exclude {:parent :_vm-field :args {:key {:value :exclude} :default []}}
          :unused {:parent :_vm-field :args {:key {:value :unused} :default false}}
          :views {:parent :_vm-field :args {:key {:value :views} :default []}}}}

  {:name :api-view-members-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/views/members — the members of an ad-hoc filter set, `{fns truncated?}` as JSON."
   :parent :json-handler
   :args {:data :_vm-members}}

  ;; Save command is ordinary graph composition. Guards finish before the writer.
  {:name :_vc-body,
   :parent :const,
   :args {:value {:as :body, :type :jsonb}}}

  {:name :_vc-candidate,
   :parent :const,
   :args {:value {:as :candidate, :type [:union :jsonb :uuid]}}}

  {:name :_vc-axis,
   :parent :const,
   :args {:value {:as :axis, :type :keyword}}}

  {:name :_vc-reason,
   :parent :const,
   :args {:value {:as :reason, :type :text}}}

  {:name :_vc-reject,
   :parent :throw,
   :args
   {:exception
    {:parent :ex-info,
     :args
     {:message :_vc-reason,
      :data
      {:parent :zipmap,
       :args
       {:keys [{:value :type} {:value :reason}],
        :vals
        [{:parent :str-to-keyword,
          :args {:string "validation-error/view-command"}}
         :_vc-reason]}}}}}}

  {:name :_vc-body-get,
   :parent :get,
   :args
   {:coll
    {:parent :ensure-type,
     :args {:value :_vc-body, :type {:value :keyword-map}}}}}

  {:name :_vc-filters,
   :parent :_vc-body-get,
   :args {:key {:value :filters}, :default nil}}

  {:name :_vc-name,
   :parent :_vc-body-get,
   :args {:key {:value :name}, :default nil}}

  {:name :_vc-text-error,
   :parent :str,
   :args {:parts [:_vc-axis " must be text of at most 512 characters"]}}

  {:name :_vc-text,
   :parent :if,
   :args
   {:test
    {:parent :is-a?,
     :args {:value :_vc-candidate, :type {:value :text}}},
    :then
    {:parent :if,
     :args
     {:test
      {:parent :lte,
       :args
       {:nums [{:parent :count, :args {:coll {:parent :ensure-type
                                              :args {:value :_vc-candidate :type {:value :text}}}}} 512]}},
      :then :_vc-candidate,
      :else {:parent :_vc-reject, :args {:reason :_vc-text-error}}}},
    :else {:parent :_vc-reject, :args {:reason :_vc-text-error}}}}

  {:name :_vc-uuid-error,
   :parent :str,
   :args {:parts [:_vc-axis " must be a UUID"]}}

  {:name :_vc-parsed-uuid,
   :parent :parse-uuid,
   :args {:string :_vc-candidate}}

  {:name :_vc-uuid,
   :parent :if,
   :args
   {:test
    {:parent :is-a?,
     :args {:value :_vc-candidate, :type {:value :uuid}}},
    :then :_vc-candidate,
    :else
    {:parent :if,
     :args
     {:test {:parent :some?, :args {:value :_vc-parsed-uuid}},
      :then :_vc-parsed-uuid,
      :else {:parent :_vc-reject, :args {:reason :_vc-uuid-error}}}}}}

  {:name :_vc-uuid-axis,
   :parent :some?,
   :args
   {:value
    {:parent :position-in,
     :args {:coll [{:value :uses} {:value :views}], :value :_vc-axis}}}}

  {:name :_vc-keyword-axis,
   :parent :some?,
   :args
   {:value
    {:parent :position-in,
     :args
     {:coll [{:value :effects} {:value :kinds} {:value :problems}],
      :value :_vc-axis}}}}

  {:name :_vc-trimmed,
   :parent :str-trim,
   :args
   {:string
    {:parent :ensure-type,
     :args {:value :_vc-candidate, :type {:value :text}}}}}

  {:name :_vc-trim-text,
   :parent :if,
   :args
   {:test
    {:parent :blank?,
     :args
     {:string
      {:parent :ensure-type,
       :args {:value :_vc-candidate, :type {:value :text}}}}},
    :then nil,
    :else :_vc-trimmed}}

  {:name :_vc-axis-dispatch,
   :lambda-params [:candidate],
   :parent :if,
   :args
   {:test :_vc-uuid-axis,
    :then
    {:parent :_vc-uuid,
     :args {:candidate :_vc-candidate, :axis :_vc-axis}}}}

  {:name :_vc-axis-item,
   :parent :_vc-axis-dispatch,
   :args {:else {:parent :_vc-text,
                 :args {:candidate :_vc-candidate, :axis :_vc-axis}}}}

  {:name :_vc-normalized-item,
   :parent :_vc-axis-dispatch,
   :args
   {:else
    {:parent :if,
     :args
     {:test :_vc-keyword-axis,
      :then
      {:parent :str-to-keyword,
       :args
       {:string
        {:parent :re-replace,
         :args
         {:string
          {:parent :ensure-type,
           :args {:value :_vc-candidate, :type {:value :text}}},
          :pattern "^:",
          :replacement ""}}}},
      :else
      {:parent :_vc-trim-text, :args {:candidate :_vc-candidate}}}}}}

  {:name :_vc-non-nil,
   :lambda-params [:candidate],
   :parent :some?,
   :args {:value {:as :candidate, :type :nullable-jsonb}}}

  {:name :_vc-axis-values,
   :parent :get,
   :args {:coll :_vc-filters, :key :_vc-axis}}

  {:name :_vc-axis-error,
   :parent :str,
   :args {:parts [:_vc-axis " must contain at most 64 values"]}}

  {:name :_vc-check-axis,
   :parent :if,
   :args
   {:test
    {:parent :contains?, :args {:coll :_vc-filters, :key :_vc-axis}},
    :then
    {:parent :if,
     :args
     {:test
      {:parent :is-a?,
       :args {:value :_vc-axis-values, :type {:value :sequence}}},
      :then
      {:parent :if,
       :args
       {:test
        {:parent :lte,
         :args
         {:nums [{:parent :count, :args {:coll :_vc-axis-values}} 64]}},
        :then
        {:parent :map,
         :args {:func :_vc-axis-item, :coll :_vc-axis-values}},
        :else {:parent :_vc-reject, :args {:reason :_vc-axis-error}}}},
      :else {:parent :_vc-reject, :args {:reason :_vc-axis-error}}}},
    :else nil}}

  {:name :_vc-normalize-axis,
   :parent :vec,
   :args
   {:coll
    {:parent :distinct,
     :args
     {:coll
      {:parent :filter,
       :args
       {:pred :_vc-non-nil,
        :coll
        {:parent :map,
         :args
         {:func :_vc-normalized-item,
          :coll
          {:parent :get,
           :args
           {:coll :_vc-filters, :key :_vc-axis, :default []}}}}}}}}}}

  {:name :_vc-allowed-key,
   :lambda-params [:candidate],
   :parent :some?,
   :args
   {:value
    {:parent :position-in,
     :args
     {:coll
      [{:value :uses}
       {:value :views}
       {:value :effects}
       {:value :kinds}
       {:value :problems}
       {:value :namespaces}
       {:value :exclude}
       {:value :name}
       {:value :unused}],
      :value {:as :candidate, :type :keyword}}}}}

  {:name :_vc-check-name,
   :parent :if,
   :args
   {:test
    {:parent :if,
     :args
     {:test
      {:parent :is-a?, :args {:value :_vc-name, :type {:value :text}}},
      :then
      {:parent :if,
       :args
       {:test {:parent :blank?, :args {:string :_vc-name}},
        :then false,
        :else
        {:parent :lte,
         :args
         {:nums [{:parent :count, :args {:coll :_vc-name}} 160]}}}},
      :else false}},
    :then nil,
    :else
    {:parent :_vc-reject,
     :args
     {:reason
      "Give the view a non-empty name of at most 160 characters"}}}}

  {:name :_vc-check-filters,
   :parent :if,
   :args
   {:test
    {:parent :if,
     :args
     {:test
      {:parent :is-a?, :args {:value :_vc-filters, :type {:value :map}}},
      :then
      {:parent :every?,
       :args
       {:pred :_vc-allowed-key,
        :coll {:parent :keys, :args {:map :_vc-filters}}}},
      :else false}},
    :then nil,
    :else
    {:parent :_vc-reject,
     :args {:reason "Unknown or missing filter axes"}}}}

  {:name :_vc-filter-name,
   :parent :get,
   :args {:coll :_vc-filters, :key {:value :name}, :default nil}}

  {:name :_vc-check-filter-name,
   :parent :if,
   :args
   {:test {:parent :some?, :args {:value :_vc-filter-name}},
    :then
    {:parent :_vc-text,
     :args {:candidate :_vc-filter-name, :axis {:value :name}}},
    :else nil}}

  {:name :_vc-check-unused,
   :parent :if,
   :args
   {:test
    {:parent :if,
     :args
     {:test
      {:parent :contains?,
       :args {:coll :_vc-filters, :key {:value :unused}}},
      :then
      {:parent :is-a?,
       :args
       {:value
        {:parent :get,
         :args
         {:coll :_vc-filters, :key {:value :unused}, :default nil}},
        :type {:value :bool}}},
      :else true}},
    :then nil,
    :else
    {:parent :_vc-reject, :args {:reason "unused must be a boolean"}}}}

  {:name :_vc-uses,
   :parent :_vc-normalize-axis,
   :args {:axis {:value :uses}}}

  {:name :_vc-views,
   :parent :_vc-normalize-axis,
   :args {:axis {:value :views}}}

  {:name :_vc-effects,
   :parent :_vc-normalize-axis,
   :args {:axis {:value :effects}}}

  {:name :_vc-kinds,
   :parent :_vc-normalize-axis,
   :args {:axis {:value :kinds}}}

  {:name :_vc-problems,
   :parent :_vc-normalize-axis,
   :args {:axis {:value :problems}}}

  {:name :_vc-namespaces,
   :parent :_vc-normalize-axis,
   :args {:axis {:value :namespaces}}}

  {:name :_vc-exclude,
   :parent :_vc-normalize-axis,
   :args {:axis {:value :exclude}}}

  {:name :_vc-normalized-name,
   :parent :if,
   :args
   {:test {:parent :some?, :args {:value :_vc-filter-name}},
    :then {:parent :_vc-trim-text, :args {:candidate :_vc-filter-name}},
    :else nil}}

  {:name :_vc-normalized-unused,
   :parent :get,
   :args {:coll :_vc-filters, :key {:value :unused}, :default false}}

  {:name :_vc-normalized-filters,
   :parent :zipmap,
   :args
   {:keys
    [{:value :name}
     {:value :uses}
     {:value :views}
     {:value :effects}
     {:value :kinds}
     {:value :problems}
     {:value :namespaces}
     {:value :exclude}
     {:value :unused}],
    :vals
    [:_vc-normalized-name
     :_vc-uses
     :_vc-views
     :_vc-effects
     :_vc-kinds
     :_vc-problems
     :_vc-namespaces
     :_vc-exclude
     :_vc-normalized-unused]}}

  {:name :_vc-enum-item,
   :lambda-params [:candidate],
   :parent :some?,
   :args
   {:value
    {:parent :position-in,
     :args
     {:coll {:as :allowed, :type [:list :keyword]},
      :value {:as :candidate, :type :keyword}}}}}

  {:name :_vc-effect-keywords,
   :parent :map,
   :args {:func :str-to-keyword, :coll :declarable-effect-categories}}

  {:name :_vc-check-kinds,
   :parent :if,
   :args
   {:test
    {:parent :every?,
     :args
     {:pred
      {:parent :_vc-enum-item,
       :args
       {:allowed
        [{:value :fn}
         {:value :types}
         {:value :secrets}
         {:value :services}
         {:value :apps}
         {:value :tests}]}},
      :coll :_vc-kinds}},
    :then nil,
    :else {:parent :_vc-reject, :args {:reason "Unknown kinds value"}}}}

  {:name :_vc-check-problems,
   :parent :if,
   :args
   {:test
    {:parent :every?,
     :args
     {:pred
      {:parent :_vc-enum-item,
       :args
       {:allowed
        [{:value :failed} {:value :type-errors} {:value :lint}]}},
      :coll :_vc-problems}},
    :then nil,
    :else
    {:parent :_vc-reject, :args {:reason "Unknown problems value"}}}}

  {:name :_vc-check-effects,
   :parent :if,
   :args
   {:test
    {:parent :every?,
     :args
     {:pred
      {:parent :_vc-enum-item,
       :args
       {:allowed
        {:parent :ensure-type,
         :args
         {:value :_vc-effect-keywords,
          :type {:value [:list :keyword]}}}}},
      :coll :_vc-effects}},
    :then nil,
    :else {:parent :_vc-reject, :args {:reason "Unknown effects value"}}}}

  {:name :_vc-command,
   :parent :zipmap,
   :args
   {:keys [{:value :name} {:value :filters}],
    :vals
    [{:parent :str-trim, :args {:string :_vc-name}}
     :_vc-normalized-filters]}}

  {:name :_vc-command-id,
   :parent :if,
   :args
   {:test
    {:parent :get,
     :args
     {:coll
      {:parent :ensure-type,
       :args {:value :_vc-body, :type {:value :keyword-map}}},
      :key {:value :id},
      :default nil}},
    :then
    {:parent :assoc,
     :args
     {:map :_vc-command,
      :key {:value :id},
      :value
      {:parent :_vc-uuid,
       :args
       {:candidate
        {:parent :get,
         :args
         {:coll
          {:parent :ensure-type,
           :args {:value :_vc-body, :type {:value :keyword-map}}},
          :key {:value :id},
          :default nil}},
        :axis {:value :id}}}}},
    :else :_vc-command}}

  {:name :_vc-command-create-id,
   :parent :if,
   :args
   {:test
    {:parent :contains?,
     :args
     {:coll
      {:parent :ensure-type,
       :args {:value :_vc-body, :type {:value :keyword-map}}},
      :key {:value :create-id}}},
    :then
    {:parent :assoc,
     :args
     {:map :_vc-command-id,
      :key {:value :create-id},
      :value
      {:parent :_vc-uuid,
       :args
       {:candidate
        {:parent :get,
         :args
         {:coll
          {:parent :ensure-type,
           :args {:value :_vc-body, :type {:value :keyword-map}}},
          :key {:value :create-id},
          :default nil}},
        :axis {:value :create-id}}}}},
    :else :_vc-command-id}}

  {:name :_vc-command-namespace-id,
   :parent :if,
   :args
   {:test
    {:parent :contains?,
     :args
     {:coll
      {:parent :ensure-type,
       :args {:value :_vc-body, :type {:value :keyword-map}}},
      :key {:value :namespace-id}}},
    :then
    {:parent :assoc,
     :args
     {:map :_vc-command-create-id,
      :key {:value :namespace-id},
      :value
      {:parent :if,
       :args
       {:test
        {:parent :get,
         :args
         {:coll
          {:parent :ensure-type,
           :args {:value :_vc-body, :type {:value :keyword-map}}},
          :key {:value :namespace-id},
          :default nil}},
        :then
        {:parent :_vc-uuid,
         :args
         {:candidate
          {:parent :get,
           :args
           {:coll
            {:parent :ensure-type,
             :args {:value :_vc-body, :type {:value :keyword-map}}},
            :key {:value :namespace-id},
            :default nil}},
          :axis {:value :namespace-id}}},
        :else nil}}}},
    :else :_vc-command-create-id}}

  {:name :parse-view-command,
   :description
   "Validate, normalize and assemble a bounded Save view command before the atomic writer is called. Guards execute in declaration order; the save primitive may record its :db effect before demanding the command.",
   :return-type :keyword-map,
   :parent :do,
   :args
   {:steps
    [{:parent :if,
      :args
      {:test
       {:parent :is-a?, :args {:value :_vc-body, :type {:value :map}}},
       :then nil,
       :else
       {:parent :_vc-reject,
        :args {:reason "Save view requires a JSON object"}}}}
     {:parent :if,
      :args
      {:test
       {:parent :not,
        :args
        {:value
         {:parent :and,
          :args
          {:values
           [{:parent :contains?,
             :args
             {:coll
              {:parent :ensure-type,
               :args {:value :_vc-body, :type {:value :keyword-map}}},
              :key {:value :id}}}
            {:parent :contains?,
             :args
             {:coll
              {:parent :ensure-type,
               :args {:value :_vc-body, :type {:value :keyword-map}}},
              :key {:value :create-id}}}]}}}},
       :then nil,
       :else
       {:parent :_vc-reject,
        :args
        {:reason
         "Use id to update or create-id to create, never both"}}}}
     :_vc-check-name
     :_vc-check-filters
     {:parent :_vc-check-axis, :args {:axis {:value :exclude}}}
     {:parent :_vc-check-axis, :args {:axis {:value :namespaces}}}
     {:parent :_vc-check-axis, :args {:axis {:value :problems}}}
     {:parent :_vc-check-axis, :args {:axis {:value :uses}}}
     {:parent :_vc-check-axis, :args {:axis {:value :effects}}}
     {:parent :_vc-check-axis, :args {:axis {:value :views}}}
     {:parent :_vc-check-axis, :args {:axis {:value :kinds}}}
     :_vc-check-filter-name
     :_vc-check-unused
     :_vc-check-kinds
     :_vc-check-problems
     :_vc-check-effects
     :_vc-command-namespace-id]}}

  {:name :save-explorer-view
   :description "Atomically create or update an ordinary explorer-view fn and every filter binding; publish only after commit."
   :args {:command {:type :keyword-map}
          :request {:type :ring-request-shape :description "Request scope pin."}}
   :return-type :keyword-map
   :effects #{:db}}

  {:name :_view-save-command
   :parent :parse-view-command
   :args {:body {:ref :parse-json-body :type :keyword-map}}}

  {:name :_view-save-result
   :parent :save-explorer-view
   :args {:command :_view-save-command}}

  {:name :api-view-save-handler
   :lambda-params [:request]
   :parent :json-envelope-response
   :args {:envelope :_view-save-result}}

