                                                      :key {:value :name}
                                                      :default nil}}}}]}}
          :else {:value {}}}}

  {:name :_parse-ns-form-parent-id-raw
   :parent :get
   :args {:coll {:as :form-data} :key {:value :parent-id} :default nil}}

  {:name :_parse-ns-form-parent-id-fragment
   :description "`{:parent-id <uuid>}` when form-data's `:parent-id` is non-blank; else `{}`. Empty-as-clear is OUT of band — the create/update path interprets a missing key as 'no change'."
   :parent :if
   :args {:test {:parent :not
                 :args {:value {:parent :blank?
                                :args {:string :_parse-ns-form-parent-id-raw}}}}
          :then {:parent :zipmap
                 :args {:keys [{:value :parent-id}]
                        :vals [{:parent :parse-uuid
                                :args {:string :_parse-ns-form-parent-id-raw}}]}}
          :else {:value {}}}}

  {:name :_parse-ns-form-description-fragment
   :description "`{:description …}` when form-data contains `:description`; else `{}`. Pass-through (no coercion)."
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll {:as :form-data} :key {:value :description}}}
          :then {:parent :zipmap
                 :args {:keys [{:value :description}]
                        :vals [{:parent :get
                                :args {:coll {:as :form-data}
                                       :key {:value :description}
                                       :default nil}}]}}
          :else {:value {}}}}

  {:name :parse-ns-from-form
   :description "Extract a namespace entity's field map from a parsed form-data map. `:name` (string) is required; `:parent-id` and `:description` are optional. The form is the body of `POST /api/entities/ns` from the editor's `+` menu."
   :parent :merge
   :args {:maps [{:value {}}
                 :_parse-ns-form-name-fragment
                 :_parse-ns-form-parent-id-fragment
                 :_parse-ns-form-description-fragment]
          :form-data {:type :_form-data-shape
                      :description "Parsed form-data map; each per-field fragment looks up its key here."}}}

