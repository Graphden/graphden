;; Route groups — the top-level entry reitit consumes via `app.server._router`.
;;
;; After the nested-routes refactor, `:all` is no longer a flat list of
;; every endpoint — it's a small list of TOP-LEVEL reitit entries:
;; standalone leaves (`:health`, `:metrics`, `:favicon`, `:editor`) and
;; the `:api-routes` prefix group. Reitit walks the nested vectors and
;; assembles full paths itself.


{:namespace "app.routes.groups"
 :description "The `:all` route bundle — the top-level nested-tree input to reitit's router."
 :fns
 [{:name :all
   :description "Top-level reitit entries — the small list of standalone leaves and the `:api-routes` prefix group that the router walks. Adding a new path = either drop a new leaf in here (if it has no prefix-mate) or extend the appropriate sub-group inside `:api-routes`."
   :parent :list
   :args {:items [:favicon
                  :editor
                  :editor-js-asset
                  :editor-css-asset
                  :partial-effect
                  :partial-fn-versions
                  :partial-fn-version-executions
                  :partial-execute-history
                  :health
                  :metrics
                  :version
                  :api-routes]}}]}
