                        :separator {:value ","}
                        :limit nil}}}}

  {:name :_parse-fn-form-pid-parse-uuid
   :description "Per-item UUID parse — HOF callback."
   :parent :parse-uuid
   :args {:string {:as :item}}}

  {:name :_parse-fn-form-parent-ids-coerced
   :description "Parsed parent-ids vec — `[]` on blank input; otherwise the parsed UUID list."
   :parent :if
   :args {:test {:parent :blank?
                 :args {:string :_parse-fn-form-parent-ids-raw}}
          :then {:value []}
          :else {:parent :vec
                 :args {:coll {:parent :map
                               :args {:func :_parse-fn-form-pid-parse-uuid
                                      :coll :_parse-fn-form-pid-trimmed}}}}}}

  {:name :_parse-fn-form-parent-ids-fragment
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll {:as :form-data} :key {:value :parent-ids}}}
          :then {:parent :zipmap
                 :args {:keys [{:value :parent-ids}]
                        :vals [:_parse-fn-form-parent-ids-coerced]}}
          :else {:value {}}}}

  {:name :_parse-fn-form-base-fn-id-raw
   :parent :get
   :args {:coll {:as :form-data} :key {:value :base-fn-id} :default nil}}

  {:name :_parse-fn-form-base-fn-id-coerced
   :parent :if
   :args {:test {:parent :not
                 :args {:value {:parent :blank?
                                :args {:string :_parse-fn-form-base-fn-id-raw}}}}
