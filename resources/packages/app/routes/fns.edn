  ;; =============================================================================
  ;; /api/* — application API surface. Adding `/v1` is a single wrap of
  ;; `:api-routes` in another group with prefix "/v1".
  ;; =============================================================================

  ;; --- /api/entities — entity CRUD ---

  {:name :entity-create
   :description "POST /api/entities/:type — create entity from form-encoded body. Auth-required."
   :parent :post
   :args {:path "/:type" :handler :create-entity-handler}}

  ;; PUT and DELETE both target /:type/:id — combine their method-maps
  ;; into one reitit entry so the path is declared exactly once.

  {:name :entity-update
   :description "Method-data for PUT on `/api/entities/:type/:id` — updates an entity from a form-encoded body. Combined with `:entity-delete` into `:entity-by-id`. Auth-required."
   :parent :_method-map-with-middleware
   :args {:method "put"
          :handler :update-entity-handler
          :middleware :_middleware-list}}

  {:name :entity-delete
   :description "Method-data for DELETE on `/api/entities/:type/:id` — soft-deletes the entity. Combined with `:entity-update` into `:entity-by-id`. Auth-required."
   :parent :_method-map-with-middleware
   :args {:method "delete"
          :handler :delete-entity-handler
          :middleware :_middleware-list}}

  {:name :_entity-by-id-methods
   :description "Merged method-data — `{:put {…} :delete {…}}` — for `/api/entities/:type/:id`."
   :parent :merge
   :args {:maps [:entity-update :entity-delete]}}

  {:name :entity-by-id
   :description "Multi-method route entry `[\"/:type/:id\" {:put … :delete …}]`. Sits inside `:entity-routes`."
   :parent :list
   :args {:items ["/:type/:id" :_entity-by-id-methods]}}

  {:name :entity-routes
   :description "/api/entities/* sub-group — POST `/:type` (create) and PUT/DELETE `/:type/:id` (update/delete). New methods on /:type/:id go into `:_entity-by-id-methods`; new sub-paths get listed here directly."
   :parent :list
   :args {:items ["/entities" :entity-create :entity-by-id]}}

  ;; --- /api/assets — frontend-asset overrides (UI Step 1) ---

  {:name :api-assets-save
   :description "POST /api/assets/save — upsert a `:resource-override` from the panel form's {path, content}; returns the refreshed Assets panel HTML. Auth-required; tenant writes rejected at the storage layer."
   :parent :post
   :args {:path "/assets/save" :handler :_asave-handler}
   :expects-effects #{:db}}

  {:name :api-assets-baseline
   :description "GET /api/assets/baseline?path=… — the shipped classpath body of one asset, for the Assets panel's diff view. Auth-required."
   :parent :get-auth-required
   :args {:path "/assets/baseline" :handler :_abase-handler}
   :expects-effects #{:io}}

  {:name :api-assets-revert
   :description "DELETE /api/assets/revert?path=… — soft-delete the path's `:resource-override`; returns the refreshed Assets panel HTML. Auth-required."
   :parent :delete
   :args {:path "/assets/revert" :handler :_arev-handler}
   :expects-effects #{:db}}

  ;; --- /api/sequence — sequence-arg editing ---

  {:name :sequence-append
   :description "POST /api/sequence/append/:fn-id — appends an item to a `:sequence`-typed arg. Auth-required."
   :parent :post
   :args {:path "/append/:fn-id" :handler :sequence-append-handler}}

  ;; PUT and DELETE both target /item/:item-id — combine their
  ;; method-maps into one reitit entry so the path is declared once.

  {:name :sequence-item-update
   :description "Method-data for PUT on `/api/sequence/item/:item-id` — replaces an item's value/ref. Combined with `:sequence-item-remove` into `:sequence-item`. Auth-required."
   :parent :_method-map-with-middleware
   :args {:method "put"
          :handler :sequence-update-handler
          :middleware :_middleware-list}}

  {:name :sequence-item-remove
   :description "Method-data for DELETE on `/api/sequence/item/:item-id` — removes an item from its sequence-arg. Combined with `:sequence-item-update` into `:sequence-item`. Auth-required."
   :parent :_method-map-with-middleware
   :args {:method "delete"
          :handler :sequence-remove-handler
          :middleware :_middleware-list}}

  {:name :_sequence-item-methods
   :description "Merged method-data — `{:put {…} :delete {…}}` — for `/api/sequence/item/:item-id`."
   :parent :merge
   :args {:maps [:sequence-item-update :sequence-item-remove]}}

  {:name :sequence-item
   :description "Multi-method route entry `[\"/item/:item-id\" {:put … :delete …}]`. Sits inside `:sequence-routes`."
   :parent :list
   :args {:items ["/item/:item-id" :_sequence-item-methods]}}

  {:name :sequence-move
   :description "POST /api/sequence/move/:item-id — swaps an item with its up/down neighbour (body `{\"direction\": \"up\"|\"down\"}`). Auth-required."
   :parent :post
   :args {:path "/move/:item-id" :handler :sequence-move-handler}}

  {:name :sequence-routes
   :description "/api/sequence/* sub-group — POST `/append/:fn-id`, POST `/move/:item-id`, plus PUT/DELETE `/item/:item-id`. New methods on /item/:item-id go into `:_sequence-item-methods`."
   :parent :list
   :args {:items ["/sequence" :sequence-append :sequence-move :sequence-item]}}

  ;; --- /api/bindings — binding-specific narrowing operations ---

  {:name :tighten-binding-effects
   :description "POST /api/bindings/:binding-id/tighten-fn-effects — narrow an fn-typed binding's effective type to a 4-arity `[:fn args ret #{eff-set}]`. Body: `{effects: [\"db\", \"io\", …]}`. Auth-required."
   :parent :post
   :args {:path "/:binding-id/tighten-fn-effects"
          :handler :tighten-binding-effects-handler}}

  {:name :bindings-routes
   :description "/api/bindings/* sub-group — currently just the tighten-fn-effects endpoint."
   :parent :list
   :args {:items ["/bindings" :tighten-binding-effects]}}

  ;; --- /api/graph — graph data API ---

  ;; AUTH-REQUIRED (provider-aware): the full graph dump + layout are the
  ;; "open view" — gated so an unauthenticated caller can't read the graph when
  ;; auth is ON (cloud / self-hosted with AUTH_TOKEN). When auth is OFF (no
  ;; provider) the provider-aware middleware passes them through, so a no-login
  ;; self-hosted instance still serves them openly. Read access can be re-opened
  ;; per-namespace via a read grant.
  {:name :api-entities
   :description "GET /api/graph/entities — full graph dump (every fn, arg, namespace) as JSON. Auth-required when auth is active (removes the anonymous graph view); open when auth is off."
   :parent :get-auth-required
   :args {:path "/entities" :handler :all-entities-handler}}

  {:name :layout-api
   :description "POST /api/graph/layout — accepts `{root-id, expansions}`, returns the laid-out graph (nodes + edges + grid positions). Auth-required when auth is active; open when auth is off."
   :parent :post
   :args {:path "/layout" :handler :_layout-api-handler}}

  {:name :graph-routes
   :description "/api/graph/* sub-group — graph-data endpoints (entities dump + layout pipeline)."
   :parent :list
   :args {:items ["/graph" :api-entities :layout-api]}}

  ;; --- /api/types — type-system surface ---

  {:name :api-types
   :description "GET /api/types — snapshot of the in-memory rich-type registry (every fn / fn-def's `:return` + `:args`). Powers editor type hints and external introspection. Auth-required when auth is active; open when auth is off."
   :parent :get-auth-required
   :args {:path "" :handler :all-rich-types-handler}}

  {:name :api-types-compatible
   :description "POST /api/types/compatible — single-pair subtype check. Body: `{expected, candidate}` in the JSON shape produced by `/api/types`. Returns `{ok, expected, candidate, reason?}`. UI uses this for type-mismatch explainers without re-implementing `subtype?` in JS. Auth-required when auth is active; open when auth is off."
   :parent :post
   :args {:path "/compatible" :handler :types-compatible-handler}}

  {:name :api-types-candidates
   :description "POST /api/types/candidates — enumerate fns whose return type is a subtype of `expected`. Body: `{expected, effects?, name-prefix?}`. Returns `{count, candidates: [{name, return, args, effects}, ...]}` sorted alphabetically. Powers type-aware fn-pickers. Auth-required when auth is active; open when auth is off."
   :parent :post
   :args {:path "/candidates" :handler :types-candidates-handler}}

  {:name :api-types-usages
   :description "POST /api/types/usages — list every fn that references a given type-row. Body: `{type-fn-id}`. Returns `{count, usages: [{fn-id, fn-name, role, kind, slot-name?}, ...]}`. Powers the inline-expand panel's 'Used by N' navigation. Auth-required when auth is active; open when auth is off."
   :parent :post
   :args {:path "/usages" :handler :types-usages-handler}}

  {:name :api-types-record
   :description "POST /api/types/record — atomically create a record type-row. JSON body `{namespace-id?, name, description?, fields: [{name, type, description?, required?}, …]}`. Returns `{ok, id?, name?, error?}`. Auth-required (creates entities)."
   :parent :post
   :args {:path "/record" :handler :types-create-record-handler}}

  {:name :api-types-record-update
   :description "PUT /api/types/record-update — diff-update an existing record (path-distinct from POST /record because the reitit router rejects duplicate path entries even across methods in our compile pipeline). JSON body `{id, name?, description?, fields: [{name, type, …}, …]}`. Auth-required."
   :parent :put
   :args {:path "/record-update" :handler :types-update-record-handler}}

  {:name :api-types-list
   :description "POST /api/types/list — atomically create a list type-row (fn + auto-`items` slot). JSON body `{namespace-id?, name, description?, element-type}`. Auth-required."
   :parent :post
   :args {:path "/list" :handler :types-create-list-handler}}

  {:name :types-routes
   :description "/api/types/* sub-group — registry snapshot + Phase 1 type-aware helpers (compatible / candidates / usages) + Tier-2 compound creators (record / list) for the editor."
   :parent :list
   :args {:items ["/types"
                  :api-types
                  :api-types-compatible
                  :api-types-candidates
                  :api-types-usages
                  :api-types-record
                  :api-types-record-update
                  :api-types-list]}}

  ;; --- /api/auth/check — admin-token validation ping ---

  {:name :auth-check
   :description "GET /api/auth/check — auth-required ping endpoint. Returns 200 `\"ok\"` when the bearer token matches; the auth middleware short-circuits to 401 otherwise. Used by the editor's lock-icon popover to validate the password before showing edit affordances."
   :parent :get-auth-required
   :args {:path "/auth/check" :handler :_auth-check-handler}}

  {:name :_auth-check-handler
   :description "Ring handler returning `200 \"ok\"` as plain text."
   :parent :text-ok-response
   :args {:body "ok"}}

  ;; --- /auth/me — accounts-addon-absent fallback (root-level, open) ---
  ;; The accounts addon owns `/auth/me` via its route-collection seam, which
  ;; runs BEFORE the graph router and returns `{account}`/401 when mounted — so
  ;; this graph route only fires on a deployment WITHOUT the accounts addon
  ;; (single-tenant / self-hosted). It returns `200 {"account": null}` so the
  ;; editor's boot probe (`probeAccountsAuth`, editor-auth.js) reads "no accounts"
  ;; cleanly instead of hitting a 404 that the browser logs to the console.
  ;; MUST be open (`:get-route`, not `:get-auth-required`): with admin-token auth
  ;; active a 401 here would be mis-read by the probe as "accounts present".
  {:name :auth-me-fallback
   :description "GET /auth/me — root-level fallback returning `200 {\"account\": null}` when the accounts addon is not mounted (its seam handles this path when present). Kills the boot-probe 404 on single-tenant deployments."
   :parent :get-route
   :args {:path "/auth/me" :handler :_auth-me-fallback-handler}}

  {:name :_auth-me-fallback-handler
   :description "Ring handler returning `200 {\"account\": null}` as JSON — the addon-absent answer for the editor's accounts probe."
   :parent :json-ok-response
   :args {:body "{\"account\":null}"}}

  ;; --- /api/value-kinds — value_kind schema enum ---

  {:name :api-value-kinds
   :description "GET /api/value-kinds — the `value_kind` schema enum as a JSON array of primitive type-tag strings. The editor's type-pickers fetch this instead of hard-coding the enum. Auth-required when auth is active; open when auth is off."
   :parent :get-auth-required
   :args {:path "/value-kinds" :handler :value-kinds-handler}}

  ;; --- /api/value-form — type-aware editor form for a binding/slot ---

  {:name :api-value-form
   :description "POST /api/value-form — JSON body `{binding-id | fn-id+slot-id, item-id?}`. Resolves the slot's effective type, picks the matching form-fn, and returns `{ok, form: <hiccup>, value: <current>}`. The editor renders the hiccup as the value-edit popover. Auth-required when auth is active; open when auth is off."
   :parent :post
   :args {:path "/value-form" :handler :value-form-handler}}

  ;; --- /api/execute — submit, poll, cancel fn runs ---

  {:name :api-execute
   :description "POST /api/execute — submit a fn-graph run. Body `{fn-id|fn-name, args, timeout-ms?, persist??}`. Returns inline `{status: succeeded, result}` for fast pure fns or `{status: pending, execution-id}` when timeout fires / effects ≠ #{} / persist? true. Auth-required."
   :parent :post
   :args {:path "/execute" :handler :execute-handler}}

  {:name :api-execution-by-id
   :description "GET /api/execute/:id — read a persisted execution row (status, result/error, declared-effects, started/finished-at, nested args). Auth-required."
   :parent :get-auth-required
   :args {:path "/execute/:id" :handler :get-execution-handler}}

  {:name :api-execution-cancel
   :description "POST /api/execute/:id/cancel — soft-cancel an in-flight execution. Sets the row's :cancel-requested? flag + future-cancel. Best-effort (blocking IO won't respect interrupt without explicit Statement.cancel())."
   :parent :post
   :args {:path "/execute/:id/cancel" :handler :cancel-execution-handler}}

  {:name :api-executions-list
   :description "GET /api/executions?fn-id=X — list last 20 executions for one fn (across all of its versions). Each row summarises status / timestamps / declared-effects; nested args are NOT included (call GET /api/execute/:id to expand a row). Auth-required."
   :parent :get-auth-required
   :args {:path "/executions" :handler :list-executions-handler}}

  ;; --- /api/debug/catch — one-shot «catch next request» trap ---

  {:name :api-debug-catch-arm
   :description "POST /api/debug/catch — arm (replace) the current org+branch's one-shot request trap. Body `{path-prefix?, capture-values?, ttl-ms?}`. The next matching HTTP request through the branch router runs path-traced and persists a :fn-execution row. Auth-required."
   :parent :post
   :args {:path "/debug/catch" :handler :debug-catch-arm-handler}}

  {:name :api-debug-catch-cancel
   :description "POST /api/debug/catch/cancel — disarm the current org+branch's trap. `{disarmed: bool}`. Auth-required."
   :parent :post
   :args {:path "/debug/catch/cancel" :handler :debug-catch-disarm-handler}}

  {:name :api-debug-catch-status
   :description "GET /api/debug/catch/status — the current org+branch's live trap (`{armed, trap}`; expired ≡ unarmed). Separate path from the POST arm route — reitit rejects the same path split across two route rows. Auth-required."
   :parent :get-auth-required
   :args {:path "/debug/catch/status" :handler :debug-catch-status-handler}}

  ;; --- /api/tests — run + status of `tests`-namespace fns ---

  {:name :api-tests-run
   :description "POST /api/tests/run — run every test on the current branch (or the body's `{fn-ids: […]}` subset) sequentially through the standard execute pipeline; returns `{total, passed, failed, other, results}`. Auth-required."
   :parent :post
   :args {:path "/tests/run" :handler :tests-run-handler}}

  {:name :api-tests-status
   :description "GET /api/tests/status — every test fn on the current branch with the newest execution status of its CURRENT version (`status` null = never ran since the last edit). Auth-required."
   :parent :get-auth-required
   :args {:path "/tests/status" :handler :tests-status-handler}}

  ;; --- /api/services/reconcile — Phase 1 hot-reload trigger ---

  {:name :api-services-reconcile
   :description "POST /api/services/reconcile — trigger the service reconciler. Reads enabled :service rows, starts missing + stops removed. Admin calls this after CREATE/UPDATE/DELETE on a :service row so the in-process state catches up without a pod restart. Phase 1 only — periodic poll arrives with Phase 3 (multi-pod). Auth-required."
   :parent :post
   :args {:path "/services/reconcile" :handler :reconcile-services-handler}}

  {:name :api-services-list
   :description "GET /api/services — list every :service row joined with its in-process running state (started-at, attempts, give-up marker) and the legacy fallback if active. Editor reads this to drive the sidebar 'Only services' filter, the row-actions 'Make service' popover, and the per-fn status badge. Auth-required."
   :parent :get-auth-required
   :args {:path "/services" :handler :list-services-handler}}

