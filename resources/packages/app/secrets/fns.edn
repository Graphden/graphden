   :parent :uri-segment-after
   :args {:marker {:value "secrets"}}}

  {:name :_delete-secret-parsed
   :description "Parse `DELETE /api/secrets/:fn-id` URL into `{:fn-id <uuid|nil> :fn-id-ref <raw>}`. Raw form preserved for dynamic error messages."
