;; System information and Ring response primitives
;; ring-response, make-handler, to-json-string, jvm-info, current-time-ms


{:namespace "core.system"
 :fns
 [{:name :ring-response
   :args {:status :int
          :headers :jsonb
          :body :text}
   :return-type :jsonb}

  ;; `:make-handler` wraps a constant response into a Ring callable
  ;; `(fn [_request] response)`. Used by reitit's default-handler trio
  ;; (`:not-found`, `:method-not-allowed`, `:not-acceptable`) where the
  ;; route-data slot is `:any`-typed (no hof-wrap), so we need a real
  ;; Clojure callable. Per-route handlers go through `:assoc-fn` and
  ;; are hof-wrap'd directly — they don't need this wrapper.
  {:name :make-handler
   :args {:response :jsonb}
   :return-type :fn}

  {:name :to-json-string
   :args {:data :any}
   :return-type :text}

  {:name :parse-json
   :args {:string :text
          :keywordize {:type :bool :value true}}
   :return-type :jsonb}

  {:name :jvm-version
   :args {}
   :return-type :jsonb}

  {:name :heap-memory
   :args {}
   :return-type :jsonb}

  {:name :thread-count
   :args {}
   :return-type :int}

  {:name :os-info
   :args {}
   :return-type :jsonb}

  ;; jvm-info composed from atomic base-fns via assoc chain
  {:name :_jvm-section
   :parent :assoc-empty
   :args {:key "jvm" :value :jvm-version}}

  {:name :_memory-section
   :parent :assoc
   :args {:map :_jvm-section :key "memory" :value :heap-memory}}

  {:name :_threads-section
   :parent :assoc
   :args {:map :_memory-section :key "threads" :value :thread-count}}

  {:name :jvm-info
   :parent :assoc
   :args {:map :_threads-section :key "os" :value :os-info}}

  {:name :current-time-ms
   :args {}
   :return-type :int}

  ;; Read environment variable
  {:name :env
   :args {:name :text}
   :return-type :text}

  ;; Construct an ExceptionInfo. Paired with :throw to raise from
  ;; graph code; also usable as a plain value if something wants a
  ;; ready-made exception without raising.
  {:name :ex-info
   :args {:message :text
          :data :jsonb}
   :return-type :any}

  ;; Raise the given exception. :return-type is :any because control
  ;; flow never returns, but the graph-level caller needs a placeholder.
  {:name :throw
   :args {:exception :any}
   :return-type :any}

  ;; `:env-required` is now a fn-def (see below) composing :env with
  ;; :if + :throw + :ex-info — kept here as a forward declaration so
  ;; consumers reading fns.edn see the spec in one place.
  {:name :env-required
   :parent :if
   :args {:test :_env-blank?
          :then :_env-missing-throw
          :else :_env-value}}

  {:name :_env-value
   :parent :env
   :args {:name {:as :name}}}

  {:name :_env-blank?
   :parent :blank?
   :args {:string :_env-value}}

  {:name :_env-missing-message
   :parent :str
   :args {:parts :_env-missing-message-parts}}

  {:name :_env-missing-message-parts
   :parent :list
   :args {:items [{:value "Required env var "}
                  :_env-name-as-string
                  {:value " is not set"}]}}

  {:name :_env-name-as-string
   :parent :identity
   :args {:value {:as :name}}}

  {:name :_env-missing-error
   :parent :ex-info
   :args {:message :_env-missing-message
          :data {"type" "execution-error/missing-env-var"}}}

  {:name :_env-missing-throw
   :parent :throw
   :args {:exception :_env-missing-error}}

  ;; Look up a classpath resource and slurp it. Returns nil if missing.
  {:name :read-resource-or-nil
   :args {:path :text}
   :return-type :text}

  ;; Read file from classpath resources, or throw with a clear message
  ;; if the path doesn't resolve. fn-def composition on top of
  ;; `:read-resource-or-nil` + `:if` + `:throw` + `:ex-info`.
  {:name :read-resource
   :parent :if
   :args {:test :_resource-nil?
          :then :_resource-not-found-throw
          :else :_resource-or-nil}}

  {:name :_resource-or-nil
   :parent :read-resource-or-nil
   :args {:path {:as :path}}}

  {:name :_resource-nil?
   :parent :nil?
   :args {:value :_resource-or-nil}}

  {:name :_resource-not-found-message
   :parent :str
   :args {:parts :_resource-not-found-parts}}

  {:name :_resource-not-found-parts
   :parent :list
   :args {:items [{:value "Resource not found: "}
                  :_resource-path-echo]}}

  {:name :_resource-path-echo
   :parent :identity
   :args {:value {:as :path}}}

  {:name :_resource-not-found-error
   :parent :ex-info
   :args {:message :_resource-not-found-message
          :data {"type" "execution-error/resource-not-found"}}}

  {:name :_resource-not-found-throw
   :parent :throw
   :args {:exception :_resource-not-found-error}}

  ;; Load multiple resource files and concatenate with separator.
  ;; Pure composition over `:map :read-resource` + `:str-join`.
  {:name :concat-resources
   :parent :str-join
   :args {:coll :_concat-resources-list
          :separator {:type :text :value "\n\n"}}}

  {:name :_concat-resources-list
   :parent :map
   :args {:func :read-resource
          :coll {:as :paths}}}

  ;; Invoke a value (that happens to be a Clojure fn) with one arg.
  ;; `:func :any` — the value is deref'd and used as-is. Use this when
  ;; :func is a fn-graph that PRODUCES a callable (e.g. :_router
  ;; returns a reitit ring-handler).
  {:name :invoke
   :args {:func :any, :arg :any}
   :return-type :any}

  ;; Call a fn-graph-as-callable with one arg. `:func :fn` — the ref is
  ;; hof-wrap'd into a callable (the fn-graph's leftover free-arg
  ;; receives :arg). Use this when :func is a fn-graph that IS a
  ;; callable (Ring-handler-shaped: has `:request` or similar free arg,
  ;; returns a response).
  {:name :call
   :args {:func :fn, :arg :any}
   :return-type :any}

  ;; Read an InputStream/Reader to string
  {:name :slurp
   :args {:input :any}
   :return-type :text}]}
