;; Storage CRUD base functions for web UI.
;; Impls that need storage access read it from `ctx` in their body
;; (see resources/packages/web/crud/impls.clj).


{:namespace "web.crud"
 :description "Storage CRUD primitives for the web UI — query/render/dispatch entity create/update/delete via context-aware impls."
 :fns
 [;; Query functions (context-aware)
  {:name :list-entities
   :description "Query a list of entities of a given type, optionally filtered by `:where`. Reads through the storage attached to the executor context."
   :args {:entity-type {:type :text :description "Entity-name keyword as string (e.g. \"fn\", \"arg\", \"ns\")."}
          :where {:type :jsonb :required false :description "Storage filter map. Omit to fetch all of the type."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :get-entity
   :description "Look up a single entity by id."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :id {:type :uuid :description "Entity UUID."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :create-entity
   :description "Insert a new entity row from `:data`. The id is generated by storage if absent."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :data {:type :jsonb :description "Field map for the new row."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :update-entity
   :description "Update an existing entity by id with `:data` (sparse — only fields present in `:data` change)."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :id {:type :uuid :description "Entity UUID to update."}
          :data {:type :jsonb :description "Sparse field map of changes."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :delete-entity
   :description "Delete an entity by id. With versioned storage this is a soft-delete; the base row persists."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :id {:type :uuid :description "Entity UUID to delete."}}
   :return-type :bool
   :effects #{:db}}

  {:name :list-all-graph-entities
   :description "Dump every fn, arg, and namespace currently in storage — the payload behind `/api/graph/entities`."
   :args {}
   :return-type :jsonb
   :effects #{:db}}

  {:name :all-rich-types
   :description "Snapshot of the in-memory rich-type registry. Returns `{fn-name {:return type :args {arg-name type}}}` for every base-fn AND composed fn-def the type-checker has processed. Powers `/api/types` — editor and external tools use this to know what each slot accepts."
   :args {}
   :return-type :jsonb
   :effects #{:db}}

  {:name :types-compatible
   :description "Phase 1 type-API: subtype check between an `expected` (slot-side) and `candidate` (binding-side) type. POST body `{expected, candidate}` in the JSON shape produced by `/api/types`. Returns `{ok :bool, expected, candidate, reason?}`. The editor's fn-picker / mismatch explainers call this instead of duplicating `subtype?` logic in JS."
   :args {:request {:type :ring-request-shape :description "Internal Ring request — body parsed into `{expected, candidate}` types."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :types-candidates
   :description "Phase 1 type-API: enumerate fns whose return type is a subtype of `expected`. POST body `{expected, effects?, name-prefix?}` — optional filters narrow by allowed-effect set or namespace / name prefix. Returns `{count, candidates: [{name, return, args, effects}, ...]}` sorted alphabetically. Powers type-aware fn-pickers."
   :args {:request {:type :ring-request-shape :description "Internal Ring request — body parsed into `{expected, effects?, name-prefix?}`."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :types-usages
   :description "Find every fn that references a given type-row. POST body `{type-fn-id}`. Returns `{count, usages: [{fn-id, fn-name, role, kind, slot-name?}, ...]}` where `kind ∈ {:base-of :element-of :return-of :slot-of :binding-of :union-branch :variant-branch}`. Used by the editor's inline-expand panel to surface a 'Used by N' footer for navigation from a type-row back to its callers."
   :args {:request {:type :ring-request-shape :description "Internal Ring request — body parsed into `{type-fn-id}`."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :process-create-record-type
   :description "Atomically create a record type-row: 1 fn-row + N slot-rows + N fn-slot-junctions. JSON body `{namespace-id?, name, description?, fields: [{name, type, description?, required?}, …]}`. Returns `{ok, id, name}` on success or `{error}` with HTTP 400/500."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :process-create-list-type
   :description "Atomically create a list type-row: 1 fn-row with `element-fn-id` + synthesised `items` slot. JSON body `{namespace-id?, name, description?, element-type}`."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :process-update-record-type
   :description "Atomic compound update: diff incoming `{id, name?, description?, fields:[…]}` against the record's current fn-slots, create new slots for added/retyped fields, drop fn-slots for removed fields, re-sequence positions, optionally rename / re-describe the fn-row. Returns `{ok, id, name}` or `{error}`. Caveat: orphaned slots are NOT garbage-collected (slot rows are shared across fns)."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :jsonb
   :effects #{:db}}

  ;; Action functions (context-aware, return {:status :headers :body} response map)
  {:name :process-create-entity
   :description "Parse a Ring request, create the entity it carries, return a partial Ring response (`{:status :headers :body}`) for the caller to wrap."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :process-update-entity
   :description "Parse a Ring request, update the entity it identifies (PUT /api/entities/:type/:id), return a partial Ring response."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :process-delete-entity
   :description "Parse a Ring request, delete the entity it identifies, return a partial Ring response."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :jsonb
   :effects #{:db}}

  ;; Sequence operations: append/remove items of a sequence arg on any fn
  ;; that has a `:sequence`-typed anchor (e.g. :list, :pairs->map children).
  {:name :process-sequence-append
   :description "Append an item to a `:sequence`-typed arg on the fn identified by the request. Returns a partial Ring response."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :process-sequence-remove
   :description "Remove an item from a `:sequence`-typed arg by item id. Returns a partial Ring response."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :process-sequence-update
   :description "Update an existing `:sequence`-arg item by item id (PUT /api/sequence/item/:item-id) — replaces its `:value` or `:ref-fn-id`. Returns a partial Ring response."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :process-tighten-binding-effects
   :description "POST /api/bindings/:binding-id/tighten-fn-effects — narrow an fn-typed binding's effective type to a 4-arity `[:fn args ret #{eff-set}]`. Body: `{effects: [\"db\", \"io\", …]}`. Creates / dedupes the anonymous fn-row carrying the new constraint and writes the binding's `:type-override-fn-id`."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map."}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :parse-form-body
   :description "Parse an `application/x-www-form-urlencoded` request body into a `{key value}` map."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map (uses its `:body`)."}}
   :return-type :jsonb}

  {:name :parse-json-body
   :description "Parse a JSON request body into a Clojure value (keywordizing string keys)."
   :args {:request {:type :ring-request-shape :description "Internal Ring request map (uses its `:body`)."}}
   :return-type :jsonb}

  {:name :str-to-uuid
   :description "Coerce a string to `java.util.UUID`. Throws on malformed input."
   :args {:string {:type :text :description "UUID in canonical 8-4-4-4-12 form."}}
   :return-type :uuid}

  ;; Render functions (context-aware, return hiccup)
  {:name :render-entity-details-view
   :description "Build the hiccup tree for the entity-details panel (right-side view). Read-only."
   :args {:request {:type :ring-request-shape :description "Internal Ring request — path params identify the entity."}}
   :return-type :jsonb}

  {:name :render-entity-form-view
   :description "Build the hiccup tree for the entity create/edit form. Path determines create-vs-edit."
   :args {:request {:type :ring-request-shape :description "Internal Ring request — path params identify the entity (for edit)."}}
   :return-type :jsonb}

  ;; Renders action buttons (Edit/Delete) for entity
  {:name :render-entity-actions
   :description "Hiccup snippet with Edit/Delete buttons for the given entity."
   :args {:entity-type {:type :text :description "Entity-name keyword as string."}
          :entity-id {:type :text :description "Entity id (already string-coerced)."}}
   :return-type :jsonb}

  ;; Form data parsing helpers
  {:name :parse-fn-from-form
   :description "Extract a fn entity's field map from a parsed form-data map."
   :args {:form-data {:type :jsonb :description "`{key value}` map from `parse-form-body`."}}
   :return-type :jsonb}

  {:name :parse-ns-from-form
   :description "Extract a namespace entity's field map from a parsed form-data map. `:name` (string) is required; `:parent-id` and `:description` are optional. The form is the body of `POST /api/entities/ns` from the editor's `+` menu."
   :args {:form-data {:type :jsonb :description "`{key value}` map from `parse-form-body`."}}
   :return-type :jsonb}

  {:name :parse-slot-from-form
   :description "Extract a slot entity's field map from a parsed form-data map. `:name` (string) is required on create; `:type-fn-id` (UUID), `:description`, `:required` are optional."
   :args {:form-data {:type :jsonb :description "`{key value}` map from `parse-form-body`."}}
   :return-type :jsonb}

  {:name :parse-fn-slot-from-form
   :description "Extract a fn-slot junction's field map. `:fn-id` and `:slot-id` (UUIDs) are required; `:position` (int) is optional and defaults to 0."
   :args {:form-data {:type :jsonb :description "`{key value}` map from `parse-form-body`."}}
   :return-type :jsonb}

  {:name :parse-binding-from-form
   :description "Extract a binding entity's field map. `:fn-id` and `:slot-id` (UUIDs) identify the slot being bound. Optional fields: `:value` (JSON literal), `:ref-fn-id` (UUID), `:rename-to` (string), `:type-override-fn-id` (UUID), `:description`, `:terminal`/`:list-append`/`:list-closed` (bool), `:override-kind` (`:fixed` / `:default`). Empty form values clear the corresponding column."
   :args {:form-data {:type :jsonb :description "`{key value}` map from `parse-form-body`."}}
   :return-type :jsonb}

  {:name :parse-binding-list-item-from-form
   :description "Extract a binding-list-item field map. `:binding-id` (UUID) and `:position` (int) are required for create. The item carries either a `:value` (JSON literal) or a `:ref-fn-id` (UUID), plus an optional `:literal` boolean (true marks a keyword literal)."
   :args {:form-data {:type :jsonb :description "`{key value}` map from `parse-form-body`."}}
   :return-type :jsonb}

  ;; =============================================================================
  ;; FN-DEFS: Constants and composed functions
  ;; =============================================================================

  ;; Field specs for fn entity details
  {:name :fn-field-specs
   :description "Field-row specs for rendering a fn entity's details. Each spec is `[label key & formatter]`."
   :parent :const
   :args {:value [["ID" :id]
                  ["Name" :name :keyword-to-str]
                  ["Parent ID" :parent-id]
                  ["Return Type" :return-type :keyword-to-str]
                  ["Impl Hash" :impl-hash]]}}

  ;; Render fn details using entity-field-rows
  {:name :render-fn-details
   :description "Render the fn-entity details panel — `:entity-field-rows` driven by `:fn-field-specs`."
   :parent :entity-field-rows
   :args {:field-specs :fn-field-specs
          :entity {:as :entity}}}

  ;; =============================================================================
  ;; FN-DEFS: Response handlers composed from base functions
  ;;
  ;; Handlers are fn-graphs. At the route binding (:assoc-handler.value
  ;; → :fn-typed via :assoc-fn) the compiler hof-wrap's them into Ring
  ;; callables. Free arg `:request` propagates from inner refs (those
  ;; whose primary `:request` arg isn't bound here) up through the
  ;; chain; hof-wrap turns the leftover into a single-arg callable.
  ;; =============================================================================

  ;; --- Data handlers: data-fn -> body-fn -> response wrapper ---

  {:name :all-entities-handler
   :description "Ring handler that returns the full graph dump as JSON. Bound by `app.routes.api-entities`."
   :parent :json-ok-response
   :args {:body :_all-entities-body}}

  {:name :_all-entities-body
   :parent :to-json-string
   :args {:data :list-all-graph-entities}}

  {:name :all-rich-types-handler
   :description "Ring handler for `GET /api/types` — returns the rich-type registry as JSON. Editor / external tools use it to know each slot's expected type without having to re-derive from EDN."
   :parent :json-ok-response
   :args {:body :_all-rich-types-body}}

  {:name :_all-rich-types-body
   :parent :to-json-string
   :args {:data :all-rich-types}}

  {:name :types-compatible-handler
   :description "Ring handler for `POST /api/types/compatible` — wraps `:types-compatible` in a JSON 200 response."
   :parent :json-ok-response
   :args {:body :_types-compatible-body}}

  {:name :_types-compatible-body
   :parent :to-json-string
   :args {:data :types-compatible}}

  {:name :types-candidates-handler
   :description "Ring handler for `POST /api/types/candidates` — wraps `:types-candidates` in a JSON 200 response."
   :parent :json-ok-response
   :args {:body :_types-candidates-body}}

  {:name :_types-candidates-body
   :parent :to-json-string
   :args {:data :types-candidates}}

  {:name :types-usages-handler
   :description "Ring handler for `POST /api/types/usages` — wraps `:types-usages` in a JSON 200 response."
   :parent :json-ok-response
   :args {:body :_types-usages-body}}

  {:name :_types-usages-body
   :parent :to-json-string
   :args {:data :types-usages}}

  {:name :types-create-record-handler
   :description "Ring handler for `POST /api/types/record` — atomic compound create for a record type-row. Wraps `process-create-record-type` in a JSON 200 response (the {:ok false :error} payload itself carries any error)."
   :parent :json-ok-response
   :args {:body :_types-create-record-body}}

  {:name :_types-create-record-body
   :parent :to-json-string
   :args {:data :process-create-record-type}}

  {:name :types-create-list-handler
   :description "Ring handler for `POST /api/types/list` — atomic compound create for a list type-row."
   :parent :json-ok-response
   :args {:body :_types-create-list-body}}

  {:name :_types-create-list-body
   :parent :to-json-string
   :args {:data :process-create-list-type}}

  {:name :types-update-record-handler
   :description "Ring handler for `PUT /api/types/record` — atomic compound update for a record type-row. Wraps `process-update-record-type` in a JSON 200 response (the {:ok false :error} payload carries failures)."
   :parent :json-ok-response
   :args {:body :_types-update-record-body}}

  {:name :_types-update-record-body
   :parent :to-json-string
   :args {:data :process-update-record-type}}

  ;; Template for HTML-rendering Ring handlers. Free arg `:hiccup`
  ;; propagates up from the body fn-def's `:render-hiccup`-typed slot,
  ;; so concrete handlers below set `:hiccup :render-…-view` directly
  ;; instead of each defining its own private `_*-body` fn-def.
  {:name :hiccup-handler
   :description "Template Ring handler — renders a hiccup tree (free arg `:hiccup`) and returns it as a 200 OK with `text/html` content-type."
   :parent :html-ok-response
   :args {:body :_hiccup-handler-body}}

  {:name :_hiccup-handler-body
   :parent :render-hiccup}

  {:name :entity-details-handler
   :description "Ring handler that returns the entity-details HTML partial. Bound by `app.routes.entity-details`."
   :parent :hiccup-handler
   :args {:hiccup :render-entity-details-view}}

  {:name :entity-form-create-handler
   :description "Ring handler that returns the create-form HTML partial. Bound by `app.routes.entity-form-create`."
   :parent :hiccup-handler
   :args {:hiccup :render-entity-form-view}}

  {:name :entity-form-edit-handler
   :description "Ring handler that returns the edit-form HTML partial. Bound by `app.routes.entity-form-edit`."
   :parent :hiccup-handler
   :args {:hiccup :render-entity-form-view}}

  ;; --- Action handlers: action-fn returns partial response, defaults
  ;; (status 200, body "", html headers) supplied by composition. ---

  {:name :_html-action-base-headers
   :parent :const
   :args {:value {"Content-Type" "text/html; charset=utf-8"}}}

  {:name :_action-status
   :parent :get
   :args {:coll {:as :result} :key {:value :status} :default 200}}

  {:name :_action-body
   :parent :get
   :args {:coll {:as :result} :key {:value :body} :default ""}}

  {:name :_action-headers-raw
   :parent :get
   :args {:coll {:as :result} :key {:value :headers} :default {}}}

  {:name :_action-headers
   :parent :merge
   :args {:maps [:_html-action-base-headers :_action-headers-raw]}}

  {:name :html-action-response
   :description "Wrap a partial action response (`{:status :headers :body}` from a `process-*` fn) into a full Ring response, defaulting status=200, body=\"\", and html content-type."
   :parent :ring-response
   :args {:status :_action-status
          :headers :_action-headers
          :body :_action-body}}

  {:name :create-entity-handler
   :description "Ring handler for `POST /api/entities/:type` — runs `process-create-entity` and wraps the result via `html-action-response`."
   :parent :html-action-response
   :args {:result :process-create-entity}}

  {:name :update-entity-handler
   :description "Ring handler for `PUT /api/entities/:type/:id` — runs `process-update-entity` and wraps the result via `html-action-response`."
   :parent :html-action-response
   :args {:result :process-update-entity}}

  {:name :delete-entity-handler
   :description "Ring handler for `DELETE /api/entities/:type/:id` — runs `process-delete-entity` and wraps the result via `html-action-response`."
   :parent :html-action-response
   :args {:result :process-delete-entity}}

  {:name :sequence-append-handler
   :description "Ring handler for `POST /api/sequence/append/:fn-id` — appends an item to the named sequence-arg."
   :parent :html-action-response
   :args {:result :process-sequence-append}}

  {:name :sequence-remove-handler
   :description "Ring handler for `DELETE /api/sequence/item/:item-id` — removes an item from its sequence-arg."
   :parent :html-action-response
   :args {:result :process-sequence-remove}}

  {:name :sequence-update-handler
   :description "Ring handler for `PUT /api/sequence/item/:item-id` — replaces an item's value/ref."
   :parent :html-action-response
   :args {:result :process-sequence-update}}

  {:name :tighten-binding-effects-handler
   :description "Ring handler for `POST /api/bindings/:binding-id/tighten-fn-effects` — narrow an fn-typed binding's effective type."
   :parent :html-action-response
   :args {:result :process-tighten-binding-effects}}]}
