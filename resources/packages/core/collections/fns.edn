;; Collection manipulation base functions
;; first, rest, cons, conj, get, assoc, dissoc, count, empty?,
;; contains?, keys, vals, merge, into, range, repeat, take, drop,
;; reverse, sort, concat, flatten, distinct


{:namespace "core.collections"
 :fns
 [{:name :first
   :args {:coll :jsonb}
   :return-type :any}

  {:name :rest
   :args {:coll :jsonb}
   :return-type :jsonb}

  {:name :cons
   :args {:item :any, :coll :jsonb}
   :return-type :jsonb}

  ;; First-class list primitive. :items is a sequence-arg; items live in
  ;; linked arg entities chained via arg.next_arg_id.
  {:name :list
   :args {:items {:type :sequence :of :any}}
   :return-type :jsonb}

  ;; Converts a list of 2-element pairs into a map. :entries is a sequence-arg
  ;; where each item is either a :pair fn-def result or a literal [k v] vector.
  {:name :pairs->map
   :args {:entries {:type :sequence :of :any}}
   :return-type :jsonb}

  {:name :conj
   :args {:coll :any, :item :any}
   :return-type :any}

  {:name :get
   :args {:coll :jsonb
          :key :any
          :default {:type :any :required false}}
   :return-type :any}

  {:name :get-in
   :args {:map :jsonb
          :path :jsonb
          :default {:type :any :required false}}
   :return-type :any}

  {:name :assoc
   :args {:map :any, :key :any, :value :any}
   :return-type :any}

  ;; Same as `:assoc` but the `:value` slot is `:fn`-typed — the bound
  ;; ref is hof-wrap'd into a callable instead of being executed and
  ;; merged as a value. Used for routes where the assoc'd value must
  ;; remain a Ring callable (handler).
  {:name :assoc-fn
   :parent :assoc
   :args {:value {:as :value :type :fn}}}

  {:name :dissoc
   :args {:map :jsonb, :key :any}
   :return-type :jsonb}

  {:name :count
   :args {:coll :jsonb}
   :return-type :int}

  {:name :empty?
   :args {:coll :jsonb}
   :return-type :bool}

  {:name :contains?
   :args {:coll :jsonb, :key :any}
   :return-type :bool}

  {:name :keys
   :args {:map :jsonb}
   :return-type :jsonb}

  {:name :vals
   :args {:map :jsonb}
   :return-type :jsonb}

  ;; `(apply merge maps)` — variadic merge like Clojure's. `:maps` is a
  ;; sequence-arg so callers can inline refs: `{:maps [:a-ref :b-ref]}`.
  {:name :merge
   :args {:maps {:type :sequence :of :any}}
   :return-type :jsonb}

  {:name :into
   :args {:to :jsonb, :from :jsonb}
   :return-type :jsonb}

  {:name :assoc-in
   :args {:m :any
          :path :jsonb
          :v :any}
   :return-type :any}

  ;; (update-in m path f) — apply `f` to value at path. `:f` is `:fn`-typed
  ;; so the bound fn-graph is hof-wrap'd; when caller binds `:defaults`
  ;; (or any other captured name), hof-wrap's call-time dispatch picks
  ;; the per-call lambda param dynamically (single non-map arg → bind to
  ;; the only leftover; map arg whose keys match all hof-free → merge).
  {:name :update-in
   :args {:m :any
          :path :jsonb
          :f :fn}
   :return-type :any}

  {:name :range
   :args {:start {:type :int :value 0}
          :end :int
          :step {:type :int :value 1}}
   :return-type :jsonb}

  {:name :repeat
   :args {:count :int, :item :any}
   :return-type :jsonb}

  {:name :take
   :args {:count :int, :coll :jsonb}
   :return-type :jsonb}

  {:name :drop
   :args {:count :int, :coll :jsonb}
   :return-type :jsonb}

  {:name :reverse
   :args {:coll :jsonb}
   :return-type :jsonb}

  {:name :sort
   :args {:coll :jsonb}
   :return-type :jsonb}

  {:name :concat
   :args {:colls :jsonb}
   :return-type :jsonb}

  {:name :flatten
   :args {:coll :jsonb}
   :return-type :jsonb}

  {:name :distinct
   :args {:coll :jsonb}
   :return-type :jsonb}

  {:name :stringify-map-keys
   :args {:m :jsonb}
   :return-type :jsonb}

  {:name :keywordize-map-keys
   :args {:m :any}
   :return-type :any}

  {:name :select-keys
   :args {:m :any, :ks :jsonb}
   :return-type :any}

  {:name :zipmap
   :args {:keys :jsonb, :vals :jsonb}
   :return-type :any}

  {:name :update-vals
   :args {:m :any, :f :fn}
   :return-type :any}

  ;; (update-in m path #(merge defaults %)) — Clojure-style closure.
  ;; `:defaults` is captured from caller's outer scope: callers bind it
  ;; via merge-in's primary-binding propagation (router-ring-response
  ;; sets `:defaults :default-security-headers`), which lands in
  ;; outer-free-args at the `:f` hof-wrap site. `:existing` is the
  ;; lambda's per-call param; update-in's impl calls `(f existing-val)`,
  ;; and hof-wrap's call-time dispatch routes the single non-map arg to
  ;; the only leftover name (= `:existing` after subtracting the captured
  ;; `:defaults`).
  {:name :merge-in
   :parent :update-in
   :args {:m {:as :m}
          :path {:as :path}
          :f :_merge-in-fn}}

  {:name :_merge-in-fn
   :parent :merge
   :args {:maps [:_merge-in-defaults-arg :_merge-in-existing-arg]}}

  {:name :_merge-in-defaults-arg
   :parent :identity
   :args {:value {:as :defaults}}}

  {:name :_merge-in-existing-arg
   :parent :identity
   :args {:value {:as :existing}}}]}
