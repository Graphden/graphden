;; Platform provisioning routes (PLATFORM_PLAN §3.4) — operator-only org /
;; token / domain registration + set-org-handler. Migrated out of core
;; `app/admin` into this addon-only package (route-collection seam §6). All
;; platform-only: the entities (:org/:token/:domain) are tenant-forbidden, so a
;; tenant POST is denied by OrgScoped. Compiled into `:tenancy-router` (see the
;; `router` module); NOT in core `:all`. Not referenced by editor JS.

{:namespace "tenancy-admin.registration"
 :description "Operator-only org / token / domain registration + set-org-handler routes."
 :fns
 [;; ---------------------------------------------------------------------
  ;; ORG REGISTRATION (§3.4 step 2) — POST /api/orgs. Platform-only: a
  ;; tenant POST is rejected by OrgScoped (`:org` is tenant-forbidden), so
  ;; only the operator (public org) registers orgs. The org `name` IS the
  ;; subdomain (identity resolver), so registration = creating the row.
  ;; ---------------------------------------------------------------------
  ;; --- shared: username → stable user id (used by :create-token here and
  ;; :create-grant in the grants module). Authz keys on the id, not the
  ;; mutable username; nil (no such user) → a token/grant that matches no
  ;; user, same non-throwing semantics as before. ---

  {:name :_uid-where
   :parent :assoc-empty
   :args {:key {:value :username} :value {:as :username :type :text}}}

  {:name :_uid-rows
   :parent :query-entities
   :args {:entity-type {:value "user"} :where :_uid-where}}

  {:name :_uid-row
   :parent :first
   :args {:coll :_uid-rows}}

  {:name :_uid-row-nil?
   :parent :nil?
   :args {:value :_uid-row}}

  {:name :_uid-id
   :parent :get
   :args {:coll :_uid-row :key {:value :id}}}

  {:name :_uid-id-text
   :parent :to-str
   :args {:value :_uid-id}}

  {:name :user-id-by-username
   :description "Resolve a username to the user's STABLE id as text — nil when no such user exists. Enforcement matches on the id (survives a username edit / delete-recreate)."
   :parent :if
   :args {:test :_uid-row-nil?
          :then {:value nil}
          :else :_uid-id-text}
   :return-type :nullable-text}

  {:name :_org-create-row
   :parent :assoc-empty
   :args {:key {:value :name} :value {:as :name :type :text}}}

  {:name :create-org
   :description "Register an :org by name (= slug = subdomain). Pure graph composition over `:create-entity`; writes the tenancy addon's :org entity — throws if absent (addon inactive)."
   :parent :create-entity
   :args {:entity-type {:value "org"} :data :_org-create-row}
   :return-type :keyword-map}

  {:name :_org-create-form-data
   :parent :parse-form-body-kw}

  {:name :_org-create-name
   :parent :get
   :args {:coll :_org-create-form-data :key {:value :name} :default {:value ""}}}

  {:name :_org-create-do
   :parent :create-org
   :args {:name :_org-create-name}}

  {:name :_org-create-id
   :parent :get
   :args {:coll :_org-create-do :key {:value :id} :default {:value ""}}}

  {:name :_org-create-id-text
   :parent :to-str
   :args {:value :_org-create-id}}

  {:name :_org-create-handler
   :lambda-params [:request :limit]
   :description "Ring handler for POST /api/orgs — registers the org and returns its new id as text/html."
   :parent :html-ok-response
   :args {:body :_org-create-id-text}}

  {:name :create-org-route
   :description "POST /api/orgs — register an org from a form-encoded body (name). Auth-required; platform-only (tenant writes of :org are denied)."
   :parent :post
   :args {:path "/api/orgs" :handler :_org-create-handler}}

  ;; ---------------------------------------------------------------------
  ;; TOKEN MINTING (§3.4 #1) — POST /api/tokens {token user org}. Mints a
  ;; storage-backed auth token: hashes the bearer (SHA-256), stores only the
  ;; hash. Platform-only (`:token` is tenant-forbidden → a tenant POST is
  ;; denied by OrgScoped). This is what makes onboarding a row insert.
  ;; ---------------------------------------------------------------------
  ;; The stored hash MUST equal `graphden.tenancy.auth/token-hash` (the
  ;; storage-token-provider hashes the same way at read time) — both are
  ;; the same SHA-256-hex derivation; the round-trip is tested in
  ;; `faas-app-test` (route-minted token authenticates via the provider).
  {:name :_token-hash
   :parent :sha256-hex
   :args {:s {:as :token :type :text}}}

  {:name :_token-user-id
   :parent :user-id-by-username
   :args {:username {:as :user :type :text}}}

  {:name :_token-row-w-hash
   :parent :assoc-empty
   :args {:key {:value :token-hash} :value :_token-hash}}

  {:name :_token-row-w-user
   :parent :assoc
   :args {:map :_token-row-w-hash :key {:value :user} :value {:as :user :type :text}}}

  {:name :_token-row-w-uid
   :parent :assoc
   :args {:map :_token-row-w-user :key {:value :user-id} :value :_token-user-id}}

  {:name :_token-row
   :parent :assoc
   :args {:map :_token-row-w-uid :key {:value :org} :value {:as :org :type :text}}}

  {:name :create-token
   :description "Mint a storage-backed auth token — hashes the bearer (`:sha256-hex`, same derivation as `tenancy.auth/token-hash`), resolves the username to its stable id, stores {token-hash, user, user-id, org}. The raw bearer is never persisted. Pure graph composition; writes the tenancy addon's :token entity — throws if absent (addon inactive)."
   :parent :create-entity
   :args {:entity-type {:value "token"} :data :_token-row}
   :return-type :keyword-map}

  {:name :_token-create-form-data
   :parent :parse-form-body-kw}

  {:name :_token-create-token
   :parent :get
   :args {:coll :_token-create-form-data :key {:value :token} :default {:value ""}}}

  {:name :_token-create-user
   :parent :get
   :args {:coll :_token-create-form-data :key {:value :user} :default {:value ""}}}

  {:name :_token-create-org
   :parent :get
   :args {:coll :_token-create-form-data :key {:value :org} :default {:value ""}}}

  {:name :_token-create-do
   :parent :create-token
   :args {:token :_token-create-token
          :user :_token-create-user
          :org :_token-create-org}}

  {:name :_token-create-id
   :parent :get
   :args {:coll :_token-create-do :key {:value :id} :default {:value ""}}}

  {:name :_token-create-id-text
   :parent :to-str
   :args {:value :_token-create-id}}

  {:name :_token-create-handler
   :lambda-params [:request :limit]
   :description "Ring handler for POST /api/tokens — mints the token and returns its new id as text/html."
   :parent :html-ok-response
   :args {:body :_token-create-id-text}}

  {:name :create-token-route
   :description "POST /api/tokens — mint a storage-backed auth token from a form-encoded body (token/user/org). Auth-required; platform-only (tenant writes of :token are denied)."
   :parent :post
   :args {:path "/api/tokens" :handler :_token-create-handler}}

  ;; ---------------------------------------------------------------------
  ;; CUSTOM DOMAIN REGISTRATION (§3.4 #2) — POST /api/domains {hostname org}.
  ;; Registers an UNVERIFIED custom domain; the operator flips :verified?
  ;; (generic CRUD update) after the graphden-verify=<org> DNS-TXT check.
  ;; Platform-only (`:domain` is tenant-forbidden → tenant POST denied).
  ;; ---------------------------------------------------------------------
  ;; `:verified? false` is the register-unverified policy: only verified
  ;; rows route, and verification is a separate operator action (flip via
  ;; generic CRUD update after the DNS-TXT check). Graph-visible so the
  ;; policy is readable; a tenant still can't touch :domain at all
  ;; (entity guard), so exposing it loses no protection.
  {:name :_domain-row-w-host
   :parent :assoc-empty
   :args {:key {:value :hostname} :value {:as :hostname :type :text}}}

  {:name :_domain-row-w-org
   :parent :assoc
   :args {:map :_domain-row-w-host :key {:value :org} :value {:as :org :type :text}}}

  {:name :_domain-row
   :parent :assoc
   :args {:map :_domain-row-w-org :key {:value :verified?} :value {:value false}}}

  {:name :create-domain
   :description "Register a custom domain (UNVERIFIED — `:verified? false` policy is graph-visible) → maps hostname to org once verified. Pure graph composition over `:create-entity`; writes the tenancy addon's :domain entity — throws if absent (addon inactive)."
   :parent :create-entity
   :args {:entity-type {:value "domain"} :data :_domain-row}
   :return-type :keyword-map}

  {:name :_domain-create-form-data
   :parent :parse-form-body-kw}

  {:name :_domain-create-hostname
   :parent :get
   :args {:coll :_domain-create-form-data :key {:value :hostname} :default {:value ""}}}

  {:name :_domain-create-org
   :parent :get
   :args {:coll :_domain-create-form-data :key {:value :org} :default {:value ""}}}

  {:name :_domain-create-do
   :parent :create-domain
   :args {:hostname :_domain-create-hostname
          :org :_domain-create-org}}

  {:name :_domain-create-id
   :parent :get
   :args {:coll :_domain-create-do :key {:value :id} :default {:value ""}}}

  {:name :_domain-create-id-text
   :parent :to-str
   :args {:value :_domain-create-id}}

  {:name :_domain-create-handler
   :lambda-params [:request :limit]
   :description "Ring handler for POST /api/domains — registers the (unverified) domain and returns its new id as text/html."
   :parent :html-ok-response
   :args {:body :_domain-create-id-text}}

  {:name :create-domain-route
   :description "POST /api/domains — register a custom domain from a form-encoded body (hostname/org). Auth-required; platform-only (tenant writes of :domain are denied)."
   :parent :post
   :args {:path "/api/domains" :handler :_domain-create-handler}}

  ;; ---------------------------------------------------------------------
  ;; SET ORG HANDLER (§3.4 step 4a) — POST /api/orgs/handler {name fn-id}.
  ;; Points an org at its app handler fn (the app-router then serves that
  ;; org's subdomain via it). Platform-only (`:org` is tenant-forbidden);
  ;; self-serve (a tenant setting its OWN handler via a validated seam) is
  ;; step 4b on top of this mutation.
  ;; ---------------------------------------------------------------------
  ;; --- shared: org row by (unique) name — nil when absent. Used by both
  ;; :set-org-handler and :set-org-execution-mode. ---

  {:name :_org-where
   :parent :assoc-empty
   :args {:key {:value :name} :value {:as :name :type :text}}}

  {:name :_org-rows-by-name
   :parent :query-entities
   :args {:entity-type {:value "org"} :where :_org-where}}

  {:name :org-by-name
   :description "First :org row matching the (unique) `:name` — nil when no such org."
   :parent :first
   :args {:coll :_org-rows-by-name}
   :return-type :nullable-keyword-map}

  {:name :_org-row-nil?
   :parent :nil?
   :args {:value :org-by-name}}

  {:name :_org-row-id
   :parent :get
   :args {:coll :org-by-name :key {:value :id}}}

  ;; handler-fn-id may arrive as a string (form body) or an already-parsed
  ;; UUID (direct graph caller) — parse only the string case, pass UUIDs
  ;; through, exactly the old `(cond-> v (string? v) parse-uuid)`.
  {:name :_org-handler-fnid-text?
   :parent :is-a?
   :args {:value {:as :handler-fn-id} :type {:value :text}}}

  {:name :_org-handler-fnid-parsed
   :parent :parse-uuid
   :args {:string {:as :handler-fn-id}}}

  {:name :_org-handler-fnid-uuid
   :parent :if
   :args {:test :_org-handler-fnid-text?
          :then :_org-handler-fnid-parsed
          :else {:as :handler-fn-id}}}

  {:name :_org-handler-data
   :parent :assoc-empty
   :args {:key {:value :handler-fn-id} :value :_org-handler-fnid-uuid}}

  {:name :_org-handler-updated
   :parent :update-entity
   :args {:entity-type {:value "org"}
          :id {:ref :_org-row-id :type :uuid}
          :data :_org-handler-data}}

  {:name :set-org-handler
   :description "Set an :org's :handler-fn-id (the app-router executes it for that org's subdomain). Pure graph composition: `:org-by-name` lookup → nil when the org doesn't exist, else `:update-entity`. Writes the tenancy addon's :org entity — throws if absent."
   :parent :if
   :args {:test :_org-row-nil?
          :then {:value nil}
          :else :_org-handler-updated}
   :return-type :nullable-keyword-map}

  {:name :_org-handler-form-data
   :parent :parse-form-body-kw}

  {:name :_org-handler-name
   :parent :get
   :args {:coll :_org-handler-form-data :key {:value :name} :default {:value ""}}}

  {:name :_org-handler-fnid
   :parent :get
   :args {:coll :_org-handler-form-data :key {:value :handler-fn-id} :default {:value ""}}}

  {:name :_org-handler-do
   :parent :set-org-handler
   :args {:name :_org-handler-name :handler-fn-id :_org-handler-fnid}}

  {:name :_org-handler-result-text
   :parent :to-str
   :args {:value :_org-handler-do}}

  {:name :_org-handler-handler
   :lambda-params [:default :request :limit]
   :description "Ring handler for POST /api/orgs/handler — sets the org's app handler, returns the updated row as text/html."
   :parent :html-ok-response
   :args {:body :_org-handler-result-text}}

  {:name :set-org-handler-route
   :description "POST /api/orgs/handler — point an org at its app handler (name, handler-fn-id). Auth-required; platform-only."
   :parent :post
   :args {:path "/api/orgs/handler" :handler :_org-handler-handler}}

  ;; ---------------------------------------------------------------------
  ;; SET ORG EXECUTION MODE — POST /api/orgs/execution-mode {name mode}.
  ;; Flips an org between "hosted" and "byo" (docs/SCALING.md § external
  ;; executor). Platform-only (`:org` is tenant-forbidden). Provisioning a
  ;; BYO customer is: create the org, mint its executor token, flip it byo.
  ;; ---------------------------------------------------------------------
  {:name :invalidate-byo-cache
   :description "Drop the byo execution-mode memo for org `:name` so a mode flip takes effect at once instead of within the ~5s TTL. One `tenancy.context` interface call."
   :args {:name {:type :text :description "Org slug."}}
   :return-type :null}

  {:name :_org-mode-data
   :parent :assoc-empty
   :args {:key {:value :execution-mode} :value {:as :execution-mode :type :text}}}

  {:name :_org-mode-updated
   :parent :update-entity
   :args {:entity-type {:value "org"}
          :id {:ref :_org-row-id :type :uuid}
          :data :_org-mode-data}}

  {:name :_org-mode-cache-dropped
   :parent :invalidate-byo-cache
   :args {:name {:as :name :type :text}}}

  ;; update → drop the byo memo → return the updated row. The third step
  ;; re-references the update node; the per-execution result cache returns
  ;; the already-computed row rather than writing twice.
  {:name :_org-mode-applied
   :parent :do
   :args {:steps [:_org-mode-updated :_org-mode-cache-dropped :_org-mode-updated]}}

  {:name :_org-mode-nf-message
   :parent :str
   :args {:parts [{:value "No org named "} {:as :name :type :text}]}}

  {:name :_org-mode-nf-data
   :parent :assoc
   :args {:map {:value {:type :org/not-found}}
          :key {:value :name}
          :value {:as :name :type :text}}}

  {:name :_org-mode-nf-error
   :parent :ex-info
   :args {:message :_org-mode-nf-message :data :_org-mode-nf-data}}

  {:name :_org-mode-throw
   :parent :throw
   :args {:exception :_org-mode-nf-error}}

  {:name :set-org-execution-mode
   :description "Set an :org's :execution-mode (\"hosted\" / \"byo\") and drop the byo memo so the flip is effective immediately. Pure graph composition: `:org-by-name` lookup → throw :org/not-found when absent, else `:update-entity` + `:invalidate-byo-cache`."
   :parent :if
   :args {:test :_org-row-nil?
          :then :_org-mode-throw
          :else :_org-mode-applied}
   :return-type :nullable-keyword-map}

  {:name :_org-mode-form-data
   :parent :parse-form-body-kw}

  {:name :_org-mode-name
   :parent :get
   :args {:coll :_org-mode-form-data :key {:value :name} :default {:value ""}}}

  {:name :_org-mode-value
   :parent :get
   :args {:coll :_org-mode-form-data :key {:value :execution-mode} :default {:value ""}}}

  {:name :_org-mode-do
   :parent :set-org-execution-mode
   :args {:name :_org-mode-name :execution-mode :_org-mode-value}}

  {:name :_org-mode-result-text
   :parent :to-str
   :args {:value :_org-mode-do}}

  {:name :_org-mode-handler
   :lambda-params [:default :request :limit]
   :description "Ring handler for POST /api/orgs/execution-mode — flips the org's execution mode, returns the updated row as text/html."
   :parent :html-ok-response
   :args {:body :_org-mode-result-text}}

  {:name :set-org-execution-mode-route
   :description "POST /api/orgs/execution-mode — flip an org between hosted and byo (name, execution-mode). Auth-required; platform-only."
   :parent :post
   :args {:path "/api/orgs/execution-mode" :handler :_org-mode-handler}}

  ;; ---------------------------------------------------------------------
  ;; SET ORG PLAN / KILL-SWITCH — POST /api/orgs/plan {name plan}. Sets an
  ;; org's :plan tier (free / network / dedicated / suspended). "suspended"
  ;; is the abuse FREEZE: `tenancy.plan/plans` gives it no effects and all
  ;; row-caps 0, so a suspended tenant can neither run nor create anything;
  ;; restore by setting its real tier back. Also serves the legit upgrade /
  ;; downgrade path (the earlier no-self-serve-upgrade gap). Platform-only
  ;; (`:org` is tenant-forbidden). The slug is validated against the real
  ;; plans map FIRST (throw :plan/unknown on a typo — a mistyped slug must
  ;; not silently resolve to free and un-suspend an abuser). Reuses the
  ;; shared :org-by-name / :_org-row-nil? / :_org-row-id nodes.
  ;; ---------------------------------------------------------------------
  {:name :known-plan-slug?
   :description "True when the text names a real plan tier (checked against `tenancy.plan/plans`, the single source of truth — a typo can't silently resolve to the free default)."
   :args {:slug {:type :text :description "Candidate plan slug (free / network / dedicated / suspended)."}}
   :return-type :bool}

  {:name :_org-plan-valid?
   :parent :known-plan-slug?
   :args {:slug {:as :plan :type :text}}}

  {:name :_org-plan-data
   :parent :assoc-empty
   :args {:key {:value :plan} :value {:as :plan :type :text}}}

  {:name :_org-plan-updated
   :parent :update-entity
   :args {:entity-type {:value "org"}
          :id {:ref :_org-row-id :type :uuid}
          :data :_org-plan-data}}

  ;; org absent → throw :org/not-found (mirrors set-org-execution-mode).
  {:name :_org-plan-nf-message
   :parent :str
   :args {:parts [{:value "No org named "} {:as :name :type :text}]}}

  {:name :_org-plan-nf-data
   :parent :assoc
   :args {:map {:value {:type :org/not-found}}
          :key {:value :name}
          :value {:as :name :type :text}}}

  {:name :_org-plan-nf-error
   :parent :ex-info
   :args {:message :_org-plan-nf-message :data :_org-plan-nf-data}}

  {:name :_org-plan-nf-throw
   :parent :throw
   :args {:exception :_org-plan-nf-error}}

  ;; unknown slug → throw :plan/unknown (fail closed — no silent free-drop).
  {:name :_org-plan-unknown-message
   :parent :str
   :args {:parts [{:value "Unknown plan tier: "} {:as :plan :type :text}]}}

  {:name :_org-plan-unknown-data
   :parent :assoc
   :args {:map {:value {:type :plan/unknown}}
          :key {:value :plan}
          :value {:as :plan :type :text}}}

  {:name :_org-plan-unknown-error
   :parent :ex-info
   :args {:message :_org-plan-unknown-message :data :_org-plan-unknown-data}}

  {:name :_org-plan-unknown-throw
   :parent :throw
   :args {:exception :_org-plan-unknown-error}}

  {:name :_org-plan-apply-or-nf
   :parent :if
   :args {:test :_org-row-nil?
          :then :_org-plan-nf-throw
          :else :_org-plan-updated}}

  {:name :set-org-plan
   :description "Set an :org's :plan tier (free / network / dedicated / suspended). \"suspended\" is the abuse kill-switch (no effects, all row-caps 0). Validates the slug against `tenancy.plan/plans` FIRST (throw :plan/unknown on a typo — no silent free-drop), then `:org-by-name` → throw :org/not-found when absent, else `:update-entity`. Platform-only; writes the tenant-forbidden :org entity."
   :parent :if
   :args {:test :_org-plan-valid?
          :then :_org-plan-apply-or-nf
          :else :_org-plan-unknown-throw}
   :return-type :nullable-keyword-map}

  {:name :_org-plan-form-data
   :parent :parse-form-body-kw}

  {:name :_org-plan-name
   :parent :get
   :args {:coll :_org-plan-form-data :key {:value :name} :default {:value ""}}}

  {:name :_org-plan-value
   :parent :get
   :args {:coll :_org-plan-form-data :key {:value :plan} :default {:value ""}}}

  {:name :_org-plan-do
   :parent :set-org-plan
   :args {:name :_org-plan-name :plan :_org-plan-value}}

  {:name :_org-plan-result-text
   :parent :to-str
   :args {:value :_org-plan-do}}

  {:name :_org-plan-handler
   :lambda-params [:default :request :limit]
   :description "Ring handler for POST /api/orgs/plan — sets the org's plan tier, returns the updated row as text/html."
   :parent :html-ok-response
   :args {:body :_org-plan-result-text}}

  {:name :set-org-plan-route
   :description "POST /api/orgs/plan — set an org's plan tier (name, plan); \"suspended\" freezes an abusive tenant, the others upgrade / downgrade. Auth-required; platform-only."
   :parent :post
   :args {:path "/api/orgs/plan" :handler :_org-plan-handler}}

  ;; ---------------------------------------------------------------------
  ;; QUOTA USAGE (task #8-frontend) — GET /api/orgs/quota returns the
  ;; CURRENT org's plan usage vs ceilings, for the editor's proactive
  ;; "N / cap fns" display. Reads the read-side seam installed by
  ;; `tenancy.plan/install!`; the handler is org-scoped by `current-org`
  ;; (like `:list-users`), so it is not a boot-baked constant. nil body
  ;; outside tenancy / for the public org.
  ;; ---------------------------------------------------------------------
  {:name :tenant-quota-status
   :description "Current org's plan usage vs ceilings — `{:plan :fns {:used :max} :list-items {:used :max}}`, or nil outside tenancy. Reads the installed `tenancy.storage/quota-status-fn` seam for current-org."
   :args {}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :_quota-status
   :parent :tenant-quota-status}

  {:name :_quota-status-json
   :parent :to-json-string
   :args {:data :_quota-status}}

  {:name :_quota-handler
   :description "Ring handler for GET /api/orgs/quota — the current org's plan usage as JSON."
   :parent :json-ok-response
   :args {:body :_quota-status-json}}

  {:name :quota-route
   :description "GET /api/orgs/quota — the current org's plan usage (fns / list-items used vs cap). Auth-required; org-scoped by current-org."
   :parent :get-auth-required
   :args {:path "/api/orgs/quota" :handler :_quota-handler}}

  ;; ---------------------------------------------------------------------
  ;; TENANT SERVICES (task #6 part 4 / FLEET_RFC §7.1) — a DEDICATED-tier
  ;; org creates + lists its own persistent services. `:service` is
  ;; tenant-forbidden (Option B), so both go through the base-storage seams
  ;; installed by `tenancy.plan/install!`; the create seam gates on the
  ;; dedicated tier + `:max-services` cap and stamps `:org-id`, the list seam
  ;; filters by `:org-id`. Org-scoped by current-org (not boot-baked).
  ;; ---------------------------------------------------------------------
  {:name :tenant-list-services
   :description "The current org's own :service rows (filtered by :org-id) via the installed `tenancy.storage/list-tenant-services-fn` seam. nil outside tenancy / for the public org."
   :args {}
