;; Org-admin Users panel (PLATFORM_PLAN §4.1) — migrated out of core
;; `app/admin` into this addon-only package as part of the route-collection
;; seam (§6). The route is compiled into `:tenancy-router` (see the `router`
;; module) and installed into the tenancy-routing singleton at boot; it is NOT
;; in core `:all`. Mirrors the grants panel — reuses its CSS classes.
;;
;; `:list-users` strips `:password-hash` at the boundary so hashes never reach
;; the wire. `:invoke-create-user` calls the addon's `:user-ops` seam (bcrypt);
;; both read the addon's `:user` entity, so they throw when the addon is
;; inactive — but this package only loads WITH the addon, so the `:try` below
;; is belt-and-suspenders. `:user` is tenant-forbidden, so a tenant POST is
;; denied by OrgScoped; this is operator-only.

{:namespace "tenancy-admin.users"
 :description "Org-admin users panel + create route, served via the tenancy route-collection seam."
 :fns
 [{:name :list-users
   :description "All :user rows WITHOUT password hashes (:username :org :id). Reads the tenancy addon's :user entity; throws if absent (addon inactive), so callers guard with :try."
   :args {}
   :return-type [:list :keyword-map]
   :effects #{:db}}

  {:name :_users-th-username
   :parent :hiccup
   :args {:tag {:value "th"} :children [{:value "Username"}]}}

  {:name :_users-th-org
   :parent :hiccup
   :args {:tag {:value "th"} :children [{:value "Org"}]}}

  {:name :_users-th-actions
   :parent :hiccup
   :args {:tag {:value "th"} :children [{:value ""}]}}

  {:name :_users-thead-row
   :parent :hiccup
   :args {:tag {:value "tr"} :children [:_users-th-username :_users-th-org :_users-th-actions]}}

  {:name :_users-thead
   :parent :hiccup
   :args {:tag {:value "thead"} :children [:_users-thead-row]}}

  {:name :_user-username-val
   :parent :get
   :args {:coll {:as :item} :key {:value :username} :default {:value ""}}}

  {:name :_user-org-val
   :parent :get
   :args {:coll {:as :item} :key {:value :org} :default {:value ""}}}

  {:name :_user-td-username
   :parent :hiccup
   :args {:tag {:value "td"} :children [:_user-username-val]}}

  {:name :_user-td-org
   :parent :hiccup
   :args {:tag {:value "td"} :children [:_user-org-val]}}

  ;; per-row delete button — HTMX: hx-delete the generic entity endpoint,
  ;; hx-swap="delete" drops THIS <tr> on success, hx-confirm prompts. No JS.
  {:name :_user-id-val
   :parent :get
   :args {:coll {:as :item} :key {:value :id} :default {:value ""}}}

  {:name :_user-id-str
   :parent :to-str
   :args {:value :_user-id-val}}

  ;; Dedicated cascade route (not the generic `/api/entities/user/:id`):
  ;; `:delete-user-route` also removes the user's `:token`s + `:grant`s so
  ;; no dangling auth/authz rows survive.
  {:name :_user-delete-url
   :parent :str-join
   :args {:coll [{:value "/api/users/"} :_user-id-str]
          :separator {:value ""}}}

  {:name :_user-delete-attrs
   :parent :assoc
   :args {:map {:value {:type "button"
                        :class "grant-delete"
                        :title "Delete user"
                        :hx-target "closest tr"
                        :hx-swap "delete"
                        :hx-confirm "Delete this user?"}}
          :key {:value :hx-delete}
          :value :_user-delete-url}}

  {:name :_user-delete-btn
   :parent :hiccup
   :args {:tag {:value "button"} :attrs :_user-delete-attrs :children [{:value "×"}]}}

  ;; per-row reset-password form: a password input + submit, hx-post to the
  ;; per-user reset route (id single-sourced from the row). No client JS.
  {:name :_user-reset-url
   :parent :str-join
   :args {:coll [{:value "/api/users/"} :_user-id-str {:value "/password"}]
          :separator {:value ""}}}

  {:name :_user-reset-input
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:value {:type "password" :name "password" :placeholder "new password" :class "grant-input" :required true}}}}

  {:name :_user-reset-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:type "submit" :class "grant-create-btn" :title "Reset password"}}
          :children [{:value "Reset pw"}]}}

  {:name :_user-reset-form-attrs
   :parent :assoc
   :args {:map {:value {:class "grant-create-form"
                        :hx-target "closest [data-users-panel]"
                        :hx-swap "outerHTML"}}
          :key {:value :hx-post}
          :value :_user-reset-url}}

  {:name :_user-reset-form
   :parent :hiccup
   :args {:tag {:value "form"}
          :attrs :_user-reset-form-attrs
          :children [:_user-reset-input :_user-reset-btn]}}

  {:name :_user-td-actions
   :parent :hiccup
   :args {:tag {:value "td"} :children [:_user-reset-form :_user-delete-btn]}}

  {:name :_user-row
   :parent :hiccup
   :args {:tag {:value "tr"} :children [:_user-td-username :_user-td-org :_user-td-actions]}}

  {:name :_users-rows
   :parent :map
   :args {:func :_user-row :coll :list-users}}

  {:name :_users-tbody
   :parent :hiccup
   :args {:tag {:value "tbody"} :children :_users-rows}}

  {:name :_users-table
   :parent :hiccup
   :args {:tag {:value "table"}
          :attrs {:value {:class "grants-admin-table"}}
          :children [:_users-thead :_users-tbody]}}

  {:name :_users-disabled
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "grants-admin-disabled"}}
          :children [{:value "Tenancy addon not active — no users to manage."}]}}

  {:name :_users-safe
   :description "The users table, or the disabled notice when :list-users throws (addon inactive). `:on-throw` is `[:fn :any]`, so the fallback is wrapped in `:const`."
   :parent :try
   :args {:body :_users-table
          :on-throw {:parent :const :args {:value :_users-disabled}}}}

  ;; --- create form — a real <form hx-post> (no client JS); HTML5 `required`
  ;; replaces the JS empty-check; the response swaps the refreshed panel back.
  {:name :_user-input-username
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:value {:type "text" :name "username" :placeholder "username" :class "grant-input" :required true}}}}

  {:name :_user-input-password
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:value {:type "password" :name "password" :placeholder "password" :class "grant-input" :required true}}}}

  {:name :_user-input-org
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:value {:type "text" :name "org" :placeholder "org" :class "grant-input" :required true}}}}

  {:name :_user-create-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:type "submit" :class "grant-create-btn"}}
          :children [{:value "+ Add user"}]}}

  ;; Path single-sourced: the route AND this form's hx-post both reference it.
  {:name :_users-api-path
   :parent :const
   :args {:value "/api/users"}}

  {:name :_users-create-form-attrs
   :parent :assoc
   :args {:map {:value {:class "grant-create-form"
                        :hx-target "closest [data-users-panel]"
                        :hx-swap "outerHTML"}}
          :key {:value :hx-post}
          :value :_users-api-path}}

  {:name :_users-create-form
   :parent :hiccup
   :args {:tag {:value "form"}
          :attrs :_users-create-form-attrs
          :children [:_user-input-username :_user-input-password :_user-input-org :_user-create-btn]}}

  {:name :_users-admin-title
   :parent :hiccup
   :args {:tag {:value "h3"} :children [{:value "Users"}]}}

  {:name :_users-admin-body
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "grants-admin" :data-users-panel "1"}}
          :children [:_users-admin-title :_users-safe :_users-create-form]}}

  {:name :_users-admin-html
   :parent :render-hiccup
   :args {:hiccup :_users-admin-body}}

  {:name :_partial-users-admin-handler
   :description "Ring handler for GET /partials/users-admin — the users table as text/html."
   :parent :html-ok-response
   :args {:body :_users-admin-html}}

  {:name :partial-users-admin
   :description "GET /partials/users-admin — server-rendered users table. Auth-required (admin-only); degrades to a notice when the tenancy addon is inactive."
   :parent :get-auth-required
   :args {:path "/partials/users-admin" :handler :_partial-users-admin-handler}}

  ;; ---------------------------------------------------------------------
  ;; USER REGISTRATION (§4.1) — POST /api/users {username password org}.
  ;; Operator op: the `:invoke-create-user` base-fn calls the `:user-ops`
  ;; seam, which bcrypt-hashes + writes `:user`. Platform-only (`:user` is
  ;; tenant-forbidden → a tenant POST is denied by OrgScoped).
  ;; ---------------------------------------------------------------------
  {:name :invoke-create-user
   :description "Create a user via the addon's user-ops seam (bcrypt-hashed). Returns the row (no password), or nil when the addon isn't active."
   :args {:username {:type :text :description "Login id (unique)."}
          :password {:type :text :description "Raw password — only its bcrypt hash is stored."}
          :org {:type :text :description "Org the user belongs to."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :_user-create-form-data
   :parent :parse-form-body}

  {:name :_user-create-username
   :parent :get
   :args {:coll :_user-create-form-data :key {:value :username} :default {:value ""}}}

  {:name :_user-create-password
   :parent :get
   :args {:coll :_user-create-form-data :key {:value :password} :default {:value ""}}}

  {:name :_user-create-org
   :parent :get
   :args {:coll :_user-create-form-data :key {:value :org} :default {:value ""}}}

  {:name :_user-create-do
   :parent :invoke-create-user
   :args {:username :_user-create-username
          :password :_user-create-password
          :org :_user-create-org}}

  {:name :_user-create-then-panel
   :description "Register the user, THEN render the refreshed panel — `:do` forces left-to-right so the panel's :list-users includes the new row. HTMX swaps this into [data-users-panel]."
   :parent :do
   :args {:steps [:_user-create-do :_users-admin-html]}}

  {:name :_user-create-handler
   :description "Ring handler for POST /api/users — registers the user and returns the refreshed users panel as text/html (HTMX swap target)."
   :parent :html-ok-response
   :args {:body :_user-create-then-panel}}

  {:name :create-user-route
   :description "POST /api/users — register a user from a form-encoded body (username/password/org). Auth-required; platform-only. Path single-sourced via :_users-api-path (shared with the form's hx-post)."
   :parent :post
   :args {:path :_users-api-path :handler :_user-create-handler}}

  ;; =====================================================================
  ;; ACCOUNT ADMIN (§4.1) — reset-password + cascade-delete. Operator-only
  ;; (`:user` / `:token` / `:grant` are tenant-forbidden). The `:invoke-*`
  ;; base-fns call the addon's `:user-ops` seam.
  ;; =====================================================================
  {:name :invoke-reset-password
   :description "Reset a user's password via the addon's user-ops seam and invalidate their sessions. Returns {:sessions-invalidated n}, or nil when the addon isn't active."
   :args {:user-id {:type :nullable-uuid :description "Target user id."}
          :password {:type :text :description "New raw password — only its hash is stored."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :invoke-delete-user
   :description "Delete a user and cascade their :token + :grant rows via the addon's user-ops seam. Returns {:tokens-deleted n :grants-deleted m}, or nil when the addon isn't active."
   :args {:user-id {:type :nullable-uuid :description "Target user id."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  ;; Shared `:id` path-param parse for /api/users/:id and
  ;; /api/users/:id/password — reitit `:path-params` first, URI fallback
  ;; (the segment after `users` is the id for both routes).
  {:name :_users-id-from-path-params
   :parent :get-in
   :args {:map {:as :request} :path [{:value :path-params} {:value :id}] :default nil}}

  {:name :_users-id-from-uri
   :parent :uri-segment-after
   :args {:marker {:value "users"}}}

  {:name :_users-id-raw
   :parent :coalesce
   :args {:value :_users-id-from-path-params :default :_users-id-from-uri}}

  {:name :_users-id-parsed
   :parent :parse-uuid
   :args {:string :_users-id-raw}}

  ;; --- DELETE /api/users/:id — cascade-delete then empty 200 (HTMX
  ;; hx-swap="delete" drops the row).
  {:name :_user-delete-do
   :parent :invoke-delete-user
   :args {:user-id :_users-id-parsed}}

  {:name :_user-delete-empty-ok
   :parent :html-ok-response
   :args {:body {:value ""}}}

  {:name :_user-delete-handler
   :description "DELETE /api/users/:id — cascade-delete the user (tokens + grants), then return an empty 200 so HTMX hx-swap=delete drops the row."
   :parent :do
   :args {:steps [:_user-delete-do :_user-delete-empty-ok]}}

  {:name :delete-user-route
   :description "DELETE /api/users/:id — cascade-delete a user + their tokens/grants. Auth-required; operator-only."
   :parent :delete
   :args {:path "/api/users/:id" :handler :_user-delete-handler}}

  ;; --- POST /api/users/:id/password {password} — reset + refresh panel.
  {:name :_user-reset-form-data
   :parent :parse-form-body}

  {:name :_user-reset-password-val
   :parent :get
   :args {:coll :_user-reset-form-data :key {:value :password} :default {:value ""}}}

  {:name :_user-reset-do
   :parent :invoke-reset-password
   :args {:user-id :_users-id-parsed :password :_user-reset-password-val}}

  {:name :_user-reset-then-panel
   :description "Reset the password, THEN render the refreshed panel — `:do` forces order. HTMX swaps into [data-users-panel]."
   :parent :do
   :args {:steps [:_user-reset-do :_users-admin-html]}}

  {:name :_user-reset-handler
   :description "Ring handler for POST /api/users/:id/password — resets the password and returns the refreshed users panel."
   :parent :html-ok-response
   :args {:body :_user-reset-then-panel}}

  {:name :reset-password-route
   :description "POST /api/users/:id/password — reset a user's password (form body {password}); invalidates their sessions. Auth-required; operator-only."
   :parent :post
   :args {:path "/api/users/:id/password" :handler :_user-reset-handler}}]}
