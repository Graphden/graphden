;; Collection manipulation base functions
;; first, rest, cons, conj, get, assoc, dissoc, count, empty?,
;; contains?, keys, vals, merge, into, range, repeat, take, drop,
;; reverse, sort, concat, flatten, distinct


{:namespace "core.collections"
 :description "Collection primitives — first/rest/conj/get/assoc/merge/range/take/drop and other Clojure-equivalent operations over maps/vectors/seqs."
 :fns
 [{:name :first
   :description "First item of a list (Clojure's `first`). Returns nil for an empty or nil list, hence the `[:union :null a]` return — narrow via `:coalesce` before use where non-null is required."
   :args {:coll {:type [:list a] :description "List to take the first of."}}
   :return-type [:union :null a]}

  {:name :rest
   :description "Everything after the first item (Clojure's `rest`). Empty for nil/empty input."
   :args {:coll {:type [:list a] :description "List to take the rest of."}}
   :return-type [:list a]}

  {:name :cons
   :description "Prepend an item to a list (Clojure's `cons`). Returns a new seq."
   :args {:item {:type a :description "Item placed at the head."}
          :coll {:type [:list a] :description "List placed after the head."}}
   :return-type [:list a]}

  ;; First-class list primitive. :items is a sequence-arg; items live in
  ;; linked arg entities chained via arg.next_arg_id.
  {:name :list
   :description "Construct a vector from a sequence-arg. Each item is a separate arg entity chained via `next-arg-id`, so refs and literals can be freely mixed."
   ;; `:items` is `[:list :any]` (heterogeneous) — a `:list` may freely
   ;; mix element types (`:cond` builds `[test result test result …]`
   ;; this way). `list-return-rule` lubs the actual items per call site.
   :args {:items {:type [:list :any] :description "Items in order. Each can be a literal or a fn-ref."}}
   :return-type [:list :any]}

  ;; Converts a list of 2-element pairs into a map. :entries is a sequence-arg
  ;; where each item is either a :pair fn-def result or a literal [k v] vector.
  {:name :pairs->map
   :description "Build a map from a sequence of `[key value]` pairs (or `:pair` results). Later pairs override earlier ones with the same key."
   :args {:entries {:type [:list :any] :description "Sequence of two-element pairs."}}
   :return-type [:map :any :any]}

  {:name :conj
   :description "Append/prepend an item depending on collection type (Clojure's `conj`). Vectors append; lists/seqs prepend; maps add a `[k v]` entry."
   :args {:coll {:type :any :description "Collection to add to."}
          :item {:type :any :description "Item to add."}}
   :return-type :any}

  {:name :get
   :description "Look up a key in a map/vector (Clojure's `get`). Falls back to `:default` when the key is missing."
   :args {:coll {:type :jsonb :description "Map or vector to read from."}
          :key {:type :any :description "Lookup key (or vector index)."}
          :default {:type :any :required false :description "Returned when the key is absent."}}
   :return-type :any}

  {:name :get-in
   :description "Look up a value at a nested path (Clojure's `get-in`). Falls back to `:default` if any segment is missing."
   :args {:map {:type :jsonb :description "Map to read from."}
          :path {:type [:list [:union :keyword :int :text]] :description "Path to traverse — each item may be a literal key (`:keyword` for records, `:int` for vector index, `:text` for string-keyed maps) or a fn-ref."}
          :default {:type :any :required false :description "Returned when the path is absent."}}
   :return-type :any}

  {:name :assoc
   :description "Set a single key in a map (Clojure's `assoc`). Returns a new map."
   :args {:map {:type :any :description "Map to update (nil treated as empty)."}
          :key {:type :any :description "Key to set."}
          :value {:type :any :description "Value to write."}}
   :return-type :any}

  ;; Same as `:assoc` but the `:value` slot is `:fn`-typed — the bound
  ;; ref is hof-wrap'd into a callable instead of being executed and
  ;; merged as a value. Used for routes where the assoc'd value must
  ;; remain a Ring callable (handler).
  ;;
  ;; Why this is its own fn-def rather than an inline `{:type [:fn …]}`
  ;; on every consumer: `:assoc-handler` mixes `:assoc-fn` + `:assoc-empty`
  ;; via MI to combine fn-typed `:value` + pre-bound `:map {}` in one
  ;; named building block. Each consumer that wants Ring-callable assoc
  ;; would otherwise reproduce the same override every time. Slot-
  ;; resolution's `ancestor-type-pin` walks the parents-chain for
  ;; exactly this MI pattern — see slot_resolution.clj. Keep as a
  ;; named alias rather than inlining.
  {:name :assoc-fn
   :description "Variant of `:assoc` whose `:value` is `:fn`-typed — the bound fn-graph is hof-wrap'd into a callable rather than executed and stored. Used where the value must remain a function (e.g. Ring handlers in route maps). Slot type `[:fn {:arg a} b]` — single-arg generic callable; positional unify so the callee's leftover free-arg name is alpha-equivalent."
   :parent :assoc
   :args {:value {:as :value :type [:fn {:arg a} b]}}}

  {:name :dissoc
   :description "Remove a single key from a map (Clojure's `dissoc`)."
   ;; `:map` is `[:map a :any]`, not `[:map a b]`: a heterogeneous-
   ;; valued record (the common case) can't unify a single `b` over
   ;; its mixed field types. Fixing the value side to `:any` keeps
   ;; record arguments accepted via `unify-map-record` while still
   ;; rejecting `[:list :int]` (lists aren't map-typed at all). The
   ;; rule (`dissoc-return-rule`) recovers the precise record shape
   ;; when `:key` is a literal.
   :args {:map {:type [:map a :any] :description "Map to remove from."}
          :key {:type a :description "Key to remove."}}
   :return-type [:map a :any]}

  {:name :count
   :description "Count items in a collection (Clojure's `count`). Returns 0 for nil. Always non-negative."
   :args {:coll {:type :jsonb :description "Collection to size."}}
   :return-type :non-negative-int}

  {:name :empty?
   :description "True iff the collection has no items (Clojure's `empty?`). True for nil."
   :args {:coll {:type :jsonb :description "Collection to test."}}
   :return-type :bool}

  {:name :contains?
   :description "True iff the collection contains the given key (Clojure's `contains?`). For vectors this checks the index, NOT the value."
   :args {:coll {:type :jsonb :description "Collection to test."}
          :key {:type :any :description "Key (or index) to look up."}}
   :return-type :bool}

  {:name :keys
   :description "Vector of map keys (Clojure's `keys`). Order is unspecified for unsorted maps."
   :args {:map {:type [:map k v] :description "Map to enumerate."}}
   :return-type [:list k]}

  {:name :vals
   :description "Vector of map values (Clojure's `vals`). Order matches `:keys`."
   :args {:map {:type [:map k v] :description "Map to enumerate."}}
   :return-type [:list v]}

  ;; `(apply merge maps)` — variadic merge like Clojure's. `:maps` is a
  ;; sequence-arg so callers can inline refs: `{:maps [:a-ref :b-ref]}`.
  ;; Item type is `[:map a :any]` — admits records via unify-map-record
  ;; (heterogeneous values fit `:any`) while rejecting a stray `[:list]`
  ;; bound by mistake.
  {:name :merge
   :description "Merge a sequence of maps left-to-right (Clojure's `(apply merge maps)`); later keys override earlier ones."
   :args {:maps {:type [:list [:map a :any]] :description "Maps to merge in order."}}
   :return-type [:map :any :any]}

  {:name :into
   :description "Pour items from one collection into another (Clojure's `into`). The destination's type is preserved."
   :args {:to {:type :jsonb :description "Destination collection."}
          :from {:type :jsonb :description "Source items."}}
   :return-type :jsonb}

  {:name :assoc-in
   :description "Set the value at a nested path in a map (Clojure's `assoc-in`). Creates intermediate maps as needed."
   :args {:m {:type :any :description "Map to update (nil treated as empty)."}
          :path {:type [:list [:union :keyword :int :text]] :description "Path to traverse — each item may be a literal key (`:keyword` for records, `:int` for vector index, `:text` for string-keyed maps) or a fn-ref."}
          :v {:type :any :description "Value to write at the path."}}
   :return-type :any}

  ;; (update-in m path f) — apply `f` to value at path. `:f` is `:fn`-typed
  ;; so the bound fn-graph is hof-wrap'd; when caller binds `:defaults`
  ;; (or any other captured name), hof-wrap's call-time dispatch picks
  ;; the per-call lambda param dynamically (single non-map arg → bind to
  ;; the only leftover; map arg whose keys match all hof-free → merge).
  {:name :update-in
   :description "Apply a callable to the value at a nested path (Clojure's `update-in`). The `:f` slot is :fn-typed; impl invokes `(f existing-value)` per call."
   :args {:m {:type :any :description "Map to update (nil treated as empty)."}
          :path {:type [:list [:union :keyword :int :text]] :description "Path to traverse — each item may be a literal key (`:keyword` for records, `:int` for vector index, `:text` for string-keyed maps) or a fn-ref."}
          :f {:type [:fn {:existing a} b] :description "Callable receiving the existing value at the path under the convention name `:existing` (alpha-equivalent for 1-arg callees), returning the new value."}}
   :return-type :any}

  {:name :range
   :description "Generate a vector of integers in `[start, end)` stepping by `step` (Clojure's `range`)."
   :args {:start {:type :int :value 0 :description "Inclusive lower bound. Defaults to 0."}
          :end {:type :int :description "Exclusive upper bound."}
          :step {:type :int :value 1 :description "Step between successive values. Defaults to 1; must be non-zero."}}
   :return-type [:list :int]}

  {:name :repeat
   :description "Vector of `count` copies of `item` (Clojure's `(into [] (repeat count item))`)."
   ;; `:non-negative-int` is a built-in type alias for
   ;; `[:refine :int [:>= 0]]`. Negative counts are rejected at
   ;; sync time — the runtime treats them as zero anyway.
   :args {:count {:type :non-negative-int :description "Number of copies."}
          :item {:type a :description "Value repeated."}}
   :return-type [:list a]}

  {:name :take
   :description "First `count` items of a list (Clojure's `take`). Realises a lazy seq."
   :args {:count {:type :non-negative-int :description "Maximum number of items to take."}
          :coll {:type [:list a] :description "Source list."}}
   :return-type [:list a]}

  {:name :drop
   :description "Skip the first `count` items (Clojure's `drop`). Returns a vector of the remainder."
   :args {:count {:type :non-negative-int :description "Number of items to skip."}
          :coll {:type [:list a] :description "Source list."}}
   :return-type [:list a]}

  {:name :reverse
   :description "Reverse a sequence (Clojure's `reverse`)."
   :args {:coll {:type [:list a] :description "List to reverse."}}
   :return-type [:list a]}

  {:name :sort
   :description "Sort a sequence in natural order (Clojure's `sort`). For mixed types use a custom comparator via composition."
   :args {:coll {:type [:list a] :description "List to sort."}}
   :return-type [:list a]}

  {:name :concat
   :description "Concatenate a sequence of sequences into one (Clojure's `(apply concat colls)`)."
   :args {:colls {:type [:list [:list :any]] :description "Sequence of sequences to concatenate; each item may be a literal collection or a fn-ref."}}
   :return-type [:list :any]}

  {:name :flatten
   :description "Flatten nested sequences into a single flat one (Clojure's `flatten`)."
   :args {:coll {:type :jsonb :description "Possibly-nested collection."}}
   :return-type [:list :any]}

  {:name :distinct
   :description "Drop duplicate items, preserving first occurrence (Clojure's `distinct`)."
   :args {:coll {:type [:list a] :description "List that may contain duplicates."}}
   :return-type [:list a]}

  {:name :stringify-map-keys
   :description "Walk a map and convert each keyword key into a string key. Useful at JSON/string boundaries."
   :args {:m {:type :jsonb :description "Map whose keys to stringify."}}
   :return-type [:map :text :any]}

  {:name :keywordize-map-keys
   :description "Walk a map and convert each string key into a keyword. Inverse of `:stringify-map-keys`."
   :args {:m {:type :any :description "Map whose keys to keywordize."}}
   :return-type [:map :keyword :any]}

  {:name :select-keys
   :description "Submap containing only the specified keys (Clojure's `select-keys`). Records in graphden are keyword-keyed, so the result is a `[:map :keyword :any]`."
   :args {:m {:type :any :description "Source map."}
          :ks {:type [:list :keyword] :description "Keys to keep — keyword each (records in graphden are keyword-keyed). Each item may be a literal or a fn-ref."}}
   :return-type [:map :keyword :any]}

  {:name :zipmap
   :description "Build a map from parallel `keys` and `vals` sequences (Clojure's `zipmap`)."
   :args {:keys {:type [:list k] :description "Vector of map keys."}
          :vals {:type [:list v] :description "Vector of corresponding values."}}
   :return-type [:map k v]}

  {:name :update-vals
   :description "Apply a function to every value in a map (Clojure's `update-vals`). Keys are preserved."
   :args {:m {:type :any :description "Map whose values to transform."}
          :f {:type [:fn {:value v} w] :description "Callable receiving each value under the convention name `:value` (alpha-equivalent for 1-arg callees), returning the new one."}}
   :return-type :any}

  ;; (update-in m path #(merge defaults %)) — Clojure-style closure.
  ;; `:defaults` is captured from caller's outer scope (callers source-id
  ;; cross-HOF directly to the named seq-item below); `:existing` is the
  ;; lambda's per-call param injected by update-in's impl. Sync derives
  ;; both via `partition-args-by-freedom` over the named items.
  {:name :merge-in
   :description "Merge `defaults` into the map at `path` inside `m`. Equivalent to `(update-in m path #(merge defaults %))` — existing keys win. `:m` and `:path` propagate up as free args of `:update-in`."
   :parent :update-in
   :args {:f :_merge-in-fn}}

  {:name :_merge-in-fn
   :parent :merge
   :args {:maps [{:as :defaults
                  :description "Map of fallback entries — supplied by the caller; merged FIRST so existing keys win."}
                 {:as :existing
                  :description "Map currently at the path — supplied by `:update-in`'s impl as the lambda's per-call input; merged LAST so its keys override."}]}}]}
