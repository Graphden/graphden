                                            :key {:value :id}
                                            :default nil}}}}
          :write-policy :_branch-policy-value}}

  {:name :_branch-policy-apply
   :description "Success — `{:ok true :write-policy <stored-or-nil>}`."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :write-policy}]
          :vals [{:value true} :_branch-policy-apply-set]}}

  {:name :_branch-policy-data
   :description "POST /api/branches/:ref/policy — flat `:cond` of `[invalid? → 400, missing? → 404-envelope, true → apply]`."
   :parent :cond
   :args {:clauses [:_branch-policy-invalid?  :_branch-policy-err-invalid
                    :_branch-policy-missing?  :_branch-policy-err-missing
