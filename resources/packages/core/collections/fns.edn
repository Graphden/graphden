;; Collection manipulation base functions
;; first, rest, cons, conj, get, assoc, dissoc, count, empty?,
;; contains?, keys, vals, merge, into, range, repeat, take, drop,
;; reverse, sort, concat, flatten, distinct


{:namespace "core.collections"
 :fns
 [{:name :first
   :args {:coll :jsonb}
   :return-type :any}

  {:name :rest
   :args {:coll :jsonb}
   :return-type :jsonb}

  {:name :cons
   :args {:item :any, :coll :jsonb}
   :return-type :jsonb}

  ;; First-class list primitive. :items is a sequence-arg; items live in
  ;; linked arg entities chained via arg.next_arg_id.
  {:name :list
   :args {:items {:type :sequence :of :any}}
   :return-type :jsonb}

  ;; Converts a list of 2-element pairs into a map. :entries is a sequence-arg
  ;; where each item is either a :pair fn-def result or a literal [k v] vector.
  {:name :pairs->map
   :args {:entries {:type :sequence :of :any}}
   :return-type :jsonb}

  {:name :conj
   :args {:coll :any, :item :any}
   :return-type :any}

  {:name :get
   :args {:coll :jsonb
          :key :any
          :default {:type :any :required false}}
   :return-type :any}

  {:name :get-in
   :args {:map :jsonb
          :path :jsonb
          :default {:type :any :required false}}
   :return-type :any}

  {:name :assoc
   :args {:map :any, :key :any, :value :any}
   :return-type :any}

  {:name :dissoc
   :args {:map :jsonb, :key :any}
   :return-type :jsonb}

  {:name :count
   :args {:coll :jsonb}
   :return-type :int}

  {:name :empty?
   :args {:coll :jsonb}
   :return-type :bool}

  {:name :contains?
   :args {:coll :jsonb, :key :any}
   :return-type :bool}

  {:name :keys
   :args {:map :jsonb}
   :return-type :jsonb}

  {:name :vals
   :args {:map :jsonb}
   :return-type :jsonb}

  ;; `(apply merge maps)` — variadic merge like Clojure's. `:maps` is a
  ;; sequence-arg so callers can inline refs: `{:maps [:a-ref :b-ref]}`.
  {:name :merge
   :args {:maps {:type :sequence :of :any}}
   :return-type :jsonb}

  {:name :into
   :args {:to :jsonb, :from :jsonb}
   :return-type :jsonb}

  {:name :assoc-in
   :args {:m :any
          :path :jsonb
          :v :any}
   :return-type :any}

  {:name :range
   :args {:start {:type :int :value 0}
          :end :int
          :step {:type :int :value 1}}
   :return-type :jsonb}

  {:name :repeat
   :args {:count :int, :item :any}
   :return-type :jsonb}

  {:name :take
   :args {:count :int, :coll :jsonb}
   :return-type :jsonb}

  {:name :drop
   :args {:count :int, :coll :jsonb}
   :return-type :jsonb}

  {:name :reverse
   :args {:coll :jsonb}
   :return-type :jsonb}

  {:name :sort
   :args {:coll :jsonb}
   :return-type :jsonb}

  {:name :concat
   :args {:colls :jsonb}
   :return-type :jsonb}

  {:name :flatten
   :args {:coll :jsonb}
   :return-type :jsonb}

  {:name :distinct
   :args {:coll :jsonb}
   :return-type :jsonb}

  {:name :stringify-map-keys
   :args {:m :jsonb}
   :return-type :jsonb}

  {:name :keywordize-map-keys
   :args {:m :any}
   :return-type :any}

  {:name :select-keys
   :args {:m :any, :ks :jsonb}
   :return-type :any}

  {:name :zipmap
   :args {:keys :jsonb, :vals :jsonb}
   :return-type :any}

  {:name :update-vals
   :args {:m :any, :f :fn}
   :return-type :any}

  ;; (assoc-in m path (merge defaults (get-in m path))) — pure
  ;; composition over existing primitives.
  {:name :merge-in
   :parent :assoc-in
   :args {:m {:as :m}
          :path {:as :path}
          :v :_merge-in-merged}}

  {:name :_merge-in-merged
   :parent :merge
   :args {:maps [:_merge-in-defaults :_merge-in-existing]}}

  {:name :_merge-in-defaults
   :parent :identity
   :args {:value {:as :defaults}}}

  {:name :_merge-in-existing
   :parent :get-in
   :args {:map {:as :m}
          :path {:as :path}}}]}
