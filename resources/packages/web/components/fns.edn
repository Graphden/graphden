;; Starter component library — composable hiccup wrappers for
;; building HTML pages from fn-defs. Each component is a thin
;; fn-def over `:hiccup` exposing a small set of slots for
;; variants + content + event-handler attrs. Wire click-
;; handlers via `:dispatch-action` (see web/runtime).
;;
;; Composition convention:
;;
;;   - `:label` / `:content` / `:children` — visible content
;;   - `:attrs` — optional attribute map (typically the result of
;;     `:dispatch-action`, but any keyword-map works)
;;
;; Shipped: `:button`, `:input`, `:textarea`, `:option`, `:select`,
;; `:checkbox`, `:form`, `:link`, `:image`, `:card`, plus the
;; `:custom-script` / `:wrap-custom-script` escape hatch.
;; Modal is deferred (needs JS lifecycle).


{:namespace "web.components"
 :description "Starter component library for user-built sites. Composable hiccup wrappers with optional event-handler attrs via :dispatch-action."
 :fns
 [;; :button — `<button [attrs]>label</button>`.
  ;; The `:attrs` slot is the wire for click-handler attrs (e.g.
  ;; `(dispatch-action :action "run-fn")`); omit to render a plain
  ;; button. Examples:
  ;;
  ;;   ;; Plain label-only button (no JS handler).
  ;;   {:name :placeholder-button
  ;;    :parent :button
  ;;    :args {:label "Soon"}}
  ;;
  ;;   ;; Click-handler button — emits `<button data-action="run-fn">Run</button>`.
  ;;   {:name :run-button
  ;;    :parent :button
  ;;    :args {:label "Run"
  ;;           :attrs {:parent :dispatch-action :args {:action "run-fn"}}}}
  {:name :button
   :description "Standard button component — renders `<button [attrs]>label</button>`. Slot `:label` is the visible button text; slot `:attrs` is an optional hiccup attrs map (typically built by `:dispatch-action`) merged onto the tag."
   :parent :hiccup
   :args {:tag {:value "button"}
          :children [{:as :label :type :text
                      :description "Visible button text."}]}}

  ;; Form-input set. Each is a thin fn-def over `:hiccup`
  ;; exposing slots specific to the form element. The `:attrs` slot is
  ;; inherited from `:hiccup` (free, optional) — caller supplies the
  ;; element-specific attrs map (`{:type "email" :name "email" …}` for
  ;; `:input`; `{:method "POST" :action "/contact"}` for `:form`; etc).

  ;; `<input attrs/>` — self-closing, no children. The only exposed
  ;; slot is the inherited `:attrs` map. Example:
  ;;
  ;;   {:name :email-input
  ;;    :parent :input
  ;;    :args {:attrs {:value {:type "email" :name "email"
  ;;                           :placeholder "you@example.com"}}}}
  {:name :input
   :description "HTML `<input [attrs]/>` — self-closing form input. Bind the inherited `:attrs` slot to a map containing `:type` / `:name` / `:placeholder` / etc."
   :parent :hiccup
   :args {:tag {:value "input"}
          :children {:value []}}}

  ;; `<textarea attrs>content</textarea>` — `:content` is the initial
  ;; textarea body. Example:
  ;;
  ;;   {:name :message-textarea
  ;;    :parent :textarea
  ;;    :args {:attrs {:value {:name "message" :rows 6}}
  ;;           :content ""}}
  {:name :textarea
   :description "HTML `<textarea [attrs]>content</textarea>`. Slot `:content` is the initial body text; `:attrs` (inherited) typically carries `:name` and `:rows`/`:cols`."
   :parent :hiccup
   :args {:tag {:value "textarea"}
          :children [{:as :content :type :text
                      :description "Initial textarea body text."}]}}

  ;; `<option [attrs]>label</option>` — building block for `:select`.
  ;; `:attrs` (inherited) typically carries `:value` / `:selected`.
  {:name :option
   :description "HTML `<option [attrs]>label</option>` — typically supplied as one of `:select`'s `:options`."
   :parent :hiccup
   :args {:tag {:value "option"}
          :children [{:as :label :type :text
                      :description "Visible option text."}]}}

  ;; `<select attrs>options...</select>` — `:options` is a list of
  ;; `:option` hiccup nodes. Example:
  ;;
  ;;   {:name :colour-select
  ;;    :parent :select
  ;;    :args {:attrs {:value {:name "colour"}}
  ;;           :options [{:parent :option :args {:label "Red"
  ;;                                              :attrs {:value {:value "red"}}}}
  ;;                     {:parent :option :args {:label "Green"
  ;;                                              :attrs {:value {:value "green"}}}}]}}
  {:name :select
   :description "HTML `<select [attrs]>options...</select>`. Slot `:options` is a list of `:option` hiccup nodes (or any hiccup-node list, but `:option` is the conventional element)."
   :parent :hiccup
   :args {:tag {:value "select"}
          :children {:as :options :type [:list :hiccup-node]
                     :description "List of option hiccup nodes — typically built via `:option`."}}}

  ;; `<input type="checkbox" [attrs]/>` — convenience over `:input`
  ;; that pre-merges `:type "checkbox"` so the caller doesn't have to
  ;; remember it. Composition: `:_checkbox-attrs` merges the caller's
  ;; optional `:attrs` onto the locked `{:type "checkbox"}` map.
  ;;
  ;;   {:name :agree-checkbox
  ;;    :parent :checkbox
  ;;    :args {:attrs {:value {:name "agree" :id "agree"}}}}
  {:name :_checkbox-attrs
   :description "Internal — merges `:type \"checkbox\"` onto the caller's optional `:attrs` map; gives `:checkbox` its `<input type=\"checkbox\">` shape without locking the rest of the attrs."
   :parent :merge
   :args {:maps [{:value {:type "checkbox"}}
                 {:as :attrs :required false
                  :description "Extra attrs (`:name` / `:id` / `:checked` / …)."}]}}

  {:name :checkbox
   :description "HTML `<input type=\"checkbox\" [attrs]/>`. The `type=\"checkbox\"` attr is merged in automatically; bind `:attrs` to add `:name` / `:id` / `:checked`."
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs :_checkbox-attrs
          :children {:value []}}}

  ;; `<form attrs>children...</form>` — `:children` is the list of
  ;; form fields + buttons. Example:
  ;;
  ;;   {:name :contact-form
  ;;    :parent :form
  ;;    :args {:attrs {:value {:method "POST" :action "/contact"}}
  ;;           :children [:email-input
  ;;                      :message-textarea
  ;;                      {:parent :button
  ;;                       :args {:label "Send" :attrs {:value {:type "submit"}}}}]}}
  {:name :form
   :description "HTML `<form [attrs]>children...</form>`. Slot `:children` is the list of form fields + buttons; `:attrs` (inherited) typically carries `:method` / `:action`."
   :parent :hiccup
   :args {:tag {:value "form"}
          :children {:as :children :type [:list :hiccup-node]
                     :description "Form fields, labels, and submit buttons in render order."}}}

  ;; Layout/content set. `:link`, `:image`, `:card`.
  ;; Each pre-merges the structurally-required attrs (`:href` for
  ;; link, `:src`+`:alt` for image, `class="card"` for card) so the
  ;; caller only has to think about the variable parts.

  ;; `<a href="..." [extra-attrs]>label</a>`. `:href` is a dedicated
  ;; slot (required) so the platform shape stays obvious; merge
  ;; order places caller's `:attrs` FIRST so the platform-supplied
  ;; href wins on conflict.
  {:name :_link-attrs
   :description "Internal — merges `{:href <href>}` onto the caller's optional `:attrs` map; gives `:link` its `<a href=...>` shape."
   :parent :merge
   :args {:maps [{:as :attrs :required false
                  :description "Extra attrs (`:target` / `:rel` / …)."}
                 {:parent :assoc
                  :args {:map {:value {}}
                         :key {:value :href}
                         :value {:as :href :type :text
                                 :description "Anchor target URL."}}}]}}

  {:name :link
   :description "HTML `<a href=\"...\" [attrs]>label</a>`. Slot `:href` is the link target (required); `:label` is the visible text; `:attrs` (optional) carries `:target` / `:rel` / etc."
   :parent :hiccup
   :args {:tag {:value "a"}
          :attrs :_link-attrs
          :children [{:as :label :type :text
                      :description "Visible link text."}]}}

  ;; `<img src="..." alt="..." [extra-attrs]/>`. Same pattern as
  ;; `:link` — required platform attrs win on conflict. The image
  ;; has no children (self-closing per HTML spec).
  {:name :_image-attrs
   :description "Internal — assembles `<img>` attrs from caller's `:attrs` plus the required `:src` + `:alt` slots."
   :parent :merge
   :args {:maps [{:as :attrs :required false
                  :description "Extra attrs (`:width` / `:height` / `:loading` / …)."}
                 {:parent :assoc
                  :args {:map {:value {}}
                         :key {:value :src}
                         :value {:as :src :type :text
                                 :description "Image source URL."}}}
                 {:parent :assoc
                  :args {:map {:value {}}
                         :key {:value :alt}
                         :value {:as :alt :type :text
                                 :description "Accessibility alt text — use empty string for purely decorative images."}}}]}}

  {:name :image
   :description "HTML `<img src=\"...\" alt=\"...\" [attrs]/>`. Slots `:src` and `:alt` are required (alt may be the empty string for decorative images); `:attrs` (optional) carries `:width`/`:height`/`:loading`."
   :parent :hiccup
   :args {:tag {:value "img"}
          :attrs :_image-attrs
          :children {:value []}}}

  ;; `<div class="card" [extra-attrs]>children...</div>`. Pre-merges
  ;; `class="card"` so dropping a `:card` into a graph gives a
  ;; predictable visual default; caller can override (later items
  ;; in the merge win).
  {:name :_card-attrs
   :description "Internal — pre-merges `{:class \"card\"}` onto the caller's optional `:attrs` map; merge order makes caller's class override the default."
   :parent :merge
   :args {:maps [{:value {:class "card"}}
                 {:as :attrs :required false
                  :description "Extra attrs (`:id` / `:role` / extra `:class`)."}]}}

  {:name :card
   :description "HTML `<div class=\"card\" [attrs]>children...</div>` — generic surface container. `:children` is the list of hiccup nodes inside the card; `:attrs` (optional) overrides or extends the default class."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs :_card-attrs
          :children {:as :children :type [:list :hiccup-node]
                     :description "Card body hiccup nodes."}}}

  ;; ---------------------------------------------------------------------------
  ;; CONVENIENCE BUTTON TEMPLATES
  ;; ---------------------------------------------------------------------------
  ;;
  ;; Collapsing the canonical "click-handler button" boilerplate.
  ;; The raw form is:
  ;;
  ;;   {:parent :button
  ;;    :args {:label "Send"
  ;;           :attrs {:parent :merge
  ;;                   :args {:maps [{:parent :dispatch-action
  ;;                                  :args {:action "submit-form"}}
  ;;                                 {:value {:type "submit"
  ;;                                          :data-target "#result"}}]}}}}
  ;;
  ;; With `:submit-button` it becomes:
  ;;
  ;;   {:parent :submit-button
  ;;    :args {:label "Send"
  ;;           :extras {:data-target "#result"}}}
  ;;
  ;; Each template exposes:
  ;;   :label   — visible button text (inherited from `:button`)
  ;;   :extras  — optional attrs map (default `{}`) merged LAST so
  ;;              the caller can add `:class` / `:data-target` /
  ;;              `:id` / etc.
  ;;
  ;; The merge order is platform-attrs first, caller-`:extras`
  ;; last — caller's keys win on conflict.

  ;; Submit-form button — the standard "POST this form" CTA.
  {:name :submit-button
   :description "`<button data-action=\"submit-form\" type=\"submit\" [extras]>label</button>`. Wires the runtime's `submit-form` handler so the enclosing `<form>` is POSTed via fetch on click; bind `:extras :data-target \"#some-selector\"` to swap the response into a specific element. Free args: `:label`, `:extras` (optional)."
   :parent :button
   :args {:attrs {:parent :merge
                  :args {:maps [{:parent :dispatch-action
                                 :args {:action {:value "submit-form"}}}
                                {:value {:type "submit"}}
                                {:as :extras :required false
                                 :description "Extra attrs merged onto the button (`:class` / `:data-target` / `:id` / …)."}]}}}}

  ;; Generic click-action button — caller picks the handler name.
  {:name :click-button
   :description "`<button data-action=\"<action>\" [extras]>label</button>`. Wires the runtime to invoke the registered handler for `:action` on click. Free args: `:label`, `:action` (registered handler name), `:extras` (optional attrs)."
   :parent :button
   :args {:attrs {:parent :merge
                  :args {:maps [{:parent :dispatch-action
                                 :args {:action {:as :action :type :non-blank-text
                                                 :description "Registered handler name (see editor-runtime.js `registerActionHandler` calls)."}}}
                                {:as :extras :required false
                                 :description "Extra attrs merged onto the button (`:class` / per-handler `:data-*` / …)."}]}}}}

  ;; Navigate-on-click button — like a styled link but as a button.
  {:name :navigate-button
   :description "`<button data-action=\"navigate\" data-href=\"<href>\" [extras]>label</button>`. The runtime's `navigate` handler sets `window.location.href = href` on click. Free args: `:label`, `:href` (target URL), `:extras` (optional attrs)."
   :parent :button
   :args {:attrs {:parent :merge
                  :args {:maps [{:parent :dispatch-action
                                 :args {:action {:value "navigate"}}}
                                {:parent :assoc
                                 :args {:map {:value {}}
                                        :key {:value :data-href}
                                        :value {:as :href :type :text
                                                :description "URL the navigate handler sets `window.location.href` to."}}}
                                {:as :extras :required false
                                 :description "Extra attrs (`:class` / `:type` / `:id` / …)."}]}}}}

  ;; Custom-handler button — inline JS body evaluated on click.
  ;; The body has `btn`, `event`, `host` in scope.
  {:name :custom-button
   :description "`<button data-action=\"custom\" data-custom-handler=\"<body>\" [extras]>label</button>`. The runtime's `custom` handler evaluates the body as `(btn, event, host) => …` on click. Free args: `:label`, `:body` (JS source), `:extras` (optional attrs)."
   :parent :button
   :args {:attrs {:parent :merge
                  :args {:maps [{:parent :dispatch-custom
                                 :args {:body {:as :body :type :js-source
                                               :description "JavaScript body executed on click."}}}
                                {:as :extras :required false
                                 :description "Extra attrs (`:class` / `:type` / per-handler `:data-*` / …)."}]}}}}

  ;; Escape hatch. When the platform components can't
  ;; express the behaviour the user needs (a custom hover effect,
  ;; a one-off DOM manipulation, integration with a 3rd-party JS
  ;; library), `:custom-script` lets the user drop raw JS into a
  ;; page or a component event-handler without leaving the graph
  ;; editor.
  ;;
  ;; Two use-sites:
  ;;
  ;;   1. **Page-level** — wrap a body in `:wrap-custom-script` and
  ;;      put it in a page's `:scripts` list:
  ;;
  ;;        {:name :my-tooltip-script
  ;;         :parent :wrap-custom-script
  ;;         :args {:body "document.querySelectorAll('[data-tip]').forEach(e => e.title = e.dataset.tip);"}}
  ;;
  ;;        ;; then in your page:
  ;;        :scripts [:graphden-runtime-script-tag :my-tooltip-script]
  ;;
  ;;   2. **Event-handler** — bind a button's `:attrs` to
  ;;      `:dispatch-custom` (see web.runtime) which builds
  ;;      `{:data-action "custom" :data-custom-handler <body>}`;
  ;;      the runtime's `custom` action handler evaluates the
  ;;      body as a JS function `(btn, event, host) => …`.
  ;;
  ;; v0: plain string body. No syntax highlighting, no Monaco. The
  ;; `:js-source` type alias (in `core.refinements`) is what
  ;; future linting / safety checks will hook into.

  {:name :custom-script
   :description "Named holder for a JavaScript source body. Compose with `:wrap-custom-script` to render as `<script>body</script>`, or with `:dispatch-custom` to attach as a button's `data-custom-handler` attr."
   :parent :const
   :return-type :js-source
   :args {:value {:as :body :type :js-source
                  :description "JavaScript source code (any valid JS body — runtime parser is the validator)."}}}

  {:name :wrap-custom-script
   :description "Render a JS body as `<script>body</script>` hiccup for inclusion in a page's `:scripts` list."
   :parent :wrap-script
   :args {:content {:as :body :type :js-source
                    :description "JavaScript source body — wrapped verbatim inside `<script>…</script>`."}}}]}
