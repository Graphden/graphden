{:namespace "app.editor"
 :description "Edit-mode form + picker partials — type-name datalist, compatible-type options, expects-effects form, and the fn-picker incompat-explainer."
 :fns
 [;; ---------------------------------------------------------------------
  ;; type-name datalist — `GET /partials/type-name-datalist`. The
  ;; create-type popover's name-autocomplete list: one <option> per
  ;; named type-row (kind label from the server's `compute-fn-role`)
  ;; plus the canonical primitives. The form itself stays client-built
  ;; (kind-tab state carry + prefill + the interactive constraint
  ;; builders — see the graph-first-exception in
  ;; editor-create-type.js); only this pure data projection moved.

  {:name :_tnd-option
   :parent :hiccup
   :args {:tag {:value "option"}
          :attrs {:parent :zipmap
                  :args {:keys [{:value :value} {:value :label}]
                         :vals [{:parent :get
                                 :args {:coll {:as :item}
                                        :key {:value :name}
                                        :default ""}}
                                {:parent :get
                                 :args {:coll {:as :item}
                                        :key {:value :kind}
                                        :default ""}}]}}
          :children {:value []}}}

  {:name :_tnd-options
   :parent :map
   :args {:func :_tnd-option :coll :type-name-kinds}}

  {:name :_tnd-fragment
   :parent :hiccup
   :args {:tag {:value "datalist"}
          :attrs {:value {:id "type-create-typename-list"}}
          :children [:_tnd-options]}}

  {:name :_tnd-html
   :parent :render-hiccup
   :args {:hiccup :_tnd-fragment}}

  {:name :_partial-tnd-handler
   :description "Ring handler for `GET /partials/type-name-datalist` — the create-type popover's name-autocomplete <datalist> as `text/html`."
   :parent :html-ok-response
   :args {:body :_tnd-html}}

  ;; ---------------------------------------------------------------------
  ;; compatible-type <option> list —
  ;; `GET /partials/compatible-type-options?expected={json}[&current=X][&primitives=true]`.
  ;; One server-side alias-aware `subtype?` sweep replaces the editor's
  ;; former per-name `/api/types/compatible` fan-out (~50 parallel
  ;; POSTs per type-picker open, in TWO places: the arg-type select and
  ;; the inline-panel narrower select). JS moves the returned <option>
  ;; nodes into its live <select>; `current` is excluded server-side
  ;; (the caller seeds it synchronously for instant render).

  {:name :_cto-expected-raw
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "expected"}}}

  {:name :_cto-expected-str
   :description "The `expected` param, narrowed to non-nil for `:parse-json`. A MISSING param is a programmer error worth a 500 — the picker JS always supplies it; only present-but-malformed VALUES degrade (see `:_cto-expected`)."
   :parent :assert-some
   :args {:value :_cto-expected-raw}}

  {:name :_cto-expected-decode
   :description "Decode the URL-encoded JSON wire shape to the type AST (same contract as `/partials/fn-picker-incompat`). Throws on malformed JSON (`:parse-json` → typed `:validation-error/malformed-json`) or an undecodable wire-shape. `:keywordize` is pinned true (its default; `:json-to-type` is key-form agnostic) so it is not a free arg captured into the `:try` body below."
   :parent :json-to-type
   :args {:json {:parent :parse-json
                 :args {:string :_cto-expected-str
                        :keywordize {:value true}}}}}

  {:name :_cto-expected
   :description "Expected slot type, or nil when `expected` is PRESENT but malformed (bad JSON / undecodable wire-shape). A graph `:try` turns that throw into nil so the handler renders the empty-select fallback instead of a 500 — mirrors `app/layout`'s `:_parse-layout-request`. A truly missing param still 500s via `:_cto-expected-str`'s `:assert-some`."
   :parent :try
   :args {:body :_cto-expected-decode
          :on-throw {:parent :const :args {:value nil}}}}

  {:name :_cto-current
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "current"}}}

  {:name :_cto-include-prims?
   :parent :equal?
   :args {:a {:parent :query-param
              :args {:request {:as :request} :param-name {:value "primitives"}}}
          :b {:value "true"}}}

  {:name :_cto-expected-ok?
   :parent :some?
   :args {:value :_cto-expected}}

  {:name :_cto-rows
   :description "Compatible type-rows for `expected`. When `expected` was malformed (`:_cto-expected` = nil) the sweep is skipped and rows are empty — the fragment degrades to the empty-select placeholder rather than passing nil into `subtype?`."
   :parent :if
   :args {:test :_cto-expected-ok?
          :then {:parent :compatible-type-names :args {:expected :_cto-expected}}
          :else {:value []}}}

  {:name :_cto-not-prim?
   :parent :not
   :args {:value {:parent :equal?
                  :args {:a {:parent :get
                             :args {:coll {:as :item} :key {:value :kind} :default nil}}
                         :b {:value "primitive"}}}}}

  {:name :_cto-rows-filtered
   :description "Rows minus the primitives when `primitives=true` wasn't asked for — the inline narrower select lists named type-rows only."
   :parent :if
   :args {:test :_cto-include-prims?
          :then :_cto-rows
          :else {:parent :filter
                 :args {:pred :_cto-not-prim? :coll :_cto-rows}}}}

  {:name :_cto-row-name
   :parent :get
   :args {:coll {:as :item} :key {:value :name} :default ""}}

  {:name :_cto-not-current?
   :parent :not
   :args {:value {:parent :equal? :args {:a {:as :item} :b :_cto-current}}}}

  {:name :_cto-names
   :parent :filter
   :args {:pred :_cto-not-current?
          :coll {:parent :map
                 :args {:func :_cto-row-name :coll :_cto-rows-filtered}}}}

  {:name :_cto-option
   :parent :hiccup
   :args {:tag {:value "option"}
          :attrs {:parent :zipmap
                  :args {:keys [{:value :value}]
                         :vals [{:as :item}]}}
          :children [{:as :item}]}}

  {:name :_cto-options
   :parent :map
   :args {:func :_cto-option :coll :_cto-names}}

  ;; "(no compatible types)" placeholder — only when the list is empty
  ;; AND no current type exists to fall back on (mirrors the old JS).
  {:name :_cto-empty-state
   :parent :if
   :args {:test {:parent :and
                 :args {:values [{:parent :empty? :args {:coll :_cto-names}}
                                 {:parent :nil? :args {:value :_cto-current}}]}}
          :then {:value [:option {:value "" :disabled "disabled"}
                         "(no compatible types)"]}
          :else :_hidden-span}}

  {:name :_cto-fragment
   :description "Wrapper div — JS lifts the <option> nodes out of it into the live <select>."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {}}
          :children [:_cto-options :_cto-empty-state]}}

  {:name :_cto-html
   :parent :render-hiccup
   :args {:hiccup :_cto-fragment}}

  {:name :_partial-cto-handler
   :lambda-params [:request]
   :description "Ring handler for `GET /partials/compatible-type-options` — the compatible-type <option> list as `text/html`. `:keywordize` is no longer a free arg (pinned at `:_cto-expected-decode`, since its `:parse-json` is now inside a `:try` body)."
   :parent :html-ok-response
   :args {:body :_cto-html}}

  ;; ---------------------------------------------------------------------
  ;; declared-effects form — `GET /partials/expects-effects-form?fn-id=…`.
  ;; The mode radios + category checkbox grid, pre-filled from the fn
  ;; row's `:expects-effects` (nil = no contract, [] = pinned purity,
  ;; list = explicit). The checkbox roster is the canonical
  ;; `known-effect-categories` set — the old hand-built JS grid listed
  ;; six categories and silently made `:process` / `:raw-sql`
  ;; undeclarable through the UI. JS owns only the
  ;; radio→enable/disable toggle and the save collect.

  {:name :_eef-row
   :parent :fn-row-by-id
   :args {:fn-id {:ref :fn-id-param :type :nullable-uuid}}}

  {:name :_eef-declared
   :description "The fn's `:expects-effects` — nil = no contract, [] = pinned purity, non-empty = explicit set."
   :parent :get
   :args {:coll :_eef-row :key {:value :expects-effects} :default nil}}

  {:name :_eef-has-contract?
   :parent :some?
   :args {:value :_eef-declared}}

  {:name :_eef-declared-names
   :parent :map
   :args {:func :_kw-item-name
          :coll {:parent :coalesce
                 :args {:value :_eef-declared :default {:value []}}}}}

  {:name :_eef-cat-checked?
   :parent :some?
   :args {:value {:parent :position-in
                  :args {:coll :_eef-declared-names :value {:as :item}}}}}

  {:name :_eef-cb-attrs
   :description "Per-category checkbox attrs — checked when the contract lists it, disabled while in no-contract mode."
   :parent :if
   :args {:test :_eef-has-contract?
          :then {:parent :if
                 :args {:test :_eef-cat-checked?
                        :then {:parent :zipmap
                               :args {:keys [{:value :type} {:value :value} {:value :checked}]
                                      :vals [{:value "checkbox"} {:as :item} {:value "checked"}]}}
                        :else {:parent :zipmap
                               :args {:keys [{:value :type} {:value :value}]
                                      :vals [{:value "checkbox"} {:as :item}]}}}}
          :else {:parent :zipmap
                 :args {:keys [{:value :type} {:value :value} {:value :disabled}]
                        :vals [{:value "checkbox"} {:as :item} {:value "disabled"}]}}}}

  {:name :_eef-checkbox
   :parent :hiccup
   :args {:tag {:value "label"}
          :attrs {:value {:class "expects-effects-checkbox"}}
          :children [{:parent :hiccup
                      :args {:tag {:value "input"}
                             :attrs :_eef-cb-attrs
                             :children {:value []}}}
                     {:parent :str-join
                      :args {:coll [{:value " "} {:as :item}]
                             :separator {:value ""}}}]}}

  {:name :_eef-grid
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "expects-effects-grid"}}
          :children [{:parent :map
                      :args {:func :_eef-checkbox
                             :coll :declarable-effect-categories}}]}}

  {:name :_eef-mode-row
   :parent :if
   :args {:test :_eef-has-contract?
          :then {:value [:div {:class "expects-effects-mode-row"}
                         [:label {:title "Drift checker is off for this fn (default)."}
                          [:input {:type "radio" :name "ee-mode" :value "none"}]
                          " no contract"]
                         [:label {:title "Drift checker compares computed effects against the ticked set. Empty = pinned purity."}
                          [:input {:type "radio" :name "ee-mode" :value "contract"
                                   :checked "checked"}]
                          " explicit contract"]]}
          :else {:value [:div {:class "expects-effects-mode-row"}
                         [:label {:title "Drift checker is off for this fn (default)."}
                          [:input {:type "radio" :name "ee-mode" :value "none"
                                   :checked "checked"}]
                          " no contract"]
                         [:label {:title "Drift checker compares computed effects against the ticked set. Empty = pinned purity."}
                          [:input {:type "radio" :name "ee-mode" :value "contract"}]
                          " explicit contract"]]}}}

  {:name :_eef-fragment
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "expects-effects-edit"}}
          :children [:_eef-mode-row :_eef-grid]}}

  {:name :_eef-html
   :parent :render-hiccup
   :args {:hiccup :_eef-fragment}}

  {:name :_partial-eef-handler
   :lambda-params [:request]
   :description "Ring handler for `GET /partials/expects-effects-form?fn-id=<uuid>` — the declared-effects edit form as `text/html`."
   :parent :html-ok-response
   :args {:body :_eef-html}}

  ;; ---------------------------------------------------------------------
  ;; fn-picker incompat-explainer. The fn-picker popover surfaces
  ;; functions whose return type doesn't satisfy the slot's expected
  ;; type under a separate "Other" section; clicking such a candidate
  ;; opens this explainer with a "Pick anyway" affordance, rendering the
  ;; incompat info server-side through the shared mismatch-rendering
  ;; chain.
  ;;
  ;; URL: `GET /partials/fn-picker-incompat?expected={url-encoded-json}
  ;;       &candidate-fn-id={uuid}`. `expected` is the slot's type
  ;; expression in its JSON wire shape (same shape `/api/types`
  ;; produces); the candidate fn-id resolves to the candidate's rich
  ;; return-type via `:rich-return-of-fn`.

  {:name :_partial-fpi-expected-raw
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "expected"}}}

  {:name :_partial-fpi-expected-json
   :description "JSON body of `expected`. `:assert-some` narrows from `:nullable-text` to `:text` for `:parse-json`'s strict slot — the picker's JS always supplies this param; missing-param is a programmer error worth surfacing as a 500."
   :parent :parse-json
   :args {:string {:parent :assert-some :args {:value :_partial-fpi-expected-raw}}}}

  {:name :_partial-fpi-expected
   :description "Expected slot type — decoded from JSON wire-shape back to the Clojure AST."
   :parent :json-to-type
   :args {:json :_partial-fpi-expected-json}}

  {:name :_partial-fpi-candidate-fn-id-str
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "candidate-fn-id"}}}

  {:name :_partial-fpi-candidate-fn-id
   :parent :parse-uuid
   :args {:string :_partial-fpi-candidate-fn-id-str}}

  {:name :_partial-fpi-candidate
   :description "Candidate fn's rich return-type (the type the user would store if they picked it). Reads through the registry by name."
   :parent :rich-return-of-fn
   :args {:fn-id :_partial-fpi-candidate-fn-id}}

  {:name :_partial-fpi-reason
   :description "One-line natural-language reason `candidate` ⊄ `expected` — same `:describe-type-mismatch` the `/api/types/compatible` endpoint produces, so the picker's text matches what a backend-validated `POST` would say."
   :parent :describe-type-mismatch
   :args {:expected :_partial-fpi-expected :candidate :_partial-fpi-candidate}}

  {:name :_partial-fpi-expected-text
   :parent :to-str :args {:value :_partial-fpi-expected}}

  {:name :_partial-fpi-candidate-text
   :parent :to-str :args {:value :_partial-fpi-candidate}}

  {:name :_partial-fpi-candidate-fn-id-text
   :parent :to-str :args {:value :_partial-fpi-candidate-fn-id}}

  {:name :_partial-fpi-header
   :parent :const
   :args {:value
          [:div {:class "mismatch-explainer-header"}
           [:span {:class "mismatch-explainer-title"} "Type mismatch"]
           [:button {:type "button"
                     :class "mismatch-explainer-close"
                     :data-explainer-close "1"
                     :aria-label "Close mismatch explainer"} "×"]]}}

  {:name :_partial-fpi-expected-row
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "mismatch-explainer-row mismatch-row-expected"}}
          :children [{:value [:span {:class "mismatch-explainer-label"} "Expected"]}
                     {:parent :hiccup
                      :args {:tag {:value "span"}
                             :attrs {:value {:class "mismatch-explainer-value"}}
                             :children [:_partial-fpi-expected-text]}}]}}

  {:name :_partial-fpi-got-row
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "mismatch-explainer-row mismatch-row-got"}}
          :children [{:value [:span {:class "mismatch-explainer-label"} "Got"]}
                     {:parent :hiccup
                      :args {:tag {:value "span"}
                             :attrs {:value {:class "mismatch-explainer-value"}}
                             :children [:_partial-fpi-candidate-text]}}]}}

  {:name :_partial-fpi-reason-row
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "mismatch-explainer-row mismatch-row-reason"}}
          :children [{:value [:span {:class "mismatch-explainer-label"} "Reason"]}
                     {:parent :hiccup
                      :args {:tag {:value "span"}
                             :attrs {:value {:class "mismatch-explainer-value"}}
                             :children [:_partial-fpi-reason]}}]}}

  ;; "Pick anyway" — the picker's primary action when the user
  ;; insists on a server-rejected type-mismatch. The button carries
  ;; `data-pick-fn-id={uuid}` so the picker's post-swap binding can
  ;; close the explainer + call its own pickFn(fnId) closure. Same
  ;; data-attr pattern the mismatch-explainer's Edit button uses.
  {:name :_partial-fpi-pick-button
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:parent :assoc
                  :args {:map {:value {:type "button"
                                       :class "mismatch-explainer-btn"}}
                         :key {:value :data-pick-fn-id}
                         :value :_partial-fpi-candidate-fn-id-text}}
          :children [{:value "Pick anyway"}]}}

  {:name :_partial-fpi-actions
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "mismatch-explainer-actions"}}
          :children [:_partial-fpi-pick-button]}}

  {:name :_partial-fpi-fragment
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "mismatch-explainer-content"}}
          :children [:_partial-fpi-header
                     :_partial-fpi-expected-row
                     :_partial-fpi-got-row
                     :_partial-fpi-reason-row
                     :_partial-fpi-actions]}}

  {:name :_partial-fpi-html
   :parent :render-hiccup
   :args {:hiccup :_partial-fpi-fragment}}

  {:name :_partial-fn-picker-incompat-handler
   :lambda-params [:request :keywordize]
   :description "Ring handler for `GET /partials/fn-picker-incompat?expected={json}&candidate-fn-id={uuid}` — returns the fn-picker incompat-explainer hiccup as `text/html`. Replaces the editor's legacy JS `renderMismatchExplainer` path used by `editor-fn-picker.js`'s `explainAndOfferAnyway`."
   :parent :html-ok-response
   :args {:body :_partial-fpi-html}}]}
