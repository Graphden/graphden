  ;; Phase 3: `:fn`'s `:name` is version-data, so the IN-clause
  ;; filter runs post-resolve over the resolved row set. The
  ;; predicate converts the names vec into a set and checks
  ;; membership of each row's resolved `:name`.
  {:name :_secret-leaf-rows-fetched
   :description "Storage rows for whatever base-fns carry the `:secret-shape` tag."
   :parent :filter
   :args {:pred :_secret-leaf-row-name-in?
          :coll :_secret-leaf-rows-resolved}}

  {:name :_secret-leaf-rows-resolved
   :parent :resolve-fn-rows
   :args {:identities :_secret-leaf-rows-identities
          :branch-chain :current-branch-chain}}

  {:name :_secret-leaf-rows-identities
   :parent :storage-query-identities
   :args {:entity-type {:value "fn"}}}

  {:name :_secret-leaf-row-name-in?
   :parent :contains?
   :args {:coll :_secret-leaf-names-set
          :key {:parent :get :args {:coll {:as :item} :key {:value :name} :default nil}}}}

  {:name :_secret-leaf-names-set
   :parent :to-set
   :args {:coll :_secret-leaf-names}}

  {:name :_secret-leaf-rows
   :description "Empty-vec guard — `:list-entities :where {:name <vec>}` rejects an empty IN-clause at the storage validator. When `web.vault` isn't loaded (no `:secret-shape`-tagged base-fns), short-circuit to `[]` so downstream `:first` + `:get` cleanly produce nil instead of throwing."
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_secret-leaf-names}}
          :then {:value []}
          :else :_secret-leaf-rows-fetched}}

  {:name :_secret-leaf-row
   :parent :first
   :args {:coll :_secret-leaf-rows}}

  {:name :_secret-leaf-fn-id
   :description "First `:secret-shape`-tagged base-fn's id; nil when `web.vault` isn't loaded (no row matches). Shared by the create / delete / rotate cond chains."
   :parent :get
   :args {:coll :_secret-leaf-row :key {:value :id} :default nil}}

  {:name :_create-secret-name-blank?
   :description "Guard #1 — request body had no `:name`. Pure graph composition: `:blank?` over the parsed `:nm` field."
   :parent :blank?
   :args {:string {:parent :get :args {:coll {:as :parsed} :key {:value :nm} :default nil}}}}

  {:name :_create-secret-path-blank?
   :description "Guard #2 — request body had no `:path`. Same shape as `:_create-secret-name-blank?` but reads `:path`."
   :parent :blank?
   :args {:string {:parent :get :args {:coll {:as :parsed} :key {:value :path} :default nil}}}}

  {:name :_create-secret-value-missing?
   :description "Guard #3 — request body's `:value` wasn't a string. `:not :is-a? :text` over the parsed `:value` field."
   :parent :not
   :args {:value {:parent :is-a?
                  :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :value} :default nil}}
                         :type {:value :text}}}}}

  {:name :_create-secret-leaf-missing?
   :description "Guard #4 — `:secret-leaf` base-fn not loaded. Pure `:nil?` over the resolved leaf-id."
   :parent :nil?
   :args {:value {:as :leaf-id}}}

  ;; Phase 3: `:namespace-id` lives on the identity row so the
  ;; pre-filter pushes into the SQL; `:name` is version-data so
  ;; the post-resolve `:filter` handles the second leg.
  {:name :_create-secret-name-taken-rows
   :parent :filter
   :args {:pred :_create-secret-name-taken-name-eq?
          :coll :_create-secret-name-taken-resolved}}

  {:name :_create-secret-name-taken-resolved
   :parent :resolve-fn-rows
   :args {:identities :_create-secret-name-taken-identities
          :branch-chain :current-branch-chain}}

  {:name :_create-secret-name-taken-identities
   :parent :storage-query-identities
   :args {:entity-type {:value "fn"}
          :where :_create-secret-name-taken-identities-where}}

  {:name :_create-secret-name-taken-identities-where
   :parent :zipmap
   :args {:keys [{:value :namespace-id}]
          :vals [{:parent :get :args {:coll {:as :parsed} :key {:value :ns-id} :default nil}}]}}

  {:name :_create-secret-name-taken-name-eq?
   :parent :equal?
   :args {:a {:parent :get :args {:coll {:as :item} :key {:value :name} :default nil}}
          :b {:parent :get :args {:coll {:as :parsed} :key {:value :nm} :default nil}}}}

  {:name :_create-secret-name-taken?
   :description "Guard #5 — a fn with the same (`:name`, `:namespace-id`) already exists. `:not :empty? (list-entities :fn {:name :nm :namespace-id :ns-id})`."
   :parent :not
   :args {:value {:parent :empty? :args {:coll :_create-secret-name-taken-rows}}}}

  {:name :_create-secret-name-taken-error
   :description "Dynamic error builder for guard #5 — uses parsed `:nm`."
   :parent :zipmap
   :args {:keys [:ok :error :reason]
          :vals [false
                 {:parent :str
                  :args {:parts ["fn already exists with name: "
                                 {:parent :get
                                  :args {:coll {:as :parsed}
                                         :key {:value :nm}
                                         :default nil}}]}}
                 :name-taken]}}

  ;; Phase 4.5 decomposition: `:try` + shared `:atom` journal pattern.
  ;; Body does vault-put + (optional metadata) + fn-create + binding-
  ;; create + post-create type-check, appending rollback entries to
  ;; the journal at each successful step. On-throw replays the journal
  ;; in reverse via the shared `:_apply-secret-rollback`.
  {:name :_apply-create-secret-body
   :description "Body of create-secret `:try`: vault-put + fn create + binding create + post-check. Throws on storage/vault/type-check failure (caught by enclosing `:try`)."
   :args {:parsed {:type {:nm :nullable-text
                          :ns-id :nullable-uuid
                          :path :nullable-text
                          :value [:union :null [:secret :text]]
                          :description :nullable-text
                          :custom-metadata :nullable-jsonb}}
          :leaf-id {:type :uuid}
          :journal {:type :any}}
   :return-type {:ok :bool
                 :secret {:id :text
                          :name :nullable-text
                          :namespace-id :nullable-text
                          :path :text
                          :description :nullable-text
