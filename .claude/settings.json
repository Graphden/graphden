{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/root/projects/graphden/.claude/hooks/check-ui-on-stop.sh",
            "timeout": 60,
            "statusMessage": "Linting modified UI files (biome + stylelint)…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/root/projects/graphden/.claude/hooks/remind-packages-quality-on-impls-edit.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
