{:paths ["scripts"]

 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :as p]
             [clojure.string :as str])

  :init (do
          ;; Lint paths cover: src + test (classpath sources) AND
          ;; resources/packages (impls.clj files loaded via load-file —
          ;; see .clj-kondo/config.edn for the namespace-name-mismatch
          ;; carve-out).
          ;; `development/` is on the :dev classpath (deps.edn :extra-paths) and
          ;; the GitHub workflow lints it — it must not be invisible to `bb ci`,
          ;; or local-green/CI-red is structural.
          (def all-paths "src test development resources/packages")
          (def green "\u001b[32m")
          (def red "\u001b[31m")
          (def cyan "\u001b[36m")
          (def yellow "\u001b[33m")
          (def reset "\u001b[0m")

          (defn run-parallel
            "Run shell commands in parallel. Wait for all, fail if any fails."
            [cmds]
            (let [procs (mapv (fn [cmd] (p/process cmd {:out :inherit :err :inherit})) cmds)]
              (doseq [proc procs] (p/check proc))))

          ;; --- docker instance addressing -----------------------------------
          ;; Mirrors the GD_* defaults in docker-compose.yml. Unset => the
          ;; canonical stack, i.e. exactly the historical behaviour.
          (def gd-instance (or (System/getenv "GD_INSTANCE") "graphden"))
          (def gd-executor (str gd-instance "-executor"))
          (def gd-url (str "http://localhost:" (or (System/getenv "GD_PORT_HTTP") "9002")))

          ;; --- shared SSH agent for the private mathx clone -----------------
          ;; `bb rebuild` builds the uberjar, which resolves the PRIVATE
          ;; `graphden-mathx` git coord over SSH (the :build alias is the only
          ;; one without the :dev/:test local-root override — by design, it is
          ;; the real distribution form). A per-shell `ssh-agent` doesn't help:
          ;; `bb ssh-key` and `bb rebuild` run in separate shells that don't
          ;; share it. So `bb ssh-key` loads the key into ONE agent bound to a
          ;; FIXED socket path, and `ssh-env` points every SSH-using child at
          ;; it — no `export SSH_AUTH_SOCK` needed in your rc.
          (def gd-ssh-sock (str (System/getenv "HOME") "/.ssh/graphden-agent.sock"))
          (defn ssh-env
            "p/shell opts pointing SSH at the fixed graphden agent socket when it
             exists; {} otherwise (so callers can splice it unconditionally)."
            []
            (if (fs/exists? gd-ssh-sock) {:extra-env {"SSH_AUTH_SOCK" gd-ssh-sock}} {}))

          (defn linked-worktree?
            "True inside an agent worktree (git-dir is <common>/worktrees/<name>),
             false in the main checkout where the two paths coincide."
            []
            (let [git-dir (fn [flag] (-> (p/shell {:out :string :err :string :continue true}
                                                  "git" "rev-parse" flag)
                                         :out str/trim))]
              (not= (fs/canonicalize (git-dir "--git-dir"))
                    (fs/canonicalize (git-dir "--git-common-dir")))))

          (defn assert-not-clobbering-shared-stack!
            "`bb rebuild`/`bb deploy` with no GD_INSTANCE target the CANONICAL
             stack: container graphden-executor, port 9002, image
             graphden-executor:latest. From an agent worktree that means
             stealing the demo instance and overwriting the very image tag the
             e2e suite boots — silently testing one agent's code against
             another's binary. Refuse; point at the isolated alternative."
            [task]
            (when (and (linked-worktree?) (nil? (System/getenv "GD_INSTANCE")))
              (println (str red "✗ " task " targets the SHARED instance (" gd-executor
                            " on " gd-url ") and the shared image tag." reset))
              (println "  You are in an agent worktree. Use your own isolated stack instead:")
              (println (str yellow "      bb wt up" reset "     # build + run this branch on its own ports"))
              (println (str yellow "      bb wt down" reset "   # stop it"))
              (println "  The canonical build happens in the landing gate, under the queue lock.")
              (System/exit 1)))

          (defn assert-gate-only!
            "The heavy suites boot the CANONICAL `graphden-executor:latest`. Run by
             hand from a worktree they do two bad things at once: they test whatever
             binary was built last — somebody else's code, reported green — and they
             saturate the box while a gate is trying to run, timing its checks out.
             They belong to the gate, which holds the queue lock and sets WTQ_GATE=1.
             The main checkout is unaffected."
            [task]
            (when (and (linked-worktree?) (not= "1" (System/getenv "WTQ_GATE")))
              (println (str red "✗ " task " boots the shared image tag (graphden-executor:latest)"
                            " and saturates the machine." reset))
              (println "  From a worktree it would test whatever was built last — not your branch —")
              (println "  and starve any gate that is running. It belongs to the landing gate:")
              (println (str yellow "      bb wt merge" reset "   # queue -> gate -> land (runs this suite for you)"))
              (println (str "  To see your own code run, use " yellow "bb wt up" reset " (isolated instance)."))
              (System/exit 1)))

          (defn await-healthy-then-verify!
            "Block until the instance's /health answers, then confirm the running
             build IS the local tree (`bb verify`) and that it serves (`bb smoke`).
             Shared by `bb rebuild` and `bb deploy`, which differ only in how they
             get there.

             Bootstrap is dominated by compiled-registry build (~21s) + fn-entities
             create (~40s) + integrant init (~10s) — ~70-80s wall in practice. The
             180 × 2s = 360s ceiling leaves margin for a cold-cache JVM warmup
             without flaking on a slow host. The demo's compiled-registry boot
             (~4.7k fns) measured 186s on 2026-07-20 — the old 180s ceiling
             failed a gate whose instance came up healthy seconds later; the
             ceiling must track the demo DB's growth, not race it."
            []
            (loop [attempts 0]
              (Thread/sleep 2000)
              (let [health (p/shell {:continue true :out :string :err :string}
                                    (str "docker exec " gd-executor
                                         " curl -sf http://localhost:8080/health"))]
                (cond
                  (zero? (:exit health))
                  (do (println (str green "✓ Server ready at " gd-url "/" reset))
                      (doseq [check ["verify" "smoke"]]
                        (let [{:keys [exit]} (p/shell {:continue true} "bb" check gd-url)]
                          (when-not (zero? exit) (System/exit exit)))))

                  (< attempts 180)
                  (do (print ".") (flush) (recur (inc attempts)))

                  :else
                  (do (println (str red "✗ Server failed to start (360s timeout — check `docker logs "
                                    gd-executor "`)" reset))
                      (System/exit 1))))))

          (defn instance-up!
            "(Re)start the instance from the image that is ALREADY built, then
             wait + verify + smoke. Lets the landing gate refresh the develop
             instance from the image it built in the feature worktree, without
             paying for a second uberjar."
            []
            (p/shell "docker-compose up -d executor")
            (await-healthy-then-verify!)))

  :enter (println (str cyan "▶ " (:name (current-task)) reset))

  ;; === DEVELOPMENT ===

  repl
  {:doc "Start headless nREPL server (writes .nrepl-port for clients to discover)"
   :override-builtin true
   :task (clojure "-A:dev -A:nrepl")}

  nrepl
  {:doc "Synonym for `bb repl` — clearer name when used by tools (Cider, clojure-mcp)"
   :task (clojure "-A:dev -A:nrepl")}

  nrepl-bg
  {:doc "Start headless nREPL in background. Logs → .nrepl.log, PID → .nrepl.pid. Stop via `bb nrepl-stop`."
   :task (let [pid-file (fs/file ".nrepl.pid")
               port-file (fs/file ".nrepl-port")
               running? (and (fs/exists? pid-file)
                             (zero? (:exit (p/shell {:continue true :out nil :err nil}
                                                    "kill" "-0" (str/trim (slurp pid-file))))))]
           (if running?
             (do (println (str red "nREPL already running (PID " (str/trim (slurp pid-file)) ")" reset))
                 (println "  Stop it first via `bb nrepl-stop`."))
             (do
               (when (fs/exists? port-file) (fs/delete port-file))
               ;; setsid + nohup fully detach; redirects free stdin/out/err
               (p/shell "bash" "-c"
                        "nohup setsid clojure -A:dev -A:nrepl >.nrepl.log 2>&1 </dev/null & echo $! >.nrepl.pid")
               (println (str "Starting nREPL... (PID " (str/trim (slurp pid-file)) ")"))
               (loop [tries 0]
                 (cond
                   (>= tries 30)
                   (println (str red "WARN: .nrepl-port did not appear within 30s; check .nrepl.log" reset))
                   (fs/exists? port-file)
                   (println (str green "✓ nREPL ready on port " (str/trim (slurp port-file)) reset
                                 "\n  log:  .nrepl.log"
                                 "\n  pid:  .nrepl.pid"
                                 "\n  stop: bb nrepl-stop"))
                   :else (do (Thread/sleep 1000) (recur (inc tries))))))))}

  nrepl-stop
  {:doc "Stop the backgrounded nREPL started by `bb nrepl-bg`"
   :task (let [pid-file (fs/file ".nrepl.pid")]
           (if (fs/exists? pid-file)
             (let [pid (str/trim (slurp pid-file))]
               (p/shell {:continue true :out nil :err nil} "kill" pid)
               ;; JVM shutdown hook deletes .nrepl-port itself, so use
               ;; delete-if-exists to avoid a race-condition crash.
               (fs/delete-if-exists pid-file)
               (fs/delete-if-exists (fs/file ".nrepl-port"))
               (println (str green "✓ Stopped nREPL (PID " pid ")" reset)))
             (println "No .nrepl.pid found — nothing to stop")))}

  ;; === LINTERS (each takes optional path) ===

  kondo
  {:doc "Run clj-kondo [path]"
   :task (let [path (or (first *command-line-args*) all-paths)
               ;; The deps.edn :kondo alias is THE pinned version (the CI
               ;; workflow pins the same one). A native binary on PATH is
               ;; used only when it matches — otherwise a dev box with a
               ;; brew-installed clj-kondo of any other vintage silently
               ;; lints with different rules than CI and the gate.
               pinned (get-in (clojure.edn/read-string (slurp "deps.edn"))
                              [:aliases :kondo :extra-deps
                               'clj-kondo/clj-kondo :mvn/version])
               native? (= 0 (:exit (p/shell {:out :string :err :string :continue true} "which clj-kondo")))
               native-version (when native?
                                (some->> (:out (p/shell {:out :string :err :string :continue true}
                                                        "clj-kondo --version"))
                                         (re-find (re-pattern "v([0-9.]+)"))
                                         second))
               native-ok? (and native? (= native-version pinned))]
           (when (and native? (not native-ok?))
             (println (str "kondo: native clj-kondo " native-version
                           " != pinned " pinned " — using the deps.edn alias")))
           (if native-ok?
             (p/shell (str "clj-kondo --lint " path))
             (clojure (str "-M:kondo --lint " path))))}

  splint
  {:doc "Run splint [path]"
   :task (clojure (str "-M:splint " (or (first *command-line-args*) all-paths)))}

  cljstyle
  {:doc "Check formatting [path]"
   :task (clojure (str "-M:cljstyle check " (or (first *command-line-args*) all-paths)))}

  biome
  {:doc "Lint editor JS via biome"
   :task (p/shell "npx" "biome" "check" "resources/packages/app/editor")}

  biome-fix
  {:doc "Auto-fix safe biome violations"
   :task (p/shell "npx" "biome" "check" "--write" "resources/packages/app/editor")}

  stylelint
  {:doc "Lint editor CSS via stylelint (design-token discipline + standard rules)"
   :task (p/shell "npx" "stylelint" "resources/packages/app/editor/**/*.css")}

  stylelint-fix
  {:doc "Auto-fix stylelint violations where possible"
   :task (p/shell "npx" "stylelint" "--fix" "resources/packages/app/editor/**/*.css")}

  ;; === Cross-cutting linters (docker-image or downloaded binary) ===
  ;;
  ;; Each task here works WITHOUT a host install: Docker pulls the
  ;; image on first run, the typos binary is fetched + cached under
  ;; `.tools/`. CI runs on a stock ubuntu-latest with docker + node
  ;; present; no extra `apt-get install …` lines required.

  shellcheck
  {:doc "Lint every tracked .sh file (plus dev/wtq/wt) via Docker koalaman/shellcheck:v0.11.0. Globbed, not a hardcoded list - a NEW shell script is linted the moment it exists."
   :task (let [skip (re-pattern "(^|/)(node_modules|target|\\.tools|\\.git|\\.playwright-mcp)/")
               sh-files (->> (fs/glob "." "**/*.sh" {:hidden true})
                        (map str)
                        (remove (fn [f] (re-find skip f)))
                        sort)]
           (apply p/shell "docker" "run" "--rm"
                  "-v" (str (System/getenv "PWD") ":/src")
                  "-w" "/src"
                  "koalaman/shellcheck:v0.11.0"
                  "dev/wtq/wt"
                  sh-files))}

  hadolint
  {:doc "Lint Dockerfile + Dockerfile.build + Dockerfile.crac via Docker hadolint/hadolint:v2.12.0-debian."
   :task (do
           (doseq [df ["Dockerfile" "Dockerfile.build" "Dockerfile.crac"]]
             (println (str "▶ hadolint " df))
             (let [proc (p/shell {:in (slurp df)}
                                 "docker" "run" "--rm" "-i"
                                 "hadolint/hadolint:v2.12.0-debian")]
               (p/check proc))))}

  gitleaks
  {:doc "Scan working tree for committed secrets via Docker zricethezav/gitleaks."
   :task (p/shell "docker" "run" "--rm"
                  "-v" (str (System/getenv "PWD") ":/repo")
                  "-w" "/repo"
                  "zricethezav/gitleaks:v8.30.1"
                  "detect" "--no-banner" "--no-git"
                  "--config" "/repo/.gitleaks.toml")}

  typos
  {:doc "Spelling check over docs + src via crate-ci/typos. Downloads the binary to .tools/typos on first run (Linux x86_64). Config: _typos.toml at repo root."
   :task (let [binary ".tools/typos"
               version "v1.48.0"]
           (when-not (fs/exists? binary)
             (println "Downloading typos" version "…")
             (fs/create-dirs ".tools")
             (let [url (str "https://github.com/crate-ci/typos/releases/download/"
                            version "/typos-" version "-x86_64-unknown-linux-musl.tar.gz")]
               (p/shell "curl" "-sL" "-o" ".tools/typos.tar.gz" url)
               (p/shell "tar" "xzf" ".tools/typos.tar.gz" "-C" ".tools/")
               (fs/delete ".tools/typos.tar.gz")))
           (p/shell binary))}

  markdownlint
  {:doc "Lint .md files via markdownlint-cli2 (npm-pinned). Config: .markdownlint-cli2.jsonc at repo root."
   :task (p/shell "npx" "markdownlint-cli2")}

  markdownlint-fix
  {:doc "Auto-fix markdownlint violations where possible."
   :task (p/shell "npx" "markdownlint-cli2" "--fix")}

  devtour
  {:doc "Regenerate the developer code-tour docs/devtour/index.html from docs/devtour/tour.edn. Anchors resolve by symbol (ns + defn); the anchored form's real source is baked in. Run after editing tour.edn or a toured form."
   :task (binding [*command-line-args* ["build"]] (load-file "scripts/devtour.clj"))}

  devtour-check
  {:doc "CI guard for the developer code-tour: every tour.edn anchor still resolves to a unique form AND docs/devtour/index.html matches a fresh regeneration (fails if source drifted from the baked tour). Fix with `bb devtour`."
   :task (binding [*command-line-args* ["check"]] (load-file "scripts/devtour.clj"))}

  ai-context-sync
  {:doc "CI guard: docs/AI_CONTEXT.md must be byte-identical to its classpath copy resources/packages/mcp/mcp/ai-context.md (the MCP server serves the latter at graphden://ai-context). The unit suite pins this too (mcp-doc-sync-test), but units are diff-scoped OUT of a docs-only change — this cheap check keeps the guard on that path. Fix by copying the edited file over the other."
   :task (let [a (slurp "docs/AI_CONTEXT.md")
               b (slurp "resources/packages/mcp/mcp/ai-context.md")]
           (when-not (= a b)
             (println "ai-context-sync: docs/AI_CONTEXT.md differs from resources/packages/mcp/mcp/ai-context.md — copy the edited one over the other")
             (System/exit 1)))}

  pkg-pin-sync
  {:doc "CI guard: every external package pinned by git coord in BOTH resources/executor-packages.edn (what build.clj bundles into the uberjar) and deps.edn (what dev/test resolve) must agree on :git/url and :git/sha. The two are edited independently, so a bump that touches only one ships a jar whose package differs from what the suite tested. Fix by copying the bumped coord to the other file."
   :task (let [deps (:deps (clojure.edn/read-string (slurp "deps.edn")))
               manifest (:packages (clojure.edn/read-string (slurp "resources/executor-packages.edn")))
               drift (for [{:keys [name lib coord]} manifest
                           :let [dep-coord (get deps lib)]
                           :when (and (:git/sha coord) (:git/sha dep-coord)
                                      (not= (select-keys coord [:git/url :git/sha])
                                            (select-keys dep-coord [:git/url :git/sha])))]
                       (str "pkg-pin-sync: " name " (" lib ") — executor-packages.edn pins "
                            (pr-str (select-keys coord [:git/url :git/sha]))
                            " but deps.edn pins "
                            (pr-str (select-keys dep-coord [:git/url :git/sha]))
                            " — bump both together"))]
           (when (seq drift)
             (run! println drift)
             (System/exit 1)))}

  pkg-copy-sync
  {:doc "CI guard: the in-tree copies of external packages (external-packages/{mathx,examples}/resources — what the suite and lint actually exercise via :override-deps / test paths) must be byte-identical to their standalone repos' resources/ trees. pkg-pin-sync guards the git-sha PIN; this guards the CONTENT — the hole through which examples/invoke-vs-call silently drifted for 3 weeks. Standalone repos are looked up as sibling checkouts (../<repo> from the main checkout, ../../<repo> from a worktree); a pair whose repo is absent (e.g. GitHub CI) SKIPS — the check guards the box the release flow runs on. Fix by syncing the edited side over the other, then committing both."
   :task (let [rel-files (fn [root]
                           (->> (fs/glob root "**")
                                (filter fs/regular-file?)
                                (map (fn [p] (str (fs/relativize root p))))
                                (set)))
               check-pair (fn [copy-dir repo-name]
                            (let [sibling (->> ["../" "../../"]
                                               (map (fn [up] (fs/path up repo-name "resources")))
                                               (filter fs/directory?)
                                               (first))]
                              (if-not sibling
                                (do (println (str "pkg-copy-sync: " repo-name
                                                  " not checked out as a sibling — skipped"))
                                    [])
                                (let [copy-set (rel-files copy-dir)
                                      repo-set (rel-files sibling)
                                      only-copy (sort (remove repo-set copy-set))
                                      only-repo (sort (remove copy-set repo-set))
                                      differing (->> (filter repo-set copy-set)
                                                     (remove (fn [rel]
                                                               (= (slurp (str (fs/path copy-dir rel)))
                                                                  (slurp (str (fs/path sibling rel))))))
                                                     (sort))
                                      describe (fn [suffix]
                                                 (fn [rel] (str "pkg-copy-sync: " rel " " suffix)))]
                                  (concat
                                    (map (describe (str "only in " copy-dir)) only-copy)
                                    (map (describe (str "only in " sibling)) only-repo)
                                    (map (describe (str "differs between " copy-dir
                                                        " and " sibling))
                                         differing))))))
               drift (concat (check-pair "external-packages/mathx/resources" "graphden-mathx")
                             (check-pair "external-packages/examples/resources" "graphden-examples"))]
           (when (seq drift)
             (run! println drift)
             (println "pkg-copy-sync: sync the edited side over the other (the monorepo copy is canonical for edits made here), then commit both.")
             (System/exit 1)))}

  actionlint
  {:doc "Lint GitHub Actions workflows via Docker rhysd/actionlint:1.7.7."
   :task (p/shell "docker" "run" "--rm"
                  "-v" (str (System/getenv "PWD") ":/repo")
                  "-w" "/repo"
                  "rhysd/actionlint:1.7.7" "-color")}

  lychee
  {:doc "Offline link-check (.md files) via Docker lycheeverse/lychee. External HTTP links are NOT contacted — run `bb lychee-online` for that. ALL exclusions live in .lychee.toml, which the GitHub job reads too — repeating them as flags is how the two drifted apart before."
   :task (p/shell "docker" "run" "--rm"
                  "-v" (str (System/getenv "PWD") ":/data")
                  "-w" "/data"
                  "lycheeverse/lychee:0.24.2-alpine"
                  "--config" ".lychee.toml"
                  "--offline" "--no-progress"
                  "**/*.md")}

  lychee-online
  {:doc "ONLINE link-check — verifies every external HTTP/HTTPS URL in docs. Slow + network-dependent; run before docs PRs, NOT on every `bb check`. Cached for 1 week (.lycheecache)."
   :task (p/shell "docker" "run" "--rm"
                  "-v" (str (System/getenv "PWD") ":/data")
                  "-w" "/data"
                  "lycheeverse/lychee:0.24.2-alpine"
                  "--config" ".lychee.toml"
                  "--no-progress"
                  "**/*.md")}

  trivy
  {:doc "Supply-chain CVE + Dockerfile misconfig scan via Docker aquasec/trivy:0.70.0. Caches vulnerability DB in /tmp/trivy-cache. Three passes: (1) IaC misconfig, (2) npm-lockfile CVE, (3) JVM/deps.edn CVE via the resolved classpath jars."
   :task (let [pwd (System/getenv "PWD")]
           (println "▶ trivy config (Dockerfile misconfig)")
           (p/shell "docker" "run" "--rm"
                    "-v" (str pwd ":/repo")
                    "-v" "/tmp/trivy-cache:/root/.cache/"
                    "-w" "/repo"
                    "aquasec/trivy:0.70.0"
                    "config" "--severity" "HIGH,CRITICAL"
                    "--skip-dirs" "node_modules,target,.tools"
                    ;; Path-scoped, documented misconfig exceptions for the
                    ;; dev/demo kind manifests (CRIU caps, stock-postgres fs).
                    ;; Not auto-detected — must be passed explicitly.
                    "--ignorefile" ".trivyignore.yaml"
                    "--exit-code" "1" "--quiet" ".")
           (println "▶ trivy fs (CVE in npm lockfiles)")
           (p/shell "docker" "run" "--rm"
                    "-v" (str pwd ":/repo")
                    "-v" "/tmp/trivy-cache:/root/.cache/"
                    "-w" "/repo"
                    "aquasec/trivy:0.70.0"
                    "fs" "--severity" "HIGH,CRITICAL"
                    "--skip-dirs" "node_modules,target,.tools,.playwright-mcp,.git,.lsp"
                    "--exit-code" "1" "--quiet" ".")
           ;; JVM CVE scan. This is a tools.deps project — no `pom.xml`, no jars
           ;; in the tree — so the `fs .` pass above finds ZERO Java deps. Feed
           ;; trivy the RESOLVED classpath jars instead: each jar carries its
           ;; `META-INF/.../pom.properties`, so trivy identifies the exact
           ;; group:artifact:version (full transitive set) and matches CVEs.
           ;; The prod classpath (`-Spath`, no aliases) = what the uberjar ships.
           ;; Git-deps resolve to source dirs, not jars, so they aren't covered
           ;; here (first-party graphden repos — no third-party CVE surface).
           (println "▶ trivy fs (CVE in JVM / deps.edn deps — resolved classpath jars)")
           (let [cp (-> (p/sh "clojure" "-Spath") :out str/trim)
                 jars (->> (str/split cp (re-pattern java.io.File/pathSeparator))
                           (filter (fn [x] (str/ends-with? x ".jar")))
                           (filter fs/exists?))
                 scan-dir (str pwd "/target/dep-scan")]
             (fs/create-dirs scan-dir)
             (try
               ;; Flatten each jar path to a unique name (trivy reads the jar's
               ;; embedded coordinates, not the filename), so same-named jars
               ;; from different groups can't collide in the scan dir.
               (doseq [j jars]
                 (fs/copy j (str scan-dir "/" (str/replace j (re-pattern "[/.]") "_") ".jar")
                          {:replace-existing true}))
               (println "  scanning" (count jars) "resolved jars")
               ;; `rootfs`, NOT `fs`: trivy's `fs` mode only reads build
               ;; lockfiles (pom.xml / package-lock.json) — it reports
               ;; "language-specific files num=0" on a directory of loose jars.
               ;; The `rootfs` scanner runs the Java `jar` analyzer, which reads
               ;; each jar's embedded pom.properties (→ group:artifact:version)
               ;; and matches CVEs. This is the mode that actually sees them.
               (p/shell "docker" "run" "--rm"
                        "-v" (str pwd ":/repo")
                        "-v" "/tmp/trivy-cache:/root/.cache/"
                        "-w" "/repo"
                        "aquasec/trivy:0.70.0"
                        "rootfs" "--severity" "HIGH,CRITICAL"
                        "--scanners" "vuln"
                        ;; honour the same documented-exception file as the
                        ;; config pass, so an accepted / unfixable-transitive
                        ;; JVM CVE can be listed rather than blocking the gate.
                        "--ignorefile" ".trivyignore.yaml"
                        "--exit-code" "1" "--quiet" "/repo/target/dep-scan")
               (finally (fs/delete-tree scan-dir)))))}

  license-check
  {:doc "Audit npm dep licenses against the allowlist of permissive licenses. Fails on any package outside MIT/BSD/Apache/ISC/CC0/Unlicense family. NOTE: npm scope ONLY — these are dev/build tooling (biome, commitlint, stylelint, markdownlint) that never ships. The runtime-shipped JVM deps in deps.edn are NOT license-gated here (trivy scans them for CVEs, not licenses); audit those separately before relying on AGPL compatibility."
   :task (let [allow (str/join ";"
                               ["MIT" "ISC" "BSD" "BSD-2-Clause" "BSD-3-Clause"
                                "Apache-2.0" "CC0-1.0" "Unlicense" "0BSD"
                                "Python-2.0" "MIT OR Apache-2.0" "MIT-0"
                                "Apache-2.0 OR MIT" "(MIT OR CC0-1.0)"])]
           (doseq [dir ["." "tools/browser-test" "tools/visual-tests"]]
             (println (str "▶ license-check " dir))
             ;; license-checker exits 0 on "No packages found in this path",
             ;; so a missing node_modules turns the audit into a silent no-op
             ;; that still reports green. Refuse to run rather than pretend.
             (when-not (fs/directory? (fs/path dir "node_modules"))
               (throw (ex-info (str "license-check: " dir "/node_modules is missing — "
                                    "the audit would pass without checking anything. "
                                    "Run 'npm ci' in " dir ".")
                               {:dir dir})))
             (p/shell {:dir dir}
                      "npx" "license-checker-rseidelsohn"
                      "--summary" "--onlyAllow" allow)))}

  commitlint
  {:doc "Lint the commit messages THIS branch adds on top of develop (merge-base..HEAD) against the conventional-commits rules in commitlint.config.cjs. Already-merged history is deliberately out of scope: its messages cannot be fixed without rewriting shared history, so linting them would produce a red CI nobody can act on — and would block every feature branch in the merge queue. On develop the range is empty and the check trivially passes. Pass an explicit range as `bb commitlint HEAD~5..HEAD` to audit a wider window by hand."
   :task (let [default-range
               (let [{:keys [exit out]} (p/shell {:out :string :err :string :continue true}
                                                 "git" "merge-base" "HEAD" "develop")]
                 (if (zero? exit)
                   (str (str/trim out) "..HEAD")
                   "HEAD~20..HEAD"))   ; no develop ref (shallow clone / fresh repo)
               range (or (first *command-line-args*) default-range)
               splitter (re-pattern "\\.\\.")
               parts (str/split range splitter)
               from (first parts)
               to (or (second parts) "HEAD")
               ;; commitlint 21 rejects --from X --to X ("point to the same
               ;; commit", exit 9), so an empty range is an error to it, not a
               ;; no-op. That is exactly the range on develop and in a freshly
               ;; claimed worktree — guard instead of handing it over.
               n-commits (-> (p/shell {:out :string :err :string :continue true}
                                      "git" "rev-list" "--count" (str from ".." to))
                             :out str/trim)]
           (println (str "▶ commitlint " range))
           (if (= "0" n-commits)
             (println "  no commits in range — nothing to lint")
             (p/shell "npx" "commitlint" "--from" from "--to" to)))}

  visual
  {:doc "Run Playwright visual-regression tests against running editor (default http://localhost:9002). Reads AUTH_TOKEN from env or .env. Use `bb visual-update` after intentional UI changes."
   :task (p/shell {:dir "tools/visual-tests"} "npx" "playwright" "test")}

  visual-update
  {:doc "Refresh visual-regression baselines (commit the updated PNGs after intentional UI changes)"
   :task (p/shell {:dir "tools/visual-tests"} "npx" "playwright" "test" "--update-snapshots")}

  ;; NOTE: Eastwood removed - incompatible with Clojure 1.12 qualified methods (Class/.method)
  ;; See: https://github.com/jonase/eastwood/issues/457

  ;; === TESTS ===

  ;; `bb test` runs the in-JVM parallel path (one runner, child NSs on a
  ;; bounded thread pool — wired by `:kaocha.plugin/parallel` in
  ;; `test/kaocha/plugin/parallel.clj`). Faster than the multi-process
  ;; path on most boxes because we pay container-startup once instead
  ;; of per-worker. NSs that redef process-wide vars carry `^:serial`
  ;; in their ns meta and run sequentially BEFORE the parallel pool.
  ;;
  ;; For targeted debugging or `--focus` flows, call kaocha directly:
  ;; `clojure -M:dev:test -m kaocha.runner --focus my.ns`.
  ;;
  ;; The multi-process path lives at `bb test-parallel` if a flake
  ;; reproduces only across separate JVMs.
  ;; -------------------------------------------------------------------
  ;; Test target matrix
  ;; -------------------------------------------------------------------
  ;; Tests split into THREE groups by what they exercise:
  ;;   - unit:        pure logic + light fixtures, in-JVM, ~4 min
  ;;   - integration: real PostgreSQL via testcontainers + full Ring
  ;;                  chain, in-JVM, ~14-17 min — the most expensive
  ;;                  thing the gate does, twice the cost of e2e
  ;;   - e2e:         Playwright browsers against a running graphden
  ;;                  deployment (Node, separate process), ~11 min
  ;;                  — requires `bb rebuild` first + AUTH_TOKEN env
  ;;
  ;; Those are measurements, taken from three consecutive landing gates:
  ;;   integration  841 / 928 / 998 s
  ;;   e2e          656 / 663 / 672 s  (the suite itself is 533-550 s of that;
  ;;                                    the rest is the isolated stack booting)
  ;;   unit         246 s as a process, 205 s of kaocha's own wall
  ;;
  ;; They replace ~1.5 / ~10-12 / ~15-25 min, which had drifted in BOTH
  ;; directions — integration was 40% dearer than advertised, e2e less than
  ;; half. `bb wt log <name>` prints this same per-phase breakdown for any gate
  ;; run, so the numbers are checkable rather than folklore, which is what the
  ;; old ones had quietly become.
  ;;
  ;; Group runners (single group):
  ;;   bb test-unit         — kaocha :unit suite
  ;;   bb test-integration  — kaocha :integration suite
  ;;   bb test-e2e          — Playwright browser-test suite
  ;;
  ;; Combinations:
  ;;   bb test-all              — unit + integration + e2e (sequential)
  ;;   bb test-unit-coverage    — unit with cloverage instrumentation
  ;;   bb test-all-coverage     — unit-with-coverage + integration + e2e
  ;;                              (cloverage covers unit, the rest runs
  ;;                               un-instrumented)
  ;;
  ;; What you can't do (by design):
  ;;   integration / e2e with cloverage — would add ~30 min wall for
  ;;   ~0% per-NS attribution: the CRUD NSes integration would
  ;;   exercise show 0% under cloverage anyway because cr/execute's
  ;;   compiled-closure cache bypasses the instrumented vars. See
  ;;   `bb coverage` docstring + `[[feedback_coverage_measurement]]`
  ;;   memory note for the empirical 2026-06-23 finding.
  ;;
  ;; CI uses `bb test-unit-coverage` (drops the separate unit-tests
  ;; check that was redundant once coverage runs the same suite with
  ;; cloverage on).

  test
  {:doc "Run unit + integration in one kaocha invocation. ~19 min (measured: unit ~4 + integration ~15). For e2e too see `bb test-all`. For fast unit-only feedback see `bb test-unit`."
   :task (clojure "-M:dev:test -m kaocha.runner")}

  test-unit
  {:doc "Unit tests only (skips ^:integration). ~4 min (measured: 246 s as a process, 205 s of kaocha wall; the old ~1.5 min was stale). Emits perf/runs/unit.edn — the report `bb perf` gates the suite-wide structural invariants against."
   :task (clojure {:extra-env {"GRAPHDEN_PERF_REPORT" "perf/runs/unit.edn"}}
                  "-M:dev:test -m kaocha.runner :unit")}

  test-js
  {:doc "JS tests that need NO graphden stack — the shared client runtime (tools/runtime-test/*.test.js: node's vm, no browser at all). NOT the type-system UI helpers: they were filed here on the belief they needed no server, but they read editor globals inside a LOADED page. A running demo instance masked that locally; GitHub CI (no stack) exposed it. Moving them to the e2e runner was tried and reverted — they pass against a warm instance and against `bb wt up`, but failed inside the e2e stack for a reason not reproducible outside it (that suite is gate-only). They stay manual, as documented in CLAUDE.md, until someone can debug them IN the gate; see docs/LAUNCH_PLAN.md future reserve."
   :task (let [;; dir → glob. Same contract as run-edit-tests.sh: adding a file
               ;; takes a glob, never an edit here.
               groups {"tools/runtime-test" "*.test.js"}
               failed (atom [])]
           (doseq [[dir pattern] groups
                   f (sort-by str (fs/glob dir pattern))
                   :let [file (str (fs/file-name f))
                         ;; `:dir` matters — each script resolves its imports
                         ;; relative to its own directory.
                         {:keys [exit]} (p/shell {:dir dir :continue true}
                                                 "node" file)]]
             (when-not (zero? exit)
               (swap! failed conj (str dir "/" file))))
           ;; `(deref failed)`, not `@failed` — bb.edn is read as EDN, where the
           ;; deref reader macro is not a thing.
           (if (seq (deref failed))
             (do (println (str red "✗ test-js: " (count (deref failed)) " failed" reset))
                 (doseq [f (deref failed)] (println (str "    " f)))
                 (System/exit 1))
             (println (str green "✓ test-js" reset))))}

  test-perf
  {:doc "Perf scenarios (focus ^:perf) — what each API-level operation costs in SQL round trips, written to perf/runs/perf.edn for `bb perf` to gate. ~1 min, nearly all of it the shared fixture. In-JVM + testcontainers only: no built image, so unlike the e2e suite this runs anywhere, CI included."
   ;; `--no-randomize` is load-bearing, not tidiness. The scenarios share one
   ;; `:once` graph, so a write scenario leaves the compiled registry in a
   ;; different state than it found it and the next read either pays for the
   ;; recompile or doesn't. Under kaocha's default randomisation that measured as
   ;; create-fn=18/tree=3 on one run and 20/1 on the next — the same total work
   ;; (21), redistributed by whichever went first. Per-scenario warm-up cannot fix
   ;; it: warm-up absorbs a scenario's own cold start, not its neighbour's edit.
   ;; With the flag: 20/1, twice, reproducibly. A budget on an irreproducible
   ;; count is a flake with a rationale.
   ;;
   ;; A flag rather than a config key, because kaocha has no per-suite randomize
   ;; toggle at all. `kaocha.plugin.randomize` reads
   ;; `:kaocha.plugin.randomize/randomize?` (or the `:randomize?` shorthand that
   ;; `kaocha.config/normalize` expands into it) from the ROOT of the config:
   ;; `normalize-test-suite` never renames it onto a suite map, and `post-load`
   ;; recurses the test-plan without consulting any per-testable key. The only
   ;; config-shaped answer would therefore disable randomisation for EVERY suite
   ;; — and only `:perf` needs determinism.
   ;;
   ;; (The first attempt put `:kaocha/randomize? false` on the suite. That is not
   ;; a kaocha key at any level — zero occurrences in the jar — so it rode along
   ;; as an inert entry, unread and unrejected: `s/keys` is open and no spec
   ;; claims it. The default `true` stood, the seed re-randomised per run, and
   ;; the counts kept flipping. Wrong name AND wrong level; either alone would
   ;; have been enough.)
   :task (clojure {:extra-env {"GRAPHDEN_PERF_REPORT" "perf/runs/perf.edn"}}
                  "-M:dev:test -m kaocha.runner :perf --no-randomize")}

  test-integration
  {:doc "Integration tests only (focus ^:integration; real PG via testcontainers). ~14-17 min — measured 841/928/998 s across three landing gates, and the single most expensive thing the gate does (twice e2e). The old ~10-12 min was 40% optimistic."
   :task (do (assert-gate-only! "bb test-integration")
             ;; documentation reporter: newline-terminated output. The
             ;; default dots reporter emits one giant unbroken line that
             ;; makes gate logs un-greppable (audit-6 log-hygiene).
             (clojure "-M:dev:test -m kaocha.runner :integration --reporter kaocha.report/documentation"))}

  test-e2e
  {:doc "Playwright browser-test suite against an ISOLATED ephemeral stack via Testcontainers (postgres + user-postgres + openbao + `graphden-executor:latest`, dynamic host ports, Ryuk reaps everything on JVM exit). Demo on :9002 stays untouched. Requires `bb rebuild` (or `bb deploy`) first so `graphden-executor:latest` is present. ~11 min end to end, measured 656/663/672 s across three landing gates: ~2 min for the stack to come healthy + ~9 min for the suite itself (533-550 s over 56 files). The old ~15-25 min figure for the suite was measured against the DEMO on :9002, where SWEEP_DELAY defaults to 2 s and the container bounces mid-sweep; this stack does neither. See `graphden.dev.e2e-stack`."
   :task (do (assert-gate-only! "bb test-e2e")
             (p/shell "clojure" "-M:dev" "-m" "graphden.dev.e2e-stack"
                      "tools/browser-test/run-edit-tests.sh"))}

  test-fleet-e2e
  {:doc "Two-container fleet e2e (kaocha :container-e2e) — boots `graphden-executor:latest` TWICE as a real two-pod fleet over a shared Postgres (testcontainers) and drives the cross-container control plane over real HTTP: /health, token-gated /internal/fleet/{status,cell/load}, shared graph, agreed placement view. Requires `bb rebuild` first so the image is present. ~4 min (two cold boots). Ryuk reaps the containers on JVM exit."
   :task (do (assert-gate-only! "bb test-fleet-e2e")
             (clojure "-M:dev:test -m kaocha.runner :container-e2e"))}

  test-all
  {:doc "Run ALL tests (unit + integration + e2e), sequential. ~30 min wall — the sum of three measured legs: ~4 (unit) + ~15 (integration) + ~11 (e2e). e2e requires `bb rebuild` first + AUTH_TOKEN."
   :task (do (p/shell "bb" "test-unit")
             (p/shell "bb" "test-integration")
             (p/shell "bb" "test-e2e"))}

  test-unit-coverage
  {:doc "Unit tests with cloverage instrumentation. ~15-19 min on a dev host — the full-graph tests (packages.registry / packages.export / executor.effect-gating) recompile the whole graph under instrumentation (~50× amplification); that's also where their real coverage of the loader/compiler comes from. Same as `bb coverage`. Use this for the coverage report; `bb test-unit` for fast feedback without instrumentation."
   :task (do (assert-gate-only! "bb coverage")
             (clojure "-M:dev:test -m kaocha.runner --config-file tests-coverage.edn :unit"))}

  test-all-coverage
  {:doc "Unit-with-coverage + integration + e2e. ~41-45 min — DERIVED, not measured: ~15-19 (unit-with-coverage, itself an unverified figure from `bb coverage`'s docstring) + ~15 (integration, measured) + ~11 (e2e, measured). Coverage covers unit only; integration / e2e run un-instrumented (see `bb coverage` docstring for why instrumenting integration adds zero useful per-NS signal). e2e runs in a separate Node process so cloverage can't reach it anyway."
   :task (do (p/shell "bb" "test-unit-coverage")
             (p/shell "bb" "test-integration")
             (p/shell "bb" "test-e2e"))}

  test-sequential
  {:doc "Run all tests sequentially in a single JVM (KAOCHA_PARALLELISM=1); use if a flake reproduces only sequentially."
   :task (p/shell {:extra-env {"KAOCHA_PARALLELISM" "1"}}
                  "clojure" "-M:dev:test" "-m" "kaocha.runner")}

  ;; Same as `bb test` but points all workers at the local docker-compose
  ;; `graphden-postgres` (port 5435) via `GRAPHDEN_TEST_PG_JDBC_URL` so
  ;; the workers skip spinning up their own testcontainer (saves
  ;; ~3-4 s per worker beyond the first). Requires `bb deploy` /
  ;; docker-compose up postgres first. The shared cluster is safe — each
  ;; worker still gets per-NS logical DBs (see
  ;; `graphden.test-infra.shared-container/ensure-ns-database!`); only
  ;; the bootstrap admin DB (`graphden`) is shared, and tests never
  ;; touch it directly.
  test-shared-pg
  {:doc "Run tests using the local docker-compose `graphden-postgres` (port 5435) for all workers."
   :task (let [n (or (first *command-line-args*) "4")]
           (p/shell {:extra-env {"GRAPHDEN_TEST_PG_JDBC_URL"
                                 "jdbc:postgresql://localhost:5435/graphden"
                                 "GRAPHDEN_TEST_PG_USERNAME" "graphden"
                                 "GRAPHDEN_TEST_PG_PASSWORD" "graphden"}}
                    "bb" "test-parallel" n))}

  ;; Parallel test runner — splits test namespaces across N worker JVMs
  ;; (default 4). Each worker spins up its OWN testcontainer (via the
  ;; shared-container plugin in tests.edn — shared inside a worker, not
  ;; across workers), so tests run isolated from each other. Worth ~2x
  ;; speedup on a quad-core dev box; the per-worker JVM + container
  ;; startup overhead (~6-8s) eats into the savings for very small test
  ;; subsets, so `bb test-sequential` exists as the single-process
  ;; escape hatch. CI may override the worker count via the first
  ;; argument: `bb test-parallel 8`.
  ;;
  ;; To skip per-worker testcontainer startup, set
  ;; `GRAPHDEN_TEST_PG_JDBC_URL` (and optionally `_USERNAME` /
  ;; `_PASSWORD`) — workers inherit env and connect to that cluster
  ;; instead. Useful when a docker-compose Postgres is already running;
  ;; see `bb test-shared-pg`.
  test-parallel
  {:doc "Run tests in parallel (N=4 by default; arg overrides)."
   :task (let [n (or (some-> (first *command-line-args*) Long/parseLong)
                     4)
               file->ns (fn [path]
                          (-> (str path)
                              (str/replace (re-pattern "^test/") "")
                              (str/replace (re-pattern "\\.clj$") "")
                              (str/replace "_" "-")
                              (str/replace "/" ".")))
               test-files (->> (fs/glob "test" "**/*_test.clj")
                               (map file->ns)
                               sort)
               ;; Stable round-robin assignment so total time is
               ;; balanced even when one chunk happens to land all the
               ;; slow integration tests.
               chunks (->> test-files
                           (map-indexed (fn [i ns] [(mod i n) ns]))
                           (group-by first)
                           (sort-by key)
                           vals
                           (map (fn [pairs] (map second pairs))))
               start (System/currentTimeMillis)
               procs (mapv (fn [chunk]
                             (let [focus-args (mapcat (fn [ns] ["--focus" ns]) chunk)
                                   args (concat ["clojure" "-M:dev:test"
                                                 "-m" "kaocha.runner"
                                                 "--reporter" "kaocha.report/dots"]
                                                focus-args)]
                               (apply p/process {:out :string :err :string} args)))
                           chunks)
               results (mapv deref procs)
               total-ms (- (System/currentTimeMillis) start)
               failures (filter (fn [r] (not= 0 (:exit r))) results)]
           (println (str cyan "Workers: " (count procs) "  Wall: "
                         (format "%.1fs" (/ total-ms 1000.0)) reset))
           (doseq [[i r] (map-indexed vector results)]
             (let [tail (->> (str/split-lines (:out r))
                             (filter (fn [line]
                                       (re-find (re-pattern "tests, .*assertions|FAIL|ERROR")
                                                line)))
                             last)]
               (println (str (if (zero? (:exit r)) green red)
                             "  worker " i ": " (or tail "(no summary)") reset))))
           (when (seq failures)
             (println (str red "✗ " (count failures) " worker(s) failed" reset))
             (doseq [{:keys [out err]} failures]
               (println out)
               (when (seq err) (println err)))
             (System/exit 1)))}

  coverage
  {:doc "Unit-only coverage (~15-19 min wall on a dev host; 2026-07-03: 72.26% form / 81.91% line — the run is dominated by the full-graph tests that recompile the whole graph under instrumentation, not by test count). Same as `bb test-unit-coverage` — kept for back-compat with scripts that already reference this name.

   Why unit-only: the integration suite (cron / services / secrets / storage / executor-runtime / branch-router / per-handler graph tests) doesn't add useful per-NS attribution under cloverage. Empirical 2026-06-23 finding: every CRUD NS that integration would exercise (`crud.entities`, `crud.fn-execution.*`, `crud.branches`, etc.) reports 0% form/line anyway — `cr/execute`'s pre-compiled closure cache (built by `cr/rebuild!`) holds already-resolved fn objects and never re-derefs through the instrumented vars. Confirmed identical under BOTH kaocha-cloverage AND a 2h32m sequential direct `clj -M:cloverage` audit (per-NS 0% identical). So adding integration to the cloverage pass costs ~30 min wall for ~0% useful per-NS signal; it ran via `bb test` / `bb test-integration` un-instrumented anyway. See `[[feedback_coverage_measurement]]` for the full reasoning.

   What the unit-only number tells you: 'do we need more UNIT tests?'. Low coverage for NSes like `system.demo-branches` (2.98%), `system.branch-router` (5.29%), `versioning.merge.core` (3.36%) here is BY DESIGN — those code paths get their gap-filling from integration tests, which we trust based on their pass/fail signal rather than cloverage attribution."
   :task (do (assert-gate-only! "bb coverage")
             (clojure "-M:dev:test -m kaocha.runner --config-file tests-coverage.edn :unit"))}

  ;; === FULL CHECK ===

  ;; CI check hierarchy — every task below delegates to the ONE runner
  ;; (scripts/ci.clj) over the ONE registry (scripts/checks.edn); no command is
  ;; duplicated. `--groups` selects which registry groups run.
  ;;
  ;;   individual:  bb kondo · bb cljstyle · bb biome · …   (each check's own task)
  ;;   sub-group:   bb lint-clj / lint-web / lint-infra / lint-docs / lint-sec
  ;;   group:       bb lint   = every linter (no unit tests) — fast pre-gate check
  ;;   group^2:     bb ci     = lint (fail-fast) -> unit tests
  ;;   the gate calls `bb ci`, so a stage runs at most once.
  perf-frontend
  {:doc "Measure what the editor's first paint asks the server for — API calls, KB, DOM nodes — into perf/runs/frontend.edn. Needs a RUNNING editor: `bb wt up` (isolated), then GRAPHDEN_URL=http://localhost:<your-port> bb perf-frontend. Human-invoked like `bb visual`, and for the same reason: it needs a built, running instance, which GitHub Actions does not have."
   :task (p/shell {:dir "tools/browser-test"} "node" "perf-frontend.js")}

  perf
  {:doc "Compare this run's structural counters against perf/budgets.edn. Reads perf/runs/*.edn, which the suites write themselves — so run `bb test-unit` first. Counts, not timings: it cannot fail because the box was busy."
   :task (load-file "scripts/perf.clj")}

  perf-update
  {:doc "Rewrite perf/budgets.edn from the current perf/runs/*.edn readings, then commit the diff (same loop as `bb visual-update`). Says loudly which budgets it RAISES — a raise is a regression being accepted."
   :task (binding [*command-line-args* ["--update"]]
           (load-file "scripts/perf.clj"))}

  ci
  {:doc "Full CI: lint (fail-fast) then unit tests, over scripts/checks.edn. ~4 min. Flags: --since <ref> diff-scopes (checks with no :relevant changed files are skipped, visibly); --skip <names/groups> force-skips; --groups <g,…> restricts."
   :task (load-file "scripts/ci.clj")}

  ci-test
  {:doc "Self-test of the CI selection core (scripts/ci_select.clj) + checks.edn validation. Runs inside bb ci as the ci-selftest check."
   :task (load-file "scripts/ci_select_test.clj")}

  lint
  {:doc "Every linter, parallel, NO unit tests — the fast pre-gate check (~1 min)."
   :task (binding [*command-line-args* ["--groups" "clj,web,infra,docs,sec,commit"]]
           (load-file "scripts/ci.clj"))}

  check
  {:doc "Alias for `bb lint` (kept for muscle memory / docs)."
   :task (binding [*command-line-args* ["--groups" "clj,web,infra,docs,sec,commit"]]
           (load-file "scripts/ci.clj"))}

  lint-clj
  {:doc "Clojure linters (kondo/splint/cljstyle) — after editing .clj."
   :task (binding [*command-line-args* ["--groups" "clj"]] (load-file "scripts/ci.clj"))}

  lint-web
  {:doc "Editor JS/CSS linters (biome/stylelint) — after editing the editor UI."
   :task (binding [*command-line-args* ["--groups" "web"]] (load-file "scripts/ci.clj"))}

  lint-infra
  {:doc "Script/Dockerfile/workflow linters (shellcheck/hadolint/actionlint)."
   :task (binding [*command-line-args* ["--groups" "infra"]] (load-file "scripts/ci.clj"))}

  lint-docs
  {:doc "Docs linters (markdownlint/lychee/typos) — after editing docs."
   :task (binding [*command-line-args* ["--groups" "docs"]] (load-file "scripts/ci.clj"))}

  lint-sec
  {:doc "Security linters (gitleaks/trivy/license-check)."
   :task (binding [*command-line-args* ["--groups" "sec"]] (load-file "scripts/ci.clj"))}

  wt
  {:doc "Parallel feature dev + merge queue (dev/wtq/README.md). Usage: bb wt <new|start|task|list|merge|status|log|drop|help> ..."
   :task (let [root (-> (p/shell {:out :string} "git" "rev-parse" "--show-toplevel")
                        :out str/trim)
               ;; :continue so a non-zero child (e.g. a failing gate) propagates
               ;; as a clean exit code, not a babashka stack trace.
               res (apply p/shell {:continue true} (str root "/dev/wtq/wt")
                          *command-line-args*)]
           (System/exit (:exit res)))}

  ;; === HELPERS ===

  fix
  {:doc "Auto-fix formatting [path]"
   :task (clojure (str "-M:cljstyle fix " (or (first *command-line-args*) all-paths)))}

  outdated
  {:doc "Check outdated dependencies"
   :task (clojure "-M:outdated")}

  security
  {:doc "Scan for CVE vulnerabilities (set GITHUB_TOKEN or NVD_API_KEY, or use --slow)"
   :task (let [github-token (System/getenv "GITHUB_TOKEN")
               nvd-api-key (System/getenv "NVD_API_KEY")
               slow-mode? (some #{"--slow"} *command-line-args*)
               warn-color "\u001b[33m"
               reset-color "\u001b[0m"
               props-file ".clj-watson.properties"]
           (cond
             ;; Prefer GitHub Advisory (faster)
             (and github-token (not (str/blank? github-token)))
             (do
               (println "Using GitHub Advisory Database...")
               (clojure "-M:watson -p deps.edn -t github-advisory"))

             ;; Fall back to NVD with API key
             (and nvd-api-key (not (str/blank? nvd-api-key)))
             (do
               (println "Using NVD Database...")
               (spit props-file (str "nvd.api.key=" nvd-api-key))
               (try
                 (clojure (str "-M:watson -p deps.edn -t dependency-check -w " props-file))
                 (finally
                   (fs/delete-if-exists props-file))))

             ;; Slow mode without API key
             slow-mode?
             (do
               (println (str warn-color "Running in slow mode without API key..." reset-color))
               (clojure "-M:watson -p deps.edn -t dependency-check --run-without-nvd-api-key"))

             ;; No tokens - show help
             :else
             (do
               (println (str warn-color "No API tokens configured." reset-color))
               (println)
               (println "Options:")
               (println "  1. Set GITHUB_TOKEN (recommended, fastest):")
               (println "     export GITHUB_TOKEN=ghp_...")
               (println "     Get at: https://github.com/settings/tokens")
               (println)
               (println "  2. Set NVD_API_KEY (more comprehensive):")
               (println "     export NVD_API_KEY=...")
               (println "     Get at: https://nvd.nist.gov/developers/request-an-api-key")
               (println)
               (println "  3. Run without API key (very slow, 10+ minutes):")
               (println "     bb security --slow")
               (System/exit 1))))}

  bench
  {:doc "Run performance benchmarks [--quick]"
   :task (clojure (str "-M:bench -m graphden.bench " (str/join " " *command-line-args*)))}

  ;; === DOCKER DEPLOYMENT ===

  ssh-key
  {:doc "Load an SSH key into a FIXED-socket agent that every `bb` task shares, so `bb rebuild` can clone the private mathx repo without an `export SSH_AUTH_SOCK` in your rc. Usage: bb ssh-key [keyfile]. Default key: first of ~/.ssh/{id_ed25519,id_ecdsa,id_rsa}. Run it once per boot (or after a passphrase timeout)."
   :task
   (let [home (System/getenv "HOME")
         key (or (first *command-line-args*)
                 (->> ["id_ed25519" "id_ecdsa" "id_rsa"]
                      (map (fn [n] (str home "/.ssh/" n)))
                      (filter fs/exists?)
                      first))]
     (when-not key
       (println (str red "No key in ~/.ssh (id_ed25519/id_ecdsa/id_rsa). Pass one: "
                     yellow "bb ssh-key <path>" reset))
       (System/exit 1))
     ;; ssh-add -l exit codes: 0 = agent up w/ keys, 1 = up but empty,
     ;; 2 = cannot connect. Only 2 means we must (re)spawn the agent.
     (let [probe (p/shell {:out :string :err :string :continue true
                           :extra-env {"SSH_AUTH_SOCK" gd-ssh-sock}}
                          "ssh-add" "-l")]
       (when (= 2 (:exit probe))
         (fs/delete-if-exists gd-ssh-sock)
         (p/shell {:out :string :err :string} "ssh-agent" "-a" gd-ssh-sock)))
     (println (str "Loading " key " into agent at " gd-ssh-sock " ..."))
     ;; Interactive on purpose: an encrypted key prompts for its passphrase,
     ;; so run this via `! bb ssh-key` (in your session shell), not headless.
     (p/shell {:extra-env {"SSH_AUTH_SOCK" gd-ssh-sock}} "ssh-add" key)
     (p/shell {:extra-env {"SSH_AUTH_SOCK" gd-ssh-sock}} "ssh-add" "-l")
     (println (str green "✓ Key loaded. `bb rebuild` will now use it." reset)))}

  rebuild
  {:doc "Rebuild jar + docker and restart the CANONICAL instance (keeps DB data). In an agent worktree this refuses to run unless GD_INSTANCE is set — use `bb wt up` for your own isolated stack. Needs the private mathx clone over SSH: run `bb ssh-key` first (see that task)."
   :task (do
           (assert-not-clobbering-shared-stack! "bb rebuild")

           (println "1. Building uberjar...")
           (p/shell (ssh-env) "clojure -T:build uber")

           (println "2. Rebuilding docker image...")
           (p/shell "docker-compose build executor")

           (println "3. Restarting container + waiting for server...")
           (instance-up!))}

  instance-up
  {:doc "Start/refresh the instance from the ALREADY-BUILT image, then wait for health + `bb verify` + `bb smoke`. No jar, no docker build. The landing gate uses this to advance the develop instance onto the image it built in the feature worktree, under the queue lock."
   :task (do
           (assert-not-clobbering-shared-stack! "bb instance-up")
           (instance-up!))}

  instance-reset
  {:doc "Drop the instance's schema, then force-recreate it from the ALREADY-BUILT image so the graph re-seeds. The gate's `--deploy` path uses this when a branch changes the schema; a plain landing keeps the data."
   :task (do
           (assert-not-clobbering-shared-stack! "bb instance-reset")
           (println "1. Resetting database schema...")
           (p/shell (str "docker exec " gd-instance "-postgres"
                         " psql -U graphden -d graphden -c"
                         " \"DROP SCHEMA public CASCADE; CREATE SCHEMA public;\""))
           (println "2. Force-recreating container + waiting for server...")
           ;; --force-recreate: the image may be byte-identical to the running
           ;; one, and compose would then do nothing — but the schema underneath
           ;; it was just dropped, so the executor MUST re-bootstrap.
           (p/shell "docker-compose up -d --force-recreate executor")
           (await-healthy-then-verify!))}

  deploy
  {:doc "Build and deploy to docker (clean rebuild with DB truncate). Same worktree guard as `bb rebuild`."
   :task (do
           (assert-not-clobbering-shared-stack! "bb deploy")

           (println "1. Cleaning target...")
           (fs/delete-tree "target")
           (fs/create-dirs "target")

           (println "2. Building uberjar...")
           (p/shell "clojure -T:build uber")

           (println "3. Resetting database schema...")
           (p/shell (str "docker exec " gd-instance "-postgres"
                         " psql -U graphden -d graphden -c"
                         " \"DROP SCHEMA public CASCADE; CREATE SCHEMA public;\""))

           (println "4. Rebuilding docker image...")
           (p/shell "docker-compose build --no-cache executor")

           (println "5. Restarting container + waiting for server...")
           (instance-up!))}

  smoke
  {:doc "Run smoke tests against a running instance: editor page, graph layout (collapsed + expanded), auth challenge. Usage: bb smoke [http://host:port]"
   :requires ([babashka.http-client :as http]
              [cheshire.core :as json]
              [clojure.java.io :as io]
              [clojure.string :as str])
   :task
   (let [raw-url (or (first *command-line-args*) "http://localhost:9002")
         base-url (if (str/ends-with? raw-url "/") (subs raw-url 0 (dec (count raw-url))) raw-url)
         ;; Read AUTH_TOKEN from the shell env, falling back to `.env` — the
         ;; SAME source docker-compose substitutes into the instance, so the
         ;; smoke authenticates as the instance it's probing even when the token
         ;; lives only in `.env` (the gate's post-land demo advance runs compose
         ;; off `.env`, but the smoke process's shell env has no AUTH_TOKEN).
         ;; `bb wt up` worktrees have no `.env` → token blank → the instance is
         ;; auth-OFF (open) and the empty bearer below is exactly right.
         token (or (not-empty (System/getenv "AUTH_TOKEN"))
                   (some-> (let [f (io/file ".env")] (when (.exists f) (slurp f)))
                           (->> (re-find (re-pattern "(?m)^AUTH_TOKEN=(.+)$")))
                           second
                           str/trim
                           not-empty))
         ;; The graph-data routes (entities / layout / types / value-form) are
         ;; auth-required now (the anonymous graph view was removed). Send the
         ;; bearer on them when a token is known (auth active); with no token
         ;; auth is OFF and they're open, so an empty opts map works too. The
         ;; auth/check challenges below deliberately DON'T use this (they assert
         ;; the 401 path), so keep it off the bare `get*`/`post-json` defaults.
         auth-opts (if (str/blank? token) {} {:headers {"Authorization" (str "Bearer " token)}})
         results (atom [])
         step (fn [name pred-fn]
                (let [outcome (try (pred-fn) (catch Throwable e {:ok? false :detail (.getMessage e)}))
                      {:keys [ok? detail]} outcome
                      mark (if ok? (str green "✓" reset) (str red "✗" reset))]
                  (println (format "  %s %s%s" mark name (if detail (str " — " detail) "")))
                  (swap! results conj ok?)
                  outcome))
         get* (fn [path & [opts]]
                (http/get (str base-url path) (merge {:throw false} opts)))
         post-json (fn [path payload & [opts]]
                     (http/post (str base-url path)
                                ;; Merge headers rather than let `opts` (e.g.
                                ;; auth-opts' Authorization) REPLACE the whole
                                ;; :headers map and drop Content-Type — that
                                ;; silently unset the JSON content-type so the
                                ;; body wasn't parsed ("must include 'expected'").
                                (-> (merge {:throw false :body (json/generate-string payload)} opts)
                                    (assoc :headers (merge {"Content-Type" "application/json"}
                                                           (:headers opts))))))]
     (println (str cyan "Smoke testing " base-url reset))

     (step "GET /                          editor page renders"
           (fn []
             (let [r (get* "/")]
               (cond
                 (not= 200 (:status r))
                 {:ok? false :detail (str "HTTP " (:status r))}

                 (not (str/includes? (:body r) "id=\"graph-surface\""))
                 {:ok? false :detail "no #graph-surface in body"}

                 ;; Without `<script src="/assets/editor.js">` the
                 ;; page loads as a blank skeleton — see the
                 ;; 2026-06-23 hiccup-postwalk regression where an
                 ;; inline `<script>` sibling silently dropped this
                 ;; tag from the rendered HTML. Cheap structural
                 ;; check, catches the whole class.
                 (not (str/includes? (:body r) "src=\"/assets/editor.js"))
                 {:ok? false :detail "no editor.js <script src> in body — editor will not bootstrap"}

                 (not (str/includes? (:body r) "src=\"/assets/api-routes.js"))
                 {:ok? false :detail "no api-routes.js <script src> in body — window.API will be undefined"}

                 (not (str/includes? (:body r) "href=\"/assets/editor.css"))
                 {:ok? false :detail "no editor.css <link> in head — page will render unstyled"}

                 :else {:ok? true}))))

     (let [entities-resp (step "GET /api/graph/entities       returns JSON with fns"
                               (fn []
                                 (let [r (get* "/api/graph/entities" auth-opts)]
                                   (cond
                                     (not= 200 (:status r)) {:ok? false :detail (str "HTTP " (:status r))}
                                     :else
                                     (let [parsed (json/parse-string (:body r) true)
                                           fns (:fns parsed)]
                                       (if (and (sequential? fns) (seq fns))
                                         {:ok? true :data parsed}
                                         {:ok? false :detail "no :fns / empty"}))))))
           ;; Pick a "rich" fn to expand — one that actually has children
           ;; via parent-id chains. `web-server` is a stable choice on
           ;; this codebase.
           target-fn (when (:ok? entities-resp)
                       (->> entities-resp :data :fns
                            (filter (fn [f] (= "web-server" (:name f))))
                            first))
           target-id (some-> target-fn :id)
           collapsed-resp (step "POST /api/graph/layout (no expansions)  returns nodes"
                                (fn []
                                  (if-not target-id
                                    {:ok? false :detail "couldn't find :web-server fn for layout test"}
                                    (let [r (post-json "/api/graph/layout"
                                                       {"root-id" target-id "expansions" {}}
                                                       auth-opts)]
                                      (cond
                                        (not= 200 (:status r)) {:ok? false :detail (str "HTTP " (:status r))}
                                        :else
                                        (let [parsed (json/parse-string (:body r) true)
                                              nodes (:nodes parsed)]
                                          (if (and (sequential? nodes) (>= (count nodes) 1))
                                            {:ok? true :node-count (count nodes)}
                                            {:ok? false :detail "no nodes returned"})))))))]
       (step "POST /api/graph/layout (with expansion)  endpoint accepts spec"
             (fn []
               (cond
                 (not (:ok? collapsed-resp)) {:ok? false :detail "skipped — collapsed layout failed"}
                 :else
                 (let [root-node-id (str "fn-" target-id)
                       r (post-json "/api/graph/layout"
                                    {"root-id" target-id
                                     "expansions" {root-node-id {"full-depth" 3
                                                                 "partial-fns" []}}}
                                    auth-opts)]
                   (cond
                     (not= 200 (:status r)) {:ok? false :detail (str "HTTP " (:status r))}
                     :else
                     (let [parsed (json/parse-string (:body r) true)
                           n (count (:nodes parsed))]
                       (if (and (sequential? (:nodes parsed)) (>= n 1))
                         {:ok? true :detail (str n " nodes")}
                         {:ok? false :detail "no nodes in expanded layout"})))))))

       (step "POST /api/value-form (binding)         → {ok:true} + form hiccup"
             (fn []
               (let [vb (when (:ok? entities-resp)
                          (->> entities-resp :data :bindings
                               (filter (fn [b] (some? (:value b))))
                               first))]
                 (if-not vb
                   {:ok? false :detail "no value-binding to test"}
                   (let [r (post-json "/api/value-form" {"binding-id" (:id vb)} auth-opts)
                         parsed (when (= 200 (:status r))
                                  (json/parse-string (:body r) true))]
                     (cond
                       (not= 200 (:status r)) {:ok? false :detail (str "HTTP " (:status r))}
                       (not (true? (:ok parsed))) {:ok? false :detail (str "expected ok=true — " (pr-str parsed))}
                       (not (vector? (:form parsed))) {:ok? false :detail "no :form hiccup"}
                       :else {:ok? true})))))))

     ;; Phase 1 type-API: subtype check + candidate enumeration.
     (step "POST /api/types/compatible (int ⊆ int)    → {ok:true}"
           (fn []
             (let [r (post-json "/api/types/compatible"
                                {"expected" "int" "candidate" "int"} auth-opts)
                   parsed (when (= 200 (:status r))
                            (json/parse-string (:body r) true))]
               (cond
                 (not= 200 (:status r)) {:ok? false :detail (str "HTTP " (:status r))}
                 (not (true? (:ok parsed))) {:ok? false :detail (str "expected ok=true, got " (pr-str parsed))}
                 :else {:ok? true}))))

     (step "POST /api/types/compatible (text ⊄ int)  → {ok:false :reason}"
           (fn []
             (let [r (post-json "/api/types/compatible"
                                {"expected" "int" "candidate" "text"} auth-opts)
                   parsed (when (= 200 (:status r))
                            (json/parse-string (:body r) true))]
               (cond
                 (not= 200 (:status r)) {:ok? false :detail (str "HTTP " (:status r))}
                 (not (false? (:ok parsed))) {:ok? false :detail "expected ok=false"}
                 (str/blank? (:reason parsed)) {:ok? false :detail "missing :reason"}
                 :else {:ok? true}))))

     (step "POST /api/types/candidates (expected=int)  → non-empty candidates"
           (fn []
             (let [r (post-json "/api/types/candidates" {"expected" "int"} auth-opts)
                   parsed (when (= 200 (:status r))
                            (json/parse-string (:body r) true))]
               (cond
                 (not= 200 (:status r)) {:ok? false :detail (str "HTTP " (:status r))}
                 (not (pos? (:count parsed 0))) {:ok? false :detail "no candidates returned"}
                 :else {:ok? true :detail (str (:count parsed) " candidates")}))))

     (step "POST /api/types/candidates (effects=[])    → pure subset only"
           (fn []
             (let [r-all (post-json "/api/types/candidates" {"expected" "int"} auth-opts)
                   r-pure (post-json "/api/types/candidates" {"expected" "int" "effects" []} auth-opts)
                   all-n (some-> r-all :body (json/parse-string true) :count)
                   pure-n (some-> r-pure :body (json/parse-string true) :count)]
               (cond
                 (or (not all-n) (not pure-n)) {:ok? false :detail "request failed"}
                 (> pure-n all-n) {:ok? false :detail "pure subset must be ≤ all"}
                 :else {:ok? true :detail (str pure-n " pure ≤ " all-n " total")}))))

     ;; Challenge probes are AUTH-MODE-AWARE (B3): with a known token the
     ;; instance runs auth-ON and must challenge; with none it runs auth-OFF
     ;; (no provider — e.g. a `bb wt up` worktree stack with no .env) and the
     ;; same route must serve OPENLY. Both are asserted so a mode regression
     ;; fails loudly either way.
     (if token
       (do
         (step "GET /api/auth/check (no token)      → 401 challenge"
               (fn []
                 (let [r (get* "/api/auth/check")]
                   (if (= 401 (:status r))
                     {:ok? true}
                     {:ok? false :detail (str "HTTP " (:status r) " (expected 401)")}))))
         (step "GET /api/auth/check (wrong token)   → 401 challenge"
               (fn []
                 (let [r (get* "/api/auth/check"
                               {:headers {"Authorization" "Bearer this-is-not-the-token"}})]
                   (if (= 401 (:status r))
                     {:ok? true}
                     {:ok? false :detail (str "HTTP " (:status r) " (expected 401)")})))))
       (step "GET /api/auth/check (no AUTH_TOKEN)  → 200 (auth off → open)"
             (fn []
               (let [r (get* "/api/auth/check")]
                 (if (= 200 (:status r))
                   {:ok? true}
                   {:ok? false :detail (str "HTTP " (:status r) " (expected 200 — auth-off instance must serve openly)")})))))

     (when token
       (step "GET /api/auth/check (env AUTH_TOKEN)  → 200 ok"
             (fn []
               (let [r (get* "/api/auth/check"
                             {:headers {"Authorization" (str "Bearer " token)}})]
                 (cond
                   (not= 200 (:status r)) {:ok? false :detail (str "HTTP " (:status r))}
                   (not= "ok" (str/trim (or (:body r) ""))) {:ok? false :detail (str "body=" (pr-str (:body r)))}
                   :else {:ok? true}))))
       nil)
     (when-not token
       (println (str cyan "  (set AUTH_TOKEN env to also test successful login)" reset)))

     (let [ok-count (count (filter true? (deref results)))
           fail-count (count (filter false? (deref results)))]
       (if (zero? fail-count)
         (println (str green "✓ smoke OK — " ok-count " checks passed" reset))
         (do (println (str red "✗ smoke FAILED — " fail-count " of " (+ ok-count fail-count) " checks failed" reset))
             (System/exit 1)))))}

  clean
  {:doc "Clean generated files"
   :task (do
           (fs/delete-tree "target")
           (fs/delete-tree ".cpcache")
           (fs/delete-tree ".clj-kondo/.cache")
           (println (str green "✓ Cleaned" reset)))}

  verify
  {:doc "Compare a running instance's /version per-section build hashes with the local source tree. Usage: bb verify [http://host:port]"
   :requires ([babashka.http-client :as http]
              [cheshire.core :as json])
   :task
   (let [raw-url (or (first *command-line-args*) "http://localhost:9002")
         base-url (if (str/ends-with? raw-url "/") (subs raw-url 0 (dec (count raw-url))) raw-url)
         version-url (str base-url "/version")
         ;; Section partitioning — must mirror `section-of` in build.clj.
         in-packages? (fn [rel] (str/starts-with? rel "packages/"))
         section-of (fn [rel]
                      (let [front-suffixes [".js" ".css" ".html" ".svg"]
                            pkg-suffixes [".edn" ".clj" ".cljc"]
                            back-suffixes [".clj" ".cljc" ".cljs" ".edn" ".sql" ".xml" ".sh"]
                            ends? (fn [suffixes] (some (fn [s] (str/ends-with? rel s)) suffixes))]
                        (cond
                          (and (in-packages? rel) (ends? front-suffixes)) :frontend
                          (and (in-packages? rel) (ends? pkg-suffixes))   :packages
                          (ends? back-suffixes)                           :backend)))
         walk-tree (fn [^String root]
                     ;; Returns [rel-path File] tuples; rel-path is
                     ;; relative to `root`, matching build.clj's
                     ;; class-dir-relative layout (copy-dir flattens
                     ;; src/ and resources/ into class-dir).
                     (let [root-file (java.io.File. root)
                           root-path (.toPath root-file)]
                       (when (.exists root-file)
                         (->> (file-seq root-file)
                              (filter (fn [^java.io.File f] (.isFile f)))
                              (map (fn [^java.io.File f]
                                     [(-> (.relativize root-path (.toPath f)) str
                                          (str/replace java.io.File/separator "/"))
                                      f]))))))
         entries (->> (concat (walk-tree "src") (walk-tree "resources"))
                      (sort-by first))
         init-mds {:frontend (java.security.MessageDigest/getInstance "SHA-256")
                   :packages (java.security.MessageDigest/getInstance "SHA-256")
                   :backend  (java.security.MessageDigest/getInstance "SHA-256")}
         sep (byte-array 1 (byte 0))
         _ (doseq [[rel ^java.io.File f] entries
                   :let [sec (section-of rel)]
                   :when sec]
             (let [^java.security.MessageDigest md (get init-mds sec)]
               (.update md (.getBytes ^String rel "UTF-8"))
               (.update md sep)
               (.update md (java.nio.file.Files/readAllBytes (.toPath f)))
               (.update md sep)))
         hex (fn [^java.security.MessageDigest md]
               (apply str (map (fn [b] (format "%02x" (bit-and ^byte b 0xff))) (.digest md))))
         local {:frontend (hex (:frontend init-mds))
                :backend  (hex (:backend init-mds))
                :packages (hex (:packages init-mds))}
         resp (try (http/get version-url {:throw false})
                   (catch Throwable e {:error (.getMessage e)}))
         remote (when (and (= 200 (:status resp)) (:body resp))
                  (try (json/parse-string (:body resp) true)
                       (catch Throwable _ nil)))
         row (fn [label local-h remote-h]
               (let [match? (= local-h remote-h)]
                 (println (format "  %-9s %s %s"
                                  (str (name label) ":")
                                  (subs local-h 0 12)
                                  (if match?
                                    (str green "✓ matches" reset)
                                    (str red "✗ differs (remote " (when remote-h (subs remote-h 0 12)) ")" reset))))
                 match?))]
     (println (str cyan "URL: " reset version-url))
     (cond
       (nil? remote)
       (do (println (str red "✗ couldn't fetch /version: " (or (:error resp) (:status resp)) reset))
           (System/exit 2))
       :else
       (let [results (mapv (fn [k] (row k (get local k) (get remote k)))
                           [:frontend :packages :backend])]
         (if (every? identity results)
           (println (str green "✓ MATCH — every section ships exactly this source" reset))
           (do (println (str red "✗ MISMATCH — some section is out of date or different" reset))
               (System/exit 1))))))}

  effects
  {:doc "Effects breakdown for a running instance — counts fn-defs per :effects category and reports any drift between computed and declared :expects-effects. Usage: bb effects [http://host:port]"
   :requires ([babashka.http-client :as http]
              [cheshire.core :as json]
              [clojure.set :as set])
   :task
   (let [raw-url (or (first *command-line-args*) "http://localhost:9002")
         base-url (if (str/ends-with? raw-url "/") (subs raw-url 0 (dec (count raw-url))) raw-url)
         types-url (str base-url "/api/types")
         resp (try (http/get types-url {:throw false})
                   (catch Throwable e {:error (.getMessage e)}))
         body (when (and (= 200 (:status resp)) (:body resp))
                (try (json/parse-string (:body resp) true)
                     (catch Throwable _ nil)))]
     (println (str cyan "URL: " reset types-url))
     (cond
       (nil? body)
       (do (println (str red "✗ couldn't fetch /api/types: "
                         (or (:error resp) (:status resp)) reset))
           (System/exit 2))

       :else
       (let [total (count body)
             by-cat (reduce-kv (fn [acc fn-name info]
                                 (reduce (fn [a t] (update a t (fnil conj []) fn-name))
                                         acc
                                         (:effects info)))
                               {} body)
             effectful-total (count (filter (fn [[_ v]] (seq (:effects v))) body))
             drifters (->> body
                           (keep (fn [[fn-name info]]
                                   (let [d (set (:expects-effects info))
                                         c (set (:effects info))]
                                     (when (seq d)
                                       (let [unexpected (set/difference c d)
                                             over       (set/difference d c)]
                                         (when (or (seq unexpected) (seq over))
                                           {:name fn-name
                                            :declared d
                                            :computed c
                                            :drift unexpected
                                            :over over}))))))
                           (sort-by :name))]
         (println (str cyan "▶ effects breakdown" reset
                       "  (effectful " effectful-total " of " total ")"))
         (doseq [tag (sort (keys by-cat))]
           (let [fns (sort (by-cat tag))]
             (println (format "  %-10s (%3d)  %s%s"
                              (name tag)
                              (count fns)
                              (str/join ", " (take 6 fns))
                              (if (> (count fns) 6) (format " … +%d more" (- (count fns) 6)) "")))))
         (println)
         (cond
           (empty? drifters)
           (println (str green "✓ no :expects-effects drift" reset))
           :else
           (do (println (str yellow "⚠ drift in " (count drifters) " fn-def(s):" reset))
               (doseq [{nm :name :keys [declared computed drift over]} drifters]
                 (println (format "  %s" (clojure.core/name nm)))
                 (when (seq drift)
                   (println (format "    DRIFT (computed but not declared): %s"
                                    (str/join ", " (sort (map clojure.core/name drift))))))
                 (when (seq over)
                   (println (format "    over-declared (declared but not computed): %s"
                                    (str/join ", " (sort (map clojure.core/name over))))))
                 (println (format "    declared: %s  computed: %s"
                                  (str/join "," (sort (map clojure.core/name declared)))
                                  (str/join "," (sort (map clojure.core/name computed))))))
               ;; Only EXIT non-zero when at least one fn-def had REAL
               ;; drift (computed effect not in :expects-effects).
               ;; Over-declaration alone is harmless.
               (when (some (fn [{:keys [drift]}] (seq drift)) drifters)
                 (System/exit 1)))))))}

  types-drift
  {:doc "Return-type drift report for a running instance — lists fn-defs whose declared :return-type is strictly wider than the rule-computed return (advisory: declaration may be deliberately wide). Usage: bb types-drift [http://host:port]"
   :requires ([babashka.http-client :as http]
              [cheshire.core :as json])
   :task
   (let [raw-url (or (first *command-line-args*) "http://localhost:9002")
         base-url (if (str/ends-with? raw-url "/") (subs raw-url 0 (dec (count raw-url))) raw-url)
         types-url (str base-url "/api/types")
         resp (try (http/get types-url {:throw false})
                   (catch Throwable e {:error (.getMessage e)}))
         body (when (and (= 200 (:status resp)) (:body resp))
                (try (json/parse-string (:body resp) true)
                     (catch Throwable _ nil)))]
     (println (str cyan "URL: " reset types-url))
     (cond
       (nil? body)
       (do (println (str red "✗ couldn't fetch /api/types: "
                         (or (:error resp) (:status resp)) reset))
           (System/exit 2))

       :else
       (let [drifters (->> body
                           (keep (fn [[fn-name info]]
                                   (when-let [d (:return-type-drift info)]
                                     {:name fn-name
                                      :declared (:declared d)
                                      :computed (:computed d)
                                      :source-file (:source-file info)
                                      :source-line (:source-line info)})))
                           (sort-by :name))]
         (println (str cyan "▶ return-type drift" reset
                       "  (" (count drifters) " fn-def(s) of " (count body) " total)"))
         (cond
           (empty? drifters)
           (println (str green "✓ no return-type drift" reset))
           :else
           (do (doseq [{nm :name :keys [declared computed source-file source-line]}
                       drifters]
                 (println (format "  %s" (clojure.core/name nm)))
                 (println (format "    declared: %s" (pr-str declared)))
                 (println (format "    computed: %s" (pr-str computed)))
                 (when source-file
                   (println (format "    at %s%s" source-file
                                    (if source-line (str ":" source-line) "")))))
               ;; Advisory only — exit 0 even on drift. Tighten to
               ;; exit 1 once authors have cleaned up the existing
               ;; backlog (per the task spec).
               (println (str yellow "⚠ advisory — declarations may be deliberately wide" reset)))))))}}}
