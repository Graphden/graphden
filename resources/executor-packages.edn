;; External impl-packages (Type-2) — the operator's single list. See
;; docs/PACKAGE_DISTRIBUTION.md § 5 and graphden.packages.manifest.
;;
;; Each entry: {:name "<package>" :lib <group/artifact> :coord {…deps.edn coord…}}
;;   git-dep : :coord {:git/url "…" :git/sha "…"}
;;   Maven   : :coord {:mvn/version "…"}
;;
;; build.clj bundles the coordinates into the uberjar; :app/packages loads the
;; names. For dev, also add the coordinate to deps.edn / a :local/root override.
{:packages
 [;; External Type-2 package (impl+fns), distributed as the standalone
  ;; graphden/graphden-mathx repo and pulled in by git coord — the real
  ;; distribution form (Track B). build.clj merges this coord into the uberjar
  ;; basis, so `bb rebuild` clones the package straight from GitHub. The repo is
  ;; PUBLIC and the coord is an https URL, so this resolves anonymously — no
  ;; credentials, no ssh-agent. `bb test`/`bb dev` resolve the in-tree copy via
  ;; :override-deps in deps.edn for offline hermeticity (see § 12 / DEPLOYMENT).
  {:name "mathx"
   :lib mathx/mathx
   :coord {:git/url "https://github.com/Graphden/graphden-mathx.git"
           :git/sha "8337147045ff2fec94212806ae16235ad2f625bc"}}]}
