  ;; POST /api/branches/:ref/merge — merge source into target.
  ;; ---------------------------------------------------------------------

  ;; --- merge-branch --- The :merge-conflict
  ;; rejection case stays inside apply (exception-surfaced from
  ;; `vs/merge-branch!`).
  ;;
  ;; Body parse + `coerce-resolutions` is fully decomposed: per-item
  ;; HOF callback over the body's `:conflict-resolutions` list extracts
  ;; the three fields (`:entity-name`, `:entity-id`, `:choice`),
  ;; validates each (string-to-keyword for entity-name + choice;
  ;; UUID-parse for entity-id; choice must be `:source` or `:target`),
  ;; emits a `[[entity-name entity-id] choice]` pair when valid or nil
  ;; otherwise. Outer filters nils, folds the pairs into a map.
  ;;
  ;; Admin extension surface — admins who want to add a `:manual`
  ;; choice or accept a different resolution shape can either parent
  ;; `:_merge-resolution-choice-valid?` to extend the choice set, or
  ;; replace `:_merge-resolution-tuple` with their own per-item HOF.
  {:name :_merge-body
   :parent :parse-json-body}

  {:name :_merge-resolutions-raw
   :description "Raw `:conflict-resolutions` array from the body (default `[]`)."
   :parent :get
   :args {:coll :_merge-body
          :key {:value :conflict-resolutions}
          :default {:value []}}}

  ;; Per-resolution HOF callback. The HOF binds `:item` to each
  ;; resolution map; the chain below extracts and validates fields.
  {:name :_merge-resolution-name-kw
   :description "`(some-> (:entity-name item) keyword)`."
   :parent :str-to-keyword
   :args {:string {:parent :get :args {:coll {:as :item} :key {:value :entity-name} :default nil}}}}

  {:name :_merge-resolution-eid
   :description "`(parse-uuid (:entity-id item))` — nil when missing/malformed."
   :parent :parse-uuid
   :args {:string {:parent :get :args {:coll {:as :item} :key {:value :entity-id} :default nil}}}}

  {:name :_merge-resolution-choice-kw
   :description "`(some-> (:choice item) keyword)`."
   :parent :str-to-keyword
   :args {:string {:parent :get :args {:coll {:as :item} :key {:value :choice} :default nil}}}}

  {:name :_merge-resolution-choice-valid?
   :description "True iff the choice is one of the recognised picks (`:source` or `:target`). Admins can extend by parent-ing or replacing this fn-def."
   :parent :or
   :args {:values [{:parent :equal? :args {:a :_merge-resolution-choice-kw :b {:value :source}}}
                   {:parent :equal? :args {:a :_merge-resolution-choice-kw :b {:value :target}}}]}}

  {:name :_merge-resolution-valid?
   :description "Three-way validation: entity-name keyword non-nil, entity-id UUID parsed, choice in recognised set."
   :parent :and
   :args {:values [{:parent :some? :args {:value :_merge-resolution-name-kw}}
                   {:parent :some? :args {:value :_merge-resolution-eid}}
                   :_merge-resolution-choice-valid?]}}

  {:name :_merge-resolution-key
   :description "`[entity-name entity-id]` — the map key the merge engine expects."
   :parent :vec
   :args {:coll [:_merge-resolution-name-kw :_merge-resolution-eid]}}

  {:name :_merge-resolution-pair
   :description "Two-element pair `[[entity-name entity-id] choice]` for `:pairs->map`."
   :parent :vec
   :args {:coll [:_merge-resolution-key :_merge-resolution-choice-kw]}}

  {:name :_merge-resolution-tuple
   :description "Per-item HOF callback: emit the pair when valid, nil otherwise. The outer filter drops nils."
   :parent :if
   :args {:test :_merge-resolution-valid?
          :then :_merge-resolution-pair
          :else nil}}

  ;; Outer: :map → :filter (drop nils) → :pairs->map.
  {:name :_merge-resolutions-mapped
   :parent :map
   :args {:func :_merge-resolution-tuple
          :coll :_merge-resolutions-raw}}

  {:name :_merge-resolutions-non-nil
   :parent :filter
   :args {:pred :some?
          :coll :_merge-resolutions-mapped}}

  {:name :_merge-resolutions
   :description "Folded `{[entity-name entity-id] :source|:target}` map ready for `vs/merge-branch!`."
   :parent :pairs->map
   :args {:entries :_merge-resolutions-non-nil}}

  ;; Source ref: `(some-> (:source body) str)` — nil-safe string coerce.
  {:name :_merge-source-raw
   :parent :get
   :args {:coll :_merge-body
          :key {:value :source}
          :default nil}}

  {:name :_merge-source-ref
   :description "Nil-safe `(str (:source body))`."
   :parent :if
   :args {:test {:parent :some? :args {:value :_merge-source-raw}}
          :then {:parent :to-str :args {:value :_merge-source-raw}}
          :else nil}}

  {:name :_merge-parsed
   :description "Parse POST /api/branches/:target/merge URL + body into `{:target-ref :source-ref :resolutions}`. Pure graph composition over `:uri-segment-after` + `:parse-json-body` + per-resolution HOF chain + `:pairs->map`."
   :parent :zipmap
   :args {:keys [{:value :target-ref} {:value :source-ref} {:value :resolutions}]
          :vals [:_branches-target-ref :_merge-source-ref :_merge-resolutions]}}

  {:name :_merge-target-missing?
   :description "Guard #1 — target branch not found. `:nil? :target`."
   :parent :nil?
   :args {:value {:as :target}}}

  {:name :_merge-source-not-supplied?
   :description "Guard #2 — `:source` missing in body. `:nil? (get parsed :source-ref)`."
   :parent :nil?
   :args {:value {:parent :get :args {:coll {:as :parsed} :key {:value :source-ref} :default nil}}}}

  {:name :_merge-source-missing?
   :description "Guard #3 — source supplied but doesn't resolve. `:nil? :source`."
   :parent :nil?
   :args {:value {:as :source}}}

  {:name :_merge-same?
   :description "Guard #4 — source and target are the same branch. `:and [some? target] [some? source] [(:id target) = (:id source)]`."
   :parent :and
   :args {:values [{:parent :some? :args {:value {:as :target}}}
                   {:parent :some? :args {:value {:as :source}}}
                   {:parent :equal?
                    :args {:a {:parent :get :args {:coll {:as :target} :key {:value :id} :default nil}}
                           :b {:parent :get :args {:coll {:as :source} :key {:value :id} :default nil}}}}]}}

  {:name :_merge-err-target-missing
   :description "Identical shape to `:_diff-err-target-missing` — inherit it verbatim."
   :parent :_diff-err-target-missing}

  {:name :_merge-err-source-not-supplied
   :parent :const
   :return-type :_error-result-shape
   :args {:value {:ok false :error "Required field ':source' is missing"}}}

  {:name :_merge-err-source-missing
   :description "Identical shape to `:_conflicts-err-source-missing` (same `:source-ref` key) — inherit it verbatim."
   :parent :_conflicts-err-source-missing}

  {:name :_merge-err-same
   :parent :const
   :return-type :_error-result-shape
   :args {:value {:ok false :error "Source and target branches must differ"}}}

  ;; --- :merge-branch! atomic primitive + graph-level try/catch ----
  ;; The atomic switch+merge stays in Clojure (`:merge-branch!`).
  ;; The success-shape AND the merge-conflict-rejection-shape live in
  ;; graph — admins can vary either without touching Clojure. The
  ;; dispatch on `:type` from `(ex-data e)` uses the new `:ex-data`
  ;; primitive in `core.system`.
  {:name :merge-branch!
   :description "The atomic merge core: `vs/switch-branch` → `:forbid-invalid?` policy check → `vs/merge-branch!` (the three share one switched-to-target storage OBJECT — a runtime value no graph slot can carry). Throws ex-info `{:type :merge-conflict :conflicts [...]}` when resolutions don't cover every conflict, or `{:type :merge-protection-violation :invalid-fn-names [...]}` when the target branch's `:forbid-invalid?` policy refuses recorded type diagnostics (error-tolerance Phase 5); other failures surface as plain Exception. Post-commit invalidation and the :skipped audit are graph steps (`:_merge-apply-record`)."
   :args {:source-branch-id {:type :uuid :description "Source branch id."}
          :target-branch-id {:type :uuid :description "Target branch id."}
          :resolutions {:type :nullable-keyword-map :required false :description "Per-conflict resolution map; absent for first-attempt merges."}}
   :return-type :keyword-map
   :effects #{:db}}

  {:name :merge-post-commit!
   :description "Post-commit finisher for a COMMITTED merge — delta-invalidate the TARGET branch's ctx (seeds = the merge's touched fns), restart the target's services, note the epoch. Runs on a dedicated joined thread so a client abort can't skip it (a committed but invisible merge); the thread+join+interrupt handling is the indivisible invariant, so the three steps stay one base-fn. Returns nil."
   :args {:source-branch-id {:type :uuid :description "Source branch id (seeds the affected-fn delta)."}
          :target-branch-id {:type :uuid :description "Target branch id (whose ctx/services refresh)."}}
   :return-type :null
   :effects #{:db}}

  {:name :merge-skipped-branch-local
   :description "Audit read — fns with a version on the source branch that won't surface on the target after merge (effective `:branch-local?` filtered them at the resolver). One library call; empty vector = everything visible propagated."
   :args {:source-branch-id {:type :uuid :description "Source branch id."}}
   :return-type [:list :keyword-map]
   :effects #{:db}}

  ;; --- Success path: the merge WRITE SEQUENCE, graph-visible
  ;;     (formerly one opaque Clojure body): commit → post-commit →
  ;;     attach the :skipped audit. ---

  ;; `:assert-some` wraps mirror the outer `:cond` (rejects nil
  ;; source/target upstream); bridges the type-checker's per-arm
  ;; narrowing gap.
  {:name :_merge-source-id
   :parent :assert-some
   :args {:value {:parent :get
                  :args {:coll {:as :source} :key {:value :id} :default nil}}}}
  {:name :_merge-target-id
   :parent :assert-some
   :args {:value {:parent :get
                  :args {:coll {:as :target} :key {:value :id} :default nil}}}}

  {:name :_merge-record-committed
   :description "Stage 1 — the atomic switch+policy+merge. Throws on :merge-conflict / :merge-protection-violation; the `:try` outside catches, so nothing later in the sequence runs on a rejected merge."
   :parent :merge-branch!
   :args {:source-branch-id :_merge-source-id
          :target-branch-id :_merge-target-id
          :resolutions {:parent :get
                        :args {:coll {:as :parsed} :key {:value :resolutions} :default nil}}}}

  {:name :_merge-post-commit
   :description "Stage 2 — the post-commit finisher, sequenced AFTER the commit by the `:do` (so a rejected merge invalidates nothing) and targeting the merge's TARGET ctx (correct for a cross-branch merge)."
   :parent :merge-post-commit!
   :args {:source-branch-id :_merge-source-id
          :target-branch-id :_merge-target-id}}

  {:name :_merge-skipped-rows
   :parent :merge-skipped-branch-local
   :args {:source-branch-id :_merge-source-id}}

  ;; nil-safe shape: the :branch-local key is always present so
  ;; downstream envelopes don't special-case the no-skips case.
  {:name :_merge-skipped-map
   :parent :zipmap
   :args {:keys [{:value :branch-local}]
          :vals [:_merge-skipped-rows]}}

  {:name :_merge-record-with-skipped
   :description "The merge record + the :skipped audit the API consumers (and the editor's post-merge alert) read."
   :parent :assoc
   :args {:map :_merge-record-committed
          :key {:value :skipped}
          :value :_merge-skipped-map}}

  {:name :_merge-apply-record
   :description "The merge write sequence: commit (stage 1) → post-commit invalidate/restart (stage 2) → attach the :skipped audit. `:do` forces the steps in order and returns the last; `:_merge-record-committed` is result-cached, so the assoc re-reads the record without re-running the merge."
   :parent :do
   :args {:steps [:_merge-record-committed
                  :_merge-post-commit
                  :_merge-record-with-skipped]}}

  {:name :_merge-apply-record-id
   :parent :get :args {:coll :_merge-apply-record :key {:value :id} :default nil}}

  {:name :_merge-apply-record-source-id
   :parent :get :args {:coll :_merge-apply-record :key {:value :source-branch-id} :default nil}}

  {:name :_merge-apply-record-target-id
   :parent :get :args {:coll :_merge-apply-record :key {:value :target-branch-id} :default nil}}

  {:name :_merge-apply-record-created-at
   :parent :get :args {:coll :_merge-apply-record :key {:value :created-at} :default nil}}

  {:name :_merge-apply-created-at-str
   :description "Nil-safe stringify of `:created-at` (mirrors `(some-> created-at str)`)."
   :parent :if
   :args {:test {:parent :some? :args {:value :_merge-apply-record-created-at}}
          :then {:parent :to-str :args {:value :_merge-apply-record-created-at}}
          :else {:value nil}}}

  {:name :_merge-apply-record-shaped
   :description "Stringified-id merge-record shape: `{:id :source-branch-id :target-branch-id :created-at}`."
   :parent :zipmap
   :args {:keys [{:value :id} {:value :source-branch-id}
                 {:value :target-branch-id} {:value :created-at}]
          :vals [{:parent :to-str :args {:value :_merge-apply-record-id}}
                 {:parent :to-str :args {:value :_merge-apply-record-source-id}}
                 {:parent :to-str :args {:value :_merge-apply-record-target-id}}
                 :_merge-apply-created-at-str]}}

  {:name :_merge-apply-skipped
   :description "Audit log: `{:branch-local [<entity-row> …]}`. Pulled straight from `merge-branch!`'s `:skipped` field which the defbase populates via `mrg/skipped-as-branch-local`. Empty `:branch-local` vec means every visible-on-source fn propagated."
   :parent :get
   :args {:coll :_merge-apply-record :key {:value :skipped} :default nil}}

  {:name :_merge-apply-success-envelope
   :description "Success envelope — `{:ok true :merge <record> :skipped {:branch-local […]}}` without the cache-invalidation side effect (which is sequenced by `:_merge-apply-success`)."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :merge} {:value :skipped}]
          :vals [{:value true} :_merge-apply-record-shaped :_merge-apply-skipped]}}

  {:name :_merge-apply-success
   :description "Success path — `:do` forces `:_merge-apply-record` (the commit → post-commit → audit sequence; the commit THROWS on `:merge-conflict`, so the outer `:try` catches it and nothing below runs), then returns `:_merge-apply-success-envelope`. The post-commit invalidation is a graph step now (`:_merge-post-commit`); its three guarantees are preserved by construction: (a) it runs only on success — sequenced after the commit in the `:do`, (b) it targets the merge's TARGET ctx, not the request's current ctx (inside `:merge-post-commit!`), and (c) it is a DELTA seeded by the touched fns, not a full registry clear. `:do` returns the last step."
   :parent :do
   :args {:steps [:_merge-apply-record
                  :_merge-apply-success-envelope]}}

  ;; --- Error path: on-throw handler dispatching by ex-data :type.
  {:name :_merge-apply-ex-data
   :parent :ex-data :args {:ex {:as :exception}}}

  {:name :_merge-apply-ex-type
   :parent :get :args {:coll :_merge-apply-ex-data :key {:value :type} :default nil}}

  {:name :_merge-apply-ex-conflicts
   :description "The `:conflicts` vec from the ex-data — only meaningful on `:merge-conflict`. The same per-row shape `:_conflicts-apply-entry` reuses for the success-path of `/conflicts`."
   :parent :map
   :args {:func :_conflicts-apply-entry
          :coll {:parent :get :args {:coll :_merge-apply-ex-data :key {:value :conflicts} :default []}}}}

  {:name :_merge-apply-err-conflict
   :description "Merge-conflict envelope — `{:ok false :reason :merge-conflict :error \"…\" :target :source :conflicts [...]}`."
   :parent :zipmap
   :return-type {:ok :bool
                 :reason :keyword
                 :http-status :int
                 :error :text
                 :target {:id :nullable-text
                          :name :any
                          :base-branch-id :nullable-text
                          :created-at :nullable-text
                          :owner-id :any
                          :write-policy :any
                          :require-merge? :any
                          :review-state :any}
                 :source {:id :nullable-text
                          :name :any
                          :base-branch-id :nullable-text
                          :created-at :nullable-text
                          :owner-id :any
                          :write-policy :any
                          :require-merge? :any
                          :review-state :any}
                 :conflicts [:list {:entity-name :any
                                    :entity-id :text
                                    :source-version :jsonb
                                    :target-version :jsonb}]}
   :args {:keys [{:value :ok} {:value :reason} {:value :http-status :literal? true} {:value :error}
                 {:value :target} {:value :source} {:value :conflicts}]
          :vals [{:value false}
                 {:value :merge-conflict}
                 {:value 409}
                 {:value "Merge has unresolved conflicts"}
                 {:parent :as-json-branch :args {:branch-row {:as :target}}}
                 {:parent :as-json-branch :args {:branch-row {:as :source}}}
                 :_merge-apply-ex-conflicts]}}

  {:name :_merge-apply-err-protection
   :description "Merge-protection envelope (error-tolerance Phase 5 + trait gate) — `{:ok false :reason :merge-protection-violation :http-status 409 :error \"…\" :invalid-fns […]}`. `:error` is the thrown message (names the broken fns for the `:forbid-invalid?` policy); `:invalid-fns` is the ex-data's `:invalid-fn-names` (empty for the trait-transfer flavour, which carries `:protected-transfers` instead)."
   :parent :zipmap
   :return-type {:ok :bool
                 :reason :keyword
                 :http-status :int
                 :error :text
                 :invalid-fns :any}
   :args {:keys [{:value :ok} {:value :reason} {:value :http-status :literal? true}
                 {:value :error} {:value :invalid-fns}]
          :vals [{:value false}
                 {:value :merge-protection-violation}
                 {:value 409}
                 {:parent :coalesce
                  :args {:value {:parent :throwable-message :args {:ex {:as :exception}}}
                         :default "Merge blocked by branch policy"}}
                 {:parent :get
                  :args {:coll :_merge-apply-ex-data
                         :key {:value :invalid-fn-names}
                         :default []}}]}}

  {:name :_merge-apply-err-generic-msg
   :description "Fallback message — `(or (.getMessage e) \"Unknown error\")`."
   :parent :coalesce
   :args {:value {:parent :throwable-message :args {:ex {:as :exception}}}
          :default "Unknown error"}}

  {:name :_merge-apply-err-generic
   :parent :zipmap
   :return-type :_error-result-shape
   :args {:keys [{:value :ok} {:value :error}]
          :vals [{:value false} :_merge-apply-err-generic-msg]}}

  {:name :_merge-apply-clauses
   :description "Dynamic `:case` clauses map — `{:merge-conflict <ref> :merge-protection-violation <ref>}`. Built via `:zipmap` so each result-vec entry is a ref (resolving to its envelope), not a literal keyword."
   :parent :zipmap
   :args {:keys [{:value :merge-conflict} {:value :merge-protection-violation}]
          :vals [:_merge-apply-err-conflict :_merge-apply-err-protection]}}

  {:name :_merge-apply-on-throw
   :description "`:try`'s `:on-throw` handler — dispatches on `(:type (ex-data e))` via `:case`. The `:merge-conflict` clause builds the structured 409-style payload; `:merge-protection-violation` builds the 409 branch-policy/trait envelope; default falls through to a generic `{:ok false :error <message>}`."
   :parent :case
   :args {:value :_merge-apply-ex-type
          :clauses :_merge-apply-clauses
          :default :_merge-apply-err-generic}}

  {:name :_merge-apply
   :description "Success branch — `vs/merge-branch!` via the `:merge-branch!` atomic primitive, wrapped in `:try` so a `:merge-conflict` rejection becomes a structured JSON envelope instead of a 500. Pure graph composition end-to-end."
   :parent :try
   :args {:body :_merge-apply-success
          :on-throw :_merge-apply-on-throw}}

  {:name :_merge-branch-data
   :description "POST /api/branches/:target/merge — flat `:cond` of 4 guards + apply. The :merge-conflict rejection comes from apply."
   :parent :cond
   :args {:clauses [:_merge-target-missing?      :_merge-err-target-missing
                    :_merge-source-not-supplied? :_merge-err-source-not-supplied
                    :_merge-source-missing?      :_merge-err-source-missing
                    :_merge-same?                :_merge-err-same
                    {:value true}                :_merge-apply]
          :parsed :_merge-parsed
          :target :_target-branch
          :source :_source-branch}}

  {:name :merge-branch-handler
   :lambda-params [:request :default]
   :description "Ring handler for POST /api/branches/:ref/merge (auth-required) — a :merge-conflict answers 409 via the envelope's :http-status; the structured conflicts payload rides the body either way."
   :parent :json-envelope-response
   :args {:envelope :_merge-branch-data}}

  ;; ---------------------------------------------------------------------
  ;; GET /partials/branch-popover — top-bar branch chip popover body.
  ;;
  ;; Reuses the existing `:_list-branches-rows` decoded-rows chain
  ;; (single source of truth for branch enumeration). `:current-name`
  ;; is the active branch's `:name` resolved from `:current-branch-id`
  ;; via `:get-entity` — the row shape carries `:name` directly so no
  ;; per-row index lookup is needed.
  ;; ---------------------------------------------------------------------

  {:name :_partial-branch-popover-current-row
   :description "Active branch's row — resolved from `:current-branch-id`. nil when the active branch was just deleted under a stale `?branch=` (defensive: render uses default `main`)."
   :parent :get-entity
   :args {:entity-type {:value "branch"}
          :id :current-branch-id}}

  {:name :_partial-branch-popover-current-name
   :description "Active branch's `:name`; nil → falls back to `main` inside the render."
   :parent :get
   :args {:coll :_partial-branch-popover-current-row
          :key {:value :name}
          :default nil}}

  ;; ---------------------------------------------------------------------
  ;; Per-row hiccup builders. Each is a HOF callback that runs once per
  ;; branch via `:_bp-rows-hiccup :parent :map`. `{:as :item}` is the
  ;; current branch row; `{:as :branches}` (closure-captured) is the
  ;; full list so we can look up parents and detect children without
  ;; an N+1 storage read; `{:as :current-name}` is the active-branch
  ;; name (closure-captured) so each row knows whether it's the
  ;; selected one. Each visual / policy decision is an
  ;; admin-tweakable graph step.
  ;; ---------------------------------------------------------------------

  {:name :_bp-row-name
   :parent :get
   :args {:coll {:as :item} :key {:value :name} :default nil}}

  {:name :_bp-row-id
   :parent :get
   :args {:coll {:as :item} :key {:value :id} :default nil}}

  {:name :_bp-row-parent-id
   :parent :get
   :args {:coll {:as :item} :key {:value :base-branch-id} :default nil}}

  {:name :_bp-row-on-current?
   :parent :equal?
   :args {:a :_bp-row-name :b {:as :current-name}}}

  {:name :_bp-row-is-main?
   :parent :equal?
   :args {:a :_bp-row-name :b {:value "main"}}}

  ;; Parent lookup — find the branch whose :id matches THIS row's
  ;; :base-branch-id. O(n) per row but n=branch count is tiny.
  {:name :_bp-row-is-parent?-cb
   :description "HOF callback used by `:_bp-row-parent-row`'s `:filter`. `{:as :item}` here is a candidate branch from the outer list, NOT the current row — name collision is intentional: HOF callbacks are always passed the element via `:item`."
   :parent :equal?
   :args {:a {:parent :get :args {:coll {:as :item} :key {:value :id} :default nil}}
          :b :_bp-row-parent-id}}

  {:name :_bp-row-parent-matches
   :parent :filter
   :args {:pred :_bp-row-is-parent?-cb :coll {:as :branches}}}

  {:name :_bp-row-parent-row
   :parent :first
   :args {:coll :_bp-row-parent-matches}}

  {:name :_bp-row-parent-name
   :parent :get
   :args {:coll :_bp-row-parent-row :key {:value :name} :default nil}}

  {:name :_bp-row-has-parent?
   :parent :some?
   :args {:value :_bp-row-parent-row}}

  ;; "" when no parent, " forked from <name>" otherwise.
  {:name :_bp-row-parent-text-shown
   :parent :str
   :args {:parts [{:value " forked from "} :_bp-row-parent-name]}}

  {:name :_bp-row-parent-text
   :parent :if
   :args {:test :_bp-row-has-parent?
          :then :_bp-row-parent-text-shown
          :else {:value ""}}}

  ;; has-children? — does any OTHER branch list THIS one as its
  ;; parent? Same closure-capture pattern as parent lookup.
  {:name :_bp-row-is-child-of-this?-cb
   :parent :equal?
   :args {:a {:parent :get :args {:coll {:as :item} :key {:value :base-branch-id} :default nil}}
          :b :_bp-row-id}}

  {:name :_bp-row-children-matches
   :parent :filter
   :args {:pred :_bp-row-is-child-of-this?-cb :coll {:as :branches}}}

  {:name :_bp-row-has-no-children?
   :parent :empty?
   :args {:coll :_bp-row-children-matches}}

  {:name :_bp-row-has-children?
   :parent :not
   :args {:value :_bp-row-has-no-children?}}

  ;; Delete-policy: × button shown unless this row is :main / has
  ;; children / is the active branch. Three orthogonal protections —
  ;; admin can reshape by re-wiring any predicate.
  {:name :_bp-row-undeletable?
   :parent :or
   :args {:values [:_bp-row-is-main? :_bp-row-has-children? :_bp-row-on-current?]}}

  {:name :_bp-row-deletable?
   :parent :not
   :args {:value :_bp-row-undeletable?}}

  ;; --- Row class + aria attrs ---

  {:name :_bp-row-class
   :parent :if
   :args {:test :_bp-row-on-current?
          :then {:value "branch-row branch-row-current"}
          :else {:value "branch-row"}}}

  {:name :_bp-row-aria-selected
   :parent :if
   :args {:test :_bp-row-on-current?
          :then {:value "true"}
          :else {:value "false"}}}

  {:name :_bp-row-attrs-1
   :parent :assoc
   :args {:map {:value {:role "option" :tabindex "0"}}
          :key {:value :class}
          :value :_bp-row-class}}

  {:name :_bp-row-attrs-2
   :parent :assoc
   :args {:map :_bp-row-attrs-1
          :key {:value :data-branch-name}
          :value :_bp-row-name}}

  {:name :_bp-row-attrs-3
   :parent :assoc
   :args {:map :_bp-row-attrs-2
          :key {:value :aria-selected}
          :value :_bp-row-aria-selected}}

  ;; data-write-policy: "" when open — the JS policy editor reads its
  ;; current value off the row instead of a second fetch.
  {:name :_bp-row-attrs
   :parent :assoc
   :args {:map :_bp-row-attrs-3
          :key {:value :data-write-policy}
          :value {:parent :if
                  :args {:test :_bp-row-protected?
                         :then :_bp-row-policy
                         :else {:value ""}}}}}

  ;; --- Children spans ---

  {:name :_bp-row-policy
   :parent :get
   :args {:coll {:as :item} :key {:value :write-policy} :default nil}}

  {:name :_bp-row-protected?
   :parent :some?
   :args {:value :_bp-row-policy}}

  {:name :_bp-row-name-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "branch-row-name"}}
          :children [:_bp-row-name]}}

  ;; --- Protected-branch lock glyph (write-policy set) ---
  {:name :_bp-row-lock-title
   :parent :str
   :args {:parts [{:value "Protected — writes limited to: "} :_bp-row-policy]}}

  {:name :_bp-row-lock-span-shown
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:parent :assoc
                  :args {:map {:value {:class "branch-row-lock" :aria-hidden "true"}}
                         :key {:value :title}
                         :value :_bp-row-lock-title}}
          :children [{:value "🔒"}]}}

  {:name :_bp-row-lock-span
   :parent :if
   :args {:test :_bp-row-protected?
          :then :_bp-row-lock-span-shown
          :else :_bp-row-empty-placeholder}}

  {:name :_bp-row-tag-span-shown
   :description "`<span class=\"branch-row-tag\">current</span>` — visible only on the active branch's row."
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "branch-row-tag"}}
          :children [{:value "current"}]}}

  {:name :_bp-row-tag-span-hidden
   :description "Empty hidden placeholder — keeps the children-vector shape uniform across rows so hiccup walks an evenly-shaped tree."
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "branch-row-tag-placeholder" :hidden "1"}}
          :children {:value []}}}

  {:name :_bp-row-tag-span
   :parent :if
   :args {:test :_bp-row-on-current?
          :then :_bp-row-tag-span-shown
          :else :_bp-row-tag-span-hidden}}

  {:name :_bp-row-meta-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "branch-row-meta"}}
          :children [:_bp-row-parent-text]}}

  ;; --- Action buttons (Δ / ⇢ / ×) ---
  ;; Per-button title + aria-label carry the row's name + the
  ;; current-name so screen readers + tooltips read e.g.
  ;; "Diff feat vs main". Each button is its own fn-def so admins
  ;; can vary the label / glyph / class independently.

  {:name :_bp-row-diff-title
   :parent :str
   :args {:parts [{:value "Show what differs between "}
                  :_bp-row-name
                  {:value " and "}
                  {:as :current-name}]}}

  {:name :_bp-row-diff-aria
   :parent :str
   :args {:parts [{:value "Diff "}
                  :_bp-row-name
                  {:value " vs "}
                  {:as :current-name}]}}

  {:name :_bp-row-diff-attrs-1
   :parent :assoc
   :args {:map {:value {:class "branch-row-diff"}}
          :key {:value :data-diff-source}
          :value :_bp-row-name}}

  {:name :_bp-row-diff-attrs-2
   :parent :assoc
   :args {:map :_bp-row-diff-attrs-1
          :key {:value :title}
          :value :_bp-row-diff-title}}

  {:name :_bp-row-diff-attrs
   :parent :assoc
   :args {:map :_bp-row-diff-attrs-2
          :key {:value :aria-label}
          :value :_bp-row-diff-aria}}

  {:name :_bp-row-diff-btn-shown
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_bp-row-diff-attrs
          :children [{:value "Δ"}]}}

  {:name :_bp-row-empty-placeholder
   :description "Reusable hidden `<span hidden=\"1\">` placeholder for the three action-button slots when the row isn't eligible for that action. Keeps children-vector shape uniform; CSS-hidden so it takes no visual space."
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:hidden "1"}}
          :children {:value []}}}

  {:name :_bp-row-diff-btn
   :parent :if
   :args {:test :_bp-row-on-current?
          :then :_bp-row-empty-placeholder
          :else :_bp-row-diff-btn-shown}}

  {:name :_bp-row-merge-title
   :parent :str
   :args {:parts [{:value "Merge "}
                  :_bp-row-name
                  {:value " INTO "}
                  {:as :current-name}]}}

  {:name :_bp-row-merge-aria
   :parent :str
   :args {:parts [{:value "Merge "}
                  :_bp-row-name
                  {:value " into "}
                  {:as :current-name}]}}

  {:name :_bp-row-merge-attrs-1
   :parent :assoc
   :args {:map {:value {:class "branch-row-merge"}}
          :key {:value :data-merge-source}
          :value :_bp-row-name}}

  {:name :_bp-row-merge-attrs-2
   :parent :assoc
   :args {:map :_bp-row-merge-attrs-1
          :key {:value :title}
          :value :_bp-row-merge-title}}

  {:name :_bp-row-merge-attrs
   :parent :assoc
   :args {:map :_bp-row-merge-attrs-2
          :key {:value :aria-label}
          :value :_bp-row-merge-aria}}

  {:name :_bp-row-merge-btn-shown
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_bp-row-merge-attrs
          :children [{:value "⇢"}]}}

  {:name :_bp-row-merge-btn
   :parent :if
   :args {:test :_bp-row-on-current?
          :then :_bp-row-empty-placeholder
          :else :_bp-row-merge-btn-shown}}

  {:name :_bp-row-delete-aria
   :parent :str
   :args {:parts [{:value "Delete branch "} :_bp-row-name]}}

  {:name :_bp-row-delete-attrs-1
   :parent :assoc
   :args {:map {:value {:class "branch-row-delete"
                        :title "Delete branch"}}
          :key {:value :data-branch-name}
          :value :_bp-row-name}}

  {:name :_bp-row-delete-attrs
   :parent :assoc
   :args {:map :_bp-row-delete-attrs-1
          :key {:value :aria-label}
          :value :_bp-row-delete-aria}}

  {:name :_bp-row-delete-btn-shown
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_bp-row-delete-attrs
          :children [{:value "×"}]}}

  {:name :_bp-row-delete-btn
   :parent :if
   :args {:test :_bp-row-deletable?
          :then :_bp-row-delete-btn-shown
          :else :_bp-row-empty-placeholder}}

  {:name :_bp-row-policy-title
   :parent :str
   :args {:parts [{:value "Protection of "} :_bp-row-name
                  {:value " — who may write"}]}}

  {:name :_bp-row-policy-attrs-1
   :parent :assoc
   :args {:map {:value {:class "branch-row-policy"}}
          :key {:value :data-policy-branch}
          :value :_bp-row-name}}

  {:name :_bp-row-policy-attrs
   :parent :assoc
   :args {:map :_bp-row-policy-attrs-1
          :key {:value :title}
          :value :_bp-row-policy-title}}

  ;; Shield — opens the JS write-policy mini-menu. Rendered on every
  ;; row; CSS shows it only under the tenancy addon (body.gd-tenancy —
  ;; without principals a policy has no one to tell apart) and hides it
  ;; under gd-no-write.
  {:name :_bp-row-policy-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_bp-row-policy-attrs
          :children [{:value "⛨"}]}}

  ;; --- Require-merge toggle (open-core; NOT tenancy-gated) ---
  ;; "Push only via merge" — the GitHub-style per-branch protection
  ;; flip. A boolean, so a single button toggles it; the current
  ;; state rides on `data-require-merge` and the `on` class, both read
  ;; by the JS handler which POSTs the NEGATION to /branches/:ref/protect.
  {:name :_bp-row-require-merge?
   :parent :get
   :args {:coll {:as :item} :key {:value :require-merge?} :default nil}}

  {:name :_bp-row-rm-data
   :parent :if
   :args {:test :_bp-row-require-merge? :then {:value "1"} :else {:value ""}}}

  {:name :_bp-row-rm-class
   :parent :if
   :args {:test :_bp-row-require-merge?
          :then {:value "branch-row-require-merge on"}
          :else {:value "branch-row-require-merge"}}}

  {:name :_bp-row-rm-title
   :parent :if
   :args {:test :_bp-row-require-merge?
          :then {:value "Push only via merge is ON — click to allow direct writes"}
          :else {:value "Direct writes allowed — click to require merge"}}}

  {:name :_bp-row-rm-attrs-1
   :parent :assoc
   :args {:map {:parent :assoc
                :args {:map {:value {}} :key {:value :class} :value :_bp-row-rm-class}}
          :key {:value :data-rm-branch}
          :value :_bp-row-name}}

  {:name :_bp-row-rm-attrs-2
   :parent :assoc
   :args {:map :_bp-row-rm-attrs-1
          :key {:value :data-require-merge}
          :value :_bp-row-rm-data}}

  {:name :_bp-row-rm-attrs
   :parent :assoc
   :args {:map :_bp-row-rm-attrs-2
          :key {:value :title}
          :value :_bp-row-rm-title}}

  {:name :_bp-row-rm-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_bp-row-rm-attrs
          :children [{:value "🔀"}]}}

  ;; --- Change-proposal toggle (open-core) ---
  ;; "Propose this branch for review into its base" — a boolean toggle
  ;; on `:review-state`. The current state rides on `data-review-state`
  ;; + the `on` class; the JS handler POSTs the negation to
  ;; /branches/:ref/propose. The accented on-state doubles as the
  ;; "this branch is a proposal" marker a reviewer scans for.
  {:name :_bp-row-review-state
   :parent :get
   :args {:coll {:as :item} :key {:value :review-state} :default nil}}

  {:name :_bp-row-proposed?
   :parent :equal?
   :args {:a :_bp-row-review-state :b {:value "proposed"}}}

  {:name :_bp-row-propose-data
   :parent :if
   :args {:test :_bp-row-proposed? :then {:value "1"} :else {:value ""}}}

  {:name :_bp-row-propose-class
   :parent :if
   :args {:test :_bp-row-proposed?
          :then {:value "branch-row-propose on"}
          :else {:value "branch-row-propose"}}}

  {:name :_bp-row-propose-title
   :parent :if
   :args {:test :_bp-row-proposed?
          :then {:value "Proposed for review — click to withdraw"}
          :else {:value "Propose this branch for review into its base"}}}

  {:name :_bp-row-propose-attrs-1
   :parent :assoc
   :args {:map {:parent :assoc
                :args {:map {:value {}} :key {:value :class} :value :_bp-row-propose-class}}
          :key {:value :data-propose-branch}
          :value :_bp-row-name}}

  {:name :_bp-row-propose-attrs-2
   :parent :assoc
   :args {:map :_bp-row-propose-attrs-1
          :key {:value :data-review-state}
          :value :_bp-row-propose-data}}

  {:name :_bp-row-propose-attrs
   :parent :assoc
   :args {:map :_bp-row-propose-attrs-2
          :key {:value :title}
          :value :_bp-row-propose-title}}

  {:name :_bp-row-propose-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_bp-row-propose-attrs
          :children [{:value "📤"}]}}

  {:name :_bp-row-actions-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "branch-row-actions"}}
          :children [:_bp-row-diff-btn :_bp-row-propose-btn :_bp-row-merge-btn :_bp-row-rm-btn :_bp-row-policy-btn :_bp-row-delete-btn]}}

  ;; The full per-branch row — assembled via the named children.
  {:name :_bp-row
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs :_bp-row-attrs
          :children [:_bp-row-name-span :_bp-row-lock-span :_bp-row-tag-span :_bp-row-meta-span :_bp-row-actions-span]}}

  ;; ---------------------------------------------------------------------
  ;; Sort policy: main first, current second, rest alpha. Composite
  ;; key `[rank name]` — clojure compares vectors lexicographically.
  ;; ---------------------------------------------------------------------

  {:name :_bp-sort-is-main?
   :parent :equal?
   :args {:a :_bp-row-name :b {:value "main"}}}

  {:name :_bp-sort-is-current?
   :parent :equal?
   :args {:a :_bp-row-name :b {:as :current-name}}}

  {:name :_bp-sort-rank
   :parent :cond
   :args {:clauses [:_bp-sort-is-main?    {:value 0}
                    :_bp-sort-is-current? {:value 1}
                    {:value true}         {:value 2}]}}

  {:name :_bp-sort-key
   :parent :vec
   :args {:coll [:_bp-sort-rank :_bp-row-name]}}

  {:name :_bp-rows-sorted
   :parent :sort-by
   :args {:key-fn :_bp-sort-key
          :coll {:as :branches}
          :current-name {:as :current-name}}}

  {:name :_bp-rows-hiccup
   :parent :map
   :args {:func :_bp-row
          :coll :_bp-rows-sorted
          :current-name {:as :current-name}
          :branches {:as :branches}}}

  ;; ---------------------------------------------------------------------
  ;; Top-level body — list + create form + error slot. Inputs:
  ;; `:branches` (full decoded rows) + `:current-name` (active
  ;; branch). Both flow in from the partial handler.
  ;; ---------------------------------------------------------------------

  {:name :_bp-listbox
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-section-rows"
                          :role "listbox"
                          :aria-label "Branches"}}
          :children :_bp-rows-hiccup}}

  {:name :_bp-list-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-popover-list"}}
          :children [:_bp-listbox]}}

  {:name :_bp-create-placeholder
   :parent :str
   :args {:parts [{:value "New branch name (forks from "}
                  {:as :current-name}
                  {:value ")"}]}}

  {:name :_bp-create-input
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:parent :assoc
                  :args {:map {:value {:id "branch-create-input"
                                       :type "text"
                                       :autocomplete "off"}}
                         :key {:value :placeholder}
                         :value :_bp-create-placeholder}}
          :children {:value []}}}

  {:name :_bp-create-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:id "branch-create-btn"
                          :class "branch-popover-btn"}}
          :children [{:value "Create"}]}}

  {:name :_bp-create-row
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-popover-create-row"}}
          :children [:_bp-create-input :_bp-create-btn]}}

  ;; Advanced — protected-branch write policy at create. Plain static
  ;; hiccup; CSS reveals it only under the tenancy addon
  ;; (body.gd-tenancy). Default stays a plain open branch — zero extra
  ;; clicks on the ordinary path.
  {:name :_bp-create-adv
   :parent :hiccup
   :args {:tag {:value "details"}
          :attrs {:value {:class "branch-adv"}}
          :children [{:parent :hiccup
                      :args {:tag {:value "summary"}
                             :attrs {:value {}}
                             :children [{:value "Advanced"}]}}
                     {:parent :hiccup
                      :args {:tag {:value "label"}
                             :attrs {:value {:class "branch-adv-label"
                                             :for "branch-create-policy"}}
                             :children [{:value "Who can write"}]}}
                     {:parent :hiccup
                      :args {:tag {:value "select"}
                             :attrs {:value {:id "branch-create-policy"}}
                             :children [{:parent :hiccup
                                         :args {:tag {:value "option"}
                                                :attrs {:value {:value "open" :selected "1"}}
                                                :children [{:value "Everyone with write access (default)"}]}}
                                        {:parent :hiccup
                                         :args {:tag {:value "option"}
                                                :attrs {:value {:value "owner"}}
                                                :children [{:value "Only me (org admins can unlock)"}]}}
                                        {:parent :hiccup
                                         :args {:tag {:value "option"}
                                                :attrs {:value {:value "admins"}}
                                                :children [{:value "Org admins only"}]}}]}}]}}

  {:name :_bp-create-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "branch-popover-create"}}
          :children [:_bp-create-row :_bp-create-adv]}}

  {:name :_bp-error-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:id "branch-popover-error"
                          :class "branch-popover-error hidden"}}
          :children {:value []}}}

  {:name :_partial-branch-popover-body
   :description "Full hiccup for the popover body — list + create form + error slot. Pure-graph composition over the `:_bp-*` chain."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {}}
          :children [:_bp-list-div :_bp-create-div :_bp-error-div]
          :branches :_list-branches-rows
          :current-name :_partial-branch-popover-current-name}}

  {:name :_partial-branch-popover-html
   :description "Rendered HTML string for the branch-popover partial."
   :parent :render-hiccup
   :args {:hiccup :_partial-branch-popover-body}}

  {:name :_partial-branch-popover-handler
   :lambda-params []
   :description "Ring handler for `GET /partials/branch-popover` — returns the popover body as `text/html`. JS swaps the response into `#branch-popover` and binds row / button click handlers via `data-*` attrs the partial emits."
   :parent :html-ok-response
   :args {:body :_partial-branch-popover-html}}]}
