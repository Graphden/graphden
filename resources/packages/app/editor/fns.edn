  {:name :graphden-components-stylesheet-tag
   :description "`<link rel=\"stylesheet\" href=\"/assets/graphden-components.css?v=<hash>\">` — default stylesheet for web.components. Include via `:graphden-page-head` (or directly in a page's `:head` list). Hash-busted to invalidate the immutable browser cache on each deploy."
   :parent :hiccup
   :args {:tag {:value "link"}
          :attrs {:parent :assoc
                  :args {:map {:value {:rel "stylesheet"}}
                         :key {:value :href}
                         :value :_graphden-components-css-url}}
          :children {:value []}}}

  {:name :graphden-page-head
   :description "Drop-in `:head` list — currently the components stylesheet `<link>`. Bind to the `:head` slot of `:html-page-route` / `:html-page-handler` / `:html-page` so pages get sensible default styling without inline `:style` attrs."
   :parent :list
   :args {:items [:graphden-components-stylesheet-tag]}}

  {:name :_editor-css-handler
   :description "Ring handler for `GET /assets/editor.css` — returns the editor stylesheet as `text/css` with `Cache-Control: public, max-age=31536000, immutable`."
   :parent :immutable-css-ok-response
   :args {:body :styles}}

