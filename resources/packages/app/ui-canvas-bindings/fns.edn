  {:name :_flag-names-count :parent :get
   :args {:coll :_flag-input :key {:value :names-count} :default 0}}
  {:name :_flag-own :parent :get
   :args {:coll :_flag-input :key {:value :own} :default false}}
  {:name :_flag-inherited :parent :get
   :args {:coll :_flag-input :key {:value :inherited} :default false}}
