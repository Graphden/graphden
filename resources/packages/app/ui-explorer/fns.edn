       {:name :_explorer-count-text-apps :parent :str :args {:parts [:_explorer-count-apps]}}
       {:name :_explorer-count-display-apps :parent :if :args {:test :_explorer-unknown-count-apps :then "" :else :_explorer-count-text-apps}}
       {:name :_explorer-count-node-apps :parent :hiccup :args {:tag "span" :attrs :_explorer-count-attrs :children [:_explorer-count-display-apps]}}
       {:name :_explorer-apps-hidden :parent :if :args {:test :_explorer-input-apps-available :then false :else true}}
       {:name :_explorer-attrs-apps :parent :_explorer-toggle-attrs :args {:vals ["button" "kind-toggle" "apps" :_explorer-pressed-apps "Only apps (fns served at a public host)" :_explorer-apps-hidden]}}
       {:name :_explorer-button-apps :parent :hiccup :args {:tag "button" :attrs :_explorer-attrs-apps :children [:_explorer-glyph-apps :_explorer-label-apps :_explorer-count-node-apps]}}
