;; HTTP endpoints for the admin-side Secrets CRUD.
;;
;; Each operation has two declarations:
;; - a `:_*-data` base-fn (thin shim calling `graphden.crud.secrets`)
;; - a `*-handler` fn-def that wraps the data fn via `:json-handler`
;;   (200 application/json). Concrete routes live in `app.routes`,
;;   wired with the auth-required middleware.
;;
;; Secret VALUES never appear on these endpoints' responses — only
;; metadata (path, created-at, version, description). The actual
;; secret stays in OpenBao and is only ever read at execution-time
;; by the user-fn-graph through `:vault-get`.


{:namespace "app.secrets"
 :description "Admin-side endpoints for the Secrets-panel CRUD — list / create / rotate / delete. Backed by `graphden.crud.secrets`."
 :fns
 [;; ---------------------------------------------------------------------
  ;; GET /api/secrets — list every secret-shaped fn-def with OpenBao
  ;; metadata (no values). Authentication required.
  ;; ---------------------------------------------------------------------

  {:name :_list-secrets-data
   :description "Returns `{:ok true :secrets [...]}`. Each entry is `{:id :name :path :created-at? :version? :description? :custom-metadata?}`. Values never appear — read at execution-time via :vault-get."
   :args {:request {:type :ring-request-shape}}
   :return-type :jsonb
   :effects #{:db :io}}

  {:name :list-secrets-handler
   :description "Ring handler for GET /api/secrets (auth-required)."
   :parent :json-handler
   :args {:data :_list-secrets-data}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/secrets — create a secret. Body `{:name :path :value
  ;; :namespace-id? :description?}`. Writes to OpenBao first, then
  ;; creates the fn-def + path-binding in graphden. Compensates by
  ;; deleting the OpenBao entry on graphden write failure.
  ;; ---------------------------------------------------------------------

  ;; --- C7 atoms: create-secret variant-2 decomposition.
  {:name :_create-secret-parsed
   :description "Parse the JSON body of POST /api/secrets into `{:nm :ns-id :path :value :description :custom-metadata}`."
   :args {:request {:type :ring-request-shape}}
   :return-type :jsonb
   :effects #{}}

  {:name :_create-secret-leaf-id
   :description "Look up the `:secret-leaf` base-fn id; nil when web.vault isn't loaded. Shared between leaf-missing guard + apply."
   :args {:request {:type :ring-request-shape}}
   :return-type :uuid
   :effects #{:db}}

  {:name :_create-secret-name-blank?
   :description "Guard #1 — request body had no `:name`."
   :args {:parsed {:type :jsonb}}
   :return-type :bool
   :effects #{}}

  {:name :_create-secret-path-blank?
   :description "Guard #2 — request body had no `:path`."
   :args {:parsed {:type :jsonb}}
   :return-type :bool
   :effects #{}}

  {:name :_create-secret-value-missing?
   :description "Guard #3 — request body's `:value` wasn't a string."
   :args {:parsed {:type :jsonb}}
   :return-type :bool
   :effects #{}}

  {:name :_create-secret-leaf-missing?
   :description "Guard #4 — `:secret-leaf` base-fn not loaded."
   :args {:leaf-id {:type :uuid}}
   :return-type :bool
   :effects #{}}

  {:name :_create-secret-name-taken?
   :description "Guard #5 — a fn with the same (name, namespace-id) already exists."
   :args {:parsed {:type :jsonb}}
   :return-type :bool
   :effects #{:db}}

  {:name :_create-secret-name-taken-error
   :description "Dynamic error builder for guard #5 — uses parsed `:nm`."
   :args {:parsed {:type :jsonb}}
   :return-type :jsonb
   :effects #{}}

  {:name :_create-secret-apply
   :description "Success branch — vault-put + graphden fn-row + path-binding. Compensates on graphden failure."
   :args {:parsed {:type :jsonb} :leaf-id {:type :uuid}}
   :return-type :jsonb
   :effects #{:db :io}}

  {:name :_create-secret-err-name-blank
   :parent :const
   :return-type :jsonb
   :args {:value {:ok false :error "Required field ':name' is missing"}}}

  {:name :_create-secret-err-path-blank
   :parent :const
   :return-type :jsonb
   :args {:value {:ok false :error "Required field ':path' is missing"}}}

  {:name :_create-secret-err-value-missing
   :parent :const
   :return-type :jsonb
   :args {:value {:ok false :error "Required field ':value' (string) is missing"}}}

  {:name :_create-secret-err-leaf-missing
   :parent :const
   :return-type :jsonb
   :args {:value {:ok false :error ":secret-leaf base-fn missing — package web.vault not loaded"}}}

  {:name :_create-secret-data
   :description "POST /api/secrets — flat `:cond` of 5 guards + apply. Lazy short-circuit means vault-put + graphden writes only run when every guard passes."
   :parent :cond
   :args {:clauses [:_create-secret-name-blank?    :_create-secret-err-name-blank
                    :_create-secret-path-blank?    :_create-secret-err-path-blank
                    :_create-secret-value-missing? :_create-secret-err-value-missing
                    :_create-secret-leaf-missing?  :_create-secret-err-leaf-missing
                    :_create-secret-name-taken?    :_create-secret-name-taken-error
                    {:value true}                  :_create-secret-apply]
          :parsed :_create-secret-parsed
          :leaf-id :_create-secret-leaf-id}}

  {:name :create-secret-handler
   :description "Ring handler for POST /api/secrets (auth-required)."
   :parent :json-handler
   :args {:data :_create-secret-data}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/secret-bindings — inline `:secret-path` binding (no
  ;; wrapper fn-def). Body `{:fn-id :slot-id :path :value}`. Used by the
  ;; editor's value-form for any slot whose declared type contains
  ;; `:secret` — see `crud.secrets/create-inline-binding`. Sibling to
  ;; /api/secrets/* (not nested) so reitit doesn't clash with
  ;; `/api/secrets/:fn-id`.
  ;; ---------------------------------------------------------------------

  ;; --- C11 atoms: create-inline-binding variant-2 decomposition.
  {:name :_inline-bind-parsed
   :description "Parse POST /api/secret-bindings body into `{:fn-id :slot-id :path :value}`."
   :args {:request {:type :ring-request-shape}}
   :return-type :jsonb
   :effects #{}}

  {:name :_inline-bind-fn-id-missing?
   :description "Guard #1 — body lacked `:fn-id` (or unparseable UUID)."
   :args {:parsed {:type :jsonb}}
   :return-type :bool
   :effects #{}}

  {:name :_inline-bind-slot-id-missing?
   :description "Guard #2 — body lacked `:slot-id` (or unparseable UUID)."
   :args {:parsed {:type :jsonb}}
   :return-type :bool
   :effects #{}}

  {:name :_inline-bind-path-blank?
   :description "Guard #3 — body lacked `:path`."
   :args {:parsed {:type :jsonb}}
   :return-type :bool
   :effects #{}}

  {:name :_inline-bind-value-missing?
   :description "Guard #4 — body's `:value` wasn't a string."
   :args {:parsed {:type :jsonb}}
   :return-type :bool
   :effects #{}}

  {:name :_inline-bind-target-fn-row
   :description "Read the target fn row by id; nil when not found."
   :args {:parsed {:type :jsonb}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :_inline-bind-target-missing?
   :description "Guard #5 — target fn doesn't exist."
   :args {:target-fn-row {:type :jsonb}}
   :return-type :bool
   :effects #{}}

  {:name :_inline-bind-existing
   :description "Look up the existing binding on (fn-id, slot-id), nil when none."
   :args {:parsed {:type :jsonb}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :_inline-bind-exists?
   :description "Guard #6 — a binding already exists for this fn+slot."
   :args {:existing {:type :jsonb}}
   :return-type :bool
   :effects #{}}

  {:name :_inline-bind-err-fn-id-missing
   :parent :const
   :return-type :jsonb
   :args {:value {:ok false :error "Required field ':fn-id' is missing or malformed"}}}

  {:name :_inline-bind-err-slot-id-missing
   :parent :const
   :return-type :jsonb
   :args {:value {:ok false :error "Required field ':slot-id' is missing or malformed"}}}

  {:name :_inline-bind-err-path-blank
   :parent :const
   :return-type :jsonb
   :args {:value {:ok false :error "Required field ':path' is missing"}}}

  {:name :_inline-bind-err-value-missing
   :parent :const
   :return-type :jsonb
   :args {:value {:ok false :error "Required field ':value' (string) is missing"}}}

  {:name :_inline-bind-err-target-missing
   :description "Dynamic error — cites the parsed fn-id."
   :args {:parsed {:type :jsonb}}
   :return-type :jsonb
   :effects #{}}

  {:name :_inline-bind-err-binding-exists
   :parent :const
   :return-type :jsonb
   :args {:value {:ok false :error "A binding already exists for this fn+slot — delete it first" :reason :binding-exists}}}

  {:name :_inline-bind-apply
   :description "Success branch — vault-put at path, then create the :secret-path-kinded binding. Rolls back vault on graphden failure."
   :args {:parsed {:type :jsonb}}
   :return-type :jsonb
   :effects #{:db :io}}

  {:name :_create-inline-binding-data
   :description "POST /api/secret-bindings — flat `:cond` of 6 guards + apply."
   :parent :cond
   :args {:clauses [:_inline-bind-fn-id-missing?   :_inline-bind-err-fn-id-missing
                    :_inline-bind-slot-id-missing? :_inline-bind-err-slot-id-missing
                    :_inline-bind-path-blank?      :_inline-bind-err-path-blank
                    :_inline-bind-value-missing?   :_inline-bind-err-value-missing
                    :_inline-bind-target-missing?  :_inline-bind-err-target-missing
                    :_inline-bind-exists?          :_inline-bind-err-binding-exists
                    {:value true}                  :_inline-bind-apply]
          :parsed :_inline-bind-parsed
          :target-fn-row :_inline-bind-target-fn-row
          :existing :_inline-bind-existing}}

  {:name :create-inline-binding-handler
   :description "Ring handler for POST /api/secrets/binding (auth-required)."
   :parent :json-handler
   :args {:data :_create-inline-binding-data}}

  ;; ---------------------------------------------------------------------
  ;; PUT /api/secrets/:fn-id/value — rotate value. Body `{:value …}`.
  ;; Path-binding in graphden is unchanged; the new value lands as a
  ;; new KV v2 version in OpenBao.
  ;; ---------------------------------------------------------------------

  ;; --- C9 atoms: rotate-secret variant-2 decomposition.
  ;; Reuses delete-side shared lookups (fn-row + vault-get-id +
  ;; secret-leaf-id) by binding `parsed` to the rotate parsed —
  ;; both shapes carry `:fn-id`.
  {:name :_rotate-secret-parsed
   :description "Parse PUT /api/secrets/:fn-id/value into `{:fn-id :fn-id-ref :value}`."
   :args {:request {:type :ring-request-shape}}
   :return-type :jsonb
   :effects #{}}

  {:name :_rotate-secret-value-missing?
   :description "Guard — request body had no `:value` (or non-string)."
   :args {:parsed {:type :jsonb}}
   :return-type :bool
   :effects #{}}

  {:name :_rotate-secret-path
   :description "Resolve the vault path bound on the secret fn."
   :args {:parsed {:type :jsonb} :fn-row {:type :jsonb}}
   :return-type :text
   :effects #{:db}}

  {:name :_rotate-secret-path-missing?
   :description "Guard — path-binding missing on the fn (corrupted state)."
   :args {:path {:type :text}}
   :return-type :bool
   :effects #{}}

  {:name :_rotate-secret-err-not-found
   :description "Dynamic error — cites the raw fn-id-ref."
   :args {:parsed {:type :jsonb}}
   :return-type :jsonb
   :effects #{}}

  {:name :_rotate-secret-err-not-a-secret
   :description "Dynamic error — cites the raw fn-id-ref."
   :args {:parsed {:type :jsonb}}
   :return-type :jsonb
   :effects #{}}

  {:name :_rotate-secret-err-value-missing
   :parent :const
   :return-type :jsonb
   :args {:value {:ok false :error "Required field ':value' (string) is missing"}}}

  {:name :_rotate-secret-err-path-missing
   :parent :const
   :return-type :jsonb
   :args {:value {:ok false :error "Secret has no :path binding (corrupted state?)" :reason :missing-binding}}}

  {:name :_rotate-secret-apply
   :description "Success branch — vault-put new value at the bound path."
   :args {:parsed {:type :jsonb} :fn-row {:type :jsonb} :path {:type :text}}
   :return-type :jsonb
   :effects #{:io}}

  {:name :_rotate-secret-data
   :description "PUT /api/secrets/:fn-id/value — flat `:cond` of 4 guards + apply. Lazy short-circuit means the vault-put only runs when every guard passes."
   :parent :cond
   :args {:clauses [:_delete-secret-not-found?     :_rotate-secret-err-not-found
                    :_delete-secret-not-a-secret?  :_rotate-secret-err-not-a-secret
                    :_rotate-secret-value-missing? :_rotate-secret-err-value-missing
                    :_rotate-secret-path-missing?  :_rotate-secret-err-path-missing
                    {:value true}                  :_rotate-secret-apply]
          :parsed :_rotate-secret-parsed
          :fn-row :_delete-secret-fn-row
          :vault-get-id :_delete-secret-vault-get-id
          :secret-leaf-id :_delete-secret-leaf-id
          :path :_rotate-secret-path}}

  {:name :rotate-secret-handler
   :description "Ring handler for PUT /api/secrets/:fn-id/value (auth-required)."
   :parent :json-handler
   :args {:data :_rotate-secret-data}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/secrets/:fn-id/migrate — convert legacy `:vault-get`
  ;; shape to new `:secret-leaf` shape. Vault contents unchanged.
  ;; ---------------------------------------------------------------------

  ;; --- C10 atoms: migrate-to-secret-leaf variant-2 decomposition.
  ;; Reuses delete-side shared lookups (fn-row + vault-get-id +
  ;; secret-leaf-id).
  {:name :_migrate-secret-parsed
   :description "Parse POST /api/secrets/:fn-id/migrate URL into `{:fn-id :fn-id-ref}`."
   :args {:request {:type :ring-request-shape}}
   :return-type :jsonb
   :effects #{}}

  {:name :_migrate-secret-base-fns-missing?
   :description "Guard #2 — `:vault-get` or `:secret-leaf` base-fn not loaded."
   :args {:vault-get-id {:type :uuid} :secret-leaf-id {:type :uuid}}
   :return-type :bool
   :effects #{}}

  {:name :_migrate-secret-not-legacy?
   :description "Guard #3 — fn's parent-ids != [:vault-get] (already migrated OR wrong shape)."
   :args {:fn-row {:type :jsonb} :vault-get-id {:type :uuid}}
   :return-type :bool
   :effects #{}}

  {:name :_migrate-secret-legacy-binding
   :description "Read the legacy `:path`-slot binding from the fn. Nil when missing (corrupted)."
   :args {:parsed {:type :jsonb} :vault-get-id {:type :uuid}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :_migrate-secret-legacy-binding-missing?
   :description "Guard #4 — legacy binding row missing."
   :args {:legacy-binding {:type :jsonb}}
   :return-type :bool
   :effects #{}}

  {:name :_migrate-secret-new-slot-id
   :description "Look up `:secret-leaf`'s `:in` slot id (target of new binding)."
   :args {:secret-leaf-id {:type :uuid}}
   :return-type :uuid
   :effects #{:db}}

  {:name :_migrate-secret-new-slot-missing?
   :description "Guard #5 — `:secret-leaf` has no inherited slot (web.vault corrupt)."
   :args {:new-slot-id {:type :uuid}}
   :return-type :bool
   :effects #{}}

  {:name :_migrate-secret-err-not-legacy
   :description "Dynamic error — cites the raw fn-id-ref."
   :args {:parsed {:type :jsonb}}
   :return-type :jsonb
   :effects #{}}

  {:name :_migrate-secret-err-base-fns-missing
   :parent :const
   :return-type :jsonb
   :args {:value {:ok false :error ":vault-get / :secret-leaf base-fn not found — package web.vault not loaded"}}}

  {:name :_migrate-secret-err-binding-missing
   :parent :const
   :return-type :jsonb
   :args {:value {:ok false :error "Legacy secret has no :path binding (corrupted state?)" :reason :missing-binding}}}

  {:name :_migrate-secret-err-slot-missing
   :parent :const
   :return-type :jsonb
   :args {:value {:ok false :error ":secret-leaf has no inherited slot — package web.vault corrupt?" :reason :missing-slot}}}

  {:name :_migrate-secret-apply
   :description "Success branch — delete legacy binding → flip parent-ids → create new `:secret-path`-kinded binding on `:in` slot."
   :args {:parsed {:type :jsonb} :legacy-binding {:type :jsonb}
          :new-slot-id {:type :uuid} :secret-leaf-id {:type :uuid}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :_migrate-secret-data
   :description "POST /api/secrets/:fn-id/migrate — flat `:cond` of 5 guards + apply. Vault contents untouched."
   :parent :cond
   :args {:clauses [:_delete-secret-not-found?      :_delete-secret-err-not-found
                    :_migrate-secret-base-fns-missing? :_migrate-secret-err-base-fns-missing
                    :_migrate-secret-not-legacy?     :_migrate-secret-err-not-legacy
                    :_migrate-secret-legacy-binding-missing? :_migrate-secret-err-binding-missing
                    :_migrate-secret-new-slot-missing? :_migrate-secret-err-slot-missing
                    {:value true}                    :_migrate-secret-apply]
          :parsed :_migrate-secret-parsed
          :fn-row :_delete-secret-fn-row
          :vault-get-id :_delete-secret-vault-get-id
          :secret-leaf-id :_delete-secret-leaf-id
          :legacy-binding :_migrate-secret-legacy-binding
          :new-slot-id :_migrate-secret-new-slot-id}}

  {:name :migrate-secret-handler
   :description "Ring handler for POST /api/secrets/:fn-id/migrate (auth-required)."
   :parent :json-handler
   :args {:data :_migrate-secret-data}}

  ;; ---------------------------------------------------------------------
  ;; DELETE /api/secrets/:fn-id — hard delete. Rejected with 409 +
  ;; usages list if any fn references the secret.
  ;; ---------------------------------------------------------------------

  ;; --- C8 atoms: delete-secret variant-2 decomposition.
  {:name :_delete-secret-parsed
   :description "Parse `DELETE /api/secrets/:fn-id` URL into `{:fn-id <uuid|nil> :fn-id-ref <raw>}`. Raw form preserved for dynamic error messages."
   :args {:request {:type :ring-request-shape}}
   :return-type :jsonb
   :effects #{}}

  {:name :_delete-secret-fn-row
   :description "Read the target fn row by id; nil when invalid / not found."
   :args {:parsed {:type :jsonb}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :_delete-secret-vault-get-id
   :description "Look up the legacy `:vault-get` base-fn id."
   :args {:request {:type :ring-request-shape}}
   :return-type :uuid
   :effects #{:db}}

  {:name :_delete-secret-leaf-id
   :description "Look up the new `:secret-leaf` base-fn id."
   :args {:request {:type :ring-request-shape}}
   :return-type :uuid
   :effects #{:db}}

  {:name :_delete-secret-not-found?
   :description "Guard #1 — invalid id OR no fn-row."
   :args {:fn-row {:type :jsonb}}
   :return-type :bool
   :effects #{}}

  {:name :_delete-secret-not-a-secret?
   :description "Guard #2 — fn row exists but parent != [:vault-get|:secret-leaf]."
   :args {:fn-row {:type :jsonb} :vault-get-id {:type :uuid} :secret-leaf-id {:type :uuid}}
   :return-type :bool
   :effects #{}}

  {:name :_delete-secret-usages
   :description "Find every fn that references the target — empty when delete can proceed."
   :args {:parsed {:type :jsonb}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :_delete-secret-in-use?
   :description "Guard #3 — usages list is non-empty."
   :args {:usages {:type :jsonb}}
   :return-type :bool
   :effects #{}}

  {:name :_delete-secret-err-not-found
   :description "Dynamic error builder — cites the raw fn-id-ref."
   :args {:parsed {:type :jsonb}}
   :return-type :jsonb
   :effects #{}}

  {:name :_delete-secret-err-not-a-secret
   :description "Dynamic error builder — cites the raw fn-id-ref."
   :args {:parsed {:type :jsonb}}
   :return-type :jsonb
   :effects #{}}

  {:name :_delete-secret-err-in-use
   :description "Dynamic error builder — count + usages list."
   :args {:usages {:type :jsonb}}
   :return-type :jsonb
   :effects #{}}

  {:name :_delete-secret-apply
   :description "Success branch — vault-delete + binding-delete + fn-delete (through crud.entities so the graph cache invalidates)."
   :args {:parsed {:type :jsonb} :fn-row {:type :jsonb}}
   :return-type :jsonb
   :effects #{:db :io}}

  {:name :_delete-secret-data
   :description "DELETE /api/secrets/:fn-id — flat `:cond` of `[not-found? → 404-shape, not-a-secret? → 409-shape, in-use? → 409 with usages list, true → apply]`. Lazy short-circuit means vault-delete + graphden deletes only run when every guard passes."
   :parent :cond
   :args {:clauses [:_delete-secret-not-found?     :_delete-secret-err-not-found
                    :_delete-secret-not-a-secret?  :_delete-secret-err-not-a-secret
                    :_delete-secret-in-use?        :_delete-secret-err-in-use
                    {:value true}                  :_delete-secret-apply]
          :parsed :_delete-secret-parsed
          :fn-row :_delete-secret-fn-row
          :vault-get-id :_delete-secret-vault-get-id
          :secret-leaf-id :_delete-secret-leaf-id
          :usages :_delete-secret-usages}}

  {:name :delete-secret-handler
   :description "Ring handler for DELETE /api/secrets/:fn-id (auth-required)."
   :parent :json-handler
   :args {:data :_delete-secret-data}}]}
