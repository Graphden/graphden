{:namespace "app.editor"
 :description "Execute-feature partials — execute-popover shell, execute-result body (incl. inline variant), execute-history panel, and the runtime-effects strip."
 :fns
 [;; ---------------------------------------------------------------------
  ;; execute-popover shell — `GET /partials/execute-popover?fn-id=<uuid>`.
  ;; Server renders the header / effects banner / free-arg scaffold /
  ;; options row / action bar / hosts; `editor-execute.js` mounts the
  ;; per-arg value-forms into the `[data-slot-id]` hosts (same
  ;; `/api/value-form` flow as before) and owns the run / poll /
  ;; cancel / history lifecycle. Free args come from the backend's own
  ;; `:free-arg-slot-map` — the JS `freeArgsOf` re-derivation (which
  ;; described itself as a mirror of that very fn) is gone, along with
  ;; its wait-for-subtree workaround.

  ;; `:nullable-uuid` honestly — `parse-uuid` yields nil for a
  ;; missing/malformed param; the shell then degrades to the
  ;; "(anonymous)" header (see the missing-fn-id test) instead of
  ;; pretending the value can't be nil.
  {:name :_xp-row
   :parent :fn-row-by-id
   :args {:fn-id {:ref :fn-id-param :type :nullable-uuid}}}

  {:name :_xp-name
   :parent :get
   :args {:coll :_xp-row :key {:value :name} :default nil}}

  {:name :_xp-title-name
   :parent :if
   :args {:test {:parent :some? :args {:value :_xp-name}}
          :then :_xp-name
          :else {:value "(anonymous)"}}}

  {:name :_xp-title
   :parent :str-join
   :args {:coll [{:value "Run :"} :_xp-title-name] :separator {:value ""}}}

  ;; The branch pill is inserted CLIENT-side after the swap — which
  ;; branch chip the user sees is client state (URL ?branch= +
  ;; localStorage), and the JS already owns that surface.
  {:name :_xp-header
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-popover-header"}}
          :children [{:parent :hiccup
                      :args {:tag {:value "span"}
                             :attrs {:value {:class "execute-popover-title"}}
                             :children [:_xp-title]}}
                     {:value [:button {:type "button"
                                       :class "execute-history-toggle"
                                       :title "Show persisted runs of this fn"
                                       :aria-expanded "false"} "History"]}
                     {:value [:button {:type "button"
                                       :class "execute-popover-close"
                                       :aria-label "Close run-fn popover"} "×"]}]}}

  ;; --- effects banner ---------------------------------------------------

  {:name :_xp-entry
   :parent :rich-type-of-name
   :args {:fn-name :_xp-name}}

  {:name :_xp-effects
   :description "Sorted vec of the fn's computed effects (raw registry entry holds a set of keywords)."
   :parent :sort
   :args {:coll {:parent :vec
                 :args {:coll {:parent :get
                               :args {:coll :_xp-entry
                                      :key {:value :effects}
                                      :default []}}}}}}

  {:name :_xp-has-effects?
   :parent :not
   :args {:value {:parent :empty? :args {:coll :_xp-effects}}}}

  {:name :_xp-eff-chip-class
   :parent :str-join
   :args {:coll [{:value "effects-chip effects-chip-"} :_kw-item-name]
          :separator {:value ""}}}

  {:name :_xp-eff-chip
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:parent :zipmap
                  :args {:keys [{:value :class}]
                         :vals [:_xp-eff-chip-class]}}
          :children [:_kw-item-name]}}

  {:name :_xp-eff-chips
   :parent :map
   :args {:func :_xp-eff-chip :coll :_xp-effects}}

  {:name :_xp-effects-banner
   :parent :if
   :args {:test :_xp-has-effects?
          :then {:parent :hiccup
                 :args {:tag {:value "div"}
                        :attrs {:value {:class "execute-effects-warning"}}
                        :children [{:value [:span {:class "execute-effects-warning-label"} "side effects: "]}
                                   :_xp-eff-chips]}}
          :else :_hidden-span}}

  ;; --- free-arg scaffold ------------------------------------------------

  {:name :_xp-free-map
   :parent :free-arg-slot-map
   :args {:fn-id {:ref :fn-id-param :type :nullable-uuid}}}

  {:name :_xp-free-names
   :description "Free-arg names, sorted for a stable row order (the slot-map is unordered)."
   :parent :sort
   :args {:coll {:parent :vec
                 :args {:coll {:parent :keys :args {:map :_xp-free-map}}}}}}

  {:name :_xp-arg-slot-id-text
   :parent :to-str
   :args {:value {:parent :get
                  :args {:coll :_xp-free-map :key {:as :item} :default nil}}}}

  {:name :_xp-arg-host
   :description "Empty per-arg mount host — editor-execute.js fetches `/api/value-form` for the `(fn-id, slot-id)` pair and renders the widget into it post-swap."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:parent :zipmap
                  :args {:keys [{:value :class} {:value :data-slot-id} {:value :data-slot-name}]
                         :vals [{:value "execute-arg-form"}
                                :_xp-arg-slot-id-text
                                :_kw-item-name]}}
          :children [{:value "…"}]}}

  {:name :_xp-arg-row
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-arg-row"}}
          :children [{:parent :hiccup
                      :args {:tag {:value "div"}
                             :attrs {:value {:class "execute-arg-label"}}
                             :children [:_kw-item-name]}}
                     :_xp-arg-host]}}

  {:name :_xp-arg-rows
   :parent :map
   :args {:func :_xp-arg-row :coll :_xp-free-names}}

  {:name :_xp-body
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-popover-body"}}
          :children [{:parent :if
                      :args {:test {:parent :empty? :args {:coll :_xp-free-names}}
                             :then {:value [:div {:class "execute-no-args-note"}
                                            "No free arguments — click Run to invoke."]}
                             :else :_hidden-span}}
                     :_xp-arg-rows]}}

  ;; --- options + actions -----------------------------------------------
  ;; Effects-bearing fns: confirm checkbox gates Run (server emits Run
  ;; disabled; JS live-toggles), persist is pre-checked + locked (the
  ;; backend auto-persists effectful runs regardless).

  ;; The "capture values" checkbox is the SECOND-STEP control of the
  ;; Debug-P3 value capture: server emits it disabled; JS enables it
  ;; only while "Trace path" is checked, and checking it opens an
  ;; explicit confirm dialog with an estimated cost line (PHILOSOPHY
  ;; § Debugging constraint 3) before it sticks.
  {:name :_xp-options
   :parent :if
   :args {:test :_xp-has-effects?
          :then {:value [:div {:class "execute-options-row"}
                         [:label {:class "execute-option-label execute-confirm-label"}
                          [:input {:type "checkbox" :class "execute-confirm-checkbox"}]
                          [:span " I understand this will produce side effects"]]
                         [:label {:class "execute-option-label execute-option-label-locked"
                                  :title "Automatically saved — runs that produce side effects are always persisted for audit trail."}
                          [:input {:type "checkbox" :class "execute-persist-checkbox"
                                   :checked "checked" :disabled "disabled"}]
                          [:span " Save to history"]]
                         [:label {:class "execute-option-label"
                                  :title "Record which fns this run traverses (with per-call durations and cache hits). Off by default — tracing adds a small capture cost to the run."}
                          [:input {:type "checkbox" :class "execute-trace-checkbox"}]
                          [:span " Trace path"]]
                         [:label {:class "execute-option-label execute-capture-values-label"
                                  :title "Also record each traversed fn's return value (up to 4 KB per value; secret-touching fns stay hidden). Requires Trace path and an explicit confirmation — value capture is the expensive mode."}
                          [:input {:type "checkbox" :class "execute-capture-values-checkbox"
                                   :disabled "disabled"}]
                          [:span " + capture values"]]]}
          :else {:value [:div {:class "execute-options-row"}
                         [:label {:class "execute-option-label"
                                  :title "When checked, this run is saved to fn-execution storage. Pure fast runs are NOT saved by default — tick this for runs you want to keep."}
                          [:input {:type "checkbox" :class "execute-persist-checkbox"}]
                          [:span " Save to history"]]
                         [:label {:class "execute-option-label"
                                  :title "Record which fns this run traverses (with per-call durations and cache hits). Off by default — tracing adds a small capture cost to the run."}
                          [:input {:type "checkbox" :class "execute-trace-checkbox"}]
                          [:span " Trace path"]]
                         [:label {:class "execute-option-label execute-capture-values-label"
                                  :title "Also record each traversed fn's return value (up to 4 KB per value; secret-touching fns stay hidden). Requires Trace path and an explicit confirmation — value capture is the expensive mode."}
                          [:input {:type "checkbox" :class "execute-capture-values-checkbox"
                                   :disabled "disabled"}]
                          [:span " + capture values"]]]}}}

  {:name :_xp-actions
   :parent :if
   :args {:test :_xp-has-effects?
          :then {:value [:div {:class "execute-action-bar"}
                         [:button {:type "button" :class "execute-run-btn"
                                   :disabled "disabled"
                                   :title "Confirm side-effects acknowledgement first"} "Run"]
                         [:button {:type "button" :class "execute-cancel-btn"
                                   :style "display:none"} "Cancel"]]}
          :else {:value [:div {:class "execute-action-bar"}
                         [:button {:type "button" :class "execute-run-btn"} "Run"]
                         [:button {:type "button" :class "execute-cancel-btn"
                                   :style "display:none"} "Cancel"]]}}}

  {:name :_xp-fragment
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-popover-content"}}
          :children [:_xp-header
                     {:value [:div {:class "execute-history-host"
                                    :style "display:none"}]}
                     :_xp-effects-banner
                     :_xp-body
                     :_xp-options
                     :_xp-actions
                     {:value [:div {:class "execute-result-host"}]}]}}

  {:name :_xp-html
   :parent :render-hiccup
   :args {:hiccup :_xp-fragment}}

  {:name :_partial-xp-handler
   :lambda-params [:request]
   :description "Ring handler for `GET /partials/execute-popover?fn-id=<uuid>` — the Run-popover shell as `text/html`. JS mounts value-forms into the arg hosts and owns run/poll/cancel/history."
   :parent :html-ok-response
   :args {:body :_xp-html}}

  ;; ---------------------------------------------------------------------
  ;; execute-result body partial. Replaces the JS `renderResultBody`
  ;; chain in `editor-execute-result.js` — `renderListResult` /
  ;; `renderRecordResult` / `renderScalarResult` / `renderTaintedPane`
  ;; / large-JSON-preview / 5MB-truncated note all migrate into the
  ;; source-side `render-execute-result-hiccup` walker; this partial
  ;; reads the execution row + emits the body hiccup.
  ;;
  ;; URL: `GET /partials/execute-result?id={uuid}`. Consumers:
  ;; `editor-execute-history.js` (row-expand body) + (future)
  ;; `editor-execute.js` orchestrator (post-Run body).

  {:name :_partial-execute-result-id-str
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "id"}}}

  {:name :_partial-execute-result-id
   :parent :parse-uuid
   :args {:string :_partial-execute-result-id-str}}

  {:name :_partial-execute-result-exec
   :parent :get-execution
   :args {:id :_partial-execute-result-id}}

  {:name :_partial-execute-result-fragment
   :description "Execute-result body hiccup for a persisted exec-id. Reparents `:_er-body` (the pure-graph walker chain in `app/execution/fns.edn`)."
   :parent :_er-body
   :args {:exec :_partial-execute-result-exec}}

  {:name :_partial-execute-result-html
   :parent :render-hiccup
   :args {:hiccup :_partial-execute-result-fragment}}

  {:name :_partial-execute-result-handler
   :lambda-params [:request]
   :description "Ring handler for `GET /partials/execute-result?id={uuid}` — returns the execution body hiccup as `text/html`. nil execution → an `[:span hidden]` (the popover stays empty so the editor's `Loading…` → empty path is graceful)."
   :parent :html-ok-response
   :args {:body :_partial-execute-result-html}}

  ;; --- POST /partials/execute-result-inline — same hiccup off a
  ;; POSTed body (not a persisted execution-id). The orchestrator's
  ;; inline-Run path uses this when persist?=false: the result lives
  ;; only in the POST response and never hits storage, so the
  ;; `?id={uuid}` endpoint can't read it. We round-trip the JSON
  ;; response back to the server purely so the editor's render layer
  ;; stays exclusively server-side — no JS branch reading
  ;; `body.result` / `body.error` and building DOM locally.

  {:name :_partial-execute-result-inline-body
   :description "JSON request body — the execution-row shape `/api/execute` returns inline. `:parse-json-body` types its return as `:nullable-jsonb`; the orchestrator only calls this partial with a keyword-keyed map body, so we narrow to `:nullable-keyword-map` for the downstream `:_er-body` slot."
   :parent :parse-json-body
   :return-type :nullable-keyword-map
   :args {:request {:as :request}}}

  {:name :_partial-execute-result-inline-fragment
   :description "Same `:_er-body` walker as the id-based GET sibling, but `:exec` comes from the POST body instead of storage."
   :parent :_er-body
   :args {:exec :_partial-execute-result-inline-body}}

  {:name :_partial-execute-result-inline-html
   :parent :render-hiccup
   :args {:hiccup :_partial-execute-result-inline-fragment}}

  {:name :_partial-execute-result-inline-handler
   :lambda-params [:request]
   :description "Ring handler for `POST /partials/execute-result-inline` — body is the JSON shape `/api/execute` returns inline (with `:status` / `:result` / `:error` / `:touched-secret?` / etc.). Same `:render-execute-result-hiccup` walker the id-based GET partial uses; lets the orchestrator render non-persisted runs server-side too."
   :parent :html-ok-response
   :args {:body :_partial-execute-result-inline-html}}

  ;; ---------------------------------------------------------------------
  ;; Execute-history panel — list of persisted runs for one fn (across
  ;; all of its versions, current branch). Lazy-fetched when the user
  ;; clicks the "History" toggle in the execute popover header.
  ;;
  ;; v1 scope: status pill + timestamp + preview + Repeat button. The
  ;; tainted/audit badges and the audit-filter chip are deferred —
  ;; surfacing them server-side needs richer per-row taint + secret
  ;; introspection than the current /api/executions exposes, and the
  ;; existing e2e contract (status + preview + repeat-btn) doesn't
  ;; depend on them.
  ;; ---------------------------------------------------------------------

  {:name :_partial-exec-hist-data
   :description "Live by-fn executions data. Reuses `:_list-executions-by-fn` — same cond / parsed shape `/api/executions` uses, so the partial is the HTML projection of that JSON."
   :parent :_list-executions-by-fn}

  {:name :_partial-exec-hist-rows
   :description "`:executions` list out of the envelope. Falls to `[]` for the error envelope path (no fn-id supplied) so the empty-state renders cleanly."
   :parent :get
   :args {:coll :_partial-exec-hist-data
          :key {:value :executions}
          :default {:value []}}}

  {:name :_partial-exec-hist-empty?
   :parent :empty?
   :args {:coll :_partial-exec-hist-rows}}

  ;; --- Per-row HOF callback.
  {:name :_partial-eh-row-id
   :parent :get
   :args {:coll {:as :item} :key {:value :id} :default {:value ""}}}

  {:name :_partial-eh-row-status-kw
   :parent :get
   :args {:coll {:as :item} :key {:value :status} :default nil}}

  ;; Status is keyword (`:succeeded` / `:failed` / `:cancelled`) —
  ;; `:name` strips the leading `:` for both class suffix and visible
  ;; text. `:coalesce` survives the rare nil-status row.
  {:name :_partial-eh-row-status-text
   :parent :coalesce
   :args {:value {:parent :name :args {:value :_partial-eh-row-status-kw}}
          :default {:value "?"}}}

  {:name :_partial-eh-row-status-class
   :parent :str-join
   :args {:coll [{:value "execute-history-status execute-history-status-"}
                 :_partial-eh-row-status-text]
          :separator {:value ""}}}

  {:name :_partial-eh-row-status-attrs
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :class}
          :value :_partial-eh-row-status-class}}

  {:name :_partial-eh-row-status-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs :_partial-eh-row-status-attrs
          :children [:_partial-eh-row-status-text]}}

  ;; `:decode-row` parses timestamptz columns into `java.sql.Timestamp`
  ;; objects, not strings — `:subs` on one throws
  ;; `count not supported on type Timestamp`. Stringify first via
  ;; `:to-str` (Timestamp's `.toString` is the SQL shape
  ;; "YYYY-MM-DD HH:MM:SS.…", which fits the 16-char truncation
  ;; cleanly).
  {:name :_partial-eh-row-started-at
   :parent :get
   :args {:coll {:as :item} :key {:value :started-at} :default {:value ""}}}

  {:name :_partial-eh-row-started-at-text
   :parent :to-str
   :args {:value :_partial-eh-row-started-at}}

  {:name :_partial-eh-row-ts-short
   :parent :subs
   :args {:string :_partial-eh-row-started-at-text
          :start {:value 0}
          :end {:value 16}}}

  {:name :_partial-eh-row-ts-span
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "execute-history-ts"}}
          :children [:_partial-eh-row-ts-short]}}

  ;; Repeat button — carries `data-execution-id` so the post-swap JS
  ;; handler can wire `applyHistoryArgs(fnEntity, id)` by selector.
  {:name :_partial-eh-row-repeat-attrs
   :parent :assoc
   :args {:map {:value {:type "button"
                        :class "execute-history-repeat-btn"
                        :title "Re-fill the form with this run's args"}}
          :key {:value :data-execution-id}
          :value :_partial-eh-row-id}}

  {:name :_partial-eh-row-repeat-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_partial-eh-row-repeat-attrs
          :children ["Repeat"]}}

  ;; "path" button (Debug P2) — rendered only for rows whose execution
  ;; captured a `:path-trace` (submitted with the "Trace path" box on).
  ;; Carries `data-execution-id`; the post-swap JS handler fetches the
  ;; row JSON and highlights the traversed fns on the canvas
  ;; (`editor-path-view.js`).
  {:name :_partial-eh-row-path-trace
   :parent :get
   :args {:coll {:as :item} :key {:value :path-trace} :default nil}}

  {:name :_partial-eh-row-path-attrs
   :parent :assoc
   :args {:map {:value {:type "button"
                        :class "execute-history-path-btn"
                        :title "Show this run's execution path on the canvas"}}
          :key {:value :data-execution-id}
          :value :_partial-eh-row-id}}

  {:name :_partial-eh-row-path-btn-el
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_partial-eh-row-path-attrs
          :children ["path"]}}

  {:name :_partial-eh-row-path-btn
   :parent :if
   :args {:test :_partial-eh-row-path-trace
          :then :_partial-eh-row-path-btn-el
          :else :_hidden-span}}

  ;; "tree" button — the step-through call-tree view of the same trace
  ;; (`/partials/execute-trace`; editor-trace-view.js owns the panel).
  ;; Same render condition as "path": only rows carrying a trace.
  {:name :_partial-eh-row-tree-attrs
   :parent :assoc
   :args {:map {:value {:type "button"
                        :class "execute-history-tree-btn"
                        :title "Step through this run's call tree"}}
          :key {:value :data-execution-id}
          :value :_partial-eh-row-id}}

  {:name :_partial-eh-row-tree-btn-el
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs :_partial-eh-row-tree-attrs
          :children ["tree"]}}

  {:name :_partial-eh-row-tree-btn
   :parent :if
   :args {:test :_partial-eh-row-path-trace
          :then :_partial-eh-row-tree-btn-el
          :else :_hidden-span}}

  ;; Preview text dispatch by status. JSON-stringifying the result
  ;; server-side keeps the format identical to what `shortPreview`
  ;; produced in JS. Error path picks `:error`; cancelled is literal.
  {:name :_partial-eh-row-result-json
   :parent :to-json-string
   :args {:data {:parent :get :args {:coll {:as :item}
                                     :key {:value :result}
                                     :default nil}}}}

  {:name :_partial-eh-row-error-text
   :parent :coalesce
   :args {:value {:parent :get :args {:coll {:as :item}
                                      :key {:value :error}
                                      :default nil}}
          :default {:value ""}}}

  {:name :_partial-eh-row-succeeded?
   :parent :equal?
   :args {:a :_partial-eh-row-status-kw :b {:value :succeeded}}}

  {:name :_partial-eh-row-failed?
   :parent :equal?
   :args {:a :_partial-eh-row-status-kw :b {:value :failed}}}

  {:name :_partial-eh-row-preview-text
   :parent :cond
   :args {:clauses [:_partial-eh-row-succeeded?  :_partial-eh-row-result-json
                    :_partial-eh-row-failed?     :_partial-eh-row-error-text
                    {:value true}                :_partial-eh-row-status-text]}}

  {:name :_partial-eh-row-preview-div
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-history-preview"}}
          :children [:_partial-eh-row-preview-text]}}

  ;; Row header (status + timestamp + Repeat) + preview body.
  {:name :_partial-eh-row-head
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-history-row-head"}}
          :children [:_partial-eh-row-status-span
                     :_partial-eh-row-ts-span
                     :_partial-eh-row-repeat-btn
                     :_partial-eh-row-path-btn
                     :_partial-eh-row-tree-btn]}}

  {:name :_partial-eh-row-attrs
   :parent :assoc
   :args {:map {:value {:class "execute-history-row"}}
          :key {:value :data-execution-id}
          :value :_partial-eh-row-id}}

  {:name :_partial-eh-row
   :description "Per-row hiccup. Row carries `data-execution-id` for the post-swap row-click expand binding; the Repeat button carries the same attribute for its own binding."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs :_partial-eh-row-attrs
          :children [:_partial-eh-row-head :_partial-eh-row-preview-div]}}

  {:name :_partial-eh-rendered-rows
   :parent :map
   :args {:func :_partial-eh-row :coll :_partial-exec-hist-rows}}

  {:name :_partial-eh-list
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-history-list"}}
          :children :_partial-eh-rendered-rows}}

  {:name :_partial-eh-empty-msg
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-history-empty"}}
          :children ["No saved runs yet. Tick \"Save to history\" before clicking Run to populate."]}}

  {:name :_partial-eh-body
   :parent :if
   :args {:test :_partial-exec-hist-empty?
          :then :_partial-eh-empty-msg
          :else :_partial-eh-list}}

  ;; --- usage-stats strip (Phase C1) — 7-day rollup line above the rows. ---
  {:name :_peh-stats
   :description "7-day usage rollup for the panel's fn — `{:runs :failed :cancelled :avg-ms}` from the pre-aggregated `:usage-stat` table (counts + durations only, org-scoped)."
   :parent :usage-fn-stats
   :args {:fn-id {:as :fn-id} :days 7}}

  {:name :_peh-stats-runs
   :parent :get
   :args {:coll :_peh-stats :key {:value :runs} :default 0}}

  {:name :_peh-stats-failed
   :parent :get
   :args {:coll :_peh-stats :key {:value :failed} :default 0}}

  {:name :_peh-stats-avg
   :parent :get
   :args {:coll :_peh-stats :key {:value :avg-ms} :default 0}}

  {:name :_peh-stats-text
   :parent :str
   :args {:parts [{:value "7d: "} :_peh-stats-runs {:value " runs · "}
                  :_peh-stats-failed {:value " failed · avg "}
                  :_peh-stats-avg {:value " ms"}]}}

  {:name :_peh-stats-line
   :description "The rollup strip rendered above the history rows."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-history-stats"}}
          :children [:_peh-stats-text]}}

  {:name :_partial-eh-fragment
   :description "Full execute-history panel hiccup — the 7-day usage strip, then empty-state OR the list of rows."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-history-panel"}}
          :children [:_peh-stats-line :_partial-eh-body]}}

  {:name :_partial-eh-html
   :parent :render-hiccup
   :args {:hiccup :_partial-eh-fragment}}

  {:name :_partial-execute-history-handler
   :lambda-params [:storage-query :fn-id :request]
   :description "Ring handler for `GET /partials/execute-history?fn-id=X` — returns the history panel hiccup as `text/html`. JS in `editor-execute.js` swaps the response into the panel host and binds Repeat / row-expand handlers post-swap."
   :parent :html-ok-response
   :args {:body :_partial-eh-html}}

  ;; ---------------------------------------------------------------------
  ;; Runtime-effects strip — chips for {runtime, declared} effect sets
  ;; with drift detection. Slimmed out of editor-execute-result.js
  ;; (rendered per-execution-result, was the most isolated of that
  ;; module's render helpers — single input shape, no recursive
  ;; rendering of arbitrary result values).
  ;;
  ;; Effects come in as comma-separated kebab-case names via query
  ;; string (`?runtime=db,io&declared=db`) so the JS caller can build
  ;; the URL without JSON-encoding. Empty list → empty string → split
  ;; returns `[""]` so we filter blanks.
  ;; ---------------------------------------------------------------------

  {:name :_partial-rfx-runtime-raw
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "runtime"}}}

  {:name :_partial-rfx-declared-raw
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "declared"}}}

  {:name :_partial-rfx-runtime-split
   :parent :str-split
   :args {:string {:parent :coalesce :args {:value :_partial-rfx-runtime-raw :default ""}}
          :separator {:value ","}}}

  {:name :_partial-rfx-declared-split
   :parent :str-split
   :args {:string {:parent :coalesce :args {:value :_partial-rfx-declared-raw :default ""}}
          :separator {:value ","}}}

  {:name :_partial-rfx-blank?
   :parent :blank?
   :args {:string {:as :item}}}

  {:name :_partial-rfx-not-blank?
   :parent :not
   :args {:value :_partial-rfx-blank?}}

  {:name :_partial-rfx-runtime
   :description "Cleaned runtime-effects list — drops empty strings produced by `str-split` on empty input."
   :parent :filter
   :args {:pred :_partial-rfx-not-blank? :coll :_partial-rfx-runtime-split}}

  {:name :_partial-rfx-declared
   :parent :filter
   :args {:pred :_partial-rfx-not-blank? :coll :_partial-rfx-declared-split}}

  {:name :_partial-rfx-empty?
   :description "Both sets empty → return empty fragment (caller's host stays untouched)."
   :parent :and
   :args {:values [{:parent :empty? :args {:coll :_partial-rfx-runtime}}
                   {:parent :empty? :args {:coll :_partial-rfx-declared}}]}}

  ;; --- Runtime chips (effects that ACTUALLY fired). Drift detection:
  ;; chip carries `execute-effects-drift` when the runtime effect isn't
  ;; in the declared set (impl widens what the rich-type promised).
  ;;
  ;; `:contains?` over a list checks INDEX, not value — so we build a
  ;; set-as-map `{eff true}` via `:into {} <pairs>` and `:contains?` it
  ;; by key. Pair HOF: `:_partial-rfx-pair-true` returns `[item true]`.
  {:name :_partial-rfx-pair-true
   :description "Per-item HOF — returns `[item true]` as a VECTOR (not list); `:into {} <list-of-pairs>` requires vector-shaped Map$Entry items at runtime."
   :parent :vec
   :args {:coll [{:as :item} {:value true}]}}

  {:name :_partial-rfx-declared-pairs
   :parent :map
   :args {:func :_partial-rfx-pair-true :coll :_partial-rfx-declared}}

  {:name :_partial-rfx-runtime-declared-set
   :parent :into
   :args {:to {:value {}} :from :_partial-rfx-declared-pairs}}

  {:name :_partial-rfx-runtime-drift?
   :parent :not
   :args {:value {:parent :contains?
                  :args {:coll :_partial-rfx-runtime-declared-set
                         :key {:as :item}}}}}

  {:name :_partial-rfx-runtime-chip-class-base
   :parent :str-join
   :args {:coll [{:value "effects-chip effects-chip-"} {:as :item}]
          :separator {:value ""}}}

  {:name :_partial-rfx-runtime-chip-class
   :parent :if
   :args {:test :_partial-rfx-runtime-drift?
          :then {:parent :str-join
                 :args {:coll [:_partial-rfx-runtime-chip-class-base
                               {:value " execute-effects-drift"}]
                        :separator {:value ""}}}
          :else :_partial-rfx-runtime-chip-class-base}}

  {:name :_partial-rfx-runtime-chip-attrs
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :class}
          :value :_partial-rfx-runtime-chip-class}}

  {:name :_partial-rfx-runtime-chip
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs :_partial-rfx-runtime-chip-attrs
          :children [{:as :item}]}}

  {:name :_partial-rfx-runtime-chips
   :parent :map
   :args {:func :_partial-rfx-runtime-chip :coll :_partial-rfx-runtime}}

  ;; --- Declared-but-unobserved chips (declared but didn't fire on this
  ;; run). Skipped entirely when no runtime data was recorded — "missing"
  ;; in that case means "unknown", not "unobserved". The check is
  ;; `runtime-non-empty? AND not (item in runtime-set)`. Same set-as-map
  ;; trick as the drift check above.
  {:name :_partial-rfx-runtime-pairs
   :parent :map
   :args {:func :_partial-rfx-pair-true :coll :_partial-rfx-runtime}}

  {:name :_partial-rfx-runtime-set
   :parent :into
   :args {:to {:value {}} :from :_partial-rfx-runtime-pairs}}

  {:name :_partial-rfx-runtime-non-empty?
   :parent :not
   :args {:value {:parent :empty? :args {:coll :_partial-rfx-runtime}}}}

  {:name :_partial-rfx-declared-show-unobserved?
   :parent :and
   :args {:values [:_partial-rfx-runtime-non-empty?
                   {:parent :not :args {:value {:parent :contains?
                                                :args {:coll :_partial-rfx-runtime-set
                                                       :key {:as :item}}}}}]}}

  {:name :_partial-rfx-declared-chip-class
   :parent :str-join
   :args {:coll [{:value "effects-chip effects-chip-"} {:as :item}
                 {:value " execute-effects-unobserved"}]
          :separator {:value ""}}}

  {:name :_partial-rfx-declared-chip-title
   :parent :str-join
   :args {:coll [{:value "Declared by the fn-def but the runtime impl didn't fire it: "}
                 {:as :item}]
          :separator {:value ""}}}

  {:name :_partial-rfx-declared-chip-shown
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:parent :assoc
                  :args {:map {:parent :assoc
                               :args {:map {:value {}}
                                      :key {:value :class}
                                      :value :_partial-rfx-declared-chip-class}}
                         :key {:value :title}
                         :value :_partial-rfx-declared-chip-title}}
          :children [{:as :item}]}}

  ;; Hidden span (zero-width sentinel) when the chip should be skipped —
  ;; keeps the children-vec shape uniform across runs.
  {:name :_partial-rfx-declared-chip-hidden
   :parent :hiccup
   :args {:tag {:value "span"} :attrs {:value {:hidden "1"}} :children {:value []}}}

  {:name :_partial-rfx-declared-chip
   :parent :if
   :args {:test :_partial-rfx-declared-show-unobserved?
          :then :_partial-rfx-declared-chip-shown
          :else :_partial-rfx-declared-chip-hidden}}

  {:name :_partial-rfx-declared-chips
   :parent :map
   :args {:func :_partial-rfx-declared-chip :coll :_partial-rfx-declared}}

  ;; --- Composition.
  {:name :_partial-rfx-label
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "execute-runtime-effects-label"}}
          :children ["ran: "]}}

  ;; Wrap the label in a 1-element list so `:concat :colls` sees a
  ;; collection of collections (the inner `[:_partial-rfx-label]`
  ;; literal would store as `[:literal-kw]`, not as a ref to the
  ;; label fn-def — `:value` literals don't resolve refs).
  {:name :_partial-rfx-label-list
   :parent :list
   :args {:items [:_partial-rfx-label]}}

  {:name :_partial-rfx-strip-children
   :parent :concat
   :args {:colls [:_partial-rfx-label-list
                  :_partial-rfx-runtime-chips
                  :_partial-rfx-declared-chips]}}

  {:name :_partial-rfx-strip-populated
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "execute-runtime-effects-strip"}}
          :children :_partial-rfx-strip-children}}

  {:name :_partial-rfx-strip-empty
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:hidden "1"}} :children {:value []}}}

  {:name :_partial-rfx-strip
   :parent :if
   :args {:test :_partial-rfx-empty?
          :then :_partial-rfx-strip-empty
          :else :_partial-rfx-strip-populated}}

  {:name :_partial-rfx-html
   :parent :render-hiccup
   :args {:hiccup :_partial-rfx-strip}}

  {:name :_partial-execute-result-effects-handler
   :lambda-params [:request]
   :description "Ring handler for `GET /partials/execute-result-effects?runtime=db,io&declared=db` — returns the runtime-effects strip hiccup as `text/html`. JS in `editor-execute.js` swaps the response into the result host below the result body."
   :parent :html-ok-response
   :args {:body :_partial-rfx-html}}

  ;; ---------------------------------------------------------------------
  ;; Interactive component preview — `GET /preview?fn-id=<uuid>`
  ;;   [`&effects=confirm`] [`&branch=<ref>`]
  ;;
  ;; The devcards-L2 surface the static component-preview pane points
  ;; at: render a `:hiccup-node`-returning fn as a REAL page (runtime
  ;; scripts + htmx live) opened in a NEW TAB from the editor. A tab
  ;; keeps the editor DOM out of reach, sidesteps the global
  ;; `frame-ancestors 'none'` / `X-Frame-Options: DENY` headers (no
  ;; framing at all), and authenticates like any page navigation
  ;; (session cookie under accounts; the auth-off self-host is open by
  ;; the same `:get-auth-required` seam).
  ;;
  ;; SECURITY — SELF-HOST ONLY. Under an active tenancy addon the
  ;; route answers 403: the page would run org-authored markup and
  ;; scripts on the EDITOR origin with the viewer's session in scope —
  ;; the same stored-XSS class the `:resource-override` "cloud writes
  ;; are system-only" rule and the apps-domain split exist to prevent
  ;; (docs/tutorial/20-apps.md). The cloud path is a future
  ;; apps-domain preview owned by the tenancy addon.
  ;;
  ;; The component renders through the STANDARD execute pipeline
  ;; (`:_execute-validation` + `:_execute-apply-bound` over a
  ;; query-built parsed map), so the type-error gate, the capacity
  ;; cap, and the effectful-run auto-persist audit trail apply
  ;; unchanged. An effectful — or effects-UNKNOWN, failing closed —
  ;; component requires the explicit `effects=confirm` param; the
  ;; confirm page mirrors the Run popover's effect chips.

  {:name :_pv-parsed
   :description "Execute-pipeline parsed map for a preview render — query-param fn-id, no args, inline timeout, `persist? false` BY REQUEST (the apply's auto-persist matrix still persists effectful runs for the audit trail)."
   :parent :zipmap
   :args {:keys [{:value :fn-id} {:value :fn-name} {:value :args}
                 {:value :timeout-ms} {:value :persist?}
                 {:value :trace?} {:value :capture-values?}]
          ;; :fn-name is always nil (the preview anchors on fn-id) but
          ;; the key must be PRESENT — the execute stages' parsed-shape
          ;; is a record type, and a record with a missing field is not
          ;; a subtype (the boot sweep rejects it).
          :vals [{:ref :fn-id-param} {:value nil} {:value {}}
                 {:value 10000} {:value false} {:value false}
                 {:value false}]}}

  {:name :_pv-validation
   :description "The standard execute stage-2 guards over the preview's parsed map — nil, or the `{:ok false :error …}` rejection envelope."
   :parent :_execute-validation
   :args {:parsed :_pv-parsed}}

  ;; Binds BOTH `:_execute-apply` slots directly (not through
  ;; `:_execute-apply-bound`, whose `{:as :parsed}` rename captures the
  ;; fn-row ref's free at ITS level) so the preview's parsed map is the
  ;; one the resolve actually sees.
  {:name :_pv-outcome
   :parent :_execute-apply
   :args {:parsed :_pv-parsed
          :fn-row {:parent :_execute-fn-row :args {:parsed :_pv-parsed}}}}

  {:name :_pv-fn-id-nil?
   :parent :nil? :args {:value :fn-id-param}}

  {:name :_pv-row-nil?
   :parent :nil?
   :args {:value {:parent :get :args {:coll :_xp-row :key {:value :id} :default nil}}}}

  ;; MUTUAL subtype = semantic type equality — same rule (and trap) as
  ;; `:_er-return-is-hiccup?`: one-way `⊆ :hiccup-node` would admit
  ;; every scalar, `:hiccup-node` being a union.
  {:name :_pv-return-or-any
   :parent :coalesce
   :args {:value {:parent :fn-return-type :args {:fn-id :fn-id-param}}
          :default {:value :any}}}

  {:name :_pv-is-component?
   :parent :and
   :args {:values [{:parent :subtype?
                    :args {:candidate :_pv-return-or-any
                           :expected {:value :hiccup-node}}}
                   {:parent :subtype?
                    :args {:candidate {:value :hiccup-node}
                           :expected :_pv-return-or-any}}]}}

  {:name :_pv-not-component?
   :parent :not :args {:value :_pv-is-component?}}

  {:name :_pv-rejected?
   :parent :some? :args {:value :_pv-validation}}

  {:name :_pv-confirmed?
   :parent :equal?
   :args {:a {:parent :query-param
              :args {:request {:as :request} :param-name {:value "effects"}}}
          :b {:value "confirm"}}}

  ;; Effects UNKNOWN (no rich-types entry — e.g. an anonymous fn)
  ;; fails CLOSED: the preview auto-executes on page load, unlike the
  ;; click-gated Run popover, so "can't verify pure" means confirm.
  {:name :_pv-needs-confirm?
   :parent :and
   :args {:values [{:parent :or
                    :args {:values [{:parent :nil? :args {:value :_xp-entry}}
                                    :_xp-has-effects?]}}
                   {:parent :not :args {:value :_pv-confirmed?}}]}}

  ;; Path- AND query-preserving: rebuilt from the request's own uri +
  ;; query string, so the same chain serves the editor origin
  ;; (`/preview?fn-id=…&branch=…`) and the apps-domain cloud preview
  ;; (`/__preview?fn-id=…&t=<capsule>` — the capsule must survive the
  ;; confirm round-trip).
  {:name :_pv-confirm-href
   :parent :str
   :args {:parts [{:parent :ring-uri :args {:request {:as :request}}}
                  {:value "?"}
                  {:parent :coalesce
                   :args {:value {:parent :ring-query-string
                                  :args {:request {:as :request}}}
                          :default {:value ""}}}
                  {:value "&effects=confirm"}]}}

  ;; --- page shell — full HTML page, htmx + runtime live ---

  {:name :_pv-title
   :parent :str-join
   :args {:coll [{:value "Preview :"} :_xp-title-name] :separator {:value ""}}}

  {:name :_pv-page-html
   :description "Full preview page HTML — components stylesheet + htmx + the SSE extension in head (a component may carry `:sse-connect-attrs`), runtime dispatcher scripts at end of body. Free arg `:pv-body` — the page body hiccup a variant supplies."
   :parent :html-page-rendered
   :args {:title :_pv-title
          :head {:parent :with-htmx-sse :args {:head :graphden-page-head}}
          :scripts :graphden-runtime-scripts
          :body {:as :pv-body}}}

  {:name :_pv-banner
   :description "Slim identity strip so a preview tab is never mistaken for a real app page. Inline style — this shell is origin-neutral and deliberately independent of the editor stylesheet."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "gd-preview-banner"
                          :style "font-family: system-ui, sans-serif; font-size: 12px; color: #556; border-bottom: 1px solid #dde; padding: 6px 10px; margin-bottom: 12px;"}}
          :children [{:value "Interactive preview — :"}
                     :_xp-title-name]}}

  {:name :_pv-result
   :parent :get :args {:coll :_pv-outcome :key {:value :result} :default nil}}

  {:name :_pv-success-body
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "gd-preview-page"}}
          :children [:_pv-banner :_pv-result]}}

  {:name :_pv-ok-response
   :parent :html-ok-response
   :args {:body {:parent :_pv-page-html :args {:pv-body :_pv-success-body}}}}

  ;; --- effect-confirm page — mirrors the Run popover's gate ---

  {:name :_pv-confirm-body
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "gd-preview-page"}}
          :children [:_pv-banner
                     {:value [:p "This component declares side effects — rendering the preview will execute them."]}
                     {:parent :hiccup
                      :args {:tag {:value "div"}
                             :attrs {:value {:class "gd-preview-effects"}}
                             :children :_xp-eff-chips}}
                     {:parent :hiccup
                      :args {:tag {:value "a"}
                             :attrs {:parent :zipmap
                                     :args {:keys [{:value :href} {:value :class}]
                                            :vals [:_pv-confirm-href
                                                   {:value "gd-preview-confirm"}]}}
                             :children [{:value "Render anyway"}]}}]}}

  {:name :_pv-confirm-response
   :parent :html-ok-response
   :args {:body {:parent :_pv-page-html :args {:pv-body :_pv-confirm-body}}}}

  ;; --- gate / failure responses ---

  {:name :_pv-tenancy-active?
   :description "The tenancy addon computed capabilities for this request — multi-tenant cloud. nil = single-tenant / self-host."
   :parent :some?
   :args {:value :request-capabilities}}

  {:name :_pv-tenancy-rej
   :parent :html-error-response
   :args {:status {:value 403}
          :reason {:value "Interactive preview is self-host only. On multi-tenant cloud it would run org-authored scripts on the editor origin — use the Run popover's static component preview instead."}}}

  {:name :_pv-bad-id-rej
   :parent :html-error-response
   :args {:status {:value 400}
          :reason {:value "Missing or malformed fn-id query parameter."}}}

  {:name :_pv-not-found-rej
   :parent :html-error-response
   :args {:status {:value 404}
          :reason {:parent :str
                   :args {:parts [{:value "Function not found: "}
                                  {:parent :to-str :args {:value :fn-id-param}}]}}}}

  {:name :_pv-not-component-rej
   :parent :html-error-response
   :args {:status {:value 400}
          :reason {:value "Not a component — the fn's return type must be :hiccup-node. Use the Run popover for ordinary results."}}}

  {:name :_pv-validation-rej
   :parent :html-error-response
   :args {:status {:value 400}
          :reason {:parent :coalesce
                   :args {:value {:parent :get
                                  :args {:coll :_pv-validation
                                         :key {:value :error} :default nil}}
                          :default {:value "Preview request rejected."}}}}}

  {:name :_pv-outcome-succeeded?
   :parent :equal?
   :args {:a {:parent :name
              :args {:value {:parent :get
                             :args {:coll :_pv-outcome
                                    :key {:value :status}
                                    :default {:value :unknown}}}}}
          :b {:value "succeeded"}}}

  {:name :_pv-failed-rej
   :parent :html-error-response
   :args {:status {:value 500}
          :reason {:parent :coalesce
                   :args {:value {:parent :get
                                  :args {:coll :_pv-outcome
                                         :key {:value :error} :default nil}}
                          :default {:value "Render did not complete inline — run the fn via the Run popover instead."}}}}}

  {:name :_pv-run-response
   :parent :if
   :args {:test :_pv-outcome-succeeded?
          :then :_pv-ok-response
          :else :_pv-failed-rej}}

  {:name :_pv-handler
   :lambda-params [:storage-query :request]
   :description "Ring handler for `GET /preview` — gate cascade (tenancy 403 → bad id 400 → unknown fn 404 → non-component 400 → execute-guard rejection 400 → effect-confirm page) then the live render. `:cond` is lazy: the execute apply runs only on the final branch."
   :parent :cond
   :args {:clauses [:_pv-tenancy-active?  :_pv-tenancy-rej
                    :_pv-fn-id-nil?       :_pv-bad-id-rej
                    :_pv-row-nil?         :_pv-not-found-rej
                    :_pv-not-component?   :_pv-not-component-rej
                    :_pv-rejected?        :_pv-validation-rej
                    :_pv-needs-confirm?   :_pv-confirm-response
                    {:value true}         :_pv-run-response]}}]}
