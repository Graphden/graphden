;; Server-side counterpart to `graphden-runtime.js`: hiccup helpers
;; for building hiccup attrs the JS dispatcher knows how to
;; route on click.
;;
;; The client-side runtime registers handlers under
;; `data-action="X"`; this server-side DSL lets fn-defs
;; (components) emit the right attrs without inlining
;; `:data-action ...` literals everywhere. Composition is via
;; `:assoc` / `:merge` for additional `data-*` attrs the
;; handler needs (`:data-fn-id`, `:data-card-fn-id`, …).


{:namespace "web.runtime"
 :description "Server-side DSL for the JS runtime — build hiccup attrs that the client-side `bindActionDispatch` (in graphden-runtime.js) routes to a registered handler."
 :fns
 [;; Emit `{:data-action <name>}` as a hiccup attrs map.
  ;; Component fn-defs (`:button`, `:link`, …) merge this with
  ;; their own attrs (title, class, etc.) and the per-handler
  ;; `data-*` payload via `:merge` / `:assoc`.
  ;;
  ;; Example use from a `:button` component:
  ;;
  ;;   {:name :my-run-button
  ;;    :parent :button
  ;;    :args {:label "Run"
  ;;           :attrs {:parent :dispatch-action
  ;;                   :args {:action "run-fn"}}}}
  {:name :dispatch-action
   :description "Hiccup attrs `{:data-action <name>}` for an element the runtime should dispatch on click. Merge with `:merge` / `:assoc` to add `:data-fn-id` / `:data-card-fn-id` / `:data-binding-id` / etc when the handler needs additional context."
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :data-action}
          :value {:as :action :type :non-blank-text
                  :description "Registered handler name (see graphden-runtime.js `registerActionHandler` calls)."}}}

  ;; Escape-hatch DSL. Build attrs for a button that carries
  ;; an inline JS body the runtime evaluates on click:
  ;;
  ;;   {:data-action "custom" :data-custom-handler <body>}
  ;;
  ;; The runtime's `custom` handler (see graphden-actions-builtin.js)
  ;; reads `data-custom-handler` and runs it as
  ;; `(new Function('btn','event','host', body))(btn, event, host)`
  ;; — so the body has `btn`, `event`, `host` bindings in scope.
  ;;
  ;; Example use:
  ;;
  ;;   {:name :my-tooltip-button
  ;;    :parent :button
  ;;    :args {:label "Hover me"
  ;;           :attrs {:parent :dispatch-custom
  ;;                   :args {:body "btn.title = 'Clicked!';"}}}}
  {:name :dispatch-custom
   :description "Hiccup attrs `{:data-action \"custom\" :data-custom-handler <body>}` — wires a button's click to the runtime's `custom` action handler, which evaluates the body as `(btn, event, host) => …`."
   :parent :merge
   :args {:maps [{:value {:data-action "custom"}}
                 {:parent :assoc
                  :args {:map {:value {}}
                         :key {:value :data-custom-handler}
                         :value {:as :body :type :js-source
                                 :description "JavaScript body executed on click — has `btn`, `event`, `host` bindings in scope."}}}]}}]}
