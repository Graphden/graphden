;; Server-Sent-Events primitive — the push half of the server-driven
;; interactivity story (web.htmx is the pull half). `:sse-stream`
;; opens a `text/event-stream` on the incoming request and re-renders
;; a 0-arg fragment fn on an interval, pushing only when the HTML
;; changed. The graph-facing templates (`:sse-fragment-route` /
;; `:sse-fragment-handler`) live in app.page next to their
;; `:fragment-route` siblings; the client side pairs with
;; `:sse-connect-attrs` (web.htmx) + `:with-htmx-sse` (app.page).

{:namespace "web.sse"
 :description "SSE stream primitive — push a re-rendered fragment to the client whenever it changes (interval-driven, change-deduped, lifetime-bounded)."
 :fns
 [{:name :sse-stream
   :description "Open an SSE stream on `:request` and push `:render`'s HTML whenever it changes, re-executing every `:interval-ms` (clamped >= 1s) — and, with `:wake-on-writes`, immediately (debounced) after any write event on the graphden_events bus. Self-closes after `:max-lifetime-ms` (clamped <= 30 min; the browser's EventSource auto-reconnects, so pages stay live through bounded stream generations). 503 when the deployment-wide cap (GRAPHDEN_SSE_MAX_STREAMS, default 200) is reached."
   :args {:request {:type :ring-request-shape
                    :description "The incoming ring request — carries the httpkit async channel the stream opens on."}
          :render {:type [:fn {} :text]
                   :description "0-arg fragment renderer — typically an `:html-fragment-rendered`-shaped fn-def; re-executed per tick as a fresh logical execution."}
          :interval-ms {:type :int
                        :description "Re-render period in ms; the impl clamps to >= 1000 (an :int rather than :positive-int slot — the graph-side default flows through :coalesce, which the checker can only prove to :int)."}
          :max-lifetime-ms {:type :int
                            :description "Stream lifetime in ms; the impl clamps to <= 30 min, then the stream closes and the client reconnects."}
          :wake-on-writes {:type :bool
                           :description "When true (and the deployment wires a NOTIFY listener), any graph/data write schedules one debounced extra tick — a change reaches the client in well under a second and `:interval-ms` degrades to the keepalive ceiling. Spurious wakes cost one render (only CHANGED fragments push)."}}
   :return-type :keyword-map
   ;; :time only — deliberately NOT :network (no egress; the stream
   ;; writes into the already-open inbound socket) and NOT :process
   ;; (ticks ride the platform's shared bounded scheduler behind the
   ;; global cap, not a tenant-owned process). The fragment's own
   ;; effects are re-gated per tick under the opening request's
   ;; captured effect gate. See the impl docstring.
   :effects #{:time}}]}
