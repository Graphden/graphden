  {:name :_rtr-owner-fn-id-text
   :parent :to-str
   :args {:value :_rtr-owner-fn-id}}

  {:name :_rtr-owner-link
   :parent :hiccup
   :args {:tag {:value "a"}
          :attrs {:parent :zipmap
                  :args {:keys [{:value :href} {:value :class}
                                {:value :data-fn-id} {:value :title}]
                         :vals [{:value "#"}
                                {:value "type-inline-resolution-link"}
                                :_rtr-owner-fn-id-text
                                :_rtr-owner-link-title]}}
          :children [:_rtr-owner-label]}}

  {:name :_rtr-owner-plain
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {}}
          :children [:_rtr-owner-label]}}

  {:name :_rtr-owner-link-or-span
   :parent :if
   :args {:test :_rtr-owner-fn-id-some?
          :then :_rtr-owner-link
          :else :_rtr-owner-plain}}

  {:name :_rtr-intro
