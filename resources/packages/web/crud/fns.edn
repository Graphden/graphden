  ;; =============================================================================
  ;; FN-DEFS: tighten-fn-effects — validation chain as a :cond graph
  ;;
  ;; The handler is a `:cond`: each clause is a `[predicate 400-response]`
  ;; pair, the `:else` clause runs `:_tighten-apply` (the DB write). The
  ;; executor is lazy — `:cond` forces a clause's test but never an
  ;; un-taken clause's result — so the write runs solely when every
  ;; guard passes. `parsed` is one shared `:_tighten-parsed`, bound at
  ;; the `:cond` fn-def — the free arg every clause's predicate exposes.
  ;; =============================================================================

  {:name :_tighten-err-binding-id
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 400 :body "<p class=\"error\">Invalid binding-id</p>"}}}

  {:name :_tighten-err-effects
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 400 :body "<p class=\"error\">'effects' must be a JSON array</p>"}}}

  {:name :_tighten-err-args
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 400 :body "<p class=\"error\">'args' must be a JSON object</p>"}}}

  {:name :_tighten-err-delta
   :parent :const
   :return-type :_partial-response-shape
   :args {:value {:status 400 :body "<p class=\"error\">Body must include at least one of args / ret / effects</p>"}}}

  {:name :process-tighten-binding-effects
   :description "POST /api/bindings/:binding-id/tighten-fn-effects — narrow an fn-typed binding's effective type. The four validation guards and the success path are a flat `:cond` — alternating `[predicate 400-response]`, ending with `true → :_tighten-apply`. `:cond` is lazy, so the DB write runs only when every guard passes. Returns a partial Ring response."
   :parent :cond
   :args {:clauses [:_tighten-binding-id-invalid? :_tighten-err-binding-id
                    :_tighten-effects-invalid?    :_tighten-err-effects
                    :_tighten-args-invalid?       :_tighten-err-args
                    :_tighten-delta-empty?        :_tighten-err-delta
                    {:value true}                 :_tighten-apply]
          :parsed :_tighten-parsed}}

  {:name :tighten-binding-effects-handler
   :description "Ring handler for `POST /api/bindings/:binding-id/tighten-fn-effects` — narrow an fn-typed binding's effective type."
   :parent :html-action-response
   :args {:result :process-tighten-binding-effects}}]}
