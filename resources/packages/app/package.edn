{:name "app"
 :version "1.0.0"
 :description "Application server: common building blocks, editor UI, and server fn-defs"
 ;; `storage` is required because consumer fn-defs
 ;; (`:_list-services-rows`, …) query the DB via the direct
 ;; `:pg-query` + `:decode-row` primitives from the `storage/pg` module.
 ;; `app-base` holds the route-building vocabulary (`:route`, the method
 ;; + auth route templates, `app.common` helpers) this package's routes
 ;; compose on — extracted so the tenancy addon / registry can reach
 ;; them without depending on the whole editor. The fn `:namespace`s
 ;; (`app.common` / `app.routes.*`) are unchanged, so app's own routes
 ;; still resolve them by name exactly as before.
 :dependencies ["core" "web" "storage" "app-base"]
 :modules ["lookups" "editor" "layout" "forms" "execution" "branches" "secrets" "page" "contact-demo" "registry" "routes" "mcp" "route-groups" "server"]
 ;; `:per-pod` — every executor pod must bind its own HTTP port. A
 ;; `:singleton` listener would leave every pod but the advisory-lock
 ;; winner without a listener, so a load balancer would see one healthy
 ;; backend no matter how many pods run.
 :services [{:name :default
             :fn-name :web-server
             :enabled? true
             :restart-policy :always
             :cardinality :per-pod
             :description "Default HTTP listener — package-seeded service for the editor/API."}]}
