                                          :coll :_parse-fn-form-effects-non-blank}}}}]}}

  {:name :_parse-fn-form-expects-effects-fragment
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll {:as :form-data} :key {:value :expects-effects}}}
          :then {:parent :zipmap
                 :args {:keys [{:value :expects-effects}]
                        :vals [:_parse-fn-form-effects-parsed]}}
          :else {:value {}}}}

  {:name :_parse-fn-form-constraint-fragment
   :description "Parse the JSON-encoded constraint vector via the new `:parse-constraint` primitive (recursive keyword-restore)."
   :parent :if
   :args {:test {:parent :contains?
                 :args {:coll {:as :form-data} :key {:value :constraint}}}
          :then {:parent :zipmap
                 :args {:keys [{:value :constraint}]
                        :vals [{:parent :parse-constraint
                                :args {:raw {:parent :get
