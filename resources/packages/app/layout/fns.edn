;; Graph layout calculation
;;
;; `get-layout-data` is a graph fn-def composing base-fn primitives so
;; the layout pipeline is visible in the graph rather than hidden in a
;; single big impl:
;;
;;   get-layout-data = _compute-layout( _load-graph-cached,
;;                                      _parse-layout-request(request) )
;;   _compute-layout = _layout-place( _layout-build-elements(graph, parsed) )
;;
;; Input: {root-id: uuid-string, expansions: {fn-id: level, ...}}
;; Output: {nodes: [...], edges: [...], grid-pos: {...}, validation: {...}}


{:namespace "app.layout"
 :description "Graph-layout pass — turns raw fn/arg entities + per-call expansion specs into the {:nodes :edges :grid-pos :validation} cytoscape response."
 :fns
 [;; =============================================================================
  ;; SHAPES: layout-pipeline stage records
  ;;
  ;; Each base-fn below produces a record of a known shape; naming them
  ;; lets the pipeline's stage args / return-types read as records
  ;; instead of bare `:jsonb`. `_`-prefixed — internal to this pipeline.
  ;; =============================================================================

  {:name :_parse-layout-request-shape
   :description "Output of `:_parse-layout-request` — the layout root and the per-fn expansion-level map keyed by cytoscape node-id."
   :type {:root-id :uuid :expansions [:map :text :any]}}

  {:name :_graph-snapshot-shape
   :description "Output of `:_load-graph-cached` — every fn / slot / fn-slot / binding / list-item row plus the derived `:args` slot views. Each list element is one entity record (heterogeneous columns → `:jsonb`)."
   :type {:fns         [:list :jsonb]
          :slots       [:list :jsonb]
          :fn-slots    [:list :jsonb]
          :bindings    [:list :jsonb]
          :list-items  [:list :jsonb]
          :args        [:list :jsonb]}}

  {:name :_layout-elements-shape
   :description "Output of `:_layout-build-elements` — the cytoscape node / edge lists (each element a `{:data … :position?}` map) before grid placement."
   :type {:nodes [:list :jsonb]
          :edges [:list :jsonb]}}

  {:name :_layout-response-shape
   :description "Output of `:_layout-place` — the full layout response: placed nodes / edges plus a node-id → position map and validation summary."
   :type {:nodes      [:list :jsonb]
          :edges      [:list :jsonb]
          :grid-pos   [:map :text :jsonb]
          :validation :jsonb}}

  ;; =============================================================================
  ;; BASE-FNS: layout pipeline primitives
  ;;
  ;; Each is exactly ONE library call into `graphden.layout.*`.
  ;; Composition, error handling, and upstream-error pass-through live
  ;; in the graph fn-defs below.
  ;; =============================================================================

  {:name :_load-graph-cached
   :description "Load every fn/slot/binding entity for layout, served from the per-context graph cache when warm. Context-aware (reads storage from `ctx`)."
   :args {}
   :return-type :_graph-snapshot-shape}

  {:name :_parse-layout-body
   :description "Single library call — parse the Ring body into `{:root-id :expansions}`. Throws JsonParseException / ExceptionInfo / IllegalArgumentException on bad input; the graph's `:try` catches all three."
   :args {:request {:type :ring-request-shape}}
   :return-type :_parse-layout-request-shape}

  {:name :_layout-build-apply
   :description "Single library call — build cytoscape `{:nodes :edges}` from the graph snapshot + parsed request. Throws ExceptionInfo on `:execution-error/not-found`."
   :args {:graph {:type :_graph-snapshot-shape}
          :parsed {:type :_parse-layout-request-shape}}
   :return-type :_layout-elements-shape}

  {:name :_layout-place-apply
   :description "Single library call — grid-place `{:nodes :edges}` into the full layout response."
   :args {:elements {:type :_layout-elements-shape}}
   :return-type :_layout-response-shape}

  ;; =============================================================================
  ;; FN-DEFS: error-shape templates + pass-through guards
  ;; =============================================================================

  {:name :_layout-err-message
   :description "`{:ok false :error <exception.message>}` — the shape `:_layout-build-elements` and `:_parse-layout-request` use to surface ExceptionInfo / IllegalArgumentException messages."
   :parent :zipmap
   :args {:keys [:ok :error]
          :vals [false
                 {:parent :throwable-message
                  :args {:ex {:as :exception}}}]}}

  ;; =============================================================================
  ;; FN-DEFS: :_parse-layout-request — :try with multi-class dispatch
  ;; =============================================================================

  {:name :_parse-layout-err-bad-json
   :description "Static err — JsonParseException leaks `Source: REDACTED` info if we surface .getMessage; replace with a generic message."
   :parent :const
   :return-type :_error-result-shape
   :args {:value {:ok false :error "Request body is not valid JSON"}}}

  {:name :_parse-layout-err-invalid-request
   :description "`{:ok false :error \"Invalid request: <msg>\"}` — IllegalArgumentException (typically from `UUID/fromString`) gets a prefix to disambiguate from server-side errors."
   :parent :zipmap
   :args {:keys [:ok :error]
          :vals [false
                 {:parent :str
                  :args {:parts ["Invalid request: "
                                 {:parent :throwable-message
                                  :args {:ex {:as :exception}}}]}}]}}

  {:name :_parse-layout-err-rethrow
   :description "Fallback — any exception class outside the three expected user-input classes is rethrown so it surfaces as a 500 / proper server error."
   :parent :throw
   :args {:exception {:as :exception}}}

  {:name :_parse-layout-exception-class
   :description "Look up the exception's class-name once so the `:cond` clauses can compare against literal class-name strings."
   :parent :throwable-class-name
   :args {:ex {:as :exception}}}

  {:name :_parse-layout-on-throw
   :description "1-arg handler — dispatch on the caught exception's class name to JsonParseException / ExceptionInfo / IllegalArgumentException err-shapes, else rethrow."
   :parent :cond
   :args {:clauses [{:parent :equal?
                     :args {:a :_parse-layout-exception-class
                            :b {:value "com.fasterxml.jackson.core.JsonParseException"}}}
                    :_parse-layout-err-bad-json
                    {:parent :equal?
                     :args {:a :_parse-layout-exception-class
                            :b {:value "clojure.lang.ExceptionInfo"}}}
                    :_layout-err-message
                    {:parent :equal?
                     :args {:a :_parse-layout-exception-class
                            :b {:value "java.lang.IllegalArgumentException"}}}
                    :_parse-layout-err-invalid-request
                    {:value true}
                    :_parse-layout-err-rethrow]}}

  {:name :_parse-layout-request
   :description "Parse the internal Ring request body into `{:root-id :expansions}` via a graph `:try` wrapping the single library call. On JsonParseException / ExceptionInfo / IllegalArgumentException the on-throw handler returns `{:ok false :error}`; other exceptions propagate."
   :parent :try
   :args {:body :_parse-layout-body
          :on-throw :_parse-layout-on-throw}}

  ;; =============================================================================
  ;; FN-DEFS: :_layout-build-elements — :if pass-through + :try
  ;; =============================================================================

  {:name :_layout-build-try
   :description "Run `:_layout-build-apply` and convert any ExceptionInfo into `:_layout-err-message`. Pure graph `:try`."
   :parent :try
   :args {:body :_layout-build-apply
          :on-throw :_layout-err-message
          :graph {:as :graph}
          :parsed {:as :parsed}}}

  {:name :_layout-build-elements
   :description "Stage A — pass an upstream `{:ok false}` parse result through, otherwise build cytoscape `{:nodes :edges}`."
   :parent :if
   :args {:test :_layout-build-parsed-failed?
          :then {:as :parsed}
          :else :_layout-build-try
          :graph {:as :graph}
          :parsed {:as :parsed}}}

  {:name :_layout-build-parsed-failed?
   :description "True iff `:parsed` is an upstream `{:ok false}` payload."
   :parent :equal?
   :args {:a {:parent :get
              :args {:coll {:as :parsed}
                     :key {:value :ok}
                     :default nil}}
          :b {:value false}}}

  ;; =============================================================================
  ;; FN-DEFS: :_layout-place — :if pass-through
  ;; =============================================================================

  {:name :_layout-place
   :description "Stage B — pass an upstream `{:ok false}` from `:_layout-build-elements` through, otherwise grid-place the elements."
   :parent :if
   :args {:test :_layout-place-failed?
          :then {:as :elements}
          :else :_layout-place-apply
          :elements {:as :elements}}}

  {:name :_layout-place-failed?
   :description "True iff `:elements` is an upstream `{:ok false}` payload."
   :parent :equal?
   :args {:a {:parent :get
              :args {:coll {:as :elements}
                     :key {:value :ok}
                     :default nil}}
          :b {:value false}}}

  ;; =============================================================================
  ;; FN-DEFS: layout pipeline composition
  ;; =============================================================================

  ;; build → place. Free args `graph` + `parsed` propagate up from
  ;; `_layout-build-elements`.
  {:name :_compute-layout
   :description "Run the build → place layout pipeline for one parsed request. Composition of `:_layout-build-elements` → `:_layout-place`. Owns `:graph` as an explicit free pin — value flows down to `:_layout-build-elements :graph` by name match."
   :parent :_layout-place
   :args {:elements :_layout-build-elements
          :graph {:type :jsonb
                  :description "Full entity graph snapshot — typically supplied by `:_load-graph-cached`."}}}

  ;; parse → load → compute. Context-aware: free arg `request`
  ;; propagates up from `_parse-layout-request`.
  {:name :get-layout-data
   :description "Fetch every fn/arg entity from storage, expand the requested subgraph based on the request's `:root-id` + `:expansions` map, run the layout pipeline, and return `{:nodes :edges :grid-pos :validation}`. Composition of `:_parse-layout-request` → `:_load-graph-cached` → `:_compute-layout`."
   :parent :_compute-layout
   :args {:graph :_load-graph-cached
          :parsed :_parse-layout-request}}

  ;; =============================================================================
  ;; FN-DEFS: Layout API handler
  ;; =============================================================================

  ;; Layout handler — fn-graph composition, no factory.
  {:name :_layout-api-handler
   :parent :json-ok-response
   :args {:body :_layout-api-body}}

  {:name :_layout-api-body
   :parent :to-json-string
   :args {:data :get-layout-data}}

  ;; The concrete `/api/graph/layout` route lives in `app.routes`.
  ]}
