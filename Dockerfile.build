# Full build Dockerfile - builds uberjar inside container
# Use: docker build -f Dockerfile.build -t graphden-executor-server .

FROM clojure:temurin-21-tools-deps-jammy@sha256:1265521d4ac4a8bec0223c0224c1987c7028e13d3fe67b0013031523ebc04f3b AS builder

WORKDIR /app

# Copy everything
COPY . .

# Build uberjar
RUN clojure -T:build uber

# Runtime stage
FROM eclipse-temurin:21-jre-jammy@sha256:fa4854e6057665066cb79953616671c20f32b96a85d6dd8b78db0762203924c4

# Pinned curl version — mirrors Dockerfile; see its comment for why.
RUN apt-get update && apt-get install -y --no-install-recommends \
        'curl=7.81.0-*' \
    && rm -rf /var/lib/apt/lists/*

# Mirror Dockerfile's non-root runtime user (trivy AVD-DS-0002) — created
# before the COPY, which sets the owner itself (see Dockerfile: a chown after
# it duplicates the jar layer).
RUN useradd --system --uid 1001 --user-group --shell /sbin/nologin \
        --home-dir /nonexistent graphden \
    && install -d -o graphden -g graphden /app

WORKDIR /app

# Copy uberjar from builder
COPY --from=builder --chown=graphden:graphden /app/target/executor-server.jar /app/executor-server.jar
USER graphden

# Set default port
ENV PORT=8080
ENV DB_POOL_SIZE=10

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Run the application
CMD ["java", \
     "-XX:+UseContainerSupport", \
     "-XX:MaxRAMPercentage=60.0", \
     "-jar", "/app/executor-server.jar"]
