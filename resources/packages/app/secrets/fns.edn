;; HTTP endpoints for the admin-side Secrets CRUD.
;;
;; Each operation has two declarations:
;; - a `:_*-data` base-fn (thin shim calling `graphden.crud.secrets`)
;; - a `*-handler` fn-def that wraps the data fn via `:json-handler`
;;   (200 application/json). Concrete routes live in `app.routes`,
;;   wired with the auth-required middleware.
;;
;; Secret VALUES never appear on these endpoints' responses — only
;; metadata (path, created-at, version, description). The actual
;; secret stays in OpenBao and is only ever read at execution-time
;; by the user-fn-graph through `:vault-get`.


{:namespace "app.secrets"
 :description "Admin-side endpoints for the Secrets-panel CRUD — list / create / rotate / delete. Backed by `graphden.crud.secrets`."
 :fns
 [;; ---------------------------------------------------------------------
  ;; GET /api/secrets — list every secret-shaped fn-def with OpenBao
  ;; metadata (no values). Authentication required.
  ;; ---------------------------------------------------------------------

  {:name :_list-secrets-data
   :description "Returns `{:ok true :secrets [...]}`. Each entry is `{:id :name :path :created-at? :version? :description? :custom-metadata?}`. Values never appear — read at execution-time via :vault-get."
   :args {:request {:type :ring-request-shape}}
   :return-type :jsonb
   :effects #{:db :io}}

  {:name :list-secrets-handler
   :description "Ring handler for GET /api/secrets (auth-required)."
   :parent :json-handler
   :args {:data :_list-secrets-data}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/secrets — create a secret. Body `{:name :path :value
  ;; :namespace-id? :description?}`. Writes to OpenBao first, then
  ;; creates the fn-def + path-binding in graphden. Compensates by
  ;; deleting the OpenBao entry on graphden write failure.
  ;; ---------------------------------------------------------------------

  {:name :_create-secret-data
   :description "POST body parsed JSON; writes OpenBao value + custom-metadata, then graphden fn-row (parent=[:vault-get]) + path-binding. Rolls back on partial failure."
   :args {:request {:type :ring-request-shape}}
   :return-type :jsonb
   :effects #{:db :io}}

  {:name :create-secret-handler
   :description "Ring handler for POST /api/secrets (auth-required)."
   :parent :json-handler
   :args {:data :_create-secret-data}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/secret-bindings — inline `:secret-path` binding (no
  ;; wrapper fn-def). Body `{:fn-id :slot-id :path :value}`. Used by the
  ;; editor's value-form for any slot whose declared type contains
  ;; `:secret` — see `crud.secrets/create-inline-binding`. Sibling to
  ;; /api/secrets/* (not nested) so reitit doesn't clash with
  ;; `/api/secrets/:fn-id`.
  ;; ---------------------------------------------------------------------

  {:name :_create-inline-binding-data
   :description "POST body parsed JSON; vault-write at :path then create a :secret-path-kinded binding on (:fn-id, :slot-id). Rolls back vault on graphden write failure (incl. capability gate)."
   :args {:request {:type :ring-request-shape}}
   :return-type :jsonb
   :effects #{:db :io}}

  {:name :create-inline-binding-handler
   :description "Ring handler for POST /api/secrets/binding (auth-required)."
   :parent :json-handler
   :args {:data :_create-inline-binding-data}}

  ;; ---------------------------------------------------------------------
  ;; PUT /api/secrets/:fn-id/value — rotate value. Body `{:value …}`.
  ;; Path-binding in graphden is unchanged; the new value lands as a
  ;; new KV v2 version in OpenBao.
  ;; ---------------------------------------------------------------------

  {:name :_rotate-secret-data
   :description "Writes a new OpenBao version at the secret's path. graphden state unchanged."
   :args {:request {:type :ring-request-shape}}
   :return-type :jsonb
   :effects #{:db :io}}

  {:name :rotate-secret-handler
   :description "Ring handler for PUT /api/secrets/:fn-id/value (auth-required)."
   :parent :json-handler
   :args {:data :_rotate-secret-data}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/secrets/:fn-id/migrate — convert legacy `:vault-get`
  ;; shape to new `:secret-leaf` shape. Vault contents unchanged.
  ;; ---------------------------------------------------------------------

  {:name :_migrate-secret-data
   :description "Migrate a legacy :vault-get-shaped secret to :secret-leaf shape. Three-step inside the handler: delete legacy binding → flip parent-ids → create new :secret-path-kinded binding. Vault state untouched."
   :args {:request {:type :ring-request-shape}}
   :return-type :jsonb
   :effects #{:db}}

  {:name :migrate-secret-handler
   :description "Ring handler for POST /api/secrets/:fn-id/migrate (auth-required)."
   :parent :json-handler
   :args {:data :_migrate-secret-data}}

  ;; ---------------------------------------------------------------------
  ;; DELETE /api/secrets/:fn-id — hard delete. Rejected with 409 +
  ;; usages list if any fn references the secret.
  ;; ---------------------------------------------------------------------

  {:name :_delete-secret-data
   :description "Rejects with `:reason :secret-in-use` + `:usages` when any fn references the secret. On success deletes every OpenBao version + metadata, then the graphden fn-row and its path-binding."
   :args {:request {:type :ring-request-shape}}
   :return-type :jsonb
   :effects #{:db :io}}

  {:name :delete-secret-handler
   :description "Ring handler for DELETE /api/secrets/:fn-id (auth-required)."
   :parent :json-handler
   :args {:data :_delete-secret-data}}]}
