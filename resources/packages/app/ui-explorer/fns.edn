       {:name :_explorer-attrs-services :parent :_explorer-toggle-attrs :args {:vals ["button" "kind-toggle" "services" :_explorer-pressed-services "Only services (daemons kept running)" false]}}
       {:name :_explorer-button-services :parent :hiccup :args {:tag "button" :attrs :_explorer-attrs-services :children [:_explorer-glyph-services :_explorer-label-services :_explorer-count-node-services]}}
