;; Graph Editor fn-defs
;; CSS / JS loaded via the core :read-resource / :concat-resources
;; chain. No base-fns in this package.


{:namespace "app.editor"
 :description "Graph-editor application — HTML/CSS/JS assembly via fn-defs (no base-fns), plus the routes for editor UI + API endpoints."
 :fns
 [;; =============================================================================
  ;; CSS + JS asset loading (fn-def compositions)
  ;; =============================================================================

  {:name :styles
   :description "Editor stylesheet — read from `packages/app/editor/editor-styles.css`. Served by `:_editor-css-handler` at `/assets/editor.css?v=<hash>` with a 1-year `immutable` `Cache-Control` so the browser fetches the body exactly once per deploy."
   :parent :read-resource
   :return-type :text
   :args {:path "packages/app/editor/editor-styles.css"}}

  ;; Editor JS modules — loaded from resources and concatenated in order.
  ;; Order matters: tooltips/icons/drag must come BEFORE overlays (which
  ;; calls into them); ui/cytoscape come after overlays (they call
  ;; into the overlay management API).
  {:name :_editor-script-paths
   :parent :const
   :args {:value ["packages/app/editor/editor-state.js"
                  "packages/app/editor/editor-popover-base.js"
                  "packages/app/editor/editor-busy.js"
                  "packages/app/editor/editor-prefs.js"
                  "packages/app/editor/editor-auth.js"
                  "packages/app/editor/editor-branches.js"
                  "packages/app/editor/editor-branch-diff.js"
                  "packages/app/editor/editor-create.js"
                  "packages/app/editor/editor-create-type.js"
                  "packages/app/editor/editor-data.js"
                  "packages/app/editor/editor-layout.js"
                  "packages/app/editor/editor-literal-types.js"
                  "packages/app/editor/editor-value-form.js"
                  "packages/app/editor/editor-widget-rating.js"
                  "packages/app/editor/editor-tooltips.js"
                  "packages/app/editor/editor-icons.js"
                  "packages/app/editor/editor-row-actions.js"
                  "packages/app/editor/editor-drag.js"
                  "packages/app/editor/editor-fn-picker.js"
                  "packages/app/editor/editor-namespace-picker.js"
                  "packages/app/editor/editor-edit-validation.js"
                  "packages/app/editor/editor-edit-modes.js"
                  "packages/app/editor/editor-edit-reparent.js"
                  "packages/app/editor/editor-execute-result.js"
                  "packages/app/editor/editor-execute-history.js"
                  "packages/app/editor/editor-execute.js"
                  "packages/app/editor/editor-fn-versions.js"
                  "packages/app/editor/editor-service-popover.js"
                  "packages/app/editor/editor-mismatch-explainer.js"
                  "packages/app/editor/editor-effect-explainer.js"
                  "packages/app/editor/editor-overlay-type-expand.js"
                  "packages/app/editor/editor-provenance-popover.js"
                  "packages/app/editor/editor-overlay-arg.js"
                  "packages/app/editor/editor-overlay-edge-label.js"
                  "packages/app/editor/editor-overlay-fn.js"
                  "packages/app/editor/editor-overlay-strips.js"
                  "packages/app/editor/editor-overlay-manager.js"
                  "packages/app/editor/editor-secrets.js"
                  "packages/app/editor/editor-sidebar.js"
                  "packages/app/editor/editor-expansion.js"
                  "packages/app/editor/editor-ui.js"
                  "packages/app/editor/editor-cytoscape.js"
                  "packages/app/editor/editor-main.js"]}}

  ;; Raw concatenation of every editor module — still contains the
  ;; literal `__BUILD_HASH__` placeholder from `editor-state.js`.
  {:name :_script-raw
   :description "Concatenated editor JS bundle, BEFORE the build-hash substitution."
   :parent :concat-resources
   :return-type :text
   :args {:paths :_editor-script-paths}}

  ;; The placeholder is replaced with the FRONTEND-section build hash
  ;; (see `:build-hash-frontend-short` in core.system). The console
  ;; marker thus reflects exactly which JS/CSS the browser is running
  ;; — and matches the `frontend` key returned by `GET /version`.
  {:name :script
   :description "Bundled editor JS with `__BUILD_HASH__` substituted by `:build-hash-frontend-short`. The in-page console marker mirrors the `frontend` value returned by `GET /version`, so the browser bundle's identity is never out of step with what the server reports. `:str-replace` is nil-flow-through; `:_script-raw` is loaded from a baked-in JAR resource and is never nil, but the declared return follows the parent's union to keep the contract explicit."
   :parent :str-replace
   :return-type :nullable-text
   :args {:string   {:ref :_script-raw                :type :text}
          :match    "__BUILD_HASH__"
          :replacement :build-hash-frontend-short}}

  ;; =============================================================================
  ;; FN-DEFS: Editor UI structure
  ;; =============================================================================

  ;; Editor body — HTML structure as hiccup constant
  {:name :body
   :description "Hiccup constant for the editor's `<body>` content — sidebar (filter input + entity list), graph container, and zoom/home/reset nav controls."
   :parent :const
   :args {:value
          ;; Semantic landmarks \u2014 <aside> for the namespace tree,
          ;; <main> for the graph canvas. axe-core's `region` rule
          ;; requires every page element be inside a landmark; without
          ;; this, screen-readers see flat content with no structure.
          [:div {:id "app"}
           [:div {:id "main-container"}
            ;; Side menu \u2014 semantic <aside> + ARIA label since the
            ;; visible <h2>"Graphden" doubles as the app title rather
            ;; than the sidebar's heading.
            [:aside {:id "side-menu" :aria-label "Function browser"}
             [:div {:class "menu-header"}
              [:h2 "Graphden"]
              ;; Right-side header buttons. `editor-prefs.js` mounts
              ;; theme + collapse buttons here on DOMContentLoaded;
              ;; `editor-auth.js` mounts the lock + popover next to
              ;; them. The "+ New namespace" affordance lives at the
              ;; bottom of `#entity-list`.
              [:div {:class "menu-header-actions"}
               [:div {:id "prefs-mount"}]
               [:div {:id "branch-mount"}]
               [:div {:id "auth-mount"}]]]
             [:div {:id "search-bar" :role "search"}
              [:label {:for "search-input" :class "visually-hidden"} "Filter functions"]
              [:input {:id "search-input" :type "text" :placeholder "Filter..."
                       :aria-label "Filter functions"
                       :oninput "onSearchInput(this.value)"}]
              [:button {:id "search-clear" :onclick "clearSearch()" :aria-label "Clear filter"} "\u00D7"]
              [:label {:id "only-services-label" :class "filter-toggle-label"
                       :title "Hide fns that are not declared as :service rows"}
               [:input {:id "only-services-toggle" :type "checkbox"
                        :onchange "setOnlyServicesFilter(this.checked)"}]
               " Only services"]]
             [:nav {:id "entity-list" :aria-label "Namespace tree"}]]
            ;; Graph container \u2014 <main> landmark
            ;; `#cy` is a `group`, not an `img`: it hosts the cytoscape
            ;; canvas AND the interactive HTML overlays (fn cards, arg
            ;; rows, action buttons). `role="img"` would make a screen
            ;; reader treat it as one atomic graphic and skip every
            ;; overlay control inside (axe `nested-interactive`).
            [:main {:id "graph-container" :aria-label "Function graph"}
             [:div {:id "cy" :role "group" :aria-label "Composition graph"}]
             ;; Navigation controls \u2014 group with role="toolbar" so
             ;; screen readers announce the buttons as a related set.
             [:div {:id "nav-controls" :role "toolbar" :aria-label "Graph navigation"}
              [:div {:class "nav-zoom-col"}
               [:button {:class "nav-btn" :onclick "navZoom(1)"
                         :aria-label "Zoom in" :title "Zoom in"} "+"]
               [:input {:id "zoom-slider" :type "range" :min "10" :max "300" :value "100"
                        :orient "vertical"
                        :aria-label "Zoom level"
                        :oninput "navZoomTo(this.value/100)" :title "Zoom"}]
               [:button {:class "nav-btn" :onclick "navZoom(-1)"
                         :aria-label "Zoom out" :title "Zoom out"} "\u2212"]]
              [:div {:class "nav-bottom-row"}
               [:button {:class "nav-btn" :onclick "navGoToRoot()"
                         :aria-label "Go to root node" :title "Go to root node"} "\u2302"]
               [:button {:class "nav-btn" :onclick "navResetPositions()"
                         :aria-label "Reset node positions" :title "Reset all node positions"} "\u27F2"]
               [:button {:class "nav-btn" :onclick "navResetZoom()"
                         :aria-label "Reset zoom" :title "Reset zoom"} "\u2299"]]]]]]}}

  ;; =============================================================================
  ;; HASH-BUSTED ASSET URLs + LINK/SCRIPT-SRC ELEMENTS
  ;;
  ;; The editor JS/CSS bundles are not inlined into the HTML response —
  ;; they're served at `/assets/editor.{js,css}?v=<hash>` with a 1-year
  ;; `immutable` `Cache-Control`. The query-string hash is the
  ;; FRONTEND build hash (`:build-hash-frontend-short`), so a new
  ;; deploy changes the URL and the browser fetches the new bundle;
  ;; in between deploys the browser serves the bundle from cache
  ;; without even a conditional request.
  ;; =============================================================================

  {:name :_editor-js-url
   :description "`/assets/editor.js?v=<frontend-build-hash>` — `<script src>` URL for the bundled editor JS. Hash busts the cache when the frontend section changes."
   :parent :str-join
   :return-type :text
   :args {:coll ["/assets/editor.js?v=" :build-hash-frontend-short]
          :separator ""}}

  {:name :_editor-css-url
   :description "`/assets/editor.css?v=<frontend-build-hash>` — `<link href>` URL for the bundled editor stylesheet."
   :parent :str-join
   :return-type :text
   :args {:coll ["/assets/editor.css?v=" :build-hash-frontend-short]
          :separator ""}}

  ;; `<script src=…>` element. NOT `:_cdn-script-element` — that template
  ;; type-checks `:url` against the `:url` refinement (`^https?://`),
  ;; which our same-origin `/assets/editor.js?v=…` path doesn't match.
  ;; Build hiccup directly, mirroring the `:_editor-css-link` shape.
  {:name :_editor-script-attrs
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :src}
          :value {:ref :_editor-js-url}}}

  {:name :_editor-script-tag
   :description "`<script src=\"/assets/editor.js?v=…\"></script>` element appended at end of `<body>`. Replaces the previous inline `<script>` so the bundle is cached across page loads."
   :parent :hiccup
   :args {:tag {:value "script"}
          :attrs :_editor-script-attrs
          :children {:value []}}}

  ;; `<link rel="stylesheet" href="…">` attrs map — built via two
  ;; assoc calls because the editor-css URL is a runtime composition
  ;; over `:build-hash-frontend-short` (can't be a literal map).
  {:name :_editor-css-link-attrs-rel
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :rel}
          :value {:value "stylesheet"}}}

  {:name :_editor-css-link-attrs
   :parent :assoc
   :args {:map :_editor-css-link-attrs-rel
          :key {:value :href}
          :value {:ref :_editor-css-url}}}

  {:name :_editor-css-link
   :description "`<link rel=\"stylesheet\" href=\"/assets/editor.css?v=…\">` element in `<head>`. Replaces the previous inline `<style>` so the browser can cache the CSS body across page loads."
   :parent :hiccup
   :args {:tag {:value "link"}
          :attrs :_editor-css-link-attrs
          :children {:value []}}}

  ;; =============================================================================
  ;; PAGE COMPOSITION (fn-defs)
  ;; =============================================================================

  ;; Build head elements list for cytoscape
  {:name :head-elements-0
   :description "Initial head-elements vector — single entry: `:_editor-css-link` (`<link rel=\"stylesheet\">` to the cached `/assets/editor.css` bundle). Subsequent fn-defs append CDN scripts."
   :parent :conj
   :args {:coll [] :item :_editor-css-link}}

  ;; Cytoscape — graph canvas renderer.
  {:name :_head-with-cytoscape
   :parent :with-cdn-script
   :args {:head :head-elements-0
          :url "https://unpkg.com/cytoscape@3.30.4/dist/cytoscape.min.js"}}

  ;; Final editor <head> — stylesheet link + Cytoscape CDN + HTMX CDN.
  ;; HTMX (2.x) lets server-rendered popover fragments declare their
  ;; own interactivity (`hx-get` for row-expand, `hx-on:click` for
  ;; declarative dismissal, etc.) without per-module JS post-swap
  ;; binding code — the graph fragment owns the contract end to end.
  {:name :head
   :description "Final editor `<head>` element vector — `:_editor-css-link` (cached stylesheet) + Cytoscape.js CDN + HTMX 2.x CDN. HTMX is the declarative-interaction layer the `/partials/*` fragments rely on."
   :parent :with-cdn-script
   :args {:head :_head-with-cytoscape
          :url "https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js"}}

  ;; Complete HTML page
  ;; Scripts: single editor JS reference (layout is computed server-side, no dagre needed)
  {:name :_editor-scripts
   :parent :list
   :args {:items [:_editor-script-tag]}}

  {:name :page
   :description "Full editor HTML page — title, head (stylesheet link + CDN scripts), body (sidebar + graph), and an end-of-body `<script src>` pointing at the cached editor JS bundle. Rendered by `:_editor-handler` on `GET /`."
   :parent :html-page
   :args {:title "Graphden - Graph Editor"
          :head :head
          :body :body
          :scripts :_editor-scripts}}

  ;; Handler — :html-ok-response sets status 200 + html content-type;
  ;; :render-hiccup converts the hiccup page to an HTML string. With
  ;; :assoc-fn at the route binding the whole graph is hof-wrap'd into
  ;; a constant Ring callable.
  {:name :_editor-rendered-page
   :parent :render-hiccup
   :return-type :text
   :args {:hiccup :page}}

  {:name :_editor-handler
   :parent :html-ok-response
   :args {:body :_editor-rendered-page}}

  ;; =============================================================================
  ;; ASSET HANDLERS — bundled JS / CSS at /assets/editor.{js,css}
  ;; Each returns the bundle body with a 1-year `immutable`
  ;; `Cache-Control`. Hash-busting lives in the URL query string.
  ;; =============================================================================

  ;; `:script` is declared `:nullable-text` because `:str-replace` is
  ;; nil-flow-through; in practice the placeholder substitution over a
  ;; baked-in resource is never nil. `:assert-some` is the type-system
  ;; bridge — narrows back to `:text` for the strict `:body` slot.
  {:name :_editor-js-body
   :description "`:script` narrowed from `:nullable-text` to `:text` via `:assert-some` — the JS bundle is a baked-in resource that can't be nil at runtime, but `:str-replace`'s nil-flow-through type forces the explicit narrowing."
   :parent :assert-some
   :return-type :text
   :args {:value :script}}

  {:name :_editor-js-handler
   :description "Ring handler for `GET /assets/editor.js` — returns the concatenated editor JS bundle (with `__BUILD_HASH__` substituted) as `application/javascript` with `Cache-Control: public, max-age=31536000, immutable`."
   :parent :immutable-js-ok-response
   :args {:body :_editor-js-body}}

  {:name :_editor-css-handler
   :description "Ring handler for `GET /assets/editor.css` — returns the editor stylesheet as `text/css` with `Cache-Control: public, max-age=31536000, immutable`."
   :parent :immutable-css-ok-response
   :args {:body :styles}}

  ;; =============================================================================
  ;; FAVICON (SVG icon with caching)
  ;; =============================================================================

  {:name :_favicon-svg-body
   :parent :const
   :args {:value "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\"><rect width=\"32\" height=\"32\" fill=\"#fff\" rx=\"4\"/><rect x=\"1\" y=\"1\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\" rx=\"4\"/><rect x=\"3\" y=\"12\" width=\"10\" height=\"8\" rx=\"2\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\"/><rect x=\"19\" y=\"4\" width=\"10\" height=\"8\" rx=\"2\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\"/><rect x=\"19\" y=\"20\" width=\"10\" height=\"8\" rx=\"2\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\"/><line x1=\"13\" y1=\"14\" x2=\"19\" y2=\"8\" stroke=\"#000\" stroke-width=\"1.5\"/><line x1=\"13\" y1=\"18\" x2=\"19\" y2=\"24\" stroke=\"#000\" stroke-width=\"1.5\"/></svg>"}}

  {:name :_favicon-handler
   :parent :cached-svg-ok-response
   :args {:body :_favicon-svg-body}}

  ;; =============================================================================
  ;; HTMX PARTIALS — server-rendered fragments swapped into editor mount-points
  ;;
  ;; First migration: the effect-explainer popover. Previously a JS
  ;; module (`editor-effect-explainer.js`) built the popover DOM from
  ;; a hard-coded `EFFECT_DESCRIPTIONS` lookup table. Now the lookup
  ;; lives in `:_effect-descriptions` below (one fn-def, editable
  ;; through the editor itself), rendered to hiccup, and served at
  ;; `GET /partials/effect?effect=db`. JS keeps only positioning +
  ;; dismissal — the content lives in the graph.
  ;;
  ;; Pattern for future partials: keep the lookup/data as fn-defs,
  ;; the hiccup composition as fn-defs, the handler is a thin
  ;; `:html-ok-response` wrap. The full chain — including which
  ;; effect names are documented — becomes inspectable / branchable
  ;; / type-checked through the same surface as everything else.
  ;; =============================================================================

  {:name :_effect-descriptions
   :description "Lookup table: effect tag (string) → plain-English description shown in the popover. Adding a new tracked effect means adding a row here, no JS edit needed."
   :parent :const
   :args {:value {"db"      "Reads or writes storage (database / persistent state)."
                  "env"     "Reads environment variables."
                  "io"      "Reads or writes files / classpath resources."
                  "network" "Makes outbound HTTP / network calls."
                  "time"    "Uses wall-clock time — call returns a different value over time."
                  "random"  "Generates random or otherwise non-deterministic values."
                  "process" "Spawns supervised background work (thread / loop / listener) that lives past the call and needs explicit stopping. Required for a fn to become a :service."}}}

  {:name :_partial-effect-name
   :description "Read the `effect` query-string parameter from the inbound request. Empty string when absent so downstream lookups fall to the default."
   :parent :query-param
   :args {:request {:as :request}
          :param-name {:value "effect"}}}

  ;; `:_effect-descriptions`'s literal map sticks keyword keys after
  ;; the JSONB round-trip (`{\"db\" ...}` → `{:db ...}`), so the
  ;; query-string lookup-key has to be coerced from string to
  ;; keyword before `:get`.
  {:name :_partial-effect-name-kw
   :parent :str-to-keyword
   :args {:string :_partial-effect-name}}

  {:name :_partial-effect-description
   :description "Plain-English description for the requested effect tag; fallback for tags not in the lookup table."
   :parent :get
   :args {:coll :_effect-descriptions
          :key :_partial-effect-name-kw
          :default {:value "Side effect that the type-checker tracks but doesn't name yet."}}}

  {:name :_partial-effect-structural-text
   :description "`:tag` form of the effect name (e.g. `:db`) — surfaced in the structural row so users can map the popover content back to the chip label."
   :parent :str-join
   :args {:coll [":" :_partial-effect-name]
          :separator ""}}

  ;; Hiccup composition for the popover content. Each tag with a
  ;; computed child (description / structural text) gets its own
  ;; `:hiccup`-based fn-def — `:value`-literal hiccup stores
  ;; keyword fn-refs as literal keywords, so dynamic content can't
  ;; sit inline. Pure-literal sub-trees (header) DO use `:const`
  ;; below where they don't depend on the request.
  {:name :_partial-effect-header
   :description "Popover header — title + close button. Pure literal (no per-request data); rendered as a fixed hiccup constant. The close button carries `data-explainer-close` so the post-swap JS handler binds dismissal without selectors."
   :parent :const
   :args {:value
          [:div {:class "type-explainer-header"}
           [:span {:class "type-explainer-title"} "Effect"]
           [:button {:type "button"
                     :class "type-explainer-close"
                     :data-explainer-close "1"
                     :aria-label "Close effect explainer"} "×"]]}}

  {:name :_partial-effect-description-div
   :description "`<div class=\"type-explainer-human\">{description}</div>` — one-line natural-language description of the effect."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "type-explainer-human"}}
          :children [:_partial-effect-description]}}

  {:name :_partial-effect-structural-div
   :description "`<div class=\"type-explainer-structural\">{:effect-tag}</div>` — canonical effect tag in the structural row."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "type-explainer-structural"}}
          :children [:_partial-effect-structural-text]}}

  {:name :_partial-effect-fragment
   :description "Full hiccup fragment for one effect's popover — header + description + structural row, wrapped in the `.type-explainer-content` container."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "type-explainer-content"}}
          :children [:_partial-effect-header
                     :_partial-effect-description-div
                     :_partial-effect-structural-div]}}

  {:name :_partial-effect-html
   :description "Rendered HTML string for the effect-explainer fragment."
   :parent :render-hiccup
   :args {:hiccup :_partial-effect-fragment}}

  {:name :_partial-effect-handler
   :description "Ring handler for `GET /partials/effect?effect=<tag>` — returns the popover hiccup as `text/html`. JS swaps the response body into the explainer mount-point and handles positioning + dismissal."
   :parent :html-ok-response
   :args {:body :_partial-effect-html}}

  ;; ---------------------------------------------------------------------
  ;; fn-versions popover (second migration). Pulls the existing
  ;; `:list-fn-versions` data chain (in `app.branches`) for one fn-id
  ;; from a query-string param, then maps each enriched version row
  ;; into a hiccup `<div class="fn-versions-row">`. JS keeps only
  ;; the fetch, anchoring, dismissal, AND the per-row switch /
  ;; restore handlers (those rebind after innerHTML swap via the
  ;; existing `data-switch-to-branch` / `data-fn-version-id` markers
  ;; this fragment carries — same shape the legacy JS-built rows
  ;; produced, so the e2e contract is preserved).
  ;; ---------------------------------------------------------------------

  {:name :_partial-fn-versions-fn-id-str
   :description "Raw `fn-id` query-string parameter — string UUID."
   :parent :query-param
   :args {:request {:as :request}
          :param-name {:value "fn-id"}}}

  {:name :_partial-fn-versions-fn-id
   :description "Parsed UUID for `fn-id`; nil when absent or malformed (`:list-fn-versions` returns an empty list on nil)."
   :parent :parse-uuid
   :args {:string :_partial-fn-versions-fn-id-str}}

  {:name :_partial-fn-versions-current-branch
   :description "Currently-selected branch name (from `?current-branch=`), used to highlight the matching row in the timeline. Empty string when absent — no row gets the `-current` class."
   :parent :query-param
   :args {:request {:as :request}
          :param-name {:value "current-branch"}}}

  {:name :_partial-fn-versions-data
   :description "Live versions data for the requested fn — wraps `:list-fn-versions`."
   :parent :list-fn-versions
   :args {:fn-id :_partial-fn-versions-fn-id}}

  {:name :_partial-fn-versions-rows
   :description "The `:versions` list out of `:list-fn-versions`'s envelope — already sorted latest-first, each row enriched with `:branch-name` and `:execution-count`."
   :parent :get
   :args {:coll :_partial-fn-versions-data
          :key {:value :versions}
          :default {:value []}}}

  {:name :_partial-fn-versions-count
   :parent :count
   :args {:coll :_partial-fn-versions-rows}}

  {:name :_partial-fn-versions-empty?
   :parent :empty?
   :args {:coll :_partial-fn-versions-rows}}

  ;; --- Per-row HOF callback. Pure rendering: takes one enriched
  ;; version row (`:item`), returns a hiccup `<div class="fn-versions-row">`
  ;; with the same CSS classes + data-attributes the legacy JS produced
  ;; (post-swap JS binds switch / restore handlers by selector).

  {:name :_partial-fnv-row-branch-name
   :parent :get
   :args {:coll {:as :item} :key {:value :branch-name} :default {:value "(unknown)"}}}

  {:name :_partial-fnv-row-version-id
   :parent :get
   :args {:coll {:as :item} :key {:value :id} :default {:value ""}}}

  {:name :_partial-fnv-row-created-at
   :parent :get
   :args {:coll {:as :item} :key {:value :created-at} :default {:value ""}}}

  ;; Timestamp shown as "YYYY-MM-DD HH:MM" — first 16 chars of either
  ;; "2026-05-24 06:21:21.103" (SQL) or "2026-05-24T06:35Z" (ISO).
  ;; `:subs` errors on shorter strings; coalesce to "" via the default
  ;; above keeps us out of the edge.
  {:name :_partial-fnv-row-ts-short
   :parent :subs
   :args {:string :_partial-fnv-row-created-at
          :start {:value 0}
          :end {:value 16}}}

  {:name :_partial-fnv-row-on-current?
   :parent :equal?
   :args {:a :_partial-fnv-row-branch-name
          :b :_partial-fn-versions-current-branch}}

  {:name :_partial-fnv-row-branch-class
   :description "`fn-versions-branch` plus `fn-versions-branch-current` when the row's branch matches the current-branch query param."
   :parent :if
   :args {:test :_partial-fnv-row-on-current?
          :then {:value "fn-versions-branch fn-versions-branch-current"}
          :else {:value "fn-versions-branch"}}}

