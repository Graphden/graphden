                  :partial-inspector-lint-suppress
                  :partial-inspector-lint-restore
                  :partial-execute-history-ack
                  :partial-inspector-test-run
                  :partial-tests-stream
                  :partial-execute-trace
                  :partial-debug-catch
                  :partial-merge-conflicts
                  :partial-execute-result-effects
                  :partial-mismatch-explainer
                  :partial-provenance
                  :partial-return-type-rule
                  :partial-inspector-detail
                  :partial-inspector-overview
                  :partial-settings-build
                  :partial-settings-access
                  :partial-fn-picker-incompat
