;; Package-registry primitives. The registry stores immutable published
;; bundles in the `:package-version` entity; `:export-namespace` is the
;; bridge that turns a live namespace subtree into a publishable bundle
;; (graphden.packages.export/export-namespace). Publish / list / fetch
;; routes (graph-composed) build on this primitive + the CRUD base-fns.

{:namespace "app.registry"
 :description "Package-registry primitives — export a namespace subtree as a publishable bundle for publish/extract."
 :fns
 [;; The shape `:export-namespace` returns — a fixed-schema artifact, so
  ;; it gets a named record type-row rather than a wide `:jsonb`.
  ;; One entry of `:package-dependencies` — the (name, version) of a package a
  ;; bundle's external fns come from (registry-resolved at publish; drives
  ;; recursive install).
  {:name :package-dependency-shape
   :description "A published package coordinate a bundle depends on: `{:name … :version …}`."
   :type {:name :text
          :version :text}}

  {:name :secret-arg-ref
   :description "One vault-path binding a shared bundle carries WITHOUT its path: which fn's which arg is a secret the installer must define. Emitted by the exporter's strip pass; surfaced at install as :needs-definition."
   :type {:fn :keyword
          :arg :keyword}}

  {:name :package-bundle-shape
   :description "A publishable package bundle: the subtree root, the namespaces it spans, its fn-defs (each a keyword-keyed fn-def map), the external fn-names it depends on, the PACKAGES (name+version) those external fns come from (for recursive install), plus the secret-args manifest (:secrets — vault paths stripped unless :secret-paths-included?)."
   :type {:namespace :text
          :namespaces [:list :text]
          :fns [:list :keyword-map]
          :dependencies [:list :keyword]
          :package-dependencies [:list :package-dependency-shape]
          :secrets [:list :secret-arg-ref]
          :secret-paths-included? :bool}}

  {:name :export-namespace
   :description "Serialise the namespace subtree rooted at `:root` into a publishable bundle by reading the live graph. The core of POST /api/packages/publish and self-hosted extract."
   :args {:root {:type :text :description "Dotted root namespace path, e.g. \"web.components\"."}}
   :return-type :package-bundle-shape
   :effects #{:db}}

  ;; The shape `:export-graph` returns — the whole-graph migration bundle.
  ;; Distinct from `:package-bundle-shape`: no single root, no `:dependencies`
  ;; (nothing is external to the whole graph).
  {:name :full-graph-export-shape
   :description "A whole-graph migration bundle: every named fn-def in the graph (each a keyword-keyed fn-def map), the namespaces they span, and the secret-args manifest (:secrets — vault paths stripped unless :secret-paths-included?)."
   :type {:fns [:list :keyword-map]
          :namespaces [:list :text]
          :secrets [:list :secret-arg-ref]
          :secret-paths-included? :bool}}

  {:name :export-graph
   :description "Serialise the ENTIRE stored graph (the current branch/scope) into a migration bundle by reading the live graph — every named fn-def plus the namespaces they span. Vault paths are STRIPPED unless :include-secret-paths is the string \"true\" (org-internal migration); the :secrets manifest always lists the affected args. The core of GET /api/export/graph (cloud→self-hosted \"download my whole project\")."
   :args {:include-secret-paths {:type :nullable-text :description "Query-param opt-in: the string \"true\" keeps vault paths in the bundle. Anything else (incl. nil) strips them."}}
   :return-type :full-graph-export-shape
   :effects #{:db}}

  ;; The RAW five-table shape a remote / BYO executor bootstraps its in-memory
  ;; storage from — the compiler reads exactly these rows. Distinct from
  ;; `:full-graph-export-shape` (named fn-def maps): this is the storage-level
  ;; rows, not the migration/re-load shape.
  {:name :graph-rows-shape
   :description "The five graph tables as raw rows, org-scoped: `{:fns :slots :fn-slots :bindings :list-items}`, each a list of keyword-keyed row maps."
   :type {:fns [:list :keyword-map]
          :slots [:list :keyword-map]
          :fn-slots [:list :keyword-map]
          :bindings [:list :keyword-map]
          :list-items [:list :keyword-map]}}

  {:name :graph-rows
   :description "Read the five graph tables as RAW rows through the request storage (org-scoped → caller's org + public, the shard a BYO executor serves). Backs GET /api/export/graph-rows — the bootstrap read for a remote / BYO executor's in-memory storage."
   :return-type :graph-rows-shape
   :effects #{:db}}

  {:name :current-org-id
   :description "The org id in scope for this request (the shared public org when unbound — single-tenant). Lets graph compositions (the governance catalog filter) compare rows against the caller's org without an org literal. Pure: a thread-local read, constant within one request."
   :args {}
   :return-type :text}

  {:name :publish-package-apply
   :description "Atomic publish core — reject if `(:pkg-name, :pkg-version)` already exists (immutable registry), else hash + insert. The existence check stays adjacent to the insert to keep the race window minimal until the DB-level UNIQUE(name, version) hardening ships. Returns a tagged `{:ok …}` result."
   :args {:pkg-name {:type :text :description "Package name, e.g. \"web.components\"."}
          :pkg-version {:type :text :description "Semver version string, e.g. \"1.2.0\"."}
          :bundle {:type :package-bundle-shape :description "Bundle from :export-namespace."}
          :pkg-public {:type :nullable-bool :required false :description "Truthy → platform-visible (`:public?` on the row — the explicit publish-publicly opt-in, spec §5). Absent/nil → private to the publisher's org; a platform-tier publish is always public."}}
   :return-type :keyword-map
   :effects #{:db :time}}

  ;; Publish = a graph guard over the atomic core. The empty-bundle
  ;; rejection is a pure input predicate (a typo'd / non-existent
  ;; `:ns-root` exports zero fns and would write a 0-fn garbage row
  ;; into the registry) — no race relevance, so it lives HERE where
  ;; admins can see and extend it; only the race-sensitive existence
  ;; check + insert stay in Clojure (`:publish-package-apply`).
  {:name :_pub-fns
   :parent :get
   :args {:coll {:as :bundle :type :package-bundle-shape}
          :key {:value :fns}
          :default {:value []}}}

  ;; NO `:type` override on the ref — `:_pub-fns`' computed return is
  ;; the narrower [:list :keyword-map] (get-return-rule over the
  ;; record-typed bundle), and an override may only NARROW
  ;; (`:bindings/type-override-widens`).
  {:name :_pub-fns-empty?
   :parent :empty?
   :args {:coll :_pub-fns}}

  {:name :_pub-err-empty
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :reason} {:value :name} {:value :version}]
          :vals [{:value false} {:value "empty-bundle"} {:as :pkg-name} {:as :pkg-version}]}}

  {:name :_pub-apply
   :parent :publish-package-apply
   :args {:pkg-name {:as :pkg-name}
          :pkg-version {:as :pkg-version}
          :bundle {:as :bundle}
          :pkg-public {:as :pkg-public}}}

  {:name :publish-package
   :description "Publish a bundle as an immutable :package-version row. Graph `:if` — rejects an empty bundle up front (`:reason \"empty-bundle\"`), else delegates to the atomic `:publish-package-apply` core (existence check + hash + insert → `:ok` or `:reason \"version-exists\"`)."
   :parent :if
   :args {:test :_pub-fns-empty?
          :then :_pub-err-empty
          :else :_pub-apply}
   :return-type :keyword-map}

  ;; ---------------------------------------------------------------------
  ;; Registry primitives — the base-fn cores the fork / materialize /
  ;; update / pin graph compositions build on.
  ;; ---------------------------------------------------------------------

  {:name :resolve-package-version
   :description "Highest published version of `:pkg-name` satisfying `:spec` (exact / semver constraint / `latest`). nil when nothing matches. Self-contained constraint-resolution algorithm (same carve-out class as `:pick-encoding`) — the guards and envelopes around it are graph."
   :args {:pkg-name {:type :text :description "Package name."}
          :spec {:type :nullable-text :description "Exact version, a semver constraint (`>=1.1`, `~>1.2`), `latest`, or nil (any)."}}
   :return-type :nullable-text
   :effects #{:db}}

  {:name :missing-package-dependencies
   :description "The declared dependency names NOT present as fns in storage — ONE batched IN-query + set diff (the batch shape, no N+1, is why this stays a single storage predicate). Empty vector = all satisfied."
   :args {:dependencies {:type [:list :jsonb] :description "A :package-version row's `:dependencies`."}}
   :return-type [:list :keyword]
   :effects #{:db}}

  {:name :fork-package-fns
   :description "Fork apply-core: sync a bundle's fns into the graph AT THEIR ORIGINAL namespace (copy-on-write) + delta-invalidate — a coupled write+invalidation pair. Returns the forked fn count."
   :args {:fns {:type [:list :jsonb] :description "The bundle's fn-defs."}}
   :return-type :int
   :effects #{:db}}

  {:name :materialize-package-fns
   :description "Materialize apply-core: sync a bundle's fns ONCE under `<ns-root>@<version>` (idempotent) + delta-invalidate — a coupled write+invalidation pair. Returns the materialized fn count."
   :args {:ns-root {:type :text :description "Package ns-root."}
          :version {:type :text :description "Concrete version."}
          :fns {:type [:list :jsonb] :description "The bundle's fn-defs."}}
   :return-type :int
   :effects #{:db}}

  {:name :update-package-apply
   :description "Update/rollback apply-core: materialize the target (if needed) → rewrite the project's own refs old→new (shared-remap invariant) → repoint the pin → delta-invalidate — one coupled unit. Returns the rewritten-ref count."
   :args {:pkg-name {:type :text :description "Package name."}
          :old-version {:type :text :description "Currently pinned version."}
          :new-version {:type :text :description "Target version (already resolved)."}
          :ns-root {:type :text :description "Package ns-root."}
          :fns {:type [:list :jsonb] :description "The TARGET version's fn-defs."}}
   :return-type :int
   :effects #{:db :time}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/packages/publish — graph-composed handler.
  ;; Body `{:name :version :ns-root}` → export subtree → publish row.
  ;; ---------------------------------------------------------------------

  {:name :_publish-body
   :description "Parsed JSON body of POST /api/packages/publish — `{:name :version :ns-root}`."
   :parent :parse-json-body}

  {:name :_publish-name-raw
   :parent :get :args {:coll :_publish-body :key {:value :name} :default nil}}
  {:name :_publish-name
   :description "Nil-safe `(str (:name body))`."
   :parent :to-str :args {:value :_publish-name-raw}}

  {:name :_publish-version-raw
   :parent :get :args {:coll :_publish-body :key {:value :version} :default nil}}
  {:name :_publish-version
   :description "Nil-safe `(str (:version body))`."
   :parent :to-str :args {:value :_publish-version-raw}}

  {:name :_publish-ns-root-raw
   :parent :get :args {:coll :_publish-body :key {:value :ns-root} :default nil}}
  {:name :_publish-ns-root
   :description "Nil-safe `(str (:ns-root body))` — the subtree to export."
   :parent :to-str :args {:value :_publish-ns-root-raw}}

  {:name :_publish-public-raw
   :description "`:public` from the body — the explicit publish-publicly opt-in (spec §5); absent → private to the publisher's org."
   :parent :get :args {:coll :_publish-body :key {:value :public} :default nil}}

  {:name :_publish-bundle
   :description "Exported bundle for the requested root namespace."
   :parent :export-namespace :args {:root :_publish-ns-root}}

  {:name :_publish-result
   :description "Publish the exported bundle under the requested name + version."
   :parent :publish-package
   :args {:pkg-name :_publish-name
          :pkg-version :_publish-version
          :bundle :_publish-bundle
          :pkg-public :_publish-public-raw}}

  {:name :publish-package-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/packages/publish (auth-required) — JSON `{ok, …}`."
   :parent :json-handler
   :args {:data :_publish-result}}

  {:name :api-packages-publish
   :description "POST /api/packages/publish — publish a namespace subtree as an immutable package version. Auth-required."
   :parent :post
   :args {:path "/packages/publish" :handler :publish-package-handler}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/packages — registry index (metadata only).
  ;; ---------------------------------------------------------------------

  ;; Registry index — pure graph composition: query every
  ;; :package-version row, reshape per-row via a HOF :map (stringified
  ;; id / published-at, :fn-count instead of the heavy :fns bundle).
  {:name :_pkg-index-rows
   :parent :query-entities
   :args {:entity-type {:value "package-version"} :where {:value {}}}}

  {:name :_pie-id
   :parent :to-str
   :args {:value {:parent :get :args {:coll {:as :item} :key {:value :id} :default nil}}}}

  {:name :_pie-name
   :parent :get :args {:coll {:as :item} :key {:value :name} :default nil}}

  {:name :_pie-version
   :parent :get :args {:coll {:as :item} :key {:value :version} :default nil}}

  {:name :_pie-ns-root
   :parent :get :args {:coll {:as :item} :key {:value :ns-root} :default nil}}

  {:name :_pie-content-hash
   :parent :get :args {:coll {:as :item} :key {:value :content-hash} :default nil}}

  {:name :_pie-published-at
   :parent :to-str
   :args {:value {:parent :get :args {:coll {:as :item} :key {:value :published-at} :default nil}}}}

  {:name :_pie-fn-count
   :parent :count
   :args {:coll {:parent :get :args {:coll {:as :item} :key {:value :fns} :default nil}}}}

  {:name :_pie-dependencies
   :parent :get :args {:coll {:as :item} :key {:value :dependencies} :default nil}}

  {:name :_pie-org-id
   :parent :get :args {:coll {:as :item} :key {:value :org-id} :default nil}}

  ;; Emitted as plain `:public` (not the row's `:public?`) for a clean JSON
  ;; key. `false` = a private (org-scoped) row; `true` = platform-visible;
  ;; null = a legacy pre-scoping row (shared).
  {:name :_pie-public
   :parent :get :args {:coll {:as :item} :key {:value :public?} :default nil}}

  {:name :_pkg-index-entry
   :description "One registry-index entry — the JSON reshape of a :package-version row."
   :parent :zipmap
   :args {:keys [{:value :id} {:value :name} {:value :version} {:value :ns-root}
                 {:value :content-hash} {:value :published-at} {:value :fn-count}
                 {:value :dependencies} {:value :org-id} {:value :public}]
          :vals [:_pie-id :_pie-name :_pie-version :_pie-ns-root
                 :_pie-content-hash :_pie-published-at :_pie-fn-count
                 :_pie-dependencies :_pie-org-id :_pie-public]}}

  {:name :list-package-versions
   :description "All published package versions as a registry index — metadata only (name, version, ns-root, content-hash, published-at, fn-count, dependencies); omits the heavy :fns bundle. Pure graph composition over `:query-entities` + a HOF reshape."
   :parent :map
   :args {:func :_pkg-index-entry :coll :_pkg-index-rows}
   :return-type [:list :keyword-map]}

  {:name :_list-packages-result
   :parent :list-package-versions}

  {:name :list-packages-handler
   :description "Ring handler for GET /api/packages (auth-required) — JSON array of the registry index."
   :parent :json-handler
   :args {:data :_list-packages-result}}

  {:name :api-packages-list
   :description "GET /api/packages — list every published package version (index). Auth-required."
   :parent :get-auth-required
   :args {:path "/packages" :handler :list-packages-handler}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/packages/:name/:version — full published bundle.
  ;; ---------------------------------------------------------------------

  ;; Full bundle fetch — pure graph composition: exact (name, version)
  ;; query + id / published-at stringified for clean JSON.
  {:name :_fpv-where-name
   :parent :assoc-empty
   :args {:key {:value :name} :value {:as :pkg-name :type :text}}}

  {:name :_fpv-where
   :parent :assoc
   :args {:map :_fpv-where-name :key {:value :version} :value {:as :pkg-version :type :text}}}

  {:name :_fpv-rows
   :parent :query-entities
   :args {:entity-type {:value "package-version"} :where :_fpv-where}}

  {:name :_fpv-row
   :parent :first
   :args {:coll :_fpv-rows}}

  {:name :_fpv-row-nil?
   :parent :nil?
   :args {:value :_fpv-row}}

  {:name :_fpv-id-str
   :parent :to-str
   :args {:value {:parent :get :args {:coll :_fpv-row :key {:value :id} :default nil}}}}

  {:name :_fpv-at-str
   :parent :to-str
   :args {:value {:parent :get :args {:coll :_fpv-row :key {:value :published-at} :default nil}}}}

  {:name :_fpv-w-id
   :parent :assoc
   :args {:map :_fpv-row :key {:value :id} :value :_fpv-id-str}}

  {:name :_fpv-decorated
   :parent :assoc
   :args {:map :_fpv-w-id :key {:value :published-at} :value :_fpv-at-str}}

  {:name :fetch-package-version
   :description "The full published bundle for `(:pkg-name, :pkg-version)`, or nil if not found. Pure graph composition; id / published-at stringified."
   :parent :if
   :args {:test :_fpv-row-nil?
          :then {:value nil}
          :else :_fpv-decorated}
   ;; DELIBERATELY wide (type-drift warns): the computed narrow form
   ;; ([:union :null {:id :text :published-at :text}]) is checker
   ;; imprecision — the :assoc chain loses the base row's bundle fields
   ;; (:name :version :fns …), which consumers genuinely read. Declaring
   ;; the computed shape would misdescribe the value.
   :return-type :nullable-keyword-map}

  {:name :_fetch-pkg-name
   :description "`:name` path-param from /api/packages/:name/:version (reitit-enriched)."
   :parent :get-in
   :args {:map {:as :request} :path [{:value :path-params} {:value :name}] :default nil}}

  {:name :_fetch-pkg-version
   :description "`:version` path-param from /api/packages/:name/:version."
   :parent :get-in
   :args {:map {:as :request} :path [{:value :path-params} {:value :version}] :default nil}}

  {:name :_fetch-pkg-result
   :parent :fetch-package-version
   :args {:pkg-name :_fetch-pkg-name :pkg-version :_fetch-pkg-version}}

  {:name :fetch-package-handler
   :lambda-params [:request]
   :description "Ring handler for GET /api/packages/:name/:version (auth-required) — JSON bundle, or null when absent."
   :parent :json-handler
   :args {:data :_fetch-pkg-result}}

  {:name :api-packages-fetch
   :description "GET /api/packages/:name/:version — the full published bundle. Auth-required."
   :parent :get-auth-required
   :args {:path "/packages/:name/:version" :handler :fetch-package-handler}}

  ;; ---------------------------------------------------------------------
  ;; GET /api/export/graph — whole-graph export as an EDN bundle: the
  ;; cloud→self-hosted "download my whole project" migration artifact. EDN
  ;; (not JSON) so fn-def keywords round-trip faithfully; read straight from
  ;; the handler ctx (like the JSON publish handler), so the full-graph read
  ;; is NOT forced lazily inside a render. Auth-required (whole project).
  ;; ---------------------------------------------------------------------
  {:name :_export-include-secrets
   :description "The `include-secret-paths` query param of GET /api/export/graph — \"true\" keeps vault paths (org-internal migration); default strips them."
   :parent :query-param
   :args {:request {:as :request} :param-name {:value "include-secret-paths"}}}
  {:name :_export-graph-result
   :parent :export-graph
   :args {:include-secret-paths :_export-include-secrets}}
  {:name :_export-graph-edn
   :description "The whole-graph bundle as an EDN string (`:pr-str`) — keywords preserved for faithful re-load."
   :parent :pr-str :args {:value :_export-graph-result}}
  {:name :_export-graph-handler
   :lambda-params [:request]
   :description "Ring handler for GET /api/export/graph (auth-required) — `application/edn` bundle."
   :parent :edn-ok-response :args {:body :_export-graph-edn}}
  {:name :api-export-graph
   :description "GET /api/export/graph — export the entire graph as an EDN migration bundle. Auth-required."
   :parent :get-auth-required
   :args {:path "/export/graph" :handler :_export-graph-handler}}

  {:name :_graph-rows-result
   :parent :graph-rows}
  {:name :_graph-rows-edn
   :description "The raw five-table rows as an EDN string (`:pr-str`) — keywords preserved for a faithful in-memory re-load on the remote executor."
   :parent :pr-str :args {:value :_graph-rows-result}}
  {:name :_graph-rows-handler
   :description "Ring handler for GET /api/export/graph-rows (auth-required) — `application/edn` raw-rows bundle."
   :parent :edn-ok-response :args {:body :_graph-rows-edn}}
  {:name :api-export-graph-rows
   :description "GET /api/export/graph-rows — the raw five-table rows a remote / BYO executor bootstraps its in-memory storage from. Org-scoped (caller's org + public). Auth-required."
   :parent :get-auth-required
   :args {:path "/export/graph-rows" :handler :_graph-rows-handler}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/packages/install — install a published version into the
  ;; (branch-scoped) target graph. Body `{:name :version}`.
  ;; ---------------------------------------------------------------------

  {:name :package-version-materialized?
   :description "True iff the version is already visible under its version-qualified namespace — the reference-install idempotency guard (a platform-materialized version seen through an OrgScoped read counts, so a tenant never re-materializes it). One storage read probing the first fn's deterministic id."
   :args {:ns-root {:type :text :description "Package ns-root."}
          :version {:type :text :description "Concrete version."}
          :fns {:type [:list :jsonb] :description "The bundle's fn-defs (the first one is probed)."}}
   :return-type :bool
   :effects #{:db}}

  ;; ---------------------------------------------------------------------
  ;; :install-package — reference-install as GRAPH recursion.
  ;;
  ;; The former Clojure `install-recursive!` walked the dependency tree
  ;; call-recursively (depth-first post-order, `visited` cycle guard,
  ;; short-circuit on the first failing dep) — the whole orchestration
  ;; was invisible in the graph. It now expresses as ONE `:fix` loop
  ;; over an explicit WORKLIST, because the graph's HOF slots (`:map` /
  ;; `:some` / `:reduce`) are pure-by-contract and cannot run effectful
  ;; per-dep installs: the RECURSION carries the effects, pure HOFs only
  ;; build data.
  ;;
  ;; State: `{:pending [op …] :visited {…}}`.
  ;;   op       — `{:op :resolve :name N :spec S :parents [ancestors]}`
  ;;              or `{:op :install :name N :resolved V :parents […]}`.
  ;;   :pending — depth-first post-order: expanding a package pushes its
  ;;              dep `:resolve` ops FIRST, then its own `:install` op,
  ;;              so every dep installs before its dependent and the
  ;;              ROOT's `:install` op is always last (its success
  ;;              envelope is the loop's return value).
  ;;   :visited — `{[name resolved] true}`, marks EXPANDED packages: a
  ;;              repeat (diamond dep or cycle) is skipped instead of
  ;;              re-expanded. (The Clojure version kept only the call-
  ;;              stack path, so a diamond dep re-installed idempotently;
  ;;              skipping reaches the same end state with fewer writes.)
  ;;
  ;; Short-circuit: a failing guard RETURNS its envelope instead of
  ;; recursing — later pending ops never run, matching the Clojure
  ;; `reduced` short-circuit. Failure attribution rebuilds the nested
  ;; `{:reason "dependency-install-failed" :name <ancestor> :dependency …}`
  ;; chain via a pure `:reduce` over the op's ancestor path
  ;; (`:_inst-wrap-failure`).
  ;;
  ;; `:resolved` rides in the `:install` op so the version picked at
  ;; resolve time is pinned (no re-resolution TOCTOU if someone publishes
  ;; a newer match mid-install); the row itself is re-read by exact
  ;; (name, resolved) — package-version rows are immutable, so the repeat
  ;; SELECT is safe (and cheap). Depth bound: `*max-recursion-depth*`
  ;; (1000) ≈ 500 packages per install — far above any real closure.
  ;; ---------------------------------------------------------------------

  ;; Type-row exposing the input slots at a stable owner (same idiom as
  ;; `:BranchChainInput` — NOT propagated frees through the `:fix` step).
  {:name :InstallPackageInput
   :description "Type-row exposing the `:pkg-name` / `:pkg-version` input slots of `:install-package`."
   :type {:pkg-name :text
          :pkg-version :text}}

  {:name :install-package
   :description "Install published `(:pkg-name, :pkg-version)` by REFERENCE: depth-first install its `:package-dependencies`, then ensure it is materialized under `<ns-root>@<version>` (idempotent, skipped when already visible) and pin (current-branch, package) → version. Does NOT copy rows into the caller's project. Rejects on not-found / missing-dependencies / a failing dependency. Writes to the request's branch (staging). Pure graph recursion — a `:fix` worklist loop over `:resolve` / `:install` ops."
   :parents [:fix :InstallPackageInput]
   :args {:step :_inst-step
          :input :_inst-initial-state}
   :return-type :keyword-map}

  ;; --- initial state: resolve the root package; nothing visited yet ---
  {:name :_inst-root-op
   :parent :zipmap
   :args {:keys [{:value :op} {:value :name} {:value :spec} {:value :parents}]
          :vals [{:value :resolve} {:as :pkg-name} {:as :pkg-version} {:value []}]}}

  {:name :_inst-initial-pending
   :parent :list
   :args {:items [:_inst-root-op]}}

  {:name :_inst-initial-state
   :parent :zipmap
   :args {:keys [{:value :pending} {:value :visited}]
          :vals [:_inst-initial-pending {:value {}}]}}

  ;; --- state / op accessors (pure) ---
  {:name :_inst-pending
   :parent :get :args {:coll {:as :input} :key {:value :pending}}}
  {:name :_inst-visited
   :parent :get :args {:coll {:as :input} :key {:value :visited}}}
  {:name :_inst-op
   :parent :first :args {:coll {:ref :_inst-pending :type [:list :any]}}}
  {:name :_inst-rest
   :parent :rest :args {:coll {:ref :_inst-pending :type [:list :any]}}}
  {:name :_inst-op-kind
   :parent :get :args {:coll :_inst-op :key {:value :op}}}
  {:name :_inst-op-name
   :parent :get :args {:coll :_inst-op :key {:value :name}}}
  {:name :_inst-op-spec
   :parent :get :args {:coll :_inst-op :key {:value :spec} :default nil}}
  {:name :_inst-op-parents
   :parent :get :args {:coll :_inst-op :key {:value :parents} :default {:value []}}}
  {:name :_inst-resolve-op?
   :parent :equal?
   :args {:a :_inst-op-kind :b {:value :resolve}}}

  ;; --- one worklist iteration: dispatch on the head op's kind ---
  {:name :_inst-step
   :parent :if
   :args {:test :_inst-resolve-op?
          :then :_inst-do-resolve
          :else :_inst-do-install}}

  ;; --- failure attribution: fold the ancestor path (nearest first)
  ;;     around the base envelope — one `dependency-install-failed`
  ;;     layer per ancestor, exactly the nesting the call-recursive
  ;;     Clojure version produced frame by frame. Root failures have
  ;;     an empty path and come back unwrapped. ---
  {:name :_inst-wrap-acc
   :parent :get :args {:coll {:as :pair} :key {:value 0}}}
  {:name :_inst-wrap-ancestor
   :parent :get :args {:coll {:as :pair} :key {:value 1}}}
  ;; Declared :keyword-map (not the computed literal record): `:reduce`'s
  ;; type-var `a` pins init = func-return = fold-return to ONE type, and
  ;; The ACC input alternates between the base envelope and the wrapped
  ;; shape (hence its :any), but THIS fn's own output is always exactly
  ;; the four zipmapped keys — declare that.
  {:name :_inst-wrapped-one
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :reason} {:value :name} {:value :dependency}]
          :vals [{:value false} {:value "dependency-install-failed"}
                 :_inst-wrap-ancestor :_inst-wrap-acc]}
   :return-type {:ok :bool :reason :text :name :any :dependency :any}}
  {:name :_inst-parents-rev
   :parent :reverse
   :args {:coll {:ref :_inst-op-parents :type [:list :any]}}}
  {:name :_inst-wrap-failure
   :parent :reduce
   :args {:func :_inst-wrapped-one
          :init {:as :base-env}
          :coll {:ref :_inst-parents-rev :type [:list :any]}}
   :return-type :keyword-map}

  ;; --- :resolve op: reject unknown, skip already-expanded, else mark
  ;;     visited and push dep resolves + own install (post-order) ---
  {:name :_inst-resolved
   :parent :resolve-package-version
   :args {:pkg-name {:ref :_inst-op-name :type :text}
          :spec {:ref :_inst-op-spec :type :nullable-text}}}
  {:name :_inst-row
   :parent :package-version-row
   :args {:pkg-name {:ref :_inst-op-name :type :text}
          :resolved :_inst-resolved}}
  {:name :_inst-row-nil?
   :parent :nil? :args {:value :_inst-row}}

  {:name :_inst-err-not-found
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :reason} {:value :name} {:value :requested}]
          :vals [{:value false} {:value "not-found"} :_inst-op-name :_inst-op-spec]}}
  {:name :_inst-fail-not-found
   :parent :_inst-wrap-failure
   :args {:base-env :_inst-err-not-found}}

  {:name :_inst-visit-key
   :parent :list
   :args {:items [:_inst-op-name :_inst-resolved]}}
  {:name :_inst-visiting?
   :parent :contains?
   :args {:coll {:ref :_inst-visited :type [:map :any :any]}
          :key :_inst-visit-key}}
  ;; `{:pending rest :visited unchanged}` — the "advance past the head
  ;; op" state, shared by the already-visited skip AND the post-install
  ;; continue (both drop the head and keep walking).
  {:name :_inst-rest-state
   :parent :zipmap
   :args {:keys [{:value :pending} {:value :visited}]
          :vals [:_inst-rest :_inst-visited]}}
  ;; `(self rest-state)` — the single "advance" re-entry, used by both
  ;; the already-visited skip and the post-install continue.
  {:name :_inst-advance
   :parent :invoke
   :args {:func {:as :self} :arg :_inst-rest-state}}

  {:name :_inst-visited-marked
   :parent :assoc
   :args {:map {:ref :_inst-visited :type [:map :any :any]}
          :key :_inst-visit-key
          :value {:value true}}}
  {:name :_inst-child-parents
   :parent :conj
   :args {:coll {:ref :_inst-op-parents :type [:list :any]}
          :item :_inst-op-name}}
  ;; one dep `{:name N :version V}` → its `:resolve` op (pure — `:map`able)
  {:name :_inst-dep-op
   :parent :zipmap
   :args {:keys [{:value :op} {:value :name} {:value :spec} {:value :parents}]
          :vals [{:value :resolve}
                 {:parent :get :args {:coll {:as :item} :key {:value :name}}}
                 {:parent :get :args {:coll {:as :item} :key {:value :version}}}
                 :_inst-child-parents]}}
  {:name :_inst-deps
   :parent :get
   :args {:coll :_inst-row :key {:value :package-dependencies} :default {:value []}}}
  {:name :_inst-dep-ops
   :parent :map
   :args {:func :_inst-dep-op
          :coll {:ref :_inst-deps :type [:list :any]}}}
  {:name :_inst-install-op
   :parent :zipmap
   :args {:keys [{:value :op} {:value :name} {:value :resolved} {:value :parents}]
          :vals [{:value :install} :_inst-op-name :_inst-resolved :_inst-op-parents]}}
  {:name :_inst-install-op-list
   :parent :list
   :args {:items [:_inst-install-op]}}
  {:name :_inst-pending-expanded
   :parent :concat
   :args {:colls [:_inst-dep-ops :_inst-install-op-list :_inst-rest]}}
  {:name :_inst-expand-state
   :parent :zipmap
   :args {:keys [{:value :pending} {:value :visited}]
          :vals [:_inst-pending-expanded :_inst-visited-marked]}}
  {:name :_inst-expand-recurse
   :parent :invoke
   :args {:func {:as :self} :arg :_inst-expand-state}}

  {:name :_inst-do-resolve
   :parent :cond
   :args {:clauses [:_inst-row-nil?  :_inst-fail-not-found
                    :_inst-visiting? :_inst-advance
                    {:value true}    :_inst-expand-recurse]}}

  ;; --- :install op: guard fn-level deps, materialize (unless already
  ;;     visible), pin, then continue — or return the root envelope ---
  {:name :_inst-i-resolved
   :parent :get :args {:coll :_inst-op :key {:value :resolved}}}
  {:name :_inst-i-row
   :parent :package-version-row
   :args {:pkg-name {:ref :_inst-op-name :type :text}
          :resolved {:ref :_inst-i-resolved :type :nullable-text}}}
  {:name :_inst-i-fn-deps
   :parent :get
   :args {:coll :_inst-i-row :key {:value :dependencies} :default {:value []}}}
  {:name :_inst-i-missing
   :parent :missing-package-dependencies
   :args {:dependencies {:ref :_inst-i-fn-deps :type [:list :jsonb]}}}
  {:name :_inst-i-missing-empty?
   :parent :empty?
   :args {:coll {:ref :_inst-i-missing :type [:list :keyword]}}}
  {:name :_inst-i-missing-any?
   :parent :not :args {:value :_inst-i-missing-empty?}}
  {:name :_inst-err-missing
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :reason} {:value :name} {:value :missing}]
          :vals [{:value false} {:value "missing-dependencies"}
                 :_inst-op-name :_inst-i-missing]}}
  {:name :_inst-fail-missing
   :parent :_inst-wrap-failure
   :args {:base-env :_inst-err-missing}}

  {:name :_inst-i-ns-root
   :parent :get :args {:coll :_inst-i-row :key {:value :ns-root} :default nil}}
  {:name :_inst-i-fns
   :parent :get :args {:coll :_inst-i-row :key {:value :fns} :default {:value []}}}
  {:name :_inst-i-materialized?
   :parent :package-version-materialized?
   :args {:ns-root {:ref :_inst-i-ns-root :type :text}
          :version {:ref :_inst-i-resolved :type :text}
          :fns {:ref :_inst-i-fns :type [:list :jsonb]}}}
  {:name :_inst-i-mat-count
   :parent :materialize-package-fns
   :args {:ns-root {:ref :_inst-i-ns-root :type :text}
          :version {:ref :_inst-i-resolved :type :text}
          :fns {:ref :_inst-i-fns :type [:list :jsonb]}}}
  ;; idempotency: a version already visible (incl. platform-materialized
  ;; under an OrgScoped read) is NOT re-synced and nothing is invalidated
  ;; — same skip the Clojure core performed.
  {:name :_inst-i-mat-maybe
   :parent :if
   :args {:test :_inst-i-materialized?
          :then {:value nil}
          :else :_inst-i-mat-count}}
  {:name :_inst-i-pin
   :parent :package-upsert-pin
   :args {:pkg-name {:ref :_inst-op-name :type :text}
          :pkg-version {:ref :_inst-i-resolved :type :text}}}
  {:name :_inst-i-vq-ns
   :parent :version-qualified-ns
   :args {:ns-root {:ref :_inst-i-ns-root :type :text}
          :version {:ref :_inst-i-resolved :type :text}
          :fn-ns {:ref :_inst-i-ns-root :type :text}}}
  ;; The version row's stripped-secrets manifest (written at publish) —
  ;; what the INSTALLER must define before the installed fns can run.
  ;; `:default []` covers pre-manifest rows (NULL column).
  {:name :_inst-i-secrets
   :parent :get
   :args {:coll :_inst-i-row :key {:value :secrets} :default {:value []}}}
  {:name :_inst-ok
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :name} {:value :version} {:value :namespace}
                 {:value :needs-definition}]
          :vals [{:value true} :_inst-op-name :_inst-i-resolved :_inst-i-vq-ns
                 :_inst-i-secrets]}}
  {:name :_inst-rest-empty?
   :parent :empty?
   :args {:coll {:ref :_inst-rest :type [:list :any]}}}
  ;; post-order guarantees the LAST op is the root's install — its
  ;; success envelope is the loop's return value.
  {:name :_inst-after-write
   :parent :if
   :args {:test :_inst-rest-empty?
          :then :_inst-ok
          :else :_inst-advance}}
  {:name :_inst-write-then-continue
   :parent :do
   :args {:steps [:_inst-i-mat-maybe :_inst-i-pin :_inst-after-write]}}
  {:name :_inst-do-install
   :parent :if
   :args {:test :_inst-i-missing-any?
          :then :_inst-fail-missing
          :else :_inst-write-then-continue}}

  {:name :_install-body
   :description "Parsed JSON body of POST /api/packages/install — `{:name :version}`."
   :parent :parse-json-body}

  {:name :_install-name-raw
   :parent :get :args {:coll :_install-body :key {:value :name} :default nil}}
  {:name :_install-name
   :parent :to-str :args {:value :_install-name-raw}}

  {:name :_install-version-raw
   :parent :get :args {:coll :_install-body :key {:value :version} :default nil}}
  {:name :_install-version
   :parent :to-str :args {:value :_install-version-raw}}

  {:name :_install-result
   :parent :install-package
   :args {:pkg-name :_install-name :pkg-version :_install-version}}

  {:name :install-package-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/packages/install (auth-required) — JSON `{ok, …}`."
   :parent :json-handler
   :args {:data :_install-result}}

  {:name :api-packages-install
   :description "POST /api/packages/install — install a published version into the (branch-scoped) graph. Auth-required."
   :parent :post
   :args {:path "/packages/install" :handler :install-package-handler}}

  ;; --- shared: published version row by (name, resolved-version). ---
  {:name :_pvr-where-name
   :parent :assoc-empty
   :args {:key {:value :name} :value {:as :pkg-name :type :text}}}

  {:name :_pvr-where
   :parent :assoc
   :args {:map :_pvr-where-name :key {:value :version} :value {:as :resolved :type :nullable-text}}}

  {:name :_pvr-rows
   :parent :query-entities
   :args {:entity-type {:value "package-version"} :where :_pvr-where}}

  {:name :_pvr-first
   :parent :first
   :args {:coll :_pvr-rows}}

  {:name :_pvr-resolved-nil?
   :parent :nil?
   :args {:value {:as :resolved}}}

  {:name :package-version-row
   :description "Published :package-version row for (`:pkg-name`, `:resolved`) — nil when `:resolved` is nil (no version matched the constraint) or no such row exists. Shared by the fork / materialize / update guard chains."
   :parent :if
   :args {:test :_pvr-resolved-nil?
          :then {:value nil}
          :else :_pvr-first}
   :return-type :nullable-keyword-map}

  ;; --- shared guard prefix over (:pkg-name, :pkg-version) ----------------
  ;; ONE copy of the chain every registry flow starts with — resolve the
  ;; constraint → fetch the row → nil-guard → declared fn-deps → missing →
  ;; empty?/any? (+ the row's ns-root / fns accessors). The update / fork /
  ;; materialize `:cond`s each kept a per-flow copy of these nine nodes;
  ;; the frees (:pkg-name + :pkg-version) unify at each flow's public
  ;; fn-def, so one definition serves all three.
  {:name :_pkgv-resolved
   :parent :resolve-package-version
   :args {:pkg-name {:as :pkg-name} :spec {:as :pkg-version}}}

  {:name :_pkgv-row
   :parent :package-version-row
   :args {:resolved :_pkgv-resolved}}

  {:name :_pkgv-row-nil?
   :parent :nil?
   :args {:value :_pkgv-row}}

  {:name :_pkgv-deps
   :parent :get
   :args {:coll :_pkgv-row :key {:value :dependencies} :default {:value []}}}

  {:name :_pkgv-missing
   :parent :missing-package-dependencies
   :args {:dependencies {:ref :_pkgv-deps :type [:list :jsonb]}}}

  {:name :_pkgv-missing-empty?
   :parent :empty?
   :args {:coll :_pkgv-missing}}

  {:name :_pkgv-missing-any?
   :parent :not
   :args {:value :_pkgv-missing-empty?}}

  {:name :_pkgv-ns-root
   :parent :get
   :args {:coll :_pkgv-row :key {:value :ns-root} :default nil}}

  {:name :_pkgv-fns
   :parent :get
   :args {:coll :_pkgv-row :key {:value :fns} :default {:value []}}}

  ;; Shared failure envelopes over the guard prefix — one per rejection
  ;; kind, not one per flow (they were byte-identical in all three).
  {:name :_pkgv-err-not-found
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :reason} {:value :name} {:value :requested}]
          :vals [{:value false} {:value "not-found"} {:as :pkg-name} {:as :pkg-version}]}}

  {:name :_pkgv-err-missing
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :reason} {:value :missing}]
          :vals [{:value false} {:value "missing-dependencies"} :_pkgv-missing]}}

  ;; `{:branch-id <current>}` — the seed of every pin-table :where
  ;; (update's pin lookup, the installed list, uninstall).
  {:name :_pins-where-branch
   :parent :assoc-empty
   :args {:key {:value :branch-id} :value :current-branch-id}}

  ;; This branch's pin row for `:pkg-name` (nil when not installed) —
  ;; the lookup update AND uninstall both start from.
  {:name :_pins-where
   :parent :assoc
   :args {:map :_pins-where-branch :key {:value :package-name} :value {:as :pkg-name :type :text}}}

  {:name :_pins-rows
   :parent :query-entities
   :args {:entity-type {:value "package-install"} :where :_pins-where}}

  {:name :_pin-row
   :parent :first
   :args {:coll :_pins-rows}}

  ;; --- :update-package-version — pin lookup → guards → apply, all graph. ---

  {:name :_upd-pin-nil?
   :parent :nil?
   :args {:value :_pin-row}}

  {:name :_upd-old
   :parent :get
   :args {:coll :_pin-row :key {:value :version} :default nil}}

  {:name :_upd-same?
   :description "Target resolves to the already-pinned version — a no-op."
   :parent :equal?
   :args {:a :_pkgv-resolved :b {:ref :_upd-old :type :nullable-text}}}

  {:name :_upd-rewritten
   :parent :update-package-apply
   :args {:pkg-name {:as :pkg-name}
          :old-version {:ref :_upd-old :type :text}
          :new-version {:ref :_pkgv-resolved :type :text}
          :ns-root {:ref :_pkgv-ns-root :type :text}
          :fns {:ref :_pkgv-fns :type [:list :jsonb]}}}

  {:name :_upd-err-not-installed
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :reason} {:value :name}]
          :vals [{:value false} {:value "not-installed"} {:as :pkg-name}]}}

  {:name :_upd-noop
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :name} {:value :from} {:value :to} {:value :rewritten-refs}]
          :vals [{:value true} {:as :pkg-name} :_upd-old :_pkgv-resolved {:value 0}]}}

  {:name :_upd-ok
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :name} {:value :from} {:value :to} {:value :rewritten-refs}]
          :vals [{:value true} {:as :pkg-name} :_upd-old :_pkgv-resolved :_upd-rewritten]}}

  {:name :update-package-version
   :description "Update (or roll back) an installed package to a different version: materialize the target, REWRITE the project's own refs from the pinned version to the target (package-internal refs untouched), repoint the pin. Symmetric (older version = rollback). Pure graph :cond — rejects on not-installed / not-found / missing-dependencies; same-version is a no-op; the apply core (`:update-package-apply`) is the coupled write+invalidate unit."
   :parent :cond
   :args {:clauses [:_upd-pin-nil?      :_upd-err-not-installed
                    :_pkgv-row-nil?     :_pkgv-err-not-found
                    :_upd-same?         :_upd-noop
                    :_pkgv-missing-any? :_pkgv-err-missing
                    {:value true}       :_upd-ok]}}

  {:name :_update-body
   :description "Parsed JSON body of POST /api/packages/update — `{:name :version}`."
   :parent :parse-json-body}

  {:name :_update-name-raw
   :parent :get :args {:coll :_update-body :key {:value :name} :default nil}}
  {:name :_update-name
   :parent :to-str :args {:value :_update-name-raw}}

  {:name :_update-version-raw
   :parent :get :args {:coll :_update-body :key {:value :version} :default nil}}
  {:name :_update-version
   :parent :to-str :args {:value :_update-version-raw}}

  {:name :_update-result
   :parent :update-package-version
   :args {:pkg-name :_update-name :pkg-version :_update-version}}

  {:name :update-package-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/packages/update (auth-required) — JSON `{ok, …}`."
   :parent :json-handler
   :args {:data :_update-result}}

  {:name :api-packages-update
   :description "POST /api/packages/update — update/rollback an installed package to another version (rewrites the project's refs). Auth-required."
   :parent :post
   :args {:path "/packages/update" :handler :update-package-handler}}

  ;; ---------------------------------------------------------------------
  ;; POST /api/packages/fork — copy-on-write: sync a version's fns into the
  ;; graph at their ORIGINAL namespace so they can be modified. Body
  ;; `{:name :version}`.
  ;; ---------------------------------------------------------------------

  {:name :_fork-do-count
   :parent :fork-package-fns
   :args {:fns {:ref :_pkgv-fns :type [:list :jsonb]}}}

  {:name :_fork-do-ok
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :name} {:value :version} {:value :forked}]
          :vals [{:value true} {:as :pkg-name} :_pkgv-resolved :_fork-do-count]}}

  {:name :fork-package
   :description "Fork published `(:pkg-name, :pkg-version)`: sync its fns into the graph at their ORIGINAL namespace, DUPLICATING rows so the caller can modify them (copy-on-write). Unlike reference install, this copies. Pure graph :cond over the shared `:_pkgv-*` guard prefix + per-flow envelopes; the apply core (`:fork-package-fns`) is the coupled sync+invalidate unit."
   :parent :cond
   :args {:clauses [:_pkgv-row-nil?     :_pkgv-err-not-found
                    :_pkgv-missing-any? :_pkgv-err-missing
                    {:value true}       :_fork-do-ok]}
   ;; The three cond branches' envelopes, verbatim — ok | missing-deps |
   ;; not-found. Matches the computed union (type-drift sweep).
   :return-type [:union {:ok :bool :name :any :version [:union :null :text]
                         :forked :int}
                 {:ok :bool :reason :text :missing [:list :keyword]}
                 {:ok :bool :reason :text :name :any :requested :any}]}

  {:name :_fork-body
   :description "Parsed JSON body of POST /api/packages/fork — `{:name :version}`."
   :parent :parse-json-body}

  {:name :_fork-name-raw
   :parent :get :args {:coll :_fork-body :key {:value :name} :default nil}}
  {:name :_fork-name
   :parent :to-str :args {:value :_fork-name-raw}}

  {:name :_fork-version-raw
   :parent :get :args {:coll :_fork-body :key {:value :version} :default nil}}
  {:name :_fork-version
   :parent :to-str :args {:value :_fork-version-raw}}

  {:name :_fork-result
   :parent :fork-package
   :args {:pkg-name :_fork-name :pkg-version :_fork-version}}

  {:name :fork-package-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/packages/fork (auth-required) — JSON `{ok, …}`."
   :parent :json-handler
   :args {:data :_fork-result}}

  {:name :api-packages-fork
   :description "POST /api/packages/fork — copy a published version's fns into the graph for modification. Auth-required."
   :parent :post
   :args {:path "/packages/fork" :handler :fork-package-handler}}

  {:name :version-qualified-ns
   :description "Pure boundary string-shaping — `web.components.foo` @ `1.3.0` under ns-root `web.components` → `web.components@1-3-0.foo`. Delegates to the same helper the apply cores use so the naming contract has one source."
   :args {:ns-root {:type :text :description "Package ns-root."}
          :version {:type :text :description "Semver version — dots sanitized to dashes."}
          :fn-ns {:type :text :description "The fn's namespace; left as-is when not under ns-root."}}
   :return-type :text}

  {:name :_mat-count
   :parent :materialize-package-fns
   :args {:ns-root {:ref :_pkgv-ns-root :type :text}
          :version {:ref :_pkgv-resolved :type :text}
          :fns {:ref :_pkgv-fns :type [:list :jsonb]}}}

  {:name :_mat-vq-ns
   :parent :version-qualified-ns
   :args {:ns-root {:ref :_pkgv-ns-root :type :text}
          :version {:ref :_pkgv-resolved :type :text}
          :fn-ns {:ref :_pkgv-ns-root :type :text}}}

  {:name :_mat-ok
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :name} {:value :version} {:value :namespace} {:value :materialized}]
          :vals [{:value true} {:as :pkg-name} :_pkgv-resolved :_mat-vq-ns :_mat-count]}}

  {:name :materialize-package-version
   :description "Sync a published version's fns ONCE under a version-qualified namespace (`<ns-root>@<sanitized-version>`) so versions coexist and callers reference them instead of copying rows. Org-neutral (current scope). Idempotent. Pure graph :cond over the shared `:_pkgv-*` guard prefix; the apply core (`:materialize-package-fns`) is the coupled sync+invalidate unit."
   :parent :cond
   :args {:clauses [:_pkgv-row-nil?     :_pkgv-err-not-found
                    :_pkgv-missing-any? :_pkgv-err-missing
                    {:value true}       :_mat-ok]}
   ;; The three cond branches' envelopes, verbatim — ok | missing-deps |
   ;; not-found. Matches the computed union (type-drift sweep).
   :return-type [:union {:ok :bool :name :any :version [:union :null :text]
                         :namespace :text :materialized :int}
                 {:ok :bool :reason :text :missing [:list :keyword]}
                 {:ok :bool :reason :text :name :any :requested :any}]}

  ;; ---------------------------------------------------------------------
  ;; Package pins — per-branch desired-state "this branch uses P at V".
  ;; Base-fns backing reference-install + the editor's installed list.
  ;; ---------------------------------------------------------------------

  {:name :package-upsert-pin
   :description "Upsert the single pin row for `(current-branch, :pkg-name)` → `:pkg-version`. Returns the branch-id as text. Shared with the install / update apply cores."
   :args {:pkg-name {:type :text :description "Package name to pin."}
          :pkg-version {:type :text :description "Version to pin the package at."}}
   :return-type :text
   :effects #{:db :time}}

  {:name :_pin-branch-text
   :parent :package-upsert-pin
   :args {:pkg-name {:as :pkg-name :type :text} :pkg-version {:as :pkg-version :type :text}}}

  {:name :set-package-pin
   :description "Upsert the pin for `(current-branch, :pkg-name)` to `:pkg-version` — one pin per (branch, package). Returns a tagged `{:ok true …}` (envelope is graph composition). Writes to the request's branch (staging)."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :package-name} {:value :version} {:value :branch-id}]
          :vals [{:value true} {:as :pkg-name} {:as :pkg-version} :_pin-branch-text]}
   :return-type {:ok :bool :package-name :any :version :any :branch-id :text}}

  ;; Installed list — pure graph composition: this branch's pins,
  ;; reshaped per-row for clean JSON.
  {:name :_inst-rows
   :parent :query-entities
   :args {:entity-type {:value "package-install"} :where :_pins-where-branch}}

  {:name :_inst-entry-name
   :parent :get :args {:coll {:as :item} :key {:value :package-name} :default nil}}

  {:name :_inst-entry-version
   :parent :get :args {:coll {:as :item} :key {:value :version} :default nil}}

  {:name :_inst-entry-branch
   :parent :to-str
   :args {:value {:parent :get :args {:coll {:as :item} :key {:value :branch-id} :default nil}}}}

  {:name :_inst-entry-at
   :parent :to-str
   :args {:value {:parent :get :args {:coll {:as :item} :key {:value :installed-at} :default nil}}}}

  {:name :_inst-entry
   :parent :zipmap
   :args {:keys [{:value :package-name} {:value :version} {:value :branch-id} {:value :installed-at}]
          :vals [:_inst-entry-name :_inst-entry-version :_inst-entry-branch :_inst-entry-at]}}

  {:name :list-installed-packages
   :description "Every package pinned on the current branch — `[{:package-name :version :branch-id :installed-at} …]`. Powers GET /api/packages/installed and the editor's installed list. Pure graph composition."
   :parent :map
   :args {:func :_inst-entry :coll :_inst-rows}
   :return-type [:list {:package-name :any :version :any
                        :branch-id :text :installed-at :text}]}

  ;; Uninstall — pure graph composition: find the pin (shared
  ;; `:_pin-row` lookup), delete it when present, return the
  ;; idempotent envelope.
  {:name :_unpin-present?
   :parent :some?
   :args {:value :_pin-row}}

  {:name :_unpin-id
   :parent :get
   :args {:coll :_pin-row :key {:value :id} :default nil}}

  {:name :_unpin-delete
   :parent :delete-entity
   :args {:entity-type {:value "package-install"} :id {:ref :_unpin-id :type :uuid}}}

  {:name :_unpin-maybe
   :parent :if
   :args {:test :_unpin-present?
          :then :_unpin-delete
          :else {:value nil}}}

  {:name :_unpin-envelope
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :package-name} {:value :removed}]
          :vals [{:value true} {:as :pkg-name} :_unpin-present?]}}

  {:name :remove-package-pin
   :description "Drop the pin for `(current-branch, :pkg-name)` — uninstall. Idempotent; `:removed false` when nothing was pinned. Pure graph composition (`:do` forces the delete before the envelope)."
   :parent :do
   :args {:steps [:_unpin-maybe :_unpin-envelope]}
   :return-type :keyword-map}

  ;; ---------------------------------------------------------------------
  ;; GET /api/packages/installed — this branch's pins.
  ;; ---------------------------------------------------------------------

  {:name :_installed-packages-result
   :parent :list-installed-packages}

  {:name :list-installed-handler
   :description "Ring handler for GET /api/packages/installed (auth-required) — JSON array of this branch's pins."
   :parent :json-handler
   :args {:data :_installed-packages-result}}

  {:name :api-packages-installed
   :description "GET /api/packages/installed — the packages pinned on the current branch. Auth-required."
   :parent :get-auth-required
   :args {:path "/packages/installed" :handler :list-installed-handler}}

  ;; ---------------------------------------------------------------------
  ;; GET /partials/packages-panel — the editor's Packages browse/install browser,
  ;; server-rendered hiccup (graph-first). Read-only table: Package | Version
  ;; over the current branch's pins. Lazy-loaded via hx-get by the Build-surface
  ;; packages chip popover (editor-shell.js `gdOpenPkgPop`).
  ;; ---------------------------------------------------------------------

  {:name :_pkg-panel-th-name
   :parent :hiccup :args {:tag {:value "th"} :children [{:value "Package"}]}}
  {:name :_pkg-panel-th-version
   :parent :hiccup :args {:tag {:value "th"} :children [{:value "Version"}]}}
  ;; empty header over the per-row uninstall (×) column
  {:name :_pkg-panel-th-actions
   :parent :hiccup :args {:tag {:value "th"} :children [{:value ""}]}}
  {:name :_pkg-panel-thead-row
   :parent :hiccup :args {:tag {:value "tr"} :children [:_pkg-panel-th-name :_pkg-panel-th-version :_pkg-panel-th-actions]}}
  {:name :_pkg-panel-thead
   :parent :hiccup :args {:tag {:value "thead"} :children [:_pkg-panel-thead-row]}}

  ;; body row — HOF over :item (each pin `{:package-name :version …}`)
  {:name :_pkg-panel-name-val
   :parent :get :args {:coll {:as :item} :key {:value :package-name} :default {:value ""}}}
  {:name :_pkg-panel-version-val
   :parent :get :args {:coll {:as :item} :key {:value :version} :default {:value ""}}}
  {:name :_pkg-panel-td-name
   :parent :hiccup :args {:tag {:value "td"} :children [:_pkg-panel-name-val]}}
  {:name :_pkg-panel-td-version
   :parent :hiccup :args {:tag {:value "td"} :children [:_pkg-panel-version-val]}}

  ;; per-row uninstall — hx-delete DELETE /api/packages/uninstall/:name, then
  ;; swap the REFRESHED panel back into [data-packages-panel] (outerHTML) so the
  ;; empty-state notice appears when the last pin goes. No client JS; the bearer
  ;; rides the htmx:configRequest bridge. Path built from the per-row name.
  {:name :_pkg-panel-uninstall-url
   :parent :str-join
   :args {:coll [{:value "/api/packages/uninstall?name="} :_pkg-panel-name-val]
          :separator {:value ""}}}
  {:name :_pkg-panel-uninstall-attrs
   :parent :assoc
   :args {:map {:value {:type "button"
                        :class "packages-uninstall"
                        :title "Uninstall package"
                        :hx-target "closest [data-packages-panel]"
                        :hx-swap "outerHTML"
                        :hx-confirm "Uninstall this package from this branch?"}}
          :key {:value :hx-delete}
          :value :_pkg-panel-uninstall-url}}
  {:name :_pkg-panel-uninstall-btn
   :parent :hiccup
   :args {:tag {:value "button"} :attrs :_pkg-panel-uninstall-attrs :children [{:value "×"}]}}

  ;; per-row update/rollback — a tiny <form hx-post="/api/packages/panel-update">
  ;; with a hidden name + a version text input (prefilled with the current
  ;; version). Submitting form-encodes {name, version} → update-package-version
  ;; (variant-B ref-rewrite; symmetric so an OLDER version = rollback; accepts
  ;; exact / `latest` / a semver constraint), then swaps the refreshed panel.
  ;; A free-text version (not a <select>) avoids a per-row registry filter;
  ;; a version dropdown is a possible follow-up.
  {:name :_pkg-panel-update-name-attrs
   :parent :assoc
   :args {:map {:value {:type "hidden" :name "name"}}
          :key {:value :value} :value :_pkg-panel-name-val}}
  {:name :_pkg-panel-update-name-input
   :parent :hiccup :args {:tag {:value "input"} :attrs :_pkg-panel-update-name-attrs}}
  {:name :_pkg-panel-update-version-attrs
   :parent :assoc
   :args {:map {:value {:type "text" :name "version" :class "packages-version-input"
                        :size "6" :title "Target version — exact, latest, or a constraint"}}
          :key {:value :value} :value :_pkg-panel-version-val}}
  {:name :_pkg-panel-update-version-input
   :parent :hiccup :args {:tag {:value "input"} :attrs :_pkg-panel-update-version-attrs}}
  {:name :_pkg-panel-update-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:value {:type "submit" :class "packages-update-btn" :title "Update / roll back to this version"}}
          :children [{:value "↑"}]}}
  {:name :_pkg-panel-update-form
   :parent :hiccup
   :args {:tag {:value "form"}
          :attrs {:value {:class "packages-update-form"
                          :hx-post "/api/packages/panel-update"
                          :hx-target "closest [data-packages-panel]"
                          :hx-swap "outerHTML"}}
          :children [:_pkg-panel-update-name-input :_pkg-panel-update-version-input :_pkg-panel-update-btn]}}
  {:name :_pkg-panel-td-actions
   :parent :hiccup :args {:tag {:value "td"} :children [:_pkg-panel-update-form :_pkg-panel-uninstall-btn]}}

  {:name :_pkg-panel-row
   :parent :hiccup :args {:tag {:value "tr"} :children [:_pkg-panel-td-name :_pkg-panel-td-version :_pkg-panel-td-actions]}}

  {:name :_pkg-panel-rows
   :parent :map :args {:func :_pkg-panel-row :coll :list-installed-packages}}
  {:name :_pkg-panel-tbody
   :parent :hiccup :args {:tag {:value "tbody"} :children :_pkg-panel-rows}}
  {:name :_pkg-panel-table
   :parent :hiccup
   :args {:tag {:value "table"}
          :attrs {:value {:class "packages-panel-table"}}
          :children [:_pkg-panel-thead :_pkg-panel-tbody]}}

  ;; empty-state — a notice when nothing is pinned on this branch (the common
  ;; single-tenant dev case), instead of a header-only table.
  {:name :_pkg-panel-empty-notice
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "packages-panel-empty"}}
          :children [{:value "No add-on packages installed on this branch. The built-in packages are always available — browse the registry below to install more."}]}}
  {:name :_pkg-panel-is-empty
   :parent :empty? :args {:coll :list-installed-packages}}
  {:name :_pkg-panel-body
   :parent :if
   :args {:test :_pkg-panel-is-empty :then :_pkg-panel-empty-notice :else :_pkg-panel-table}}

  ;; --- Browse + Install: the registry index inside a native <details> ----
  ;; Each published (name, version) is an Install button; hx-post carries the
  ;; pair as query params (same query-not-path reason as uninstall) and swaps
  ;; the REFRESHED panel back into [data-packages-panel]. HOF over :item.
  {:name :_pkg-avail-name-val
   :parent :get :args {:coll {:as :item} :key {:value :name} :default {:value ""}}}
  {:name :_pkg-avail-version-val
   :parent :get :args {:coll {:as :item} :key {:value :version} :default {:value ""}}}
  {:name :_pkg-avail-install-url
   :parent :str-join
   :args {:coll [{:value "/api/packages/panel-install?name="} :_pkg-avail-name-val
                 {:value "&version="} :_pkg-avail-version-val]
          :separator {:value ""}}}
  {:name :_pkg-avail-install-attrs
   :parent :assoc
   :args {:map {:value {:type "button"
                        :class "packages-install-btn"
                        :hx-target "closest [data-packages-panel]"
                        :hx-swap "outerHTML"}}
          :key {:value :hx-post}
          :value :_pkg-avail-install-url}}
  {:name :_pkg-avail-install-btn
   :parent :hiccup
   :args {:tag {:value "button"} :attrs :_pkg-avail-install-attrs :children [{:value "Install"}]}}

  ;; Fork button per browse row — COPY (copy-on-write) the version's fns into the
  ;; graph at their original namespace so they can be edited, vs Install's
  ;; by-reference pin. hx-post the pair as query params; the refreshed panel
  ;; carries a transient fork notice (fork writes no pin, so the installed table
  ;; is otherwise unchanged).
  {:name :_pkg-avail-fork-url
   :parent :str-join
   :args {:coll [{:value "/api/packages/panel-fork?name="} :_pkg-avail-name-val
                 {:value "&version="} :_pkg-avail-version-val]
          :separator {:value ""}}}
  {:name :_pkg-avail-fork-attrs
   :parent :assoc
   :args {:map {:value {:type "button"
                        :class "packages-fork-btn"
                        :title "Fork — copy this version's fns into the graph to edit"
                        :hx-target "closest [data-packages-panel]"
                        :hx-swap "outerHTML"}}
          :key {:value :hx-post}
          :value :_pkg-avail-fork-url}}
  {:name :_pkg-avail-fork-btn
   :parent :hiccup
   :args {:tag {:value "button"} :attrs :_pkg-avail-fork-attrs :children [{:value "Fork"}]}}
  ;; Private-to-org badge (spec §5): `:public?` false = an org-private row.
  ;; Publish normalises the flag at WRITE time (platform-tier → true), so
  ;; `false` is exactly "private"; legacy shared rows carry nil, not false,
  ;; and get no badge.
  {:name :_pkg-avail-public-val
   :parent :get :args {:coll {:as :item} :key {:value :public} :default nil}}
  {:name :_pkg-avail-private?
   :parent :equal? :args {:a :_pkg-avail-public-val :b {:value false}}}
  {:name :_pkg-avail-private-badge
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "packages-private-badge"}}
          :children [{:value "private"}]}}
  {:name :_pkg-avail-badge-maybe
   :parent :if
   :args {:test :_pkg-avail-private? :then :_pkg-avail-private-badge :else {:value nil}}}
  {:name :_pkg-avail-td-name
   :parent :hiccup :args {:tag {:value "td"} :children [:_pkg-avail-name-val :_pkg-avail-badge-maybe]}}
  {:name :_pkg-avail-td-version
   :parent :hiccup :args {:tag {:value "td"} :children [:_pkg-avail-version-val]}}
  {:name :_pkg-avail-td-action
   :parent :hiccup :args {:tag {:value "td"} :children [:_pkg-avail-install-btn :_pkg-avail-fork-btn]}}
  {:name :_pkg-avail-row
   :parent :hiccup
   :args {:tag {:value "tr"} :children [:_pkg-avail-td-name :_pkg-avail-td-version :_pkg-avail-td-action]}}
  {:name :_pkg-avail-rows
   :parent :map :args {:func :_pkg-avail-row :coll :list-package-versions}}
  {:name :_pkg-avail-tbody
   :parent :hiccup :args {:tag {:value "tbody"} :children :_pkg-avail-rows}}
  {:name :_pkg-avail-table
   :parent :hiccup
   :args {:tag {:value "table"}
          :attrs {:value {:class "packages-panel-table"}}
          :children [:_pkg-avail-tbody]}}
  {:name :_pkg-avail-is-empty
   :parent :empty? :args {:coll :list-package-versions}}
  {:name :_pkg-avail-empty-notice
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "packages-panel-empty"}}
          :children [{:value "No packages published in the registry yet."}]}}
  {:name :_pkg-avail-body
   :parent :if
   :args {:test :_pkg-avail-is-empty :then :_pkg-avail-empty-notice :else :_pkg-avail-table}}
  {:name :_pkg-avail-summary
   :parent :hiccup :args {:tag {:value "summary"} :children [{:value "+ Install a package"}]}}
  {:name :_pkg-avail-details
   :parent :hiccup
   :args {:tag {:value "details"}
          :attrs {:value {:class "packages-available"}}
          :children [:_pkg-avail-summary :_pkg-avail-body]}}

  ;; Stable [data-packages-panel] root — the hx-target every panel mutation
  ;; (uninstall / install / update / fork) swaps with hx-swap="outerHTML", so
  ;; the whole panel (installed pins + the browse <details>) re-renders from
  ;; fresh desired-state each time.
  ;;
  ;; Install is a BUILD act: this panel is the browse/install browser reached
  ;; from the Build-surface "packages" context-bar chip. Publish is NOT here —
  ;; it is an authoring action on a namespace (packages spec §3). The publish
  ;; <details> (`:_pkg-publish-details`) is intentionally excluded from this
  ;; root; its POST route (`:api-packages-panel-publish`) stays live at the API
  ;; level, and a namespace-scoped publish affordance is the next slice (A2).
  ;; Until then publish is simply not surfaced in the editor — deliberate, not
  ;; an orphan to "fix" by re-adding it to the chip.
  {:name :_pkg-panel-root
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:data-packages-panel "1"}}
          :children [:_pkg-panel-body :_pkg-avail-details]}}

  {:name :_pkg-panel-html
   :parent :render-hiccup :args {:hiccup :_pkg-panel-root}}
  {:name :_partial-packages-panel-handler
   :description "Ring handler for GET /partials/packages-panel — installed packages as text/html."
   :parent :html-ok-response :args {:body :_pkg-panel-html}}
  {:name :partial-packages-panel
   :description "GET /partials/packages-panel — server-rendered list of packages pinned on the current branch. Per-row × uninstalls. Auth-required."
   :parent :get-auth-required
   :args {:path "/partials/packages-panel" :handler :_partial-packages-panel-handler}}

  ;; ---------------------------------------------------------------------
  ;; GET /partials/packages-governance — the Organization surface's
  ;; read-mostly governance view (packages spec §4): the catalog of
  ;; versions THIS org published, and an install audit (which package is
  ;; pinned at which version on which branch). No install button — install
  ;; lives on the Build packages chip. Shallow chains only (query +
  ;; reshape + hiccup); never re-ref the publish/secrets closure (the A2
  ;; boot landmine).
  ;; ---------------------------------------------------------------------

  ;; -- catalog: :package-version rows this org published. The org
  ;;    comparison is row `:org-id` vs `:current-org-id` — never an org
  ;;    literal; publish stamps the same value with and without the
  ;;    tenancy addon, so the filter works identically on both.
  {:name :_gov-row-org
   :parent :get :args {:coll {:as :item} :key {:value :org-id} :default nil}}
  {:name :_gov-row-mine?
   :parent :equal? :args {:a :_gov-row-org :b :current-org-id}}
  {:name :_gov-catalog-rows
   :description "The :package-version rows the caller's org published — the governance catalog."
   :parent :filter :args {:pred :_gov-row-mine? :coll :_pkg-index-rows}}

  {:name :_gov-cat-name
   :parent :get :args {:coll {:as :item} :key {:value :name} :default {:value ""}}}
  {:name :_gov-cat-version
   :parent :get :args {:coll {:as :item} :key {:value :version} :default {:value ""}}}
  {:name :_gov-cat-public
   :parent :get :args {:coll {:as :item} :key {:value :public?} :default nil}}
  {:name :_gov-cat-visibility
   :description "\"public\" / \"private\" from the row's :public? — write-time-normalised, so the flag alone decides."
   :parent :if
   :args {:test :_gov-cat-public :then {:value "public"} :else {:value "private"}}}
  {:name :_gov-cat-at
   :parent :to-str
   :args {:value {:parent :get :args {:coll {:as :item} :key {:value :published-at} :default {:value ""}}}}}
  {:name :_gov-cat-td-name
   :parent :hiccup :args {:tag {:value "td"} :children [:_gov-cat-name]}}
  {:name :_gov-cat-td-version
   :parent :hiccup :args {:tag {:value "td"} :children [:_gov-cat-version]}}
  {:name :_gov-cat-td-visibility
   :parent :hiccup :args {:tag {:value "td"} :children [:_gov-cat-visibility]}}
  {:name :_gov-cat-td-at
   :parent :hiccup :args {:tag {:value "td"} :children [:_gov-cat-at]}}
  {:name :_gov-cat-row
   :parent :hiccup
   :args {:tag {:value "tr"}
          :children [:_gov-cat-td-name :_gov-cat-td-version :_gov-cat-td-visibility :_gov-cat-td-at]}}
  {:name :_gov-cat-body-rows
   :parent :map :args {:func :_gov-cat-row :coll :_gov-catalog-rows}}
  {:name :_gov-cat-tbody
   :parent :hiccup :args {:tag {:value "tbody"} :children :_gov-cat-body-rows}}
  {:name :_gov-cat-thead
   :parent :hiccup
   :args {:tag {:value "thead"}
          :children [{:value [:tr [:th "Package"] [:th "Version"] [:th "Visibility"] [:th "Published"]]}]}}
  {:name :_gov-cat-table
   :parent :hiccup
   :args {:tag {:value "table"}
          :attrs {:value {:class "packages-panel-table"}}
          :children [:_gov-cat-thead :_gov-cat-tbody]}}
  {:name :_gov-cat-empty
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "packages-panel-empty"}}
          :children [{:value "Nothing published by this organization yet — publish a namespace with its ⬆ action."}]}}
  {:name :_gov-cat-is-empty
   :parent :empty? :args {:coll :_gov-catalog-rows}}
  {:name :_gov-cat-block
   :parent :if
   :args {:test :_gov-cat-is-empty :then :_gov-cat-empty :else :_gov-cat-table}}

  ;; -- install audit: every pin visible to this org (all branches), each
  ;;    resolved to its branch name via ONE branches query + a zipmap
  ;;    (no per-row read).
  {:name :_gov-branch-rows
   :parent :query-entities
   :args {:entity-type {:value "branch"} :where {:value {}}}}
  {:name :_gov-branch-row-id
   :parent :get :args {:coll {:as :item} :key {:value :id} :default nil}}
  {:name :_gov-branch-row-name
   :parent :get :args {:coll {:as :item} :key {:value :name} :default {:value "?"}}}
  {:name :_gov-branch-ids
   :parent :map :args {:func :_gov-branch-row-id :coll :_gov-branch-rows}}
  {:name :_gov-branch-names
   :parent :map :args {:func :_gov-branch-row-name :coll :_gov-branch-rows}}
  {:name :_gov-branch-name-map
   :description "branch-id → branch-name for the audit rows — one query + zipmap, no per-pin read."
   :parent :zipmap :args {:keys :_gov-branch-ids :vals :_gov-branch-names}}

  {:name :_gov-pins
   :parent :query-entities
   :args {:entity-type {:value "package-install"} :where {:value {}}}}
  {:name :_gov-pin-name
   :parent :get :args {:coll {:as :item} :key {:value :package-name} :default {:value ""}}}
  {:name :_gov-pin-version
   :parent :get :args {:coll {:as :item} :key {:value :version} :default {:value ""}}}
  {:name :_gov-pin-branch-id
   :parent :get :args {:coll {:as :item} :key {:value :branch-id} :default nil}}
  {:name :_gov-pin-branch
   :parent :get :args {:coll :_gov-branch-name-map :key :_gov-pin-branch-id :default {:value "?"}}}
  {:name :_gov-pin-at
   :parent :to-str
   :args {:value {:parent :get :args {:coll {:as :item} :key {:value :installed-at} :default {:value ""}}}}}
  {:name :_gov-pin-td-name
   :parent :hiccup :args {:tag {:value "td"} :children [:_gov-pin-name]}}
  {:name :_gov-pin-td-version
   :parent :hiccup :args {:tag {:value "td"} :children [:_gov-pin-version]}}
