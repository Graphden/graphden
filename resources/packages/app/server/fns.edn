;; Web server fn-defs - combines editor UI with health/metrics endpoints
;; Endpoints:
;;   GET / (Editor HTML)
;;   GET /favicon.ico (SVG)
;;   GET /health (JSON)
;;   GET /metrics (JSON)
;;   GET /api/graph/entities (JSON)
;;   GET /partials/entity-details/:type/:id (HTML partial)
;;   GET /partials/entity-form/:type (HTML partial)
;;   GET /partials/entity-form/:type/:id (HTML partial)
;;   POST /api/entities/:type (JSON)
;;   POST /api/graph/layout (JSON)
;;   DELETE /api/entities/:type/:id (JSON)


{:namespace "app.server"
 :fns
[;; =============================================================================
 ;; HEALTH ROUTE (Dynamic JSON)
 ;; =============================================================================

 {:name :health-json-body-fn
  :parent :to-json-string
  :args {:data :health-status}}

 {:name :health-response-fn
  :parent :json-ok-response
  :args {:body :health-json-body-fn}}

 {:name :health-handler-fn
  :parent :make-handler
  :args {:response :health-response-fn}}

 ;; GET /health
 {:name :health-route
  :parent :get-route
  :args {:path "/health" :handler :health-handler-fn}}

 ;; =============================================================================
 ;; METRICS ROUTE (JVM Info)
 ;; =============================================================================

 {:name :metrics-json-body-fn
  :parent :to-json-string
  :args {:data :jvm-info}}

 {:name :metrics-response-fn
  :parent :json-ok-response
  :args {:body :metrics-json-body-fn}}

 {:name :metrics-handler-fn
  :parent :make-handler
  :args {:response :metrics-response-fn}}

 ;; GET /metrics
 {:name :metrics-route
  :parent :get-route
  :args {:path "/metrics" :handler :metrics-handler-fn}}

 ;; =============================================================================
 ;; ROUTES COLLECTION & SERVER
 ;; =============================================================================

 ;; All routes - uses list-11 which hides the conj cascade inside
 ;; When viewing editor-routes, you see 11 route arguments, not the cascade
 ;; The cascade (list-11 -> list-10 -> ... -> triple -> pair -> conj-any)
 ;; is only visible when you expand list-11
 {:name :editor-routes
  :parent :list-11
  :args {:item1 :favicon-route
         :item2 :editor-route
         :item3 :api-entities-route
         :item4 :entity-details-route
         :item5 :entity-form-create-route
         :item6 :entity-form-edit-route
         :item7 :create-entity-route
         :item8 :delete-entity-route
         :item9 :health-route
         :item10 :metrics-route
         :item11 :layout-api-route}}

 ;; Router receives routes vector
 {:name :router-fn
  :parent :router
  :args {:routes :editor-routes
         :not-found-response :default-404-response
         :method-not-allowed-response :default-405-response
         :error-response :default-500-response}}

 ;; Server receives router as handler
 {:name :web-server
  :parent :http-server
  :args {:handler :router-fn
         :port 8080
         :default-headers :security-headers}}]}
