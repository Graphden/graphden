{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "off" } } },
	"files": {
		"includes": [
			"**/resources/packages/app/editor/**/*.js",
			"!**/node_modules/**",
			"!**/tools/browser-test/**"
		]
	},
	"javascript": {
		"globals": ["cytoscape", "BUILD_HASH", "authFetch", "isAuthenticated"],
		"formatter": { "enabled": false }
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noUselessElse": "off",
				"useTemplate": "off",
				"useConst": "warn",
				"noParameterAssign": "off",
				"useSingleVarDeclarator": "off",
				"useNumberNamespace": "off"
			},
			"complexity": {
				"noForEach": "off",
				"useArrowFunction": "off",
				"useOptionalChain": "warn",
				"useLiteralKeys": "warn",
				"noUselessTernary": "warn"
			},
			"suspicious": {
				"noAssignInExpressions": "warn",
				"noConsole": "off",
				"noVar": "off",
				"useIterableCallbackReturn": "off"
			},
			"correctness": {
				"noUnusedVariables": "off",
				"noUnusedFunctionParameters": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"**/resources/packages/app/editor/editor-state.js",
				"**/resources/packages/app/editor/editor-ui.js"
			],
			"linter": {
				"rules": {
					"style": { "useConst": "off" }
				}
			}
		}
	]
}
