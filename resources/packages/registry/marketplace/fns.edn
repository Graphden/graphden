  ;; ACTIONS — each does its write, then re-renders the item
  ;; =====================================================================

  ;; params ride the query string (buttons) or the urlencoded form; query wins
  {:name :_mka-form
   :parent :parse-form-body-kw}
  {:name :_mka-param
   :description "Query param `:param-name`, else the form field of the same name, else \"\"."
   :parent :str-trim
   :args {:string {:parent :to-str
                   :args {:value {:parent :coalesce
                                  :args {:value {:parent :query-param :args {:request {:as :request} :param-name {:as :param-name}}}
                                         :default {:parent :get :args {:coll :_mka-form :key {:parent :str-to-keyword :args {:string {:as :param-name}}} :default {:value ""}}}}}}}}}
  {:name :_mka-name
   :parent :_mka-param :args {:param-name {:value "name"}}}
  {:name :_mka-version
   :parent :_mka-param :args {:param-name {:value "version"}}}
  {:name :_mka-fork?
   :parent :equal? :args {:a {:parent :_mka-param :args {:param-name {:value "fork"}}} :b {:value "1"}}}

  ;; --- install / fork (fns) ---
  {:name :_mka-install-do
   :parent :if
   :args {:test :_mka-fork?
          :then {:parent :fork-package :args {:pkg-name :_mka-name :pkg-version :_mka-version}}
          :else {:parent :install-package :args {:pkg-name :_mka-name :pkg-version :_mka-version :source {:value nil}}}}}
  ;; The notice reads the install OUTCOME under the `outcome` lambda-param —
  ;; `:call` runs the install ONCE; a second ref to the effectful
  ;; `:_mka-install-do` would install again.
  {:name :_mka-install-notice
   :description "The outcome as a sentence — ok, or the refusal's `:reason`. Free arg: `:outcome`."
