{;; clj-kondo configuration
 ;; https://github.com/clj-kondo/clj-kondo/blob/master/doc/config.md

 :config-paths ["imports/http-kit/http-kit"
                "imports/metosin/malli"
                "imports/com.gfredericks/test.chuck"
                "imports/taoensso/encore"]

 :hooks
 {:analyze-call {graphden.executor.registry.macros/defbase hooks.defbase/defbase
                 graphden.executor.defbase/defbase hooks.defbase/defbase
                 graphden.executor.test-setup/fn-impl hooks.fn-impl/fn-impl}}

 ;; resources/packages/<pkg>/<module>/impls.clj files are loaded via
 ;; `load-file`, not via classpath. Their `(ns graphden.packages.…impls)`
 ;; deliberately mismatches the on-disk path, so namespace-name-mismatch
 ;; is turned off for THAT ns-group only (config-in-ns below) and stays
 ;; an error everywhere else.
 :ns-groups [{:pattern "graphden\\.packages\\..*\\.impls" :name package-impls}]
 :config-in-ns {package-impls {:linters {:namespace-name-mismatch {:level :off}}}}

 :linters
 {;; Critical - these indicate real bugs or dead code
  :unused-binding {:level :error}
  :unused-import {:level :error}
  :unused-namespace {:level :error}
  :unused-private-var {:level :error}
  :unused-referred-var {:level :error}
  ;; shadowed-var: ON. A local that shadows a var of its OWN namespace
  ;; (`executor-id` param next to `(defn executor-id …)`) or an
  ;; accidentally-shadowed core fn (`inc`, `reverse`, `partial`, `subs`)
  ;; is the bug class this catches — every such site was renamed when
  ;; the rule was enabled (2026-09-02). The excluded names are the data
  ;; model's own field/entity names, destructured with `{:keys […]}` in
  ;; hundreds of places (`name`, `key`, `ref`, `binding`, `parents`, `ns`,
  ;; `ns-name`, `type`, `test`) plus the two pair-idioms `new` (old/new)
  ;; and `chunk` (batch chunks); renaming those would make the code read
  ;; worse, not safer. defbase arg vectors are user-visible base-fn arg
  ;; names (`map`, `count`, `keys`, …) — the kondo hook tags its generated
  ;; `:keys` destructure with `:clj-kondo/ignore [:shadowed-var]`, so they
  ;; never reach the linter.
  :shadowed-var {:level :warning
                 :exclude [name key ref binding parents ns ns-name type test new chunk]}
  :inline-def {:level :error}

  ;; Code quality
  :redundant-do {:level :warning}
  :redundant-let {:level :warning}
  :redundant-fn-wrapper {:level :warning}
  :single-key-in {:level :warning}
  :missing-else-branch {:level :warning}
  :unsorted-required-namespaces {:level :warning}
  :refer-all {:level :warning}
  :cond-else {:level :warning}

  ;; Performance hints
  :single-logical-operand {:level :warning}
  :reduce-without-init {:level :warning}

  ;; Type hints - critical for correctness
  :unresolved-symbol {:level :error}
  :unresolved-namespace {:level :error}
  :unresolved-var {:level :error}
  :type-mismatch {:level :error}

  ;; Docstrings (optional, enable if you want to enforce docs)
  :missing-docstring {:level :off}

  ;; Consistent naming
  :non-arg-vec-return-type-hint {:level :warning}

  ;; ON everywhere except the package impls.clj ns-group — see the
  ;; :config-in-ns entry at the top of this file.
  :namespace-name-mismatch {:level :error}}

 :output
 {:progress true
  :canonical-paths true}}
