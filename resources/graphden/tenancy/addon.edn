;; Tenancy addon config fragment (PLATFORM_PLAN §3.0 B3).
;;
;; Activate by naming this resource in GRAPHDEN_ADDON_CONFIGS, e.g.
;;   GRAPHDEN_ADDON_CONFIGS=graphden/tenancy/addon.edn
;; The manifest (graphden.system.config) deep-merges it over the core
;; config and runs :graphden/require so the addon's init-key loads.
;;
;; Effect:
;;  - insert OrgScopedStorage BENEATH versioning by redirecting
;;    :db/versioned's base through :org/scoped-storage, which wraps the core
;;    :app/storage seam → Versioned(OrgScoped(app/storage(Postgres)));
;;  - wire :tenancy/request-scope onto :exec/context's :request-scope seam
;;    (B4) so the branch-router authenticates + binds *current-org* per
;;    request.
;;
;; Real per-org isolation still needs an auth provider that resolves :org
;; (session/JWT) + B5 (RLS). With the default single-token provider every
;; request binds the public org, so activating the addon is a safe
;; no-op-equivalent until that provider lands.
{:graphden/require [graphden.tenancy.addon]

 :org/scoped-storage {:base #ig/ref :app/storage}

 :db/versioned {:base-storage #ig/ref :org/scoped-storage}

 :tenancy/request-scope {}

 :exec/context {:request-scope #ig/ref :tenancy/request-scope}

 ;; RLS ops wiring (B5): wrap the shared :db/postgres pool so every
 ;; connection carries graphden.current_org from *current-org*. Combined
 ;; with enable-rls! at deploy + a non-superuser app role, RLS becomes the
 ;; can't-be-bypassed second isolation layer.
 :tenancy/datasource-wrap {}

 :db/postgres {:datasource-wrap #ig/ref :tenancy/datasource-wrap}

 ;; Install the RLS policies at boot. Depends on :db/postgres (tables
 ;; already created by its init-key), so policies attach after migration.
 :tenancy/rls-enabler {:storage #ig/ref :db/postgres}}

;; To turn the addon from a safe no-op into real multi-tenancy, a
;; deployment also overrides the :auth/provider seam with an org-resolving
;; provider — NOT shipped here because the token→org map is a deployment
;; secret. Add to YOUR addon config (e.g. via a second GRAPHDEN_ADDON_CONFIGS
;; entry merged after this one):
;;
;;   {:graphden/require [graphden.tenancy.addon]
;;    :auth/multi-tenant-provider {:tokens {"<secret>" {:user "alice" :org "acme"}}}
;;    :exec/context {:auth-provider #ig/ref :auth/multi-tenant-provider}}
;;
;; Then the request's bearer resolves to its :org, B4 binds *current-org*,
;; and OrgScopedStorage (+ RLS) isolate the tenant.
;;
;; To ALSO enforce per-user grants (§4.2 — opt-in), wire a grant store onto
;; the request-scope. Without this, tenant writes pass (subject only to
;; OrgScoped + the effect gate):
;;
;;   {:graphden/require [graphden.tenancy.addon]
;;    :tenancy/grant-store {:grants [{:subject "alice" :capability :write :namespace "acme.team"}]}
;;    :tenancy/request-scope {:grant-store #ig/ref :tenancy/grant-store}
;;    ;; per-TARGET-namespace write enforcement (also wire the store here):
;;    :org/scoped-storage {:base #ig/ref :app/storage
;;                         :grant-store #ig/ref :tenancy/grant-store}}
;;
;; request-scope does the coarse "is this user a writer/executor at all"
;; check (403); the storage guard does the precise per-namespace check
;; (a :fn write to a namespace the user lacks :write on → 403). With the
;; store on request-scope only, enforcement is org-coarse; add it to
;; :org/scoped-storage too for per-namespace.
;;
;; For PERSISTENT grants (a :grant table instead of a config map), splice
;; the :grant entity into the schema and point the store at storage:
;;
;;   {:graphden/require [graphden.tenancy.addon]
;;    :tenancy/grant-schema {}
;;    :db/schema {:extensions [#ig/ref :tenancy/grant-schema]}
;;    :tenancy/grant-store {:storage #ig/ref :db/postgres}
;;    :tenancy/request-scope {:grant-store #ig/ref :tenancy/grant-store}
;;    :org/scoped-storage {:base #ig/ref :app/storage
;;                         :grant-store #ig/ref :tenancy/grant-store}
;;    ;; per-namespace EXECUTE: gate /api/execute by the fn's namespace:
;;    :tenancy/execute-guard {:grant-store #ig/ref :tenancy/grant-store}
;;    :exec/context {:request-scope #ig/ref :tenancy/request-scope
;;                   :execute-guard #ig/ref :tenancy/execute-guard}}
;;
;; Grant rows (subject, capability ["write"/"execute"/"admin"], namespace)
;; are then ordinary entities — manage them via /api/entities/grant.
;;
;; Add :personal-ns-prefix to give every user implicit :admin on their own
;; namespace (§4.4) — `<prefix>.<user>`, no grant row needed:
;;   :tenancy/grant-store {:storage #ig/ref :db/postgres :personal-ns-prefix "users"}
;;
;; SUBDOMAIN ROUTING (§3.2) — resolve the org from the request Host
;; (`acme.graphden.app` → org `acme`). The token is the org AUTHORITY (single-
;; membership); the subdomain is a GUARD — a member on a foreign subdomain is
;; denied (403), and it can never widen access (so a spoofed Host can't read
;; another org). Anonymous → public. The DEFAULT resolver is identity
;; (subdomain label IS the org-id — no table). Wire the resolver + base domain
;; onto request-scope:
;;   :tenancy/org-resolver {}            ; identity: <org>.graphden.app → org
;;   :tenancy/request-scope {:grant-store #ig/ref :tenancy/grant-store
;;                           :org-resolver #ig/ref :tenancy/org-resolver
;;                           :base-domain "graphden.app"}
;; Pass :subdomains {"vanity" "real-org"} ONLY for aliases where a subdomain
;; differs from its org-id. A hostname→org table is a separate thing — only
;; for CUSTOM domains (§3.2 R10), which also need DNS-TXT verification.
;;
;; The addon ships its own fns-packages (e.g. an org-admin UI) via the
;; fns-channel seam — append to :app/packages without restating the core
;; list, so they load ONLY when the addon is active:
;;   :app/packages {:extra-package-names ["tenancy-admin"]}
