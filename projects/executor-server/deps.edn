{:paths ["../../src"
         "../../resources"
         "../../bases/executor-runtime/src"
         "../../bases/executor-runtime/resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        ;; Web server
        http-kit/http-kit {:mvn/version "2.8.0"}
        metosin/reitit {:mvn/version "0.10.0"}
        metosin/malli {:mvn/version "0.20.0"}
        ;; Logging
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        ch.qos.logback/logback-classic {:mvn/version "1.5.31"}
        ;; PostgreSQL
        org.postgresql/postgresql {:mvn/version "42.7.10"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1093"}
        com.zaxxer/HikariCP {:mvn/version "7.0.2"}
        com.github.seancorfield/honeysql {:mvn/version "2.7.1368"}
        cheshire/cheshire {:mvn/version "6.1.0"}
        ;; System lifecycle
        integrant/integrant {:mvn/version "0.11.0"}
        aero/aero {:mvn/version "1.1.6"}}

 :aliases {:run {:main-opts ["-m" "graphden.executor-runtime.core"]}
