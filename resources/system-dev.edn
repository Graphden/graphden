;; Development system configuration
;; Uses local PostgreSQL with sensible defaults

{:db/schema {}

 :db/age
 {:jdbc-url "jdbc:postgresql://localhost:5434/graphden"
  :username "graphden"
  :password "graphden"
  :pool-size 5
  :schema #ig/ref :db/schema}

 :db/versioned
 {:base-storage #ig/ref :db/age}

 :exec/base-fns
 {:storage #ig/ref :db/versioned}

 :exec/fn-entities
 {:storage #ig/ref :db/versioned
  :fn-defs #ig/ref :app/fn-defs}

 :exec/context
 {:storage #ig/ref :db/versioned
  :max-depth 1000
  :timeout-ms 120000}

 :http/server
 {:context #ig/ref :exec/context
  :startup-fn-name :web-server-fn
  :port 8080}

 :app/fn-defs #var graphden.web.editor.core/fn-defs}
