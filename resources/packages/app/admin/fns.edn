{:namespace "app.admin"
 :fns
 [;; ---------------------------------------------------------------------
  ;; ORG REGISTRATION (§3.4 step 2) — POST /api/orgs. Platform-only: a
  ;; tenant POST is rejected by OrgScoped (`:org` is tenant-forbidden), so
  ;; only the operator (public org) registers orgs. The org `name` IS the
  ;; subdomain (identity resolver), so registration = creating the row.
  ;; ---------------------------------------------------------------------
  {:name :create-org
   :description "Register an :org by name (= slug = subdomain). Reads the tenancy addon's :org entity; throws if absent (addon inactive)."
   :args {:name {:type :text :description "Org slug — becomes the subdomain and the *current-org* value."}}
   :return-type :keyword-map
   :effects #{:db}}

  {:name :_org-create-form-data
   :parent :parse-form-body}

  {:name :_org-create-name
   :parent :get
   :args {:coll :_org-create-form-data :key {:value :name} :default {:value ""}}}

  {:name :_org-create-do
   :parent :create-org
   :args {:name :_org-create-name}}

  {:name :_org-create-id
   :parent :get
   :args {:coll :_org-create-do :key {:value :id} :default {:value ""}}}

  {:name :_org-create-id-text
   :parent :to-str
   :args {:value :_org-create-id}}

  {:name :_org-create-handler
   :description "Ring handler for POST /api/orgs — registers the org and returns its new id as text/html."
   :parent :html-ok-response
   :args {:body :_org-create-id-text}}

  {:name :create-org-route
   :description "POST /api/orgs — register an org from a form-encoded body (name). Auth-required; platform-only (tenant writes of :org are denied)."
   :parent :post
   :args {:path "/api/orgs" :handler :_org-create-handler}}

  ;; ---------------------------------------------------------------------
  ;; TOKEN MINTING (§3.4 #1) — POST /api/tokens {token user org}. Mints a
  ;; storage-backed auth token: hashes the bearer (SHA-256), stores only the
  ;; hash. Platform-only (`:token` is tenant-forbidden → a tenant POST is
  ;; denied by OrgScoped). This is what makes onboarding a row insert.
  ;; ---------------------------------------------------------------------
  {:name :create-token
   :description "Mint a storage-backed auth token — hashes the bearer (SHA-256) and stores {token-hash, user, org}. Reads the tenancy addon's :token entity; throws if absent (addon inactive)."
   :args {:token {:type :text :description "The raw bearer token — only its SHA-256 hash is stored."}
          :user {:type :text :description "Principal user id."}
          :org {:type :text :description "Principal org — becomes *current-org* for that bearer."}}
   :return-type :keyword-map
   :effects #{:db}}

  {:name :_token-create-form-data
   :parent :parse-form-body}

  {:name :_token-create-token
   :parent :get
   :args {:coll :_token-create-form-data :key {:value :token} :default {:value ""}}}

  {:name :_token-create-user
   :parent :get
   :args {:coll :_token-create-form-data :key {:value :user} :default {:value ""}}}

  {:name :_token-create-org
   :parent :get
   :args {:coll :_token-create-form-data :key {:value :org} :default {:value ""}}}

  {:name :_token-create-do
   :parent :create-token
   :args {:token :_token-create-token
          :user :_token-create-user
          :org :_token-create-org}}

  {:name :_token-create-id
   :parent :get
   :args {:coll :_token-create-do :key {:value :id} :default {:value ""}}}

  {:name :_token-create-id-text
   :parent :to-str
   :args {:value :_token-create-id}}

  {:name :_token-create-handler
   :description "Ring handler for POST /api/tokens — mints the token and returns its new id as text/html."
   :parent :html-ok-response
   :args {:body :_token-create-id-text}}

  {:name :create-token-route
   :description "POST /api/tokens — mint a storage-backed auth token from a form-encoded body (token/user/org). Auth-required; platform-only (tenant writes of :token are denied)."
   :parent :post
   :args {:path "/api/tokens" :handler :_token-create-handler}}

  ;; ---------------------------------------------------------------------
  ;; CUSTOM DOMAIN REGISTRATION (§3.4 #2) — POST /api/domains {hostname org}.
  ;; Registers an UNVERIFIED custom domain; the operator flips :verified?
  ;; (generic CRUD update) after the graphden-verify=<org> DNS-TXT check.
  ;; Platform-only (`:domain` is tenant-forbidden → tenant POST denied).
  ;; ---------------------------------------------------------------------
  {:name :create-domain
   :description "Register a custom domain (UNVERIFIED) → maps hostname to org once verified. Reads the tenancy addon's :domain entity; throws if absent (addon inactive)."
   :args {:hostname {:type :text :description "Full custom host, e.g. app.acme.com."}
          :org {:type :text :description "Org the host serves once verified."}}
   :return-type :keyword-map
   :effects #{:db}}

  {:name :_domain-create-form-data
   :parent :parse-form-body}

  {:name :_domain-create-hostname
   :parent :get
   :args {:coll :_domain-create-form-data :key {:value :hostname} :default {:value ""}}}

  {:name :_domain-create-org
   :parent :get
   :args {:coll :_domain-create-form-data :key {:value :org} :default {:value ""}}}

  {:name :_domain-create-do
   :parent :create-domain
   :args {:hostname :_domain-create-hostname
          :org :_domain-create-org}}

  {:name :_domain-create-id
   :parent :get
   :args {:coll :_domain-create-do :key {:value :id} :default {:value ""}}}

  {:name :_domain-create-id-text
   :parent :to-str
   :args {:value :_domain-create-id}}

  {:name :_domain-create-handler
   :description "Ring handler for POST /api/domains — registers the (unverified) domain and returns its new id as text/html."
   :parent :html-ok-response
   :args {:body :_domain-create-id-text}}

  {:name :create-domain-route
   :description "POST /api/domains — register a custom domain from a form-encoded body (hostname/org). Auth-required; platform-only (tenant writes of :domain are denied)."
   :parent :post
   :args {:path "/api/domains" :handler :_domain-create-handler}}

  ;; ---------------------------------------------------------------------
  ;; SET ORG HANDLER (§3.4 step 4a) — POST /api/orgs/handler {name fn-id}.
  ;; Points an org at its app handler fn (the app-router then serves that
  ;; org's subdomain via it). Platform-only (`:org` is tenant-forbidden);
  ;; self-serve (a tenant setting its OWN handler via a validated seam) is
  ;; step 4b on top of this mutation.
  ;; ---------------------------------------------------------------------
  {:name :set-org-handler
   :description "Set an :org's :handler-fn-id (the app-router executes it for that org's subdomain). Reads the tenancy addon's :org entity; throws if absent."
   :args {:name {:type :text :description "Org slug."}
          :handler-fn-id {:type :text :description "Fn-id (UUID) of the org's app handler."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :_org-handler-form-data
   :parent :parse-form-body}

  {:name :_org-handler-name
   :parent :get
   :args {:coll :_org-handler-form-data :key {:value :name} :default {:value ""}}}

  {:name :_org-handler-fnid
   :parent :get
   :args {:coll :_org-handler-form-data :key {:value :handler-fn-id} :default {:value ""}}}

  {:name :_org-handler-do
   :parent :set-org-handler
   :args {:name :_org-handler-name :handler-fn-id :_org-handler-fnid}}

  {:name :_org-handler-result-text
   :parent :to-str
   :args {:value :_org-handler-do}}

  {:name :_org-handler-handler
   :description "Ring handler for POST /api/orgs/handler — sets the org's app handler, returns the updated row as text/html."
   :parent :html-ok-response
   :args {:body :_org-handler-result-text}}

  {:name :set-org-handler-route
   :description "POST /api/orgs/handler — point an org at its app handler (name, handler-fn-id). Auth-required; platform-only."
   :parent :post
   :args {:path "/api/orgs/handler" :handler :_org-handler-handler}}

  ;; ---------------------------------------------------------------------
  ;; SELF-SERVE DEPLOY (§3.4 step 4b) — POST /api/my-app/handler {fn-id}.
  ;; A tenant points its OWN org at its OWN fn. The `:invoke-set-org-handler`
  ;; base-fn calls the injectable `:set-org-handler` seam (tenancy addon),
  ;; which validates ownership + does the controlled `:org` update. No seam
  ;; (single-tenant) → nil. Auth-required; the seam 403s a bad/cross-org fn.
  ;; ---------------------------------------------------------------------
  {:name :invoke-set-org-handler
   :description "Invoke the self-serve deploy seam for the current tenant: set its org's app handler to fn-id. Returns the updated :org row, or nil when the addon isn't active."
   :args {:fn-id {:type :text :description "Fn-id (UUID) of the tenant's own app handler."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :_my-app-handler-form-data
   :parent :parse-form-body}

  {:name :_my-app-handler-fnid
   :parent :get
   :args {:coll :_my-app-handler-form-data :key {:value :fn-id} :default {:value ""}}}

  {:name :_my-app-handler-do
   :parent :invoke-set-org-handler
   :args {:fn-id :_my-app-handler-fnid}}

  {:name :_my-app-handler-text
   :parent :to-str
   :args {:value :_my-app-handler-do}}

  {:name :_my-app-handler-handler
   :description "Ring handler for POST /api/my-app/handler — self-serve set the tenant's app handler."
   :parent :html-ok-response
   :args {:body :_my-app-handler-text}}

  {:name :set-my-app-handler-route
   :description "POST /api/my-app/handler — a tenant sets its OWN org's app handler (fn-id). Auth-required; the seam validates ownership."
   :parent :post
   :args {:path "/api/my-app/handler" :handler :_my-app-handler-handler}}

  ;; ---------------------------------------------------------------------
  ;; SELF-SERVE DNS-VERIFY (§3.4 #2) — POST /api/my-app/verify-domain {hostname}.
  ;; A tenant proves it owns a custom domain (graphden-verify=<org> DNS-TXT)
  ;; registered to its org, flipping :verified? so the app-router serves it.
  ;; The `:invoke-verify-domain` base-fn calls the injectable `:verify-domain`
  ;; seam, which validates org-ownership + runs the privileged DNS lookup. No
  ;; seam (single-tenant) → nil. Auth-required; the seam 403s a foreign host.
  ;; ---------------------------------------------------------------------
  {:name :invoke-verify-domain
   :description "Invoke the self-serve DNS-verify seam: prove the current tenant owns hostname and mark its :domain verified. Returns the updated row, or nil when the addon isn't active."
   :args {:hostname {:type :text :description "The tenant's custom host to verify, e.g. app.acme.com."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :_verify-domain-form-data
   :parent :parse-form-body}

  {:name :_verify-domain-hostname
   :parent :get
   :args {:coll :_verify-domain-form-data :key {:value :hostname} :default {:value ""}}}

  {:name :_verify-domain-do
   :parent :invoke-verify-domain
   :args {:hostname :_verify-domain-hostname}}

  {:name :_verify-domain-text
   :parent :to-str
   :args {:value :_verify-domain-do}}

  {:name :_verify-domain-handler
   :description "Ring handler for POST /api/my-app/verify-domain — self-serve verify the tenant's custom domain."
   :parent :html-ok-response
   :args {:body :_verify-domain-text}}

  {:name :verify-my-domain-route
   :description "POST /api/my-app/verify-domain — a tenant proves ownership of its OWN custom domain (hostname). Auth-required; the seam validates org-ownership + DNS."
   :parent :post
   :args {:path "/api/my-app/verify-domain" :handler :_verify-domain-handler}}

  ;; --- shared 401 body for a failed credential attempt (login + signup) ----
  {:name :_auth-401-body
   :parent :const
   :args {:value "Invalid username or password."}}

  {:name :_auth-401
   :parent :text-unauthorized-response
   :args {:body :_auth-401-body}}

  ;; ---------------------------------------------------------------------
  ;; LOGIN (§4.1) — POST /api/login {username password}. UNAUTHENTICATED (you
  ;; log in to obtain a token). The `:invoke-login` base-fn calls the
  ;; `:user-ops` seam, which verifies credentials and mints a session `:token`
  ;; (the storage-token-provider resolves it thereafter). 200 + the token, or
  ;; 401 on bad credentials.
  ;; ---------------------------------------------------------------------
  {:name :invoke-login
   :description "Verify credentials via the addon's user-ops seam and mint a session token. Returns {:token :user :org} on success, nil on bad credentials / no addon."
   :args {:username {:type :text :description "Login id."}
          :password {:type :text :description "Raw password."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :_login-form-data
   :parent :parse-form-body}

  {:name :_login-username
   :parent :get
   :args {:coll :_login-form-data :key {:value :username} :default {:value ""}}}

  {:name :_login-password
   :parent :get
   :args {:coll :_login-form-data :key {:value :password} :default {:value ""}}}

  {:name :_login-do
   :parent :invoke-login
   :args {:username :_login-username
          :password :_login-password}}

  {:name :_login-token
   :parent :get
   :args {:coll :_login-do :key {:value :token} :default {:value ""}}}

  {:name :_login-token-text
   :parent :to-str
   :args {:value :_login-token}}

  {:name :_login-token-blank?
   :parent :blank?
   :args {:string :_login-token-text}}

  {:name :_login-200
   :parent :html-ok-response
   :args {:body :_login-token-text}}

  {:name :_login-handler
   :description "Ring handler for POST /api/login — 200 + the minted session token, or 401 on bad credentials (blank token)."
   :parent :if
   :args {:test :_login-token-blank? :then :_auth-401 :else :_login-200}}

  ;; UNAUTHENTICATED — `:post-route` (no auth-required middleware, unlike
  ;; `:post`): login is the entry point to obtaining auth, so it must be
  ;; reachable without a token. The request-scope runs it as public; login!
  ;; reads `:user` + mints the session token in the platform context.
  {:name :login-route
   :description "POST /api/login — exchange username/password for a session token. UNAUTHENTICATED (the entry point to obtaining auth)."
   :parent :post-route
   :args {:path "/api/login" :handler :_login-handler}}

  ;; ---------------------------------------------------------------------
  ;; SIGNUP (§4.1) — POST /api/signup {username password org}. UNAUTHENTICATED
  ;; self-serve registration: creates a BRAND-NEW org + user and auto-logs-in
  ;; (returns the session token). The seam refuses an existing org, so a new
  ;; account can never join another tenant. Empty body on failure (taken /
  ;; blank), exactly like login.
  ;; ---------------------------------------------------------------------
  {:name :invoke-signup
   :description "Self-serve signup via the user-ops seam: create a new org + user, auto-login. Returns {:token :user :org}, or nil on failure / rate-limit / no addon."
   :args {:username {:type :text :description "Desired login id (must be free)."}
          :password {:type :text :description "Raw password — only its bcrypt hash is stored."}
          :org {:type :text :description "Desired org slug (must be free — signup creates it)."}
          :request {:type :ring-request-shape :description "The Ring request — its client IP feeds the per-IP signup rate limiter."}}
   :return-type :nullable-keyword-map
   :effects #{:db}}

  {:name :_signup-form-data
   :parent :parse-form-body}

  {:name :_signup-username
   :parent :get
   :args {:coll :_signup-form-data :key {:value :username} :default {:value ""}}}

  {:name :_signup-password
   :parent :get
   :args {:coll :_signup-form-data :key {:value :password} :default {:value ""}}}

  {:name :_signup-org
   :parent :get
   :args {:coll :_signup-form-data :key {:value :org} :default {:value ""}}}

  {:name :_signup-do
   :parent :invoke-signup
   :args {:username :_signup-username
          :password :_signup-password
          :org :_signup-org}}

  {:name :_signup-token
   :parent :get
   :args {:coll :_signup-do :key {:value :token} :default {:value ""}}}

  {:name :_signup-token-text
   :parent :to-str
   :args {:value :_signup-token}}

  {:name :_signup-token-blank?
   :parent :blank?
   :args {:string :_signup-token-text}}

  {:name :_signup-200
   :parent :html-ok-response
   :args {:body :_signup-token-text}}

  {:name :_signup-token-result
   :description "200 + the new session token, or 401 when signup failed (taken / blank)."
   :parent :if
   :args {:test :_signup-token-blank? :then :_auth-401 :else :_signup-200}}

  ;; The rate limiter returns a {:rate-limited true} sentinel for an over-quota
  ;; IP → 429 (distinct from a credential/taken failure → 401).
  {:name :_signup-rate-limited?
   :parent :get
   :args {:coll :_signup-do :key {:value :rate-limited} :default {:value false}}}

  {:name :_signup-429-body
   :parent :const
   :args {:value "Too many signup attempts — please try again later."}}

  {:name :_signup-429
   :parent :text-too-many-requests-response
   :args {:body :_signup-429-body}}

  {:name :_signup-handler
   :description "Ring handler for POST /api/signup — 429 when rate-limited, else 200 + the new session token, or 401 when signup failed (taken / blank)."
   :parent :if
   :args {:test :_signup-rate-limited? :then :_signup-429 :else :_signup-token-result}}

  {:name :signup-route
   :description "POST /api/signup — self-serve register a new org + user and get a session token. UNAUTHENTICATED."
   :parent :post-route
   :args {:path "/api/signup" :handler :_signup-handler}}

  ;; ---------------------------------------------------------------------
  ;; LOGOUT (§4.1) — POST /api/logout. Deletes the caller's session `:token`
  ;; server-side (the seam reads the bearer from `:request`), so a leaked
  ;; token can't be replayed after sign-out. Auth-required (you present the
  ;; token to invalidate it). `:request` stays a free arg → bound to the Ring
  ;; request at the handler call.
  ;; ---------------------------------------------------------------------
  {:name :invoke-logout
   :description "Invoke the addon's logout seam — delete the caller's session token (bearer read from :request). Returns true iff a row was deleted, or nil when the addon isn't active."
   :args {:request {:type :ring-request-shape :description "The Ring request — its bearer identifies the session to invalidate."}}
   :return-type [:union :null :bool]
   :effects #{:db}}

  {:name :_logout-do
   :parent :invoke-logout}

  {:name :_logout-text
   :parent :to-str
   :args {:value :_logout-do}}

  {:name :_logout-handler
   :description "Ring handler for POST /api/logout — invalidates the caller's session token."
   :parent :html-ok-response
   :args {:body :_logout-text}}

  {:name :logout-route
   :description "POST /api/logout — delete the caller's session token. Auth-required (the bearer to invalidate is the request's own)."
   :parent :post
   :args {:path "/api/logout" :handler :_logout-handler}}

  ;; ---------------------------------------------------------------------
  ;; LOGOUT-ALL (§4.1) — POST /api/logout-all. Sign out everywhere: delete
  ;; EVERY session token for the current user (the seam reads
  ;; *current-principal*). Auth-required.
  ;; ---------------------------------------------------------------------
  {:name :invoke-logout-all
   :description "Invoke the addon's logout-all seam — delete every session token for the current user. Returns the count deleted, or nil when the addon isn't active."
   :args {}
   :return-type [:union :null :int]
   :effects #{:db}}

  {:name :_logout-all-do
   :parent :invoke-logout-all}

  {:name :_logout-all-text
   :parent :to-str
   :args {:value :_logout-all-do}}

  {:name :_logout-all-handler
   :description "Ring handler for POST /api/logout-all — invalidates every session of the current user."
   :parent :html-ok-response
   :args {:body :_logout-all-text}}

  {:name :logout-all-route
   :description "POST /api/logout-all — sign out everywhere (delete all the current user's session tokens). Auth-required."
   :parent :post
   :args {:path "/api/logout-all" :handler :_logout-all-handler}}]}
