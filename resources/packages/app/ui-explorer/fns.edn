       {:name :_explorer-label-fn :parent :hiccup :args {:tag "span" :attrs {:value {:class "kind-label"}} :children ["fn"]}}
       {:name :_explorer-attrs-fn :parent :_explorer-toggle-attrs :args {:vals ["button" "kind-toggle" "fn" :_explorer-pressed-fn "Only functions" false]}}
       {:name :_explorer-button-fn :parent :hiccup :args {:tag "button" :attrs :_explorer-attrs-fn :children [:_explorer-glyph-fn :_explorer-label-fn]}}
       {:name :_explorer-pressed-types :parent :if :args {:test :_explorer-selected-types :then "true" :else "false"}}
       {:name :_explorer-glyph-types :parent :hiccup :args {:tag "span" :attrs {:value {:class "kind-glyph" :aria-hidden "true"}} :children ["T"]}}
       {:name :_explorer-label-types :parent :hiccup :args {:tag "span" :attrs {:value {:class "kind-label"}} :children ["types"]}}
       {:name :_explorer-attrs-types :parent :_explorer-toggle-attrs :args {:vals ["button" "kind-toggle" "types" :_explorer-pressed-types "Only types" false]}}
       {:name :_explorer-button-types :parent :hiccup :args {:tag "button" :attrs :_explorer-attrs-types :children [:_explorer-glyph-types :_explorer-label-types]}}
       {:name :_explorer-pressed-secrets :parent :if :args {:test :_explorer-selected-secrets :then "true" :else "false"}}
