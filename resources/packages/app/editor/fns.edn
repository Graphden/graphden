;; Graph Editor fn-defs
;; CSS / JS bundles load through `:concat-resources-overridable` (the
;; override tier over the classpath baseline). No base-fns in this package.


{:namespace "app.editor"
 :description "Graph-editor application — HTML/CSS/JS assembly via fn-defs (no base-fns), plus the routes for editor UI + API endpoints."
 :fns
 [;; =============================================================================
  ;; CSS + JS asset loading (fn-def compositions)
  ;; =============================================================================

  ;; Path lists as `:const`s so the serve chain AND the Assets panel's
  ;; known-asset allowlist share one source of truth (no third copy of
  ;; the CSS path literal).
  {:name :_editor-css-paths
   :parent :const
   :args {:value ["packages/app/editor/editor-styles.css"]}}

  {:name :_components-css-paths
   :parent :const
   :args {:value ["packages/app/editor/components.css"]}}

  ;; A ONE-ITEM bundle, not `:parent :read-resource-overridable` with a
  ;; `:path` pin: the overridable seam re-exposes callable `:path` sites,
  ;; and a call-env `:path` (the ROUTE's own "/assets/…" arg) outranks a
  ;; grandparent pin at run time — the per-item HOF bind is the one
  ;; call-shape that pins reliably (same as the JS bundles).
  {:name :styles
   :description "Editor stylesheet — read from `packages/app/editor/editor-styles.css` through the override tier. Served by `:_editor-css-handler` at `/assets/editor.css?v=<hash>` with a 1-year `immutable` `Cache-Control` so the browser fetches the body exactly once per deploy."
   :parent :concat-resources-overridable
   :return-type :text
   :args {:paths :_editor-css-paths}}

  ;; Editor JS modules — loaded from resources and concatenated in order.
  ;; Order matters: tooltips/icons/drag must come BEFORE overlays (which
  ;; calls into them); ui/render come after overlays (they call
  ;; into the overlay management API).
  {:name :_editor-script-paths
   :parent :const
   :args {:value ["packages/app/editor/editor-state.js"
                  ;; Accessibility primitives. Early because the graph
                  ;; tween below asks it whether it may animate at all.
                  "packages/app/editor/editor-a11y.js"
                  ;; The graph itself: two maps and a tween. No library.
                  "packages/app/editor/editor-graph-model.js"
                  ;; Viewport (pan / zoom / gestures) — owns the two numbers the
                  ;; graph layer's transform is built from. `gv` reads it.
                  "packages/app/editor/editor-viewport.js"
                  ;; `gv` — the graph-view seam every module downstream reads.
                  "packages/app/editor/editor-graph-view.js"
                  "packages/web/runtime/graphden-popover.js"
                  ;; Keyboard: the shortcut registry + Space leader. After
                  ;; graphden-popover.js (it uses the focus primitives),
                  ;; before the modules that register their own bindings.
                  "packages/app/editor/editor-shortcuts.js"
                  "packages/app/editor/editor-busy.js"
                  "packages/app/editor/editor-prefs.js"
                  ;; Feedback ("Report a problem") — early so its uncaught-
                  ;; error ring buffer sees everything after boot; the shell
                  ;; menu (editor-auth.js) and the Errors panel call its
                  ;; window.openFeedbackForm at click time.
                  "packages/app/editor/editor-feedback.js"
                  "packages/app/editor/editor-auth.js"
                  "packages/app/editor/editor-org-switcher.js"
                  "packages/app/editor/editor-branches.js"
                  "packages/app/editor/editor-diff-render.js"
                  "packages/app/editor/editor-branch-diff.js"
                  "packages/app/editor/editor-diff-mode.js"
                  "packages/app/editor/editor-create.js"
                  ;; Per-kind field builders + prefill parsers — loaded before
                  ;; editor-create-type.js so the popover shell can call
                  ;; buildKindFields at open time.
                  "packages/app/editor/editor-create-type-fields.js"
                  "packages/app/editor/editor-create-type.js"
                  "packages/app/editor/editor-data.js"
                  "packages/app/editor/editor-layout.js"
                  ;; SVG edge layer — needs `taxiBendX` from editor-layout.js.
                  "packages/app/editor/editor-edges-svg.js"
                  "packages/app/editor/editor-literal-types.js"
                  ;; Presentation half of the type helpers.
                  "packages/app/editor/editor-type-format.js"
                  ;; EDN reader/printer — graphden-forms.js's `edn`
                  ;; field-kind calls into it.
                  "packages/web/runtime/graphden-edn.js"
                  "packages/web/runtime/graphden-forms.js"
                  ;; CodeMirror upgrade for code textareas — before
                  ;; editor-value-form.js (which calls gdCode.enhanceWithin).
                  "packages/app/editor/editor-code.js"
                  "packages/app/editor/editor-value-form.js"
                  "packages/app/editor/editor-widget-rating.js"
                  "packages/app/editor/editor-tooltips.js"
                  "packages/app/editor/editor-icons.js"
                  "packages/web/runtime/graphden-runtime.js"
                  "packages/web/runtime/graphden-actions-builtin.js"
                  "packages/app/editor/editor-row-actions.js"
                  "packages/app/editor/editor-drag.js"
                  "packages/app/editor/editor-fn-picker.js"
                  "packages/app/editor/editor-namespace-picker.js"
                  "packages/app/editor/editor-edit-validation.js"
                  "packages/app/editor/editor-edit-modes.js"
                  ;; fn-level + type-level edit modes (the skeleton lives
                  ;; in editor-edit-modes.js).
                  "packages/app/editor/editor-edit-modes-fn.js"
                  "packages/app/editor/editor-edit-modes-type.js"
                  "packages/app/editor/editor-edit-reparent.js"
                  "packages/app/editor/editor-execute-result.js"
                  ;; Canvas path-highlight for traced runs (Debug P2) —
                  ;; loaded before the execute modules that call its
                  ;; window-exported entry points.
                  "packages/app/editor/editor-path-view.js"
                  ;; Step-through call-tree panel of a stored trace —
                  ;; before execute-history + editor-debug, which call
                  ;; its window.openTraceView.
                  "packages/app/editor/editor-trace-view.js"
                  "packages/app/editor/editor-execute-history.js"
                  "packages/app/editor/editor-execute.js"
                  "packages/app/editor/editor-fn-versions.js"
                  "packages/app/editor/editor-fn-usages.js"
                  "packages/app/editor/editor-fn-peek.js"
                  "packages/app/editor/editor-service-popover.js"
                  "packages/app/editor/editor-mismatch-explainer.js"
                  "packages/app/editor/editor-effect-explainer.js"
                  ;; Structural type-interpretation half of the inline
                  ;; `▸/▾` panel.
                  "packages/app/editor/editor-type-expand-render.js"
                  "packages/app/editor/editor-overlay-type-expand.js"
                  "packages/app/editor/editor-provenance-popover.js"
                  "packages/app/editor/editor-overlay-arg.js"
                  "packages/app/editor/editor-overlay-edge-label.js"
                  "packages/app/editor/editor-overlay-fn-rows.js"
                  "packages/app/editor/editor-overlay-fn.js"
                  "packages/app/editor/editor-overlay-strips.js"
                  "packages/app/editor/editor-overlay-manager.js"
                  ;; Keyboard navigation over the node overlays —
                  ;; delegated, so it survives every re-render.
                  "packages/app/editor/editor-canvas-keys.js"
                  "packages/app/editor/editor-secrets.js"
                  "packages/app/editor/editor-grants-admin.js"
                  "packages/app/editor/editor-users-admin.js"
                  "packages/app/editor/editor-roles-admin.js"
                  "packages/app/editor/editor-executors-admin.js"
                  "packages/app/editor/editor-orgs-admin.js"
                  "packages/app/editor/editor-platform-access.js"
                  "packages/app/editor/editor-quota.js"
                  "packages/app/editor/editor-stats.js"
                  "packages/app/editor/editor-errors.js"
                  "packages/app/editor/editor-type-errors.js"
                  ;; Tests: status cache + Operate section shell + the
                  ;; isTestFn predicate editor-sidebar.js's lens reads.
                  "packages/app/editor/editor-tests.js"
                  ;; Debug: «catch next request» Operate section
                  ;; (buildDebugSection read by editor-sidebar.js).
                  "packages/app/editor/editor-debug.js"
                  "packages/app/editor/editor-apps.js"
                  "packages/app/editor/editor-assets.js"
                  "packages/app/editor/editor-sidebar.js"
                  ;; Keyboard navigation over the rows editor-sidebar.js
                  ;; builds — delegated, so it survives the rebuilds.
                  "packages/app/editor/editor-tree-keys.js"
                  ;; Diagnostics drawer (Build) — open/collapse lifecycle +
                  ;; badge counts for the errors/type-errors/tests/debug
                  ;; sections editor-sidebar.js mounts into it.
                  "packages/app/editor/editor-diagnostics.js"
                  "packages/app/editor/editor-expansion.js"
                  "packages/app/editor/editor-ui.js"
                  "packages/app/editor/editor-render.js"
                  ;; Account section on the Settings surface (the merged /account
                  ;; page) — loads before shell so gdRenderSettings can call
                  ;; its render hook.
                  "packages/app/editor/editor-account.js"
                  ;; Redesign shell — surface switching + deep-link hashes.
                  ;; Loads before main so window.gdShellSurface / the hash
                  ;; router exist for the boot navigation.
                  "packages/app/editor/editor-shell.js"
                  ;; Interactive tutorial overlay — before main so the boot
                  ;; hook (maybeStartTutorial) exists for main's
                  ;; DOMContentLoaded, and in the same lexical scope as
                  ;; graphData/lookups (its checks read them bare).
                  "packages/app/editor/editor-tour-checks.js"
                  "packages/app/editor/editor-tour-cleanup.js"
                  "packages/app/editor/editor-tour.js"
                  "packages/app/editor/editor-tour-picker.js"
                  "packages/app/editor/editor-main.js"]}}

  ;; Raw concatenation of every editor module — still contains the
  ;; literal `__BUILD_HASH__` placeholder from `editor-state.js`.
  {:name :_script-raw
   :description "Concatenated editor JS bundle, BEFORE the build-hash substitution."
   :parent :concat-resources-overridable
   :return-type :text
   :args {:paths :_editor-script-paths}}

  ;; The placeholder is replaced with the FRONTEND-section build hash
  ;; (see `:build-hash-frontend-short` in core.system). The console
  ;; marker thus reflects exactly which JS/CSS the browser is running
  ;; — and matches the `frontend` key returned by `GET /version`.
  {:name :script
   :description "Bundled editor JS with `__BUILD_HASH__` substituted by `:build-hash-frontend-short`. The in-page console marker mirrors the `frontend` value returned by `GET /version`, so the browser bundle's identity is never out of step with what the server reports. `:str-replace` is nil-flow-through; `:_script-raw` is loaded from a baked-in JAR resource and is never nil, but the declared return follows the parent's union to keep the contract explicit."
   :parent :str-replace
   :return-type :nullable-text
   :args {:string   {:ref :_script-raw                :type :text}
          :match    "__BUILD_HASH__"
          :replacement :frontend-hash-effective}}

  ;; =============================================================================
  ;; FN-DEFS: Editor UI structure
  ;; =============================================================================

  ;; Editor body — HTML structure as hiccup constant
  {:name :body
   :description "Hiccup constant for the editor's `<body>` content — sidebar (filter input + entity list), graph container, and zoom/home/reset nav controls."
   :parent :const
   :args {:value
          ;; Semantic landmarks \u2014 <aside> for the namespace tree,
          ;; <main> for the graph canvas. axe-core's `region` rule
          ;; requires every page element be inside a landmark; without
          ;; this, screen-readers see flat content with no structure.
          [:div {:id "app" :class "gd-redesign"}
           ;; Skip link (WCAG 2.4.1) — first focusable thing on the page.
           ;; The Explorer tree sits before the graph in the DOM and can hold
           ;; hundreds of rows, so a keyboard user reaching the canvas would
           ;; otherwise tab through all of them. Visually hidden until
           ;; focused (see `.gd-skip-link` in editor-styles.css).
           [:a {:href "#graph-container" :class "gd-skip-link"} "Skip to graph"]
           ;; TOP BAR (redesign 2026-08-15 — the rail is retired). The editor
           ;; vs everything-else split is GLOBAL now: you live on Build; the
           ;; management screens (Settings / Organization / Platform) are rare
           ;; destinations reached through the account chip's menu, not
           ;; permanent navigation. The bar keeps only what must stay visible
           ;; from ANY surface: the brand (→ back to Build), the org switcher
           ;; (whose graph am I looking at) and the account chip. The BUILD
           ;; context (workspace / branch / packages) lives in the Explorer
           ;; head — it collapses away with the Explorer.
           [:header {:id "gd-ctxbar"}
            [:button {:type "button" :id "gd-brand-home" :class "gd-brand-home"
                      :title "Back to the editor"
                      :aria-label "Back to the editor"
                      :onclick "gdShellGoHome()"}
             [:svg {:viewBox "0 0 32 32" :fill "none" :width "20" :height "20" :aria-hidden "true"}
              [:g {:stroke "currentColor" :stroke-width "3" :stroke-linecap "round"}
               [:line {:x1 "9" :y1 "6" :x2 "25" :y2 "26"}]
               [:line {:x1 "17" :y1 "16" :x2 "8" :y2 "26"}]]
              [:g {:fill "currentColor"}
               [:circle {:cx "9" :cy "6" :r "3"}]
               [:circle {:cx "25" :cy "26" :r "3"}]
               [:circle {:cx "8" :cy "26" :r "3"}]]]
             [:b "Graphden"]]
            ;; (No global search chip: it was a dead affordance — never wired to
            ;; anything. The live function search is the Explorer filter, which
            ;; hits ?scope=search. One search, where the functions are.)
            [:span {:class "gd-bar-spacer"}]
            [:div {:id "org-mount"}]
            [:div {:id "auth-mount"}]]
           [:div {:id "main-container"}
            ;; Side menu \u2014 semantic <aside> + ARIA label since the
            ;; visible <h2>"Graphden" doubles as the app title rather
            ;; than the sidebar's heading.
            [:aside {:id "side-menu" :aria-label "Function browser"}
             ;; Redesign 2026-08: the brand and the org/auth mounts live in the
             ;; top bar (#gd-ctxbar); the explorer keeps a slim title plus the
             ;; Build-context row below it.
             [:div {:class "gd-exp-head"}
              [:span {:class "gd-exp-title"} "Explorer"]
              ;; Collapse the Explorer — the toggle lives WITH the panel it
              ;; controls. editor-prefs.js/applyCollapsed keeps the chevron (‹)
              ;; + title in sync; the collapsed-state EXPAND affordance is the
              ;; left-edge tab (.sidebar-expand-floating), Build-only.
              [:button {:id "sidebar-collapse-btn" :class "gd-exp-collapse"
                        :type "button" :title "Collapse sidebar"
                        :aria-label "Collapse sidebar"
                        :onclick "gdToggleSidebar()"}
               [:svg {:viewBox "0 0 24 24" :width "14" :height "14" :fill "none"
                      :stroke "currentColor" :stroke-width "2.4"
                      :stroke-linecap "round" :stroke-linejoin "round" :aria-hidden "true"}
                [:polyline {:points "15 18 9 12 15 6"}]]]]
             ;; BUILD CONTEXT — what you author IN: workspace scope, branch,
             ;; packages. Lives with the Explorer (one collapse hides the whole
             ;; browsing/context chrome, leaving the canvas nearly bare); the
             ;; chips keep their ids — the owning modules (editor-shell /
             ;; editor-branches) wire them by id, unchanged. When the Explorer
             ;; is collapsed on a NON-default branch, the left-edge expand tab
             ;; grows a branch badge so the write-context never becomes
             ;; invisible (editor-prefs.js/gdSyncEdgeBranchBadge).
             [:div {:id "gd-exp-ctx"}
              [:button {:type "button" :id "gd-ws-chip" :class "gd-ctx-chip"
                        :title "Switch workspace scope"}
               [:span {:class "gd-ctx-dot"}]
               [:span {:class "gd-ctx-k"} "workspace"]
               [:b "All functions"]]
              [:div {:id "branch-mount"}]
              ;; Packages (dependencies) — a BUILD-surface act (add building
              ;; blocks to your project). Hidden until JS confirms the optional
              ;; registry package is present (window.API probe).
              [:button {:type "button" :id "gd-pkg-chip" :class "gd-ctx-chip" :hidden "hidden"
                        :title "Packages — browse & install"}
               [:span {:class "gd-ctx-k"} "packages"]
               [:b "Browse"]]]
             [:div {:id "search-bar" :role "search"}
              [:label {:for "search-input" :class "visually-hidden"} "Filter functions"]
              [:input {:id "search-input" :type "text" :placeholder "Filter..."
                       :aria-label "Filter functions"
                       :oninput "onSearchInput(this.value)"}]
              [:button {:id "search-clear" :onclick "clearSearch()" :aria-label "Clear filter"} "\u00D7"]
              ;; The LENS — kind chips with FOCUS semantics ("show only this
              ;; kind"), replacing the old hide-semantics eyes. "All" (empty
              ;; lens) shows everything with per-row kind markers; clicking a
              ;; kind chip focuses the tree on that kind (structure/expansion
              ;; kept, client-side filter, no reload); a further chip adds to
              ;; the selection; re-clicking (or "All") returns. State persists
              ;; in localStorage; syncKindFilterBar (editor-sidebar.js) syncs
              ;; aria-pressed, fills the services/apps counts and hides the
              ;; apps chip when the deployment has no app routing. The
              ;; trailing `+` opens the New-secret form (authed only).
              [:div {:id "kind-filters" :role "group"
                     :aria-label "Focus the tree on an entity kind"}
               [:button {:type "button" :class "kind-toggle kind-all" :data-kind "all"
                         :aria-pressed "true" :onclick "toggleKind('all')"
                         :title "Show everything"}
                [:span {:class "kind-glyph" :aria-hidden "true"} "◍"]
                [:span {:class "kind-label"} "all"]]
               [:button {:type "button" :class "kind-toggle" :data-kind "fn"
                         :aria-pressed "false" :onclick "toggleKind('fn')"
                         :title "Only functions"}
                [:span {:class "kind-glyph" :aria-hidden "true"} "λ"]
                [:span {:class "kind-label"} "fn"]]
               [:button {:type "button" :class "kind-toggle" :data-kind "types"
                         :aria-pressed "false" :onclick "toggleKind('types')"
                         :title "Only types"}
                [:span {:class "kind-glyph" :aria-hidden "true"} "T"]
                [:span {:class "kind-label"} "types"]]
               [:button {:type "button" :class "kind-toggle" :data-kind "secrets"
                         :aria-pressed "false" :onclick "toggleKind('secrets')"
                         :title "Only secrets"}
                [:span {:class "kind-glyph" :aria-hidden "true"} "🔒"]
                [:span {:class "kind-label"} "secrets"]]
               [:button {:type "button" :class "kind-toggle" :data-kind "services"
                         :aria-pressed "false" :onclick "toggleKind('services')"
                         :title "Only services (daemons kept running)"}
                [:span {:class "kind-glyph" :aria-hidden "true"} "⚙"]
                [:span {:class "kind-label"} "services"]
                [:span {:class "kind-count" :aria-hidden "true"}]]
               [:button {:type "button" :class "kind-toggle" :data-kind "apps"
                         :aria-pressed "false" :onclick "toggleKind('apps')"
                         :hidden "hidden"
                         :title "Only apps (fns served at a public host)"}
                [:span {:class "kind-glyph" :aria-hidden "true"} "▣"]
                [:span {:class "kind-label"} "apps"]
                [:span {:class "kind-count" :aria-hidden "true"}]]
               [:button {:type "button" :class "kind-toggle" :data-kind "tests"
                         :aria-pressed "false" :onclick "toggleKind('tests')"
                         :title "Only tests (fns in a `tests` namespace)"}
                [:span {:class "kind-glyph" :aria-hidden "true"} "✓"]
                [:span {:class "kind-label"} "tests"]
                [:span {:class "kind-count" :aria-hidden "true"}]]
               ;; DETAIL toggle, not a lens: marks rows instead of
               ;; filtering them (fns whose execution carries effects
               ;; get a small `fx`). Individually toggleable so the
               ;; tree only carries the detail when asked for; sits in
               ;; the same chip row but its own aria semantics say
               ;; "show", not "focus". State: graphden.treeDetails.
               [:button {:type "button"
                         :class "kind-toggle tree-detail-toggle"
                         :data-detail "fx" :aria-pressed "false"
                         :onclick "toggleTreeDetail('fx')"
                         :title "Mark fns whose execution has effects (io, time, …)"}
                [:span {:class "kind-glyph" :aria-hidden "true"} "fx"]
                [:span {:class "kind-label"} "marks"]]]]
             ;; Create-a-secret action — NOT a filter, so it sits OUTSIDE the
             ;; kind-filters role-group (and the search bar). Contextual:
             ;; syncKindFilterBar reveals it only for an authed user with the
             ;; `secrets` lens active — creating a secret belongs with viewing them.
             [:button {:id "secret-add-btn" :type "button" :class "gd-secret-add"
                       :hidden "hidden" :title "Create a new secret"
                       :aria-label "New secret"
                       :onclick "openCreateSecretForm(this)"}
              [:span {:class "kind-glyph" :aria-hidden "true"} "🔒"]
              [:span {:class "kind-label"} "New secret"]]
             ;; Recent fns — the navigation trail. renderRecentFns
             ;; (editor-sidebar.js) fills it from localStorage on every
             ;; tree update; hidden while empty or while the filter is
             ;; active (search owns that space).
             [:div {:id "gd-recent-fns" :hidden "hidden"
                    :aria-label "Recently selected functions"}]
             ;; role="tree": the rows inside are treeitems with an
             ;; explicit aria-level (the tree renders flat — a namespace
             ;; header and its children are siblings, so depth cannot be
             ;; read off the DOM). Arrow-key navigation lives in
             ;; editor-tree-keys.js.
             [:nav {:id "entity-list" :role "tree" :aria-label "Namespace tree"}]]
            ;; Graph container \u2014 <main> landmark
            ;; `#graph-surface` is a `group`, not an `img`: it hosts the
            ;; SVG edge layer AND the interactive HTML overlays (fn cards,
            ;; arg rows, action buttons). `role="img"` would make a screen
            ;; reader treat it as one atomic graphic and skip every
            ;; overlay control inside (axe `nested-interactive`).
            ;; `tabindex="-1"` so the skip link above actually MOVES focus
            ;; here; without it the browser only scrolls and focus stays
            ;; behind in the Explorer. Not in the tab order (-1).
            [:main {:id "graph-container" :aria-label "Function graph" :tabindex "-1"}
             [:div {:id "graph-surface" :role "group" :aria-label "Composition graph"}]
             ;; Navigation controls \u2014 group with role="toolbar" so
             ;; screen readers announce the buttons as a related set.
             [:div {:id "nav-controls" :role "toolbar" :aria-label "Graph navigation"}
              [:div {:class "nav-zoom-col"}
               [:button {:class "nav-btn" :onclick "navZoom(1)"
                         :aria-label "Zoom in" :title "Zoom in"} "+"]
               [:input {:id "zoom-slider" :type "range" :min "10" :max "300" :value "100"
                        :orient "vertical"
                        :aria-label "Zoom level"
                        :oninput "navZoomTo(this.value/100)" :title "Zoom"}]
               [:button {:class "nav-btn" :onclick "navZoom(-1)"
                         :aria-label "Zoom out" :title "Zoom out"} "\u2212"]]
              [:div {:class "nav-bottom-row"}
               [:button {:class "nav-btn" :onclick "navGoToRoot()"
                         :aria-label "Go to root node" :title "Go to root node"} "\u2302"]
               [:button {:class "nav-btn" :onclick "navResetPositions()"
                         :aria-label "Reset node positions" :title "Reset all node positions"} "\u27F2"]
               [:button {:class "nav-btn" :onclick "navResetZoom()"
                         :aria-label "Fit graph in view" :title "Fit graph in view"} "\u2299"]
               ;; Progressive disclosure \u2014 toggle the dense card metadata strips
               ;; (return-type + effects) on/off across the canvas. Cards start
               ;; compact (editor-shell.js sets body.gd-cards-compact).
               [:button {:class "nav-btn" :onclick "gdToggleCardDetails(this)"
                         :aria-pressed "false"
                         :aria-label "Show card details" :title "Show card details"}
                [:svg {:viewBox "0 0 24 24" :fill "none" :stroke "currentColor"
                       :stroke-width "1.8" :aria-hidden "true"}
                 [:path {:d "M4 6h16M4 12h16M4 18h10"}]]]]]]
            ;; RIGHT INSPECTOR \u2014 one home for everything about the selected fn
            ;; (redesign 2026-08): bindings, types, effects, provenance, this
            ;; function's OWN stats/errors, versions, run. Empty until a node
            ;; is selected; editor-shell.js fills it. Replaces the popover-hell.
            [:aside {:id "gd-inspector" :aria-label "Inspector"}
             [:div {:class "gd-insp-empty"}
              "Select a node to inspect its bindings, types, effects, and this function\u2019s own run history."]]
            ;; DIAGNOSTICS DRAWER \u2014 the code-facing live lists (Errors /
            ;; Type errors / Tests / Debug) as a collapsible strip under the
            ;; canvas. They used to live on the Organization surface, which
            ;; hid the editor while you read them; here a fn link in a row
            ;; navigates the canvas and the list STAYS open. The admin panels
            ;; (grants, members, packages, monitoring, \u2026) remain on
            ;; Organization. editor-sidebar.js mounts the section panes into
            ;; #gd-diag-panels; editor-diagnostics.js owns open/collapse +
            ;; the badge counts on the bar.
            [:section {:id "gd-diag-drawer" :data-open "0" :aria-label "Diagnostics"}
             [:div {:class "gd-diag-bar"}
              [:nav {:id "gd-diag-nav" :aria-label "Diagnostics sections"}]
              [:button {:id "gd-diag-toggle" :type "button" :class "gd-diag-toggle"
                        :onclick "gdDiagToggle()"
                        :aria-expanded "false" :aria-controls "gd-diag-panels"
                        :aria-label "Toggle diagnostics drawer"
                        :title "Toggle diagnostics drawer"} "\u25b4"]]
             [:div {:id "gd-diag-panels" :class "gd-diag-pane" :hidden "hidden"}]]
            ;; Placeholder overlay for surfaces not yet rebuilt (Run / Review /
            ;; Operate / Workspaces / Settings). Hidden on the Build surface.
            [:div {:id "gd-surface-overlay" :hidden "hidden"}
             [:div {:class "gd-surface-card"}
              [:div {:class "gd-surface-title"} "Coming"]
              [:div {:class "gd-surface-sub"} ""]
              [:button {:type "button" :class "gd-surface-back"
                        :onclick "gdShellGoHome()"}
               "Back to Build"]]]
            ;; OPERATE surface — the ops/admin panels (packages, monitoring,
            ;; grants, users, apps, assets) mount here instead of crowding
            ;; the explorer. The code-facing diagnostics (errors,
            ;; type-errors, tests, debug) moved to the Build-surface
            ;; diagnostics drawer. Shown when the Operate rail button is
            ;; active; editor-sidebar.js renders panels into #gd-operate-panels.
            [:section {:id "gd-operate" :hidden "hidden" :aria-label "Organization"}
             [:div {:class "gd-operate-head"}
              [:h1 "Organization"]
              ;; Two variants toggled by `body.gd-tenancy` (added once a
              ;; capability header arrives): the RBAC promise (members / roles /
              ;; permissions) only holds when the tenancy addon is active. A
              ;; single-tenant self-hosted instance has no members/roles, so it
              ;; gets the operational-only wording — no over-promise.
              [:p {:class "gd-solo-only"} "This instance's operations — packages, monitoring, apps and assets. Live code diagnostics (errors, tests) sit in the drawer under the canvas."]
              [:p {:class "gd-tenancy-only"} "Your organization — members, roles and permissions, plus its packages, monitoring and apps. Live code diagnostics (errors, tests) sit in the drawer under the canvas."]]
             [:div {:class "gd-op-body"}
              [:nav {:id "gd-operate-nav" :class "gd-op-nav" :aria-label "Organization sections"}]
              [:div {:id "gd-operate-panels" :class "gd-op-pane"}]]]
            ;; PLATFORM surface — cross-org / platform-wide administration (the
            ;; org registry today; landing + cross-org stats + platform-rights
            ;; grant next). editor-sidebar.js renders the platform sections into
            ;; #gd-platform-panels; the rail button is hidden without a platform
            ;; right (body.gd-platform).
            [:section {:id "gd-platform" :hidden "hidden" :aria-label "Platform"}
             [:div {:class "gd-operate-head"}
              [:h1 "Platform"]
              [:p "Platform-wide administration across every organization."]]
             [:div {:class "gd-op-body"}
              [:nav {:id "gd-platform-nav" :class "gd-op-nav" :aria-label "Platform sections"}]
              [:div {:id "gd-platform-panels" :class "gd-op-pane"}]]]
            ;; SETTINGS surface — personal editor settings, one section at a
            ;; time in the same nav+pane shell as Organization/Platform
            ;; (.gd-op-body), so unequal panels never leave grid holes. The
            ;; sections are static markup (unlike Operate, whose panels mount
            ;; from the sidebar render): Appearance / Account / About this
            ;; build / Access. gdRenderSettings (editor-shell.js) wires the
            ;; nav, populates the dynamic bits (theme/compact state, sign-in
            ;; state, build hashes, capabilities) and honours the
            ;; `@settings/<section>` deep link. Team access (grants / users /
            ;; roles) is operational and lives in Operate, not here.
            [:section {:id "gd-settings" :hidden "hidden" :aria-label "Settings"}
             [:div {:class "gd-operate-head"}
              [:h1 "Settings"]
              [:p "Your editor — appearance, account, and what this build is. Team access (grants, users, roles) lives in Organization."]]
             [:div {:class "gd-op-body"}
              [:nav {:id "gd-settings-nav" :class "gd-op-nav" :aria-label "Settings sections"}
               [:button {:type "button" :class "gd-op-nav-btn" :data-section "appearance" :aria-current "page"} "Appearance"]
               ;; Account nav entry — hidden outside the open accounts addon;
               ;; editor-account.js unhides it after the /auth/me boot probe.
               [:button {:type "button" :class "gd-op-nav-btn" :data-section "account" :aria-current "false" :hidden "hidden"} "Account"]
               [:button {:type "button" :class "gd-op-nav-btn" :data-section "build" :aria-current "false"} "About this build"]
               [:button {:type "button" :class "gd-op-nav-btn" :data-section "access" :aria-current "false"} "Access"]]
              [:div {:id "gd-settings-panels" :class "gd-op-pane"}
               [:section {:class "gd-op-card gd-set-pane" :data-section "appearance"}
                [:h2 {:class "gd-op-card-title"} "Appearance"]
                [:div {:class "gd-set-row"}
                 [:div {:class "gd-set-copy"}
                  [:div {:class "gd-set-label"} "Theme"]
                  [:div {:class "gd-set-hint"} "Light or dark drafting board."]]
                 [:button {:id "gd-set-theme" :type "button" :class "gd-set-btn"} "—"]]
                [:div {:class "gd-set-row"}
                 [:div {:class "gd-set-copy"}
                  [:div {:class "gd-set-label"} "Graph cards"]
                  [:div {:class "gd-set-hint"} "Compact hides the type / effect strips until you reveal them."]]
                 [:button {:id "gd-set-compact" :type "button" :class "gd-set-btn"} "—"]]]
               ;; ACCOUNT — the /account page merged in (2026-08-15): sign-in
               ;; methods, 2FA, API tokens, the verify-email banner. Shown only
               ;; under the open accounts addon (editor-account.js unhides its
               ;; nav button after the /auth/me boot probe answers); the
               ;; standalone /account page remains as the headless-deployment
               ;; fallback and redirects here when the editor serves it. Body
               ;; content is session-state fetched client-side from the
               ;; /auth/* JSON API — a graph partial can't render another
               ;; principal's session.
               [:section {:class "gd-op-card gd-set-pane" :data-section "account" :id "gd-set-account" :hidden "hidden"}
                [:h2 {:class "gd-op-card-title"} "Account"]
                [:div {:id "gd-acct-root"}]]
               [:section {:class "gd-op-card gd-set-pane" :data-section "build" :hidden "hidden"}
                [:h2 {:class "gd-op-card-title"} "About this build"]
                [:div {:class "gd-set-row"}
                 [:div {:class "gd-set-copy"}
                  [:div {:class "gd-set-label"} "Frontend"]
                  [:div {:class "gd-set-hint"} "The bundle hash your browser is running."]]
                 [:code {:id "gd-set-hash" :class "gd-set-code"} "—"]]
                [:div {:id "gd-set-version" :class "gd-set-versions"}]
                [:button {:id "gd-set-reload" :type "button" :class "gd-set-btn"} "Reload editor"]]
               [:section {:class "gd-op-card gd-set-pane" :data-section "access" :hidden "hidden"}
                [:h2 {:class "gd-op-card-title"} "Access"]
                [:p {:class "gd-set-hint"} "Who may touch what is enforced by the server. Under a tenancy addon your granted capabilities show below; the admin controls (grants, users, roles, orgs) live in the Organization surface."]
                [:div {:id "gd-set-caps" :class "gd-set-caps"}]]]]]
            ;; (No Run surface: running a fn is the ▶ action on its node/card
            ;; → the execute popover; its run history is the inspector "Runs"
            ;; tab and its version timeline the "Versions" tab. A dedicated
            ;; surface only duplicated both.)
            ;; (No Workspaces surface — the scope switcher is the ctxbar chip
            ;; (#gd-ws-chip → gdOpenWsPop); a full-page surface duplicated it.)
            ]]}}

  ;; =============================================================================
  ;; HASH-BUSTED ASSET URLs + LINK/SCRIPT-SRC ELEMENTS
  ;;
  ;; The editor JS/CSS bundles are not inlined into the HTML response —
  ;; they're served at `/assets/editor.{js,css}?v=<hash>` with a 1-year
  ;; `immutable` `Cache-Control`. The query-string hash is the
  ;; FRONTEND build hash (`:build-hash-frontend-short`), so a new
  ;; deploy changes the URL and the browser fetches the new bundle;
  ;; in between deploys the browser serves the bundle from cache
  ;; without even a conditional request.
  ;; =============================================================================

  {:name :_editor-js-url
   :description "`/assets/editor.js?v=<frontend-build-hash>` — `<script src>` URL for the bundled editor JS. Hash busts the cache when the frontend section changes."
   :parent :str-join
   :return-type :text
   :args {:coll ["/assets/editor.js?v=" :frontend-hash-effective]
          :separator ""}}

  {:name :_editor-css-url
   :description "`/assets/editor.css?v=<frontend-build-hash>` — `<link href>` URL for the bundled editor stylesheet."
   :parent :str-join
   :return-type :text
   :args {:coll ["/assets/editor.css?v=" :frontend-hash-effective]
          :separator ""}}

  ;; `<script src=…>` element. NOT `:_cdn-script-element` — that template
  ;; type-checks `:url` against the `:url` refinement (`^https?://`),
  ;; which our same-origin `/assets/editor.js?v=…` path doesn't match.
  ;; Build hiccup directly, mirroring the `:_editor-css-link` shape.
  {:name :_editor-script-attrs
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :src}
          :value {:ref :_editor-js-url}}}

  {:name :_editor-script-tag
   :description "`<script src=\"/assets/editor.js?v=…\"></script>` element appended at end of `<body>`. Replaces the previous inline `<script>` so the bundle is cached across page loads."
   :parent :hiccup
   :args {:tag {:value "script"}
          :attrs :_editor-script-attrs
          :children {:value []}}}

  ;; `<script src="/assets/api-routes.js?v=…">` — loads the boot-
  ;; time-cached `window.API = {…}` module so every editor JS
  ;; module can address `/api/*` routes by symbolic name
  ;; (`window.API.api_branches`) instead of duplicating path
  ;; literals.
  ;;
  ;; Served as a SEPARATE static asset rather than inlined as
  ;; `<script>{…}</script>` because an inline `<script>` with raw
  ;; children placed before another `<script>` sibling triggered a
  ;; hiccup-normalisation bug where the next sibling was silently
  ;; dropped from the rendered HTML (editor.js never loaded, page
  ;; came up blank). Standalone repro of the hiccup chain on the
  ;; same inputs renders both siblings correctly, so the bug lives
  ;; somewhere graphden-specific between fn-def execution and the
  ;; hiccup output — see `test/graphden/regressions/inline_script_
  ;; sibling_drop_test.clj` for the pinned regression. Using two
  ;; `<script src>` siblings sidesteps the issue entirely.
  {:name :_api-routes-js-url
   :description "`/assets/api-routes.js?v=<frontend-build-hash>` — `<script src>` URL for the cached `window.API` module."
   :parent :str-join
   :return-type :text
   :args {:coll ["/assets/api-routes.js?v=" :frontend-hash-effective]
          :separator ""}}

  {:name :_api-routes-js-handler
   :description "Ring handler for `GET /assets/api-routes.js` — returns the boot-cached `window.API` JS module as `application/javascript` with 1-year `immutable` `Cache-Control`."
   :parent :immutable-js-ok-response
   :args {:body :cached-api-routes-js}}

  {:name :_editor-api-routes-script-attrs
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :src}
          :value {:ref :_api-routes-js-url}}}

  {:name :_editor-api-routes-script-tag
   :description "`<script src=\"/assets/api-routes.js?v=…\"></script>` — loads the boot-cached `window.API` module before the main editor.js bundle so every editor module can read `window.API.<key>` at file-eval time."
   :parent :hiccup
   :args {:tag {:value "script"}
          :attrs :_editor-api-routes-script-attrs
          :children {:value []}}}

  ;; `<link rel="stylesheet" href="…">` attrs map — built via two
  ;; assoc calls because the editor-css URL is a runtime composition
  ;; over `:build-hash-frontend-short` (can't be a literal map).
  {:name :_editor-css-link-attrs-rel
   :parent :assoc
   :args {:map {:value {}}
          :key {:value :rel}
          :value {:value "stylesheet"}}}

  {:name :_editor-css-link-attrs
   :parent :assoc
   :args {:map :_editor-css-link-attrs-rel
          :key {:value :href}
          :value {:ref :_editor-css-url}}}

  {:name :_editor-css-link
   :description "`<link rel=\"stylesheet\" href=\"/assets/editor.css?v=…\">` element in `<head>`. Replaces the previous inline `<style>` so the browser can cache the CSS body across page loads."
   :parent :hiccup
   :args {:tag {:value "link"}
          :attrs :_editor-css-link-attrs
          :children {:value []}}}

  ;; =============================================================================
  ;; PAGE COMPOSITION (fn-defs)
  ;; =============================================================================

  ;; Build head elements list for the editor page
  {:name :head-elements-0
   :description "Initial head-elements vector — single entry: `:_editor-css-link` (`<link rel=\"stylesheet\">` to the cached `/assets/editor.css` bundle). Subsequent fn-defs append CDN scripts."
   :parent :conj
   :args {:coll [] :item :_editor-css-link}}

  ;; Final editor <head> — stylesheet link + HTMX CDN.
  ;; HTMX (2.x) lets server-rendered popover fragments declare their
  ;; own interactivity (`hx-get` for row-expand, `hx-on:click` for
  ;; declarative dismissal, etc.) without per-module JS post-swap
  ;; binding code — the graph fragment owns the contract end to end.
  ;;
  ;; The graph itself needs no library: nodes are HTML overlays, edges are SVG
  ;; paths, and the viewport is one CSS transform.
  {:name :_head-htmx
   :description "Head after the locally-served htmx 2.x bundle (`/assets/htmx.min.js`, vendored — no CDN). HTMX is the declarative-interaction layer the `/partials/*` fragments rely on."
   :parent :with-cdn-script
   :args {:head :head-elements-0
          :url :_htmx-js-url}}

  ;; CodeMirror is loaded `defer` — 488 KB that must NOT block first
  ;; paint. `window.CM` is only read at enhance time (a value-form open
  ;; or an htmx swap), which is always after a deferred script has run,
  ;; so nothing races it.
  {:name :_cm-script-attrs
   :parent :assoc
   :args {:map {:value {"defer" "defer"}}
          :key {:value "src"}
          :value :_cm-js-url}}

  {:name :_cm-script-tag
   :parent :hiccup
   :args {:tag {:value "script"} :attrs :_cm-script-attrs :children {:value []}}}

  {:name :head
   :description "Final editor `<head>` element vector — stylesheet link, htmx, and the DEFERRED vendored CodeMirror bundle (`window.CM` — editor-code.js upgrades the code textareas with it)."
   :parent :conj
   :args {:coll :_head-htmx :item :_cm-script-tag}}

  ;; Complete HTML page
  ;; Scripts: API constants module (inline) THEN the editor JS
  ;; bundle. Order matters — every module in editor.js may read
  ;; `window.API.<key>` at file-eval time.
  {:name :_editor-scripts
   :parent :list
   :args {:items [:_editor-api-routes-script-tag :_editor-script-tag]}}

  {:name :page
   :description "Full editor HTML page — title, head (stylesheet link + CDN scripts), body (sidebar + graph), and an end-of-body `<script src>` pointing at the cached editor JS bundle. Rendered by `:_editor-handler` on `GET /`."
   :parent :html-page
   :args {:title "Graphden - Graph Editor"
          :head :head
          :body :body
          :scripts :_editor-scripts}}

  ;; Handler — :html-ok-response sets status 200 + html content-type;
  ;; :render-hiccup converts the hiccup page to an HTML string. With
  ;; :assoc-fn at the route binding the whole graph is hof-wrap'd into
  ;; a constant Ring callable.
  {:name :_editor-rendered-page
   :parent :render-hiccup
   :return-type :text
   :args {:hiccup :page}}

  {:name :_editor-handler
   ;; [] — static page; [:default] was a leaked derived free, and a 1-param
   ;; shape drops the raw ring request into that slot on the bare-route path.
   ;; no-cache: the shell's asset URLs carry `?v=<effective hash>` which
   ;; rolls on an asset-override save — a heuristically-cached shell would
   ;; keep serving the old URLs.
   :lambda-params []
   :parent :html-no-cache-ok-response
   :args {:body :_editor-rendered-page}}

  ;; =============================================================================
  ;; ASSET HANDLERS — bundled JS / CSS at /assets/editor.{js,css}
  ;; Each returns the bundle body with a 1-year `immutable`
  ;; `Cache-Control`. Hash-busting lives in the URL query string.
  ;; =============================================================================

  ;; `:script` is declared `:nullable-text` because `:str-replace` is
  ;; nil-flow-through; in practice the placeholder substitution over a
  ;; baked-in resource is never nil. `:assert-some` is the type-system
  ;; bridge — narrows back to `:text` for the strict `:body` slot.
  {:name :_editor-js-body
   :description "`:script` narrowed from `:nullable-text` to `:text` via `:assert-some` — the JS bundle is a baked-in resource that can't be nil at runtime, but `:str-replace`'s nil-flow-through type forces the explicit narrowing."
   :parent :assert-some
   :return-type :text
   :args {:value :script}}

  {:name :_editor-js-handler
   :lambda-params []
   :description "Ring handler for `GET /assets/editor.js` — returns the concatenated editor JS bundle (with `__BUILD_HASH__` substituted) as `application/javascript` with `Cache-Control: public, max-age=31536000, immutable`."
   :parent :immutable-js-ok-response
   :args {:body :_editor-js-body}}

  ;; Standalone runtime bundle for graph-composed pages (e.g.
  ;; /demo/contact). Includes graphden-runtime.js (the dispatcher
  ;; / registry / loadPartial primitives) + graphden-actions-
  ;; builtin.js (navigate + submit-form + custom). Loaded INSTEAD
  ;; of editor.js on pages that don't host the editor canvas
  ;; (editor.js is ~700 KB and initialises the graph canvas + WebSocket
  ;; subscriptions that crash a stripped-down page).
  {:name :_graphden-runtime-js-paths
   :parent :const
   :args {:value ["packages/web/runtime/graphden-popover.js"
                  "packages/web/runtime/graphden-edn.js"
                  "packages/web/runtime/graphden-forms.js"
                  "packages/web/runtime/graphden-runtime.js"
                  "packages/web/runtime/graphden-actions-builtin.js"]}}

  {:name :_graphden-runtime-js-body
   :description "Concatenated `graphden-popover.js` + `graphden-edn.js` + `graphden-forms.js` + `graphden-runtime.js` + `graphden-actions-builtin.js` (in `web/runtime/`) — the platform JS primitives graph-composed pages need (popover positioning + dismiss; EDN read/print; hiccup form render / collect / fill / widgets; action dispatch + built-in navigate / submit-form / custom handlers)."
   :parent :concat-resources-overridable
   :return-type :text
   :args {:paths :_graphden-runtime-js-paths}}

  {:name :_graphden-runtime-js-handler
   :lambda-params []
   :description "Ring handler for `GET /assets/graphden-runtime.js` — minimal runtime bundle for graph-composed pages. Same 1-year `immutable` cache headers as editor.js (hash-bust via `?v=` on the script tag)."
   :parent :immutable-js-ok-response
   :args {:body :_graphden-runtime-js-body}}

  ;; Reusable `<script>` tags + bundle list for graph-composed
  ;; pages that need the dispatcher to be live. Bound to a page's
  ;; `:scripts` slot via :graphden-runtime-scripts (one binding,
  ;; two tags). See :html-page-route in app/page for the
  ;; one-fn-def page-route template that pairs with these.

  ;; --- htmx asset — vendored locally (web/vendor/htmx.min.js, see
  ;; its README for provenance): no CDN dependency for the editor OR
  ;; for tenant pages. Same immutable + ?v=hash caching as the other
  ;; assets.

  ;; ===========================================================================
  ;; UI Step 1 — asset overrides. `:resource-override` rows (versioned,
  ;; per-branch, path-unique) shadow classpath frontend assets: reading
  ;; an asset checks the graph first, so the editor's own JS/CSS is
  ;; editable from inside the running editor — no jar rebuild. The
  ;; effective frontend hash folds the overrides in, so every asset URL
  ;; (?v=…) rolls forward on an edit and the browser's immutable cache
  ;; steps aside on the next page load.
  ;; ===========================================================================

  ;; The `:path` free stays a BARE `{:as :path}` — an annotation here
  ;; (`:type`/`:description`) would mint a DISTINCT slot named `path`
  ;; next to `:read-resource-or-nil`'s, and a consumer's single
  ;; `{:path "…"}` pin would close only one of the two; the other
  ;; surfaces at the ROUTE fn-def and swallows its `:path "/assets/…"`
  ;; arg (name-shadowing — the editor.css 500).
  {:name :_ro-where
   :parent :zipmap
   :args {:keys [{:value :path}]
          :vals [{:as :asset-path}]}}

  {:name :_ro-row
   :parent :first
   :args {:coll {:parent :query-entities
                 :args {:entity-type {:value "resource-override"}
                        :where :_ro-where}}}}

  {:name :_ro-content
   :parent :get
   :args {:coll :_ro-row :key {:value :content} :default nil}}

  ;; `:get` computes `:any`, so the then-branch goes through `:to-str`
  ;; (identity on the `:text` content column) to prove `:text` — same
  ;; trick as narrowing, without a refinement row.
  ;;
  ;; The `:asset-path` free surfaces at TWO slot sites (the `:_ro-where`
  ;; zipmap value and the `:read-resource` rename), so it only binds
  ;; correctly through a NAMED call — the HOF per-item call below, or an
  ;; `exec` with named args. A parent PIN closes just one of the two
  ;; sites, which is why every consumer goes through the one-item /
  ;; n-item bundle shape (`:concat-resources-overridable`) instead of
  ;; `:parent`-ing this fn with a pinned path. The free is also
  ;; deliberately NOT named `:path` — the route templates bind a `:path`
  ;; arg ("/assets/…"), and an unclosed same-name slot resolves from the
  ;; caller's env (the original editor.css 500).
  {:name :read-resource-overridable
   :lambda-params [:asset-path]
   :description "Read a frontend asset — the branch's `:resource-override` row when one exists, else the classpath baseline (`:read-resource`). The seam that makes the editor's own JS/CSS editable in place. Call it with a NAMED `:asset-path` (HOF per-item or exec) — see the slot-sites note above."
   :parent :if
   :args {:test {:parent :and
                 :args {:values [{:parent :not :args {:value :_ro-disabled?}}
                                 {:parent :some? :args {:value :_ro-content}}]}}
          :then {:parent :to-str :args {:value :_ro-content}}
          :else {:parent :read-resource :args {:path {:as :asset-path}}}}}

  ;; RESCUE HATCH: a broken JS override can brick the editor (a syntax
  ;; error in one file kills the whole concatenated bundle, and the
  ;; Assets panel lives INSIDE the editor). Restart with
  ;; GRAPHDEN_DISABLE_ASSET_OVERRIDES=1 → every asset serves its shipped
  ;; baseline (`:and` short-circuits, the override query never runs) →
  ;; revert the bad row from the panel → unset and restart. The save
  ;; path also syntax-checks JS client-side, so this is the belt behind
  ;; that suspender.
  {:name :_ro-disabled?
   :parent :non-blank?
   :args {:string {:parent :coalesce
                   :args {:value {:parent :env
                                  :args {:name {:value "GRAPHDEN_DISABLE_ASSET_OVERRIDES"}}}
                          :default {:value ""}}}}}

  {:name :_concat-overridable-list
   :parent :map
   :args {:func :read-resource-overridable
          :coll {:as :paths}}}

  {:name :concat-resources-overridable
   :description "`:concat-resources` with the override tier — each path reads through `:read-resource-overridable`. Every editor/runtime bundle builds through this."
   :parent :str-join
   :return-type :text
   :args {:coll :_concat-overridable-list
          :separator {:value "\n\n"}}}

  ;; --- effective frontend hash: baked hash ++ overrides fingerprint.
  {:name :_ro-all
   :parent :query-entities
   :args {:entity-type {:value "resource-override"}
          :where {:value {}}}}

  {:name :_ro-row-fingerprint
   :parent :str
   :args {:parts [{:parent :get :args {:coll {:as :item} :key {:value :path} :default ""}}
                  {:value ":"}
                  {:parent :sha256-hex
                   :args {:s {:parent :to-str
                              :args {:value {:parent :get
                                             :args {:coll {:as :item}
                                                    :key {:value :content}
                                                    :default ""}}}}}}]}}

  {:name :_ro-fingerprint
   :parent :str-join
   :args {:coll {:parent :sort
                 :args {:coll {:parent :map
                               :args {:func :_ro-row-fingerprint
                                      :coll :_ro-all}}}}
          :separator {:value "|"}}}

  {:name :_frontend-hash-with-overrides
   :parent :subs
   :args {:string {:parent :sha256-hex
                   :args {:s {:parent :str
                              :args {:parts [:build-hash-frontend-short
                                             :_ro-fingerprint]}}}}
          :start {:value 0} :end {:value 12}}}

  {:name :frontend-hash-effective
   :description "The hash the asset URLs (`?v=…`) and `window.BUILD_HASH` carry: the baked frontend hash when no overrides exist, else 12 hex chars of sha256(baked ++ overrides fingerprint) — so an in-editor asset edit rolls every asset URL and defeats the browser's immutable cache on the next load. `/version` keeps reporting the BAKED hash (jar identity — `bb verify` compares code, not overrides)."
   :parent :if
   :args {:test {:parent :or
                 :args {:values [{:parent :empty? :args {:coll :_ro-all}}
                                 ;; Rescue hatch: when overrides are disabled the
                                 ;; assets serve their baseline BYTES, so the URL
                                 ;; must carry the BAKED hash too — otherwise the
                                 ;; browser keeps the bricked bundle cached under
                                 ;; the override hash and never re-fetches.
                                 :_ro-disabled?]}}
          :then :build-hash-frontend-short
          :else :_frontend-hash-with-overrides}}

  {:name :_htmx-js-paths
   :parent :const
   :args {:value ["packages/web/vendor/htmx.min.js"]}}

  {:name :_htmx-js-body
   :description "The vendored htmx 2.x bundle read off the classpath."
   :parent :concat-resources-overridable
   :return-type :text
   :args {:paths :_htmx-js-paths}}

  {:name :_htmx-js-handler
   :lambda-params []
   :description "Ring handler for `GET /assets/htmx.min.js` — the vendored htmx bundle with the standard 1-year `immutable` cache headers (hash-bust via `?v=` on the script tag)."
   :parent :immutable-js-ok-response
