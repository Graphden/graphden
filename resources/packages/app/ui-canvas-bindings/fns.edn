    :then "Optional — the fn runs without it.",
    :else :_required-above}}
  {:name :_required-optional,
   :parent :if,
   :args
   {:test :_required,
    :then
    "Optional by declaration, required here — and in every descendant.",
    :else :_required-not-here}}
  {:name :_required-line,
   :parent :if,
   :args {:test :_optional, :then :_required-optional, :else ""}}
