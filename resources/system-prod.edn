;; Production system configuration
;; Environment variables are read via Aero #env tag

{:db/schema {}

 :db/postgres
 {:jdbc-url #or [#env JDBC_URL "jdbc:postgresql://localhost:5432/graphden"]
  :username #or [#env DB_USERNAME "graphden"]
  :password #or [#env DB_PASSWORD "graphden"]
  :pool-size #long #or [#env DB_POOL_SIZE "10"]
  :schema #ig/ref :db/schema}

 ;; Tenancy storage seam (PLATFORM_PLAN §3.0). Identity passthrough by
 ;; default; the tenancy addon overrides :app/storage with an org-scoped
 ;; decorator. Sits BENEATH versioning so the branch-router's vs/unwrap
 ;; keeps the tenant filter.
 :app/storage
 {:base #ig/ref :db/postgres}

 :db/versioned
 {:base-storage #ig/ref :app/storage}

 ;; Cross-process events: every executor pod LISTENs on
 ;; `graphden_events` so that a mutation on one pod (e.g. an admin
 ;; toggles a :service via /api/entities/service on pod A) is
 ;; observed by all sibling pods within ~1s. The listener owns a
 ;; dedicated PG connection — pool-bound connections aren't usable
 ;; for LISTEN because the session must stay alive forever.
 :db/notify-listener
 {:pg-opts
  {:jdbc-url #or [#env JDBC_URL "jdbc:postgresql://localhost:5432/graphden"]
   :username #or [#env DB_USERNAME "graphden"]
   :password #or [#env DB_PASSWORD "graphden"]}}

 ;; Per-service ownership via Postgres session-scoped advisory locks.
 ;; Owns a dedicated PG connection (pool connections aren't usable —
 ;; advisory locks are session-scoped and a pool would lend the
 ;; session to other callers). Reconciler tries to acquire the lock
 ;; before starting each service; only the pod that wins runs it.
 :db/service-locks
 {:pg-opts
  {:jdbc-url #or [#env JDBC_URL "jdbc:postgresql://localhost:5432/graphden"]
   :username #or [#env DB_USERNAME "graphden"]
   :password #or [#env DB_PASSWORD "graphden"]}}

 ;; SSE invalidation relay — forwards graphden_events to remote / BYO
 ;; executors over SSE. Opt-in: set GRAPHDEN_SSE_PORT to enable (unset ⇒
 ;; the component starts but the relay is a no-op). Its own port, separate
 ;; from the app HTTP server.
 :sse/relay
 {:port #or [#env GRAPHDEN_SSE_PORT nil]
  :notify-listener #ig/ref :db/notify-listener
  :auth-provider #ig/ref :auth/provider}

 ;; Load packages from resources/packages/
 ;; `examples` is dev/test-only per its package.edn description
 ;; ("pedagogical fn-def examples — Load only in dev/test, never in
 ;; prod"); it ships 174 pedagogical fn-defs that bloat the prod
 ;; DB + namespace tree without serving any runtime feature.
 :app/packages
 {:package-names ["core" "storage" "web" "app"]}

 :exec/base-fns
 {:storage #ig/ref :db/versioned
  :packages #ig/ref :app/packages}

 :exec/fn-entities
 {:storage #ig/ref :db/versioned
  :packages #ig/ref :app/packages
  :base-fns #ig/ref :exec/base-fns}

 ;; OpenBao / Vault KV v2 client. Address + token are INFRASTRUCTURE
 ;; level — the user fn-graph never sees them; it calls `:vault-get`
 ;; which pulls the client off the executor context. When VAULT_ADDR
 ;; is unset the client returns nil and `:vault-get` errors on use.
 :vault/client
 {:address #or [#env VAULT_ADDR ""]
  :token #or [#env VAULT_TOKEN ""]}

 ;; Authentication seam (PLATFORM_PLAN §3.0). Default single-token
 ;; provider; the tenancy addon overrides this key with session/JWT.
 :auth/provider
 {:token #or [#env AUTH_TOKEN ""]}

 :exec/context
 {:storage #ig/ref :db/versioned
  :vault-client #ig/ref :vault/client
  ;; Raw PG storage for NOTIFY emission (the pool is on PostgresStorage).
  ;; Emission is fire-and-forget — done on the main pool, not on the
  ;; listener's dedicated connection.
  :pg-storage #ig/ref :db/postgres
  ;; ctx-scoped base-fns map (sidesteps the process-global registry).
  :base-fns #ig/ref :exec/base-fns
  :auth-provider #ig/ref :auth/provider
  ;; Executor shard: comma-separated org-ids this pod compiles, e.g.
  ;; "public,acme". Unset ⇒ the whole graph (self-hosted default, and
  ;; what every single-tenant deployment wants). List "public"
  ;; explicitly — the platform packages live there.
  :executor-orgs #or [#env GRAPHDEN_EXECUTOR_ORGS nil]
  ;; Pod role. "true" ⇒ this is a customer's OWN executor (BYO): it serves
  ;; the `:byo` orgs in its shard. Unset/false ⇒ a hosted pod, which 421s
  ;; any `:byo` org. A BYO pod also sets GRAPHDEN_EXECUTOR_ORGS to just its
  ;; own org.
  :byo-executor? #or [#env GRAPHDEN_BYO_EXECUTOR nil]
  ;; Fleet identity (docs/FLEET_RFC.md §6.1, T2.6). The DNS name other
  ;; executors reach this pod at (k8s StatefulSet / headless-service pod name).
  ;; Set ⇒ this pod forward-hops a misdirected request to the cell's holder
  ;; instead of 421, AND exposes the internal cell-command endpoint (§6.3, T3.3)
  ;; that a move drives. Unset (single-tenant / self-hosted) ⇒ 421 as before,
  ;; no fleet endpoint. Two more env vars, read directly (not Aero keys), tune
  ;; the fleet transport when this is set:
  ;;   GRAPHDEN_PORT           — the port every pod's app server listens on
  ;;                             (default 8080); the forward-hop + cell-command
  ;;                             clients dial `http://<executor-id>:<port>`.
  ;;   GRAPHDEN_INTERNAL_TOKEN — shared control-plane secret gating
  ;;                             `POST /internal/fleet/cell/...` (a k8s secret,
  ;;                             same on every pod). Unset ⇒ the endpoint
  ;;                             fail-closes and moves are disabled.
  :executor-id #or [#env GRAPHDEN_EXECUTOR_ID nil]}

 ;; Compile fn graphs into Clojure closures at startup. Depends on
 ;; fn-entities so every composed fn is already in storage before we
 ;; traverse them.
 :exec/compiled-registry
 {:context #ig/ref :exec/context
  :_fn-entities #ig/ref :exec/fn-entities}

 ;; Per-branch ExecutionContext registry + Ring dispatcher. Seeded
 ;; with the default branch (main) right after the compiled registry
 ;; is built. The `:branch-routing-wrap` base-fn impl reads from this
 ;; router on every request to decide which branch's compiled view
 ;; serves the call.
 :exec/branch-router
 {:context #ig/ref :exec/context
  :_compiled-registry #ig/ref :exec/compiled-registry}

 ;; Backend↔frontend URL drift check. Runs after the compiled
 ;; registry is ready; walks the live router's `/api/*` paths and
 ;; scans every editor JS for `/api/*` literals — throws on drift
 ;; (rename a route fn-def, forget to update the JS → boot fails
 ;; rather than silent runtime 404). Toggled off via
 ;; `GRAPHDEN_SKIP_URL_DRIFT_CHECK=1` for emergency overrides.
 :exec/api-url-drift-check
 {:context #ig/ref :exec/context
  :_compiled-registry #ig/ref :exec/compiled-registry
  :skip? #or [#env GRAPHDEN_SKIP_URL_DRIFT_CHECK ""]}

 ;; Boot-time-cached `window.API = {…}` JS module. Computed once
 ;; after `:_router` compiles; consumed by the editor JS bundle via
 ;; the pure `:cached-api-routes-js` base-fn so editor modules can
 ;; address routes by name (`API.api_branches`) instead of
 ;; duplicating path literals.
 :exec/api-routes-js-cache
 {:context #ig/ref :exec/context
  :_compiled-registry #ig/ref :exec/compiled-registry}

 ;; Service registry: seeds packages' `:services` declarations into the
 ;; `:service` table (idempotent — deterministic ids), then reads
 ;; enabled rows and starts them under the supervisor. See
 ;; system/core.clj for the full lifecycle.
 :exec/service-reconciler
 {:context #ig/ref :exec/context
  :packages #ig/ref :app/packages
  :notify-listener #ig/ref :db/notify-listener
  :service-locks #ig/ref :db/service-locks
  :_compiled-registry #ig/ref :exec/compiled-registry
  :_branch-router #ig/ref :exec/branch-router}

 ;; Fleet placement controller (docs/FLEET_RFC.md §6.3, Phase 2). A leader-
 ;; locked periodic tick that reads live cell weights + the executor set
 ;; (GRAPHDEN_FLEET_EXECUTORS) and applies placement: places new tenant app
 ;; cells, rebalances SUSTAINED imbalance via the directed cell-command
 ;; transport. Own advisory-lock connection (distinct from the reconciler's)
 ;; elects one controller fleet-wide. Inert unless this pod is a fleet member
 ;; (:enabled? ← GRAPHDEN_EXECUTOR_ID). Tuning envs (read directly):
 ;; GRAPHDEN_FLEET_SUSTAIN_TICKS, GRAPHDEN_FLEET_MIN_IMPROVEMENT,
 ;; GRAPHDEN_FLEET_MAX_MOVES.
 :exec/fleet-controller
 {:context #ig/ref :exec/context
  :_compiled-registry #ig/ref :exec/compiled-registry
  :pg-opts
  {:jdbc-url #or [#env JDBC_URL "jdbc:postgresql://localhost:5432/graphden"]
   :username #or [#env DB_USERNAME "graphden"]
   :password #or [#env DB_PASSWORD "graphden"]}
  :enabled? #or [#env GRAPHDEN_EXECUTOR_ID nil]
  :period-ms #long #or [#env GRAPHDEN_FLEET_CONTROLLER_PERIOD_MS "30000"]}

 ;; Hourly sweep of :fn-execution rows past per-status TTL.
 ;; period-ms overridable via env (e.g. 600000 for 10-min sweeps in
 ;; staging). Independent of HTTP — runs even when nobody hits /api.
 :exec/cleanup-scheduler
 {:context #ig/ref :exec/context
  :period-ms #long #or [#env CLEANUP_PERIOD_MS "3600000"]}

 ;; Demo branches for the versioning UI. OPT-IN: only seeds when
 ;; GRAPHDEN_DEMO_BRANCHES_ENABLED is truthy (`1`, `true`, `yes`,
 ;; `on`). Real prod ships with no seeding so demo rows don't appear
 ;; in production graphs by accident. Dev / docker-compose sets the
 ;; var via .env so the editor's branch picker has demo content out
 ;; of the box.
 ;;
 ;; Idempotent regardless of toggle: a branch whose `:name` already
 ;; exists in the DB is left untouched, so a pod restart doesn't
 ;; double-write. After `bb deploy` (clean DB) the branches reappear.
 ;; Drop a branch (UI or DELETE /api/branches/:n) to re-seed it on
 ;; next restart. See `graphden.system.demo-branches` for the
 ;; mutation vocabulary.
 :exec/demo-branches
 {:context #ig/ref :exec/context
  :_after-router #ig/ref :exec/branch-router
  :enabled? #or [#env GRAPHDEN_DEMO_BRANCHES_ENABLED ""]
  :branches
  [{:name "demo-edit-description"
    :description "Lightweight demo — only `add`'s description differs"
    :mutations
    [{:type :update-fn-description
      :fn-name "add"
      :description "Sum a vector of numbers (edited on demo-edit-description)"}]}

   {:name "demo-new-fn"
    :description "Carries a fn (`demo-twice`) that does NOT exist on main"
    :mutations
    [{:type :create-fn
      :name "demo-twice"
      :parent "add"
      :description "Demo-only `add` clone — shows up as `:added-in-source` in the diff"}]}]}}
