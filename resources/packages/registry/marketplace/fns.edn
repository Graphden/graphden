   :args {:string {:parent :to-str :args {:value {:parent :get :args {:coll :_mki-origin :key {:value :as-of} :default {:value ""}}}}}
          :limit {:value 10}}}
  {:name :_mki-origin-note
   :description "Where the reviews live: the origin registry. The rating / installs shown above are ITS numbers, as of the mirror."
   :parent :hiccup
   :args {:tag {:value "div"} :attrs {:value {:class "mk-origin-note"}}
          :children [{:value "Mirrored from "}
