;; String manipulation base functions
;; str, subs, str-len, str-upper, str-lower, str-trim, str-split, str-join,
;; str-to-keyword, keyword-to-str


{:namespace "core.strings"
 :fns
 [{:name :str
   :args {:parts :jsonb}
   :return-type :text}

  {:name :subs
   :args {:string :text
          :start :int
          :end {:type :int :required false}}
   :return-type :text}

  {:name :str-len
   :args {:string :text}
   :return-type :int}

  {:name :str-upper
   :args {:string :text}
   :return-type :text}

  {:name :str-lower
   :args {:string :text}
   :return-type :text}

  {:name :str-trim
   :args {:string :text}
   :return-type :text}

  {:name :str-split
   :args {:string :text, :separator :text}
   :return-type :jsonb}

  {:name :str-join
   :args {:coll :jsonb
          :separator {:type :text :value ""}}
   :return-type :text}

  {:name :str-to-keyword
   :args {:string :text}
   :return-type :any}

  {:name :keyword-to-str
   :args {:keyword :any}
   :return-type :text}

  {:name :pr-str
   :args {:value :any}
   :return-type :text}

  {:name :to-str
   :args {:value :any}
   :return-type :text}

  {:name :parse-query-string
   :args {:string :text}
   :return-type :jsonb}

  ;; (if (> (count s) n) (str (subs s 0 n) "...") s) — pure composition.
  {:name :truncate
   :parent :if
   :args {:test :_truncate-too-long?
          :then :_truncate-suffixed
          :else {:as :string}}}

  {:name :_truncate-len
   :parent :str-len
   :args {:string {:as :string}}}

  {:name :_truncate-max-length-echo
   :parent :identity
   :args {:value {:as :max-length}}}

  {:name :_truncate-too-long?
   :parent :gt
   :args {:nums [:_truncate-len :_truncate-max-length-echo]}}

  {:name :_truncate-prefix
   :parent :subs
   :args {:string {:as :string}
          :start 0
          :end {:as :max-length}}}

  {:name :_truncate-suffixed
   :parent :str
   :args {:parts [:_truncate-prefix {:value "..."}]}}

  {:name :blank?
   :args {:string {:type :text :required false}}
   :return-type :bool}

  {:name :url-decode
   :args {:string :text}
   :return-type :text}

  {:name :str-contains?
   :args {:string :text, :substring :text}
   :return-type :bool}

  {:name :str-starts-with?
   :args {:string :text, :prefix :text}
   :return-type :bool}]}
