;; Open `accounts` module — opt-in identity layer (docs/ACCOUNTS.md).
;;
;; Enable it by naming this fragment in GRAPHDEN_ADDON_CONFIGS:
;;   GRAPHDEN_ADDON_CONFIGS=graphden/accounts/addon.edn
;; Omit it and core runs exactly as before (single-token or open) — this
;; fragment is the whole opt-in switch, no core-config edit needed.
;;
;; It deep-merges over system-<profile>.edn:
;;   - loads graphden.accounts.init (registers the init-key defmethods),
;;   - adds :account / :identity / :session to the schema via the
;;     :db/schema :extensions seam,
;;   - swaps :exec/context's :auth-provider to the accounts provider
;;     (bearer OR gd_session cookie → account principal).
;;
;; NOTE (prod/tenancy coexistence, Phase 4): :db/schema :extensions is a
;; VECTOR — deep-merge REPLACES vectors, it does not concat. When accounts
;; and tenancy both run, the prod fragment that wins must list BOTH
;; extension refs; that unification lands with the tenancy cutover.
{:graphden/require [graphden.accounts.init]

 :accounts/schema-extension {}

 ;; The provider reads the BASE storage — auth runs in the platform context,
 ;; before any request scope binds.
 :accounts/provider {:storage #ig/ref :db/postgres}

 ;; Transactional email. RESEND_API_KEY unset (→ "") selects the LogMailer,
 ;; so a self-hosted instance without an email provider still completes
 ;; verification (the link goes to the log). GRAPHDEN_MAIL_FROM overrides the
 ;; default sender.
 :accounts/mailer {:api-key #env RESEND_API_KEY
                   :from #env GRAPHDEN_MAIL_FROM}

 ;; The /auth/* HTTP surface (password + social + verify). Each social provider
 ;; is enabled only when BOTH its client-id and secret are set (unset #env →
 ;; "" → OFF), so social login is per-provider opt-in. GRAPHDEN_APP_ORIGIN is
 ;; the public origin used for redirect URIs + verification links; unset → the
 ;; request Host is used.
 :accounts/routes-install {:storage #ig/ref :db/postgres
                           :mailer #ig/ref :accounts/mailer
                           :app-origin #env GRAPHDEN_APP_ORIGIN
                           :oauth-providers {"github" {:client-id #env GITHUB_CLIENT_ID
                                                       :client-secret #env GITHUB_CLIENT_SECRET}
                                             "google" {:client-id #env GOOGLE_CLIENT_ID
                                                       :client-secret #env GOOGLE_CLIENT_SECRET}}
                           :telegram {:bot-token #env TELEGRAM_BOT_TOKEN}}

 :db/schema {:extensions [#ig/ref :accounts/schema-extension]}

 :exec/context {:auth-provider #ig/ref :accounts/provider}}
