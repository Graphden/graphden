  ;; (username + org + create-account) ships WITH the tenancy addon, which
  ;; overrides this same /partials/auth-form path via the route-collection
  ;; seam — so a self-hosted build carries no tenant markup at all.
  {:name :_auth-form-fields
   :description "The single-tenant auth popover fields (admin password + actions + error) as a fragment (rendered directly into `#auth-popover`, staying direct flex children). The `data-auth-mode` marker on the error div tells editor-auth.js which submit path the served form expects."
   :parent :list
