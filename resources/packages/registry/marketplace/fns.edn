;; The MARKETPLACE — discovery over the registry (docs/MARKETPLACE.md).
;;
;; One artifact entity serves every kind: a `:package-version` row is a
;; fns package (`:kind` nil / "fns"), an editor THEME ("theme" — its
;; `:payload` is the token map) or a KEYBOARD LAYOUT ("keymap" — its
;; `:payload` the binding overrides). This module adds what a listing
;; needs on top of publish / install:
;;
;;   • the listing vocabulary + normaliser every publish path shares
;;     (`:listing-normalize` — kind, category, tags, description, payload);
;;   • the CARD aggregation — one card per package name: latest version,
;;     every version, the rating (avg + count over `:package-review`) and
;;     the install count (`:package-stat`) — plus the search / category /
;;     tag / sort filters, as pure graph over the index;
;;   • the two server-rendered partials the Marketplace SURFACE mounts
;;     (`/partials/marketplace` = toolbar + cards or the Executor roster;
;;     `/partials/marketplace/item` = one package: versions, actions,
;;     reviews) and the action routes that re-render them (install / fork,
;;     apply a theme or keymap, write / delete a review);
;;   • `POST /api/marketplace/publish` for the non-fns kinds (a theme or
;;     keymap has no namespace to export — the payload IS the artifact)
;;     and `GET /api/marketplace` (the cards as JSON — what Settings reads
;;     for "my saved themes", and what scripts read).
;;
;; HTMX contract: every partial root is `div[data-marketplace]` carrying
;; `hx-target="closest [data-marketplace]" hx-swap="outerHTML"`, which
;; htmx INHERITS — so a card, a tab, a tag chip or an action button only
;; names its URL, and every response is the next whole root.
;;
;; HOF-callback convention: the element is `:item`; a callback that also
;; needs a value from the caller declares it as its own free arg
;; (`{:as :reviews}` …) and the `:map` / `:filter` site binds it — the
;; wrap-time capture contract (docs/CLOSURE_CAPTURE.md). Effectful reads
;; (the review / stat queries) are computed ONCE at the site and captured,
;; never re-read per card.

{:namespace "app.marketplace"
 :description "Marketplace over the registry — listing vocabulary, per-package cards (versions, rating, installs), search/category/tag filters, the surface partials, reviews, apply-a-theme/keymap, and the non-fns publish route."
 :fns
 [;; =====================================================================
  ;; LISTING VOCABULARY + NORMALISER
  ;; =====================================================================

  {:name :listing-kinds
   :description "The marketplace kinds a `:package-version` row can be — `fns` (a fn-def package), `theme` (an editor theme), `keymap` (a keyboard layout). Nil `:kind` on a row reads as `fns`."
   :parent :const
   :args {:value ["fns" "theme" "keymap"]}}

  {:name :listing-categories
   :description "The category vocabulary per kind — one category per listing, chosen from this list (a free-text category would make the category filter useless)."
   :parent :const
   :args {:value {"fns" ["web" "data" "integrations" "utilities" "ai" "devops" "examples" "other"]
                  "theme" ["light" "dark" "high-contrast" "colorful" "minimal" "other"]
                  "keymap" ["vim-like" "emacs-like" "ide-like" "accessibility" "other"]}}}

  ;; `:non-negative-int` — the refinement `:take :count` / `:str-clip :limit`
  ;; demand (a bare `:int` const fails the sweep).
  {:name :listing-max-tags
   :parent :const :args {:value 10} :return-type :non-negative-int}

  {:name :listing-max-description
   :parent :const :args {:value 2000} :return-type :non-negative-int}

  ;; --- the inputs, nil-safe ---
  {:name :_lst-kind
   :parent :coalesce
   :args {:value {:as :kind :type :nullable-text} :default {:value "fns"}}}

  {:name :_lst-kind-ok?
   :description "`|`-delimited membership — a pure string test, no HOF closure."
   :parent :str-contains?
   :args {:string {:parent :str-join
                   :args {:coll [{:value "|"}
                                 {:parent :str-join :args {:coll :listing-kinds :separator {:value "|"}}}
                                 {:value "|"}]
                          :separator {:value ""}}}
          :substring {:parent :str-join :args {:coll [{:value "|"} :_lst-kind {:value "|"}] :separator {:value ""}}}}}

  {:name :_lst-category-raw
   :parent :str-lower
   :args {:string {:parent :str-trim
                   :args {:string {:parent :to-str :args {:value {:as :category :type :nullable-text}}}}}}}

  {:name :_lst-category-blank?
   :parent :empty? :args {:coll :_lst-category-raw}}

  {:name :_lst-category
   :description "The category, or nil when none was given."
   :parent :if
   :args {:test :_lst-category-blank? :then {:value nil} :else :_lst-category-raw}}

  ;; The vocabulary's string keys come back KEYWORDISED from the jsonb
  ;; round-trip (a literal map on a const) — look up by keyword.
  {:name :_lst-categories-for-kind
   :parent :get
   :args {:coll :listing-categories :key {:parent :str-to-keyword :args {:string :_lst-kind}} :default {:value []}}}

  {:name :_lst-category-ok?
   :parent :or
   :args {:values [:_lst-category-blank?
                   {:parent :str-contains?
                    :args {:string {:parent :str-join
                                    :args {:coll [{:value "|"}
                                                  {:parent :str-join :args {:coll :_lst-categories-for-kind :separator {:value "|"}}}
                                                  {:value "|"}]
                                           :separator {:value ""}}}
                           :substring {:parent :str-join :args {:coll [{:value "|"} :_lst-category-raw {:value "|"}] :separator {:value ""}}}}}]}}

  ;; tags: a comma-separated string (every API takes the same shape —
  ;; the form field, the JSON body, the ns-publish popover) → trimmed,
  ;; lower-cased, restricted to [a-z0-9-], non-empty, distinct, capped.
  {:name :_lst-tag-clean
   :parent :re-replace
   :args {:string {:parent :str-lower :args {:string {:parent :str-trim :args {:string {:parent :to-str :args {:value {:as :item}}}}}}}
          :pattern {:value "[^a-z0-9-]"}
          :replacement {:value ""}}}

  {:name :_lst-tag-keep?
   :parent :not :args {:value {:parent :empty? :args {:coll {:as :item}}}}}

  {:name :_lst-tags-split
   :parent :str-split
   :args {:string {:parent :to-str :args {:value {:as :tags :type :nullable-text}}}
          :separator {:value ","}}}

  {:name :_lst-tags
   :parent :take
   :args {:count :listing-max-tags
          :coll {:parent :distinct
                 :args {:coll {:parent :filter
                               :args {:pred :_lst-tag-keep?
                                      :coll {:parent :map :args {:func :_lst-tag-clean :coll :_lst-tags-split}}}}}}}}

  {:name :_lst-description-raw
   :parent :str-clip
   :args {:string {:parent :str-trim :args {:string {:parent :to-str :args {:value {:as :description :type :nullable-text}}}}}
          :limit :listing-max-description}}

  {:name :_lst-description
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_lst-description-raw}}
          :then {:value nil}
          :else :_lst-description-raw}}

  {:name :_lst-error
   :description "nil, or the refusal reason — `bad-kind` / `bad-category`."
   :parent :cond
   :args {:clauses [{:parent :not :args {:value :_lst-kind-ok?}} {:value "bad-kind"}
                    {:parent :not :args {:value :_lst-category-ok?}} {:value "bad-category"}
                    {:value true} {:value nil}]}}

  {:name :listing-normalize
   :description "Normalise a marketplace listing — `{:kind :description :category :tags :payload :error}`: kind defaults to `fns`, category lower-cased and checked against the kind's vocabulary, tags parsed from a comma string ([a-z0-9-], distinct, ≤ 10), description trimmed + clipped. `:error` is nil or the refusal reason (`bad-kind` / `bad-category`); `:listing-invalid?` reads it."
   :parent :zipmap
   :args {:keys [{:value :kind} {:value :description} {:value :category} {:value :tags} {:value :payload} {:value :error}]
          :vals [:_lst-kind :_lst-description :_lst-category
                 {:parent :vec :args {:coll :_lst-tags}}
                 {:as :payload :type :nullable-keyword-map}
                 :_lst-error]}
   :return-type {:kind :text :description :nullable-text :category :nullable-text
                 :tags [:list :text] :payload :nullable-keyword-map :error :nullable-text}}

  {:name :listing-invalid?
   :description "True when a normalised listing carries an `:error`."
   :parent :some?
   :args {:value {:parent :get :args {:coll {:as :listing :type :keyword-map} :key {:value :error} :default nil}}}}

  {:name :listing-error-envelope
   :description "The `{:ok false :reason …}` envelope for an invalid listing."
   :parent :zipmap
   :args {:keys [{:value :ok} {:value :reason}]
          :vals [{:value false}
                 {:parent :get :args {:coll {:as :listing :type :keyword-map} :key {:value :error} :default nil}}]}}

  ;; --- GET /api/marketplace/categories — the vocabulary, for the editor's
  ;;     publish forms (one source of truth: the graph const above) ---
  {:name :_mk-categories-handler
   :lambda-params []
   :description "Ring handler for GET /api/marketplace/categories — `:listing-categories` as JSON."
   :parent :json-handler
   :args {:data :listing-categories}}

  {:name :api-marketplace-categories
   :description "GET /api/marketplace/categories — `{kind [category …]}`, the listing vocabulary the publish forms offer. Auth-required."
   :parent :get-auth-required
   :args {:path "/marketplace/categories" :handler :_mk-categories-handler}}

  ;; =====================================================================
  ;; CARDS — one per package name, over the registry index
  ;; =====================================================================

  ;; --- row accessors (`:item` = one index entry) ---
  {:name :_mkr-name
   :parent :get :args {:coll {:as :item} :key {:value :name} :default {:value ""}}}
  {:name :_mkr-version
   :parent :get :args {:coll {:as :item} :key {:value :version} :default {:value ""}}}
  {:name :_mkr-rank
   :parent :semver-rank :args {:version :_mkr-version}}

  ;; --- reviews → `{name {:count n :avg x}}` (one query, captured once) ---
  {:name :_mk-review-rows
   :parent :query-entities
   :args {:entity-type {:value "package-review"} :where {:value {}}}}

  {:name :_mkv-package-name
   :parent :get :args {:coll {:as :item} :key {:value :package-name} :default {:value ""}}}

  {:name :_mkv-rating
   :parent :get :args {:coll {:as :item} :key {:value :rating} :default {:value 0}}}

  ;; `:value` = one group's review rows
  {:name :_mkv-count
   :parent :count :args {:coll {:as :value}}}
  {:name :_mkv-sum
   :parent :add
   :args {:nums {:ref :_mkv-ratings :type [:list :numeric]}}}
  {:name :_mkv-ratings
   :parent :map :args {:func :_mkv-rating :coll {:as :value}}}
  {:name :_mkv-avg
   :parent :round
   :args {:number {:parent :div :args {:nums [:_mkv-sum :_mkv-count]}} :decimals {:value 1}}}
  {:name :_mkv-agg
   :parent :zipmap
   :args {:keys [{:value :count} {:value :avg}] :vals [:_mkv-count :_mkv-avg]}}

  {:name :marketplace-review-map
   :description "`{package-name {:count n :avg x}}` over every visible review — one query, aggregated in the graph."
   :parent :update-vals
   :args {:m {:parent :group-by :args {:key-fn :_mkv-package-name :coll :_mk-review-rows}}
          :f :_mkv-agg}}

  ;; --- installs → `{name installs}` ---
  {:name :_mk-stat-rows
   :parent :query-entities
   :args {:entity-type {:value "package-stat"} :where {:value {}}}}

  {:name :_mks-pair
   :parent :vec
   :args {:coll [{:parent :get :args {:coll {:as :item} :key {:value :package-name} :default {:value ""}}}
                 {:parent :get :args {:coll {:as :item} :key {:value :installs} :default {:value 0}}}]}}

  {:name :marketplace-install-map
   :description "`{package-name installs}` — the global cumulative install counters."
   :parent :into
   :args {:to {:value {}}
          :from {:parent :map :args {:func :_mks-pair :coll :_mk-stat-rows}}}}

  ;; --- the card (`:item` = one package's index rows; `:reviews` / `:installs` captured) ---
  {:name :_mkc-sorted-desc
   :description "The package's rows newest version first."
   :parent :reverse
   :args {:coll {:parent :sort-by :args {:key-fn :_mkr-rank :coll {:as :item}}}}}

  {:name :_mkc-latest
   :parent :first :args {:coll :_mkc-sorted-desc}}

  {:name :_mkc-name
   :parent :get :args {:coll :_mkc-latest :key {:value :name} :default {:value ""}}}

  ;; A MIRROR (`:origin` set on the latest row) shows its origin's signals,
  ;; never local ones: the origin is the one authority for the package's
  ;; reviews (docs/MARKETPLACE.md § 7).
  {:name :_mkc-origin
   :parent :get :args {:coll :_mkc-latest :key {:value :origin} :default nil}}
  {:name :_mkc-mirrored?
   :parent :some? :args {:value :_mkc-origin}}
  {:name :_mkc-rating
   :parent :if
   :args {:test :_mkc-mirrored?
          :then {:parent :get :args {:coll :_mkc-origin :key {:value :rating} :default nil}}
          :else {:parent :get :args {:coll {:as :reviews :type [:map :text :any]} :key :_mkc-name :default nil}}}}

  {:name :_mkc-installs
   :parent :if
   :args {:test :_mkc-mirrored?
          :then {:parent :get :args {:coll :_mkc-origin :key {:value :installs} :default {:value 0}}}
          :else {:parent :get :args {:coll {:as :installs :type [:map :text :any]} :key :_mkc-name :default {:value 0}}}}}

  {:name :marketplace-card
   :description "One marketplace card from a package's index rows: `{:name :kind :description :category :tags :org-id :public :latest :versions :version-count :published-at :fn-count :rating {:count :avg} | nil :installs :origin}`. `:reviews` / `:installs` are the captured aggregate maps; a mirror (`:origin` set) reports the origin's rating / installs instead."
   :parent :zipmap
   :args {:keys [{:value :name} {:value :kind} {:value :description} {:value :category} {:value :tags}
                 {:value :org-id} {:value :public} {:value :latest} {:value :versions} {:value :version-count}
                 {:value :published-at} {:value :fn-count} {:value :rating} {:value :installs} {:value :origin}]
          :vals [:_mkc-name
                 {:parent :get :args {:coll :_mkc-latest :key {:value :kind} :default {:value "fns"}}}
                 {:parent :get :args {:coll :_mkc-latest :key {:value :description} :default nil}}
                 {:parent :get :args {:coll :_mkc-latest :key {:value :category} :default nil}}
                 {:parent :get :args {:coll :_mkc-latest :key {:value :tags} :default {:value []}}}
                 {:parent :get :args {:coll :_mkc-latest :key {:value :org-id} :default nil}}
                 {:parent :get :args {:coll :_mkc-latest :key {:value :public} :default nil}}
                 {:parent :get :args {:coll :_mkc-latest :key {:value :version} :default {:value ""}}}
                 {:parent :map :args {:func :_mkr-version :coll :_mkc-sorted-desc}}
                 {:parent :count :args {:coll {:as :item}}}
                 {:parent :get :args {:coll :_mkc-latest :key {:value :published-at} :default {:value ""}}}
                 {:parent :get :args {:coll :_mkc-latest :key {:value :fn-count} :default {:value 0}}}
                 :_mkc-rating
                 :_mkc-installs
                 :_mkc-origin]}}

  {:name :marketplace-cards
   :description "Every visible package as a card — the registry index grouped by name, each group folded by `:marketplace-card` with the review / install aggregates captured once."
   :parent :map
   :args {:func :marketplace-card
          :coll {:parent :vals :args {:map {:parent :group-by :args {:key-fn :_mkr-name :coll :list-package-versions}}}}
          :reviews :marketplace-review-map
          :installs :marketplace-install-map}}

  ;; =====================================================================
  ;; FILTERS — kind / q / category / tag / mine / sort, read off the request
  ;; =====================================================================

  {:name :_mkq-param
   :description "A query param as trimmed text (\"\" when absent). Free args: `:request`, `:param-name`."
   :parent :str-trim
   :args {:string {:parent :to-str
                   :args {:value {:parent :query-param :args {:request {:as :request} :param-name {:as :param-name}}}}}}}

  {:name :_mkq-kind-raw
   :parent :_mkq-param :args {:param-name {:value "kind"}}}
  {:name :_mkq-kind
   :description "The kind tab — `fns` by default; `executor` is the roster tab, not a listing kind."
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_mkq-kind-raw}} :then {:value "fns"} :else :_mkq-kind-raw}}
  {:name :_mkq-q
   :parent :str-lower :args {:string {:parent :_mkq-param :args {:param-name {:value "q"}}}}}
  {:name :_mkq-category
   :parent :str-lower :args {:string {:parent :_mkq-param :args {:param-name {:value "category"}}}}}
  {:name :_mkq-tag
   :parent :str-lower :args {:string {:parent :_mkq-param :args {:param-name {:value "tag"}}}}}
  {:name :_mkq-sort-raw
   :parent :_mkq-param :args {:param-name {:value "sort"}}}
  {:name :_mkq-sort
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_mkq-sort-raw}} :then {:value "rating"} :else :_mkq-sort-raw}}
  {:name :_mkq-mine?
   :parent :equal?
   :args {:a {:parent :_mkq-param :args {:param-name {:value "mine"}}} :b {:value "1"}}}

  ;; --- predicates over a card (`:item`), the parameter captured ---
  {:name :_mkf-card-kind
   :parent :to-str :args {:value {:parent :get :args {:coll {:as :item} :key {:value :kind} :default {:value "fns"}}}}}
  {:name :_mkf-kind?
   :parent :equal? :args {:a :_mkf-card-kind :b {:as :kind :type :text}}}

  {:name :_mkf-category?
   :parent :equal? :args {:a :_mkh-card-category-val :b {:as :category :type :text}}}

  {:name :_mkf-card-tags-blob
   :description "`|tag|tag|` — membership by delimiter."
   :parent :str-join
   :args {:coll [{:value "|"}
                 {:parent :str-join :args {:coll {:parent :get :args {:coll {:as :item} :key {:value :tags} :default {:value []}}} :separator {:value "|"}}}
                 {:value "|"}]
          :separator {:value ""}}}
  {:name :_mkf-tag?
   :parent :str-contains?
   :args {:string :_mkf-card-tags-blob
          :substring {:parent :str-join :args {:coll [{:value "|"} {:as :tag :type :text} {:value "|"}] :separator {:value ""}}}}}

  {:name :_mkf-card-search-blob
   :description "name + description + tags, lower-cased — what the search box matches against."
   :parent :str-lower
   :args {:string {:parent :str-join
                   :args {:coll [{:parent :get :args {:coll {:as :item} :key {:value :name} :default {:value ""}}}
                                 {:parent :to-str :args {:value {:parent :get :args {:coll {:as :item} :key {:value :description} :default {:value ""}}}}}
                                 {:parent :str-join :args {:coll {:parent :get :args {:coll {:as :item} :key {:value :tags} :default {:value []}}} :separator {:value " "}}}]
                          :separator {:value " "}}}}}
  {:name :_mkf-q?
   :parent :str-contains? :args {:string :_mkf-card-search-blob :substring {:as :q :type :text}}}

  {:name :_mkf-mine?
   :parent :equal?
   :args {:a {:parent :to-str :args {:value {:parent :get :args {:coll {:as :item} :key {:value :org-id} :default {:value ""}}}}}
          :b :current-org-id}}

  ;; --- the filter chain (each stage skipped when its param is blank) ---
  ;; `kind=any` lists every kind — what a REMOTE mirror asks for
  ;; (`:remote-package-card`) when it does not yet know the package's kind.
  {:name :_mkf-by-kind
   :parent :if
   :args {:test {:parent :equal? :args {:a :_mkq-kind :b {:value "any"}}}
          :then :marketplace-cards
          :else {:parent :filter :args {:pred :_mkf-kind? :coll :marketplace-cards :kind :_mkq-kind}}}}
  {:name :_mkf-by-mine
   :parent :if
   :args {:test :_mkq-mine?
          :then {:parent :filter :args {:pred :_mkf-mine? :coll :_mkf-by-kind}}
          :else :_mkf-by-kind}}
  {:name :_mkf-by-category
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_mkq-category}}
          :then :_mkf-by-mine
          :else {:parent :filter :args {:pred :_mkf-category? :coll :_mkf-by-mine :category :_mkq-category}}}}
  {:name :_mkf-by-tag
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_mkq-tag}}
          :then :_mkf-by-category
          :else {:parent :filter :args {:pred :_mkf-tag? :coll :_mkf-by-category :tag :_mkq-tag}}}}
  {:name :_mkf-by-q
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_mkq-q}}
          :then :_mkf-by-tag
          :else {:parent :filter :args {:pred :_mkf-q? :coll :_mkf-by-tag :q :_mkq-q}}}}

  ;; --- sort keys ---
  {:name :_mks-key-installs
   :parent :get :args {:coll {:as :item} :key {:value :installs} :default {:value 0}}}
  {:name :_mks-key-recent
   :description "`:published-at` is already ISO text on a card (the index stringified it) — sortable as is."
   :parent :get :args {:coll {:as :item} :key {:value :published-at} :default {:value ""}}}
  {:name :_mks-key-name
   :parent :get :args {:coll {:as :item} :key {:value :name} :default {:value ""}}}

  {:name :_mks-by-rating
   :parent :reverse :args {:coll {:parent :sort-by :args {:key-fn :_mkh-card-rating-avg :coll :_mkf-by-q}}}}
  {:name :_mks-by-installs
   :parent :reverse :args {:coll {:parent :sort-by :args {:key-fn :_mks-key-installs :coll :_mkf-by-q}}}}
  {:name :_mks-by-recent
   :parent :reverse :args {:coll {:parent :sort-by :args {:key-fn :_mks-key-recent :coll :_mkf-by-q}}}}
  {:name :_mks-by-name
   :parent :sort-by :args {:key-fn :_mks-key-name :coll :_mkf-by-q}}

  {:name :marketplace-listing
   :description "The cards the request asks for — `kind` (default fns) / `mine=1` / `category` / `tag` / `q` filters, then `sort` (`rating` default, `installs`, `recent`, `name`). Free arg: `:request`."
   :parent :cond
   :args {:clauses [{:parent :equal? :args {:a :_mkq-sort :b {:value "installs"}}} :_mks-by-installs
                    {:parent :equal? :args {:a :_mkq-sort :b {:value "recent"}}} :_mks-by-recent
                    {:parent :equal? :args {:a :_mkq-sort :b {:value "name"}}} :_mks-by-name
                    {:value true} :_mks-by-rating]}}

  ;; --- GET /api/marketplace — the listing as JSON ---
  {:name :_mk-index-handler
   :lambda-params [:request]
   :description "Ring handler for GET /api/marketplace — the filtered, sorted cards as a JSON array."
   :parent :json-handler
   :args {:data :marketplace-listing}}

  {:name :api-marketplace-index
   :description "GET /api/marketplace?kind=&q=&category=&tag=&sort=&mine= — marketplace cards (one per package: latest, versions, rating, installs, listing). Auth-required."
   :parent :get-auth-required
   :args {:path "/marketplace" :handler :_mk-index-handler}}

  ;; =====================================================================
  ;; RENDER HELPERS
  ;; =====================================================================

  {:name :_mk-stars-n
   :description "The rating rounded to whole stars (0–5)."
   :parent :round :args {:number {:as :rating :type :numeric} :decimals {:value 0}}}
  {:name :_mk-stars-start
   :parent :sub :args {:nums [{:value 5} :_mk-stars-n]}}
  {:name :_mk-stars-end
   :parent :sub :args {:nums [{:value 10} :_mk-stars-n]}}
  {:name :_mk-stars
   :description "`★★★☆☆` for a 0–5 rating (rounded) — a fixed 10-glyph strip windowed by the rating. Free arg: `:rating`."
   :parent :subs
   :args {:string {:value "★★★★★☆☆☆☆☆"}
          :start {:ref :_mk-stars-start :type :int}
          :end {:ref :_mk-stars-end :type :int}}}

  {:name :_mk-url-name
   :parent :url-encode :args {:string {:as :pkg-name :type :text}}}


  ;; --- one card ---
  {:name :_mkh-card-name
   :parent :get :args {:coll {:as :item} :key {:value :name} :default {:value ""}}}
  {:name :_mkh-card-kind
   :parent :get :args {:coll {:as :item} :key {:value :kind} :default {:value "fns"}}}
  {:name :_mkh-card-open-url
   :parent :str-join
   :args {:coll [{:value "/partials/marketplace/item?name="} {:parent :url-encode :args {:string :_mkh-card-name}}]
          :separator {:value ""}}}
  {:name :_mkh-card-title
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:parent :assoc
                  :args {:map {:value {:type "button" :class "mk-card-open"}}
                         :key {:value :hx-get} :value :_mkh-card-open-url}}
          :children [{:parent :hiccup :args {:tag {:value "span"} :attrs {:value {:class "mk-card-name"}} :children [:_mkh-card-name]}}
                     {:parent :hiccup :args {:tag {:value "span"} :attrs {:value {:class "mk-card-latest"}}
                                             :children [{:parent :get :args {:coll {:as :item} :key {:value :latest} :default {:value ""}}}]}}]}}
  {:name :_mkh-card-rating
   :parent :get :args {:coll {:as :item} :key {:value :rating} :default nil}}
  {:name :_mkh-card-rating-avg
   :parent :get-in :args {:map {:as :item} :path [{:value :rating} {:value :avg}] :default {:value 0}}}
  {:name :_mkh-card-rating-el
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "mk-rating" :title "Average rating (reviews)"}}
          :children [{:parent :_mk-stars :args {:rating :_mkh-card-rating-avg}}
                     {:value " "}
                     {:parent :to-str :args {:value :_mkh-card-rating-avg}}
                     {:value " ("}
                     {:parent :to-str :args {:value {:parent :get-in :args {:map {:as :item} :path [{:value :rating} {:value :count}] :default {:value 0}}}}}
                     {:value ")"}]}}
  {:name :_mkh-card-rating-maybe
   :parent :if
   :args {:test {:parent :nil? :args {:value :_mkh-card-rating}}
          :then {:parent :hiccup :args {:tag {:value "span"} :attrs {:value {:class "mk-rating mk-rating-none"}} :children [{:value "no reviews yet"}]}}
          :else :_mkh-card-rating-el}}
  {:name :_mkh-card-installs
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "mk-installs" :title "Installs"}}
          :children [{:value "↓ "} {:parent :to-str :args {:value {:parent :get :args {:coll {:as :item} :key {:value :installs} :default {:value 0}}}}}]}}
  {:name :_mkh-card-versions
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:value {:class "mk-versions"}}
          :children [{:parent :to-str :args {:value {:parent :get :args {:coll {:as :item} :key {:value :version-count} :default {:value 0}}}}}
                     {:value " version(s)"}]}}
  {:name :_mkh-card-category-val
   :parent :to-str :args {:value {:parent :get :args {:coll {:as :item} :key {:value :category} :default {:value ""}}}}}
  {:name :_mkh-card-category
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_mkh-card-category-val}}
          :then {:value nil}
          :else {:parent :hiccup :args {:tag {:value "span"} :attrs {:value {:class "mk-category"}} :children [:_mkh-card-category-val]}}}}
  {:name :_mkh-card-origin-url
   :parent :to-str
   :args {:value {:parent :get-in :args {:map {:as :item} :path [{:value :origin} {:value :url}] :default {:value ""}}}}}
  {:name :_mkh-card-mirror
   :description "`mirror of <url>` on a card whose latest version was pulled from another registry — its rating / installs are the origin's."
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_mkh-card-origin-url}}
          :then {:value nil}
          :else {:parent :hiccup :args {:tag {:value "span"} :attrs {:value {:class "mk-mirror" :title "Mirrored from another registry — its rating and installs are the origin's"}}
                                        :children [{:value "mirror of "} :_mkh-card-origin-url]}}}}
  {:name :_mkh-card-private
   :parent :if
   :args {:test {:parent :equal? :args {:a {:parent :get :args {:coll {:as :item} :key {:value :public} :default nil}} :b {:value false}}}
          :then {:parent :hiccup :args {:tag {:value "span"} :attrs {:value {:class "packages-private-badge"}} :children [{:value "private"}]}}
          :else {:value nil}}}
  {:name :_mkh-card-desc-val
   :parent :str-clip
   :args {:string {:parent :to-str :args {:value {:parent :get :args {:coll {:as :item} :key {:value :description} :default {:value ""}}}}}
          :limit {:value 160}}}
  {:name :_mkh-card-desc
   :parent :hiccup
   :args {:tag {:value "p"} :attrs {:value {:class "mk-card-desc"}} :children [:_mkh-card-desc-val]}}

  ;; tag chip (`:item` = a tag string; `:kind` captured for the URL)
  {:name :_mkh-tag-url
   :parent :str-join
   :args {:coll [{:value "/partials/marketplace?kind="} {:parent :url-encode :args {:string {:as :kind :type :text}}}
                 {:value "&tag="} {:parent :url-encode :args {:string {:parent :to-str :args {:value {:as :item}}}}}]
          :separator {:value ""}}}
  {:name :_mkh-tag-chip
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:parent :assoc
                  :args {:map {:value {:type "button" :class "mk-tag" :title "Filter by this tag"}}
                         :key {:value :hx-get} :value :_mkh-tag-url}}
          :children [{:value "#"} {:parent :to-str :args {:value {:as :item}}}]}}
  {:name :_mkh-card-tags
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "mk-tags"}}
          :children {:parent :map :args {:func :_mkh-tag-chip
                                         :coll {:parent :get :args {:coll {:as :item} :key {:value :tags} :default {:value []}}}
                                         :kind :_mkh-card-kind}}}}

  {:name :marketplace-card-html
   :description "One `article.mk-card` — name + latest (opens the item), category / private badges, rating, installs, version count, description, tag chips."
   :parent :hiccup
   :args {:tag {:value "article"}
          :attrs {:parent :assoc
                  :args {:map {:value {:class "mk-card"}} :key {:value :data-mk-card} :value :_mkh-card-name}}
          :children [:_mkh-card-title
                     {:parent :hiccup :args {:tag {:value "div"} :attrs {:value {:class "mk-card-meta"}}
                                             :children [:_mkh-card-category :_mkh-card-private :_mkh-card-mirror :_mkh-card-rating-maybe :_mkh-card-installs :_mkh-card-versions]}}
                     :_mkh-card-desc
                     :_mkh-card-tags]}}

  ;; --- toolbar ---
  ;; kind tabs (`:item` = ["kind" "Label"]; `:kind` = the current one)
  {:name :_mkt-tab-value
   :parent :first :args {:coll {:as :item}}}
  {:name :_mkt-tab-checked?
   :parent :equal? :args {:a {:parent :to-str :args {:value :_mkt-tab-value}} :b {:as :kind :type :text}}}
  {:name :_mkt-tab-input
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:parent :assoc
                  :args {:map {:parent :assoc
                               :args {:map {:value {:type "radio" :name "kind" :class "mk-tab-input"}}
                                      :key {:value :value} :value :_mkt-tab-value}}
                         :key {:value :checked} :value :_mkt-tab-checked?}}}}
  {:name :_mkt-tab
   :parent :hiccup
   :args {:tag {:value "label"}
          :attrs {:parent :assoc
                  :args {:map {:value {:class "mk-tab"}} :key {:value :data-mk-tab} :value :_mkt-tab-value}}
          :children [:_mkt-tab-input
                     {:parent :hiccup :args {:tag {:value "span"}
                                             :children [{:parent :first :args {:coll {:parent :reverse :args {:coll {:as :item}}}}}]}}]}}
  {:name :_mkt-tabs
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "mk-tabs" :role "tablist" :aria-label "Marketplace kinds"}}
          :children {:parent :map
                     :args {:func :_mkt-tab
                            :coll {:value [["fns" "Packages"] ["theme" "Themes"] ["keymap" "Keymaps"] ["executor" "Executor"]]}
                            :kind :_mkq-kind}}}}

  {:name :_mkt-search
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:parent :assoc
                  :args {:map {:value {:type "search" :name "q" :class "mk-search" :placeholder "Search packages, themes, keymaps…"
                                       :aria-label "Search the marketplace" :autocomplete "off"}}
                         :key {:value :value} :value :_mkq-q}}}}

  ;; category options (`:item` = a category; `:category` = the current)
  {:name :_mkt-cat-option
   :parent :hiccup
   :args {:tag {:value "option"}
          :attrs {:parent :assoc
                  :args {:map {:parent :assoc :args {:map {:value {}} :key {:value :value} :value {:parent :to-str :args {:value {:as :item}}}}}
                         :key {:value :selected} :value {:parent :equal? :args {:a {:parent :to-str :args {:value {:as :item}}} :b {:as :category :type :text}}}}}
          :children [{:parent :to-str :args {:value {:as :item}}}]}}
  ;; "All categories" first — its own fn-def and a `:list` head: an inline
  ;; anonymous fn nested inside a vector literal is not resolved as a ref
  ;; (it rendered as its `_anon-…` name), so the head is composed, not
  ;; written in place.
  {:name :_mkt-cat-all-option
   :parent :hiccup
   :args {:tag {:value "option"} :attrs {:value {:value ""}} :children [{:value "All categories"}]}}
  {:name :_mkt-cat-head
   :parent :list :args {:items [:_mkt-cat-all-option]}}
  {:name :_mkt-cat-options
   :parent :map
   :args {:func :_mkt-cat-option
          :coll {:parent :get :args {:coll :listing-categories
                                     :key {:parent :str-to-keyword :args {:string :_mkq-kind}}
                                     :default {:value []}}}
          :category :_mkq-category}}
  {:name :_mkt-cat-select
   :parent :hiccup
   :args {:tag {:value "select"}
          :attrs {:value {:name "category" :class "mk-select" :aria-label "Category"}}
          :children {:parent :concat :args {:colls [:_mkt-cat-head :_mkt-cat-options]}}}}

  ;; sort options (`:item` = ["key" "Label"]; `:sort` = the current)
  {:name :_mkt-sort-option
   :parent :hiccup
   :args {:tag {:value "option"}
          :attrs {:parent :assoc
                  :args {:map {:parent :assoc :args {:map {:value {}} :key {:value :value} :value {:parent :first :args {:coll {:as :item}}}}}
                         :key {:value :selected} :value {:parent :equal? :args {:a {:parent :to-str :args {:value {:parent :first :args {:coll {:as :item}}}}} :b {:as :sort :type :text}}}}}
          :children [{:parent :first :args {:coll {:parent :reverse :args {:coll {:as :item}}}}}]}}
  {:name :_mkt-sort-select
   :parent :hiccup
   :args {:tag {:value "select"}
          :attrs {:value {:name "sort" :class "mk-select" :aria-label "Sort"}}
          :children {:parent :map
                     :args {:func :_mkt-sort-option
                            :coll {:value [["rating" "Top rated"] ["installs" "Most installed"] ["recent" "Recently published"] ["name" "Name"]]}
                            :sort :_mkq-sort}}}}

  {:name :_mkt-tag-hidden
   :parent :hiccup
   :args {:tag {:value "input"}
          :attrs {:parent :assoc :args {:map {:value {:type "hidden" :name "tag"}} :key {:value :value} :value :_mkq-tag}}}}
  {:name :_mkt-tag-clear-url
   :parent :str-join
   :args {:coll [{:value "/partials/marketplace?kind="} {:parent :url-encode :args {:string :_mkq-kind}}
                 {:value "&category="} {:parent :url-encode :args {:string :_mkq-category}}
                 {:value "&sort="} {:parent :url-encode :args {:string :_mkq-sort}}]
          :separator {:value ""}}}
  {:name :_mkt-tag-active
   :parent :if
   :args {:test {:parent :empty? :args {:coll :_mkq-tag}}
          :then {:value nil}
          :else {:parent :hiccup
                 :args {:tag {:value "button"}
                        :attrs {:parent :assoc
                                :args {:map {:value {:type "button" :class "mk-tag mk-tag-active" :title "Clear the tag filter"}}
                                       :key {:value :hx-get} :value :_mkt-tag-clear-url}}
                        :children [{:value "#"} :_mkq-tag {:value " ×"}]}}}}

  {:name :_mkt-controls
   :description "Search + category + sort — hidden on the Executor tab (a roster has none)."
   :parent :if
   :args {:test {:parent :equal? :args {:a :_mkq-kind :b {:value "executor"}}}
          :then {:value nil}
          :else {:parent :hiccup
                 :args {:tag {:value "div"} :attrs {:value {:class "mk-controls"}}
                        :children [:_mkt-search :_mkt-cat-select :_mkt-sort-select :_mkt-tag-hidden :_mkt-tag-active]}}}}

  {:name :marketplace-toolbar
   :description "The listing toolbar — a `form` htmx re-GETs on any change (kind tabs, search with a 300 ms debounce, category, sort; the active tag rides a hidden input)."
   :parent :hiccup
   :args {:tag {:value "form"}
          :attrs {:value {:class "mk-toolbar"
                          :hx-get "/partials/marketplace"
                          :hx-trigger "change, keyup changed delay:300ms from:[name=q], submit"
                          :role "search"}}
          :children [:_mkt-tabs :_mkt-controls]}}

  ;; --- results ---
  {:name :_mk-cards-grid
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "mk-grid"}}
          :children {:parent :map :args {:func :marketplace-card-html :coll :marketplace-listing}}}}
  {:name :_mk-empty
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "mk-empty"}}
          :children [{:value "Nothing here yet — publish a namespace (⬆ on a namespace row), or save a theme / keyboard layout from Settings and share it."}]}}
  {:name :_mk-results
   :parent :if
   :args {:test {:parent :empty? :args {:coll :marketplace-listing}}
          :then :_mk-empty
          :else :_mk-cards-grid}}

  ;; --- the Executor roster (Type-2 / bundled packages of THIS executor) ---
  {:name :_mkx-cell
   :parent :hiccup :args {:tag {:value "td"} :children [{:parent :to-str :args {:value {:parent :get :args {:coll {:as :item} :key {:as :key} :default {:value ""}}}}}]}}
