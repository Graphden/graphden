  {:name :_partial-stats-handler
   :lambda-params [:request]
   :description "Ring handler for GET /partials/stats?days=7|30|90 — the current org's run statistics as text/html (headline, period switcher, per-day trend with CSS bars, top-fns; plus the operator-only by-org section). Auth-required (route side); org-scoped by construction (every rollup base-fn reads the CURRENT org only; the cross-org read returns [] for tenants impl-side)."
   :parent :html-ok-response
   :args {:body :_pstats-html}}

  ;; ---------------------------------------------------------------------
  ;; SETTINGS partials (round-4 audit) — the two dynamic bodies of the
  ;; Settings surface. `/partials/settings-build` renders the deployed
  ;; backend/packages hash rows off `:build-hashes` (the same resource
  ;; `/version` serves); `/partials/settings-access` renders the
  ;; principal's capability chips off the request-scope seam — the SAME
  ;; fact the addon stamps into `X-Graphden-Capabilities`, so the copy
  ;; and the ✓/✕ logic live server-side instead of the editor re-deriving
  ;; them from response headers. editor-shell.js only mounts.
  ;; ---------------------------------------------------------------------

  {:name :request-capabilities
   :description "Membership map (`{\"write\" true …}`) of the capability names the tenancy addon computed for the CURRENT request — the same list it stamps into the `X-Graphden-Capabilities` header, read off the core seam (`graphden.tenancy.context/current-capabilities`). nil without the addon (single-tenant: everything allowed, nothing to list)."
   :args {}
   :return-type [:union :null [:map :text :bool]]}

  ;; --- Build card: one `.gd-set-ver` row per baked section hash. ---
  {:name :_setb-hash
   :parent :get
   :args {:coll :build-hashes :key {:as :section} :default {:value ""}}}

  {:name :_setb-hash12
   :description "First 12 hex chars of the section hash — or an em-dash when the build carries no hash for it (dev jars)."
   :parent :if
   :args {:test {:parent :empty? :args {:coll {:ref :_setb-hash :type :text}}}
          :then {:value "—"}
          :else {:parent :subs
                 :args {:string {:ref :_setb-hash :type :text}
                        :start {:value 0}
                        :end {:value 12}}}}}

  {:name :_setb-row
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "gd-set-ver"}}
          :children [{:parent :hiccup
                      :args {:tag {:value "span"}
                             :children [{:as :section}]}}
                     {:parent :hiccup
                      :args {:tag {:value "code"}
                             :children [:_setb-hash12]}}]}}

  {:name :_setb-rows
   :parent :list
   :args {:items [{:parent :_setb-row :args {:section "backend"}}
                  {:parent :_setb-row :args {:section "packages"}}]}}

  {:name :_setb-html
   :parent :render-hiccup
   :args {:hiccup :_setb-rows}}

  {:name :_partial-settings-build-handler
   :lambda-params []
   :description "Ring handler for GET /partials/settings-build — the Settings 'About this build' backend/packages hash rows as text/html. Static content (nothing read off the request) — `:lambda-params []`, the tutorial-page handler shape. The FRONTEND hash deliberately stays client-side (`window.BUILD_HASH` is baked into the bundle so it witnesses what the BROWSER runs — a server render would defeat its cache-staleness purpose)."
   :parent :html-ok-response
   :args {:body :_setb-html}}

  ;; --- Access card: capability chips (tenancy) or the single-tenant
  ;;     copy. The chip template exposes :label + :on frees; the two
  ;;     instances bind them to the write/execute membership reads. ---
  {:name :_seta-caps
   :description "The current request's capability membership map (nil = single-tenant)."
   :parent :request-capabilities}

  {:name :_seta-single-tenant?
   :parent :nil?
   :args {:value :_seta-caps}}

  {:name :_seta-chip-mark
   :parent :if
   :args {:test {:as :on} :then {:value "✓ "} :else {:value "✕ "}}}

  {:name :_seta-chip-onoff
   :parent :if
   :args {:test {:as :on} :then {:value "gd-cap-on"} :else {:value "gd-cap-off"}}}

  {:name :_seta-chip-class
   :parent :str
   :args {:parts [{:value "gd-cap "} :_seta-chip-onoff]}}

  {:name :_seta-chip-text
   :parent :str
   :args {:parts [:_seta-chip-mark {:as :label}]}}

  {:name :_seta-chip
   :parent :hiccup
   :args {:tag {:value "span"}
          :attrs {:parent :zipmap
                  :args {:keys [{:value :class}]
                         :vals [:_seta-chip-class]}}
          :children [:_seta-chip-text]}}

  {:name :_seta-can-write
   :parent :get
   :args {:coll :_seta-caps :key {:value "write"} :default {:value false}}}

  {:name :_seta-can-execute
   :parent :get
   :args {:coll :_seta-caps :key {:value "execute"} :default {:value false}}}

  {:name :_seta-chips
   :parent :list
   :args {:items [{:parent :_seta-chip :args {:label "write" :on :_seta-can-write}}
                  {:parent :_seta-chip :args {:label "execute" :on :_seta-can-execute}}]}}

  {:name :_seta-body
   :parent :if
   :args {:test :_seta-single-tenant?
          :then {:value [:div {:class "gd-set-hint"} "Single-tenant — every action is available."]}
          :else :_seta-chips}}

  {:name :_seta-html
   :parent :render-hiccup
   :args {:hiccup :_seta-body}}

  {:name :_partial-settings-access-handler
   :lambda-params []
   :description "Ring handler for GET /partials/settings-access — the Settings access card body as text/html: the principal's own write/execute capability chips under a tenancy addon, or the single-tenant copy without one. Nothing is read off the REQUEST MAP (`:lambda-params []`) — the per-principal fact arrives via the request-scope seam binding, not the Ring map. Shows the requester THEIR OWN capabilities (the same fact every response already carries in `X-Graphden-Capabilities`) — nothing cross-principal to leak."
   :parent :html-ok-response
   :args {:body :_seta-html}}

  ;; ---------------------------------------------------------------------
  ;; ASSETS panel (UI Step 1) — GET /partials/assets-panel. Every frontend
  ;; bundle file the platform serves, with its override status; per-row
  ;; edit loads /partials/asset-edit into the panel's editor slot; saving
  ;; POSTs /api/assets/save (upsert by path) and re-renders the panel.
  ;; Writes hit the versioned `:resource-override` entity — per-branch,
  ;; tenant-forbidden under the tenancy addon (stored-XSS surface).
  ;; ---------------------------------------------------------------------
  {:name :_passets-known-paths
   :description "Every classpath asset the override tier can shadow — the five JS bundle path lists (editor, runtime, htmx, htmx-sse, CodeMirror) plus the two standalone stylesheets. Shared `:const` lists, so this allowlist can't drift from the serve chain."
   :parent :concat
   :args {:colls [:_editor-script-paths
                  :_graphden-runtime-js-paths
                  :_htmx-js-paths
                  :_htmx-sse-js-paths
                  :_cm-js-paths
                  :_editor-css-paths
                  :_components-css-paths]}}

  ;; `:contains?` on a LIST checks indices, so membership tests go
  ;; through self-keyed maps (path → path).
  {:name :_passets-known-map
   :parent :zipmap
   :args {:keys :_passets-known-paths :vals :_passets-known-paths}}

  {:name :_passets-ro-path
   :parent :get
   :args {:coll {:as :item} :key {:value :path} :default {:value ""}}}

  {:name :_passets-ro-paths
   :parent :map
   :args {:func :_passets-ro-path :coll :_ro-all}}

  {:name :_passets-ro-by-path
   :parent :zipmap
   :args {:keys :_passets-ro-paths :vals :_passets-ro-paths}}

  {:name :_passets-orphan?
   :description "True for an override row whose path is NOT a known bundle file — inert for serving, but it still rolls the effective hash, so the panel must surface it."
   :parent :not
   :args {:value {:parent :contains?
                  :args {:coll :_passets-known-map :key {:as :item}}}}}

  {:name :_passets-orphans
   :parent :filter
   :args {:pred :_passets-orphan? :coll :_passets-ro-paths}}

  {:name :_passets-row-paths
   :parent :concat
   :args {:colls [:_passets-known-paths :_passets-orphans]}}

  {:name :_passets-row-overridden?
   :parent :contains?
   :args {:coll :_passets-ro-by-path :key {:as :item}}}

  {:name :_passets-row-chip
   :parent :if
   :args {:test :_passets-row-overridden?
          :then {:value [:span {:class "gd-asset-chip gd-asset-chip-override"} "override"]}
          :else {:value [:span {:class "gd-asset-chip"} "baseline"]}}}

  ;; htmx serializes a named button's value, so the path rides the
  ;; request without any client JS or URL-encoding of our own.
  {:name :_passets-row-edit-attrs
   :parent :assoc
   :args {:map {:value {:type "button" :name "path" :class "gd-asset-edit-btn"
                        :hx-get "/partials/asset-edit"
                        :hx-target "#gd-asset-editor" :hx-swap "innerHTML"}}
          :key {:value :value} :value {:as :item}}}

  {:name :_passets-row-edit-btn
   :parent :hiccup
   :args {:tag {:value "button"} :attrs :_passets-row-edit-attrs
          :children [{:value "edit"}]}}

  {:name :_passets-row-path-code
   :parent :hiccup
   :args {:tag {:value "code"} :attrs {:value {:class "gd-asset-path"}}
          :children [{:as :item}]}}

  {:name :_passets-row
   :description "One asset row — path, baseline/override chip, edit button."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "gd-asset-row"}}
          :children [:_passets-row-path-code :_passets-row-chip :_passets-row-edit-btn]}}

  {:name :_passets-rendered-rows
   :parent :map
   :args {:func :_passets-row :coll :_passets-row-paths}}

  {:name :_passets-root
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:data-assets-panel "1" :class "gd-assets-panel"}}
          :children [{:value [:p {:class "gd-asset-hint"}
                              "Per-branch DB overrides shadowing the shipped editor files. Saving rolls every asset URL's ?v= — reload the page to run the edited code."]}
                     {:parent :hiccup
                      :args {:tag {:value "div"}
                             :attrs {:value {:class "gd-asset-list"}}
                             :children [:_passets-rendered-rows]}}
                     {:value [:div {:id "gd-asset-editor" :class "gd-asset-editor"}]}]}}

  {:name :_passets-html
   :parent :render-hiccup
   :args {:hiccup :_passets-root}}

  {:name :_partial-assets-panel-handler
   :lambda-params []
   :description "Ring handler for GET /partials/assets-panel — the frontend-asset override panel as text/html. Auth-required (route side); writes are additionally tenant-forbidden at the storage layer."
   :parent :html-ok-response
   :args {:body :_passets-html}}

  ;; --- `?path=` — shared by asset-edit / baseline / revert -------------
  ;; `:query-param` computes `:nullable-text`; the `:coalesce` strips the
  ;; `:null` so downstream `:text`-typed path slots prove.
  {:name :_asset-path
   :parent :coalesce
   :args {:value {:parent :query-param
                  :args {:param-name {:value "path"}}}
          :default {:value ""}}}

  {:name :_pedit-override-content
   :parent :_ro-content
   :args {:asset-path :_asset-path}}

  ;; The classpath fallback reads ONLY a known bundle path — a caller
  ;; must not turn `?path=` into an arbitrary classpath read (the edit
  ;; partial is auth-required, but that gate is weaker than "one shipped
  ;; asset"; a tenant principal could otherwise slurp private source).
  {:name :_asset-known?
   :parent :contains?
   :args {:coll :_passets-known-map :key :_asset-path}}

  {:name :_asset-baseline
   :parent :if
   :args {:test :_asset-known?
          :then {:parent :coalesce
                 :args {:value {:parent :read-resource-or-nil
                                :args {:path :_asset-path}}
                        :default {:value ""}}}
          :else {:value ""}}}

  ;; Effective content for the textarea: override if present, else the
  ;; (allowlisted) classpath baseline, else "" (an orphan path has no
  ;; baseline).
  {:name :_pedit-content
   :parent :coalesce
   :args {:value :_pedit-override-content
          :default :_asset-baseline}}

  {:name :_pedit-path-input-attrs
   :parent :assoc
   :args {:map {:value {:type "hidden" :name "path"}}
          :key {:value :value} :value :_asset-path}}

  {:name :_pedit-path-input
   :parent :hiccup
   :args {:tag {:value "input"} :attrs :_pedit-path-input-attrs}}

  ;; CodeMirror language by extension. `.json` is checked BEFORE `.js`
  ;; (`.json` contains `.js` as a substring). Anything else — an orphan
  ;; `.edn`/`.html` override — gets `text`, NOT `js`, so the client's
  ;; `new Function` syntax gate (which fires only on `js`) can't make a
  ;; valid non-JS override unsaveable.
  {:name :_pedit-lang
   :description "CodeMirror language for the asset — `css` / `json` / `js` by extension, else `text` (plain, ungated)."
   :parent :cond
   :args {:clauses [{:parent :str-contains? :args {:string :_asset-path :substring {:value ".css"}}} {:value "css"}
                    {:parent :str-contains? :args {:string :_asset-path :substring {:value ".json"}}} {:value "json"}
                    {:parent :str-contains? :args {:string :_asset-path :substring {:value ".js"}}} {:value "js"}
                    {:value true} {:value "text"}]}}

  {:name :_pedit-textarea-attrs
   :parent :assoc
   :args {:map {:value {:name "content" :rows "18" :spellcheck "false"
                        :class "arg-value-edit-input value-form-hiccup gd-asset-textarea"}}
          :key {:value :data-lang}
          :value :_pedit-lang}}

  {:name :_pedit-textarea
   :parent :hiccup
   :args {:tag {:value "textarea"}
          :attrs :_pedit-textarea-attrs
          :children [:_pedit-content]}}

  {:name :_pedit-form
   :parent :hiccup
   :args {:tag {:value "form"}
          :attrs {:value {:class "gd-asset-edit-form"
                          :hx-post "/api/assets/save"
                          :hx-target "closest [data-assets-panel]"
                          :hx-swap "outerHTML"}}
          :children [:_pedit-path-input :_pedit-textarea
                     {:value [:button {:type "submit" :class "gd-asset-save-btn"}
                              "Save override"]}]}}

  ;; Revert sits OUTSIDE the form — htmx would otherwise serialize the
  ;; whole textarea into the DELETE's query string.
  {:name :_pedit-revert-attrs
   :parent :assoc
   :args {:map {:value {:type "button" :name "path" :class "gd-asset-revert-btn"
                        :hx-delete "/api/assets/revert"
                        :hx-target "closest [data-assets-panel]" :hx-swap "outerHTML"
                        :hx-confirm "Remove the override and return to the shipped baseline?"}}
          :key {:value :value} :value :_asset-path}}

  {:name :_pedit-revert-btn
   :parent :hiccup
   :args {:tag {:value "button"} :attrs :_pedit-revert-attrs
          :children [{:value "Revert to baseline"}]}}

  {:name :_pedit-revert-opt
   :parent :if
   :args {:test {:parent :some? :args {:value :_pedit-override-content}}
          :then :_pedit-revert-btn
          :else :hidden-span}}

  ;; Diff toggle — sits OUTSIDE the form (htmx must not serialize it);
  ;; editor-assets.js opens a read-only MergeView of baseline vs the
  ;; CURRENT editor content via GET /api/assets/baseline.
  {:name :_pedit-diff-btn
   :parent :hiccup
   :args {:tag {:value "button"}
          :attrs {:parent :assoc
                  :args {:map {:value {:type "button" :class "gd-asset-diff-btn"}}
                         :key {:value :data-path}
                         :value :_asset-path}}
          :children [{:value "Diff vs baseline"}]}}

  {:name :_pedit-body
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "gd-asset-edit"}}
          :children [{:parent :hiccup
                      :args {:tag {:value "code"}
                             :attrs {:value {:class "gd-asset-path"}}
                             :children [:_asset-path]}}
                     :_pedit-form :_pedit-diff-btn :_pedit-revert-opt]}}

  {:name :_pedit-html
   :parent :render-hiccup
   :args {:hiccup :_pedit-body}}

  {:name :_partial-asset-edit-handler
   :lambda-params [:request]
   :description "Ring handler for GET /partials/asset-edit?path=… — the override editor (textarea prefilled with the effective content, save form, revert-if-overridden) as text/html. Auth-required (route side)."
   :parent :html-ok-response
   :args {:body :_pedit-html}}

  ;; --- POST /api/assets/save — upsert by path, then re-render --------
  {:name :_asave-form
   :parent :parse-form-body-kw}

  {:name :_asave-path
   :parent :get
   :args {:coll :_asave-form :key {:value :path} :default {:value ""}}}

  {:name :_asave-content
   :parent :get
   :args {:coll :_asave-form :key {:value :content} :default {:value ""}}}

  {:name :_asave-existing-id
   :parent :get
   :args {:coll {:parent :_ro-row :args {:asset-path :_asave-path}}
          :key {:value :id} :default nil}}

  {:name :_asave-write
   :parent :if
   :args {:test {:parent :some? :args {:value :_asave-existing-id}}
          :then {:parent :update-entity
                 :args {:entity-type {:value "resource-override"}
                        :id :_asave-existing-id
                        :data {:parent :zipmap
                               :args {:keys [{:value :content}]
                                      :vals [:_asave-content]}}}}
          :else {:parent :create-entity
                 :args {:entity-type {:value "resource-override"}
                        :data {:parent :zipmap
                               :args {:keys [{:value :path} {:value :content}]
                                      :vals [:_asave-path :_asave-content]}}}}}}

  {:name :_asave-write-guarded
   :description "A blank path never becomes a row — a hand-crafted body without `path` is a no-op, the response is just the re-rendered panel."
   :parent :if
   :args {:test {:parent :neq :args {:values [:_asave-path {:value ""}]}}
          :then :_asave-write
          :else {:value nil}}}

  ;; No response-cache flush needed: the immutable-response cache keys on
  ;; the query string (`:_response-cache-key`), and a save rolls the
  ;; effective `?v=` hash, so the next asset request is a fresh cache key
  ;; on EVERY node — the pre-save entry is simply never requested again.
  ;; (A per-JVM flush here would only have cleared the node that handled
  ;; the POST, leaving every other node stale.)
  {:name :_asave-then-panel
   :description "Write THEN render — `:do` forces order so the refreshed panel shows the new override status."
   :parent :do
   :args {:steps [:_asave-write-guarded :_passets-html]}}

  {:name :_asave-handler
   :lambda-params [:request]
   :description "Ring handler for POST /api/assets/save — upserts the form's {path, content} as a `:resource-override` and returns the refreshed Assets panel as text/html. Auth-required; tenant writes are rejected by the storage layer."
   :parent :html-ok-response
   :args {:body :_asave-then-panel}}

  ;; --- GET /api/assets/baseline?path=… — shipped file body (diff) ---
  {:name :_abase-handler
   :lambda-params [:request]
   :description "Ring handler for GET /api/assets/baseline?path=… — the SHIPPED body of one asset as text/plain, for the panel's diff view (override vs baseline). Auth-required (route side)."
   :parent :text-ok-response
   :args {:body :_asset-baseline}}

  ;; --- DELETE /api/assets/revert?path=… — drop override, re-render ---
  {:name :_arev-id
   :parent :get
   :args {:coll {:parent :_ro-row :args {:asset-path :_asset-path}}
          :key {:value :id} :default nil}}

  {:name :_arev-delete
   :parent :if
   :args {:test {:parent :some? :args {:value :_arev-id}}
          :then {:parent :delete-entity
                 :args {:entity-type {:value "resource-override"} :id :_arev-id}}
          :else {:value false}}}

  {:name :_arev-then-panel
   :parent :do
   :args {:steps [:_arev-delete :_passets-html]}}

  {:name :_arev-handler
   :lambda-params [:request]
   :description "Ring handler for DELETE /api/assets/revert?path=… — soft-deletes the path's `:resource-override` (baseline resumes, hash rolls back) and returns the refreshed Assets panel as text/html. Auth-required."
   :parent :html-ok-response
   :args {:body :_arev-then-panel}}]}
