                     :class "type-explainer-close"
                     :data-explainer-close "1"
                     :aria-label "Close effect explainer"} "×"]]}}

  {:name :_partial-effect-description-div
   :description "`<div class=\"type-explainer-human\">{description}</div>` — one-line natural-language description of the effect."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "type-explainer-human"}}
          :children [:_partial-effect-description]}}

  {:name :_partial-effect-structural-div
   :description "`<div class=\"type-explainer-structural\">{:effect-tag}</div>` — canonical effect tag in the structural row."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "type-explainer-structural"}}
          :children [:_partial-effect-structural-text]}}

  {:name :_partial-effect-fragment
   :description "Full hiccup fragment for one effect's popover — header + description + structural row, wrapped in the `.type-explainer-content` container."
   :parent :hiccup
   :args {:tag {:value "div"}
          :attrs {:value {:class "type-explainer-content"}}
          :children [:_partial-effect-header
                     :_partial-effect-description-div
                     :_partial-effect-structural-div]}}

  {:name :_partial-effect-html
   :description "Rendered HTML string for the effect-explainer fragment."
   :parent :render-hiccup
   :args {:hiccup :_partial-effect-fragment}}

  {:name :_partial-effect-handler
   :lambda-params [:request]
   :description "Ring handler for `GET /partials/effect?effect=<tag>` — returns the popover hiccup as `text/html`. JS swaps the response body into the explainer mount-point and handles positioning + dismissal."
   :parent :html-ok-response
   :args {:body :_partial-effect-html}}

  ;; =====================================================================
  ;; AUTH-FORM PARTIAL (graph-first §6-#2) — GET /partials/auth-form
  ;; (UNAUTHENTICATED: it IS the login form, fetched before you have a
  ;; session). The popover FIELDS live in the graph; editor-auth.js keeps
