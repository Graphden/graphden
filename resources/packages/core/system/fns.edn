;; System information and Ring response primitives
;; ring-response, make-handler, to-json-string, jvm-info, current-time-ms


{:namespace "core.system"
 :description "System primitives — Ring response shape, JSON, JVM info, timing, env, resources."
 :fns
 [;; ---------------------------------------------------------------------
  ;; Record-type declarations. Open-record
  ;; subtyping (`{a:int b:text} ⊆ {a:int}`) means handlers that produce
  ;; a SUPERSET of the named fields still satisfy the type — matches
  ;; how http-kit consumes the response map.
  ;; ---------------------------------------------------------------------

  ;; `:body` is `:any`, not `:text`: Ring's body is text OR bytes (a
  ;; served image / font — `:read-resource-bytes`), and the encode +
  ;; cache wraps already handle both. `:ring-response` keeps its own
  ;; `:body` free typed `:text`; `:ring-bytes-response` is the binary twin.
  {:name :ring-response-shape
   :type {:status :http-status
          :headers :text-map
          :body :any}}

  {:name :jvm-version-shape
   :type {:name :text
          :version :text
          :uptime-ms :int}}

  {:name :heap-memory-shape
   :type {:heap-used :int
          :heap-max :int
          :heap-committed :int
          :free :int
          :total :int
          :max :int}}

  {:name :os-info-shape
   :type {:name :text
          :arch :text
          :processors :int
          :load-average :numeric}}

  ;; ring-response — pure-declaration constructor for `:ring-response-shape`.
  ;; Built as an :assoc chain: each step adds one field to a growing
  ;; record, threading the lifted free args (`:status` `:headers` `:body`)
  ;; through. No defbase needed — the type-system's `:assoc` rule
  ;; computes the record shape, which `:return-type :ring-response-shape`
  ;; pins (computed ⊆ declared check at sync time).
  ;;
  ;; `:headers` flows through keyword-keyed (JSONB roundtrip keywordizes
  ;; literal map keys). The `:http-server` adapter (web/http/impls.clj)
  ;; stringifies once on the way to http-kit, so no in-graph
  ;; `:stringify-map-keys` step is needed here.

  {:name :_ring-response--w-status
   :parent :assoc
   :args {:map {}
          :key {:value :status}
          :value {:as :status :type :http-status}}}

  {:name :_ring-response--w-headers
   :parent :assoc
   :args {:map :_ring-response--w-status
          :key {:value :headers}
          :value {:as :headers :type :text-map}}}

  {:name :ring-response
   :description "Build a Ring response: `{:status :headers :body}`. Free args: `:status` (refined `:http-status`), `:headers` (jsonb, stringified), `:body` (text)."
   :parent :assoc
   :args {:map :_ring-response--w-headers
          :key {:value :body}
          :value {:as :body :type :text}}
   :return-type :ring-response-shape}

  {:name :ring-bytes-response
   :description "`:ring-response` for a BINARY body — the same status + headers builder, `:body` typed `:any` so a byte array from `:read-resource-bytes` fits (the encode wrap skips non-compressible content-types; the immutable-response cache replays a byte array verbatim). Set `Content-Type` yourself."
   :parent :assoc
   :args {:map :_ring-response--w-headers
          :key {:value :body}
          :value {:as :body :type :any}}
   :return-type :ring-response-shape}

  ;; Ring-handler shape over `:constantly` — the result is a one-arg
  ;; callable that returns `:response` for any request, ignoring the
  ;; input. Used for reitit's default-handler trio (`:not-found`,
  ;; `:method-not-allowed`, `:not-acceptable`) where the slot expects a
  ;; raw Clojure callable; per-route handlers use `:assoc-fn` instead.
  ;; Pure rename of `:constantly`'s `:value` arg to `:response` — no
  ;; new impl, just a semantic alias.
  {:name :make-handler
   :description "Ring-handler shape over `:constantly` — binds `:response` so the resulting callable returns it for every request, ignoring the input."
   :parent :constantly
   :args {:value {:as :response}}}

  {:name :to-json-string
   :description "Serialize a Clojure value to a JSON string."
   :args {:data {:type :jsonb :description "Any JSON-encodable value."}}
   :return-type :text}

  {:name :to-json-pretty
   :description "Serialize a Clojure value to a pretty-printed (indented) JSON string. Sibling of :to-json-string — a separate atom rather than an optional flag slot, so existing consumers' free-arg surface stays untouched."
   :args {:data {:type :jsonb :description "Any JSON-encodable value."}}
   :return-type :text}

  {:name :parse-json
   :description "Parse a JSON string into a Clojure value."
   :args {:string {:type :text :description "JSON text to parse."}
          :keywordize {:type :bool :value true
                       :description "When true, convert string keys to keywords."}}
   :return-type :jsonb}

  {:name :parse-edn
   :description "Read one EDN value from text; nil when it doesn't parse. Generic counterpart to `:parse-json` — fn-def bundles travel as EDN because that is the one encoding where a reference (`:other-fn`) stays distinguishable from a string (moved from the optional mcp package when the registry's import route needed it too)."
   :args {:string {:type :nullable-text :description "EDN source text."}}
   :return-type :any}

  {:name :system-property
   :description "`(System/getProperty name)` — read a JVM system property (`java.vm.name`, `java.version`, `user.dir`, etc.). Returns nil when unset. Counterpart to `:env` for environment variables."
   :args {:name {:type :text :description "Property name (`java.version`, …)."}}
   :return-type :nullable-text
   :effects #{:env}}

  {:name :jvm-uptime-ms
   :description "Milliseconds since the JVM started. Single library call (`ManagementFactory.getRuntimeMXBean().getUptime()`) so admins can build their own JVM-info shape without an opaque all-in-one impl."
   :args {}
   :return-type :int
   :effects #{:io}}

  ;; :jvm-version is a graph composition of the three primitives —
  ;; admins can swap fields, add `:user-dir`, drop `:uptime-ms`, etc.
  ;; without writing Clojure.
  {:name :jvm-version
   :description "Java runtime info — `{:name :version :uptime-ms}`. Composed from `:system-property` (twice, for `java.vm.name` + `java.version`) and `:jvm-uptime-ms`. Same observable shape as before; just admin-extensible. `:version` is wrapped in `{:value …}` because the editor's `/version` route fn-def shadows the bare keyword; the others are safe but match the explicit-literal style of the wrapped one."
   :parent :zipmap
   :args {:keys [{:value :name} {:value :version} {:value :uptime-ms}]
          :vals [{:parent :system-property :args {:name {:value "java.vm.name"}}}
                 {:parent :system-property :args {:name {:value "java.version"}}}
                 :jvm-uptime-ms]}}

  ;; Heap / process-memory primitives — one MXBean/Runtime call each,
  ;; same standard as :jvm-uptime-ms: admins compose their own memory
  ;; shape via :zipmap instead of getting an opaque all-in-one impl.

  {:name :heap-used
   :description "Bytes of heap currently used (`MemoryMXBean.getHeapMemoryUsage().getUsed()`)."
   :args {}
   :return-type :int
   :effects #{:io}}                 ; live runtime state — varies per call

  {:name :heap-max
   :description "Max heap bytes (`MemoryMXBean.getHeapMemoryUsage().getMax()`); -1 when undefined."
   :args {}
   :return-type :int
   :effects #{:io}}                 ; live runtime state — varies per call

  {:name :heap-committed
   :description "Bytes of heap committed by the OS (`MemoryMXBean.getHeapMemoryUsage().getCommitted()`)."
   :args {}
   :return-type :int
   :effects #{:io}}                 ; live runtime state — varies per call

  {:name :free-memory
   :description "Free bytes within the JVM's currently allocated memory (`Runtime.freeMemory()`)."
   :args {}
   :return-type :int
   :effects #{:io}}                 ; live runtime state — varies per call

  {:name :total-memory
   :description "Total bytes currently allocated to the JVM (`Runtime.totalMemory()`)."
   :args {}
   :return-type :int
   :effects #{:io}}                 ; live runtime state — varies per call

  {:name :max-memory
   :description "Max bytes the JVM will attempt to use (`Runtime.maxMemory()`)."
   :args {}
   :return-type :int
   :effects #{:io}}                 ; live runtime state — varies per call

  ;; :heap-memory is a graph composition of the six primitives above —
  ;; admins can drop fields, add `:jvm-uptime-ms`, etc. without Clojure.
  {:name :heap-memory
   :description "JVM heap usage snapshot — `{:heap-used :heap-max :heap-committed :free :total :max}` in bytes. Composed via `:zipmap` from the six single-call memory primitives; keys are wrapped in `{:value …}` because the value names double as fn names."
   :parent :zipmap
   :args {:keys [{:value :heap-used} {:value :heap-max} {:value :heap-committed}
                 {:value :free} {:value :total} {:value :max}]
          :vals [:heap-used :heap-max :heap-committed
                 :free-memory :total-memory :max-memory]}
   :return-type :heap-memory-shape}

  {:name :thread-count
   :description "Live thread count from the JVM ThreadMXBean."
   :args {}
   :return-type :int
   :effects #{:io}}                 ; live runtime state — varies per call

  ;; OS primitives — one OperatingSystemMXBean call each.

  {:name :os-name
   :description "Operating-system name (`OperatingSystemMXBean.getName()`)."
   :args {}
   :return-type :text
   :effects #{:io}}                 ; system-property read

  {:name :os-arch
   :description "OS architecture (`OperatingSystemMXBean.getArch()`)."
   :args {}
   :return-type :text
   :effects #{:io}}                 ; system-property read

  {:name :os-processors
   :description "Number of processors available to the JVM (`OperatingSystemMXBean.getAvailableProcessors()`)."
   :args {}
   :return-type :int
   :effects #{:io}}                 ; live runtime state — varies per call

  {:name :os-load-average
   :description "System load average for the last minute (`OperatingSystemMXBean.getSystemLoadAverage()`); -1.0 when unavailable."
   :args {}
   :return-type :numeric
   :effects #{:io}}                 ; live runtime state — varies per call

  ;; :os-info is a graph composition of the four primitives above.
  {:name :os-info
   :description "Host operating-system info — `{:name :arch :processors :load-average}`. Composed via `:zipmap` from the four single-call OS primitives; keys wrapped in `{:value …}` to stay literal keywords."
   :parent :zipmap
   :args {:keys [{:value :name} {:value :arch} {:value :processors} {:value :load-average}]
          :vals [:os-name :os-arch :os-processors :os-load-average]}
   :return-type :os-info-shape}

  {:name :counters-snapshot
   :description "Process-global structural counters (`graphden.util.counters`) — compiled-registry full-clears, delta-recompiles, compiles. Counts of RARE structural events, not per-request metrics. Surfaced on /metrics so a running executor can be asked what it just did, instead of having it inferred from a stack trace minutes after the fact."
   :args {}
   :return-type :jsonb
   :effects #{:io}}                 ; process-global mutable state — varies per call

  ;; ---------------------------------------------------------------------
  ;; :render-prometheus — OpenMetrics exposition as GRAPH composition.
  ;;
  ;; The former Clojure formatter hand-rolled the whole exposition
  ;; (recursive flatten + key sanitise + numeric filter + line format +
  ;; join) while claiming to be a "library adapter" — there is no
  ;; library; it was multi-step composition, so it lives in the graph.
  ;;
  ;; Same `:fix` worklist idiom as `:install-package` (pure here — the
  ;; recursion only builds data). State: `{:stack [frame …] :lines [l …]}`;
  ;; frame = `{:prefix <text> :ks [k …] :m <map>}`. Each step consumes ONE
  ;; key of the top frame: a nested map pushes a child frame ON TOP of the
  ;; advanced stack (depth-first, so a subtree's lines land before the
  ;; parent's remaining keys — same order the recursive `mapcat` emitted);
  ;; a numeric leaf appends `<key> <v>`; other leaves drop (a Prometheus
  ;; sample value is numeric). Empty frame pops; empty stack returns lines.
  ;; ---------------------------------------------------------------------

  ;; --- initial state over the (nil-safe) input map ---
  {:name :_prom-m
   :parent :coalesce
   :args {:value {:as :m :type :nullable-jsonb} :default {:value {}}}}
  {:name :_prom-root-ks
   :parent :keys
   :args {:map {:ref :_prom-m :type [:map :any :any]}}}
  {:name :_prom-root-frame
   :parent :zipmap
   :args {:keys [{:value :prefix} {:value :ks} {:value :m}]
          :vals [{:value "graphden"} :_prom-root-ks :_prom-m]}}
  {:name :_prom-initial-stack
   :parent :list
   :args {:items [:_prom-root-frame]}}
  {:name :_prom-initial-state
   :parent :zipmap
   :args {:keys [{:value :stack} {:value :lines}]
          :vals [:_prom-initial-stack {:value []}]}}

  ;; --- state / frame accessors (pure) ---
  {:name :_prom-stack
   :parent :get :args {:coll {:as :input} :key {:value :stack}}}
  {:name :_prom-lines
   :parent :get :args {:coll {:as :input} :key {:value :lines}}}
  {:name :_prom-stack-empty?
   :parent :empty? :args {:coll {:ref :_prom-stack :type [:list :any]}}}
  {:name :_prom-frame
   :parent :first :args {:coll {:ref :_prom-stack :type [:list :any]}}}
  {:name :_prom-stack-rest
   :parent :rest :args {:coll {:ref :_prom-stack :type [:list :any]}}}
  {:name :_prom-ks
   :parent :get :args {:coll :_prom-frame :key {:value :ks}}}
  {:name :_prom-ks-empty?
   :parent :empty? :args {:coll {:ref :_prom-ks :type [:list :any]}}}
  {:name :_prom-frame-m
   :parent :get :args {:coll :_prom-frame :key {:value :m}}}
  {:name :_prom-prefix
   :parent :get :args {:coll :_prom-frame :key {:value :prefix}}}
  {:name :_prom-k
   :parent :first :args {:coll {:ref :_prom-ks :type [:list :any]}}}
  {:name :_prom-v
   :parent :get
   :args {:coll {:ref :_prom-frame-m :type [:map :any :any]} :key :_prom-k}}

  ;; --- advance the top frame past the consumed key ---
  {:name :_prom-ks-rest
   :parent :rest :args {:coll {:ref :_prom-ks :type [:list :any]}}}
  {:name :_prom-frame-advanced
   :parent :assoc
   :args {:map :_prom-frame :key {:value :ks} :value :_prom-ks-rest}}
  {:name :_prom-stack-advanced
   :parent :cons
   :args {:item :_prom-frame-advanced
          :coll {:ref :_prom-stack-rest :type [:list :any]}}}

  ;; --- metric key: prefix _ sanitise(lower(name k)) ---
  {:name :_prom-k-name
   :parent :name
   :args {:value :_prom-k}}
  {:name :_prom-k-lower
   :parent :str-lower
   :args {:string {:ref :_prom-k-name :type :text}}}
  {:name :_prom-seg
   :parent :re-replace
   :args {:string :_prom-k-lower
          :pattern {:value "[^a-z0-9_]"}
          :replacement {:value "_"}}}
  {:name :_prom-key
   :parent :str
   :args {:parts [:_prom-prefix {:value "_"} :_prom-seg]}}

  ;; --- dispatch on the value's shape ---
  {:name :_prom-v-map?
   :parent :is-a?
   :args {:type {:value :map} :value :_prom-v}}
  {:name :_prom-v-num?
   :parent :is-a?
   :args {:type {:value :numeric} :value :_prom-v}}

  ;; nested map → push its frame on top (depth-first descent)
  {:name :_prom-child-ks
   :parent :keys
   :args {:map {:ref :_prom-v :type [:map :any :any]}}}
  {:name :_prom-child-frame
   :parent :zipmap
   :args {:keys [{:value :prefix} {:value :ks} {:value :m}]
          :vals [:_prom-key :_prom-child-ks :_prom-v]}}
  {:name :_prom-stack-descend
   :parent :cons
   :args {:item :_prom-child-frame
          :coll {:ref :_prom-stack-advanced :type [:list :any]}}}
  {:name :_prom-state-descend
   :parent :zipmap
   :args {:keys [{:value :stack} {:value :lines}]
          :vals [:_prom-stack-descend :_prom-lines]}}
  {:name :_prom-recurse-descend
   :parent :invoke
   :args {:func {:as :self} :arg :_prom-state-descend}}

  ;; numeric leaf → append "<key> <v>"
  {:name :_prom-line
   :parent :str
   :args {:parts [:_prom-key {:value " "} :_prom-v]}}
  {:name :_prom-lines-emit
   :parent :conj
   :args {:coll {:ref :_prom-lines :type [:list :any]} :item :_prom-line}}
  {:name :_prom-state-emit
   :parent :zipmap
   :args {:keys [{:value :stack} {:value :lines}]
          :vals [:_prom-stack-advanced :_prom-lines-emit]}}
  {:name :_prom-recurse-emit
   :parent :invoke
   :args {:func {:as :self} :arg :_prom-state-emit}}

  ;; non-numeric leaf → drop it
  {:name :_prom-state-skip
   :parent :zipmap
   :args {:keys [{:value :stack} {:value :lines}]
          :vals [:_prom-stack-advanced :_prom-lines]}}
  {:name :_prom-recurse-skip
   :parent :invoke
   :args {:func {:as :self} :arg :_prom-state-skip}}

  ;; exhausted frame → pop it
  {:name :_prom-state-pop
   :parent :zipmap
   :args {:keys [{:value :stack} {:value :lines}]
          :vals [:_prom-stack-rest :_prom-lines]}}
  {:name :_prom-recurse-pop
   :parent :invoke
   :args {:func {:as :self} :arg :_prom-state-pop}}

  ;; --- one worklist iteration ---
  {:name :_prom-dispatch
   :parent :cond
   :args {:clauses [:_prom-v-map? :_prom-recurse-descend
                    :_prom-v-num? :_prom-recurse-emit
                    {:value true}  :_prom-recurse-skip]}}
  {:name :_prom-frame-step
   :parent :if
   :args {:test :_prom-ks-empty?
          :then :_prom-recurse-pop
          :else :_prom-dispatch}}
  {:name :_prom-step
   :parent :if
   :args {:test :_prom-stack-empty?
          :then :_prom-lines
          :else :_prom-frame-step}}

  {:name :_prom-fixed
   :parent :fix
   :args {:step :_prom-step :input :_prom-initial-state}}

  {:name :render-prometheus
   :description "Render a metrics map as an OpenMetrics / Prometheus text exposition — one `graphden_<flattened_key> <number>` line per numeric leaf (nested maps flatten with `_`; keys sanitised to `[a-z0-9_]`; non-numeric labels dropped). Pure graph composition — a `:fix` worklist over the nested map, joined with newlines."
   :parent :str-join
   :args {:coll {:ref :_prom-fixed :type [:list :any]}
          :separator {:value "\n"}}
   :return-type :text}

  ;; jvm-info composed from atomic base-fns via assoc chain
  {:name :jvm-info
   :description "Aggregate JVM/system snapshot — version, heap, threads, OS."
   :parent :assoc
   :args {:map :_threads-section :key "os" :value :os-info}}

  {:name :_jvm-section
   :parent :assoc-empty
   :args {:key "jvm" :value :jvm-version}}

  {:name :_memory-section
   :parent :assoc
   :args {:map :_jvm-section :key "memory" :value :heap-memory}}

  {:name :_threads-section
   :parent :assoc
   :args {:map :_memory-section :key "threads" :value :thread-count}}

  {:name :log-warn
   :description "Log a WARN line (`clojure.tools.logging/warn`) with a message + structured data map. Returns nil. The observability primitive for best-effort failure paths — a graph `:try` whose `:on-throw` swallows the error must still leave a trace for operators (e.g. vault drift during secret delete)."
   :args {:message {:type :text :description "Human-readable warning."}
          :data {:type :jsonb :value {} :required false
                 :description "Structured context map logged alongside the message."}}
   :return-type :null
   :effects #{:io}}

  {:name :current-time-ms
   :description "Wall-clock milliseconds since Unix epoch."
   :args {}
   :return-type :int
   :effects #{:time}}

  {:name :env
   :description "Read an OS environment variable. Returns nil if the variable is unset, hence the `:nullable-text` (`:nullable-text`) return — callers narrow to non-null via `:coalesce` (or an `:if`/`:nil?` guard)."
   :args {:name {:type :text :description "Environment variable name."}}
   :return-type :nullable-text
   :effects #{:env}
   ;; Runtime-config marker — see graphden.versioning.branch-local.
   ;; Env-var indirection is per-deployment by definition (the OS env
   ;; differs between dev / staging / prod). Descendants composed via
   ;; `:parent :env` (or wrappers like `:env-or-default`) inherit
   ;; sticky-local so user-defined env adapters never cross-merge.
   :branch-local? true}

  ;; The PUBLIC-settings counterpart of `:env`: reads the boot-time
  ;; snapshot `graphden.system.deploy-config` (populated by the
  ;; `:exec/deploy-config` init-key from the system config's declared
  ;; `:settings` map). `:effects #{}` is load-bearing — the editor's own
  ;; partials / APIs read hub + feedback + rescue-hatch settings through
  ;; this, and on the cloud those requests run under the request-level
  ;; effect gate, which excludes `:env` (the process environment holds
  ;; secrets). A key the operator did not declare reads as nil, so this
  ;; is not a side door to the environment.
  {:name :deploy-config
   :description "Read one PUBLIC deployment setting by key — a value the operator declared non-secret by listing it under `:exec/deploy-config` `:settings` in the system config (`:hub-url`, `:feedback-url`, `:feedback-intake`, `:disable-asset-overrides`). Snapshotted once at boot in the platform process, so this is a pure read (`:effects #{}`) that works under every effect gate; `:env` stays the gated primitive for everything else. Unset, blank, or undeclared ⇒ nil (`:nullable-text`)."
   :args {:key {:type :keyword :description "Setting key as declared under `:exec/deploy-config` `:settings`, e.g. `:hub-url`."}}
   :return-type :nullable-text
   :effects #{}
   ;; Runtime-config marker, same as `:env` — a deployment setting is
   ;; per-instance by definition, so descendants never cross-merge.
   :branch-local? true}

  ;; The hub setting has ONE graph definition — the branches popover
  ;; (push / pull) and the registry's sync-status probe both read it
  ;; here rather than each spelling out the `:deploy-config` read.
  {:name :deploy-hub-url
   :description "GRAPHDEN_HUB_URL as snapshotted at boot (`:deploy-config :hub-url`) — a pure read, so hub-facing partials and probes answer under the cloud's request-level effect gate. Branch-local by descent (hub wiring is per-deployment runtime config). nil when no hub is configured."
   :parent :deploy-config
   :args {:key {:value :hub-url}}}

  {:name :hub-configured?
   :description "True when this instance is wired to a hub — `:deploy-hub-url` is non-empty."
   :parent :not
   :args {:value {:parent :empty? :args {:coll :deploy-hub-url}}}}

  ;; Construct an ExceptionInfo. Paired with :throw to raise from
  ;; graph code; also usable as a plain value if something wants a
  ;; ready-made exception without raising.
  {:name :ex-info
   :description "Construct a Clojure `clojure.lang.ExceptionInfo` from a message + data map. Pair with `:throw` to raise; the value can also flow through the graph as a plain exception object."
   :args {:message {:type :text :description "Human-readable error message."}
          :data {:type :jsonb :description "Structured `:data` payload attached to the exception."}}
   :return-type :any}

  ;; Raise the given exception. Control flow never returns, so the
  ;; result type is `:never` — the bottom type, a subtype of every
  ;; type. In `(:if cond :then "ok" :else (:throw …))` the union of
  ;; the branches is `[:union :text :never]`, which `make-union`
  ;; collapses to `:text` — the throwing branch contributes nothing.
  {:name :throw
   :description "Raise an exception from graph code. Control flow never returns; `:return-type` is `:never` (the bottom type) so a throwing branch is accepted in any context and vanishes from a branch union."
   :args {:exception {:type :any :description "Exception to raise (typically built via `:ex-info`)."}}
   :return-type :never}

  ;; Look up a classpath resource and slurp it. Returns nil if missing.
  {:name :read-resource-or-nil
   :description "Read a classpath resource as a string, or return nil if the path doesn't resolve. Building block for `:read-resource` (which throws on miss)."
   :args {:path {:type :text :description "Resource path relative to the classpath root."}}
   :return-type :nullable-text
   :effects #{:io}}

  ;; A SHIPPED frontend asset — the editor's own JS/CSS/SVG/HTML, a
  ;; served .md — read once per process and cached, NO effect: the bundle
  ;; is the same bytes for every org and every visitor (it is what the
  ;; browser downloads anyway), so a request under the cloud's effect gate
  ;; may read it. Bounded to ASSET KINDS under `packages/` — `.js .css .svg
  ;; .html .md`, no `..` — so it is not a door to config (`cloud/*.edn`),
  ;; sources (`.clj`/`.edn`) or anything a tenant should not see through a
  ;; path it chose. Anything else stays with `:read-resource-or-nil` (`:io`).
  ;; Before this the editor's asset routes read the classpath per request
  ;; and the tenancy addon had to widen `:io` for the UI shell's exact
  ;; paths — a request-level exception that no longer needs to exist.
  {:name :shipped-asset
   :description "A shipped frontend asset as text — one of `.js .css .svg .html .md` under `packages/`, read once per process and cached. Pure (`:effects #{}`): the same public bytes for everyone. Throws `validation-error/shipped-asset-path` for a path outside that shape and `execution-error/resource-not-found` when the build does not carry the file. `:read-resource-or-nil` (`:io`) remains the primitive for a caller-chosen path."
   :args {:path {:type :text :description "Classpath path of the asset, e.g. `packages/app/editor/editor-styles.css`."}}
   :return-type :text
   :effects #{}}

  ;; The BINARY sibling of `:read-resource-or-nil` — a classpath resource
  ;; as a byte array, for serving a shipped image / font from a graph
  ;; route. Same `:io` effect (the path is caller-chosen, so the cloud's
  ;; request-level gate keeps a tenant from pulling config out of the
  ;; jar); the operator's own apps (the graphden.dev landing) are what it
  ;; is for. The graph has no bytes type — the value rides an `:any` slot
  ;; into a Ring `:body`, where the encode wrap leaves non-compressible
  ;; content-types alone and the immutable-response cache replays it.
  {:name :read-resource-bytes
   :description "Read a classpath resource as a byte array (`InputStream.readAllBytes`), or nil when the path doesn't resolve. For binary assets a graph route serves — images, fonts; `:read-resource-or-nil` is the text sibling. `:io`, like every classpath read."
   :args {:path {:type :text :description "Resource path relative to the classpath root, e.g. `landing/editor-demo.gif`."}}
   :return-type :any
   :effects #{:io}}

  ;; Read file from classpath resources, or throw with a clear message
  ;; if the path doesn't resolve. fn-def composition on top of
  ;; `:read-resource-or-nil` + `:if` + `:throw` + `:ex-info`.
  {:name :read-resource
   :lambda-params [:path]
   :description "Read a classpath resource as a string, throwing `execution-error/resource-not-found` when the path doesn't resolve. Pure composition over `:read-resource-or-nil`/`:if`/`:throw`/`:ex-info`. `:path` propagates from the inner `:read-resource-or-nil :path` rename annotation."
   :parent :if
   :args {:test :_resource-nil?
          :then :_resource-not-found-throw
          :else :_resource-or-nil}}

  {:name :_resource-or-nil
   :parent :read-resource-or-nil
   :args {:path {:as :path}}}

  {:name :_resource-nil?
   :parent :nil?
   :args {:value :_resource-or-nil}}

  {:name :_resource-not-found-message
   :parent :str
   :args {:parts [{:value "Resource not found: "}
                  {:as :path}]}}

  {:name :_resource-not-found-error
   :parent :ex-info
   :args {:message :_resource-not-found-message
          :data {"type" "execution-error/resource-not-found"}}}

  {:name :_resource-not-found-throw
   :parent :throw
   :args {:exception :_resource-not-found-error}}

  ;; Load multiple resource files and concatenate with separator.
  ;; Pure composition over `:map :read-resource` + `:str-join`.
  ;;
  ;; NOTE (reachability audit): UNREFERENCED by first-party fn-defs —
  ;; every editor/runtime bundle goes through the app tier's
  ;; `:concat-resources-overridable` twin, which reads each path via
  ;; `:read-resource-overridable`. This one stays DELIBERATELY: it is
  ;; the plain-`core` bundling primitive for anyone composing without
  ;; the override tier. Registered in `tools/graph-reachability.edn`
  ;; so the audit reports it as held vocabulary, not as dead code.
  {:name :concat-resources
   :description "Read each path in `:paths` via `:read-resource` and join the contents with a separator (default `\\n\\n`). Used to bundle CSS/JS asset modules."
   :parent :str-join
   :args {:coll :_concat-resources-list
          :separator {:type :text :value "\n\n"}
          :paths {:type [:list :text]
                  :description "Classpath resource paths — each is slurp'd via `:read-resource`, contents joined by `:separator`."}}}

  {:name :_concat-resources-list
   :parent :map
   :args {:func :read-resource
          :coll {:as :paths}}}

  ;; ---------------------------------------------------------------------
  ;; :parse-int — text → int via Long/parseLong. Throws
  ;; NumberFormatException on a malformed input, which surfaces as an
  ;; execution-error in the editor's result pane; wrap in `:try` to
  ;; catch it in-graph.
  ;; ---------------------------------------------------------------------
  {:name :parse-int
   :description "Parse a base-10 integer out of `:s`. Backed by Long/parseLong — accepts an optional leading `-`, rejects whitespace / decimal points / non-digit characters with NumberFormatException."
   :args {:s {:type :text
              :description "Text containing the integer literal, e.g. \"8081\"."}}
   :return-type :int}

  ;; ONE digest primitive — the ALGORITHM is data, pinned by graph-level
  ;; presets (same ladder shape as :http-request / :route). Deploy
  ;; verification uses the build-time hash below instead (single source
  ;; of truth across front- and back-end).
  {:name :digest-hex
   :description "Lower-case hex digest of a UTF-8 string under `:algorithm` (any name the JVM's MessageDigest providers resolve — \"SHA-256\", \"SHA-512\", \"SHA-1\", \"MD5\", …; unknown names throw at runtime). Prefer the `:sha256-hex` preset unless the algorithm genuinely varies."
   :args {:algorithm {:type :non-blank-text
                      :description "JVM MessageDigest algorithm name, e.g. \"SHA-256\"."}
          :s {:type :text :description "Input string."}}
   :return-type :text}

  {:name :sha256-hex
   :description "Lower-case 64-char hex SHA-256 digest of a UTF-8 string — `:digest-hex` with the algorithm pinned. Use `:subs` to take a shorter prefix when a concise build identifier is needed."
   :parent :digest-hex
   :args {:algorithm "SHA-256"}}

  ;; ============================================================================
  ;; Build identifiers (3-section)
  ;;
  ;; The uberjar carries `graphden-build-hashes.json`, written at build
  ;; time by `build.clj`'s `compute-section-hashes` step. It splits the
  ;; deploy into three independently-hashed sections so a `/version`
  ;; check tells you WHAT moved, not just whether anything did:
  ;;
  ;;   :frontend  — every `.js` / `.css` / `.html` / `.svg` under
  ;;                `resources/packages/` (the editor browser bundle)
  ;;   :packages  — every `.edn` / `.clj` under `resources/packages/`
  ;;                (graph fn-defs + their base-fn impls)
  ;;   :backend   — `src/**/*.clj` plus non-package resources
  ;;                (`system-*.edn`, `logback.xml`, …)
  ;;
  ;; All three flow into `GET /version`; the editor's console marker
  ;; uses the frontend hash specifically (it's the bit the user can
  ;; visually verify against what they have open in the editor).
  ;; ============================================================================

  ;; The FIXED build artifact, read once per process and cached — no
  ;; `:io` effect: unlike `:read-resource` (an arbitrary caller-chosen
  ;; classpath path, rightly gated) this reads exactly one baked,
  ;; non-secret, org-agnostic file. That keeps `/version` and the
  ;; Settings → Build partial inside the cloud's request-level effect
  ;; gate, where every tenant session runs.
  {:name :build-hashes-raw
   :description "The baked `graphden-build-hashes.json` resource as text — read once per process and cached. Pure (`:effects #{}`): a fixed build artifact, not a caller-chosen path. Throws `execution-error/resource-not-found` when the build never wrote it (a source checkout without `bb rebuild`)."
   :args {}
   :return-type :text
   :effects #{}}

  {:name :build-hashes
   :description "Map `{\"frontend\" … \"backend\" … \"packages\" …}` — each value is the lower-case 64-char hex SHA-256 of that section of the deploy at build time. Keys stay strings (`:keywordize false`) so the `:get` lookups below match the JSON shape verbatim."
   :parent :parse-json
   :args {:string :build-hashes-raw
          :keywordize false}}

  {:name :build-hash-frontend
   :description "Frontend-section SHA-256 — every `.js` / `.css` under `resources/packages/`. Changes only when a browser-side asset changes."
   :parent :get
   :args {:coll :build-hashes :key "frontend"}}

  {:name :build-hash-frontend-short
   :description "First 12 chars of `:build-hash-frontend` — used by the editor's `BUILD_HASH` console marker so the in-page identifier reflects exactly which JS/CSS the user is running."
   :parent :subs
   :args {:string :build-hash-frontend :start 0 :end 12}}

  ;; Invoke a value (that happens to be a Clojure fn) with one arg.
  ;; `:func :any` — the value is deref'd and used as-is. Use this when
  ;; :func is a fn-graph that PRODUCES a callable (e.g. :_router
  ;; returns a reitit ring-handler).
  ;;
  ;; NOTE: the slot's `:any` type is load-bearing for the executor's
  ;; runtime dispatch — `:fn`-typed slots trigger `hof-wrap` (treat
  ;; the bound fn-graph as something to wrap into a callable);
  ;; `:any`-typed slots pass the value through as-is. Type-system
  ;; polymorphism on this slot would require splitting the slot's
  ;; runtime-dispatch tag from its type-check shape (separate task).
  ;; Type-check still gets call-site narrowing via the rich-types
  ;; ref re-firing mechanism (`effective-ref-return`).
  {:name :invoke
   :description "Invoke a value that's already a Clojure callable with one argument. Polymorphic via type-vars `a`/`b`: a fn-graph whose `:return-type` is itself a fn-type produces the callable; type-checker unifies and propagates `b` from the produced fn's return through to consumers. Runtime detects callable-producer via `:produces-callable?` and uses thunk semantics."
   :args {:func {:type [:fn {:arg a} b]
                 :description "Bound fn-graph whose `:return-type` is a fn-type — its evaluation produces a Clojure callable."}
          :arg {:type a :description "Single argument passed to the callable."}}
   :return-type b}

  ;; Call a fn-graph-as-callable with one arg. `:func :fn` — the ref is
  ;; hof-wrap'd into a callable (the fn-graph's leftover free-arg
  ;; receives :arg). Use this when :func is a fn-graph that IS a
  ;; callable (Ring-handler-shaped: has `:request` or similar free arg,
  ;; returns a response).
  {:name :call-with
   :description "Invoke a fn-graph (hof-wrap'd into a callable) with a MAP of named arguments — the multi-arg counterpart of `:call`. The slot's fn-type names the arguments (pin it at the binding site: `{:as :nack :type [:fn {:message-id :uuid :error :text} :any]}`); `:args` carries them under those names."
   :args {:func {:type [:fn {} a] :description "Fn-graph to wrap into a callable. Pin a structural type with 2+ named args at the binding site; the wrap becomes a map-callable."}
          :args {:type :keyword-map :description "The named arguments, keyed by the slot's arg names."}}
   :return-type a}

  {:name :call
   :description "Invoke a fn-graph (hof-wrap'd into a Clojure callable) with one argument. Use when `:func` IS a callable; for already-built Clojure fns use `:invoke`."
   :args {:func {:type [:fn {:arg a} b] :description "Fn-graph to wrap into a callable. Single-arg slot; positional unify (the callee's leftover free-arg name is alpha-equivalent)."}
          :arg {:type a :description "Single argument passed to the callable."}}
   :return-type b}

  ;; Call a fn-graph-as-callable with NO args. `:func [:fn {} a]` —
  ;; bare-shape HOF slot. The ref is hof-wrap'd; with zero call-site
  ;; lambda-params, the wrap produces a variadic-ignore callable
  ;; that closes over the outer free-args (closure-capture; see
  ;; docs/CLOSURE_CAPTURE.md). Companion to `:call` (1-arg) for
  ;; cases where the target takes no per-invocation input — e.g.
  ;; cron fire-targets, signal handlers, scheduled cleanup tasks.
  {:name :call-noargs
   :description "Invoke a fn-graph (hof-wrap'd into a 0-arg callable) with no arguments. Use when `:func` IS a callable that takes nothing. Mirrors `:call` for the no-arg case."
   :args {:func {:type [:fn {} a] :description "Fn-graph wrapped as a 0-arg callable. Captured args resolve from the calling fn's binding-chain at wrap time."}}
   :return-type a}

  ;; Graph-level try/catch. Pair with `:atom` + `:swap-conj` (from
  ;; `core.concurrency`) to express journalled-write transactions: the
  ;; body's phases conj rollback-entries into a shared atom, and
  ;; `on-throw` derefs the atom + replays in reverse. `:_update-record-
  ;; type-apply` (web/crud/fns.edn) is the canonical use.
  {:name :try
   :description "Run `:body` (a 0-arg HOF callable) and return its result. If body throws an `Exception`, invoke `:on-throw` with the exception and return its result. `Throwable`-level errors (OOM / InterruptedException / LinkageError) DELIBERATELY propagate — graph-level try is for recoverable exceptions only."
   :args {:body {:type [:fn {} a]
                 :description "0-arg callable; its result is returned on success."}
          :on-throw {:type [:fn {:exception :any} b]
                     :description "1-arg callable invoked with the caught `Exception` when body throws; its result is returned instead. The exception's `ex-data` is available for case-style dispatch. May return a different shape than body — `:try`'s return-type is `[:union a b]`."}}
   :return-type [:union a b]}

  ;; Read an InputStream/Reader to string
  {:name :slurp
   :description "Read an InputStream to a string (Clojure's `slurp`). Used to materialise Ring request bodies. Returns nil for a non-InputStream input, hence `:nullable-text`."
   :args {:input {:type :any :description "InputStream (or any `:any` value — non-streams read back as nil)."}}
   :return-type :nullable-text
   :effects #{:io}}

  ;; Exception accessors — let `:on-throw` handlers dispatch on class
  ;; name (`:case` lookup) and surface the human-readable message in
  ;; graph-built error responses without a bespoke base-fn per call site.
  {:name :throwable-message
   :description "`(.getMessage ex)` — the human-readable message of any `Throwable`. Returns nil when `:ex` is nil. Use inside a `:try`'s `:on-throw` handler to surface the message in a `{:ok false :error}` response."
   :args {:ex {:type :any :description "Throwable. nil-safe."}}
   :return-type :nullable-text}

  {:name :throwable-class-name
   :description "`(.getName (.getClass ex))` — the fully-qualified class name of any `Throwable`. Returns nil when `:ex` is nil. Use as the `:value` of a `:case` to dispatch on exception type inside an `:on-throw` handler."
   :args {:ex {:type :any :description "Throwable. nil-safe."}}
   :return-type :nullable-text}

  {:name :ex-data
   :description "`(ex-data ex)` — the structured `:type`/payload map from an `ex-info`-style exception, or nil for non-ex-info exceptions. Use inside an `:on-throw` handler to access the `:type` key (e.g. `:constraint-violation/branch-has-children`) for `:case`-style dispatch."
   :args {:ex {:type :any :description "Throwable. nil-safe; non-ex-info exceptions also return nil."}}
   :return-type :nullable-jsonb}

  {:name :parse-uuid
   :description "Parse `:string` as a `:uuid`. Returns nil for non-string / blank / malformed input — every failure mode collapses to nil so graph callers don't need a try/catch wrap. Defensive boundary mirroring `crud.request/parse-uuid-or-clear`."
   :args {:string {:type :any :required false :description "Candidate string. Non-string / blank → nil."}}
   :return-type :nullable-uuid}]}
